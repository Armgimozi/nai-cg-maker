{
  "name": "BlockSuseon",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": false
      }
    },
    "TextChatService": {
      "$properties": {
        "ChatVersion": "TextChatService",
        "CreateDefaultTextChannels": true,
        "CreateDefaultCommands": true
      },
      "ChatWindowConfiguration": {
        "$className": "ChatWindowConfiguration",
        "$properties": {
          "Enabled": true
        }
      },
      "ChatInputBarConfiguration": {
        "$className": "ChatInputBarConfiguration",
        "$properties": {
          "Enabled": true
        }
      },
      "BubbleChatConfiguration": {
        "$className": "BubbleChatConfiguration",
        "$properties": {
          "Enabled": true
        }
      }
    }
  }
}
