 "rules": {
  "tier": "광석·보석 tier ≤ 곡괭이 tier + 1 일 때만 캔다 (0.3.6.1 주인 결정 — 한 단계 위는 그 광석 제 곡괭이 빠르기 × 0.6). 아니면 진행 없음 + 액션바 한 줄 \"곡괭이가 약해 캘 수 없습니다\" (1초에 1번). 레벨 조건은 어디에도 없다",
  "reach_above": 1,
  "stretch_factor": 0.6,
  "too_weak_actionbar": "곡괭이가 약해 캘 수 없습니다",
  "seconds": "base_seconds(광석 tier) ÷ 곡괭이 speed[광석 tier] (보석 노드는 gems.base_seconds). 서버가 Tool 규칙 speed = 30·단단함(Material#getHardness) ÷ (20·초) 로 바꿈, correct_for_drops = TRUE",
  "min_seconds": 1.0,
  "can_break": "곡괭이 CAN_BREAK = mines 의 블록들 (광산 블록 표에서). 블록 설정이 바뀌면 접속 때 곡괭이 구성요소를 다시 씀",
  "outside_mine": "광산 월드 밖(오버월드·네더·엔드·미궁 월드 모두)에서 그 곡괭이로 광산 블록 12종을 부수면 취소 + 안내 1초에 1번 (R §3-15). 미궁도 이 블록을 쓴다: 2층 벽 구리·철 광석 · 6·7층 방해석 (DungeonManager 가 이미 부수기를 막음 — 안내 글만 더함). 0.3.6.1 보석 블록 6개(좀벌레 돌)는 미궁·마을·구역 어디에도 없다",
  "server_recheck": "BlockBreakEvent 는 늘 취소하고 서버가 다시 본다: 광산 월드 · 곡괭이 tier ≥ 광석 tier · 그 사람에게 고갈 아님 · 눈 → 블록 상자 거리 ≤ 4.5 + 0.25 (바닐라 서버는 5.5 까지 받아 고친 클라이언트가 더 멀리 캠) · 가방 자리. 하나라도 아니면 수확 없음",
  "pickaxe_item": "바탕 아이템은 지금 방식 그대로 PAPER (ENCHANTABLE 없음 → 효율 마법·모루로 속도 계약이 깨지지 않음) + MAX_STACK_SIZE 1",
  "harvest": {
   "ore_per_block": 1,
   "bonus": "곡괭이 bonus 확률로 +1",
   "gem_chance": 0.022,
   "gem_rule": "광석 블록마다 gem_chance 로 같은 tier 보석 1개",
   "gem_node": "1개, 노드 재생 gem_node_regen_minutes",
   "rich": {
    "chance": 0.04,
    "multiplier": 3,
    "shown": "그 사람에게만 반짝임"
   },
   "into_bag": "가방에 바로 — 가득 차면 캐지지도 비워지지도 않음 (\"가방이 가득 찼습니다\")",
   "no_vanilla_drops": true,
   "no_xp": true
  },
  "veins": {
   "shared": "진짜 블록이 모두에게 빈 광맥(depleted_block)이 되고 시간이 지나면 다시 찬다 (계약 §0-3)",
   "regen": "다시 차는 시간 = regen_minutes ÷ min(광산 월드 사람 수, regen_players_cap). 재시작 때는 다 찬 상태",
   "ids": "광맥 번호 = 청사진 마커를 (y, z, x) 순으로 정렬한 번호",
   "reach_max": 12,
   "reach_metric": "발 = 바닥+1, 눈 = 바닥+2.62, 선 자리 아무 곳 (몸 폭 0.6), 눈 → 블록 상자 가장 가까운 점 ≤ 4.5 (R §2-8). 밟고 설 수 있는 장식(통·울타리·계단 등) 위도 선 자리로 잰다",
   "reach_server": 4.75,
   "reach_server_metric": "같은 방식, 거리만 4.75 (server_recheck 의 한도) — 여기서도 ≤ reach_max"
  },
