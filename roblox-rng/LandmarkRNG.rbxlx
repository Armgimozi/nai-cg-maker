	-- 코인 막대: [동전] 12.3K / 50K [체크]
	local bar = Ui.new("Frame", {
		Name = "Coins",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -SECTION_PAD),
