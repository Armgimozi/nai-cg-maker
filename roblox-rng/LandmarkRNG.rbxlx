      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--!strict
-- 게임 전체 밸런스/설정 값. 숫자만 바꿔서 난이도를 조절할 수 있습니다.

-- n 번째 환생 조건(코인 + 이번 판에 보유해야 하는 명소 Id)
export type RebirthStep = {
	Coins: number,
	Landmarks: { string },
}

-- 게임패스(한 번 사면 영구). PassId 가 0 이면 비활성(화면에 안 나옴)
export type GamePass = {
	Id: string,
	Name: string,
	PassId: number,
	LuckMult: number?, -- 행운 배율
	CooldownMult: number?, -- 굴림 간격 배율
	IncomeMult: number?, -- 관광 수입 배율
	Price: number?, -- Robux 가격(상점 버튼에 먼저 보여 줌. 클라이언트가 GetProductInfo 로 실제 가격을 받으면 그 값으로 바꿈)
}

-- 개발자 상품(여러 번 구매). ProductId 가 0 이면 비활성(화면에 안 나옴)
export type Product = {
	Id: string,
	Name: string,
	ProductId: number,
	Seconds: number?, -- 시간 부스트 길이(초). 같은 부스트를 또 사면 시간이 더해짐
	LuckMult: number?, -- 부스트 중 행운 배율
	ServerWide: boolean?, -- true 면 서버 전체 부스트(저장 안 하는 서버 변수), 아니면 개인 부스트(Data.Boosts)
	IncomeSeconds: number?, -- 코인 팩: 초당 관광 수입 × 이 초만큼 코인
	MinCoins: number?, -- 코인 팩: 최소 코인
	Price: number?, -- Robux 가격(게임패스와 같음)
}

local Config = {
	-- 굴리기(지구본 돌리기) ----------------------------------------------
	ROLL_COOLDOWN = 1.2, -- 굴리기 사이 최소 간격(초). 서버가 강제합니다.
	-- 네트워크 지연을 감안한 허용 오차(초): 이만큼 일찍 닿아도 받음. 늦게 닿은 요청 뒤에는 2배까지(RollLogic.cooldownGate)
	COOLDOWN_TOLERANCE = 0.15,
	BASE_LUCK = 1,
	-- 자동 굴림(AUTO) 중 이미 발견한 명소는 지구본을 돌리지 않고 결과 카드만 퐁(빠른 결과, 새 발견·수동 굴림은 원래 연출).
	-- 연출을 기다리지 않아서 AUTO 는 굴림 간격대로 굴림 → 여행사(최대 -50%)·빠른 굴림(×0.7)이 AUTO 도 빠르게 함
	-- (후반 시간당 3,000 / 4,286 / 6,000 / 8,571번 = 없음 / 빠른 굴림 / 여행사 최대 / 둘 다 — 클라이언트가 원래 보낼 시각을
	-- 기준으로 해서 프레임 늦음이 쌓이지 않아 평균이 굴림 간격 그대로. balance/sim_results.md 9번).
	-- false 면 모든 결과를 등급 길이의 연출로(연출이 굴림 간격보다 길어 AUTO 가 느려짐)
	AUTO_QUICK_REVEAL = true,

	-- 1/N 이상 희귀한 명소를 발견하면 서버 전체에 "뉴스 속보"(사하라 신기루 성·샹그릴라·세계수. 후반 1인 시간당 약
	-- 0.5~1.4번 = 후반 8명 서버에서 5~15분에 한 번꼴 — 사용자 결정, balance/sim_results.md 9d)
	ANNOUNCE_ONE_IN = 100000000,
	-- 1/N 이상이면 광장 하늘에 거대한 홀로그램까지 띄움(샹그릴라·세계수 — 속보보다 드문 단계)
	HOLOGRAM_ONE_IN = 375000000,

	-- 새 명소를 처음 발견했을 때 보너스 코인 = ceil(DISCOVERY_BONUS_MULT * N ^ 0.5)
	DISCOVERY_BONUS_MULT = 5,

	-- 관광 공원(타이쿤) ------------------------------------------------------
	BASE_SLOTS = 6, -- 처음 전시 칸 수 (공원 확장 업그레이드로 늘어남)
	PARK_GRID = 6, -- 공원 전시 격자 한 변의 칸 수(6×6 = 최대 36칸). 명소가 더 많으면 희귀한 순서로 36개만 전시
	-- 등급(Rank 1~7)별 명소 1개의 초당 관광 수입
	TIER_INCOME = { 1, 2, 5, 12, 35, 120, 500 },
	-- 별(★): 가챠 중복처럼 같은 명소를 또 뽑을 때마다 +1. 처음 발견 = 별 0, 2번째 = ★1 … 6번째 = ★5(최대).
	-- STAR_THRESHOLDS[k] = 별 k 개가 되는 이번 판 발견 수(보유 수). 별 수는 보유 수로 계산하고 저장하지 않음
	STAR_THRESHOLDS = { 2, 3, 4, 5, 6 },
	STAR_INCOME_BONUS = 0.3, -- 별 1개마다 그 명소 수입 +30% (★5 = ×2.5)

	-- 여권 도장: 한 대륙에서 이 등급(Rank) 이하의 명소를 모두 발견하면 영구 행운 보너스(대륙마다 더해짐).
	-- 5 = 불가사의까지. 그보다 희귀한 전설급은 도장에 필요 없는 보너스 수집.
	STAMP_MAX_RANK = 5,
	REGION_LUCK_BONUS = 0.25,

	-- 업그레이드(영구). 가격 = floor(BasePrice * Growth ^ 현재레벨)
	Upgrades = {
		{
			Id = "Globe",
			Name = "지구본",
			Emoji = "🌐",
			Description = "행운 +10%",
			BasePrice = 400,
			Growth = 1.7,
			MaxLevel = 20,
			PerLevel = 0.10,
		},
		{
			Id = "Agency",
			Name = "여행사",
			Emoji = "✈️",
			Description = "굴림 간격 -5%",
			BasePrice = 300,
			Growth = 1.8,
			MaxLevel = 10,
			PerLevel = 0.05,
		},
		{
			Id = "Park",
			Name = "공원 확장",
			Emoji = "🏞️",
			Description = "전시 칸 +3",
			BasePrice = 250,
			Growth = 2.0,
			MaxLevel = 10, -- 6 + 3*10 = 36칸 = 격자(6×6) 가득
			PerLevel = 3,
		},
		{
			Id = "Ticket",
			Name = "입장료",
			Emoji = "🎟️",
			Description = "관광 수입 +20%",
			BasePrice = 500,
			Growth = 1.9,
			MaxLevel = 15,
			PerLevel = 0.20,
		},
	},

	-- 환생 ---------------------------------------------------------------
	-- REBIRTHS[n] = n 번째 환생 조건. 요구 명소는 이번 판에 보유하고 있어야 함(환생하면 보유 명소는 비워짐).
	-- 환생은 MAX_REBIRTHS 번까지(목록 길이와 같음). 다 하면 더 환생할 수 없음.
	-- (명소 목록이 늘어나도 그대로 쓸 수 있는 명소 Id 만 사용)
	-- 요구 명소는 그 판에 부스트를 다 켠 최대 행운보다 희귀해야 함(행운 ≥ N 이면 굴림에서 못 나옴 — 테스트가 확인).
	-- 진행 목표(무료, AUTO, 온라인 시간): 첫 환생 약 17분, 3번째 2.8시간, 5번째 약 26시간, 10번째 약 23일
	-- (유료 게임패스 3종 + 하루 부스트 1번 = 8분 · 78분 · 12시간 · 11일 — balance/sim_results.md 9번)
	REBIRTHS = {
		{ Coins = 400000, Landmarks = { "eiffel", "liberty" } },
		{ Coins = 4000000, Landmarks = { "pyramid", "chichen" } },
		{ Coins = 60000000, Landmarks = { "moai", "stonehenge", "alexandria" } },
		{ Coins = 500000000, Landmarks = { "babylon", "artemis", "rhodes" } },
		{ Coins = 3000000000, Landmarks = { "zeus", "mausoleum", "trojanhorse" } },
		{ Coins = 9000000000, Landmarks = { "atlantis", "labyrinth" } },
		{ Coins = 18000000000, Landmarks = { "hwangnyongsa", "eldorado" } },
		{ Coins = 40000000000, Landmarks = { "fountainofyouth", "yonggung" } },
		{ Coins = 90000000000, Landmarks = { "mu", "zealandia" } },
		{ Coins = 200000000000, Landmarks = { "skyisland" } },
	} :: { RebirthStep },
	MAX_REBIRTHS = 10, -- 환생 상한(= REBIRTHS 단계 수). 보너스도 여기서 멈춤
	REBIRTH_LUCK_MULT = 2, -- 환생 1회마다 행운 ×2 (행운 × 2^환생 수: 10번 = ×1,024)
	REBIRTH_INCOME_BONUS = 0.5, -- 환생 1회마다 관광 수입 +50% (수입 × (1 + 0.5 × 환생 수))

	-- 유료 상품(Robux) ----------------------------------------------------
	-- 2026-09-30 Open Cloud 로 등록한 번호(아이콘: art/products). 0 이면 그 상품은 비활성(화면에 안 나옴).
	-- Price 는 Creator Hub 에 넣은 Robux 가격과 같게 유지(상점 버튼에 먼저 보이는 값. 실제 가격은 클라이언트가 다시 받음)
	GamePasses = {
		{ Id = "LuckVIP", Name = "행운 VIP", PassId = 1999287690, LuckMult = 2, Price = 399 },
		{ Id = "FastRoll", Name = "빠른 굴림", PassId = 2002682533, CooldownMult = 0.7, Price = 199 },
		{ Id = "DoubleIncome", Name = "수입 2배", PassId = 2003390304, IncomeMult = 2, Price = 299 },
	} :: { GamePass },
	Products = {
		{
			Id = "LuckBoost",
			Name = "행운 부스트",
			ProductId = 3715550240,
			Seconds = 900,
			LuckMult = 2,
			Price = 49,
		},
		{
			Id = "ServerLuck",
			Name = "서버 행운",
			ProductId = 3715550255,
			Seconds = 900,
			LuckMult = 2,
			ServerWide = true,
			Price = 99,
		},
		{
			Id = "CoinPack",
			Name = "코인 팩",
			ProductId = 3715550261,
			IncomeSeconds = 1800,
			MinCoins = 1000,
			Price = 79,
		},
	} :: { Product },
	-- 시간 부스트(개인·서버): 남은 시간 + 부스트 시간이 이 값을 넘으면 서버가 구매 창을 띄우지 않음.
	-- 이미 결제된 영수증은 이 값과 상관없이 산 시간을 다 더함(동시에 연 구매 창, 늦게 온 영수증 — 돈 낸 시간을 버리지 않음)
	MAX_BOOST_SECONDS = 3 * 60 * 60,
	-- 지급·저장할 때의 남은 시간 상한. 데이터 손상 방지용일 뿐이라 보통은 닿지 않게 아주 큼
	MAX_BOOST_STORED_SECONDS = 24 * 60 * 60,
	-- 중복 지급 방지용으로 기억하는 최근 구매 영수증(PurchaseId) 수. 저장이 계속 실패하는 동안 쌓인 영수증이
	-- 밀려나 다시 지급되지 않도록 넉넉하게(1000개 ≈ 40KB, DataStore 한도 4MB)
	MAX_RECEIPTS = 1000,

	-- 저장 ---------------------------------------------------------------
	DATASTORE_NAME = "LandmarkRNG_v1",
	AUTOSAVE_INTERVAL = 120,
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Format</string>
          <string name="Source"><![CDATA[--!strict
-- 숫자/시간 표시용 포맷 함수

local Format = {}

-- 1234567 -> "1,234,567"
function Format.commas(n: number): string
	local negative = n < 0
	local digits = tostring(math.floor(math.abs(n)))
	local out = digits:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if out:sub(1, 1) == "," then
		out = out:sub(2)
	end
	return if negative then "-" .. out else out
end

local SUFFIXES = {
	{ 1e12, "T" },
	{ 1e9, "B" },
	{ 1e6, "M" },
	{ 1e3, "K" },
}

-- 2500000 -> "2.5M", 404040 -> "404K". 반올림 대신 버림(999.95K 가 "1000K" 가 되지 않도록).
function Format.short(n: number): string
	for _, entry in SUFFIXES do
		local unit = entry[1] :: number
		if n >= unit then
			local value = n / unit
			local text
			if value >= 100 then
				text = tostring(math.floor(value))
			else
				text = string.format("%.1f", math.floor(value * 10) / 10):gsub("%.0$", "")
			end
			return text .. (entry[2] :: string)
		end
	end
	return Format.commas(n)
end

-- 확률 표기: 항상 콤마 자연수 ("1 in 2,500", "1 in 40,000,000")
function Format.oneIn(n: number): string
	return "1 in " .. Format.commas(n) -- 백만 넘어도 줄이지 않고 그대로(1 in 40,000,000)
end

-- 1.5 -> "x1.5", 2 -> "x2", 1.25 -> "x1.25"
function Format.multiplier(x: number): string
	local text = string.format("%.2f", x):gsub("0+$", ""):gsub("%.$", "")
	return "x" .. text
end

-- 초 -> "4:05" / "1:02:03"
function Format.duration(seconds: number): string
	local total = math.max(0, math.ceil(seconds))
	local h = total // 3600
	local m = (total % 3600) // 60
	local s = total % 60
	if h > 0 then
		return string.format("%d:%02d:%02d", h, m, s)
	end
	return string.format("%d:%02d", m, s)
end

-- Color3 -> "#rrggbb" (RichText 용)
function Format.hex(color: Color3): string
	return string.format(
		"#%02x%02x%02x",
		math.floor(color.R * 255 + 0.5),
		math.floor(color.G * 255 + 0.5),
		math.floor(color.B * 255 + 0.5)
	)
end

-- RichText 에 넣을 문자열 이스케이프
function Format.escape(text: string): string
	return (text:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"):gsub('"', "&quot;"))
end

return Format
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">ImageIds</string>
          <string name="Source"><![CDATA[--!strict
-- 그림 에셋 Id 표 (이름 -> "rbxassetid://<숫자>").
-- tools/upload_images.py 가 art/png/*.png 를 올린 뒤 이 파일의 빈 문자열을 채웁니다(손으로 넣어도 됨).
-- 빈 문자열이면 코드로 그린 기본 모양을 씁니다: 아이콘은 3D 미니 모형(Icons.luau), 스킨은 Frame + UICorner + UIStroke.
-- 한 줄에 하나씩 `이름 = "..."`, 형식을 유지해 주세요(도구가 이 줄을 찾아 바꿉니다).

local ImageIds: { [string]: string } = {
	-- 아이콘 (정사각형, 투명 배경)
	coin = "rbxassetid://92735606856597",
	globe = "rbxassetid://120346838245612",
	passport = "rbxassetid://87589831804856",
	album = "rbxassetid://119409643400403",
	hammer = "rbxassetid://140249077514315",
	park = "rbxassetid://107569372693886",
	plaza = "rbxassetid://72077343461516",
	dice = "rbxassetid://134549464858003",
	clover = "rbxassetid://114594000848516",
	star = "rbxassetid://81395542088665",
	star_empty = "rbxassetid://140275366426879",
	news = "rbxassetid://106558405094559",
	lock = "rbxassetid://88755806602020",
	auto = "rbxassetid://74061414150372",
	close = "rbxassetid://93895182737016",
	check = "rbxassetid://72676469391845",
	arrow_up = "rbxassetid://115996354535723",
	stamp_home = "rbxassetid://126314844348937",
	stamp_europe = "rbxassetid://128003629180266",
	stamp_asia = "rbxassetid://85954883217288",
	stamp_africa = "rbxassetid://85590245416189",
	stamp_americas = "rbxassetid://77122062692820",
	stamp_oceania = "rbxassetid://138424553067781",
	stamp_legend = "rbxassetid://93435199901514",
	-- (선택) 업그레이드 아이콘. 비어 있으면 3D 모형
	plane = "",
	ticket = "",

	-- 스킨 (256x256, 9-slice SliceCenter = 64,64,192,192, tag 은 캡슐용 46..210 — Ui.luau SKINS). 회색 바탕 그림을 ImageColor3 로 물들여 씀.
	-- sunburst 는 9-slice 없이 통째로 늘여 씀.
	button_face = "rbxassetid://114337261704107",
	button_shadow = "rbxassetid://131795792663906",
	panel_paper = "rbxassetid://135177337416974",
	pill = "rbxassetid://76337661510619",
	sunburst = "rbxassetid://103053283018731",
	tag = "rbxassetid://111522354097064",

	-- 리본 꼬리 (늘이지 않는 그림, 56:50). 회색 바탕 그림을 ImageColor3 로 물들여 씀. 비어 있으면 둥근 네모 Frame 꼬리 (Ui.ribbon)
	ribbon_tail_l = "rbxassetid://95542836384666",
	ribbon_tail_r = "rbxassetid://114127605721192",
}

return ImageIds
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Landmarks</string>
          <string name="Source"><![CDATA[--!strict
-- 명소(뽑기 결과) 목록. OneIn = "1/N 확률"의 N.
-- 새 명소를 추가하려면 DEFINITIONS 에 한 줄만 넣으면 됩니다(Id는 저장 키이므로 게시 후엔 바꾸지 마세요).
-- 모형: Shape 이름으로 Models.luau 가 코드로 임시 모형을 만듭니다.
--       ReplicatedStorage.LandmarkModels 폴더에 Id 와 같은 이름의 Model 을 넣으면 그 모형(예: AI 메쉬)을 대신 씁니다.

export type Tier = {
	Rank: number,
	Name: string,
	MinOneIn: number,
	Color: Color3,
}

export type Region = {
	Id: string,
	Name: string,
	Emoji: string,
	Color: Color3,
}

export type Landmark = {
	Id: string,
	Name: string,
	Subtitle: string, -- 영문 이름
	OneIn: number,
	Region: string, -- Region.Id (대륙)
	Shape: string, -- Models.luau 의 임시 모형 종류
	Primary: Color3, -- 주 색
	Secondary: Color3, -- 보조 색
	Accent: Color3, -- 강조 색(빛/장식)
	Material: Enum.Material, -- 주 재질
	Tier: Tier,
}

local Landmarks = {}

-- 등급: OneIn 이 MinOneIn 이상이면 해당 등급(높은 등급부터 검사)
Landmarks.Tiers = {
	{ Rank = 1, Name = "일반 명소", MinOneIn = 1, Color = Color3.fromRGB(190, 200, 210) },
	{ Rank = 2, Name = "도시 명소", MinOneIn = 10, Color = Color3.fromRGB(110, 215, 120) },
	{ Rank = 3, Name = "국가 명소", MinOneIn = 100, Color = Color3.fromRGB(80, 165, 255) },
	{ Rank = 4, Name = "세계 명소", MinOneIn = 1000, Color = Color3.fromRGB(185, 110, 255) },
	{ Rank = 5, Name = "불가사의", MinOneIn = 12500, Color = Color3.fromRGB(255, 175, 45) },
	{ Rank = 6, Name = "잃어버린 유산", MinOneIn = 250000, Color = Color3.fromRGB(255, 85, 110) },
	{ Rank = 7, Name = "전설", MinOneIn = 8000000, Color = Color3.fromRGB(120, 255, 235) },
} :: { Tier }

-- 여권에 나오는 대륙(도장 대상). 순서 = 여권/지구본 연출 순서
Landmarks.Regions = {
	{ Id = "Asia", Name = "아시아", Emoji = "🏯", Color = Color3.fromRGB(255, 120, 120) },
	{ Id = "Europe", Name = "유럽", Emoji = "🏰", Color = Color3.fromRGB(110, 150, 255) },
	{ Id = "Africa", Name = "아프리카", Emoji = "🐪", Color = Color3.fromRGB(240, 190, 90) },
	{ Id = "Americas", Name = "아메리카", Emoji = "🗽", Color = Color3.fromRGB(90, 210, 150) },
	{ Id = "Oceania", Name = "오세아니아", Emoji = "🏝️", Color = Color3.fromRGB(70, 200, 235) },
} :: { Region }

Landmarks.RegionById = {} :: { [string]: Region }
for _, region in Landmarks.Regions do
	Landmarks.RegionById[region.Id] = region
end

local function tierFor(oneIn: number): Tier
	for i = #Landmarks.Tiers, 1, -1 do
		local tier = Landmarks.Tiers[i]
		if oneIn >= tier.MinOneIn then
			return tier
		end
	end
	return Landmarks.Tiers[1]
end

