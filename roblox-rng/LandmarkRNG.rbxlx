        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">Oceania</string>
            <string name="Source"><![CDATA[-- 오세아니아 명소 전용 모형. Models/init.luau 가 K(파트 헬퍼·색·기존 모양)를 넘겨 호출합니다.
-- 규칙: 바닥 10x10 안, 높이 22 이하, 바닥 y = 0, 정면 -Z, 파트 45개 이하. c.P/c.S/c.A = 명소 주/보조/강조 색, c.M = 재질.
-- 하버 브리지(bridge) · 스카이타워(needle) · 12사도 바위(seastacks) · 그레이트 배리어 리프(reef) · 모아이(moai)
-- · 난마돌(ruins) · 무 대륙(island 의 mu 버전) 은 원래 그 명소를 위해 만든 모양을 그대로 씀.

return function(K)
	local B = {}

	local V, rgb, Mat, PI = K.V, K.rgb, K.Mat, K.PI
	local UPRIGHT, ALONG_Z = K.UPRIGHT, K.ALONG_Z
	local GRASS, LEAF, WATER, DARK = K.GRASS, K.LEAF, K.WATER, K.DARK
	local ROCK, WOOD, SAND, CLOUD, BLACK, WHITE = K.ROCK, K.WOOD, K.SAND, K.CLOUD, K.BLACK, K.WHITE
	local mix, block, box, ball, cyl, col, wedge, beam = K.mix, K.block, K.box, K.ball, K.cyl, K.col, K.wedge, K.beam
	local gable, plant, archCorner, facing = K.gable, K.plant, K.archCorner, K.facing

	-- a 에서 b 까지 이어지는 판: 가로 w(진행 방향의 오른쪽), 두께 t. a → b 는 수직이 아니어야 함
	local function slab(c, a, b, w, t, color, material)
		local mid = (a + b) / 2
		return block(c, CFrame.lookAt(mid, b), V(w, t, (b - a).Magnitude), color, material)
	end

	-- 세 점을 잇는 삼각형 판(직각 쐐기 두 개): 한 변(밑변)에 맞은편 꼭짓점에서 수선을 내려 둘로 나눔.
	--   쐐기의 경계 상자가 설계 공간(바닥 위, 10x10 안)에 들어가는 밑변을 고름
	local function tri(c, a, b, d, color, material, thick)
		local t = thick or 0.15
		local function fits(p)
			local limit = 5 - t / 2
			return p.Y >= t / 2 and math.abs(p.X) <= limit and math.abs(p.Z) <= limit
		end
		local chosen, fallback, longest = nil, nil, -1
		for _, o in { { a, b, d }, { b, d, a }, { d, a, b } } do
			local apex, p, q = o[1], o[2], o[3]
			local edge = q - p
			local s = (apex - p):Dot(edge) / edge:Dot(edge)
			if s > 1e-3 and s < 1 - 1e-3 then
				local up = apex - (p + edge * s)
				if fits(p) and fits(q) and fits(p + up) and fits(q + up) then
					chosen = o
					break
				end
				if edge.Magnitude > longest then
					fallback, longest = o, edge.Magnitude
				end
			end
		end
		local o = chosen or fallback
		if not o then
			return
		end
		local apex, p, q = o[1], o[2], o[3]
		local edge = q - p
		local foot = p + edge * ((apex - p):Dot(edge) / edge:Dot(edge))
		local height = (apex - foot).Magnitude
		local up = (apex - foot).Unit
		for _, e in { p, q } do
			local back = (foot - e).Unit
			local center = (e + apex) / 2
			wedge(c, CFrame.lookAt(center, center - back, up), V(t, height, (foot - e).Magnitude), color, material)
		end
	end

	-- 야자수: 기운 줄기 + 늘어진 잎 4장. (x, y, z) = 밑동, (dx, dz) = 기우는 방향
	local function palm(c, x, y, z, h, dx, dz, leaf)
		local top = V(x + dx, y + h, z + dz)
		beam(c, V(x, y, z), top, 0.24, WOOD, Mat.Wood)
		for k = 0, 3 do
			local angle = k * PI / 2 + 0.5
			local tip = top + V(math.cos(angle) * 1.15, -0.5, math.sin(angle) * 1.15)
			slab(c, top + V(0, 0.08, 0), tip, 0.42, 0.08, leaf, Mat.Grass)
		end
	end

	-- 네 삼각 면으로 된 뾰족한 봉우리(바닥 네 점 base, 꼭짓점 apex). 바닥 면은 없음
	local function pyramid(c, apex, base, color, material, thick)
		for k = 1, #base do
			tri(c, apex, base[k], base[k % #base + 1], color, material, thick or 0.25)
		end
	end

	-- cf(바닥 중앙) 기준 박공 능선: 길이 w(로컬 X), 폭 d(로컬 Z), 높이 h
	local function gableAt(c, cf, w, d, h, color, material)
		wedge(c, cf * CFrame.new(0, h / 2, -d / 4), V(w, h, d / 2), color, material)
		wedge(c, cf * CFrame.new(0, h / 2, d / 4) * CFrame.Angles(0, PI, 0), V(w, h, d / 2), color, material)
	end

	-- 모에라키 볼더스: 바다(앞) → 젖은 모래 경사 → 모래사장 → 낮은 흙 절벽(뒤, 풀).
	--   모래에 반쯤 묻힌 둥근 바위들(거북 등껍질 같은 밝은 금 = 바위를 두른 얇은 원판) + 파도 거품
	B.moeraki = function(c)
		local vein = mix(c.P, c.S, 0.62)
		local wet = mix(c.S, c.P, 0.4)
		local beachY = 0.7
		box(c, 0, 0, 0, 9.8, 0.3, 9.8, c.A, Mat.Glass, 0.1)
		box(c, 0, 0, 1.6, 9.8, beachY, 6.6, c.S, Mat.Sand)
		wedge(c, CFrame.new(0, beachY / 2, -2.3), V(9.8, beachY, 1.2), wet, Mat.Sand)
		box(c, -0.4, 0.3, -3.15, 8.8, 0.05, 0.3, WHITE, Mat.SmoothPlastic, 0.15)
		box(c, 1, 0.3, -4.25, 6.4, 0.05, 0.25, WHITE, Mat.SmoothPlastic, 0.3)
		-- 뒤쪽 흙 절벽(높낮이 둘) + 풀
		local bank = mix(c.S, c.P, 0.55)
		box(c, 1.6, beachY, 4.45, 6.6, 1.3, 0.9, bank)
		box(c, -3.1, beachY, 4.3, 3.6, 2, 1.2, mix(bank, c.P, 0.3))
		box(c, 1.6, beachY + 1.3, 4.45, 6.6, 0.25, 0.9, GRASS, Mat.Grass)
		box(c, -3.1, beachY + 2, 4.3, 3.6, 0.25, 1.2, GRASS, Mat.Grass)
		-- 바위: { x, z, 지름, 모래 위(true)/물속(false), 금 방향 }
		local boulders = {
			{ -3, -1, 2.4, true, 0.3 },
			{ -0.6, -0.5, 2.6, true, -0.5 },
			{ 1.8, -1.4, 2.2, true, 0.9 },
			{ 3.8, -0.1, 1.9, true, -0.2 },
			{ 0.6, 1.9, 1.7, true, 0.6 },
			{ -3.2, 2.2, 1.5, true, 0 },
			{ -1.7, -3.5, 1.9, false, 1.1 },
			{ 2.6, -3.7, 1.6, false, -0.8 },
			{ 4.1, -2.6, 1.2, false, 0 },
		}
		for k, b in boulders do
			local x, z, d = b[1], b[2], b[3]
			local y = if b[4] then beachY + d * 0.25 else d / 2 + 0.02
			ball(c, x, y, z, d, c.P)
			if k <= 4 or k == 7 then
				local rot = CFrame.new(x, y, z) * CFrame.Angles(0, b[5], 0)
				cyl(c, rot * CFrame.Angles(0, 0, 0.35), 0.12, d + 0.1, vein)
				cyl(c, rot * CFrame.Angles(0, 1.7, 0) * CFrame.Angles(0, 0, -0.6), 0.12, d + 0.1, vein)
			end
		end
	end

	-- 플린더스 스트리트 역: 노란 벽 + 붉은 벽돌 띠의 긴 2층 역사, 왼쪽 모퉁이의 큰 초록 돔 파빌리온
	--   (큰 아치 창 + 입구 위 시계 줄), 오른쪽 끝 시계탑, 앞 도로의 초록 트램
	B.flindersst = function(c)
		local glass = rgb(52, 62, 78)
		local cream = mix(c.P, WHITE, 0.45)
		box(c, 0, 0, 0, 9.8, 0.2, 9.8, rgb(160, 158, 152), Mat.Concrete)
		box(c, 0, 0.2, -3.75, 9.8, 0.04, 2.1, rgb(72, 74, 80), Mat.Asphalt)
		-- 본관
		box(c, 0, 0.2, 1.3, 9.6, 3, 3.4, c.P)
		box(c, 0, 1.6, 1.3, 9.7, 0.22, 3.5, c.S)
		box(c, 0, 3.2, 1.3, 9.7, 0.3, 3.5, c.S)
		box(c, 0.85, 2, -0.43, 4, 0.9, 0.06, glass)
		box(c, 0.85, 0.45, -0.43, 4, 1, 0.06, glass)
		for _, x in { -0.3, 0.85, 2 } do
			box(c, x, 0.2, -0.46, 0.26, 3, 0.1, c.S)
		end
		-- 돔 파빌리온(왼쪽 모퉁이)
		local px, pz = -2.9, 0.3
		box(c, px, 0.2, pz, 3.4, 5, 3.4, c.P)
		for _, sx in { -1, 1 } do
			box(c, px + sx * 1.55, 0.2, pz - 1.55, 0.42, 5, 0.42, c.S)
		end
		local face = pz - 1.73
		box(c, px, 2.2, face, 1.8, 1.9, 0.06, glass)
		cyl(c, CFrame.new(px, 4.1, face) * ALONG_Z, 0.06, 1.8, glass)
		box(c, px, 0.2, face, 1.5, 1.1, 0.06, DARK)
		box(c, px, 1.45, face - 0.02, 2.3, 0.55, 0.06, c.S)
		for k = 0, 3 do
			cyl(c, CFrame.new(px - 0.84 + k * 0.56, 1.72, face - 0.08) * ALONG_Z, 0.06, 0.42, WHITE)
		end
		box(c, px, 5.2, pz, 3.8, 0.3, 3.8, c.S)
		col(c, px, 5.5, pz, 0.8, 2.8, cream)
		ball(c, px, 6.3, pz, 3, c.A, Mat.Metal)
		col(c, px, 7.6, pz, 0.8, 0.6, cream)
		ball(c, px, 8.55, pz, 0.45, c.A, Mat.Metal)
		-- 시계탑(오른쪽 끝)
		local tx = 3.8
		box(c, tx, 0.2, 0, 1.8, 7.3, 1.8, c.P)
		box(c, tx, 3, 0, 1.9, 0.3, 1.9, c.S)
		box(c, tx, 5.2, 0, 1.9, 0.3, 1.9, c.S)
		cyl(c, CFrame.new(tx, 6.35, -0.93) * ALONG_Z, 0.08, 1.1, WHITE)
		box(c, tx, 6.35, -0.99, 0.08, 0.45, 0.04, DARK)
		box(c, tx, 7.5, 0, 2.1, 0.3, 2.1, c.S)
		col(c, tx, 7.8, 0, 0.6, 1.3, cream)
		ball(c, tx, 8.1, 0, 1.3, c.A, Mat.Metal)
		col(c, tx, 8.7, 0, 0.6, 0.12, cream)
		-- 초록 트램
		local tram = rgb(46, 112, 74)
		box(c, 0.6, 0.24, -3.7, 3.4, 1.15, 1.1, tram, Mat.SmoothPlastic)
		box(c, 0.6, 0.35, -3.7, 3.45, 0.25, 1.15, rgb(236, 214, 150), Mat.SmoothPlastic)
		box(c, 0.6, 0.85, -3.7, 3.45, 0.35, 1.15, glass, Mat.SmoothPlastic)
		box(c, 0.6, 1.39, -3.7, 3, 0.15, 0.9, rgb(70, 70, 70), Mat.SmoothPlastic)
		beam(c, V(0.6, 1.54, -3.7), V(1.4, 2.4, -3.7), 0.06, DARK)
	end

	-- 팬케이크 바위: 바다 + 얇은 석회암 판을 겹겹이 쌓은 바위 무더기(무른 층은 들어가고 단단한 층은 튀어나옴)
	--   뒤쪽 곶은 네모난 판, 앞쪽 바위 기둥은 둥근 판(팬케이크 더미) + 바위 틈 분수공의 물보라 + 꼭대기 덤불
	B.pancakerocks = function(c)
		local seam = mix(c.S, BLACK, 0.1)
		local light = mix(c.P, WHITE, 0.2)
		box(c, 0, 0, 0, 9.8, 0.3, 9.8, c.A, Mat.Glass, 0.1)
		-- 어두운 심 + 튀어나온 밝은 판 n장. round 이면 둥근 판
		local function pancakes(x, z, w, d, h, n, yaw, round)
			if round then
				col(c, x, 0.3, z, h - 0.05, w * 0.78, seam)
			else
				block(
					c,
					CFrame.new(x, 0.3 + h / 2 - 0.03, z) * CFrame.Angles(0, yaw, 0),
					V(w * 0.8, h - 0.06, d * 0.8),
					seam
				)
			end
			local t = h / n
			for k = 0, n - 1 do
				local s = (1 - 0.05 * ((k * 7) % 3)) * (1 - k * 0.03)
				local y = 0.3 + (k + 1) * t - t * 0.29
				local dx = ((k * 5) % 3 - 1) * 0.08
				local color = if k % 2 == 0 then light else c.P
				if round then
					col(c, x + dx, y - t * 0.29, z - dx, t * 0.58, w * s, color)
				else
					local cf = CFrame.new(x + dx, y, z) * CFrame.Angles(0, yaw + (k % 3 - 1) * 0.07, 0)
					block(c, cf, V(w * s, t * 0.58, d * s), color)
				end
			end
		end
		pancakes(-1.3, 2.9, 7.1, 3.5, 5.4, 7, 0.04, false)
		pancakes(3, 0, 2.8, 2.6, 4.4, 6, 0, true)
		pancakes(-2.6, -1.5, 2.4, 2.4, 3.4, 5, 0, true)
		pancakes(0.8, -3.3, 1.6, 1.6, 1.9, 3, 0, true)
		-- 분수공 물보라
		local spray = mix(WHITE, c.A, 0.12)
		col(c, 0.1, 0.3, -0.5, 0.08, 2, WHITE, Mat.SmoothPlastic, 0.25)
		col(c, 0.1, 0.3, -0.5, 3.8, 0.8, spray, Mat.SmoothPlastic, 0.3)
		ball(c, 0.1, 4.3, -0.5, 1.7, spray, Mat.SmoothPlastic, 0.3)
		ball(c, -0.5, 5.1, -0.3, 1.3, spray, Mat.SmoothPlastic, 0.45)
		ball(c, 0.7, 4.9, -0.8, 1.1, spray, Mat.SmoothPlastic, 0.45)
		-- 덤불(아마 풀)
		ball(c, -3.4, 5.8, 3.3, 1.4, LEAF, Mat.Grass)
		ball(c, -1.3, 5.75, 3.8, 1.1, mix(LEAF, GRASS, 0.5), Mat.Grass)
		ball(c, 1.2, 5.7, 3.1, 1, LEAF, Mat.Grass)
		ball(c, 3, 4.75, 0.2, 0.9, mix(LEAF, GRASS, 0.5), Mat.Grass)
	end

	-- 캐시드럴 코브: 바다 + 오른쪽 모래사장(앞뒤로 이어짐) + 흰 석회암 곶을 뚫은 높고 뾰족한 동굴 아치
	--   + 곶 위 덤불과 포후투카와 나무 + 앞바다의 테호호 바위(뾰족한 바다 기둥)
	B.cathedralcove = function(c)
		local rock = c.P
		local shade = mix(c.P, ROCK, 0.3)
		local wet = mix(c.P, ROCK, 0.6)
		box(c, 0, 0, 0, 9.8, 0.3, 9.8, c.S, Mat.Glass, 0.1)
		box(c, 1.6, 0, 0.3, 6.6, 0.45, 9.2, SAND, Mat.Sand)
		wedge(c, CFrame.new(1.6, 0.225, -4.6), V(6.6, 0.45, 0.6), SAND, Mat.Sand)
		wedge(c, CFrame.new(-2, 0.225, 0.3) * facing(-1, 0), V(9.2, 0.45, 0.6), SAND, Mat.Sand)
		-- 곶: 왼쪽·오른쪽 벽 + 아치 위 덩어리 + 뾰족한 아치 모서리
		local z, depth = 1.5, 3.8
		box(c, -0.9, 0.3, z, 2.6, 7.2, depth, rock)
		box(c, 3.85, 0.3, z, 2.1, 6.6, depth, rock)
		box(c, 1.6, 5.4, z, 2.4, 1.8, depth, rock)
		archCorner(c, 0.4, 5.4, z, 1.1, depth, rock, -1)
		archCorner(c, 2.8, 5.4, z, 1.1, depth, rock, 1)
		box(c, -0.9, 0.3, z, 2.7, 0.7, depth + 0.1, wet)
		wedge(c, CFrame.new(-2.9, 0.3 + 2.6, z + 0.2) * facing(-1, 0), V(depth - 0.4, 5.2, 1.4), shade)
		box(c, 3.85, 0.3, z, 2.2, 0.7, depth + 0.1, wet)
		block(c, CFrame.new(0.4, 7.4, 1.8) * CFrame.Angles(0, 0.08, 0.05), V(5, 1, 3.4), shade)
		block(c, CFrame.new(3.6, 7, 1.4) * CFrame.Angles(0, -0.1, -0.06), V(2.3, 1, 3.2), shade)
		box(c, 0.9, 7.85, 1.8, 5.6, 0.25, 3.2, c.A, Mat.Grass)
		plant(c, -0.8, 8.1, 2.2, 1.1, 1.6, mix(c.A, LEAF, 0.5))
		plant(c, 2.4, 8.1, 1.3, 0.9, 1.3, c.A)
		ball(c, 4, 7.9, 2.4, 1.2, mix(c.A, LEAF, 0.3), Mat.Grass)
		-- 테호호 바위: 앞바다에 선 뾰족한 바위(삼각 면 4개) + 꼭대기 덤불 + 물거품
		local hx, hz = -3.1, -2.5
		col(c, hx, 0.3, hz, 0.06, 3.4, WHITE, Mat.SmoothPlastic, 0.25)
		pyramid(c, V(hx + 0.5, 5.8, hz + 0.6), {
			V(hx - 1.5, 0.3, hz - 1),
			V(hx - 0.2, 0.3, hz - 1.6),
			V(hx + 1.4, 0.3, hz - 0.9),
			V(hx + 1.3, 0.3, hz + 1.3),
			V(hx - 1.3, 0.3, hz + 1.4),
		}, mix(rock, ROCK, 0.15))
		ball(c, hx + 0.45, 5.15, hz + 0.6, 1, c.A, Mat.Grass)
	end

	-- 힐리어 핑크 호수: 바다(짙은 파랑) + 얕은 물 + 해변 + 숲 덮인 섬 가운데의 분홍 타원 호수(흰 소금 테두리)
	--   + 호수와 바다를 가르는 좁은 숲 띠 + 뒤쪽 언덕
	B.lakehillier = function(c)
		local forest = c.S
		local deep = mix(c.S, BLACK, 0.25)
		box(c, 0, 0, 0, 9.8, 0.3, 9.8, c.A, Mat.Glass, 0.1)
		box(c, 0, 0.3, -3.3, 9.8, 0.04, 1.2, mix(c.A, WHITE, 0.45), Mat.Glass, 0.1)
		box(c, 0, 0, 1.6, 9.8, 1, 6.6, forest, Mat.Grass)
		box(c, 0, 0, -2.2, 9.8, 0.6, 1.2, SAND, Mat.Sand)
		box(c, 0, 0.3, -2.86, 9.8, 0.05, 0.25, WHITE, Mat.SmoothPlastic, 0.2)
		ball(c, 3.4, 1.35, 3.5, 2.7, deep, Mat.Grass)
		-- 호수: 원 3개를 겹친 타원(흰 테두리 → 분홍 물)
		local lakes = { { -2.2, 3.6 }, { 0, 4.4 }, { 2.2, 3.6 } }
		for _, l in lakes do
			col(c, l[1], 1, 1.2, 0.05, l[2] + 0.5, rgb(246, 240, 232), Mat.Sand)
		end
		for _, l in lakes do
			col(c, l[1], 1, 1.2, 0.1, l[2], c.P, Mat.SmoothPlastic)
		end
		-- 숲(나무 공): { x, z, 지름 }
		local trees = {
			{ -4.1, -1.1, 1.1 },
			{ -2.6, -1.2, 1.2 },
			{ -1, -1.25, 1 },
			{ 0.6, -1.2, 1.2 },
			{ 2.2, -1.25, 1 },
			{ 3.8, -1.1, 1.2 },
			{ -4.2, 1.8, 1.3 },
			{ 4.3, 1, 1.1 },
			{ -3.4, 4.1, 1.4 },
			{ -0.9, 4.2, 1.3 },
			{ 1.4, 4.1, 1.2 },
		}
		for k, t in trees do
			ball(c, t[1], 1 + t[3] * 0.3, t[2], t[3], if k % 2 == 0 then forest else deep, Mat.Grass)
		end
	end

	-- 웨이브 록: 붉은 흙 바닥 위, 앞(-Z)으로 말려드는 파도 모양 화강암 절벽.
	--   곡면은 세로 조각 5개 x 원호 토막 6개(조각마다 색이 달라 세로 줄무늬) + 발치의 경사 + 뒤쪽 바위 덩어리와 덤불
	B.waverock = function(c)
		local ground = rgb(186, 112, 70)
		box(c, 0, 0, 0, 9.8, 0.2, 9.8, ground, Mat.Ground)
		local zc, yc, R, T = -2.4, 4.33, 3.4, 0.75
		local a0, a1, segments = math.rad(8), math.rad(172), 6
		local tints = {
			c.P,
			mix(c.P, c.S, 0.4),
			mix(c.P, c.A, 0.35),
			mix(c.P, c.S, 0.6),
			mix(c.P, c.A, 0.12),
		}
		for i = 0, 4 do
			local x = -3.92 + i * 1.96
			local r = R + ((i * 3) % 4 - 1.5) * 0.05
			for k = 0, segments - 1 do
				local t1 = a0 + (a1 - a0) * k / segments
				local t2 = a0 + (a1 - a0) * (k + 1) / segments
				local tm = (t1 + t2) / 2
				local rm = r + T / 2
				local length = 2 * (r + T) * math.sin((t2 - t1) / 2) + 0.06
				local color = tints[i + 1]
				if k == 0 then
					color = mix(color, c.A, 0.4)
				elseif k == segments - 1 then
					color = mix(color, c.S, 0.25)
				end
				local cf = CFrame.new(x, yc - rm * math.cos(tm), zc + rm * math.sin(tm)) * CFrame.Angles(-tm, 0, 0)
				block(c, cf, V(1.98, T, length), color)
			end
		end
		wedge(c, CFrame.new(0, 0.2 + 0.4, -2.45), V(9.8, 0.8, 1.1), mix(c.P, c.A, 0.45))
		box(c, 0, 0.2, 3.15, 9.8, 7, 3.5, mix(c.P, c.S, 0.3))
		box(c, 0, 7, 2, 9.8, 1.5, 5.8, mix(c.P, c.S, 0.2))
		block(c, CFrame.new(0.4, 8.7, 2.9) * CFrame.Angles(0, 0, 0.03), V(8.4, 0.5, 3.6), mix(c.P, c.S, 0.45))
		ball(c, -3, 8.9, 3.6, 1.3, LEAF, Mat.Grass)
		ball(c, 2.6, 9, 3.8, 1.1, mix(LEAF, SAND, 0.2), Mat.Grass)
		ball(c, -4.1, 0.55, -4.1, 0.9, mix(LEAF, SAND, 0.3), Mat.Grass)
		ball(c, 3.9, 0.5, -4.2, 0.8, mix(LEAF, SAND, 0.3), Mat.Grass)
		-- 파도를 타는 사람(크기 비교)
		box(c, 1.6, 0.2, -3.3, 0.3, 0.8, 0.25, rgb(220, 60, 60), Mat.SmoothPlastic)
		ball(c, 1.6, 1.2, -3.3, 0.35, rgb(235, 195, 160), Mat.SmoothPlastic)
	end

	-- 팔라우 락 아일랜드: 옥색 석호 + 짙은 물길 + 흰 모래 여울 + 버섯 모양 섬들
	--   (물가가 파여 드러난 흰 석회암 밑동 위에 둥글게 덮인 밀림) + 카약
	B.rockislands = function(c)
		local lime = c.A
		local deepChannel = mix(c.S, rgb(20, 70, 150), 0.55)
		box(c, 0, 0, 0, 9.8, 0.3, 9.8, c.S, Mat.Glass, 0.1)
		block(c, CFrame.new(0.4, 0.32, 0.2) * CFrame.Angles(0, 0.5, 0), V(1.6, 0.04, 9), deepChannel, Mat.Glass, 0.1)
		col(c, -2.4, 0.3, 2.4, 0.04, 4.4, mix(c.S, WHITE, 0.45), Mat.Sand)
		col(c, 2.6, 0.3, -1.6, 0.04, 3.2, mix(c.S, WHITE, 0.45), Mat.Sand)
		-- 섬: { x, z, 지름, 덧붙은 둥근 덩어리들 {dx, dz, 지름} }
		local islands = {
			{ -2.5, 2.3, 3.2, { { 1.5, 0.9, 2.4 }, { -0.8, -1.3, 2 } } },
			{ 2.6, 3, 2.8, { { -1.2, 0.6, 1.9 } } },
			{ 2.8, -1.5, 2.3, { { 0.8, 0.8, 1.5 } } },
			{ 0, 0, 1.9, {} },
			{ -2.9, -2.5, 1.7, {} },
			{ -0.6, -3.6, 1.2, {} },
			{ 4.1, 0.9, 1.2, {} },
			{ 1.1, -3.8, 0.9, {} },
		}
		for k, isle in islands do
			local x, z, d = isle[1], isle[2], isle[3]
			local green = if k % 2 == 0 then c.P else mix(c.P, LEAF, 0.4)
			-- 공 중심을 조금 띄워 물가에 파인 흰 밑동(지름 0.8d)이 드러나게
			local function dome(px, pz, pd, color)
				local y = pd / 2 + 0.25
				col(c, px, 0.3, pz, y - 0.3, pd * 0.8, lime, Mat.Limestone)
				ball(c, px, y, pz, pd, color, Mat.Grass)
			end
			dome(x, z, d, green)
			for _, lump in isle[4] do
				dome(x + lump[1], z + lump[2], lump[3], mix(green, BLACK, 0.12))
			end
		end
		block(c, CFrame.new(-1.8, 0.4, -1) * CFrame.Angles(0, 0.4, 0), V(0.35, 0.18, 1.4), rgb(250, 200, 40))
		block(c, CFrame.new(-1.8, 0.55, -1) * CFrame.Angles(0, 0.4 + PI / 2, 0.3), V(0.06, 0.06, 1.3), DARK)
	end

	-- 보라보라: 짙은 바다 + 옥빛 석호 + 둘레의 모투(모래 산호섬, 야자) + 가운데 초록 섬.
	--   가파른 초록 비탈(삼각 면 4개) 위에 깎아지른 검은 바위 봉우리 오테마누 + 옆의 파히아 산
	--   + 앞쪽 수상 방갈로(초가지붕) 줄과 나무 잔교
	B.borabora = function(c)
		local sand = c.A
		local thatch = rgb(190, 150, 90)
		local rock = mix(c.P, DARK, 0.6)
		box(c, 0, 0, 0, 9.8, 0.3, 9.8, rgb(25, 95, 175), Mat.Glass, 0.1)
		col(c, 0, 0, 0, 0.36, 9.6, c.S, Mat.Glass, 0.1)
		-- 모투: 각도(도)
		for k, deg in { -15, 30, 70, 110, 150, 195 } do
			local a = math.rad(deg)
			local p = V(4.2 * math.cos(a), 0.46, 4.2 * math.sin(a))
			local tangent = V(-math.sin(a), 0, math.cos(a))
			block(c, CFrame.lookAt(p, p + tangent), V(0.7, 0.25, 1.9), sand, Mat.Sand)
			if k % 2 == 1 then
				ball(c, p.X, 0.9, p.Z, 0.8, LEAF, Mat.Grass)
			end
		end
		-- 가운데 섬 + 오테마누
		col(c, 0.3, 0.3, 1.2, 0.35, 5.4, sand, Mat.Sand)
		col(c, 0.3, 0.3, 1.2, 0.85, 4.8, c.P, Mat.Grass)
		pyramid(c, V(0.5, 6.6, 1.5), {
			V(-1.3, 1.1, -0.4),
			V(2.1, 1.1, -0.3),
			V(2.1, 1.1, 3),
			V(-1.2, 1.1, 3),
		}, c.P, Mat.Grass)
		block(c, CFrame.new(0.55, 6, 1.5) * CFrame.Angles(0, 0.3, 0.04), V(1.9, 3.2, 1.6), rock, Mat.Basalt)
		block(c, CFrame.new(0.75, 7.75, 1.5) * CFrame.Angles(0, 0.3, 0.18), V(1.6, 0.8, 1.4), rock, Mat.Basalt)
		ball(c, -1.4, 2.3, 2.9, 2, mix(c.P, LEAF, 0.25), Mat.Grass)
		ball(c, -0.9, 3.3, 3.1, 1.3, mix(c.P, LEAF, 0.25), Mat.Grass)
		-- 수상 방갈로 + 잔교
		box(c, 0.4, 0.55, -2.55, 5.8, 0.1, 0.35, WOOD, Mat.Wood)
		box(c, 0.4, 0.55, -1.55, 0.35, 0.1, 2, WOOD, Mat.Wood)
		for _, x in { -1.9, -0.4, 1.1, 2.6 } do
			box(c, x, 0.3, -3.3, 0.95, 0.35, 0.95, WOOD, Mat.Wood)
			box(c, x, 0.65, -3.3, 0.8, 0.5, 0.8, rgb(215, 185, 140), Mat.Wood)
			gable(c, x, 1.15, -3.3, 1.05, 1.05, 0.55, thatch)
		end
	end

	-- 밀퍼드 사운드: 짙은 피오르 물 + 물에서 곧장 솟은 뾰족한 마이터 봉(삼각 면 4개, 꼭대기 눈)
	--   + 밑동 숲 + 오른쪽 뒤의 초록 산과 비탈을 흘러내리는 폭포(물보라) + 낮게 걸린 구름 + 유람선
	B.milfordsound = function(c)
		local rockColor = mix(c.P, ROCK, 0.75)
		local forest = mix(c.P, LEAF, 0.6)
		box(c, 0, 0, 0, 9.8, 0.3, 9.8, c.S, Mat.Glass, 0.1)
		-- 마이터 봉 + 꼭대기 눈(같은 면을 바깥으로 조금 띄운 작은 삼각형)
		local apex = V(-1.2, 17, 1.1)
		local base = {
			V(-4.3, 0.3, -1.6),
			V(1.6, 0.3, -1.5),
			V(1.5, 0.3, 3.9),
			V(-4.4, 0.3, 3.7),
		}
		pyramid(c, apex, base, rockColor, Mat.Slate)
		local snowLine = 0.7
		for k = 1, 4 do
			local p1 = base[k] + (apex - base[k]) * snowLine
			local p2 = base[k % 4 + 1] + (apex - base[k % 4 + 1]) * snowLine
			local n = (p1 - apex):Cross(p2 - apex).Unit
			if n.Y < 0 then
				n = -n
			end
			tri(c, apex + n * 0.18, p1 + n * 0.18, p2 + n * 0.18, c.A, Mat.Snow, 0.12)
		end
		-- 오른쪽 뒤 산 + 폭포
		local peak = V(3.3, 10.5, 3.2)
		local foot = {
			V(1.6, 0.3, 0.3),
			V(4.6, 0.3, 0.3),
			V(4.6, 0.3, 4.6),
			V(1.4, 0.3, 4.6),
		}
		pyramid(c, peak, foot, forest, Mat.Grass)
		local edgeMid = (foot[1] + foot[2]) / 2
		local n = (foot[1] - peak):Cross(foot[2] - peak).Unit
		if n.Y < 0 then
			n = -n
		end
		local fallTop = edgeMid + (peak - edgeMid) * 0.62 + n * 0.2
		local fallFoot = edgeMid + n * 0.25 + V(0, 0.15, 0)
		beam(c, fallTop, fallFoot, 0.4, WHITE, Mat.SmoothPlastic, 0.1)
		ball(c, fallFoot.X, 0.85, fallFoot.Z - 0.1, 1.3, WHITE, Mat.SmoothPlastic, 0.35)
		-- 밑동 숲
		ball(c, -3.4, 1.1, -1.3, 1.8, forest, Mat.Grass)
		ball(c, -1.5, 1, -1.6, 1.6, mix(forest, LEAF, 0.3), Mat.Grass)
		ball(c, 0.6, 1.05, -1.4, 1.7, forest, Mat.Grass)
		ball(c, -4, 1.1, 1.2, 1.6, mix(forest, LEAF, 0.3), Mat.Grass)
		-- 구름
		ball(c, -3.4, 9.2, -0.2, 1.8, CLOUD, Mat.SmoothPlastic, 0.3)
		ball(c, 1.1, 8.3, -0.6, 1.4, CLOUD, Mat.SmoothPlastic, 0.35)
		ball(c, 3.2, 11.2, 2.4, 1.5, CLOUD, Mat.SmoothPlastic, 0.3)
		-- 유람선
		box(c, 1.2, 0.3, -3.5, 2.4, 0.45, 0.8, WHITE, Mat.SmoothPlastic)
		box(c, 1, 0.75, -3.5, 1.3, 0.45, 0.6, rgb(40, 60, 90), Mat.SmoothPlastic)
		col(c, 1.9, 0.75, -3.5, 0.6, 0.3, rgb(200, 50, 40), Mat.SmoothPlastic)
	end

	-- 킬라우에아: 바다 위 넓고 완만한 방패 화산(얇은 원판을 계단처럼) + 꼭대기 칼데라와 붉은 용암 호수
	--   + 바다로 흘러드는 용암 줄기와 김 기둥 + 화구의 화산 가스 + 옆구리 분석구의 용암 분수 + 비탈의 숲
	B.kilauea = function(c)
		local crust = mix(c.P, BLACK, 0.3)
		local lava = c.S
		box(c, 0, 0, 0, 9.8, 0.3, 9.8, rgb(30, 110, 190), Mat.Glass, 0.1)
		local cx, cz = 0, 0.6
		local step = 0.35
		for k = 0, 6 do
			local d = 8.6 - k * 0.7
			col(c, cx, 0.3 + k * step, cz, step, d, if k % 2 == 0 then c.P else mix(c.P, crust, 0.5), Mat.Basalt)
		end
		local top = 0.3 + 7 * step
		-- 칼데라(어두운 바닥 + 둘레 턱) + 용암 호수
		col(c, cx, top, cz, 0.04, 3.6, crust, Mat.Basalt)
		for k = 0, 5 do
			local rot = CFrame.new(cx, 0, cz) * CFrame.Angles(0, k * PI / 3, 0)
			block(c, rot * CFrame.new(0, top + 0.2, -1.95), V(2.3, 0.4, 0.5), c.P, Mat.Basalt)
		end
		col(c, cx + 0.4, top, cz - 0.2, 0.1, 1.9, lava, Mat.Neon)
		ball(c, cx + 0.4, top + 0.1, cz - 0.2, 0.7, c.A, Mat.Neon)
		-- 용암 줄기(비탈을 따라 바다까지): 방향 각(정면 -Z 기준)
		local function surface(rho)
			return 0.3 + (4.3 - rho) + step
		end
		for _, flow in { { 0.25, 5.1 }, { -0.8, 4.2 } } do
			local dir = V(math.sin(flow[1]), 0, -math.cos(flow[1]))
			local p1 = V(cx, 0, cz) + dir * 2.2 + V(0, surface(2.2), 0)
			local p2 = V(cx, 0, cz) + dir * 4.3 + V(0, surface(4.3) - 0.1, 0)
			beam(c, p1, p2, 0.36, lava, Mat.Neon)
			local p3 = V(cx, 0, cz) + dir * flow[2] + V(0, 0.4, 0)
			beam(c, p2, p3, 0.3, lava, Mat.Neon)
		end
		-- 바다에 닿은 곳: 용암 삼각주 + 김 기둥
		local entry = V(cx, 0, cz) + V(math.sin(0.25), 0, -math.cos(0.25)) * 4.9
		box(c, entry.X, 0.3, entry.Z, 1.4, 0.12, 0.7, lava, Mat.Neon)
		ball(c, entry.X + 0.2, 1.3, entry.Z + 0.1, 1.5, WHITE, Mat.SmoothPlastic, 0.35)
		ball(c, entry.X + 0.7, 2.5, entry.Z + 0.4, 1.8, WHITE, Mat.SmoothPlastic, 0.45)
		ball(c, entry.X + 1.3, 3.8, entry.Z + 0.7, 1.6, WHITE, Mat.SmoothPlastic, 0.55)
		-- 화산 가스
		local gas = rgb(215, 210, 205)
		ball(c, cx + 0.5, top + 1.5, cz + 0.1, 1.8, gas, Mat.SmoothPlastic, 0.3)
		ball(c, cx + 0.9, top + 3, cz + 0.5, 2.2, gas, Mat.SmoothPlastic, 0.4)
		ball(c, cx + 1.5, top + 4.7, cz + 0.9, 2.5, gas, Mat.SmoothPlastic, 0.5)
		-- 분석구(푸우오오) + 용암 분수
		local vx, vz = 2.8, 0.9
		col(c, vx, 1.9, vz, 0.5, 1.4, crust, Mat.Basalt)
		col(c, vx, 2.4, vz, 0.35, 0.9, crust, Mat.Basalt)
		col(c, vx, 2.7, vz, 1.2, 0.25, lava, Mat.Neon)
		ball(c, vx, 3.9, vz, 0.55, c.A, Mat.Neon)
		-- 비탈의 숲
		ball(c, -2.6, 1.4, 3.2, 1.2, LEAF, Mat.Grass)
		ball(c, -3.5, 1, 1.4, 1, mix(LEAF, GRASS, 0.4), Mat.Grass)
		ball(c, -1.2, 1.3, 3.9, 1, LEAF, Mat.Grass)
	end

	-- 와이토모 반딧불이 동굴: 풀 언덕(양 한 마리, 싱크홀) 아래로 뚫린 넓은 동굴 입구.
	--   어두운 동굴 벽을 수놓은 청록 반딧불이 점 + 천장에서 늘어진 빛나는 실 + 종유석 + 동굴 강의 나무배
	B.waitomo = function(c)
		local rock = c.P
		local dark = c.S
		local glow = c.A
		local lime = mix(c.P, WHITE, 0.4)
		local mouthZ, backZ, top = -1.2, 2.4, 5.6
		box(c, 0, 0, 0, 9.8, 0.3, 9.8, rock)
		box(c, 0, 0.3, (backZ + 4.9) / 2, 6.4, top - 0.3, 4.9 - backZ, dark)
		-- 양옆: 바깥으로 비탈진 수풀 언덕(안쪽 면은 곧은 동굴 벽)
		local hillH = top + 1.2 - 0.3
		for _, sx in { -1, 1 } do
			local cf = CFrame.new(sx * 4.05, 0.3 + hillH / 2, (mouthZ + 4.9) / 2) * facing(sx, 0)
			wedge(c, cf, V(4.9 - mouthZ, hillH, 1.7), mix(GRASS, rock, 0.35), Mat.Grass)
			box(c, sx * 3.18, 0.3, (mouthZ + backZ) / 2, 0.06, top - 0.3, backZ - mouthZ, dark)
		end
		box(c, 0, top, 1.6, 6.4, 1.2, 6.6, rock)
		box(c, 0, top + 1.2, 1.6, 6.4, 0.3, 6.6, GRASS, Mat.Grass)
		ball(c, -1.9, top + 1.4, 2.8, 2.6, GRASS, Mat.Grass)
		ball(c, 2, top + 1.3, 3.4, 2.4, mix(GRASS, LEAF, 0.3), Mat.Grass)
		col(c, 0.9, top + 1.5, 1, 0.05, 1.3, DARK)
		box(c, -0.8, top + 1.5, -0.8, 0.7, 0.45, 0.45, WHITE, Mat.SmoothPlastic)
		box(c, -1.2, top + 1.75, -0.8, 0.25, 0.3, 0.25, DARK)
		-- 동굴 강 + 나무배
		box(c, 0.3, 0.3, -1.6, 2.8, 0.06, 6.6, mix(dark, WATER, 0.4), Mat.Glass, 0.15)
		box(c, 0.3, 0.3, -1, 1.1, 0.35, 2, WOOD, Mat.Wood)
		ball(c, 0.3, 0.9, -1.4, 0.42, rgb(230, 190, 160), Mat.SmoothPlastic)
		ball(c, 0.3, 0.9, -0.6, 0.42, rgb(230, 190, 160), Mat.SmoothPlastic)
		-- 둥글게 깎인 입구 모서리 + 입구의 바위
		archCorner(c, -3.15, top, (mouthZ + backZ) / 2, 1.2, backZ - mouthZ, mix(rock, dark, 0.4), -1)
		archCorner(c, 3.15, top, (mouthZ + backZ) / 2, 1.2, backZ - mouthZ, mix(rock, dark, 0.4), 1)
		ball(c, -2.9, 0.75, -1.6, 1.2, rock)
		ball(c, 3.1, 0.65, -1.9, 1, rock)
		-- 종유석(입구 천장)
		for k, x in { -1.6, -0.6, 1.6 } do
			local h = 0.5 + (k % 2) * 0.35
			col(c, x, top - h, -1.45, h, 0.3, lime)
		end
		-- 반딧불이 점: 뒷벽 { x, y } + 옆벽
		local dots = {
			{ -2.6, 3.9 },
			{ -1.7, 2.8 },
			{ -0.8, 3.6 },
			{ 0.2, 2.4 },
			{ 1, 3.9 },
			{ 1.9, 2.9 },
			{ 2.7, 3.7 },
			{ -2.2, 1.8 },
			{ 2.4, 1.6 },
			{ -0.4, 1.4 },
		}
		for _, d in dots do
			ball(c, d[1], d[2], backZ - 0.05, 0.32, glow, Mat.Neon)
		end
		for _, sx in { -1, 1 } do
			ball(c, sx * 3.12, 3.4, 0.2, 0.3, glow, Mat.Neon)
			ball(c, sx * 3.12, 2.2, 1.4, 0.3, glow, Mat.Neon)
		end
		-- 늘어진 빛 실
		for _, t in { { -2.2, -0.4, 1.4 }, { -1, 0.8, 1 }, { 0.2, -0.7, 1.6 }, { 1.4, 0.5, 1.2 }, { 2.4, -0.2, 1.5 } } do
			box(c, t[1], top - t[3], t[2], 0.07, t[3], 0.07, glow, Mat.Neon, 0.3)
		end
	end

	-- 얍섬 돌 화폐(라이): 풀밭 + 돌길 + 길가에 세워 둔 가운데 구멍 뚫린 거대한 돌 원판들(크기 제각각, 뒤로 살짝 기댐)
	--   + 가장 큰 돌의 구멍을 꿴 나무 장대 + 바닥에 누운 돌 + 야자수
	B.yapstone = function(c)
		local stone = c.P
		local grass = mix(c.A, BLACK, 0.1)
		box(c, 0, 0, 0, 9.8, 0.25, 9.8, grass, Mat.Grass)
		box(c, 0, 0.25, -1.2, 9.8, 0.1, 1.8, mix(c.S, WHITE, 0.2), Mat.Slate)
		local function rai(x, z, d, yaw, lean)
			local t = math.max(0.35, d * 0.13)
			local cf = CFrame.new(x, 0.3 + d / 2, z) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(lean, 0, 0)
			cyl(c, cf * ALONG_Z, t, d, stone)
			cyl(c, cf * ALONG_Z, t + 0.06, d * 0.24, DARK)
			return cf
		end
		local big = rai(-2.5, 0.8, 4.2, 0.12, 0.1)
		rai(1.1, 1.2, 3.2, -0.15, 0.08)
		rai(3.6, 1.6, 2.4, 0.25, 0.1)
		rai(-0.6, 3.5, 2.6, 0.3, 0.06)
		rai(2.5, 3.9, 1.8, -0.2, 0.05)
		rai(-4.1, -3, 1.2, 0.4, 0.05)
		beam(c, big.Position - big.LookVector * 1.4, big.Position + big.LookVector * 1.4, 0.2, WOOD, Mat.Wood)
		-- 누운 돌
		cyl(c, CFrame.new(1.6, 0.53, -3.2) * UPRIGHT, 0.36, 2, stone)
		cyl(c, CFrame.new(1.6, 0.53, -3.2) * UPRIGHT, 0.42, 0.5, DARK)
		palm(c, -4.2, 0.25, 3.9, 4.6, 0.5, -0.5, LEAF)
		palm(c, 4.1, 0.25, -3.8, 3.8, -0.5, 0.4, mix(LEAF, GRASS, 0.3))
		palm(c, 4.3, 0.25, 4.3, 3.4, -0.6, -0.6, LEAF)
		ball(c, -1.3, 0.55, -3.9, 1, mix(LEAF, GRASS, 0.4), Mat.Grass)
	end

	-- 질랜디아: 짙은 해저 + 물에 잠긴 긴 대륙(등고선처럼 두 단, 단마다 가장자리가 청록으로 빛남) + 반투명 바다
	--   + 물 위로 나온 뉴질랜드(북섬의 설산 화산, 남섬의 눈 덮인 남알프스) + 뉴칼레도니아 + 채텀 제도 + 탐사선
	B.zealandia = function(c)
		local glow = c.A
		local yaw = -0.67
		box(c, 0, 0, 0, 9.8, 0.25, 9.8, mix(c.S, BLACK, 0.35), Mat.Slate)
		-- 대지: { x, z, 가로, 세로, 비틀기 }, 단마다 { 바닥, 높이, 색 }
		local tiers = {
			{
				0.25,
				0.8,
				mix(c.P, c.S, 0.35),
				{
					{ -2.3, 2.6, 2, 3.8, 0 },
					{ -0.7, 0.7, 3.6, 4.6, 0 },
					{ 1.3, -1.4, 3.4, 4.2, 0.05 },
					{ 2.6, -3.3, 3, 2.2, 0.45 },
				},
			},
			{
				1.05,
				0.55,
				c.P,
				{
					{ -2.2, 2.5, 1.1, 2.8, 0 },
					{ -0.4, 0.4, 2.2, 3.4, 0.1 },
					{ 1.3, -1.3, 2.2, 3.4, 0 },
				},
			},
		}
		for _, tier in tiers do
			local y0, h, color = tier[1], tier[2], tier[3]
			for _, p in tier[4] do
				local cf = CFrame.new(p[1], y0 + h / 2, p[2]) * CFrame.Angles(0, yaw + p[5], 0)
				block(c, cf * CFrame.new(0, -0.08, 0), V(p[3] + 0.28, h - 0.16, p[4] + 0.28), glow, Mat.Neon)
				block(c, cf, V(p[3], h, p[4]), color, Mat.Slate)
			end
		end
		box(c, 0, 0.25, 0, 9.8, 2.1, 9.8, mix(c.S, WATER, 0.5), Mat.Glass, 0.6)
		-- 물 위의 섬들
		local function isle(x, z, w, h, d, turn, color)
			block(c, CFrame.new(x, 1.6 + h / 2, z) * CFrame.Angles(0, turn, 0), V(w, h, d), color, Mat.Grass)
		end
		isle(2, 0.1, 1.2, 1.2, 2.4, -0.55, GRASS)
		isle(1.3, 1.5, 0.6, 1, 1.6, -0.9, GRASS)
		isle(0.6, -2.2, 1.4, 0.9, 3.4, -0.7, mix(GRASS, LEAF, 0.4))
		isle(-2.8, 3.1, 0.6, 0.85, 2.4, -0.9, GRASS)
		isle(4.1, -1, 0.7, 0.85, 0.6, 0, GRASS)
		isle(-0.6, -3.8, 0.6, 0.85, 0.5, 0, GRASS)
		-- 루아페후 화산(원뿔 + 눈) + 남섬 등줄기의 눈 덮인 남알프스(박공 능선)
		col(c, 2.1, 2.8, 0, 0.3, 0.95, ROCK)
		col(c, 2.1, 3.1, 0, 0.3, 0.6, ROCK)
		col(c, 2.1, 3.4, 0, 0.18, 0.3, WHITE, Mat.Snow)
		local alps = CFrame.new(0.6, 2.5, -2.2) * CFrame.Angles(0, -0.7, 0) * CFrame.Angles(0, PI / 2, 0)
		gableAt(c, alps, 3.4, 1.4, 0.9, mix(GRASS, LEAF, 0.4), Mat.Grass)
		gableAt(c, alps * CFrame.new(0, 0.49, 0), 2.6, 0.72, 0.45, WHITE, Mat.Snow)
		-- 탐사선
		box(c, -2.6, 2.35, -2.2, 1.6, 0.35, 0.6, WHITE, Mat.SmoothPlastic)
		box(c, -2.9, 2.7, -2.2, 0.6, 0.4, 0.45, rgb(220, 70, 50), Mat.SmoothPlastic)
	end

	return B
end
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[-- 원격 통신 객체. 서버가 처음 require 할 때 만들고, 클라이언트는 생길 때까지 기다립니다.
-- (Rojo 없이 Studio 에 직접 복사해도 따로 RemoteEvent 를 만들 필요가 없도록)

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local FOLDER_NAME = "LandmarkRNGRemotes"

local FUNCTIONS = {
	"GetState", -- () -> Snapshot?
	"Roll", -- () -> RollResponse (DESIGN.md 참고)
	"Feature", -- (landmarkId?) -> { Ok, State }
	"BuyUpgrade", -- (upgradeId) -> { Ok, Reason?, State }
	"SetSetting", -- (key, value) -> { Ok, State } (key: "AutoFeature" | "AutoPark")
	"SetDisplay", -- (slot, landmarkId?, expected?, expectedFrom?) -> { Ok, Reason?, State } 공원 전시 칸에 명소 놓기/빼기
	-- (expected = 클라이언트가 본 그 칸의 명소 Id, 빈 칸 "". 다르면 Reason "stale")
	"Teleport", -- ("Park" | "Plaza") -> { Ok }
	"Rebirth", -- () -> { Ok, Reason?, State }
	"BuyPass", -- (passKey) -> { Ok } (서버가 게임패스 구매 창을 띄움)
	"BuyProduct", -- (productKey) -> { Ok } (서버가 개발자 상품 구매 창을 띄움)
}

local EVENTS = {
	"State", -- 서버 -> 클라: Snapshot (관광 수입 등 서버 쪽 변화)
	"Announce", -- 서버 -> 모두: 희귀 명소 발견 "뉴스 속보"
	"ServerLuck", -- 서버 -> 모두: 서버 행운 시작/연장 { UserId, Name, Until, Left }
}

local folder: Folder
if RunService:IsServer() then
	folder = Instance.new("Folder")
	folder.Name = FOLDER_NAME
	for _, name in FUNCTIONS do
		local remote = Instance.new("RemoteFunction")
		remote.Name = name
		remote.Parent = folder
	end
	for _, name in EVENTS do
		local remote = Instance.new("RemoteEvent")
		remote.Name = name
		remote.Parent = folder
	end
	folder.Parent = ReplicatedStorage
else
	folder = ReplicatedStorage:WaitForChild(FOLDER_NAME) :: Folder
end

local Net = {}

function Net.fn(name: string): RemoteFunction
	return folder:WaitForChild(name) :: RemoteFunction
end

function Net.event(name: string): RemoteEvent
	return folder:WaitForChild(name) :: RemoteEvent
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">ParkGrid</string>
          <string name="Source"><![CDATA[--!strict
-- 공원 부지 전시 격자(순수 계산: 숫자만) + 3D 배치 모드 규칙. 서버(ParkService: 받침대 자리)와
-- 클라이언트(ParkEdit: 칸 찾기·집어서 옮기기)가 같이 씀. Instance/Vector3 를 쓰지 않아서 테스트에서 바로 돌림.
--
-- 부지 좌표: 부지 중앙 바닥이 원점, -Z = 입구(광장 쪽), +X = 부지 CFrame 의 RightVector (ParkLayout 과 같음).
-- 칸 번호 -> 격자 자리는 PlayerState.slotCell (입구 쪽 줄부터, 한 줄 안에서는 가운데에 가까운 칸부터).
-- 입구에서 공원 안쪽(+Z)을 보면 오른쪽이 -X 라서 slotCell 의 열 1(왼쪽 끝)이 x 가 가장 큰 열.

local Config = require(script.Parent.Config)
local Landmarks = require(script.Parent.Landmarks)
local PlayerState = require(script.Parent.PlayerState)

type Snapshot = PlayerState.Snapshot

local ParkGrid = {}

ParkGrid.GRID = Config.PARK_GRID
ParkGrid.SPACING = 12 -- 칸 가운데 사이 거리(스터드)
ParkGrid.FRONT_MARGIN = 6 -- 입구와 첫 줄 사이 빈 공간
-- 부지 크기(둘레 띠 제외). 서버 ParkLayout.PLOT_WIDTH/PLOT_DEPTH 와 같아야 함(테스트가 확인)
ParkGrid.PLOT_WIDTH = 76
ParkGrid.PLOT_DEPTH = 80
ParkGrid.BASE_TOP = 0.6 -- 부지 윗면 높이
ParkGrid.PEDESTAL_SIZE = 10
ParkGrid.PEDESTAL_HEIGHT = 0.6
ParkGrid.MINIATURE_SIZE = 9
-- 칸 찾기 기본 반지름: 칸 한 변(12)의 네 귀퉁이(가운데에서 8.5)까지 덮음 = 격자 안 어디를 가리켜도 가장 가까운 칸
ParkGrid.SNAP_RADIUS = ParkGrid.SPACING * 0.75

-- 월드 칸 모델(ParkService 가 만드는 Slots 폴더의 칸 Model) 속성 `Look` 값: 명소 Id 이거나 아래 둘 중 하나
-- (명소 Id 는 '#' 으로 시작하지 않음)
ParkGrid.LOOK_LOCKED = "#locked"
ParkGrid.LOOK_EMPTY = "#empty"

local GRID = ParkGrid.GRID
local MIDDLE = (GRID + 1) / 2
local FIRST_ROW_Z = -ParkGrid.PLOT_DEPTH / 2 + ParkGrid.FRONT_MARGIN + ParkGrid.SPACING / 2

-- 칸 가운데(부지 좌표)와 격자 자리 -> 칸 번호
local OFFSETS: { { number } } = {}
local SLOT_BY_CELL: { [number]: number } = {} -- row * 100 + column -> 칸 번호
for slot = 1, GRID * GRID do
	local row, column = PlayerState.slotCell(slot)
	OFFSETS[slot] = { (MIDDLE - column) * ParkGrid.SPACING, FIRST_ROW_Z + (row - 1) * ParkGrid.SPACING }
	SLOT_BY_CELL[row * 100 + column] = slot
end

-- 칸 가운데(부지 좌표 x, z). 받침대 바닥 = 부지 윗면(y = BASE_TOP)
function ParkGrid.slotOffset(slot: number): (number, number)
	local offset = OFFSETS[slot]
	return offset[1], offset[2]
end

-- 부지 좌표 (x, z) 에서 가장 가까운 칸. 그 칸 가운데까지 radius(기본 SNAP_RADIUS)보다 멀면 nil
function ParkGrid.slotAt(x: number, z: number, radius: number?): number?
	if x ~= x or z ~= z then
		return nil
	end
	local column = math.clamp(math.floor(MIDDLE - x / ParkGrid.SPACING + 0.5), 1, GRID)
	local row = math.clamp(math.floor((z - FIRST_ROW_Z) / ParkGrid.SPACING + 1.5), 1, GRID)
	local slot = SLOT_BY_CELL[row * 100 + column]
	local sx, sz = ParkGrid.slotOffset(slot)
	local limit = radius or ParkGrid.SNAP_RADIUS
	if (x - sx) ^ 2 + (z - sz) ^ 2 > limit * limit then
		return nil
	end
	return slot
end

-- 부지 좌표 (x, z) 가 부지 바닥(+ 둘레 margin) 안인지
function ParkGrid.onPlot(x: number, z: number, margin: number?): boolean
	local pad = margin or 0
	return math.abs(x) <= ParkGrid.PLOT_WIDTH / 2 + pad and math.abs(z) <= ParkGrid.PLOT_DEPTH / 2 + pad
end

-- 칸의 지금 모습: "#locked" / "#empty" / 명소 Id (월드 칸 모델의 Look 속성과 같은 값)
function ParkGrid.look(state: Snapshot, slot: number): string
	local slots, unlocked = PlayerState.parkSlots(state)
	if slot > unlocked then
		return ParkGrid.LOOK_LOCKED
	end
	return slots[slot] or ParkGrid.LOOK_EMPTY
end

-- 명소가 전시된 칸(0 = 전시 안 됨)
function ParkGrid.slotOf(state: Snapshot, id: string): number
	local slots, unlocked = PlayerState.parkSlots(state)
	for slot = 1, unlocked do
		if slots[slot] == id then
			return slot
		end
	end
	return 0
end

-- 보관함(배치 모드 아래 띠): 가졌지만 전시 안 된 명소, 희귀한 순서
function ParkGrid.storage(state: Snapshot): { string }
	local slots, unlocked = PlayerState.parkSlots(state)
	local shown: { [string]: boolean } = {}
	for slot = 1, unlocked do
		local id = slots[slot]
		if id then
			shown[id] = true
		end
	end
	local result = {}
	for _, landmark in Landmarks.RarestFirst do
		if (state.Inventory[landmark.Id] or 0) > 0 and not shown[landmark.Id] then
			table.insert(result, landmark.Id)
		end
	end
	return result
end

-- 놓기 계획: 들고 있는 명소(heldId)를 칸 target 에 놓을 때 할 일. 옮기는 명소가 지금 있는 칸(From, 0 = 보관함)은
-- 화면 상태에서 다시 셈(들고 있는 사이 자동 굴림으로 자리가 밀렸을 수 있음).
--   Kind "locked" = 잠긴 칸(알림만), "cancel" = 제자리(내려놓기 취소),
--   "move" = 빈 칸으로 옮김, "swap" = 명소가 있는 칸과 자리 바꿈(Partner 가 From 칸으로 감),
--   "place" = 보관함에서 빈 칸에, "replace" = 보관함에서 명소가 있는 칸에(Partner 는 보관함으로).
-- Expected / ExpectedFrom 은 그대로 SetDisplay(Slot, Id, Expected, ExpectedFrom) 로 보냄(서버가 stale 확인)
export type DropPlan = {
	Kind: string,
	Slot: number,
	Id: string,
	From: number,
	Expected: string,
	Partner: string?,
}

function ParkGrid.dropPlan(state: Snapshot, heldId: string, target: number): DropPlan
	local slots, unlocked = PlayerState.parkSlots(state)
	local from = ParkGrid.slotOf(state, heldId)
	local plan: DropPlan = { Kind = "cancel", Slot = target, Id = heldId, From = from, Expected = "", Partner = nil }
	if target < 1 or target > unlocked then
		plan.Kind = if target >= 1 and target <= PlayerState.MAX_SLOTS then "locked" else "cancel"
		return plan
	end
	local occupant = slots[target]
	plan.Expected = occupant or ""
	if occupant == heldId then
		return plan -- 제자리
	end
	plan.Partner = occupant
	if from > 0 then
		plan.Kind = if occupant then "swap" else "move"
	else
		plan.Kind = if occupant then "replace" else "place"
	end
	return plan
end

-- 보관함에서 집은 명소가 처음 떠 있을 칸: 첫 빈 열린 칸, 없으면(공원 꽉 참) 전시 칸 중 수입이 가장 적은 명소의 칸
-- (PlayerState.betterHidden 이 견주는 명소 — 바꿔 넣으면 수입이 느는 자리, 같으면 앞 번호), 그것도 없으면 1.
-- 칸 번호가 작을수록 입구 쪽 앞줄이라 휴대폰의 좁은 위에서 보기에서도 화면 안(예전엔 부지 가운데 = 화면 위 끝 밖)
function ParkGrid.storageStart(state: Snapshot): number
	local slots, unlocked = PlayerState.parkSlots(state)
	local weakestSlot, weakest = 0, math.huge
	for slot = 1, unlocked do
		local id = slots[slot]
		if not id then
			return slot
		end
		local landmark = Landmarks.ById[id]
		local income = if landmark then PlayerState.landmarkIncome(landmark, state.Inventory[id] or 0) else 0
		if income < weakest then
			weakestSlot, weakest = slot, income
		end
	end
	return if weakestSlot > 0 then weakestSlot else 1
end

-- 보관(들고 있는 전시 명소를 보관함으로): SetDisplay(Slot, nil, Expected). 보관함에서 집은 것이면 nil
function ParkGrid.storePlan(state: Snapshot, heldId: string): { Slot: number, Expected: string }?
	local from = ParkGrid.slotOf(state, heldId)
	if from == 0 then
		return nil
	end
	return { Slot = from, Expected = heldId }
end

-- 위에서 보기 카메라 ----------------------------------------------------------------
-- 입구(-Z) 쪽 위에서 공원 안쪽(+Z)을 TOP_PITCH 각도로 내려다보는 카메라. 격자 앞 Rows 줄(열린 칸이 있는 줄 + 잠긴 줄
-- 하나: 어디가 늘어날지 보이게, ParkGrid.topRows)이 화면에서 HUD 가 가리지 않은 영역 안에 가장 크게 들어오는 거리와
-- 바라보는 곳(부지 좌표)을 찾음. 칸이 적을 때(휴대폰에서 특히) 명소가 작게 보이지 않게 쓰는 줄만 맞춤.
-- 받침대 네 귀퉁이와 명소 꼭대기(TOP_FIT_HEIGHT)까지 넣어서 뒷줄 명소가 화면 위로 잘리지 않게 함.
ParkGrid.TOP_PITCH = math.rad(55)
ParkGrid.TOP_FIT_HEIGHT = 12 -- 명소 꼭대기(받침대 윗면 위) — 큰 모형(최대 약 20)은 조금 잘려도 받침대는 보이게
ParkGrid.TOP_MIN_DISTANCE = 30
ParkGrid.TOP_MAX_DISTANCE = 500

export type TopView = {
	Eye: { number }, -- 부지 좌표 { x, y, z }
	Target: { number },
	Distance: number,
}

-- view: Aspect(가로/세로), Fov(세로 시야각, 도), Left/Right/Top/Bottom(화면 가장자리에서 가리는 비율 0..1),
-- Rows(맞출 앞 줄 수 1..GRID, 기본 GRID), Zoom(1 = 딱 맞게, 클수록 멀리)
export type TopViewInput = {
	Aspect: number,
	Fov: number,
	Left: number?,
	Right: number?,
	Top: number?,
	Bottom: number?,
	Rows: number?,
	Zoom: number?,
}

-- 앞 rows 줄을 맞출 때 화면에 넣을 점(부지 좌표 { x, y, z }): 받침대 네 귀퉁이 + 앞·뒷줄 양끝 명소 꼭대기
local fitCache: { [number]: { { number } } } = {}
function ParkGrid.topFitPoints(rows: number?): { { number } }
	local count = math.clamp(math.floor(rows or GRID), 1, GRID)
	local cached = fitCache[count]
	if cached then
		return cached
	end
	local points: { { number } } = {}
	local edge = (GRID - 1) / 2 * ParkGrid.SPACING + ParkGrid.PEDESTAL_SIZE / 2
	local front = FIRST_ROW_Z - ParkGrid.PEDESTAL_SIZE / 2
	local back = FIRST_ROW_Z + (count - 1) * ParkGrid.SPACING
	local tall = ParkGrid.BASE_TOP + ParkGrid.PEDESTAL_HEIGHT + ParkGrid.TOP_FIT_HEIGHT
	for _, x in { -edge, edge } do
		table.insert(points, { x, ParkGrid.BASE_TOP, front })
		table.insert(points, { x, ParkGrid.BASE_TOP, back + ParkGrid.PEDESTAL_SIZE / 2 })
	end
	-- 명소 꼭대기는 받침대 바깥 끝(edge)까지: 카메라에 가까운 앞줄 양끝 명소가 원근 때문에 화면 옆으로 삐져나가지 않게
	for _, x in { -edge, edge } do
		table.insert(points, { x, tall, FIRST_ROW_Z })
		table.insert(points, { x, tall, back })
	end
	fitCache[count] = points
	return points
end

-- 위에서 보기에서 맞출 줄 수: 열린 칸이 있는 줄 + 잠긴 줄 하나(공원 확장으로 어디가 늘어날지), 최대 GRID
function ParkGrid.topRows(unlocked: number): number
	return math.clamp(math.ceil(math.max(unlocked, 0) / GRID) + 1, 1, GRID)
end

-- 카메라(바라보는 곳 target, 거리 d)로 본 점의 화면 위치(-1..1, 오른쪽·위가 +). 카메라 뒤면 nil
-- 카메라 오른쪽 = 부지 -X (입구에서 안쪽을 볼 때 오른쪽), 위 = 화면 위
function ParkGrid.project(
	point: { number },
	targetX: number,
	targetZ: number,
	distance: number,
	aspect: number,
	fov: number
): (number?, number?)
	local s, c = math.sin(ParkGrid.TOP_PITCH), math.cos(ParkGrid.TOP_PITCH)
	local vx = point[1] - targetX
	local vy = point[2] - (ParkGrid.BASE_TOP + s * distance)
	local vz = point[3] - (targetZ - c * distance)
	local depth = -vy * s + vz * c
	if depth <= 0.1 then
		return nil, nil
	end
	local t = math.tan(math.rad(fov) / 2)
	return -vx / (depth * t * aspect), (vy * c + vz * s) / (depth * t)
end

function ParkGrid.topView(view: TopViewInput): TopView
	local aspect = math.max(view.Aspect, 0.2)
	local fov = math.clamp(view.Fov, 20, 110)
	-- 보이는 영역(-1..1). 가리는 비율이 너무 커도 화면의 10% 는 남김
	local left = -1 + 2 * math.clamp(view.Left or 0, 0, 0.45)
	local right = 1 - 2 * math.clamp(view.Right or 0, 0, 0.45)
	local bottom = -1 + 2 * math.clamp(view.Bottom or 0, 0, 0.45)
	local top = 1 - 2 * math.clamp(view.Top or 0, 0, 0.45)
	local wantX, wantY = (left + right) / 2, (bottom + top) / 2
	local t = math.tan(math.rad(fov) / 2)
	local s = math.sin(ParkGrid.TOP_PITCH)
	local points = ParkGrid.topFitPoints(view.Rows)
	local rows = math.clamp(math.floor(view.Rows or GRID), 1, GRID)

	-- 거리 d 에서 격자 가운데가 영역 가운데에 오게 바라보는 곳을 옮기고(원근 때문에 몇 번 되풀이), 격자 범위를 돌려줌
	local function aim(distance: number): (number, number, number, number, boolean)
		local tx, tz = 0, FIRST_ROW_Z + (rows - 1) * ParkGrid.SPACING / 2
		local width, height, ok = 0, 0, true
		for _ = 1, 8 do
			local minX, maxX, minY, maxY = math.huge, -math.huge, math.huge, -math.huge
			ok = true
			for _, point in points do
				local x, y = ParkGrid.project(point, tx, tz, distance, aspect, fov)
				if not x or not y then
					ok = false
					break
				end
				minX, maxX = math.min(minX, x), math.max(maxX, x)
				minY, maxY = math.min(minY, y), math.max(maxY, y)
			end
			if not ok then
				break
			end
			width, height = maxX - minX, maxY - minY
			-- 카메라를 +X 로 옮기면 화면에서 점들이 오른쪽(+)으로, +Z 로 옮기면 아래(-)로 감
			tx += (wantX - (minX + maxX) / 2) * distance * t * aspect
			tz -= (wantY - (minY + maxY) / 2) * distance * t / s
		end
		return tx, tz, width, height, ok
	end

	local low, high = ParkGrid.TOP_MIN_DISTANCE, ParkGrid.TOP_MAX_DISTANCE
	for _ = 1, 30 do
		local middle = (low + high) / 2
		local _, _, width, height, ok = aim(middle)
		if ok and width <= right - left and height <= top - bottom then
			high = middle
		else
			low = middle
		end
	end
	local distance = math.clamp(high * (view.Zoom or 1), ParkGrid.TOP_MIN_DISTANCE, ParkGrid.TOP_MAX_DISTANCE)
	local tx, tz = aim(distance)
	local c = math.cos(ParkGrid.TOP_PITCH)
	return {
		Eye = { tx, ParkGrid.BASE_TOP + s * distance, tz - c * distance },
		Target = { tx, ParkGrid.BASE_TOP, tz },
		Distance = distance,
	}
end

-- 위에서 보기 배율(Zoom, 1 = 맞출 줄이 딱 맞음, 클수록 멀리) 범위와 휠 한 칸
ParkGrid.ZOOM_MIN, ParkGrid.ZOOM_MAX, ParkGrid.ZOOM_STEP = 0.8, 1.45, 0.08

-- 두 손가락 벌리기/모으기: 손가락을 댔을 때 배율 startZoom · 손가락 사이 거리 startDistance(px) 에서 지금 거리
-- distance 가 되면 새 배율(벌리면 가까이 = 작아짐, 범위 안으로)
function ParkGrid.pinchZoom(startZoom: number, startDistance: number, distance: number): number
	if startDistance <= 0 or distance <= 0 or startDistance ~= startDistance or distance ~= distance then
		return math.clamp(startZoom, ParkGrid.ZOOM_MIN, ParkGrid.ZOOM_MAX)
	end
	return math.clamp(startZoom * startDistance / distance, ParkGrid.ZOOM_MIN, ParkGrid.ZOOM_MAX)
end

-- 자동 배치를 켜면 지금 배치가 바뀌는지 (바뀌면 [자동] 을 한 번 더 눌러 "확인?")
function ParkGrid.autoWouldChange(state: Snapshot): boolean
	local slots, unlocked = PlayerState.parkSlots(state)
	local auto = table.clone(state) :: any
	auto.Settings = table.clone(state.Settings)
	auto.Settings.AutoPark = true
	local best = PlayerState.parkSlots(auto)
	for slot = 1, unlocked do
		if slots[slot] ~= best[slot] then
			return true
		end
	end
	return false
end

-- 스냅샷 사본(배치에 필요한 표만 새로)에 편집을 적용해서 돌려줌(미리 보기). edit 가 false 면 nil
function ParkGrid.preview(state: Snapshot, edit: (any) -> boolean): Snapshot?
	local copy = table.clone(state) :: any
	copy.Settings = table.clone(state.Settings)
	copy.Display = table.clone((state :: any).Display or {})
	if not edit(copy) then
		return nil
	end
	copy.Income = PlayerState.incomePerSecond(copy, copy)
	return copy
end

return ParkGrid
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">PlayerState</string>
          <string name="Source"><![CDATA[--!strict
-- 플레이어 데이터와 그 데이터를 바꾸는 규칙(순수 함수). 서버가 유일한 진실의 원천이고,
-- 클라이언트는 Snapshot 만 받아서 화면에 그립니다. Roblox 서비스에 의존하지 않아 테스트 가능.
-- 읽기 전용 함수(luck, permanentLuck, park, parkSlots, stars, incomePerSecond 등)는 Data 대신 Snapshot 을 넘겨도 됩니다.
-- luck / permanentLuck / autoDiscover / rollLuck / cooldown / incomePerSecond / addIncome / snapshot / sync 는
-- 선택 인자 mods(게임패스·서버 행운)를 받습니다.
-- mods 가 없으면 게임패스·서버 행운 없이 계산합니다. Snapshot 은 Passes/ServerLuck 필드가 있어서
-- PlayerState.luck(snapshot, snapshot) 처럼 mods 자리에 그대로 넘겨도 됩니다.

local Config = require(script.Parent.Config)
local Landmarks = require(script.Parent.Landmarks)

type Landmark = Landmarks.Landmark
type GamePass = Config.GamePass
type Product = Config.Product

export type Settings = {
	AutoFeature: boolean, -- 더 희귀한 명소를 발견하면 자동으로 대표 명소로 지정
	AutoPark: boolean, -- true: 공원 전시를 희귀한 순서로 자동 배치 / false: 플레이어가 고른 배치(Data.Display)
}

-- 세션에만 있는 효과(저장 안 함). 서버가 만들어서 넘김
export type Mods = {
	Passes: { [string]: boolean }?, -- 가진 게임패스 Id -> true
	ServerLuck: boolean?, -- 서버 전체 행운 부스트 중인지
}

export type RebirthRequirement = {
	Coins: number,
	Landmarks: { string }, -- 이번 판에 보유해야 하는 명소 Id
}

-- 상품 지급 결과(grantProduct)
export type Grant = {
	Product: string, -- 상품 Id (Config.Products 의 Id)
	Coins: number, -- 더해진 코인(코인 팩)
	Seconds: number, -- 더해진 부스트 시간(초)
	ServerWide: boolean, -- true 면 서버가 서버 행운 타이머에 Seconds 를 더해야 함(Data 는 안 바뀜)
}

export type Data = {
	Rolls: number,
	Coins: number, -- 관광 수입이 초 단위로 쌓이므로 소수일 수 있음(표시할 때 버림)
	Inventory: { [string]: number }, -- 이번 판에 보유한 명소 Id -> 발견 횟수 (환생하면 비움)
	Discovered: { [string]: boolean }, -- 한 번이라도 발견한 명소 Id -> true (환생해도 유지. 도감·여권 기준)
	Featured: string?, -- 대표 명소(캐릭터 옆에 떠 다님)
	Upgrades: { [string]: number }, -- 업그레이드 Id -> 레벨
	Settings: Settings,
	-- 직접 고른 공원 배치(AutoPark = false 일 때만 씀): 전시 칸 번호 -> 명소 Id, 빈 칸은 "".
	-- 구멍 없는 배열(DataStore 안전), 길이 ≤ PARK_GRID². 보유하지 않거나 겹치는 Id 는 전시할 때 건너뜀
	Display: { string },
	Rebirths: number, -- 환생 횟수
	Boosts: { [string]: number }, -- 개인 시간 부스트 상품 Id -> 남은 초(접속 중에만 줄어듦)
	Receipts: { string }, -- 최근에 지급한 구매 영수증 PurchaseId (중복 지급 방지, 최근 MAX_RECEIPTS 개)
}

export type Snapshot = {
	Revision: number,
	Rolls: number,
	Coins: number,
	Inventory: { [string]: number },
	Discovered: { [string]: boolean },
	Featured: string?,
	Upgrades: { [string]: number },
	Settings: Settings,
	Display: { string }, -- 직접 고른 공원 배치(복사본). 전시 칸은 PlayerState.parkSlots(snapshot) 로 계산
	Rebirths: number,
	Boosts: { [string]: number }, -- 개인 부스트 남은 초
	Passes: { [string]: boolean }, -- 가진 게임패스
	ServerLuck: boolean, -- 서버 행운 부스트 중인지
	NextRebirth: RebirthRequirement?, -- 다음 환생 조건(최대까지 했으면 nil)
	Luck: number, -- mods 반영
	-- 영구 행운 = Luck 에서 시간 부스트·서버 행운을 뺀 값(PlayerState.permanentLuck). 확률(OneIn)이 이 값 이하인
	-- 명소는 자동 발견(Discovered 에 이미 들어 있음)이고 부스트 없이는 굴림에서 다시 안 나옴
	PermanentLuck: number,
	Cooldown: number, -- mods 반영
	Income: number, -- 초당 관광 수입(mods 반영)
}

export type Upgrade = typeof(Config.Upgrades[1])

local PlayerState = {}

PlayerState.UpgradesById = {} :: { [string]: Upgrade }
for _, upgrade in Config.Upgrades do
	PlayerState.UpgradesById[upgrade.Id] = upgrade
end

PlayerState.PassesById = {} :: { [string]: GamePass }
for _, pass in Config.GamePasses do
	PlayerState.PassesById[pass.Id] = pass
end

PlayerState.ProductsById = {} :: { [string]: Product }
for _, product in Config.Products do
	PlayerState.ProductsById[product.Id] = product
end

-- 공원 전시 칸 최대 수(격자 칸 수) = Data.Display 최대 길이
PlayerState.MAX_SLOTS = Config.PARK_GRID * Config.PARK_GRID
-- 별 최대 개수(★5). 처음 발견 = 별 0, 같은 명소를 또 뽑을 때마다 +1
PlayerState.MAX_STARS = #Config.STAR_THRESHOLDS

function PlayerState.new(): Data
	local upgrades = {}
	for _, upgrade in Config.Upgrades do
		upgrades[upgrade.Id] = 0
	end
	return {
		Rolls = 0,
		Coins = 0,
		Inventory = {},
		Discovered = {},
		Featured = nil,
		Upgrades = upgrades,
		Settings = { AutoFeature = true, AutoPark = true },
		Display = {},
		Rebirths = 0,
		Boosts = {},
		Receipts = {},
	}
end

local function nonNegativeInt(value: any): number?
	if type(value) == "number" and value == value and value >= 0 and value < math.huge then
		return math.floor(value)
	end
	return nil
end

-- 개인 시간 부스트 상품인지(Data.Boosts 에 남은 시간이 쌓이는 상품)
local function isPersonalBoost(product: Product): boolean
	return product.Seconds ~= nil and not product.ServerWide
end

local function trimReceipts(receipts: { string })
	while #receipts > Config.MAX_RECEIPTS do
		table.remove(receipts, 1)
	end
end

-- 배치 끝의 빈 칸("")은 저장할 필요가 없으므로 잘라 냄
local function trimDisplay(display: { string })
	while #display > 0 and display[#display] == "" do
		table.remove(display)
	end
end

-- 저장된 배치(형식 보장 없음) -> 구멍 없는 문자열 배열. 문자열이 아니거나 앞 칸과 겹치는 Id 는 빈 칸("").
-- 모르는 명소 Id 는 보존(보유 명소처럼 명소를 잠시 뺐다가 다시 넣어도 안전, 전시할 때만 건너뜀)
local function cleanDisplay(raw: any): { string }
	local display = {}
	if type(raw) ~= "table" then
		return display
	end
	local seen = {}
	for slot = 1, PlayerState.MAX_SLOTS do
		local id = raw[slot]
		if type(id) == "string" and id ~= "" and not seen[id] then
			seen[id] = true
			display[slot] = id
		else
			display[slot] = ""
		end
	end
	trimDisplay(display)
	return display
end

-- display[slot] = id. 사이에 빈 자리가 생기면 ""로 채워서 구멍 없는 배열을 유지
local function setEntry(display: { string }, slot: number, id: string)
	for i = #display + 1, slot - 1 do
		display[i] = ""
	end
	display[slot] = id
end

-- DataStore 에서 읽은 값(형식 보장 없음)을 안전한 Data 로 정리합니다.
-- 모르는 명소 Id 의 발견 횟수는 지우지 않고 보존합니다(명소를 잠시 뺐다가 다시 넣어도 안전).
function PlayerState.reconcile(raw: any): Data
	local data = PlayerState.new()
	if type(raw) ~= "table" then
		return data
	end

	data.Rolls = nonNegativeInt(raw.Rolls) or 0
	data.Coins = nonNegativeInt(raw.Coins) or 0
	data.Rebirths = nonNegativeInt(raw.Rebirths) or 0

	if type(raw.Inventory) == "table" then
		for id, count in raw.Inventory do
			local n = nonNegativeInt(count)
			if type(id) == "string" and n and n > 0 then
				data.Inventory[id] = n
			end
		end
	end

	if type(raw.Discovered) == "table" then
		for id, flag in raw.Discovered do
			if type(id) == "string" and flag == true then
				data.Discovered[id] = true
			end
		end
	end
	-- 보유한 명소는 항상 발견한 명소(Discovered 가 없던 예전 저장도 여기서 채워짐)
	for id in data.Inventory do
		data.Discovered[id] = true
	end

	if type(raw.Featured) == "string" and Landmarks.ById[raw.Featured] and data.Inventory[raw.Featured] then
		data.Featured = raw.Featured
	end

	if type(raw.Upgrades) == "table" then
		for _, upgrade in Config.Upgrades do
			local level = nonNegativeInt(raw.Upgrades[upgrade.Id])
			if level then
				data.Upgrades[upgrade.Id] = math.min(level, upgrade.MaxLevel)
			end
		end
	end

	if type(raw.Settings) == "table" then
		if type(raw.Settings.AutoFeature) == "boolean" then
			data.Settings.AutoFeature = raw.Settings.AutoFeature
		end
		-- 예전 저장에는 없음 -> 기본값(자동 배치) = 예전과 같은 공원
		if type(raw.Settings.AutoPark) == "boolean" then
			data.Settings.AutoPark = raw.Settings.AutoPark
		end
	end
	data.Display = cleanDisplay(raw.Display)

	if type(raw.Boosts) == "table" then
		for _, product in Config.Products do
			local left = raw.Boosts[product.Id]
			if isPersonalBoost(product) and type(left) == "number" and left == left and left > 0 then
				data.Boosts[product.Id] = math.min(left, Config.MAX_BOOST_STORED_SECONDS)
			end
		end
	end

	if type(raw.Receipts) == "table" then
		for _, purchaseId in ipairs(raw.Receipts) do
			if type(purchaseId) == "string" then
				table.insert(data.Receipts, purchaseId)
			end
		end
		trimReceipts(data.Receipts)
	end

	return data
end

-- 업그레이드 ---------------------------------------------------------------

function PlayerState.upgradeLevel(data: Data | Snapshot, upgradeId: string): number
	return data.Upgrades[upgradeId] or 0
end

-- 현재 레벨에서 다음 레벨로 가는 가격. 최대 레벨이면 nil.
function PlayerState.upgradePrice(upgradeId: string, level: number): number?
	local upgrade = PlayerState.UpgradesById[upgradeId]
	if not upgrade or level >= upgrade.MaxLevel then
		return nil
	end
	return math.floor(upgrade.BasePrice * upgrade.Growth ^ level)
end

-- 직접 배치 중 공원 확장으로 새로 열린 칸 채우기 (아래 "관광 공원" 에서 정의)
local fillSlots: (data: Data, from: number, to: number) -> ()

-- 반환: 성공 여부, 실패 사유(표시용)
function PlayerState.buyUpgrade(data: Data, upgradeId: any): (boolean, string?)
	local upgrade = if type(upgradeId) == "string" then PlayerState.UpgradesById[upgradeId] else nil
	if not upgrade then
		return false, "존재하지 않는 업그레이드입니다"
	end
	local level = PlayerState.upgradeLevel(data, upgrade.Id)
	local price = PlayerState.upgradePrice(upgrade.Id, level)
	if not price then
		return false, "이미 최대 레벨입니다"
	end
	if data.Coins < price then
		return false, "코인이 부족합니다"
	end
	local slotsBefore = PlayerState.slots(data)
	data.Coins -= price
	data.Upgrades[upgrade.Id] = level + 1
	if upgrade.Id == "Park" then
		fillSlots(data, slotsBefore + 1, PlayerState.slots(data))
	end
	return true, nil
end

-- 발견 기록 / 여권 도장 -------------------------------------------------------

-- 한 번이라도 발견한 명소인지(환생해도 유지). 도감의 발견/미발견과 여권은 이것 기준.
function PlayerState.isDiscovered(data: Data | Snapshot, landmarkId: string): boolean
	local discovered = data.Discovered
	if discovered and discovered[landmarkId] then
		return true
	end
	return (data.Inventory[landmarkId] or 0) > 0
end

-- 이 명소가 여권 도장 조건에 들어가는지 (전설급은 보너스 수집이라 제외)
function PlayerState.countsForStamp(landmark: Landmark): boolean
	return landmark.Tier.Rank <= Config.STAMP_MAX_RANK
end

-- 대륙의 도장 진행도: 발견한 수, 필요한 수 (도장 조건에 드는 명소만, 역대 발견 기록 기준)
function PlayerState.regionProgress(data: Data | Snapshot, regionId: string): (number, number)
	local found, required = 0, 0
	for _, landmark in Landmarks.ByRegion[regionId] or {} do
		if PlayerState.countsForStamp(landmark) then
			required += 1
			if PlayerState.isDiscovered(data, landmark.Id) then
				found += 1
			end
		end
	end
	return found, required
end

-- 도장을 받은 대륙 Id 목록 (Landmarks.Regions 순서)
function PlayerState.completedRegions(data: Data | Snapshot): { string }
	local completed = {}
	for _, region in Landmarks.Regions do
		local found, required = PlayerState.regionProgress(data, region.Id)
		if required > 0 and found >= required then
			table.insert(completed, region.Id)
		end
	end
	return completed
end

-- 부스트 / 게임패스 -----------------------------------------------------------

local function rebirthsOf(data: Data | Snapshot): number
	return data.Rebirths or 0
end

-- 환생 rebirths 번의 행운 배율 = REBIRTH_LUCK_MULT ^ 환생 수 (1, 2, 4, … 10번 = 1,024). MAX_REBIRTHS 에서 멈춤
function PlayerState.rebirthLuckMult(rebirths: number): number
	local n = math.clamp(math.floor(rebirths), 0, Config.MAX_REBIRTHS)
	return Config.REBIRTH_LUCK_MULT ^ n
end

-- 환생 rebirths 번의 관광 수입 배율 = 1 + REBIRTH_INCOME_BONUS × 환생 수 (MAX_REBIRTHS 에서 멈춤)
function PlayerState.rebirthIncomeMult(rebirths: number): number
	local n = math.clamp(math.floor(rebirths), 0, Config.MAX_REBIRTHS)
	return 1 + Config.REBIRTH_INCOME_BONUS * n
end

-- mods 에 있는 게임패스 목록(Config.GamePasses 순서)
local function ownedPasses(mods: Mods?): { GamePass }
	local list = {}
	local passes = if mods then mods.Passes else nil
	if passes then
		for _, pass in Config.GamePasses do
			if passes[pass.Id] == true then
				table.insert(list, pass)
			end
		end
	end
	return list
end

-- 개인 부스트 남은 초(없으면 0)
function PlayerState.boostLeft(data: Data | Snapshot, productKey: string): number
	local boosts = data.Boosts
	return if boosts then boosts[productKey] or 0 else 0
end

-- 남은 시간 left 에 seconds 를 더한 값. 이미 결제된 시간이라 구매 창 상한(MAX_BOOST_SECONDS)으로 자르지 않고,
-- 데이터 손상 방지용 상한(MAX_BOOST_STORED_SECONDS)까지만 막음. 개인 부스트와 서버 행운이 같이 씀
function PlayerState.stackSeconds(left: number, seconds: number): number
	return math.min(Config.MAX_BOOST_STORED_SECONDS, math.max(0, left) + math.max(0, seconds))
end

-- 개인 시간 부스트(예: LuckBoost)의 남은 시간을 더함(stackSeconds). 개인 부스트 상품이 아니면 false.
function PlayerState.addBoost(data: Data, productKey: any): boolean
	local product = if type(productKey) == "string" then PlayerState.ProductsById[productKey] else nil
	if not product or not isPersonalBoost(product) then
		return false
	end
	local left = data.Boosts[product.Id] or 0
	data.Boosts[product.Id] = PlayerState.stackSeconds(left, product.Seconds or 0)
	return true
end

-- 접속 중 dt 초만큼 부스트 시간을 줄임. 끝난 부스트가 있으면 true.
function PlayerState.tickBoosts(data: Data, dt: number): boolean
	if not (dt > 0) then
		return false
	end
	local expired = false
	for id, left in data.Boosts do
		local after = left - dt
		if after > 0 then
			data.Boosts[id] = after
		else
			data.Boosts[id] = nil
			expired = true
		end
	end
	return expired
end

-- 행운 / 속도 -----------------------------------------------------------------

-- 영구 행운 = 기본 × 지구본 × 여권 도장 × 환생(2^환생 수) × 행운 VIP (시간 부스트·서버 행운 제외).
-- 자동 발견(autoDiscover) 기준. 지구본은 환생하면 0 레벨로 돌아가므로 "영구"는 부스트가 아니라는 뜻
function PlayerState.permanentLuck(data: Data | Snapshot, mods: Mods?): number
	local globe = PlayerState.UpgradesById.Globe
	local globeMult = 1 + globe.PerLevel * PlayerState.upgradeLevel(data, "Globe")
	local regionMult = 1 + Config.REGION_LUCK_BONUS * #PlayerState.completedRegions(data)
	local luck = Config.BASE_LUCK * globeMult * regionMult * PlayerState.rebirthLuckMult(rebirthsOf(data))
	for _, pass in ownedPasses(mods) do
		luck *= pass.LuckMult or 1
	end
	return luck
end

-- 이번 굴림에 적용할 행운 = 영구 행운 × 행운 부스트 × 서버 행운
function PlayerState.luck(data: Data | Snapshot, mods: Mods?): number
	local luck = PlayerState.permanentLuck(data, mods)
	local serverLuck = mods ~= nil and mods.ServerLuck == true
	for _, product in Config.Products do
		if product.ServerWide then
			if serverLuck then
				luck *= product.LuckMult or 1
			end
		elseif product.Seconds and PlayerState.boostLeft(data, product.Id) > 0 then
			luck *= product.LuckMult or 1
		end
	end
	return luck
end

-- 자동 발견: 굴림은 희귀한 것부터 "행운 / N" 판정이라 행운 ≥ N 이면 그보다 흔한 명소는 다시는 안 나옴(RollLogic).
-- 그래서 아직 발견하지 않은 명소 중 확률(OneIn)이 영구 행운(permanentLuck) 이하인 것은 발견한 것으로 칩니다
-- (도감·여권 도장 기준인 Discovered 에 기록 — 행운이 나중에 내려가도 유지). 보유(Inventory)·공원 수입·
-- 환생 조건·발견 보너스 코인은 그대로. 새로 채운 도장이 행운을 올리면 한 번 더 확인합니다.
-- 서버는 직접 부르지 않고 PlayerState.sync(상태 보내기 전 — 접속·굴림·업그레이드·환생·게임패스)와
-- PlayerState.rollLuck(굴리기 전)로만 씀(빠뜨리면 도감·여권이 굴린 명소만 세게 되므로 한곳에 묶어 둠 — 테스트가 확인).
-- 반환: 이번에 새로 발견 처리한 명소 Id 목록(흔한 것 → 희귀한 것)
function PlayerState.autoDiscover(data: Data, mods: Mods?): { string }
	local added = {}
	while true do
		local luck = PlayerState.permanentLuck(data, mods)
		local changed = false
		for _, landmark in Landmarks.List do
			if landmark.OneIn > luck then
				break -- List 는 흔한 것 → 희귀한 것
			end
			if not PlayerState.isDiscovered(data, landmark.Id) then
				data.Discovered[landmark.Id] = true
				table.insert(added, landmark.Id)
				changed = true
			end
		end
		if not changed then
			return added
		end
	end
end

-- 서버 굴림에 쓸 행운: 먼저 자동 발견(새 도장이 영구 행운을 올릴 수 있음), 그다음 luck(부스트·서버 행운 포함)
function PlayerState.rollLuck(data: Data, mods: Mods?): number
	PlayerState.autoDiscover(data, mods)
	return PlayerState.luck(data, mods)
end

function PlayerState.cooldown(data: Data | Snapshot, mods: Mods?): number
	local agency = PlayerState.UpgradesById.Agency
	local cooldown = Config.ROLL_COOLDOWN * (1 - agency.PerLevel * PlayerState.upgradeLevel(data, "Agency"))
	for _, pass in ownedPasses(mods) do
		cooldown *= pass.CooldownMult or 1
	end
	return cooldown
end

-- 관광 공원 ---------------------------------------------------------------

function PlayerState.slots(data: Data | Snapshot): number
	local park = PlayerState.UpgradesById.Park
	return Config.BASE_SLOTS + park.PerLevel * PlayerState.upgradeLevel(data, "Park")
end

-- 이번 판 발견 횟수(보유 수) -> 별 개수(0~MAX_STARS). 가챠 중복처럼 처음 발견 = 별 0, 또 뽑을 때마다 +1
-- (STAR_THRESHOLDS = { 2, 3, 4, 5, 6 }: 2번째 ★1 … 6번째 ★5). 보유하지 않았어도(0) 별 0 이므로 보유 여부는
-- 개수(count > 0)로 판단. 별은 개수로 계산하고 따로 저장하지 않음
function PlayerState.stars(count: number): number
	local stars = 0
	for i, threshold in Config.STAR_THRESHOLDS do
		if count >= threshold then
			stars = i
		end
	end
	return stars
end

-- 전시 칸 번호 -> 격자 자리. 칸 번호는 입구 쪽 줄부터, 한 줄 안에서는 가운데에 가까운 칸부터
-- (입구에서 공원 안쪽을 볼 때 가운데 오른쪽 → 가운데 왼쪽 → 그 바깥 오른쪽 → …)라서 자동 배치에서는
-- 가장 희귀한 명소가 입구 정면에 옴. 월드 받침대(ParkService)와 공원 배치 창(Panels)이 같은 표를 씀.
local SLOT_CELLS: { { number } } = {}
do
	local grid = Config.PARK_GRID
	local middle = (grid + 1) / 2
	-- 부지 좌표 열 c(1..grid, x = (c - middle) 칸). 가운데에 가까운 열부터, 같으면 x 가 작은 열부터
	local columns = {}
	for c = 1, grid do
		table.insert(columns, c)
	end
	table.sort(columns, function(a: number, b: number): boolean
		local da, db = math.abs(a - middle), math.abs(b - middle)
		if da ~= db then
			return da < db
		end
		return a < b
	end)
	for row = 1, grid do
		for _, c in columns do
			-- 입구에서 공원 안쪽(부지 +Z)을 보면 오른쪽이 -X 라서, 보이는 대로의 열 번호는 좌우가 뒤집힘
			table.insert(SLOT_CELLS, { row, grid + 1 - c })
		end
	end
end

-- 반환: row(1 = 입구 쪽 줄 … PARK_GRID = 맨 안쪽 줄), column(1 = 입구에서 공원 안쪽을 볼 때 왼쪽 끝)
function PlayerState.slotCell(slot: number): (number, number)
	local cell = SLOT_CELLS[slot]
	return cell[1], cell[2]
end

-- 열린 전시 칸 수(격자 칸 수까지)
local function unlockedSlots(data: Data | Snapshot): number
	return math.clamp(PlayerState.slots(data), 0, PlayerState.MAX_SLOTS)
end

local function autoParkOn(data: Data | Snapshot): boolean
	return data.Settings.AutoPark ~= false -- 설정이 없던 예전 데이터/스냅샷은 자동 배치
end

-- 전시 칸마다 전시되는 명소. 반환: 칸 번호 -> 명소 Id(빈 칸은 nil), 열린 칸 수.
-- 자동 배치: 이번 판에 가진 명소를 희귀한 순서로 1번 칸부터.
-- 직접 배치: Display 에서 열린 칸만, 보유한 명소만, 같은 명소는 앞 칸 하나만.
function PlayerState.parkSlots(data: Data | Snapshot): ({ [number]: string }, number)
	local unlocked = unlockedSlots(data)
	local result: { [number]: string } = {}
	if autoParkOn(data) then
		local slot = 0
		for _, landmark in Landmarks.RarestFirst do
			if slot >= unlocked then
				break
			end
			if (data.Inventory[landmark.Id] or 0) > 0 then
				slot += 1
				result[slot] = landmark.Id
			end
		end
	else
		local display = data.Display or {}
		local seen = {}
		for slot = 1, unlocked do
			local id = display[slot]
			if type(id) == "string" and not seen[id] and Landmarks.ById[id] and (data.Inventory[id] or 0) > 0 then
				seen[id] = true
				result[slot] = id
			end
		end
	end
	return result, unlocked
end

-- 공원에 전시되는 명소 Id 목록(칸 번호 순서). 자동 배치면 희귀한 순서로 전시 칸 수만큼
function PlayerState.park(data: Data | Snapshot): { string }
	local slots, unlocked = PlayerState.parkSlots(data)
	local result = {}
	for slot = 1, unlocked do
		local id = slots[slot]
		if id then
			table.insert(result, id)
		end
	end
	return result
end

-- 지금 보이는 전시 그대로 Display 에 옮겨 적음: 자동 배치를 끌 때 시작 배치,
-- 직접 배치 편집 전 정리(보유하지 않거나 겹치거나 잠긴 칸의 Id 는 빠짐)
local function freezeDisplay(data: Data)
	local slots, unlocked = PlayerState.parkSlots(data)
	local display = {}
	for slot = 1, unlocked do
		display[slot] = slots[slot] or ""
	end
	trimDisplay(display)
	data.Display = display
end

-- 칸 하나에 명소를 놓거나(landmarkId) 비움(nil). 이미 다른 칸에 있는 명소면 그 칸과 자리를 바꿈
-- (그 칸에는 이 칸에 있던 명소가 가거나 빈 칸이 됨). 자동 배치 중이면 지금 자동 배치에서 시작하고 자동 배치를 끔.
-- slot: 1..열린 칸 수 정수, landmarkId: 보유한 명소 Id 또는 nil.
-- expected(선택): 요청한 쪽이 본 그 칸의 명소 Id(빈 칸은 ""). 지금 그 칸에 보이는 것과 다르면 아무것도 바꾸지 않고
--   "stale" — 클라이언트 화면이 늦은 사이(예: 자동 굴림이 빈 칸에 새 명소를 놓음) 그 명소를 모르고 덮어쓰지 않게.
--   nil 이면 확인하지 않음(서버 내부 · 옛 클라이언트).
-- 반환: 성공 여부, 실패 사유(표시용 문장, 또는 "stale")
function PlayerState.setDisplay(
	data: Data,
	slot: any,
	landmarkId: any,
	expected: any?,
	expectedFrom: any?
): (boolean, string?)
	if type(slot) ~= "number" or slot ~= slot or slot % 1 ~= 0 or slot < 1 or slot > PlayerState.MAX_SLOTS then
		return false, "잘못된 칸입니다"
	end
	if slot > unlockedSlots(data) then
		return false, "잠긴 칸입니다"
	end
	if landmarkId ~= nil then
		local known = type(landmarkId) == "string" and Landmarks.ById[landmarkId] ~= nil
		if not known or (data.Inventory[landmarkId] or 0) <= 0 then
			return false, "보유하지 않은 명소입니다"
		end
	end
	if expected ~= nil or (landmarkId ~= nil and expectedFrom ~= nil) then
		local shown, unlocked = PlayerState.parkSlots(data)
		if expected ~= nil and (type(expected) ~= "string" or (shown[slot] or "") ~= expected) then
			return false, "stale"
		end
		-- 옮기는 명소가 클라이언트가 본 칸(0 = 전시 안 됨)에 그대로 있는지. 자동 배치에서 새로 뽑은 명소가
		-- 옮기던 명소를 밀어냈는데 그대로 옮기면, 자리 바꿀 상대가 옮겨지지 않고 빠져 버림
		if landmarkId ~= nil and expectedFrom ~= nil then
			local current = 0
			for s = 1, unlocked do
				if shown[s] == landmarkId then
					current = s
					break
				end
			end
			if type(expectedFrom) ~= "number" or expectedFrom ~= current then
				return false, "stale"
			end
		end
	end
	freezeDisplay(data)
	data.Settings.AutoPark = false
	local display = data.Display
	local id: string = landmarkId or ""
	if id ~= "" then
		local from = table.find(display, id)
		if from and from ~= slot then
			display[from] = display[slot] or ""
		end
	end
	setEntry(display, slot, id)
	trimDisplay(display)
	return true, nil
end

-- 자동 배치 켜기/끄기. 켜면 희귀한 순서로 다시 채움(직접 배치는 지움),
-- 끄면 지금 자동 배치 그대로에서 시작(화면은 안 바뀜)
function PlayerState.setAutoPark(data: Data, on: boolean)
	if on then
		data.Settings.AutoPark = true
		table.clear(data.Display)
	elseif autoParkOn(data) then
		freezeDisplay(data)
		data.Settings.AutoPark = false
	end
end

-- 자동 배치로 되돌림(가장 희귀한 명소들로 다시 채움)
function PlayerState.autoPark(data: Data)
	PlayerState.setAutoPark(data, true)
end

-- 직접 배치 중 이번 판에 처음 얻은 명소: 첫 빈 칸(칸 번호 순서)에 전시. 빈 칸이 없으면 전시 안 함
local function placeNew(data: Data, id: string)
	if autoParkOn(data) then
		return
	end
	local slots, unlocked = PlayerState.parkSlots(data)
	local empty: number? = nil
	for slot = 1, unlocked do
		local shown = slots[slot]
		if shown == id then
			return -- 이미 전시 중
		elseif not shown and not empty then
			empty = slot
		end
	end
	if empty then
		setEntry(data.Display, empty, id)
	end
end

-- 직접 배치 중 새로 열린 칸(from..to 중 빈 칸)을 아직 전시하지 않은 보유 명소로 희귀한 순서대로 채움
function fillSlots(data: Data, from: number, to: number)
	if autoParkOn(data) then
		return
	end
	local slots, unlocked = PlayerState.parkSlots(data)
	local shown = {}
	for slot = 1, unlocked do
		local id = slots[slot]
		if id then
			shown[id] = true
		end
	end
	local rarest = Landmarks.RarestFirst
	local index = 1
	for slot = math.max(1, from), math.min(to, unlocked) do
		if not slots[slot] then
			while index <= #rarest do
				local landmark = rarest[index]
				index += 1
				if not shown[landmark.Id] and (data.Inventory[landmark.Id] or 0) > 0 then
					shown[landmark.Id] = true
					setEntry(data.Display, slot, landmark.Id)
					break
				end
			end
		end
	end
end

-- 명소 1개의 초당 수입 (입장료 업그레이드 제외) = 등급 수입 × (1 + 별 보너스 × 별 수). 보유하지 않으면 0
function PlayerState.landmarkIncome(landmark: Landmark, count: number): number
	if not (count > 0) then
		return 0
	end
	local base = Config.TIER_INCOME[landmark.Tier.Rank] or 0
	return base * (1 + Config.STAR_INCOME_BONUS * PlayerState.stars(count))
end

-- 직접 배치 중 "전시하면 수입이 느는데 전시 안 된" 보유 명소 Id 목록(희귀한 순서): 전시 칸에 있는 명소 중
-- 가장 수입이 적은 것보다 수입이 큰 것. 전시된 명소가 하나도 없으면 수입이 있는 보유 명소 전부.
-- 자동 배치면 빈 목록(자동 배치가 알아서 채움). 배치 버튼 숫자 배지 · "공원 꽉 참" 알림 기준
function PlayerState.betterHidden(data: Data | Snapshot): { string }
	local result = {}
	if autoParkOn(data) then
		return result
	end
	local slots, unlocked = PlayerState.parkSlots(data)
	if unlocked <= 0 then
		return result
	end
	local shown: { [string]: boolean } = {}
	local weakest: number? = nil
	for slot = 1, unlocked do
		local id = slots[slot]
		if id then
			shown[id] = true
			local income = PlayerState.landmarkIncome(Landmarks.ById[id], data.Inventory[id] or 0)
			weakest = if weakest then math.min(weakest, income) else income
		end
	end
	local floor = weakest or 0
	for _, landmark in Landmarks.RarestFirst do
		local count = data.Inventory[landmark.Id] or 0
		if count > 0 and not shown[landmark.Id] and PlayerState.landmarkIncome(landmark, count) > floor then
			table.insert(result, landmark.Id)
		end
	end
	return result
end

-- 직접 배치 중 이번 판에 처음 얻은 명소(보유 1개)가 공원이 꽉 차서(빈 열린 칸이 없어서) 전시되지 못했는지.
-- 굴림 연출이 끝난 뒤 "공원 꽉 참" 알림 기준(자동 배치면 늘 false — 자동 배치가 알아서 채움)
function PlayerState.missedByFullPark(data: Data | Snapshot, landmarkId: string): boolean
	if autoParkOn(data) or (data.Inventory[landmarkId] or 0) ~= 1 then
		return false
	end
	local slots, unlocked = PlayerState.parkSlots(data)
	for slot = 1, unlocked do
		local id = slots[slot]
		if id == landmarkId or id == nil then
			return false -- 전시 중이거나, 빈 칸이 있음(꽉 차서 못 놓인 게 아님)
		end
	end
	return true
end

-- 초당 관광 수입 = 전시 명소 합 × 입장료 × 환생 × 수입 2배 게임패스
function PlayerState.incomePerSecond(data: Data | Snapshot, mods: Mods?): number
	local total = 0
	for _, id in PlayerState.park(data) do
		total += PlayerState.landmarkIncome(Landmarks.ById[id], data.Inventory[id])
	end
	local ticket = PlayerState.UpgradesById.Ticket
	local income = total
		* (1 + ticket.PerLevel * PlayerState.upgradeLevel(data, "Ticket"))
		* PlayerState.rebirthIncomeMult(rebirthsOf(data))
	for _, pass in ownedPasses(mods) do
		income *= pass.IncomeMult or 1
	end
	return income
end

-- dt 초 동안의 관광 수입을 더하고, 더한 양을 반환
function PlayerState.addIncome(data: Data, dt: number, mods: Mods?): number
	local amount = PlayerState.incomePerSecond(data, mods) * math.max(0, dt)
	data.Coins += amount
	return amount
end

-- 굴림 --------------------------------------------------------------------

function PlayerState.discoveryBonus(landmark: Landmark): number
	return math.ceil(Config.DISCOVERY_BONUS_MULT * landmark.OneIn ^ 0.5)
end

-- 굴림 결과 반영. 반환: 보너스 코인, 역대 처음 발견인지(보너스는 이때만), 별이 올랐는지
-- (이번 판에 이미 보유한 명소를 또 뽑으면 별 +1(★5 까지). 환생 뒤 예전에 발견했던 명소를 다시 얻으면
-- 처음 발견도 별 상승도 아님 — 별 0 부터 다시)
-- 직접 배치 중 이번 판에 처음 얻은 명소는 첫 빈 전시 칸에 놓임(빈 칸이 없으면 안 놓임)
function PlayerState.applyRoll(data: Data, landmark: Landmark): (number, boolean, boolean)
	local before = data.Inventory[landmark.Id] or 0
	local after = before + 1
	local isNew = not PlayerState.isDiscovered(data, landmark.Id)
	data.Inventory[landmark.Id] = after
	data.Discovered[landmark.Id] = true
	data.Rolls += 1
	if before == 0 then
		placeNew(data, landmark.Id)
	end
	local bonus = if isNew then PlayerState.discoveryBonus(landmark) else 0
	data.Coins += bonus
	local starUp = before > 0 and PlayerState.stars(after) > PlayerState.stars(before)
	return bonus, isNew, starUp
end

-- 가장 희귀한 보유 명소(이번 판)
function PlayerState.best(data: Data | Snapshot): Landmark?
	for _, landmark in Landmarks.RarestFirst do
		if (data.Inventory[landmark.Id] or 0) > 0 then
			return landmark
		end
	end
	return nil
end

-- landmarkId 가 nil 이면 해제. 보유한 명소만 대표로 지정 가능.
function PlayerState.feature(data: Data, landmarkId: any): boolean
	if landmarkId == nil then
		data.Featured = nil
		return true
	end
	if type(landmarkId) == "string" and Landmarks.ById[landmarkId] and (data.Inventory[landmarkId] or 0) > 0 then
		data.Featured = landmarkId
		return true
	end
	return false
end

function PlayerState.setSetting(data: Data, key: any, value: any): boolean
	if key == "AutoFeature" and type(value) == "boolean" then
		data.Settings.AutoFeature = value
		return true
	elseif key == "AutoPark" and type(value) == "boolean" then
		PlayerState.setAutoPark(data, value)
		return true
	end
	return false
end

-- 환생 --------------------------------------------------------------------

-- rebirths 번 환생한 플레이어의 다음 환생 조건(복사본). 최대(Config.MAX_REBIRTHS)까지 했으면 nil
function PlayerState.rebirthRequirement(rebirths: number): RebirthRequirement?
	local n = math.max(0, math.floor(rebirths)) + 1
	local step = if n <= Config.MAX_REBIRTHS then Config.REBIRTHS[n] else nil
	if not step then
		return nil
	end
	return { Coins = step.Coins, Landmarks = table.clone(step.Landmarks) }
end

-- 환생을 최대까지 했는지
function PlayerState.rebirthMaxed(data: Data | Snapshot): boolean
	return rebirthsOf(data) >= Config.MAX_REBIRTHS
end

-- 반환: 환생 가능 여부, 이번 판에 없는 요구 명소 Id 목록, 모자란 코인(0 이상). 최대까지 했으면 false, {}, 0
function PlayerState.canRebirth(data: Data | Snapshot): (boolean, { string }, number)
	local requirement = PlayerState.rebirthRequirement(rebirthsOf(data))
	if not requirement then
		return false, {}, 0
	end
	local missing = {}
	for _, id in requirement.Landmarks do
		if (data.Inventory[id] or 0) <= 0 then
			table.insert(missing, id)
		end
	end
	local coinsShort = math.max(0, math.ceil(requirement.Coins - data.Coins))
	return #missing == 0 and coinsShort == 0, missing, coinsShort
end

-- 환생: 코인·업그레이드·보유 명소·대표 명소·직접 배치(Display) 초기화, 환생 수 +1.
-- 공원은 자동 배치로 되돌림(AutoPark = true): 빈 공원에서 직접 배치로 다시 시작하면 새로 얻는 명소가
-- 첫 빈 칸부터 차고 공원이 꽉 찬 뒤에는 더 좋은 명소를 얻어도 전시가 안 되기 때문.
-- 유지: 발견 기록(Discovered = 도감·여권 도장), 그 밖의 설정(AutoFeature), 굴림 수, 부스트, 영수증.
-- 반환: 성공 여부, 실패 사유(표시용)
function PlayerState.rebirth(data: Data): (boolean, string?)
	if PlayerState.rebirthMaxed(data) then
		return false, "최대 환생입니다"
	end
	local ok, missing = PlayerState.canRebirth(data)
	if not ok then
		if #missing > 0 then
			return false, "필요한 명소가 없습니다"
		end
		return false, "코인이 부족합니다"
	end
	for id in data.Inventory do
		data.Discovered[id] = true
	end
	table.clear(data.Inventory)
	table.clear(data.Display)
	data.Settings.AutoPark = true
	data.Featured = nil
	data.Coins = 0
	for _, upgrade in Config.Upgrades do
		data.Upgrades[upgrade.Id] = 0
	end
	data.Rebirths = rebirthsOf(data) + 1
	return true, nil
end

-- 구매 영수증 / 상품 지급 --------------------------------------------------------

function PlayerState.hasReceipt(data: Data, purchaseId: any): boolean
	return table.find(data.Receipts, tostring(purchaseId)) ~= nil
end

-- 지급한 영수증을 기록(이미 있으면 그대로). 최근 MAX_RECEIPTS 개만 보관(오래된 것부터 지움).
function PlayerState.addReceipt(data: Data, purchaseId: any)
	local key = tostring(purchaseId)
	if table.find(data.Receipts, key) then
		return
	end
	table.insert(data.Receipts, key)
	trimReceipts(data.Receipts)
end

-- 개발자 상품 효과를 data 에 적용. productKey 는 Config.Products 의 Id.
-- 개인 부스트는 남은 시간 추가, 코인 팩은 max(MinCoins, 초당 수입(mods 반영) × IncomeSeconds) 코인,
-- 서버 전체 부스트는 data 를 바꾸지 않고 Grant.ServerWide 로 알려 줌(서버가 서버 변수에 반영).
-- 영수증 기록(addReceipt)은 따로 해야 함.
function PlayerState.grantProduct(data: Data, productKey: any, mods: Mods?): (boolean, Grant?)
	local product = if type(productKey) == "string" then PlayerState.ProductsById[productKey] else nil
	if not product then
		return false, nil
	end
	if product.ServerWide then
		return true, { Product = product.Id, Coins = 0, Seconds = product.Seconds or 0, ServerWide = true }
	end
	if isPersonalBoost(product) then
		local before = PlayerState.boostLeft(data, product.Id)
		PlayerState.addBoost(data, product.Id)
		local added = PlayerState.boostLeft(data, product.Id) - before
		return true, { Product = product.Id, Coins = 0, Seconds = added, ServerWide = false }
	end
	if product.IncomeSeconds or product.MinCoins then
		local fromIncome = PlayerState.incomePerSecond(data, mods) * (product.IncomeSeconds or 0)
		local amount = math.floor(math.max(product.MinCoins or 0, fromIncome))
		data.Coins += amount
		return true, { Product = product.Id, Coins = amount, Seconds = 0, ServerWide = false }
	end
	return false, nil
end

-- 스냅샷 --------------------------------------------------------------------

function PlayerState.snapshot(data: Data, revision: number, mods: Mods?): Snapshot
	local passes = {}
	for _, pass in ownedPasses(mods) do
		passes[pass.Id] = true
	end
	return {
		Revision = revision,
		Rolls = data.Rolls,
		Coins = data.Coins,
		Inventory = table.clone(data.Inventory),
		Discovered = table.clone(data.Discovered),
		Featured = data.Featured,
		Upgrades = table.clone(data.Upgrades),
		Settings = table.clone(data.Settings),
		Display = table.clone(data.Display),
		Rebirths = data.Rebirths,
		Boosts = table.clone(data.Boosts),
		Passes = passes,
		ServerLuck = mods ~= nil and mods.ServerLuck == true,
		NextRebirth = PlayerState.rebirthRequirement(data.Rebirths),
		Luck = PlayerState.luck(data, mods),
		PermanentLuck = PlayerState.permanentLuck(data, mods),
		Cooldown = PlayerState.cooldown(data, mods),
		Income = PlayerState.incomePerSecond(data, mods),
	}
end

-- 서버가 보내는 상태: 먼저 자동 발견(autoDiscover — Data.Discovered 에 기록), 그다음 snapshot.
-- 서버는 상태를 늘 이것으로 만듦(snapshot 을 직접 부르지 않음 — 도감·여권이 서버와 화면에서 늘 같게. 테스트가 확인)
function PlayerState.sync(data: Data, revision: number, mods: Mods?): Snapshot
	PlayerState.autoDiscover(data, mods)
	return PlayerState.snapshot(data, revision, mods)
end

return PlayerState
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">RollLogic</string>
          <string name="Source"><![CDATA[--!strict
-- 굴림 판정 (순수 함수 — 서버/테스트에서 공용)
--
-- 방식: 가장 희귀한 오라부터 차례로 "luck / N" 확률 판정을 하고, 처음 성공한 오라를 줍니다.
-- 모두 실패하면 가장 흔한 오라. 그래서 행운 1 에서 희귀 오라는 거의 정확히 1/N,
-- 행운이 L 배면 희귀 오라 확률도 약 L 배가 됩니다. 행운이 N 이상이면 그보다 흔한 오라는 안 나옵니다.

export type Rollable = { Id: string, OneIn: number }

local RollLogic = {}

-- rarestFirst: OneIn 내림차순 목록. nextNumber: [0, 1) 난수 함수.
function RollLogic.roll<T>(rarestFirst: { T & Rollable }, luck: number, nextNumber: () -> number): T & Rollable
	local count = #rarestFirst
	for i = 1, count - 1 do
		local aura = rarestFirst[i]
		-- nextNumber() < luck / OneIn 과 같지만 나눗셈 오차가 없음
		if nextNumber() * aura.OneIn < luck then
			return aura
		end
	end
	return rarestFirst[count]
end

-- 주어진 행운에서 각 오라가 실제로 나올 확률 { [Id] = p } (합계 1)
function RollLogic.probabilities(rarestFirst: { Rollable }, luck: number): { [string]: number }
	local result = {}
	local remaining = 1
	local count = #rarestFirst
	for i = 1, count - 1 do
		local aura = rarestFirst[i]
		local p = math.min(1, luck / aura.OneIn)
		result[aura.Id] = remaining * p
		remaining *= 1 - p
	end
	result[rarestFirst[count].Id] = remaining
	return result
end

-- 서버 굴림 간격 판정(서버 Roll · 클라이언트 스모크의 가짜 서버가 같이 씀). lastRoll: 지난 굴림의 기준 시각,
-- now: 요청이 서버에 닿은 시각. 받으면 (true, 새 기준 시각), 너무 이르면 (false, 다시 보낼 때까지 남은 초).
-- 허용 오차(tolerance)만큼 일찍 와도 받음. 새 기준 = max(원래 가능했던 시각, 닿은 시각 - 오차):
-- 받을 때마다 기준이 굴림 간격 이상 늘어나서 평균 속도는 1/굴림 간격을 넘지 못하고(오래 쉰 뒤 한 번만 2 × 오차 당겨짐),
-- 한 번 늦게 닿은 요청(업로드 지연이 튐) 뒤에 제때 보낸 요청이 2 × 오차 안에서 일찍 닿아도 거절하지 않음
-- (기준을 늦게 닿은 시각 그대로 두면 지연이 오차보다 줄어든 다음 굴림이 거절됨 — AUTO 가 굴림 간격대로 보내므로)
function RollLogic.cooldownGate(lastRoll: number, now: number, cooldown: number, tolerance: number): (boolean, number)
	local readyAt = lastRoll + cooldown
	if now < readyAt - tolerance then
		return false, readyAt - now
	end
	return true, math.max(readyAt, now - tolerance)
end

return RollLogic
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="23">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="24">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- 서버 진입점: 플레이어 데이터, 굴림 판정(서버 권위), 관광 수입, 업그레이드, 환생, 유료 상품,
-- 공원/대표 명소 표시, 뉴스 속보

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Landmarks = require(Shared.Landmarks)
local Net = require(Shared.Net)
local PlayerState = require(Shared.PlayerState)
local RollLogic = require(Shared.RollLogic)

local DataService = require(script.DataService)
local FeaturedDisplay = require(script.FeaturedDisplay)
local ParkService = require(script.ParkService)
local Purchases = require(script.Purchases)
local Scenery = require(script.Scenery)
local World = require(script.World)

-- 세계 명소(Rank 4) 이상은 굴린 사람의 연출(최대 약 4초)이 끝난 뒤에 공원/리더보드/뉴스/홀로그램에 반영
-- (굴린 본인의 클라이언트는 연출이 끝날 때까지 자기 뉴스 속보를 따로 보류함)
local REVEAL_GRACE = 4.5
local REVEAL_RANK = 4
-- 관광 수입은 서버가 1초마다 쌓고, 클라이언트는 Income 으로 코인을 부드럽게 올려 보여 줌.
-- 마지막으로 상태를 보낸 뒤 이만큼 지나면 다시 보내서 오차를 바로잡음(매초 보내지 않음)
local RESYNC_INTERVAL = 10
local TELEPORT_COOLDOWN = 1
-- 공원 배치 바꾸기(SetDisplay, 자동 배치 설정)는 칸마다 미니어처를 다시 만들 수 있으므로 속도 제한:
-- 연속 EDIT_BURST 번까지 바로, 그다음은 초당 EDIT_RATE 번
local EDIT_BURST = 10
local EDIT_RATE = 4

type Session = {
	Data: PlayerState.Data,
	LockId: string?, -- nil 이면 저장하지 않음(Studio 등)
	LastRoll: number,
	Revision: number,
	LastSync: number, -- 마지막으로 Snapshot 을 만든(보낸) 시각
	LastTeleport: number,
	EditTokens: number, -- 공원 배치 바꾸기 속도 제한(토큰 버킷)
	EditAt: number,
	Stats: { Rolls: IntValue, Rebirths: IntValue, Best: StringValue },
	Plot: number?, -- 배정된 공원 부지 번호(부지가 모자라면 nil)
	-- 연출이 아직 안 끝나 공원/리더보드에 공개하지 않은 발견(명소 Id -> 횟수)
	Hidden: { [string]: number },
	-- 가진 게임패스 Id -> true (세션에만 저장. 접속 시 확인 + 구매 완료 이벤트로 갱신)
	Passes: { [string]: boolean },
}

local sessions: { [Player]: Session } = {}
local started: { [Player]: boolean } = {}
-- 게임패스 소유 정보. 데이터 로드와 동시에 확인하므로 세션보다 먼저 만들어 두고 세션이 같은 표를 씀
local passesByPlayer: { [Player]: { [string]: boolean } } = {}
-- 접속 시 게임패스 확인(다시 확인 포함)이 끝났는지. 실패로 끝나도 true (코인 팩 영수증이 이걸 잠깐 기다림)
local passesReady: { [Player]: boolean } = {}
local rng = Random.new()

-- 서버 행운(서버 전원에게 적용, 저장 안 함). os.clock() 기준 끝나는 시각
local serverLuckUntil = 0
local serverLuckOn = false -- 마지막으로 모두에게 알린 상태(끝날 때 한 번 상태를 다시 보내기 위함)
local serverLuckBy: { UserId: number, Name: string }? = nil -- 마지막 구매자

local function nextNumber(): number
	return rng:NextNumber()
end

local function serverLuckLeft(): number
	return math.max(0, serverLuckUntil - os.clock())
end

local function modsFor(session: Session): PlayerState.Mods
	return { Passes = session.Passes, ServerLuck = serverLuckLeft() > 0 }
end

-- 상태를 보낼 때마다 먼저 자동 발견(PlayerState.sync — 영구 행운 이하 확률의 미발견 명소 -> 발견 기록). 접속·굴림·
-- 업그레이드·환생·게임패스 등 행운이 바뀌는 일은 모두 상태를 보내므로 도감·여권이 서버와 화면에서 늘 같음
local function snapshot(session: Session): PlayerState.Snapshot
	session.Revision += 1
	session.LastSync = time()
	return PlayerState.sync(session.Data, session.Revision, modsFor(session))
end

local function pushState(player: Player)
	local session = sessions[player]
	if session then
		Net.event("State"):FireClient(player, snapshot(session))
	end
end

local function pushStateAll()
	for player in sessions do
		pushState(player)
	end
end

-- 연출 중인 발견을 뺀 "남에게 보이는" 데이터. 공원·간판·리더보드로 결과가 미리 새지 않게 함.
-- (예: 세계 명소를 뽑고 1초 뒤 흔한 명소를 뽑아도 공원에는 세계 명소가 아직 안 나타남)
local function visibleData(session: Session): PlayerState.Data
	if next(session.Hidden) == nil then
		return session.Data
	end
	local inventory = table.clone(session.Data.Inventory)
	for id, count in session.Hidden do
		local left = (inventory[id] or 0) - count
		inventory[id] = if left > 0 then left else nil
	end
	local view = table.clone(session.Data)
	view.Inventory = inventory
	return view
end

-- 공원 전시 + 간판 + 리더보드 "최고"
local function refreshVisible(player: Player, session: Session)
	local visible = visibleData(session)
	local best = PlayerState.best(visible)
	session.Stats.Best.Value = if best then best.Name else "-"
	local ok, err = pcall(ParkService.update, player, visible, modsFor(session))
	if not ok then
		warn("[LandmarkRNG] 공원 갱신 실패: " .. tostring(err))
	end
end

-- 공원 배치 바꾸기 속도 제한. 허용이면 토큰 하나를 씀
local function takeEditToken(session: Session): boolean
	local now = time()
	session.EditTokens = math.min(EDIT_BURST, session.EditTokens + (now - session.EditAt) * EDIT_RATE)
	session.EditAt = now
	if session.EditTokens < 1 then
		return false
	end
	session.EditTokens -= 1
	return true
end

local function refreshFeatured(player: Player)
	local session = sessions[player]
	local featured = if session and session.Data.Featured then Landmarks.ById[session.Data.Featured] else nil
	local ok, err = pcall(FeaturedDisplay.apply, player.Character, featured)
	if not ok then
		warn("[LandmarkRNG] 대표 명소 표시 실패: " .. tostring(err))
	end
end

local function createLeaderstats(player: Player): { Rolls: IntValue, Rebirths: IntValue, Best: StringValue }
	local folder = Instance.new("Folder")
	folder.Name = "leaderstats"
	local rolls = Instance.new("IntValue")
	rolls.Name = "굴림"
	rolls.Parent = folder
	local rebirths = Instance.new("IntValue")
	rebirths.Name = "환생"
	rebirths.Parent = folder
	local best = Instance.new("StringValue")
	best.Name = "최고"
	best.Value = "-"
	best.Parent = folder
	folder.Parent = player
	return { Rolls = rolls, Rebirths = rebirths, Best = best }
end

local function onCharacter(player: Player, character: Model)
	-- 머리/몸통이 생길 때까지 기다린 뒤 대표 명소를 붙임
	character:WaitForChild("Head", 10)
	character:WaitForChild("HumanoidRootPart", 10)
	if player.Character == character then
		refreshFeatured(player)
	end
end

-- BindToClose 가 진행 중인 저장을 기다릴 수 있도록 개수를 셈
local savesInFlight = 0

local function trackedSave(player: Player, data: PlayerState.Data, lockId: string, release: boolean): boolean
	savesInFlight += 1
	local ok, saved = pcall(DataService.save, player, data, lockId, release)
	savesInFlight -= 1
	if not ok then
		warn("[LandmarkRNG] 저장 오류: " .. tostring(saved))
		return false
	end
	return saved == true
end

-- 게임패스 ----------------------------------------------------------------

-- 가진 게임패스가 늘었을 때: 내 화면(상태) + 모두가 보는 공원 간판(수입 2배가 간판 수입에 들어감)
local function onPassesChanged(player: Player)
	local session = sessions[player]
	if session then
		refreshVisible(player, session)
		pushState(player)
	end
end

-- 서버 행운 ----------------------------------------------------------------

-- 클라이언트용 서버 행운 정보. Until 은 workspace:GetServerTimeNow() 기준 끝나는 시각, Left 는 보낼 때 남은 초
local function serverLuckInfo()
	local left = serverLuckLeft()
	return {
		UserId = if serverLuckBy then serverLuckBy.UserId else 0,
		Name = if serverLuckBy then serverLuckBy.Name else "",
		Until = workspace:GetServerTimeNow() + left,
		Left = left,
	}
end

-- 결제된 시간은 다 더함(구매 창 상한 MAX_BOOST_SECONDS 로 자르지 않음 — Purchases.extendUntil)
local function extendServerLuck(buyer: Player, seconds: number)
	local added
	serverLuckUntil, added = Purchases.extendUntil(serverLuckUntil, os.clock(), seconds)
	serverLuckOn = true
	serverLuckBy = { UserId = buyer.UserId, Name = buyer.DisplayName }
	Net.event("ServerLuck"):FireAllClients(serverLuckInfo())
	pushStateAll()
	print(string.format("[LandmarkRNG] %s 님이 서버 행운 %d초 추가", buyer.Name, math.floor(added + 0.5)))
end

-- 유료 상품 처리(Purchases)에 넘기는 서버 쪽 일 --------------------------------------

local purchaseDeps: Purchases.Deps = {
	findPlayer = function(userId: number): Player?
		return Players:GetPlayerByUserId(userId)
	end,
	session = function(player: Player): Purchases.Session?
		return sessions[player]
	end,
	inGame = function(player: Player): boolean
		return player.Parent == Players
	end,
	passesReady = function(player: Player): boolean
		return passesReady[player] == true
	end,
	mods = function(session: Purchases.Session): PlayerState.Mods
		return modsFor(session :: any)
	end,
	save = function(player: Player, session: Purchases.Session): boolean
		local lockId = session.LockId
		return lockId ~= nil and trackedSave(player, session.Data, lockId, false)
	end,
	serverLuck = extendServerLuck,
	pushState = pushState,
	ownsPass = function(player: Player, passId: number): boolean
		return MarketplaceService:UserOwnsGamePassAsync(player.UserId, passId)
	end,
	passesChanged = onPassesChanged,
	wait = function(seconds: number)
		task.wait(seconds)
	end,
	clock = os.clock,
}

-- 게임패스 구매 창이 닫힘: 샀으면 바로 반영. 안 샀는데 아직 모르는 패스면 한 번 더 확인
-- (이미 가진 패스라서 로블록스가 "이미 보유" 로 닫은 경우 — 접속 확인이 오류였던 때)
MarketplaceService.PromptGamePassPurchaseFinished:Connect(
	function(player: Player, passId: number, wasPurchased: boolean)
		local pass = Purchases.passByPassId(passId)
		local owned = passesByPlayer[player]
		if not pass or not owned or owned[pass.Id] then
			return
		end
		if wasPurchased then
			owned[pass.Id] = true
			onPassesChanged(player)
		else
			Purchases.recheckPass(player, owned, pass, purchaseDeps)
		end
	end
)

-- 접속 시 게임패스 확인(오류 난 패스는 몇 번 다시). owned 는 세션과 같은 표라서 확인되는 대로 반영됨
local function loadPasses(player: Player, owned: { [string]: boolean })
	Purchases.checkPasses(player, owned, purchaseDeps)
	if passesByPlayer[player] == owned then -- 그사이 나갔다 들어오지 않았으면
		passesReady[player] = true
	end
end

-- 플레이어 입장/퇴장 -----------------------------------------------------------

local function onPlayerAdded(player: Player)
	if started[player] then
		return
	end
	started[player] = true

	-- 게임패스 확인은 데이터 로드와 동시에 진행
	local passes = {}
	passesByPlayer[player] = passes
	task.spawn(loadPasses, player, passes)

	local data, lockId = DataService.load(player)
	if player.Parent == nil then
		-- 불러오는 동안 나감: 방금 건 세션 잠금을 풀어 둬야 다음 접속이 기다리지 않음
		started[player] = nil
		passesByPlayer[player] = nil
		passesReady[player] = nil
		if data and lockId then
			trackedSave(player, data, lockId, true)
		end
		return
	end
	if not data then
		player:Kick("데이터를 불러오지 못했습니다. 잠시 후 다시 접속해 주세요.")
		return
	end

	local session: Session = {
		Data = data,
		LockId = lockId,
		LastRoll = -math.huge,
		Revision = 0,
		LastSync = time(),
		LastTeleport = -math.huge,
		EditTokens = EDIT_BURST,
		EditAt = time(),
		Stats = createLeaderstats(player),
		Plot = nil,
		Hidden = {},
		Passes = passes,
	}
	sessions[player] = session
	session.Stats.Rolls.Value = data.Rolls
	session.Stats.Rebirths.Value = data.Rebirths

	-- 공원 부지 배정 + 전시
	local ok, result = pcall(ParkService.assign, player)
	if ok then
		session.Plot = result
	else
		warn("[LandmarkRNG] 공원 부지 배정 실패: " .. tostring(result))
	end
	refreshVisible(player, session)

	player.CharacterAdded:Connect(function(character)
		onCharacter(player, character)
	end)
	-- 일부 아바타(다이나믹 헤드 등)는 외형 로딩 중 머리를 교체하므로 로딩이 끝난 뒤 한 번 더 붙임
	player.CharacterAppearanceLoaded:Connect(function(character)
		if player.Character == character then
			refreshFeatured(player)
		end
	end)
	if player.Character then
		task.spawn(onCharacter, player, player.Character)
	end
	pushState(player)
	-- 서버 행운이 이미 진행 중이면 남은 시간을 알려 줌
	if serverLuckLeft() > 0 then
		Net.event("ServerLuck"):FireClient(player, serverLuckInfo())
	end
end

local function saveAndRelease(player: Player)
	started[player] = nil
	passesByPlayer[player] = nil
	passesReady[player] = nil
	local ok, err = pcall(ParkService.release, player)
	if not ok then
		warn("[LandmarkRNG] 공원 부지 정리 실패: " .. tostring(err))
	end
	local session = sessions[player]
	if not session then
		return
	end
	sessions[player] = nil
	if session.LockId then
		trackedSave(player, session.Data, session.LockId, true)
	end
end

-- 월드(광장 + 지구본), 공원 부지, 주변 풍경. 실패해도 굴리기/저장은 되도록 pcall
do
	local ok, err = pcall(World.build)
	if not ok then
		warn("[LandmarkRNG] 광장을 만들지 못했습니다: " .. tostring(err))
	end
	ok, err = pcall(ParkService.init)
	if not ok then
		warn("[LandmarkRNG] 공원 부지를 만들지 못했습니다: " .. tostring(err))
	end
	ok, err = pcall(Scenery.build)
	if not ok then
		warn("[LandmarkRNG] 주변 풍경을 만들지 못했습니다: " .. tostring(err))
	end
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(saveAndRelease)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

-- 서버 종료 시 남은 플레이어를 병렬로 저장하고, 퇴장 처리 중인 저장까지 끝나길 기다림(최대 약 25초)
game:BindToClose(function()
	for player in sessions do
		task.spawn(saveAndRelease, player)
	end
	local deadline = os.clock() + 25
	while savesInFlight > 0 and os.clock() < deadline do
		task.wait(0.1)
	end
end)

-- 자동 저장
task.spawn(function()
	while true do
		task.wait(Config.AUTOSAVE_INTERVAL)
		for player, session in sessions do
			if session.LockId then
				task.spawn(DataService.save, player, session.Data, session.LockId, false)
			end
		end
	end
end)

-- 관광 수입 + 시간 부스트 (접속 중에만). 상태는 매초 보내지 않고 RESYNC_INTERVAL 마다 재동기화만.
-- 굴리는 중인 플레이어는 굴림 응답마다 상태를 받으므로 재동기화가 연출 도중에 끼어들지 않음.
-- 부스트가 끝나거나 서버 행운이 끝나면 행운이 바뀌므로 바로 상태를 보냄.
task.spawn(function()
	while true do
		local dt = task.wait(1)
		local now = time()
		local serverLuckEnded = serverLuckOn and serverLuckLeft() <= 0
		if serverLuckEnded then
			serverLuckOn = false
		end
		for player, session in sessions do
			PlayerState.addIncome(session.Data, dt, modsFor(session))
			local expired = PlayerState.tickBoosts(session.Data, dt)
			if expired or serverLuckEnded or now - session.LastSync >= RESYNC_INTERVAL then
				pushState(player)
			end
		end
	end
end)

local function announce(player: Player, landmark: Landmarks.Landmark, rollNumber: number)
	local hologram = landmark.OneIn >= Config.HOLOGRAM_ONE_IN
	Net.event("Announce"):FireAllClients({
		UserId = player.UserId,
		Name = player.DisplayName,
		LandmarkId = landmark.Id,
		Rolls = rollNumber,
		Hologram = hologram,
	})
	if hologram then
		local ok, err = pcall(World.hologram, landmark)
		if not ok then
			warn("[LandmarkRNG] 홀로그램 실패: " .. tostring(err))
		end
	end
	print(
		string.format(
			"[LandmarkRNG] %s 님이 %s (%s) 발견 — %d번째 굴림",
			player.Name,
			landmark.Name,
			Format.oneIn(landmark.OneIn),
			rollNumber
		)
	)
end

-- 희귀 발견을 연출이 끝날 때까지 숨겼다가 공개
local function revealLater(player: Player, session: Session, landmark: Landmarks.Landmark)
	session.Hidden[landmark.Id] = (session.Hidden[landmark.Id] or 0) + 1
	task.delay(REVEAL_GRACE, function()
		local left = (session.Hidden[landmark.Id] or 1) - 1
		session.Hidden[landmark.Id] = if left > 0 then left else nil
		if sessions[player] == session then
			refreshVisible(player, session)
		end
	end)
end

-- 개발자 상품 구매 처리 --------------------------------------------------------
-- 규칙은 Purchases.processReceipt: 지급 + 저장 성공 후에만 PurchaseGranted, 같은 PurchaseId 는 Data.Receipts 로
-- 한 번만 지급, 데이터를 불러오는 중이면 세션을 기다림. 저장이 실패하면 NotProcessedYet → Roblox 가 나중에 다시 부름.

local function processReceipt(receiptInfo: { [string]: any }): Enum.ProductPurchaseDecision
	return Purchases.processReceipt(receiptInfo, purchaseDeps)
end

MarketplaceService.ProcessReceipt = function(receiptInfo)
	local ok, decision = pcall(processReceipt, receiptInfo)
	if ok then
		return decision
	end
	warn("[LandmarkRNG] 구매 처리 오류: " .. tostring(decision))
	return Enum.ProductPurchaseDecision.NotProcessedYet
end

-- 원격 함수 --------------------------------------------------------------

Net.fn("GetState").OnServerInvoke = function(player: Player)
	-- 클라이언트가 데이터 로드보다 먼저 시작할 수 있으므로 최대 30초 대기
	local deadline = os.clock() + 30
	while not sessions[player] and player.Parent and os.clock() < deadline do
		task.wait(0.2)
	end
	local session = sessions[player]
	return if session then snapshot(session) else nil
end

Net.fn("Roll").OnServerInvoke = function(player: Player)
	local session = sessions[player]
	if not session then
		return { Ok = false, Reason = "loading" }
	end

	-- 쿨타임(RollLogic.cooldownGate): 허용 오차만큼 일찍 와도 받아주되, 기준 시각이 받을 때마다 굴림 간격 이상 밀려서
	-- 오차를 반복 악용해도 평균 속도가 빨라지지 않음. 네트워크 지연이 들쭉날쭉해도(늦게 닿은 요청 뒤 제때 보낸 요청)
	-- 거절하지 않게 기준은 "닿은 시각 - 오차"까지만 늦춤
	local mods = modsFor(session)
	local now = time()
	local ok, value = RollLogic.cooldownGate(
		session.LastRoll,
		now,
		PlayerState.cooldown(session.Data, mods),
		Config.COOLDOWN_TOLERANCE
	)
	if not ok then
		return { Ok = false, Reason = "cooldown", RetryIn = value }
	end
	session.LastRoll = value

	-- 굴리기 전에 자동 발견(도장이 늘면 행운이 오름 — rollLuck). 굴린 뒤의 자동 발견은 응답 State(snapshot)에서
	local luck = PlayerState.rollLuck(session.Data, mods)
	local landmark = RollLogic.roll(Landmarks.RarestFirst, luck, nextNumber)
	local bonus, isNew, starUp = PlayerState.applyRoll(session.Data, landmark)
	local rollNumber = session.Data.Rolls
	session.Stats.Rolls.Value = rollNumber

	-- 세계 명소 이상은 연출이 끝난 뒤에 공원/리더보드("최고")에 반영해야 결과가 미리 새지 않음
	if landmark.Tier.Rank >= REVEAL_RANK then
		revealLater(player, session, landmark)
	else
		refreshVisible(player, session)
	end
	if landmark.OneIn >= Config.ANNOUNCE_ONE_IN then
		task.delay(REVEAL_GRACE, announce, player, landmark, rollNumber)
	end

	return {
		Ok = true,
		LandmarkId = landmark.Id,
		Luck = luck,
		Bonus = bonus,
		IsNew = isNew,
		StarUp = starUp,
		Stars = PlayerState.stars(session.Data.Inventory[landmark.Id] or 0),
		State = snapshot(session),
	}
end

-- 대표 명소 지정/해제. 자동 지정 여부는 클라이언트가 연출 뒤에 판단해서 요청함(서버는 검증만).
Net.fn("Feature").OnServerInvoke = function(player: Player, landmarkId: any)
	local session = sessions[player]
	if not session then
		return { Ok = false }
	end
	local before = session.Data.Featured
	local ok = PlayerState.feature(session.Data, landmarkId)
	if ok and session.Data.Featured ~= before then
		refreshFeatured(player)
	end
	return { Ok = ok, State = snapshot(session) }
end

Net.fn("BuyUpgrade").OnServerInvoke = function(player: Player, upgradeId: any)
	local session = sessions[player]
	if not session then
		return { Ok = false, Reason = "데이터를 불러오는 중입니다" }
	end
	local ok, reason = PlayerState.buyUpgrade(session.Data, upgradeId)
	if ok then
		-- 공원 확장(칸 수), 입장료(간판의 수입) 등이 바뀔 수 있음. 바뀐 칸만 다시 만듦
		refreshVisible(player, session)
	end
	return { Ok = ok, Reason = reason, State = snapshot(session) }
end

Net.fn("SetSetting").OnServerInvoke = function(player: Player, key: any, value: any)
	local session = sessions[player]
	if not session then
		return { Ok = false }
	end
	-- 자동 배치를 켜면 공원이 다시 채워지므로 배치 편집과 같은 속도 제한
	local park = key == "AutoPark"
	if park and not takeEditToken(session) then
		return { Ok = false, State = snapshot(session) }
	end
	local ok = PlayerState.setSetting(session.Data, key, value)
	if ok and park then
		refreshVisible(player, session)
	end
	return { Ok = ok, State = snapshot(session) }
end

-- 공원 전시 칸에 명소 놓기(이미 다른 칸에 있으면 자리 바꿈) / 빼기(nil). 검증은 PlayerState.setDisplay.
-- expected: 클라이언트가 본 그 칸의 명소 Id("" = 빈 칸), expectedFrom: 옮기는 명소가 있던 칸(0 = 전시 안 됨).
-- 둘 중 하나라도 지금과 다르면 Reason "stale" + 새 상태(클라이언트가 다시 그림).
-- 자동 배치 중 첫 편집이면 자동 배치가 꺼지고 지금 배치에서 시작
Net.fn("SetDisplay").OnServerInvoke = function(
	player: Player,
	slot: any,
	landmarkId: any,
	expected: any,
	expectedFrom: any
)
	local session = sessions[player]
	if not session then
		return { Ok = false, Reason = "데이터를 불러오는 중입니다" }
	end
	if not takeEditToken(session) then
		return { Ok = false, Reason = "busy", State = snapshot(session) }
	end
	local ok, reason = PlayerState.setDisplay(session.Data, slot, landmarkId, expected, expectedFrom)
	if ok then
		refreshVisible(player, session)
	end
	return { Ok = ok, Reason = reason, State = snapshot(session) }
end

-- 환생: 코인·업그레이드·보유 명소·대표 명소 초기화 → 공원/간판/리더보드/대표 명소 표시 갱신
Net.fn("Rebirth").OnServerInvoke = function(player: Player)
	local session = sessions[player]
	if not session then
		return { Ok = false, Reason = "데이터를 불러오는 중입니다" }
	end
	local ok, reason = PlayerState.rebirth(session.Data)
	if ok then
		session.Stats.Rebirths.Value = session.Data.Rebirths
		refreshVisible(player, session)
		refreshFeatured(player)
		pushState(player)
		print(string.format("[LandmarkRNG] %s 님 %d번째 환생", player.Name, session.Data.Rebirths))
	end
	return { Ok = ok, Reason = reason, State = snapshot(session) }
end

-- 구매 창 띄우기. 결과는 구매 완료 이벤트 / ProcessReceipt 에서 State(+ServerLuck) 이벤트로 반영됨.
-- 못 띄우면 { Ok = false, Reason }: "owned" 이미 가진 게임패스, "loading" 데이터 불러오는 중,
-- "max" 부스트 시간이 가득 참(3시간), nil 그 밖의 실패
Net.fn("BuyPass").OnServerInvoke = function(player: Player, passKey: any)
	local pass = if type(passKey) == "string" then PlayerState.PassesById[passKey] else nil
	if not pass or pass.PassId <= 0 then
		return { Ok = false }
	end
	-- 접속 때 확인이 오류였거나 웹사이트에서 산 경우를 위해 한 번 더 확인(가졌으면 구매 창 대신 바로 반영)
	local owned = passesByPlayer[player]
	if owned and Purchases.recheckPass(player, owned, pass, purchaseDeps) then
		return { Ok = false, Reason = "owned" }
	end
	local ok, err = pcall(function()
		MarketplaceService:PromptGamePassPurchase(player, pass.PassId)
	end)
	if not ok then
		warn("[LandmarkRNG] 게임패스 구매 창 실패: " .. tostring(err))
	end
	return { Ok = ok }
end

Net.fn("BuyProduct").OnServerInvoke = function(player: Player, productKey: any)
	-- 시간 부스트는 남은 시간이 최대(MAX_BOOST_SECONDS)를 넘게 되면 구매 창을 띄우지 않음(Purchases.promptCheck)
	local product, reason = Purchases.promptCheck(productKey, sessions[player], serverLuckLeft())
	if not product then
		return { Ok = false, Reason = reason }
	end
	local ok, err = pcall(function()
		MarketplaceService:PromptProductPurchase(player, product.ProductId)
	end)
	if not ok then
		warn("[LandmarkRNG] 개발자 상품 구매 창 실패: " .. tostring(err))
	end
	return { Ok = ok }
end

Net.fn("Teleport").OnServerInvoke = function(player: Player, where: any)
	if where ~= "Park" and where ~= "Plaza" then
		return { Ok = false }
	end
	local session = sessions[player]
	if not session then
		return { Ok = false }
	end
	local now = time()
	if now - session.LastTeleport < TELEPORT_COOLDOWN then
		return { Ok = false }
	end

	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not character or not humanoid or humanoid.Health <= 0 or not root then
		return { Ok = false }
	end

	local target: CFrame
	if where == "Park" then
		local entrance = ParkService.entranceCFrame(player)
		if not entrance then
			return { Ok = false }
		end
		target = entrance + Vector3.new(0, 3, 0) -- 캐릭터 피벗(HumanoidRootPart)은 발바닥보다 약 3 스터드 위
	else
		target = World.plazaCFrame()
	end

	session.LastTeleport = now
	humanoid.Sit = false
	character:PivotTo(target)
	return { Ok = true }
end
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[-- DataStore 저장/불러오기 + 세션 잠금
--
-- 저장 형식: { Data = PlayerState.Data, Lock = { Id, JobId, Time }? }
-- 세션 잠금: 불러올 때마다 새 잠금 Id 를 발급하고, 저장은 그 Id 가 기록에 그대로 있을 때만 합니다.
--   · 이전 세션(다른 서버든 같은 서버 재접속이든)이 아직 저장 중이면 잠시 기다렸다가 불러옴
--   · 퇴장 저장으로 잠금이 풀린 뒤 늦게 도착한 자동 저장은 무시됨(잠금을 다시 걸지 않음)
--   · 잠금이 만료되어 다른 세션이 가져갔으면 그쪽 데이터를 덮어쓰지 않음

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local PlayerState = require(Shared.PlayerState)

local LOCK_EXPIRE_SECONDS = Config.AUTOSAVE_INTERVAL * 3
local LOAD_ATTEMPTS = 6
local SAVE_ATTEMPTS = 3

local DataService = {}

local store: DataStore? = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DATASTORE_NAME)
	end)
	if ok then
		store = result
	else
		warn("[DataService] DataStore 를 열 수 없습니다: " .. tostring(result))
	end
end

local function keyFor(player: Player): string
	return "player_" .. player.UserId
end

local function newLock(lockId: string)
	return { Id = lockId, JobId = game.JobId, Time = os.time() }
end

-- 반환: data(실패 시 nil), lockId(nil 이면 저장하지 않음)
-- Studio 에서 API 접근이 꺼져 있으면 새 데이터로 플레이만 하고 저장은 하지 않습니다.
function DataService.load(player: Player): (PlayerState.Data?, string?)
	if not store then
		if RunService:IsStudio() then
			return PlayerState.new(), nil
		end
		return nil, nil
	end

	local lockId = HttpService:GenerateGUID(false)
	for attempt = 1, LOAD_ATTEMPTS do
		local steal = attempt == LOAD_ATTEMPTS
		local blocked = false
		local loaded: any = nil

		local ok, err = pcall(function()
			store:UpdateAsync(keyFor(player), function(record)
				-- UpdateAsync 는 충돌 시 이 함수를 다시 부를 수 있으므로 결과 변수는 매번 초기화
				blocked = false
				loaded = nil
				record = if type(record) == "table" then record else {}
				local lock = record.Lock
				if
					not steal
					and type(lock) == "table"
					and lock.Id ~= lockId
					and os.time() - (tonumber(lock.Time) or 0) < LOCK_EXPIRE_SECONDS
				then
					blocked = true
					return nil -- 쓰기 취소
				end
				loaded = record.Data
				record.Lock = newLock(lockId)
				return record
			end)
		end)

		if ok and not blocked then
			return PlayerState.reconcile(loaded), lockId
		end
		if not ok then
			warn(
				string.format(
					"[DataService] %s 불러오기 실패(%d/%d): %s",
					player.Name,
					attempt,
					LOAD_ATTEMPTS,
					tostring(err)
				)
			)
			if RunService:IsStudio() then
				-- 게시 안 된 place 이거나 API 접근이 꺼진 경우: 테스트는 되도록 저장 없이 진행
				warn(
					"[DataService] Studio 에서는 저장 없이 진행합니다. 저장까지 테스트하려면 게임을 게시하고 "
						.. "Game Settings > Security > 'Enable Studio Access to API Services' 를 켜세요."
				)
				return PlayerState.new(), nil
			end
		end
		if player.Parent == nil then
			return nil, nil
		end
		task.wait(if blocked then 5 else attempt * 1.5)
	end
	return nil, nil
end

-- lockId: load 가 돌려준 값. release=true 면 잠금을 풀어 다음 세션이 바로 불러갈 수 있게 합니다(퇴장 시).
function DataService.save(player: Player, data: PlayerState.Data, lockId: string, release: boolean): boolean
	if not store then
		return false
	end
	for attempt = 1, SAVE_ATTEMPTS do
		local stale = false
		local ok, err = pcall(function()
			store:UpdateAsync(keyFor(player), function(record)
				stale = false
				record = if type(record) == "table" then record else {}
				local lock = record.Lock
				if type(lock) ~= "table" or lock.Id ~= lockId then
					-- 이미 풀린 잠금(퇴장 저장 완료)이거나 다른 세션이 가져간 경우: 덮어쓰지 않음
					stale = true
					return nil
				end
				record.Data = data
				record.Lock = if release then nil else newLock(lockId)
				return record
			end)
		end)
		if ok then
			if stale then
				warn(
					"[DataService] "
						.. player.Name
						.. " 의 세션이 이미 끝났거나 다른 세션이 데이터를 사용 중이라 저장을 건너뜁니다."
				)
				return false
			end
			return true
		end
		warn(
			string.format(
				"[DataService] %s 저장 실패(%d/%d): %s",
				player.Name,
				attempt,
				SAVE_ATTEMPTS,
				tostring(err)
			)
		)
		if attempt < SAVE_ATTEMPTS then
			task.wait(attempt * 2)
		end
	end
	return false
end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">FeaturedDisplay</string>
          <string name="Source"><![CDATA[-- 대표 명소를 캐릭터에 표시: 오른쪽 어깨 옆에 작은 모형이 붙어 다니고, 머리 위에 명소 이름표
-- 모형은 HumanoidRootPart 에 용접(Weld)해서 캐릭터와 함께 움직입니다(무게 없음, 충돌 없음).
-- 이름표는 UI 스타일 가이드 v2 를 따름: 등급 색 통통한 딱지 + 흰 FredokaOne 글자 + Ink 테두리(이모지 없음).
-- Shared/ImageIds.star 그림이 있으면 이름 왼쪽에 작은 별 아이콘을 붙임.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Landmarks = require(Shared.Landmarks)
local Models = require(Shared.Models)

-- 그림 Id 표 (없거나 깨져도 코드로 그린 모양으로 동작)
local function loadImageIds(): { [string]: any }
	local module = Shared:FindFirstChild("ImageIds")
	if module and module:IsA("ModuleScript") then
		local ok, result = pcall(require, module)
		if ok and type(result) == "table" then
			return result
		end
	end
	return {}
end
local ImageIds = loadImageIds()

-- 그림 Id ("rbxassetid://...") 또는 nil
local function imageId(name: string): string?
	local value = ImageIds[name]
	if type(value) == "number" then
		return "rbxassetid://" .. tostring(value)
	elseif type(value) == "string" and value ~= "" then
		return if value:match("^%d+$") then "rbxassetid://" .. value else value
	end
	return nil
end

local FX_NAME = "FeaturedLandmark"
local MODEL_SIZE = 2.4
local MAX_DIMENSION = 2.6 -- 가로·세로·높이 중 가장 긴 쪽 상한(키 큰 명소가 캐릭터만큼 커지지 않게)
local SHOULDER_OFFSET = CFrame.new(2.4, 0.9, 0) -- HumanoidRootPart 기준: 오른쪽 어깨 옆(모형 바닥 높이)
local LABEL_DISTANCE = 80
local TAG_HEIGHT = 1.1 -- 이름표 높이(스터드). 너비는 이름 길이에 맞춤

local INK = Color3.fromRGB(30, 27, 46)
local WHITE = Color3.new(1, 1, 1)

local FeaturedDisplay = {}

local function clear(character: Model)
	for _, descendant in character:GetDescendants() do
		if descendant.Name == FX_NAME then
			descendant:Destroy()
		end
	end
end

local function attachModel(character: Model, landmark: Landmarks.Landmark)
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then
		return
	end
	local ok, result = pcall(Models.create, landmark, MODEL_SIZE, { Anchored = false })
	if not ok then
		warn("[FeaturedDisplay] " .. landmark.Id .. " 모형을 만들지 못했습니다: " .. tostring(result))
		return
	end
	local model = result :: Model
	model.Name = FX_NAME
	local extents = model:GetExtentsSize()
	local longest = math.max(extents.X, extents.Y, extents.Z)
	if longest > MAX_DIMENSION then
		model:ScaleTo(model:GetScale() * MAX_DIMENSION / longest)
	end
	model:PivotTo(root.CFrame * SHOULDER_OFFSET)

	-- 파트마다 지금 위치 그대로 HumanoidRootPart 에 고정
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.Anchored = false
			descendant.Massless = true
			descendant.CanCollide = false
			descendant.CastShadow = false
			local weld = Instance.new("Weld")
			weld.C0 = root.CFrame:ToObjectSpace(descendant.CFrame)
			weld.Part0 = root
			weld.Part1 = descendant
			weld.Parent = descendant
		end
	end
	model.Parent = character
end

local function corner(gui: GuiObject)
	local round = Instance.new("UICorner")
	round.CornerRadius = UDim.new(0.5, 0) -- 캡슐 모양
	round.Parent = gui
end

local function stroke(gui: GuiObject, thickness: number)
	local line = Instance.new("UIStroke")
	line.Thickness = thickness
	line.Color = INK
	line.Parent = gui
end

-- 머리 위 이름표: 어두운 그림자 판 위에 등급 색 앞면(위쪽이 살짝 밝음), 흰 이름 + Ink 글자 테두리
local function attachLabel(character: Model, landmark: Landmarks.Landmark)
	local head = character:FindFirstChild("Head")
	if not head or not head:IsA("BasePart") then
		return
	end
	-- 한글 한 글자 폭 ≈ 글자 높이(약 0.7 스터드) + 양옆 여백. 별 아이콘이 있으면 그만큼 넓힘
	local chars = utf8.len(landmark.Name) or #landmark.Name
	local starId = imageId("star")
	local iconWidth = if starId then TAG_HEIGHT * 0.9 else 0
	local width = math.clamp(chars * 0.72 + 0.9, 2.6, 8) + iconWidth

	local billboard = Instance.new("BillboardGui")
	billboard.Name = FX_NAME
	billboard.Adornee = head
	billboard.Size = UDim2.fromScale(width, TAG_HEIGHT)
	billboard.StudsOffset = Vector3.new(0, 2.7, 0)
	billboard.MaxDistance = LABEL_DISTANCE
	billboard.LightInfluence = 0
	billboard.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

	local tier = landmark.Tier.Color
	local shadow = Instance.new("Frame")
	shadow.Name = "Shadow"
	shadow.Size = UDim2.fromScale(1, 0.86)
	shadow.Position = UDim2.fromScale(0, 0.14)
	shadow.BackgroundColor3 = tier:Lerp(INK, 0.4)
	shadow.BorderSizePixel = 0
	shadow.ZIndex = 1
	corner(shadow)
	stroke(shadow, 2)
	shadow.Parent = billboard

	local face = Instance.new("Frame")
	face.Name = "Face"
	face.Size = UDim2.fromScale(1, 0.86)
	face.BackgroundColor3 = tier
	face.BorderSizePixel = 0
	face.ZIndex = 2
	corner(face)
	stroke(face, 2)
	local shine = Instance.new("UIGradient")
	shine.Color = ColorSequence.new(WHITE, Color3.fromRGB(214, 214, 214))
	shine.Rotation = 90 -- 위 → 아래
	shine.Parent = face
	face.Parent = billboard

	local label = Instance.new("TextLabel")
	label.Name = "Name"
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.Text = landmark.Name
	label.TextColor3 = WHITE
	stroke(label, 2)
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0.08 + iconWidth / width, 0)
	pad.PaddingRight = UDim.new(0.08, 0)
	pad.PaddingTop = UDim.new(0.14, 0)
	pad.PaddingBottom = UDim.new(0.14, 0)
	pad.Parent = label
	label.Parent = face

	if starId then
		-- 이름 왼쪽 별 (딱지 높이보다 조금 커서 위아래로 살짝 삐져나옴)
		local star = Instance.new("ImageLabel")
		star.Name = "Star"
		star.BackgroundTransparency = 1
		star.Image = starId
		star.ScaleType = Enum.ScaleType.Fit
		star.SizeConstraint = Enum.SizeConstraint.RelativeYY
		star.Size = UDim2.fromScale(1.3, 1.3)
		star.AnchorPoint = Vector2.new(0, 0.5)
		star.Position = UDim2.new(0, 0, 0.5, 0)
		star.ZIndex = 3
		star.Parent = face
	end

	billboard.Parent = head
end

-- 이전 표시를 지우고, landmark 가 있으면 새로 붙임(nil 이면 지우기만)
function FeaturedDisplay.apply(character: Model?, landmark: Landmarks.Landmark?)
	if not character then
		return
	end
	clear(character)
	if landmark then
		attachModel(character, landmark)
		attachLabel(character, landmark)
	end
end

return FeaturedDisplay
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">ParkLayout</string>
          <string name="Source"><![CDATA[--!strict
-- 공원 부지·길 배치의 기준(순수 계산: Instance/Vector3 없이 숫자만). ParkService 와 Scenery 가 같이 씁니다.
--
-- 좌표: 광장 중심이 원점, 땅 윗면 y = 0. 방향 각도 a 는 (cos a, 0, sin a) 쪽(스폰 정면 -Z = 270도).
-- 부지 좌표계(ParkService 의 plot.CFrame): 부지 중앙이 원점, +Z(Dir) = 광장에서 멀어지는 쪽,
--   -Z = 입구(광장 쪽), +X(Right) = CFrame.lookAt(부지 중심, 원점) 의 RightVector.
-- 여기 숫자를 바꾸면 부지 위치가 바뀝니다(ParkService 가 그대로 씀). 장식(Scenery)은 blocked 로 비켜 갑니다.

local ParkLayout = {}

ParkLayout.PLOT_COUNT = 8 -- 서버 최대 인원과 같게 (Creator Hub 에서 서버 크기 8)
ParkLayout.RING_RADIUS = 115 -- 광장 중심에서 부지 입구(광장 쪽 가장자리)까지
ParkLayout.FIRST_ANGLE = 247.5 -- 첫 부지 방향(도). 스폰 정면(270도) 근처
ParkLayout.PLAZA_EDGE = 44 -- 길이 시작되는 곳(광장 둘레 계단 아래에서부터)

ParkLayout.PLOT_WIDTH = 76
ParkLayout.PLOT_DEPTH = 80
ParkLayout.BORDER = 1.5 -- 부지 둘레 색 띠 폭
ParkLayout.PATH_WIDTH = 10 -- 광장 → 입구 길 폭

-- 장식이 비켜야 할 곳 ---------------------------------------------------------
-- 광장(반지름 45) + 둘레 계단(3) + 둘레 나무(World: 반지름 56, 잎 지름 7.5) 바깥까지. 스폰·지구본도 이 안
ParkLayout.PLAZA_CLEAR = 62
-- 입구 앞 간판 자리: 주인 간판 아치(판자 28 + 기둥, 밑으로 7.5 스터드) / 빈 부지 말뚝(길 옆 x = 9)
ParkLayout.SIGN_HALF_WIDTH = 16.5
ParkLayout.SIGN_DEPTH = 8.5 -- 입구(둘레 띠 앞 가장자리)에서 광장 쪽으로
ParkLayout.PLOT_MARGIN = 3 -- 부지(+둘레 띠) 둘레 여유
ParkLayout.PATH_MARGIN = 2 -- 길 양옆 여유
ParkLayout.SIGN_MARGIN = 1

export type Layout = { Angle: number, Radius: number, Path: boolean }

-- 부지 하나의 바닥 사각형(둘레 띠 포함)과 입구 길
export type Footprint = {
	Index: number,
	Angle: number, -- 라디안
	CenterX: number, -- 부지 중앙(바닥)
	CenterZ: number,
	DirX: number, -- 부지 +Z = 광장 중심 → 부지 방향(단위 벡터)
	DirZ: number,
	RightX: number, -- 부지 +X
	RightZ: number,
	HalfWidth: number, -- 둘레 띠 포함 반폭(부지 X)
	HalfDepth: number, -- 둘레 띠 포함 반깊이(부지 Z)
	PathFrom: number, -- 길: 광장 중심에서 부지 방향으로 PathFrom ~ PathTo, 폭 PATH_WIDTH
	PathTo: number,
}

-- 부지 순서 = 배정 순서(가장 작은 빈 번호부터). 모두 한 고리(RING_RADIUS)에 있고 광장에서 길이 이어짐
ParkLayout.LAYOUT = {} :: { Layout }
for i = 0, ParkLayout.PLOT_COUNT - 1 do
	table.insert(ParkLayout.LAYOUT, {
		Angle = math.rad(ParkLayout.FIRST_ANGLE + 360 / ParkLayout.PLOT_COUNT * i),
		Radius = ParkLayout.RING_RADIUS,
		Path = true,
	})
end

local FOOTPRINTS: { Footprint } = {}
for index, layout in ParkLayout.LAYOUT do
	local dirX, dirZ = math.cos(layout.Angle), math.sin(layout.Angle)
	local centerDistance = layout.Radius + ParkLayout.PLOT_DEPTH / 2
	table.insert(FOOTPRINTS, {
		Index = index,
		Angle = layout.Angle,
		CenterX = dirX * centerDistance,
		CenterZ = dirZ * centerDistance,
		DirX = dirX,
		DirZ = dirZ,
		-- CFrame.lookAt(중심, 원점).RightVector = (-Dir) x (0, 1, 0)
		RightX = dirZ,
		RightZ = -dirX,
		HalfWidth = ParkLayout.PLOT_WIDTH / 2 + ParkLayout.BORDER,
		HalfDepth = ParkLayout.PLOT_DEPTH / 2 + ParkLayout.BORDER,
		PathFrom = ParkLayout.PLAZA_EDGE,
		PathTo = if layout.Path then layout.Radius + 1 else ParkLayout.PLAZA_EDGE,
	})
end

-- 모든 부지의 바닥 사각형(복사본)
function ParkLayout.footprints(): { Footprint }
	local list = {}
	for _, footprint in FOOTPRINTS do
		table.insert(list, table.clone(footprint))
	end
	return list
end

-- 월드 (x, z) → 부지 좌표 (x, z)
function ParkLayout.toLocal(footprint: Footprint, x: number, z: number): (number, number)
	local dx, dz = x - footprint.CenterX, z - footprint.CenterZ
	return dx * footprint.RightX + dz * footprint.RightZ, dx * footprint.DirX + dz * footprint.DirZ
end

-- 이웃 부지 사이 쐐기 모양 잔디 틈의 가운데 방향(라디안). gapAngles()[i] = i 번 부지와 i+1 번 부지 사이
function ParkLayout.gapAngles(): { number }
	local list = {}
	for _, layout in ParkLayout.LAYOUT do
		table.insert(list, layout.Angle + math.pi / ParkLayout.PLOT_COUNT)
	end
	return list
end

-- 틈 가운데 선에서 광장 중심으로부터 rho 만큼 간 곳의 틈 반폭(가운데 선에 수직, 부지 둘레 띠까지). 음수면 틈 없음
function ParkLayout.gapHalfWidth(rho: number): number
	local half = math.pi / ParkLayout.PLOT_COUNT
	return (rho * math.sin(half) - (ParkLayout.PLOT_WIDTH / 2 + ParkLayout.BORDER)) / math.cos(half)
end

-- (x, z) 에 반지름 pad 인 장식을 두면 광장/부지/간판/길을 침범하는지. 침범하면 true 와 이유
-- ("plaza" | "plot" | "sign" | "path")
function ParkLayout.blocked(x: number, z: number, pad: number?): (boolean, string?)
	local p = pad or 0
	if x * x + z * z <= (ParkLayout.PLAZA_CLEAR + p) ^ 2 then
		return true, "plaza"
	end
	for _, footprint in FOOTPRINTS do
		local lx, lz = ParkLayout.toLocal(footprint, x, z)
		local plotPad = p + ParkLayout.PLOT_MARGIN
		if math.abs(lx) <= footprint.HalfWidth + plotPad and math.abs(lz) <= footprint.HalfDepth + plotPad then
			return true, "plot"
		end
		local signPad = p + ParkLayout.SIGN_MARGIN
		if
			math.abs(lx) <= ParkLayout.SIGN_HALF_WIDTH + signPad
			and lz <= -footprint.HalfDepth
			and lz >= -footprint.HalfDepth - ParkLayout.SIGN_DEPTH - signPad
		then
			return true, "sign"
		end
		-- 길은 광장 중심에서 부지 방향으로 곧게 뻗으므로 원점 기준으로 잼
		local along = x * footprint.DirX + z * footprint.DirZ
		local side = x * footprint.RightX + z * footprint.RightZ
		local pathPad = p + ParkLayout.PATH_MARGIN
		if
			footprint.PathTo > footprint.PathFrom
			and math.abs(side) <= ParkLayout.PATH_WIDTH / 2 + pathPad
			and along >= footprint.PathFrom - pathPad
			and along <= footprint.PathTo + pathPad
		then
			return true, "path"
		end
	end
	return false, nil
end

return ParkLayout
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">ParkService</string>
          <string name="Source"><![CDATA[-- 관광 공원 부지: 광장을 둘러싼 원형 배치. 플레이어마다 부지 하나를 배정하고 미니어처를 전시합니다.
--
-- 배치: 광장을 둘러싼 고리 하나에 8칸(반지름 115) = 서버 최대 인원 8명. 반지름은 광장 중심에서 부지 "입구"
--   (광장 쪽 가장자리)까지 거리입니다. 부지 중심까지로 잡으면 이웃 부지끼리 겹치기 때문.
--   빈 부지가 없으면(서버 인원이 부지보다 많을 때) assign 이 nil 을 돌려주고, 그 플레이어는 부지 없이 놉니다.
-- 부지 좌표계: 부지 중앙 바닥이 원점, -Z(LookVector)가 광장 쪽 = 입구.
-- 전시 칸: 6x6 격자. 칸 자리(부지 좌표)와 칸 번호 -> 격자 자리는 Shared/ParkGrid(= PlayerState.slotCell: 입구에
--   가까운 줄부터, 한 줄 안에서는 가운데에 가까운 칸부터 = 자동 배치에서 가장 희귀한 명소가 입구 정면).
--   칸마다 무엇을 전시할지는 PlayerState.parkSlots(자동 배치 또는 플레이어가 고른 배치).
-- update 는 칸마다 이전 상태를 기억해 두고 바뀐 칸만 다시 만듭니다(별 개수는 이름표 글자만 바꿈).
-- 클라이언트 3D 배치 모드(ParkEdit)용 복제 속성(서버는 ClickDetector 를 달지 않음):
--   부지 모델: OwnerUserId(주인 UserId, 빈 부지는 nil), Origin(부지 CFrame: 중앙 바닥, -Z = 입구)
--   칸 모델(Slots 폴더, 36칸 모두 — 잠긴 칸 포함): Slot(칸 번호), Look("#locked" | "#empty" | 명소 Id)
--   주인 클라이언트가 이걸 보고 자기 부지에서만 칸을 찾고(누르기·놓을 자리 표시) 집어서 옮김.
-- 간판: 주인이 있으면 입구 아치(나무 판자 + Ink 테두리 + 크림 글자판: 공원 아이콘 + 이름, 초록 알약: 동전 + "+X/s"),
--   빈 부지는 길 옆 낮은 말뚝 간판("빈 부지")만 세워서 광장에서 볼 때 어지럽지 않게 합니다.
-- 그림: Shared/ImageIds 에 park/coin 아이콘, panel_paper/pill 스킨 Id 가 있으면 간판에 그 그림을 씀(없으면 코드로 그림).
-- 바닥: 밝고 따뜻한 돌 포석(Pavement). 빈 부지에는 칸 자리 36곳에 얇은 밝은 판(EmptyGrid 폴더, Slots 밖 — 배치 모드가
--   칸으로 착각하지 않음)을 깔고, 주인이 오면 치움(받침대·잠긴 칸이 대신함, 잠긴 칸도 같은 색 판).
-- 장식: 둘레 색 띠 + 네 귀퉁이 덤불 + 옆·뒤 낮은 울타리(입구 쪽은 비움). 위에서 봐도 부지가 구분됩니다.
-- 글자 스타일은 DESIGN.md "UI 스타일 가이드 v2" 를 따름(FredokaOne, Ink 테두리, 이모지 없음).

local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Landmarks = require(Shared.Landmarks)
local Models = require(Shared.Models)
local ParkGrid = require(Shared.ParkGrid)
local PlayerState = require(Shared.PlayerState)

local ParkLayout = require(script.Parent.ParkLayout)

-- 그림 Id 표 (없거나 깨져도 코드로 그린 모양으로 동작)
local function loadImageIds(): { [string]: any }
	local module = Shared:FindFirstChild("ImageIds")
	if module and module:IsA("ModuleScript") then
		local ok, result = pcall(require, module)
		if ok and type(result) == "table" then
			return result
		end
	end
	return {}
end
local ImageIds = loadImageIds()

-- 부지 수·반지름·크기·길은 ParkLayout 에 있음(주변 풍경 Scenery 도 같은 값으로 부지를 비켜 감)
local PLAZA_EDGE = ParkLayout.PLAZA_EDGE -- 길이 시작되는 곳(광장 둘레 계단 아래에서부터)

local PLOT_WIDTH = ParkLayout.PLOT_WIDTH
local PLOT_DEPTH = ParkLayout.PLOT_DEPTH
local BASE_TOP = ParkGrid.BASE_TOP -- 부지 윗면 높이
local BORDER = ParkLayout.BORDER -- 부지 둘레 색 띠 폭

-- 칸 크기·간격은 Shared/ParkGrid (클라이언트 배치 모드가 같은 값으로 칸을 찾음)
local PEDESTAL_SIZE = ParkGrid.PEDESTAL_SIZE
local PEDESTAL_HEIGHT = ParkGrid.PEDESTAL_HEIGHT
local MINIATURE_SIZE = ParkGrid.MINIATURE_SIZE
local LABEL_DISTANCE = 60
local PATH_WIDTH = ParkLayout.PATH_WIDTH

local MAX_STARS = #Config.STAR_THRESHOLDS

-- 간판 배치(부지 좌표)
local SIGN_Z = -PLOT_DEPTH / 2 - BORDER - 1 -- 입구 바로 앞(잔디 위)
local BOARD_SIZE = Vector3.new(28, 6, 0.8) -- 주인 간판 판자
local BOARD_Y = 10.5 -- 판자 중심 높이(판자 아래 7.5 스터드: 사람이 밑으로 지나감)
local FRAME = 0.6 -- 판자 둘레 Ink 테두리 굵기
local POST = 1.6 -- 간판 기둥 굵기
local STAKE_BOARD = Vector3.new(6, 2.6, 0.4) -- 빈 부지 말뚝 간판
local STAKE_X = 9 -- 말뚝 간판 위치: 길(폭 10) 바로 옆
local STAKE_TILT = math.rad(-4) -- 말뚝을 살짝 기울여서 장난스럽게
local FENCE_HEIGHT = 2.2
local RAIL = Vector3.new(0.35, 0.35, 0.35) -- 울타리 가로대 단면

local LABEL_WIDTH = 10 -- 전시 이름표 크기(스터드)
local LABEL_HEIGHT = 2.6

-- 부지 바닥: 따뜻하고 밝은 돌 포석(Pavement, 광장 포석과 한 집안). 둘레 잔디와 또렷이 갈리고 흰 받침대·명소가 돋보임.
-- (예전 잔디색 Grass 바닥은 실제 게임에서 어둡게 그려져 위에서 보면 짙은 초록 판처럼 보였음)
local BASE_COLOR = Color3.fromRGB(236, 222, 194)
local PATH_COLOR = Color3.fromRGB(218, 200, 166) -- 광장 → 입구 길(포석, 부지 바닥보다 조금 짙게)
local PEDESTAL_COLOR = Color3.fromRGB(236, 234, 228)
-- 빈 부지(주인 없음)의 칸 자리 표시: 포석보다 살짝 밝은 매끈한 판 36개 = "명소가 올 자리".
-- 주인 부지의 잠긴 칸(아직 못 여는 자리)도 같은 판이라 빈 부지와 같은 말로 읽힘(열린 칸은 흰 받침대)
local GRID_MARK_COLOR = Color3.fromRGB(245, 237, 219)
local LOCKED_COLOR = GRID_MARK_COLOR
local GRID_MARK_SIZE = 9
local GRID_MARK_THICK = 0.06
local GRID_MARK_LIFT = 0.02 -- 판 밑면이 부지 윗면보다 이만큼 위(윗면은 +0.08: z-fighting 없음)

-- UI 스타일 가이드 v2 팔레트
local INK = Color3.fromRGB(30, 27, 46)
local CREAM = Color3.fromRGB(255, 244, 220)
local WHITE = Color3.new(1, 1, 1)
local SUN = Color3.fromRGB(255, 197, 61)
local GRASS = Color3.fromRGB(76, 217, 100)
local GRASS_SHADOW = Color3.fromRGB(46, 158, 69)
local STAR_EMPTY = Color3.fromRGB(150, 146, 170) -- 아직 못 딴 별

-- 월드 소품 색
local WOOD = Color3.fromRGB(181, 120, 66) -- 간판 판자(따뜻한 갈색)
local WOOD_DARK = Color3.fromRGB(122, 78, 45) -- 기둥, 말뚝
local FENCE_COLOR = Color3.fromRGB(255, 250, 240)
local BUSH_COLOR = Color3.fromRGB(72, 184, 84)
local BUSH_LIGHT = Color3.fromRGB(122, 214, 104)

local FONT = Enum.Font.FredokaOne
local EMPTY_STAR_HEX = Format.hex(STAR_EMPTY)

local EMPTY_TITLE = "빈 부지"
local COIN_DEEP = Color3.fromRGB(217, 144, 15)
local SLICE_CENTER = Rect.new(64, 64, 192, 192) -- 스킨 그림(256x256) 9-slice
local SKIN_RADIUS = 50 -- 스킨 그림 속 모서리 반지름(px)

-- 칸 상태 키(= 칸 모델의 Look 속성): 명소 Id 이거나 아래 둘 중 하나(명소 Id 는 '#' 으로 시작하지 않음)
local KEY_LOCKED = ParkGrid.LOOK_LOCKED
local KEY_EMPTY = ParkGrid.LOOK_EMPTY

type Slot = {
	Key: string,
	Container: Model,
	StarLabel: TextLabel?,
	Stars: number,
}

type Plot = {
	Index: number,
	CFrame: CFrame,
	Model: Model,
	SlotFolder: Folder,
	OwnerSign: Model, -- 주인이 있을 때만 부지 모델 아래에 둠
	EmptySign: Model, -- 빈 부지일 때만 부지 모델 아래에 둠
	EmptyGrid: Folder, -- 빈 부지일 때만: 칸 자리 표시 판 36개(주인이 오면 받침대·잠긴 칸이 대신함)
	TitleLabels: { TextLabel },
	IncomeLabels: { TextLabel },
	Owner: Player?,
	Slots: { Slot },
}

type Layout = ParkLayout.Layout

-- 부지 순서 = 배정 순서(가장 작은 빈 번호부터). 첫 부지는 스폰 정면(-Z = 270도) 근처.
local LAYOUT: { Layout } = ParkLayout.LAYOUT

-- 전시 칸 위치(부지 좌표, Y = 부지 윗면). 칸 번호 순서 = ParkGrid.slotOffset (PlayerState.slotCell 과 같은 격자 자리)
local SLOT_OFFSETS: { Vector3 } = {}
for slot = 1, PlayerState.MAX_SLOTS do
	local x, z = ParkGrid.slotOffset(slot)
	table.insert(SLOT_OFFSETS, Vector3.new(x, BASE_TOP, z))
end

local ParkService = {}

local folder: Folder? = nil
local plots: { Plot } = {}
local plotByPlayer: { [Player]: Plot } = {}

local function newPart(
	parent: Instance,
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material
): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

-- 장식용 공(덤불, 꼭지). 걸리적거리지 않게 충돌 없음
local function ball(parent: Instance, name: string, diameter: number, cframe: CFrame, color: Color3): Part
	local part =
		newPart(parent, name, Vector3.new(diameter, diameter, diameter), cframe, color, Enum.Material.SmoothPlastic)
	part.Shape = Enum.PartType.Ball
	part.CanCollide = false
	return part
end

-- GUI 헬퍼 ---------------------------------------------------------------

local function textLabel(parent: Instance, size: UDim2, position: UDim2, color: Color3): TextLabel
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = size
	label.Position = position
	label.Font = FONT
	label.TextScaled = true
	label.TextColor3 = color
	label.Text = ""
	label.Parent = parent
	return label
end

local function frame(parent: Instance, size: UDim2, position: UDim2, color: Color3): Frame
	local box = Instance.new("Frame")
	box.Size = size
	box.Position = position
	box.BackgroundColor3 = color
	box.BorderSizePixel = 0
	box.Parent = parent
	return box
end

local function corner(gui: GuiObject, radius: UDim)
	local round = Instance.new("UICorner")
	round.CornerRadius = radius
	round.Parent = gui
end

-- Ink 테두리: 글자에 붙이면 글자 테두리, 상자에 붙이면 상자 테두리
local function stroke(gui: GuiObject, thickness: number)
	local line = Instance.new("UIStroke")
	line.Thickness = thickness
	line.Color = INK
	line.Parent = gui
end

local function padding(gui: GuiObject, x: UDim, y: UDim)
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = x
	pad.PaddingRight = x
	pad.PaddingTop = y
	pad.PaddingBottom = y
	pad.Parent = gui
end

-- 그림 Id ("rbxassetid://...") 또는 nil
local function imageId(name: string): string?
	local value = ImageIds[name]
	if type(value) == "number" then
		return "rbxassetid://" .. tostring(value)
	elseif type(value) == "string" and value ~= "" then
		return if value:match("^%d+$") then "rbxassetid://" .. value else value
	end
	return nil
end

-- 스킨 그림(9-slice)을 깔고 상자의 바탕·테두리·그라데이션은 끔. 그림이 없으면 아무것도 안 함.
-- radius: 화면에서 보일 모서리 반지름(px, 간판은 PixelsPerStud 기준)
local function skin(gui: GuiObject, name: string, color: Color3, radius: number, height: number?)
	local id = imageId(name)
	if not id then
		return
	end
	gui.BackgroundTransparency = 1
	for _, child in gui:GetChildren() do
		if child:IsA("UIStroke") or child:IsA("UIGradient") then
			child.Enabled = false
		end
	end
	local scale = radius / SKIN_RADIUS
	if height then
		scale = math.min(scale, height / 2 / 64)
	end
	local image = Instance.new("ImageLabel")
	image.Name = "Skin"
	image.BackgroundTransparency = 1
	image.Size = UDim2.fromScale(1, 1)
	image.Image = id
	image.ImageColor3 = color
	image.ScaleType = Enum.ScaleType.Slice
	image.SliceCenter = SLICE_CENTER
	image.SliceScale = scale
	image.ZIndex = 0
	image.Parent = gui
end

-- 그림이 없을 때 쓰는 동전: 해 색 동그라미 + Ink 테두리 + 안쪽 진한 고리
local function drawCoin(box: Frame)
	local coin = frame(box, UDim2.fromScale(1, 1), UDim2.new(), SUN)
	coin.ZIndex = 3
	corner(coin, UDim.new(0.5, 0))
	stroke(coin, 4)
	local ring = frame(coin, UDim2.fromScale(0.58, 0.58), UDim2.fromScale(0.5, 0.5), SUN)
	ring.AnchorPoint = Vector2.new(0.5, 0.5)
	ring.BackgroundTransparency = 1
	ring.ZIndex = 4
	corner(ring, UDim.new(0.5, 0))
	local line = Instance.new("UIStroke")
	line.Thickness = 5
	line.Color = COIN_DEEP
	line.Parent = ring
end

-- 그림이 없을 때 쓰는 공원 아이콘: 동그란 나무(초록 잎 + 갈색 줄기)
local function drawTree(box: Frame)
	local trunk = frame(box, UDim2.fromScale(0.22, 0.42), UDim2.fromScale(0.5, 1), WOOD_DARK)
	trunk.AnchorPoint = Vector2.new(0.5, 1)
	trunk.ZIndex = 3
	stroke(trunk, 4)
	local leaves = frame(box, UDim2.fromScale(0.86, 0.72), UDim2.fromScale(0.5, 0), BUSH_COLOR)
	leaves.AnchorPoint = Vector2.new(0.5, 0)
	leaves.ZIndex = 4
	corner(leaves, UDim.new(0.5, 0))
	stroke(leaves, 4)
end

-- 정사각 아이콘 자리(부모 높이 기준 크기). 그림 Id 가 있으면 ImageLabel, 없으면 fallback 으로 그림
local function icon(
	parent: GuiObject,
	name: string,
	size: number,
	position: UDim2,
	anchor: Vector2,
	fallback: (Frame) -> ()
): Frame
	local box = Instance.new("Frame")
	box.Name = "Icon"
	box.BackgroundTransparency = 1
	box.SizeConstraint = Enum.SizeConstraint.RelativeYY
	box.Size = UDim2.fromScale(size, size)
	box.Position = position
	box.AnchorPoint = anchor
	box.ZIndex = 3
	local id = imageId(name)
	if id then
		local image = Instance.new("ImageLabel")
		image.Name = "Image"
		image.BackgroundTransparency = 1
		image.Size = UDim2.fromScale(1, 1)
		image.Image = id
		image.ScaleType = Enum.ScaleType.Fit
		image.ZIndex = 3
		image.Parent = box
	else
		fallback(box)
	end
	box.Parent = parent
	return box
end

-- 통통한 딱지: 어두운 그림자 판(drop 만큼 아래) 위에 색 앞면(위쪽이 살짝 밝음).
-- position 은 딱지 윗변 가운데. skinName/pixelHeight 를 주면 그 스킨 그림을 씀(간판처럼 픽셀 크기가 고정된 곳만).
-- 반환: 앞면(글자를 넣을 곳)
local function chunky(
	parent: Instance,
	size: UDim2,
	position: UDim2,
	drop: UDim,
	color: Color3,
	shadowColor: Color3,
	thickness: number,
	skinName: string?,
	pixelHeight: number?
): Frame
	local shadow = frame(parent, size, position + UDim2.new(UDim.new(), drop), shadowColor)
	shadow.Name = "Shadow"
	shadow.AnchorPoint = Vector2.new(0.5, 0)
	shadow.ZIndex = 1
	corner(shadow, UDim.new(0.5, 0))
	stroke(shadow, thickness)

	local face = frame(parent, size, position, color)
	face.Name = "Face"
	face.AnchorPoint = Vector2.new(0.5, 0)
	face.ZIndex = 2
	corner(face, UDim.new(0.5, 0))
	stroke(face, thickness)
	local shine = Instance.new("UIGradient")
	shine.Color = ColorSequence.new(WHITE, Color3.fromRGB(214, 214, 214))
	shine.Rotation = 90 -- 위 → 아래
	shine.Parent = face

	if skinName and pixelHeight then
		skin(shadow, skinName, shadowColor, pixelHeight / 2, pixelHeight)
		skin(face, skinName, color, pixelHeight / 2, pixelHeight)
	end
	return face
end

-- 채운 별은 해 색, 못 딴 별은 흐린 색(RichText)
local function starText(stars: number): string
	local text = string.rep("★", stars)
	if stars < MAX_STARS then
		text ..= `<font color="{EMPTY_STAR_HEX}">{string.rep("★", MAX_STARS - stars)}</font>`
	end
	return text
end

-- 초당 수입 짧게: "+13.5/s", "+12.5K/s"
local function incomeText(income: number): string
	if income < 100 then
		local text = string.format("%.1f", math.floor(income * 10) / 10):gsub("%.0$", "")
		return "+" .. text .. "/s"
	end
	return "+" .. Format.short(income) .. "/s"
end

-- 간판 ---------------------------------------------------------------------

local function surfaceGui(board: BasePart, face: Enum.NormalId): SurfaceGui
	local gui = Instance.new("SurfaceGui")
	gui.Name = "SignGui"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = board
	return gui
end

-- 주인 간판 한 면: 가장자리에 나무가 보이는 크림 글자판 + [공원 아이콘] 이름(Ink) + 초록 알약 [동전] "+X/s".
-- 반환: 제목, 수입 라벨
local PANEL_HEIGHT = BOARD_SIZE.Y * 40 - 36 -- 글자판 높이(px, PixelsPerStud 40)
local TITLE_SIDE = 130 -- 제목 양옆 여백(px): 왼쪽엔 공원 아이콘, 오른쪽은 가운데 정렬용

local function signFace(board: BasePart, face: Enum.NormalId): (TextLabel, TextLabel)
	local gui = surfaceGui(board, face)
	local panel = frame(gui, UDim2.new(1, -40, 1, -36), UDim2.fromScale(0.5, 0.5), CREAM)
	panel.Name = "Panel"
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	corner(panel, UDim.new(0, 24))
	stroke(panel, 6)
	skin(panel, "panel_paper", WHITE, 24)

	icon(panel, "park", 0.42, UDim2.new(0, 34, 0.06, 0), Vector2.new(0, 0), drawTree)
	local title = textLabel(panel, UDim2.new(1, -TITLE_SIDE * 2, 0.46, 0), UDim2.new(0, TITLE_SIDE, 0.06, 0), INK)
	title.Name = "Title"

	local pill = chunky(
		panel,
		UDim2.fromScale(0.62, 0.34),
		UDim2.fromScale(0.5, 0.56),
		UDim.new(0, 6),
		GRASS,
		GRASS_SHADOW,
		4,
		"pill",
		math.floor(PANEL_HEIGHT * 0.34)
	)
	icon(pill, "coin", 0.82, UDim2.new(0, 10, 0.5, 0), Vector2.new(0, 0.5), drawCoin)
	local income = textLabel(pill, UDim2.fromScale(1, 1), UDim2.new(), WHITE)
	income.Name = "Income"
	padding(income, UDim.new(0.14, 0), UDim.new(0.14, 0))
	stroke(income, 3)
	return title, income
end

-- 주인 간판(입구 아치): 나무 판자 + Ink 테두리 + 양옆 기둥(부지 색 모자, 금색 꼭지).
-- 반환: 간판 모델, 제목 라벨들, 수입 라벨들(앞뒤 두 면)
local function buildOwnerSign(cf: CFrame, color: Color3): (Model, { TextLabel }, { TextLabel })
	local sign = Instance.new("Model")
	sign.Name = "Sign"
	local base = cf * CFrame.new(0, 0, SIGN_Z) -- 간판 바닥 가운데(땅 높이)
	local width, height = BOARD_SIZE.X, BOARD_SIZE.Y

	local board = newPart(sign, "Board", BOARD_SIZE, base * CFrame.new(0, BOARD_Y, 0), WOOD, Enum.Material.Wood)

	-- Ink 테두리: 판자보다 두꺼워서 앞뒤로 살짝 튀어나온 액자. 위아래 막대가 모서리까지 덮음
	local depth = BOARD_SIZE.Z + 0.4
	for _, side in { -1, 1 } do
		newPart(
			sign,
			"BoardFrame",
			Vector3.new(width + FRAME * 2, FRAME, depth),
			base * CFrame.new(0, BOARD_Y + side * (height + FRAME) / 2, 0),
			INK,
			Enum.Material.SmoothPlastic
		)
		newPart(
			sign,
			"BoardFrame",
			Vector3.new(FRAME, height, depth),
			base * CFrame.new(side * (width + FRAME) / 2, BOARD_Y, 0),
			INK,
			Enum.Material.SmoothPlastic
		)
	end

	-- 판자 양옆 기둥 + 부지 색 모자 + 금색 꼭지
	local postX = width / 2 + FRAME + POST / 2
	local postTop = BOARD_Y + height / 2 + FRAME + 0.6
	for _, side in { -1, 1 } do
		newPart(
			sign,
			"Post",
			Vector3.new(POST, postTop, POST),
			base * CFrame.new(side * postX, postTop / 2, 0),
			WOOD_DARK,
			Enum.Material.Wood
		)
		newPart(
			sign,
			"PostCap",
			Vector3.new(POST + 0.8, 0.7, POST + 0.8),
			base * CFrame.new(side * postX, postTop + 0.35, 0),
			color,
			Enum.Material.SmoothPlastic
		)
		ball(sign, "PostKnob", 1.3, base * CFrame.new(side * postX, postTop + 1.2, 0), SUN)
	end

	local frontTitle, frontIncome = signFace(board, Enum.NormalId.Front)
	local backTitle, backIncome = signFace(board, Enum.NormalId.Back)
	return sign, { frontTitle, backTitle }, { frontIncome, backIncome }
end

-- 빈 부지 말뚝 간판: 길 옆에 낮게, 살짝 기울여서. 광장 쪽 면에만 글자
local function buildEmptySign(cf: CFrame): Model
	local sign = Instance.new("Model")
	sign.Name = "EmptySign"
	local base = cf * CFrame.new(STAKE_X, 0, SIGN_Z) * CFrame.Angles(0, 0, STAKE_TILT)
	local boardY = 2 + STAKE_BOARD.Y / 2

	-- 말뚝은 판자 뒤(부지 쪽)에 붙임
	newPart(
		sign,
		"Stake",
		Vector3.new(0.5, boardY, 0.5),
		base * CFrame.new(0, boardY / 2, STAKE_BOARD.Z / 2 + 0.25),
		WOOD_DARK,
		Enum.Material.Wood
	)
	local board = newPart(sign, "Board", STAKE_BOARD, base * CFrame.new(0, boardY, 0), WOOD, Enum.Material.Wood)

	local gui = surfaceGui(board, Enum.NormalId.Front)
	local panel = frame(gui, UDim2.new(1, -16, 1, -16), UDim2.fromScale(0.5, 0.5), CREAM)
	panel.Name = "Panel"
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	corner(panel, UDim.new(0, 14))
	stroke(panel, 4)
	skin(panel, "panel_paper", WHITE, 14)

	local title = textLabel(panel, UDim2.new(1, -24, 0.7, 0), UDim2.new(0, 12, 0.15, 0), INK)
	title.Text = EMPTY_TITLE
	title.TextTransparency = 0.15
	return sign
end

local function setSign(plot: Plot, title: string, subtitle: string)
	for _, label in plot.TitleLabels do
		label.Text = title
	end
	for _, label in plot.IncomeLabels do
		label.Text = subtitle
	end
end

-- 주인이 있으면 입구 아치 간판, 없으면 말뚝 간판 + 칸 자리 표시 판만 보이게
local function showOwned(plot: Plot, owned: boolean)
	plot.OwnerSign.Parent = if owned then plot.Model else nil
	plot.EmptySign.Parent = if owned then nil else plot.Model
	plot.EmptyGrid.Parent = if owned then nil else plot.Model
end

-- 빈 부지 칸 자리 표시: 6x6 칸 가운데(SLOT_OFFSETS)마다 얇고 살짝 밝은 판. 부딪히지도 광선에 맞지도 않음.
-- 부지 모델(Slots 폴더 밖)에 따로 둬서 클라이언트 배치 모드가 칸으로 착각하지 않음
local function buildEmptyGrid(cf: CFrame): Folder
	local grid = Instance.new("Folder")
	grid.Name = "EmptyGrid"
	local y = GRID_MARK_LIFT + GRID_MARK_THICK / 2 -- 부지 윗면 기준
	for _, offset in SLOT_OFFSETS do
		local mark = newPart(
			grid,
			"GridMark",
			Vector3.new(GRID_MARK_SIZE, GRID_MARK_THICK, GRID_MARK_SIZE),
			cf * CFrame.new(offset + Vector3.new(0, y, 0)),
			GRID_MARK_COLOR,
			Enum.Material.SmoothPlastic
		)
		mark.CanCollide = false
		mark.CanQuery = false
		mark.CanTouch = false
		mark.CastShadow = false
	end
	return grid
end

-- 부지 장식 ---------------------------------------------------------------

type FenceSide = { Center: Vector3, Axis: Vector3, Length: number }

-- 위에서 봐도 부지가 보이게: 둘레 띠 위에 옆·뒤 낮은 울타리 + 네 귀퉁이 덤불. 입구(앞) 쪽은 비워 둠.
-- 부지 하나에 파트 20개(가로대 6, 기둥 6, 덤불 8)
local function decorate(model: Model, cf: CFrame)
	local edgeX = PLOT_WIDTH / 2 + BORDER / 2 -- 둘레 띠 가운데
	local edgeZ = PLOT_DEPTH / 2 + BORDER / 2
	local ground = BASE_TOP - 0.2 -- 둘레 띠 윗면

	local sides: { FenceSide } = {
		{ Center = Vector3.new(-edgeX, ground, 0), Axis = Vector3.new(0, 0, 1), Length = edgeZ * 2 },
		{ Center = Vector3.new(edgeX, ground, 0), Axis = Vector3.new(0, 0, 1), Length = edgeZ * 2 },
		{ Center = Vector3.new(0, ground, edgeZ), Axis = Vector3.new(1, 0, 0), Length = edgeX * 2 },
	}
	for _, side in sides do
		-- 가로대 두 줄(양 끝은 귀퉁이 덤불에 묻힘)
		for _, y in { 0.9, 1.8 } do
			newPart(
				model,
				"FenceRail",
				RAIL + side.Axis * (side.Length - RAIL.X),
				cf * CFrame.new(side.Center + Vector3.new(0, y, 0)),
				FENCE_COLOR,
				Enum.Material.SmoothPlastic
			)
		end
		-- 기둥은 3등분 지점에 두 개
		for _, t in { -1, 1 } do
			newPart(
				model,
				"FencePost",
				Vector3.new(0.6, FENCE_HEIGHT, 0.6),
				cf * CFrame.new(side.Center + side.Axis * (t * side.Length / 6) + Vector3.new(0, FENCE_HEIGHT / 2, 0)),
				FENCE_COLOR,
				Enum.Material.SmoothPlastic
			)
		end
	end

	-- 귀퉁이 덤불: 큰 공 + 위에 작은 밝은 공
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			local spot = Vector3.new(sx * edgeX, ground, sz * edgeZ)
			ball(model, "Bush", 3.4, cf * CFrame.new(spot + Vector3.new(0, 1.2, 0)), BUSH_COLOR)
			ball(model, "Bush", 2.2, cf * CFrame.new(spot + Vector3.new(-sx * 0.7, 2.5, -sz * 0.5)), BUSH_LIGHT)
		end
	end
end

-- 부지 바닥, 둘레 색 띠, 장식, 간판(주인용/빈 부지용), 광장까지 길
local function buildPlot(parent: Instance, index: number, layout: Layout): Plot
	local direction = Vector3.new(math.cos(layout.Angle), 0, math.sin(layout.Angle))
	local center = direction * (layout.Radius + PLOT_DEPTH / 2)
	local cf = CFrame.lookAt(center, Vector3.zero) -- -Z(LookVector)가 광장 쪽
	-- 이웃 부지와 색이 겹치지 않게 황금비 간격으로 색상환을 돔
	local color = Color3.fromHSV(((index - 1) * 0.618034) % 1, 0.6, 0.95)

	local model = Instance.new("Model")
	model.Name = "Plot" .. index
	model:SetAttribute("Origin", cf) -- 클라이언트 배치 모드가 칸 자리(ParkGrid.slotOffset)를 월드로 옮길 때 씀

	-- 둘레 띠(윗면 0.4) 위에 부지 바닥(윗면 0.6): 계단처럼 걸어서 오를 수 있음
	newPart(
		model,
		"Border",
		Vector3.new(PLOT_WIDTH + BORDER * 2, BASE_TOP - 0.2, PLOT_DEPTH + BORDER * 2),
		cf * CFrame.new(0, (BASE_TOP - 0.2) / 2, 0),
		color,
		Enum.Material.SmoothPlastic
	)
	newPart(
		model,
		"Base",
		Vector3.new(PLOT_WIDTH, BASE_TOP, PLOT_DEPTH),
		cf * CFrame.new(0, BASE_TOP / 2, 0),
		BASE_COLOR,
		Enum.Material.Pavement
	)
	decorate(model, cf)

	-- 간판 두 종류를 미리 만들어 두고 주인 유무에 따라 하나만 부지 아래에 둠
	local ownerSign, titleLabels, incomeLabels = buildOwnerSign(cf, color)
	local emptySign = buildEmptySign(cf)

	-- 광장에서 입구까지 길(안쪽 고리와, 안쪽 부지 사이로 보이는 바깥 부지만). 부지/광장 아래로 살짝 들어감
	if layout.Path then
		local from, to = PLAZA_EDGE, layout.Radius + 1
		local length = to - from
		local mid = direction * ((from + to) / 2) + Vector3.new(0, 0.1, 0)
		local path = newPart(
			model,
			"Path",
			Vector3.new(PATH_WIDTH, 0.2, length),
			CFrame.lookAt(mid, Vector3.new(0, 0.1, 0)),
			PATH_COLOR,
			Enum.Material.Pavement
		)
		path.CastShadow = false
	end

	local slotFolder = Instance.new("Folder")
	slotFolder.Name = "Slots"
	slotFolder.Parent = model

	local plot: Plot = {
		Index = index,
		CFrame = cf,
		Model = model,
		SlotFolder = slotFolder,
		OwnerSign = ownerSign,
		EmptySign = emptySign,
		EmptyGrid = buildEmptyGrid(cf),
		TitleLabels = titleLabels,
		IncomeLabels = incomeLabels,
		Owner = nil,
		Slots = {},
	}
	showOwned(plot, false)
	model.Parent = parent
	return plot
end

-- 서버 시작 시 한 번: 모든 부지의 바닥/장식/간판/길을 만들어 둠(주인 없는 부지는 "빈 부지" 말뚝 간판)
function ParkService.init()
	if folder then
		return
	end
	local parks = Instance.new("Folder")
	parks.Name = "Parks"
	folder = parks
	for index, layout in LAYOUT do
		table.insert(plots, buildPlot(parks, index, layout))
	end
	parks.Parent = Workspace
end

-- 칸 위 작은 이름표: 등급 색 둥근 딱지(흰 이름 + Ink 테두리) + 그 아래 별(해 색 + Ink 테두리)
local function addLabel(pedestal: BasePart, landmark: Landmarks.Landmark, modelHeight: number): TextLabel
	local anchor = Instance.new("Attachment")
	anchor.Name = "LabelAnchor"
	anchor.Position = Vector3.new(0, PEDESTAL_HEIGHT / 2 + modelHeight + 1.4, 0)
	anchor.Parent = pedestal

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "Label"
	billboard.Adornee = anchor
	billboard.Size = UDim2.fromScale(LABEL_WIDTH, LABEL_HEIGHT)
	billboard.MaxDistance = LABEL_DISTANCE
	billboard.LightInfluence = 0
	billboard.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

	-- 딱지 너비는 이름 길이에 맞춤(한글 한 글자 폭 ≈ 글자 높이 ≈ 1 스터드)
	local chars = utf8.len(landmark.Name) or #landmark.Name
	local width = math.clamp((chars * 1.05 + 1.4) / LABEL_WIDTH, 0.3, 1)
	local tier = landmark.Tier.Color
	local tag = chunky(
		billboard,
		UDim2.fromScale(width, 0.52),
		UDim2.fromScale(0.5, 0),
		UDim.new(0.07, 0),
		tier,
		tier:Lerp(INK, 0.4),
		2
	)
	local name = textLabel(tag, UDim2.fromScale(1, 1), UDim2.new(), WHITE)
	name.Name = "Name"
	name.Text = landmark.Name
	padding(name, UDim.new(0.08, 0), UDim.new(0.14, 0))
	stroke(name, 2)

	local stars = textLabel(billboard, UDim2.fromScale(1, 0.34), UDim2.fromScale(0, 0.64), SUN)
	stars.Name = "Stars"
	stars.RichText = true
	stroke(stars, 2)

	billboard.Parent = anchor
	return stars
end

-- key: KEY_LOCKED(바닥에 얇은 밝은 판 = 빈 부지 칸 자리 표시와 같은 모습) / KEY_EMPTY(빈 받침대) / 명소 Id(받침대 + 미니어처 + 이름표)
local function buildSlot(plot: Plot, index: number, key: string): Slot
	local floor = plot.CFrame * CFrame.new(SLOT_OFFSETS[index]) -- 칸 바닥 중앙(부지 윗면)
	local container = Instance.new("Model")
	container.Name = "Slot" .. index
	local slot: Slot = { Key = key, Container = container, StarLabel = nil, Stars = -1 }

	if key == KEY_LOCKED then
		local tile = newPart(
			container,
			"Locked",
			Vector3.new(PEDESTAL_SIZE, 0.1, PEDESTAL_SIZE),
			floor * CFrame.new(0, 0.08, 0),
			LOCKED_COLOR,
			Enum.Material.SmoothPlastic
		)
		tile.CanCollide = false
		tile.CastShadow = false
	else
		local pedestal = newPart(
			container,
			"Pedestal",
			Vector3.new(PEDESTAL_SIZE, PEDESTAL_HEIGHT, PEDESTAL_SIZE),
			floor * CFrame.new(0, PEDESTAL_HEIGHT / 2, 0),
			PEDESTAL_COLOR,
			Enum.Material.Marble
		)
		local landmark = if key ~= KEY_EMPTY then Landmarks.ById[key] else nil
		if landmark then
			pedestal.Color = landmark.Tier.Color:Lerp(PEDESTAL_COLOR, 0.6)
			-- 모형 하나가 잘못돼도 나머지 칸/이름표는 만들어지도록 pcall. 반환: 모형 높이
			local ok, result = pcall(function(): number
				local model = Models.create(landmark, MINIATURE_SIZE)
				model:PivotTo(floor * CFrame.new(0, PEDESTAL_HEIGHT, 0))
				model.Parent = container
				return model:GetExtentsSize().Y
			end)
			if not ok then
				warn("[ParkService] " .. landmark.Id .. " 모형을 만들지 못했습니다: " .. tostring(result))
			end
			slot.StarLabel = addLabel(pedestal, landmark, if ok then result else 0)
		end
	end
	-- 주인 클라이언트(배치 모드)가 칸 번호와 모습을 읽음. 모델을 만들 때 한 번 정하고 바꾸지 않음(모습이 바뀌면 새 모델)
	container:SetAttribute("Slot", index)
	container:SetAttribute("Look", key)

	container.Parent = plot.SlotFolder
	return slot
end

local function clearSlots(plot: Plot)
	for _, slot in plot.Slots do
		slot.Container:Destroy()
	end
	table.clear(plot.Slots)
end

-- 가장 작은 빈 부지 번호를 배정. 부지가 모자라면 nil(공원 없이 플레이).
function ParkService.assign(player: Player): number?
	ParkService.init()
	local existing = plotByPlayer[player]
	if existing then
		return existing.Index
	end
	for _, plot in plots do
		if not plot.Owner then
			plot.Owner = player
			plotByPlayer[player] = plot
			plot.Model:SetAttribute("OwnerUserId", player.UserId)
			setSign(plot, player.DisplayName, incomeText(0))
			showOwned(plot, true)
			return plot.Index
		end
	end
	warn("[ParkService] 빈 공원 부지가 없습니다: " .. player.Name)
	return nil
end

-- 퇴장: 전시물을 모두 치우고 부지를 비움
function ParkService.release(player: Player)
	local plot = plotByPlayer[player]
	if not plot then
		return
	end
	plotByPlayer[player] = nil
	plot.Owner = nil
	plot.Model:SetAttribute("OwnerUserId", nil)
	clearSlots(plot)
	showOwned(plot, false)
	setSign(plot, "", "")
end

-- 전시 상태를 data 에 맞춤. data 는 Data 또는 같은 필드(Inventory, Upgrades, Settings, Display)를 가진 표.
-- mods: 게임패스·서버 행운 등(없으면 기본). 간판의 수입 표시에 "수입 2배" 가 반영되도록
function ParkService.update(player: Player, data: PlayerState.Data, mods: PlayerState.Mods?)
	local plot = plotByPlayer[player]
	if not plot then
		return
	end
	local park, unlocked = PlayerState.parkSlots(data)
	unlocked = math.min(unlocked, #SLOT_OFFSETS)

	for index = 1, #SLOT_OFFSETS do
		local id = if index <= unlocked then park[index] else nil
		local key = if id then id elseif index <= unlocked then KEY_EMPTY else KEY_LOCKED
		local slot = plot.Slots[index]
		if not slot or slot.Key ~= key then
			if slot then
				slot.Container:Destroy()
			end
			slot = buildSlot(plot, index, key)
			plot.Slots[index] = slot
		end
		local starLabel = slot.StarLabel
		if id and starLabel then
			local stars = PlayerState.stars(data.Inventory[id] or 0)
			if stars ~= slot.Stars then
				slot.Stars = stars
				starLabel.Text = starText(stars)
			end
		end
	end

	setSign(plot, player.DisplayName, incomeText(PlayerState.incomePerSecond(data, mods)))
end

-- 공원 입구 안쪽 바닥(부지 윗면)에서 공원 안쪽을 바라보는 CFrame. 부지가 없으면 nil.
function ParkService.entranceCFrame(player: Player): CFrame?
	local plot = plotByPlayer[player]
	if not plot then
		return nil
	end
	local position = plot.CFrame:PointToWorldSpace(Vector3.new(0, BASE_TOP, -PLOT_DEPTH / 2 + 3))
	return CFrame.lookAt(position, position - plot.CFrame.LookVector)
end

return ParkService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">Purchases</string>
          <string name="Source"><![CDATA[-- 유료 상품(Robux) 서버 규칙: 개발자 상품 영수증(ProcessReceipt) 판정·지급, 게임패스 소유 확인, 구매 창 조건.
-- 세션 표·저장·이벤트 같은 서버 일은 init.server 가 deps 로 넘김 → 테스트(tests/run.luau)가 가짜 deps 로 그대로 돌림.
--
-- 영수증 규칙:
--   · 지급 + 저장 성공 뒤에만 PurchaseGranted. 저장이 실패하면 NotProcessedYet → Roblox 가 나중에 다시 부름
--   · 같은 PurchaseId 는 Data.Receipts 로 한 번만 지급(다시 불리면 저장만 다시 시도)
--   · 접속 직후 데이터를 불러오는 중이면 세션이 생길 때까지 기다림. 여기서 바로 NotProcessedYet 을 돌려주면
--     접속 때 다시 온 영수증이 다음 구매나 다음 접속 때까지 지급되지 않음
--   · 코인 팩(초당 수입 기준)은 접속 시 게임패스(수입 2배) 확인이 끝날 때까지 잠깐 기다린 뒤 지급

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local PlayerState = require(Shared.PlayerState)

local Purchases = {}

-- 데이터를 불러오는 동안 영수증이 기다리는 최대 초 (DataService.load 는 세션 잠금 대기까지 약 25~30초)
Purchases.SESSION_WAIT = 60
-- 코인 팩이 접속 시 게임패스 확인(다시 확인 포함)을 기다리는 최대 초
Purchases.PASS_WAIT = 15
Purchases.POLL = 0.25
-- 게임패스 확인이 오류 나면 이만큼(초) 기다렸다가 오류 난 패스만 다시 확인. 모두 실패하면 이번 접속은 포기
Purchases.PASS_RETRY = { 1, 2, 4 }

export type Session = {
	Data: PlayerState.Data,
	LockId: string?, -- nil 이면 저장하지 않음(Studio)
	Passes: { [string]: boolean },
}

export type Deps = {
	findPlayer: (userId: number) -> Player?, -- Players:GetPlayerByUserId
	session: (player: Player) -> Session?, -- 데이터를 다 불러온 세션(아직이면 nil)
	inGame: (player: Player) -> boolean, -- 아직 이 서버에 있는지(나가거나 Kick 되면 false)
	passesReady: (player: Player) -> boolean, -- 접속 시 게임패스 확인(다시 확인 포함)이 끝났는지
	mods: (session: Session) -> PlayerState.Mods,
	save: (player: Player, session: Session) -> boolean, -- 저장(잠금 유지). 성공하면 true
	serverLuck: (player: Player, seconds: number) -> (), -- 서버 행운 타이머에 더하고 모두에게 알림
	pushState: (player: Player) -> (),
	ownsPass: (player: Player, passId: number) -> boolean, -- UserOwnsGamePassAsync (오류는 그대로 던짐)
	passesChanged: (player: Player) -> (), -- 가진 게임패스가 늘었음(상태 + 공원 간판 갱신)
	wait: (seconds: number) -> (),
	clock: () -> number,
}

function Purchases.productByProductId(productId: any): Config.Product?
	local id = tonumber(productId)
	if not id then
		return nil
	end
	for _, product in Config.Products do
		if product.ProductId > 0 and product.ProductId == id then
			return product
		end
	end
	return nil
end

function Purchases.passByPassId(passId: any): Config.GamePass?
	local id = tonumber(passId)
	if not id then
		return nil
	end
	for _, pass in Config.GamePasses do
		if pass.PassId > 0 and pass.PassId == id then
			return pass
		end
	end
	return nil
end

-- ready() 가 true 가 될 때까지 기다림. 플레이어가 나가거나 seconds 초가 지나면 그만. 반환: ready() 결과
local function waitFor(deps: Deps, player: Player, seconds: number, ready: () -> boolean): boolean
	local deadline = deps.clock() + seconds
	while not ready() do
		if not deps.inGame(player) or deps.clock() >= deadline then
			return false
		end
		deps.wait(Purchases.POLL)
	end
	return true
end

-- MarketplaceService.ProcessReceipt 본체(오류는 부르는 쪽 pcall 이 NotProcessedYet 으로 바꿈)
function Purchases.processReceipt(receiptInfo: { [string]: any }, deps: Deps): Enum.ProductPurchaseDecision
	local notYet = Enum.ProductPurchaseDecision.NotProcessedYet
	local player = deps.findPlayer(receiptInfo.PlayerId)
	if not player then
		return notYet -- 이 서버에 없음: 다음 접속 때 다시 옴
	end
	local purchaseId = tostring(receiptInfo.PurchaseId)
	local product = Purchases.productByProductId(receiptInfo.ProductId)

	-- 데이터를 불러오는 중: 세션이 생길 때까지 기다림(불러오기 실패 = Kick, 도중에 나감 → 바로 그만)
	local loaded = waitFor(deps, player, Purchases.SESSION_WAIT, function()
		return deps.session(player) ~= nil
	end)
	if not loaded then
		return notYet
	end
	-- 코인 팩은 초당 수입(수입 2배 게임패스 포함)으로 정하므로 접속 시 게임패스 확인을 잠깐 기다림.
	-- 확인이 끝나지 않아도 PASS_WAIT 가 지나면 지금 아는 대로 지급(무한정 미루지 않음)
	if product and product.IncomeSeconds then
		local session = deps.session(player)
		if session and not PlayerState.hasReceipt(session.Data, purchaseId) then
			waitFor(deps, player, Purchases.PASS_WAIT, function()
				return deps.passesReady(player)
			end)
		end
	end

	-- 기다리는 동안 나갔을 수 있으니 세션을 다시 읽음. 여기서 지급·영수증 기록까지는 멈추지 않음(같은 영수증이
	-- 동시에 불려도 한쪽만 지급)
	local session = deps.session(player)
	if not session then
		return notYet
	end
	if not PlayerState.hasReceipt(session.Data, purchaseId) then
		if not product then
			warn("[LandmarkRNG] 모르는 개발자 상품: " .. tostring(receiptInfo.ProductId))
			return notYet
		end
		local ok, grant = PlayerState.grantProduct(session.Data, product.Id, deps.mods(session))
		if not ok or not grant then
			return notYet
		end
		PlayerState.addReceipt(session.Data, purchaseId)
		if grant.ServerWide then
			deps.serverLuck(player, grant.Seconds)
		else
			deps.pushState(player)
		end
	end

	-- Studio(저장 안 함)에서는 효과만 적용되고 완료 처리는 되지 않음
	if not session.LockId then
		return notYet
	end
	if deps.save(player, session) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	return notYet
end

-- 서버 행운 타이머 늘리기: (지금 끝나는 시각, 지금 시각, 더할 초) -> (새 끝나는 시각, 실제로 더한 초).
-- 결제된 시간이라 구매 창 상한(MAX_BOOST_SECONDS)으로 자르지 않음(PlayerState.stackSeconds)
function Purchases.extendUntil(untilTime: number, now: number, seconds: number): (number, number)
	local left = math.max(0, untilTime - now)
	local after = PlayerState.stackSeconds(left, seconds)
	return now + after, after - left
end

-- BuyProduct 원격: 구매 창을 띄워도 되는지. 반환: (상품, nil) 이면 띄움, 아니면 (nil, 이유)
--   이유 "loading" = 데이터를 불러오는 중, "max" = 남은 부스트 시간 + 이번 시간이 MAX_BOOST_SECONDS 를 넘음, nil = 모르는 상품
-- serverLuckLeft: 지금 서버 행운 남은 초
function Purchases.promptCheck(productKey: any, session: Session?, serverLuckLeft: number): (Config.Product?, string?)
	local product = if type(productKey) == "string" then PlayerState.ProductsById[productKey] else nil
	if not product or product.ProductId <= 0 then
		return nil, nil
	end
	if not session then
		return nil, "loading"
	end
	local seconds = product.Seconds
	if seconds then
		local left = if product.ServerWide then serverLuckLeft else PlayerState.boostLeft(session.Data, product.Id)
		if left + seconds > Config.MAX_BOOST_SECONDS then
			return nil, "max"
		end
	end
	return product, nil
end

-- 게임패스 ----------------------------------------------------------------

-- 접속 시 게임패스 소유 확인. owned 는 세션과 같은 표라서 확인되는 대로 반영됨.
-- 오류 난 패스만 PASS_RETRY 간격으로 다시 확인하고(나가면 그만), 새로 찾은 패스가 있으면 그때마다 passesChanged.
-- 반환: 끝까지 확인하지 못한 패스 수(0 = 모두 확인)
function Purchases.checkPasses(player: Player, owned: { [string]: boolean }, deps: Deps): number
	local pending: { Config.GamePass } = {}
	for _, pass in Config.GamePasses do
		if pass.PassId > 0 then
			table.insert(pending, pass)
		end
	end
	local tries = #Purchases.PASS_RETRY + 1
	for attempt = 1, tries do
		local failed = {}
		local found = false
		for _, pass in pending do
			if owned[pass.Id] then
				continue -- 그사이 구매 완료 이벤트로 받음
			end
			local ok, result = pcall(deps.ownsPass, player, pass.PassId)
			if not ok then
				table.insert(failed, pass)
				warn(
					string.format(
						"[LandmarkRNG] %s 게임패스(%s) 확인 실패(%d/%d): %s",
						player.Name,
						pass.Id,
						attempt,
						tries,
						tostring(result)
					)
				)
			elseif result == true then
				owned[pass.Id] = true
				found = true
			end
		end
		if found then
			deps.passesChanged(player)
		end
		pending = failed
		if #pending == 0 or attempt == tries then
			break
		end
		deps.wait(Purchases.PASS_RETRY[attempt])
		if not deps.inGame(player) then
			break
		end
	end
	return #pending
end

-- BuyPass 원격: 구매 창을 띄우기 전에 한 번 더 확인(접속 때 확인이 오류였거나 웹사이트에서 산 경우).
-- 새로 가진 걸 알게 되면 passesChanged. 반환: 가졌는지(true 면 구매 창을 띄우지 않음)
function Purchases.recheckPass(player: Player, owned: { [string]: boolean }, pass: Config.GamePass, deps: Deps): boolean
	if owned[pass.Id] then
		return true
	end
	local ok, result = pcall(deps.ownsPass, player, pass.PassId)
	if not ok then
		warn(
			string.format(
				"[LandmarkRNG] %s 게임패스(%s) 다시 확인 실패: %s",
				player.Name,
				pass.Id,
				tostring(result)
			)
		)
		return false
	end
	if result == true then
		owned[pass.Id] = true
		deps.passesChanged(player)
		return true
	end
	return false
end

return Purchases
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">Scenery</string>
          <string name="Source"><![CDATA[-- 주변 풍경: 공원을 바다 위 휴양 섬으로 만듭니다. 서버 시작 때 한 번만 만듭니다.
--   지형(Workspace.Terrain): 구불구불한 해안선의 섬(공원 자리는 y = 0 으로 평평, 부지 뒤 숲띠는 낮은 잔디 언덕)
--     + 물속으로 완만하게 내려가는 모래사장(얕은 곳은 청록 물빛) + 물가 바위 + 수평선까지 바다 + 먼 작은 섬
--     모양은 Scenery/Island(순수 계산). 섬·작은 섬은 복셀 표 한 번씩(WriteVoxelChannels, 안 되면 WriteVoxels),
--     먼 바다는 큰 FillBlock 몇 번. 부지·길·산책로·광장 밑은 풀잎 장식이 없는 재질로 칠함(얇은 파트를 풀잎이 뚫지 않게)
--   파트: 산책로(돌길 고리 둘 + 정원 오솔길 + 원형 광장), 보이지 않는 물가 벽, 장식(정원 8곳·숲띠·모래사장·바다).
--     배치는 Scenery/Plan(고정 시드), 모양은 Scenery/Props. 결과는 Workspace.Scenery 폴더(구역별 하위 폴더).
-- 비상 바닥: default.project.json 의 FallbackGround(반지름 225 원기둥, 윗면 y -0.5 = 지형 윗면 바로 밑)가 있어서
-- 지형을 못 만들어도(또는 만드는 동안에도) 스폰·부지·길 밑은 허공이 아닙니다. 지형을 다 만들면 치웁니다.

local Workspace = game:GetService("Workspace")

local Island = require(script.Island)
local Plan = require(script.Plan)
local Props = require(script.Props)

local Scenery = {}

Scenery.Plan = Plan
Scenery.Island = Island

local FALLBACK_NAME = "FallbackGround" -- default.project.json 의 비상 바닥 파트
local WALL_THICKNESS = 2
local ROUTE_HEIGHT = Plan.Tuning.ROUTE_HEIGHT
local RING_STAGGER = 0.05 -- 이웃 고리 판끼리 윗면 높이 차(겹치는 모서리가 깜빡이지 않게, 걸을 때는 안 느껴짐)

-- 산책로 재질별 색(밝고 따뜻하게)
local ROUTE_COLORS: { [string]: Color3 } = {
	Cobblestone = Color3.fromRGB(206, 190, 162),
	Brick = Color3.fromRGB(210, 144, 114),
	Pebble = Color3.fromRGB(226, 212, 184),
	Slate = Color3.fromRGB(160, 162, 160),
	WoodPlanks = Color3.fromRGB(196, 138, 82),
	Pavement = Color3.fromRGB(222, 208, 180),
}

-- 광장 바닥 무늬: World 의 광장(반지름 45, 윗면 y = 1, 포석) 가운데(스폰 둘레)에 박은 나침반 장미.
-- 여덟 갈래 뾰족한 별(갈래마다 밝은 반쪽 + 짙은 반쪽 = 납작하게 눕힌 쐐기 둘) + 가운데 둥근 메달(스폰 받침을 둘러쌈).
-- 북쪽(지구본 쪽, -Z) 갈래는 빨강. 모든 조각은 광장 속에 반쯤 묻힌 두께 0.2 판이라 걸어서 못 느낌
local PLAZA_TOP = 1 -- World.luau 의 PLAZA_TOP
local COMPASS = {
	Cardinal = { Length = 16.5, Half = 3.4, Top = PLAZA_TOP + 0.1 }, -- 동서남북(북쪽 끝은 지구본 받침(z -17) 바로 앞)
	Diagonal = { Length = 10.5, Half = 2.6, Top = PLAZA_TOP + 0.06 }, -- 사이 네 갈래(동서남북 밑에 깔림)
	North = { Color3.fromRGB(255, 150, 128), Color3.fromRGB(226, 74, 64) },
	Main = { Color3.fromRGB(128, 186, 236), Color3.fromRGB(52, 78, 136) },
	Minor = { Color3.fromRGB(246, 204, 104), Color3.fromRGB(212, 146, 58) },
	Medallion = { -- 금색 테두리 + 남색 가운데(흰 대리석 스폰 받침이 올라앉음)
		{ R = 8.9, Top = PLAZA_TOP + 0.14, Color = Color3.fromRGB(246, 204, 104), Material = "Marble" },
		{ R = 7.9, Top = PLAZA_TOP + 0.18, Color = Color3.fromRGB(52, 78, 136), Material = "Granite" },
	},
}

local built: Folder? = nil

local function material(name: string): Enum.Material
	return (Enum.Material :: any)[name]
end

local function rgb(list: { number }): Color3
	return Color3.fromRGB(list[1], list[2], list[3])
end

-- 구역별 하위 폴더(없으면 만듦) + 파트 수 셀 구역 지정
local function zoneFolder(root: Folder, name: string): Folder
	Props.setZone(name)
	local existing = root:FindFirstChild(name)
	if existing and existing:IsA("Folder") then
		return existing
	end
	local folder = Instance.new("Folder")
	folder.Name = name
	folder.Parent = root
	return folder
end

-- 지형 -------------------------------------------------------------------------------

export type TerrainStats = {
	Ok: boolean,
	Method: string, -- "WriteVoxelChannels" | "WriteVoxels" | "failed"
	Voxels: number, -- 복셀 표로 쓴 복셀 수
	Solid: number, -- 그중 땅이 있는 복셀
	Water: number, -- 그중 물이 있는 복셀
	FillBlocks: number, -- 먼 바다 FillBlock 호출 수
	FillVoxels: number, -- FillBlock 이 채운 복셀 수(대략)
	Seconds: number,
}

-- 재질 이름 → Enum.Material(처음 쓸 때 찾아 둠)
local MATERIALS = setmetatable({}, {
	__index = function(self, name)
		local value = material(name)
		rawset(self, name, value)
		return value
	end,
}) :: any

local function setupLook(terrain: Terrain)
	for name, color in Island.COLORS do
		terrain:SetMaterialColor(material(name), rgb(color))
	end
	local W = Island.WATER
	terrain.WaterColor = rgb(W.Color)
	terrain.WaterTransparency = W.Transparency
	terrain.WaterReflectance = W.Reflectance
	terrain.WaterWaveSize = W.WaveSize
	terrain.WaterWaveSpeed = W.WaveSpeed
	-- 풀잎 장식(Terrain.Decoration, Grass 재질에만 나옴)은 스크립트로 못 바꾸는 속성(NotScriptable)이라 여기서 켜지 않고
	-- default.project.json 의 Workspace.Terrain 에서 켬(place 파일에 저장됨)
end

-- 먼 바다: 바닥 판 + 물(섬·작은 섬 자리는 나중에 복셀 표가 덮어씀)
local function fillOcean(terrain: Terrain, stats: TerrainStats)
	local V = Island.VOXEL
	local floorHeight = Island.SEA_FLOOR - Island.FLOOR_BOTTOM
	local waterHeight = Island.WATER_LEVEL - Island.SEA_FLOOR
	for _, tile in Island.oceanTiles() do
		-- 바닥 판(단단한 지형)은 Roblox 가 윗면을 반 칸 위에 그려서 SOLID_LIFT 만큼 내려 채움(보이는 윗면 = SEA_FLOOR)
		local floorY = (Island.FLOOR_BOTTOM + Island.SEA_FLOOR) / 2 - Island.SOLID_LIFT
		local waterY = (Island.SEA_FLOOR + Island.WATER_LEVEL) / 2
		terrain:FillBlock(
			CFrame.new(tile.X, floorY, tile.Z),
			Vector3.new(tile.Size, floorHeight, tile.Size),
			MATERIALS.Mud
		)
		terrain:FillBlock(
			CFrame.new(tile.X, waterY, tile.Z),
			Vector3.new(tile.Size, waterHeight, tile.Size),
			MATERIALS.Water
		)
		stats.FillBlocks += 2
		stats.FillVoxels += (tile.Size // V) ^ 2 * ((floorHeight + waterHeight) // V)
	end
end

-- 복셀 표 한 장 쓰기: WriteVoxelChannels(땅 + 물이 한 복셀에 같이 → 물가가 매끈) 가 안 되면 WriteVoxels
local function writeArea(terrain: Terrain, area: Island.Area, plan: Plan.Result, stats: TerrainStats)
	local V = Island.VOXEL
	local grid = Island.voxels(area.MinX, area.MinZ, area.SizeX, area.SizeZ, {
		Paint = plan.Paint,
		Ponds = plan.Ponds,
		Materials = MATERIALS,
	})
	local lo = Vector3.new(grid.MinX, grid.MinY, grid.MinZ)
	local region = Region3.new(lo, lo + Vector3.new(grid.SizeX, grid.SizeY, grid.SizeZ) * V)
	local ok = stats.Method ~= "WriteVoxels"
		and pcall(function()
			terrain:WriteVoxelChannels(region, V, {
				SolidMaterial = grid.Material,
				SolidOccupancy = grid.Solid,
				LiquidOccupancy = grid.Liquid,
			})
		end)
	if ok then
		stats.Method = "WriteVoxelChannels"
	else
		local materials, occupancies = Island.legacy(grid, MATERIALS.Water, MATERIALS.Air)
		terrain:WriteVoxels(region, V, materials, occupancies)
		stats.Method = "WriteVoxels"
	end
	stats.Voxels += grid.SizeX * grid.SizeY * grid.SizeZ
	stats.Solid += grid.SolidCount
	stats.Water += grid.WaterCount
end

-- 지형 섬 + 바다. 실패해도 오류를 밖으로 던지지 않음(비상 바닥이 있음)
function Scenery.buildTerrain(plan: Plan.Result): TerrainStats
	local stats: TerrainStats = {
		Ok = false,
		Method = "failed",
		Voxels = 0,
		Solid = 0,
		Water = 0,
		FillBlocks = 0,
		FillVoxels = 0,
		Seconds = 0,
	}
	local started = os.clock()
	local ok, err = pcall(function()
		local terrain = Workspace.Terrain
		setupLook(terrain)
		fillOcean(terrain, stats)
		stats.Method = "?"
		for _, area in Island.areas() do
			writeArea(terrain, area, plan, stats)
		end
	end)
	stats.Seconds = os.clock() - started
	stats.Ok = ok
	if ok then
		-- 지형이 생겼으면 비상 바닥은 필요 없음(땅속에 묻혀 있지만 연못 바닥에서는 보이므로 치움)
		local fallback = Workspace:FindFirstChild(FALLBACK_NAME)
		if fallback and fallback:IsA("BasePart") then
			fallback:Destroy()
		end
	else
		stats.Method = "failed"
		warn("[Scenery] 지형 섬을 만들지 못했습니다(비상 바닥은 있음): " .. tostring(err))
	end
	return stats
end

-- 파트 --------------------------------------------------------------------------------

-- 보이지 않는 물가 벽: 닫힌 꺾은선(각도가 커지는 순서 = 안쪽이 왼쪽)을 따라 판을 세움. 판 안쪽 면이 선 위
local function buildWall(parent: Instance, wall)
	local points = wall.Points
	local height = wall.Height
	local y = wall.Bottom + height / 2
	for k, p in points do
		local q = points[k % #points + 1]
		local dx, dz = q[1] - p[1], q[2] - p[2]
		local length = math.sqrt(dx * dx + dz * dz)
		if length > 0.01 then
			-- 오른쪽(바깥) = (dz, -dx) / length
			local ox, oz = dz / length * WALL_THICKNESS / 2, -dx / length * WALL_THICKNESS / 2
			local center = Vector3.new((p[1] + q[1]) / 2 + ox, y, (p[2] + q[2]) / 2 + oz)
			local part = Props.block(
				parent,
				"EdgeWall",
				Vector3.new(WALL_THICKNESS, height, length + 0.6),
				CFrame.lookAt(center, center + Vector3.new(dx, 0, dz)),
				Color3.new(1, 1, 1),
				Enum.Material.SmoothPlastic,
				true
			)
			part.Transparency = 1
			part.CastShadow = false
		end
	end
end

-- 고리 산책로: 가운데 선 꼭짓점(Points) 사이마다 곧은 판 하나. 이음매에서 꺾이는 만큼 판을 반폭 * tan(꺾인 각 / 2)
-- 늘려서 바깥쪽 틈을 덮고, 겹치는 모서리가 깜빡이지 않게 이웃 판끼리 윗면을 RING_STAGGER 씩 번갈아 낮춤
local function buildRing(parent: Instance, ring: Plan.Ring)
	local points = ring.Points
	local n = #points
	local half = ring.Width / 2
	local color = if ring.Color then rgb(ring.Color) else ROUTE_COLORS[ring.Material] or ROUTE_COLORS.Cobblestone
	local function at(k: number): Vector3
		local p = points[(k - 1) % n + 1]
		return Vector3.new(p[1], 0, p[2])
	end
	-- k 번 꼭짓점에서 꺾이는 각의 절반의 tan
	local function bend(k: number): number
		local a = (at(k) - at(k - 1)).Unit
		local b = (at(k + 1) - at(k)).Unit
		local cos = math.clamp(a:Dot(b), -1, 1)
		return math.tan(math.acos(cos) / 2)
	end
	for k = 1, n do
		local a, b = at(k), at(k + 1)
		local direction = (b - a).Unit
		local from = a - direction * (half * bend(k) + 0.05)
		local to = b + direction * (half * bend(k + 1) + 0.05)
		local top = ring.Top - (k % 2) * RING_STAGGER
		local center = (from + to) / 2 + Vector3.new(0, top - ROUTE_HEIGHT / 2, 0)
		local part = Props.block(
			parent,
			"Walkway",
			Vector3.new(ring.Width, ROUTE_HEIGHT, (to - from).Magnitude),
			CFrame.lookAt(center, center + direction),
			color,
			material(ring.Material),
			true
		)
		part.CastShadow = false
	end
end

local function buildWalkways(parent: Instance, plan: Plan.Result)
	for _, ring in plan.Rings do
		buildRing(parent, ring)
	end
	for _, trail in plan.Trails do
		local color = ROUTE_COLORS[trail.Material] or ROUTE_COLORS.Cobblestone
		local part = Props.segment(parent, "GardenTrail", trail, ROUTE_HEIGHT, color, material(trail.Material), true)
		part.CastShadow = false
	end
	for _, disc in plan.Discs do
		local color = ROUTE_COLORS[disc.Material] or ROUTE_COLORS.Cobblestone
		local part = Props.disc(
			parent,
			"GardenPlaza",
			disc.X,
			disc.Z,
			disc.R,
			disc.Top,
			ROUTE_HEIGHT,
			color,
			material(disc.Material),
			true
		)
		part.CastShadow = false
	end
end

-- 나침반 갈래 반쪽: 가운데(0, 0)에서 끝(방향 (ux, uz) 으로 length)까지, 옆으로 half 폭의 직각삼각형.
-- 쐐기(로컬 YZ 단면이 직각삼각형)를 눕힘: 로컬 X = 위(두께), 직각 꼭짓점 = 가운데. side = 1 / -1(어느 쪽 반쪽)
local function compassHalf(
	parent: Instance,
	ux: number,
	uz: number,
	length: number,
	half: number,
	top: number,
	side: number,
	color: Color3,
	mat: Enum.Material
)
	local thickness = 0.2
	local u = Vector3.new(ux, 0, uz)
	local v = Vector3.new(uz, 0, -ux) * side -- 옆(up x v = -u 가 되게 side 에 따라 위아래를 뒤집음)
	local up = Vector3.new(0, side, 0)
	local center = u * (length / 2) + v * (half / 2) + Vector3.new(0, top - thickness / 2, 0)
	local piece = Props.wedge(
		parent,
		"PlazaCompass",
		Vector3.new(thickness, half, length),
		CFrame.fromMatrix(center, up, v),
		color,
		mat,
		true
	)
	piece.CastShadow = false
end

local function buildPlazaInlay(parent: Instance)
	for k = 0, 7 do
		local angle = math.rad(270 + k * 45) -- k = 0 이 북쪽(지구본 쪽, -Z)
		local ux, uz = math.cos(angle), math.sin(angle)
		local spec = if k % 2 == 0 then COMPASS.Cardinal else COMPASS.Diagonal
		local colors = if k == 0 then COMPASS.North elseif k % 2 == 0 then COMPASS.Main else COMPASS.Minor
		compassHalf(parent, ux, uz, spec.Length, spec.Half, spec.Top, 1, colors[1], Enum.Material.Marble)
		compassHalf(parent, ux, uz, spec.Length, spec.Half, spec.Top, -1, colors[2], Enum.Material.Granite)
	end
	for _, ring in COMPASS.Medallion do
		local part =
			Props.disc(parent, "PlazaCompass", 0, 0, ring.R, ring.Top, 0.2, ring.Color, material(ring.Material), true)
		part.CastShadow = false
	end
end

-- 파트 수 요약 문자열("구역 n, ...") + 합계
local function summary(counts: { [string]: number }): (string, number)
	local names = {}
	local total = 0
	for name, count in counts do
		table.insert(names, name)
		total += count
	end
	table.sort(names)
	local parts = {}
	for _, name in names do
		table.insert(parts, name .. " " .. counts[name])
	end
	return table.concat(parts, ", "), total
end

-- 풍경을 만들어 Workspace.Scenery 에 둠(두 번째 호출부터는 그대로 돌려줌). 반환: 폴더, 구역별 파트 수, 지형 결과
function Scenery.build(): (Folder, { [string]: number }, TerrainStats?)
	if built then
		return built, Props.counts(), nil
	end
	local started = os.clock()
	local plan = Plan.make()
	local planSeconds = os.clock() - started
	local terrain = Scenery.buildTerrain(plan)

	started = os.clock()
	Props.resetCounts()
	local root = Instance.new("Folder")
	root.Name = "Scenery"
	buildWall(zoneFolder(root, "Walls"), plan.Wall)
	buildWalkways(zoneFolder(root, "Walkways"), plan)
	buildPlazaInlay(zoneFolder(root, "Walkways"))
	for _, item in plan.Items do
		if not Props.build(zoneFolder(root, item.Zone), item) then
			warn("[Scenery] 모르는 장식 종류: " .. item.Kind)
		end
	end
	root.Parent = Workspace
	built = root

	local counts = Props.counts()
	local text, total = summary(counts)
	print(
		string.format(
			"[Scenery] 파트 %d개 (%s) / 지형 %s: 복셀 표 %d(땅 %d, 물 %d) + FillBlock %d번(약 %d 복셀), %.2f초"
				.. " / 배치 %.2f초, 파트 %.2f초",
			total,
			text,
			terrain.Method,
			terrain.Voxels,
			terrain.Solid,
			terrain.Water,
			terrain.FillBlocks,
			terrain.FillVoxels,
			terrain.Seconds,
			planSeconds,
			os.clock() - started
		)
	)
	for key, count in plan.Skipped do
		print(string.format("[Scenery] 자리가 없어 못 놓음: %s x%d", key, count))
	end
	return root, counts, terrain
end

return Scenery
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">Island</string>
            <string name="Source"><![CDATA[--!strict
-- 섬 지형(순수 계산: Instance 없이 숫자만). 해안선·땅 높이·재질과 지형 복셀 표를 만듭니다.
-- Scenery/init.luau 가 이 표를 Workspace.Terrain 에 씁니다(WriteVoxelChannels, 안 되면 WriteVoxels).
--
-- 높이(광장 중심에서의 거리 r):
--   r <= 214          공원(광장·부지·길·산책로): 땅 윗면이 정확히 y = 0(복셀 경계라 평평). 파트가 그대로 올라앉음
--   214 ~ 풀밭 끝       부지 뒤 숲띠: 낮고 둥근 잔디 언덕(최고 4). 풀밭 끝은 234 이상
--   풀밭 끝 ~ 물가      모래사장(물가 = 해안선 245~292, 노이즈로 구불구불 + 등대 곶 + 넓은 모래사장 두 곳)
--   물가 너머           얕은 모래 턱(폭 16~46, 물 깊이 3 = 청록 물빛) → 깊은 바다 바닥(y -24)
-- 물 높이 y = -4(복셀 경계). 먼 바다(한 변 3072)는 FillBlock, 섬 둘레(한 변 784)와 먼 작은 섬은 복셀 표.
-- 물가 바위(지형 Rock, 둥근 턱 + 옆 혹 둘)와 먼 작은 섬 모양(길쭉하고 구불구불한 모래섬 + 한쪽으로 치우친 풀 언덕)도
-- 여기서 정합니다(배치 계획 Plan 이 이 모양을 보고 장식을 놓음).
-- 모든 모양은 고정 오프셋 math.noise 라서 서버·미리보기·테스트에서 항상 같습니다.

local Island = {}

local TAU = math.pi * 2

-- 기준 값 ------------------------------------------------------------------------
Island.VOXEL = 4 -- 지형 복셀 한 변(스터드). 아래 높이 값은 모두 이 배수(복셀 경계)
-- 실제 Roblox 는 단단한 지형 윗면을 "맨 위 땅 복셀 바닥 + 2 + 4·점유율" 에 그림(복셀 반 칸 위).
-- Open Cloud Luau 실행으로 잰 값: [-4,0) 가득·위는 빔 → 윗면 +2, [-4,0) 반 → 0, FillBlock 윗면 0 → +2.
-- 물(액체)은 "복셀 바닥 + 4·점유율" 그대로. 그래서 땅 점유율은 원하는 높이보다 이만큼 낮춰서 씀
Island.SOLID_LIFT = 2
Island.WATER_LEVEL = -4 -- 바다 물 윗면
Island.SEA_FLOOR = -24 -- 먼 바다 바닥 윗면 = 섬 복셀 표 맨 아래
Island.FLOOR_BOTTOM = -28 -- 먼 바다 바닥 판 밑면(FillBlock)
Island.TOP = 4 -- 섬 복셀 표 맨 위(= 숲띠 언덕 최고 높이)
Island.FLAT_RADIUS = 214 -- 이 안은 땅 윗면이 정확히 0(바깥 산책로 바깥 가장자리 212 + 2)
Island.GRASS_MIN = 234 -- 풀밭 끝(모래 시작)의 최소 반지름(바깥 산책로 + 22)
Island.COAST_MIN = 245 -- 해안선(물가) 반지름 범위
Island.COAST_MAX = 292
Island.REGION_HALF = 392 -- 섬 복셀 표: 원점 중심 한 변 784(이 밖은 깊은 바다 바닥)
Island.OCEAN_HALF = 1536 -- 먼 바다: 원점 중심 한 변 3072(반지름 1500 까지 모든 방향)
Island.OCEAN_TILE = 1024 -- 먼 바다 FillBlock 한 번 크기
-- 비상 바닥(default.project.json 의 FallbackGround 원기둥): 지형이 안 만들어져도 스폰·부지 밑이 허공이 아니게.
-- 윗면 y -0.5, 반지름 225(풀밭 끝 234 보다 안쪽)라서 지형이 있으면 땅속에 완전히 묻혀 안 보임
Island.FALLBACK_RADIUS = 225
Island.FALLBACK_TOP = -0.5

local MOUND_HEIGHT = 4 -- 숲띠 잔디 언덕 최고 높이(= TOP)
local SHALLOW_DEPTH = 3 -- 모래 턱 끝의 물 깊이
local DROP_SLOPE = 0.5 -- 모래 턱 너머 깊은 바다로 내려가는 기울기

-- 물가 명물 방향(도): 등대 곶(광장에서 315도 틈 정원 사이로 보임), 넓은 모래사장 두 곳(부두·파라솔)
Island.LIGHTHOUSE_ANGLE = 315
Island.PIER_ANGLE = 135
local HEADLAND = { Angle = math.rad(315), Width = math.rad(9), Bulge = 13 }
local BEACHES = {
	{ Angle = math.rad(150), Width = math.rad(38), Bulge = 8, Extra = 9 },
	{ Angle = math.rad(28), Width = math.rad(30), Bulge = 5, Extra = 7 },
}

-- 먼 작은 섬(모래 + 풀 언덕). Radius = 평균 반지름(물가), Stretch = 길쭉한 정도(긴 축 / 평균, 넓이는 같게),
-- Axis = 긴 축 방향(도), Hill = 풀 언덕 가운데가 섬 가운데에서 치우친 정도(반지름 비율, 치우친 방향은 Axis + 90)
Island.ISLETS = {
	{ Angle = 205, Distance = 560, Radius = 30, Stretch = 1.35, Axis = 40, Hill = 0.18 },
	{ Angle = 330, Distance = 720, Radius = 42, Stretch = 1.25, Axis = 100, Hill = -0.2 },
	{ Angle = 42, Distance = 640, Radius = 26, Stretch = 1.45, Axis = 150, Hill = 0.15 },
	{ Angle = 112, Distance = 880, Radius = 55, Stretch = 1.3, Axis = 10, Hill = 0.22 },
	{ Angle = 268, Distance = 980, Radius = 48, Stretch = 1.4, Axis = 75, Hill = -0.18 },
	{ Angle = 160, Distance = 700, Radius = 34, Stretch = 1.2, Axis = 125, Hill = 0.2 },
}

-- 도움 함수 ------------------------------------------------------------------------

local function smooth(t: number): number
	local c = math.clamp(t, 0, 1)
	return c * c * (3 - 2 * c)
end

-- 두 값 중 큰 값을 부드럽게(k 만큼 둥글게): 경계가 원호로 딱 잘리지 않게
local function smoothMax(a: number, b: number, k: number): number
	return (a + b + math.sqrt((a - b) * (a - b) + k * k)) / 2
end

-- 원 둘레를 따라 매끄럽게 변하는 노이즈(한 바퀴 돌면 제자리). 대략 -0.45 ~ 0.65
local function around(angle: number, freq: number, seed: number): number
	return math.noise(math.cos(angle) * freq + seed, math.sin(angle) * freq - seed * 0.7, seed * 0.31 + 0.5)
end

-- center 방향에서 1, width(라디안) 밖에서 0 인 부드러운 혹
local function bump(angle: number, center: number, width: number): number
	local d = math.abs(math.atan2(math.sin(angle - center), math.cos(angle - center)))
	if d >= width then
		return 0
	end
	local t = d / width
	return (1 - t * t) ^ 2
end

-- 해안선·모래사장 ------------------------------------------------------------------

-- 물가(해안선) 반지름(정확한 식): 두 겹 노이즈 + 등대 곶 + 넓은 모래사장 쪽 불룩
local function coastExact(angle: number): number
	local n = around(angle, 1.6, 3.7) * 0.7 + around(angle, 4.2, 8.9) * 0.3
	local r = 263 + 29 * n + HEADLAND.Bulge * bump(angle, HEADLAND.Angle, HEADLAND.Width)
	for _, beach in BEACHES do
		r += beach.Bulge * bump(angle, beach.Angle, beach.Width)
	end
	return math.clamp(r, Island.COAST_MIN, Island.COAST_MAX)
end

-- 모래사장 폭(풀밭 끝 ~ 물가): 대략 9~24(넓은 모래사장은 더 넓게)
local function beachWidth(angle: number): number
	local w = 15 + 9 * around(angle, 2.3, 5.1)
	for _, beach in BEACHES do
		w += beach.Extra * bump(angle, beach.Angle, beach.Width)
	end
	-- 등대 곶은 바위가 차지하므로 모래를 좁게
	w -= 5 * bump(angle, HEADLAND.Angle, HEADLAND.Width)
	return math.max(w, 9)
end

-- 물가 너머 얕은 모래 턱 폭
local function shelfExact(angle: number): number
	return math.clamp(30 + 22 * around(angle, 2.0, 12.4), 16, 46)
end

-- 각도별 표(0.25도 간격, 사이는 직선 보간): 복셀 칸마다 노이즈를 다시 계산하지 않게. 모든 곳이 이 표를 씀
local STEPS = 1440
local COAST: { number } = {}
local GRASS: { number } = {}
local SHELF: { number } = {}
for i = 0, STEPS do
	local angle = i / STEPS * TAU
	local coast = coastExact(angle)
	COAST[i + 1] = coast
	GRASS[i + 1] = smoothMax(coast - beachWidth(angle), Island.GRASS_MIN, 6)
	SHELF[i + 1] = shelfExact(angle)
end

local function lookup(list: { number }, angle: number): number
	local f = (angle % TAU) / TAU * STEPS
	local i = math.floor(f)
	local t = f - i
	if i >= STEPS then -- 아주 작은 음수 각도는 % 뒤에 TAU 로 반올림될 수 있음
		i, t = STEPS - 1, 1
	end
	return list[i + 1] + (list[i + 2] - list[i + 1]) * t
end

-- 물가(해안선) 반지름. angle = 라디안(atan2(z, x))
function Island.coastRadius(angle: number): number
	return lookup(COAST, angle)
end

-- 풀밭 끝(모래 시작) 반지름
function Island.grassEdge(angle: number): number
	return lookup(GRASS, angle)
end

-- 물가 바위 ----------------------------------------------------------------------

-- 물가 바위(지형 Rock): 반쯤 물에 잠긴 둥근 바위. Base = 바위 밑면 높이, Height = 밑면에서 꼭대기까지
export type Rock = { X: number, Z: number, R: number, Height: number, Base: number, Seed: number }
Island.ROCKS = {} :: { Rock }
local function addRock(angleDegrees: number, offset: number, radius: number, height: number)
	local angle = math.rad(angleDegrees)
	local d = Island.coastRadius(angle) + offset
	table.insert(Island.ROCKS, {
		X = math.cos(angle) * d,
		Z = math.sin(angle) * d,
		R = radius,
		Height = height,
		Base = Island.WATER_LEVEL - 2,
		Seed = #Island.ROCKS * 7.31 + 1.7,
	})
end
-- 등대 곶: 큰 바위(꼭대기 약 y 2, 등대 받침) + 물속 바위 둘. 1 번(등대 받침) 말고는 Plan 이 위에 둥근 바윗돌 무더기를 얹음
addRock(315, -3, 13, 8)
addRock(311, 8, 7, 5.5)
addRock(319, 9, 5.5, 5)
-- 물가 여기저기(물 위로 2~3 드러난 울퉁불퉁한 바위 턱 — 위에 Plan 의 둥근 바윗돌 무더기가 올라앉음)
addRock(72, 3, 9, 6.5)
addRock(76.5, 10, 5, 5)
addRock(207, 3, 8.5, 6)
addRock(252, 4, 7, 5.5)
addRock(356, 3, 8, 6)
addRock(101, 6, 5.5, 5)
addRock(118, 20, 4.5, 4.5) -- 부두 옆 물속 바위

-- 바위마다 옆에 붙은 작은 혹 둘(한 덩어리 둥근 돔이 아니라 울퉁불퉁한 바위 무더기로 보이게). 바위 반지름 R 의
-- 1.3 배 안에만 생김(Plan 은 바위 자리를 R * 1.35 까지 비워 둠)
local LOBES: { Rock } = {}
for _, rock in Island.ROCKS do
	for k = 1, 2 do
		local a = rock.Seed * 2.7 + k * 2.4
		local d = rock.R * (0.45 + 0.1 * k)
		table.insert(LOBES, {
			X = rock.X + math.cos(a) * d,
			Z = rock.Z + math.sin(a) * d,
			R = rock.R * (0.62 - 0.1 * k),
			Height = rock.Height * (0.8 - 0.12 * k),
			Base = rock.Base,
			Seed = rock.Seed + k * 5.1,
		})
	end
end
local ROCK_SHAPES: { Rock } = table.clone(Island.ROCKS)
for _, lobe in LOBES do
	table.insert(ROCK_SHAPES, lobe)
end

-- 바위 높이(바위 밖이면 -무한)
local function rockHeight(x: number, z: number): number
	local best = -math.huge
	for _, rock in ROCK_SHAPES do
		local dx, dz = x - rock.X, z - rock.Z
		local reach = rock.R * 1.3
		if dx * dx + dz * dz < reach * reach then
			local a = math.atan2(dz, dx)
			local radius = rock.R * (1 + 0.22 * around(a, 1.8, rock.Seed))
			local t = math.sqrt(dx * dx + dz * dz) / radius
			if t < 1 then
				-- 둥근 돔에 울퉁불퉁한 노이즈(복셀 4 보다 큰 굴곡만 남음)
				local crag = 1 + 0.2 * math.noise(x / 6 + rock.Seed, z / 6 - rock.Seed, 0.37)
				best = math.max(best, rock.Base + rock.Height * (1 - t * t) ^ 0.7 * crag)
			end
		end
	end
	return best
end

-- 먼 작은 섬 ------------------------------------------------------------------------

export type Islet = {
	X: number,
	Z: number,
	R: number,
	Seed: number,
	Reach: number, -- 이 거리 밖은 깊은 바다 바닥
	Stretch: number,
	Axis: number, -- 라디안
	HillX: number, -- 풀 언덕 가운데(월드)
	HillZ: number,
}
local ISLETS: { Islet } = {}
for i, islet in Island.ISLETS do
	local a = math.rad(islet.Angle)
	local x, z = math.cos(a) * islet.Distance, math.sin(a) * islet.Distance
	local axis = math.rad(islet.Axis)
	local hill = islet.Hill * islet.Radius
	table.insert(ISLETS, {
		X = x,
		Z = z,
		R = islet.Radius,
		Seed = 20 + i * 3.3,
		Reach = islet.Radius * 1.35 * islet.Stretch + (Island.WATER_LEVEL - Island.SEA_FLOOR) / DROP_SLOPE + 16,
		Stretch = islet.Stretch,
		Axis = axis,
		HillX = x - math.sin(axis) * hill,
		HillZ = z + math.cos(axis) * hill,
	})
end

function Island.islets(): { Islet }
	local list = {}
	for _, islet in ISLETS do
		table.insert(list, table.clone(islet))
	end
	return list
end

-- 길쭉한 타원(넓이 = 반지름 1 원) 위 angle 방향 반지름 비율
local function ellipse(islet: Islet, angle: number): number
	local c, s = math.cos(angle - islet.Axis), math.sin(angle - islet.Axis)
	return 1 / math.sqrt((c / islet.Stretch) ^ 2 + (s * islet.Stretch) ^ 2)
end

-- 작은 섬 물가 반지름(가운데에서 angle 방향): 길쭉한 타원 + 두 겹 노이즈(한쪽이 곶처럼 튀어나오고 한쪽은 움푹)
function Island.isletRadius(islet: Islet, angle: number): number
	local n = 1 + 0.24 * around(angle, 1.5, islet.Seed) + 0.14 * around(angle, 3.6, islet.Seed + 4.1)
	return islet.R * n * ellipse(islet, angle)
end

-- 작은 섬 위 높이: 한쪽으로 치우친 구불구불한 풀 언덕(물 위 최고 약 5) → 넓은 모래 → 물속
local function isletHeight(islet: Islet, x: number, z: number): (number, string)
	local dx, dz = x - islet.X, z - islet.Z
	local radius = Island.isletRadius(islet, math.atan2(dz, dx))
	local d = math.sqrt(dx * dx + dz * dz)
	local u = d / radius
	local wl = Island.WATER_LEVEL
	if u <= 1 then
		-- 모래: 가운데 쪽은 물 위 2.5, 물가로 갈수록 낮아짐
		local h = wl + 2.5 * (1 - smooth((u - 0.35) / 0.65))
		-- 풀 언덕: 치우친 가운데에서 구불구불한 가장자리까지(물가 가까이는 스며들어 모래)
		local hx, hz = x - islet.HillX, z - islet.HillZ
		local ha = math.atan2(hz, hx)
		local hillR = islet.R * 0.52 * (1 + 0.28 * around(ha, 2.2, islet.Seed + 9)) * ellipse(islet, ha)
		local hu = math.sqrt(hx * hx + hz * hz) / hillR
		local fade = 1 - smooth((u - 0.55) / 0.3)
		if hu < 1 and fade > 0 then
			h += 2.6 * smooth((1 - hu) / 0.7) * fade
			if hu < 0.92 and u < 0.8 then
				return h, "Grass"
			end
		end
		return h, "Sand"
	end
	local under = d - radius
	-- 물가 너머 얕은 턱(8)은 짧게: 먼 섬 둘레의 밝은 청록 테가 너무 넓게 번지지 않게
	local h = math.max(Island.SEA_FLOOR, wl - under * 0.25 - math.max(0, under - 8) * DROP_SLOPE)
	return h, if h < wl - 5 then "Mud" else "Sand"
end

-- 땅 높이·재질 ------------------------------------------------------------------------

-- 공원·숲띠 잔디 재질: 풀(장식 풀잎) 사이사이 잎 풀(LeafyGrass) 무늬
local function lawnMaterial(x: number, z: number): string
	local v = math.noise(x / 26 + 4.7, z / 26 - 1.9, 0.71) + 0.4 * math.noise(x / 9 + 0.3, z / 9 + 5.1, 0.13)
	return if v > 0.3 then "LeafyGrass" else "Grass"
end

-- 본섬(바위 제외) 높이와 재질. r = 원점 거리
local function mainHeight(x: number, z: number, r: number): (number, string)
	if r <= Island.FLAT_RADIUS then
		return 0, lawnMaterial(x, z)
	end
	local angle = math.atan2(z, x)
	local coast = lookup(COAST, angle)
	local grass = lookup(GRASS, angle)
	local wl = Island.WATER_LEVEL
	if r < grass then
		-- 숲띠: 공원 쪽과 모래 쪽 끝에서는 0 으로 스며드는 둥근 언덕
		local n = math.noise(x / 44 + 17.1, z / 44 + 3.3, 0.5) + 0.45 * math.noise(x / 17 + 2.2, z / 17 + 9.4, 0.27)
		local fade = smooth((r - Island.FLAT_RADIUS) / 14) * smooth((grass - r) / 9)
		return MOUND_HEIGHT * smooth((n + 0.05) / 0.6) * fade, lawnMaterial(x, z)
	elseif r <= coast then
		-- 모래사장: 풀밭 쪽은 완만하게, 물가 쪽은 조금 가파르게
		local u = (r - grass) / math.max(coast - grass, 1)
		return wl * u ^ 1.4, "Sand"
	end
	local d = r - coast
	local shelf = lookup(SHELF, angle)
	local h
	if d < shelf then
		h = wl - SHALLOW_DEPTH * (d / shelf)
	else
		h = math.max(Island.SEA_FLOOR, wl - SHALLOW_DEPTH - (d - shelf) * DROP_SLOPE)
	end
	return h, if h < wl - SHALLOW_DEPTH - 1.5 then "Mud" else "Sand"
end

-- (x, z) 의 땅 윗면 높이와 재질 이름(바위·작은 섬 포함, 연못·칠하기 제외)
function Island.surface(x: number, z: number): (number, string)
	local r = math.sqrt(x * x + z * z)
	local h, material
	if r < Island.REGION_HALF then
		h, material = mainHeight(x, z, r)
	else
		h, material = Island.SEA_FLOOR, "Mud"
		for _, islet in ISLETS do
			local dx, dz = x - islet.X, z - islet.Z
			if dx * dx + dz * dz < islet.Reach * islet.Reach then
				local ih, im = isletHeight(islet, x, z)
				if ih > h then
					h, material = ih, im
				end
			end
		end
	end
	local rock = rockHeight(x, z)
	if rock > h + 0.25 then
		return rock, "Rock"
	end
	return h, material
end

function Island.height(x: number, z: number): number
	return (Island.surface(x, z))
end

-- 반지름 radius 원 안(가운데 + 둘레 8곳)에서 가장 낮은 땅 높이: 비탈에 선 나무·기둥 밑이 뜨지 않게
function Island.lowestAround(x: number, z: number, radius: number): number
	local low = Island.height(x, z)
	for k = 0, 7 do
		local a = k / 8 * TAU
		low = math.min(low, Island.height(x + math.cos(a) * radius, z + math.sin(a) * radius))
	end
	return low
end

-- 물 위 마른 땅인지(모래사장 장식 검사용)
function Island.isDry(x: number, z: number): boolean
	return Island.height(x, z) > Island.WATER_LEVEL + 0.2
end

-- 칠하기·연못 ------------------------------------------------------------------------

-- 지형 윗면 칠하기(Plan 이 만듦): 부지·길·산책로·광장·납작한 장식 밑은 풀잎(Grass 장식)이 얇은 파트를
-- 뚫고 나오지 않게 다른 재질로. Margin = 모양 밖으로 더 칠할 거리(기본 3: 복셀 반 대각선 + 풀잎 여유)
export type Shape = {
	Kind: string, -- "Circle" | "Blob"(가장자리가 구불구불한 원) | "Ring" | "Segment" | "Box"
	Material: string,
	Margin: number?,
	X: number?, -- Circle/Box 중심
	Z: number?,
	R: number?, -- Circle 반지름
	R1: number?, -- Ring(원점 중심) 안·바깥 반지름
	R2: number?,
	X1: number?, -- Segment 양 끝 + 반폭
	Z1: number?,
	X2: number?,
	Z2: number?,
	Half: number?,
	DirX: number?, -- Box: 로컬 Z 축(단위 벡터), 반폭(X)·반깊이(Z)
	DirZ: number?,
	HalfX: number?,
	HalfZ: number?,
}

-- 연못: 물 윗면 y = 0(공원 땅과 같은 높이), 가운데 깊이 Depth, 가장자리 구불구불
export type Pond = { X: number, Z: number, R: number, Depth: number, Seed: number }

-- (x, z) 가 모양 안(+ margin + extra)인지
function Island.inShape(shape: Shape, x: number, z: number, extra: number?): boolean
	local m = (shape.Margin or 3) + (extra or 0)
	local kind = shape.Kind
	if kind == "Circle" then
		local dx, dz = x - (shape.X :: number), z - (shape.Z :: number)
		local reach = (shape.R :: number) + m
		return dx * dx + dz * dz <= reach * reach
	elseif kind == "Blob" then
		local dx, dz = x - (shape.X :: number), z - (shape.Z :: number)
		local r = shape.R :: number
		local reach = r * (1 + 0.3 * around(math.atan2(dz, dx), 1.4, (shape.X :: number) * 0.01 + 3)) + m
		return dx * dx + dz * dz <= reach * reach
	elseif kind == "Ring" then
		local r = math.sqrt(x * x + z * z)
		return r >= (shape.R1 :: number) - m and r <= (shape.R2 :: number) + m
	elseif kind == "Segment" then
		local x1, z1, x2, z2 = shape.X1 :: number, shape.Z1 :: number, shape.X2 :: number, shape.Z2 :: number
		local vx, vz = x2 - x1, z2 - z1
		local length2 = vx * vx + vz * vz
		local t = if length2 > 0 then math.clamp(((x - x1) * vx + (z - z1) * vz) / length2, 0, 1) else 0
		local px, pz = x1 + vx * t - x, z1 + vz * t - z
		local reach = (shape.Half :: number) + m
		return px * px + pz * pz <= reach * reach
	elseif kind == "Box" then
		local dirX, dirZ = shape.DirX :: number, shape.DirZ :: number
		local dx, dz = x - (shape.X :: number), z - (shape.Z :: number)
		local lz = dx * dirX + dz * dirZ
		local lx = dx * dirZ - dz * dirX
		return math.abs(lx) <= (shape.HalfX :: number) + m and math.abs(lz) <= (shape.HalfZ :: number) + m
	end
	return false
end

-- 모양이 차지하는 사각 범위(minX, minZ, maxX, maxZ, 여유 포함)
local function shapeBounds(shape: Shape): (number, number, number, number)
	local m = (shape.Margin or 3) + 3
	local kind = shape.Kind
	if kind == "Circle" or kind == "Blob" then
		local x, z, r = shape.X :: number, shape.Z :: number, (shape.R :: number) * (if kind == "Blob" then 1.3 else 1)
		return x - r - m, z - r - m, x + r + m, z + r + m
	elseif kind == "Ring" then
		local r = (shape.R2 :: number) + m
		return -r, -r, r, r
	elseif kind == "Segment" then
		local h = (shape.Half :: number) + m
		local x1, z1, x2, z2 = shape.X1 :: number, shape.Z1 :: number, shape.X2 :: number, shape.Z2 :: number
		return math.min(x1, x2) - h, math.min(z1, z2) - h, math.max(x1, x2) + h, math.max(z1, z2) + h
	end
	local reach = math.sqrt((shape.HalfX :: number) ^ 2 + (shape.HalfZ :: number) ^ 2) + m
	local x, z = shape.X :: number, shape.Z :: number
	return x - reach, z - reach, x + reach, z + reach
end

-- 연못 가장자리 반지름(구불구불). angle = 연못 가운데에서 본 방향(라디안)
function Island.pondRadius(pond: Pond, angle: number): number
	return pond.R * (1 + 0.16 * around(angle, 1.4, pond.Seed))
end

-- 연못 깊이(연못 밖이면 0)
function Island.pondDepth(ponds: { Pond }, x: number, z: number): number
	local depth = 0
	for _, pond in ponds do
		local dx, dz = x - pond.X, z - pond.Z
		local reach = pond.R * 1.25
		if dx * dx + dz * dz < reach * reach then
			local radius = Island.pondRadius(pond, math.atan2(dz, dx))
			local t = math.sqrt(dx * dx + dz * dz) / radius
			if t < 1 then
				depth = math.max(depth, pond.Depth * smooth((1 - t) / 0.45))
			end
		end
	end
	return depth
end

-- 복셀 표 ------------------------------------------------------------------------------

-- WriteVoxelChannels 모양: [x][y][z] 3차원 표. Material = 재질(materials 표로 바꾼 값), Solid/Liquid = 0~1
export type Grid = {
	MinX: number,
	MinY: number,
	MinZ: number,
	SizeX: number, -- 복셀 수
	SizeY: number,
	SizeZ: number,
	Material: { { { any } } },
	Solid: { { { number } } },
	Liquid: { { { number } } },
	SolidCount: number, -- 땅이 조금이라도 있는 복셀 수
	WaterCount: number, -- 물이 조금이라도 있는 복셀 수
}

export type GridOptions = {
	Paint: { Shape }?,
	Ponds: { Pond }?,
	-- 재질 이름 → 실제 값(Enum.Material.X). 없으면 이름 문자열 그대로(테스트)
	Materials: { [string]: any }?,
}

-- 원점 기준 (minX, minZ) 에서 sizeX x sizeZ 복셀(한 변 VOXEL) 칸의 지형 표. y 는 SEA_FLOOR ~ TOP
function Island.voxels(minX: number, minZ: number, sizeX: number, sizeZ: number, options: GridOptions?): Grid
	local V = Island.VOXEL
	local opts: GridOptions = options or {}
	local names = opts.Materials
	local function mat(name: string): any
		return if names then names[name] else name
	end
	local minY = Island.SEA_FLOOR
	local sizeY = (Island.TOP - minY) // V
	local wl = Island.WATER_LEVEL

	-- 칠하기: 모양마다 걸치는 칸만 돌며 칸 가운데를 검사(나중 모양이 앞 모양을 덮음)
	local paint: { [number]: string } = {}
	for _, shape in opts.Paint or {} do
		local x0, z0, x1, z1 = shapeBounds(shape)
		local i0 = math.max(0, math.floor((x0 - minX) / V))
		local i1 = math.min(sizeX - 1, math.floor((x1 - minX) / V))
		local k0 = math.max(0, math.floor((z0 - minZ) / V))
		local k1 = math.min(sizeZ - 1, math.floor((z1 - minZ) / V))
		for i = i0, i1 do
			local cx = minX + (i + 0.5) * V
			for k = k0, k1 do
				if Island.inShape(shape, cx, minZ + (k + 0.5) * V) then
					paint[i * 100000 + k] = shape.Material
				end
			end
		end
	end
	local ponds = opts.Ponds or {}

	local materials: { { { any } } } = {}
	local solids: { { { number } } } = {}
	local liquids: { { { number } } } = {}
	local solidCount, waterCount = 0, 0
	local air = mat("Air")
	for i = 1, sizeX do
		local mx, sx, lx = {}, {}, {}
		materials[i], solids[i], liquids[i] = mx, sx, lx
		for j = 1, sizeY do
			mx[j], sx[j], lx[j] = {}, {}, {}
		end
		local cx = minX + (i - 0.5) * V
		for k = 1, sizeZ do
			local cz = minZ + (k - 0.5) * V
			local h, name = Island.surface(cx, cz)
			local waterTop = wl
			local depth = if #ponds > 0 then Island.pondDepth(ponds, cx, cz) else 0
			if depth > 0 then
				h = math.min(h, -depth)
				waterTop = 0
				name = if depth > 2.5 then "Mud" elseif depth > 0.6 then "Sand" else name
			end
			local painted = paint[(i - 1) * 100000 + (k - 1)]
			if painted and depth <= 0.6 and name ~= "Sand" and name ~= "Rock" then
				name = painted
			end
			local solidMaterial = mat(name)
			-- 칸 한 줄(아래 → 위): 땅 윗면 h 아래는 땅, 그 위 물 높이까지는 물.
			-- 땅은 Roblox 가 반 칸 위에 그리므로 SOLID_LIFT 만큼 낮춘 높이로 점유율을 셈(보이는 윗면 = h)
			local solidTop = h - Island.SOLID_LIFT
			for j = 1, sizeY do
				local bottom = minY + (j - 1) * V
				local solid = (solidTop - bottom) / V
				if solid >= 1 then
					solid = 1
				elseif solid <= 0 then
					solid = 0
				end
				local liquid = (waterTop - bottom) / V
				if liquid >= 1 then
					liquid = 1
				end
				liquid -= solid
				if liquid < 0 then
					liquid = 0
				end
				if solid > 0 then
					mx[j][k] = solidMaterial
					solidCount += 1
				else
					mx[j][k] = air
				end
				sx[j][k] = solid
				lx[j][k] = liquid
				if liquid > 0 then
					waterCount += 1
				end
			end
		end
	end
	return {
		MinX = minX,
		MinY = minY,
		MinZ = minZ,
		SizeX = sizeX,
		SizeY = sizeY,
		SizeZ = sizeZ,
		Material = materials,
		Solid = solids,
		Liquid = liquids,
		SolidCount = solidCount,
		WaterCount = waterCount,
	}
end

-- WriteVoxels(예전 API: 복셀마다 재질 하나)용 표로 바꿈: 땅이 반 이상이면 땅, 아니고 물이 있으면 물(가득)
function Island.legacy(grid: Grid, water: any, air: any): ({ { { any } } }, { { { number } } })
	local materials: { { { any } } } = {}
	local occupancies: { { { number } } } = {}
	for i = 1, grid.SizeX do
		local mi, oi = {}, {}
		materials[i], occupancies[i] = mi, oi
		for j = 1, grid.SizeY do
			local mj, oj = {}, {}
			mi[j], oi[j] = mj, oj
			local gm, gs, gl = grid.Material[i][j], grid.Solid[i][j], grid.Liquid[i][j]
			for k = 1, grid.SizeZ do
				local solid, liquid = gs[k], gl[k]
				if solid >= 0.5 or (solid > 0 and liquid <= 0) then
					mj[k], oj[k] = gm[k], solid
				elseif liquid > 0 then
					mj[k], oj[k] = water, 1
				else
					mj[k], oj[k] = air, 0
				end
			end
		end
	end
	return materials, occupancies
end

-- 쓸 복셀 표 범위: 본섬 한 장 + 작은 섬마다 한 장. Min = 월드 좌표(복셀 경계), Size = 복셀 수
export type Area = { Name: string, MinX: number, MinZ: number, SizeX: number, SizeZ: number }
function Island.areas(): { Area }
	local V = Island.VOXEL
	local half = Island.REGION_HALF
	local count = half * 2 // V
	local list: { Area } = {
		{ Name = "Island", MinX = -half, MinZ = -half, SizeX = count, SizeZ = count },
	}
	for i, islet in ISLETS do
		local x0 = math.floor((islet.X - islet.Reach) / V) * V
		local z0 = math.floor((islet.Z - islet.Reach) / V) * V
		local x1 = math.ceil((islet.X + islet.Reach) / V) * V
		local z1 = math.ceil((islet.Z + islet.Reach) / V) * V
		local sizeX, sizeZ = (x1 - x0) // V, (z1 - z0) // V
		table.insert(list, { Name = "Islet" .. i, MinX = x0, MinZ = z0, SizeX = sizeX, SizeZ = sizeZ })
	end
	return list
end

-- 먼 바다 FillBlock 조각(가운데 x, z, 한 변). 바닥 판(FLOOR_BOTTOM ~ SEA_FLOOR)과 물(SEA_FLOOR ~ WATER_LEVEL)
export type Tile = { X: number, Z: number, Size: number }
function Island.oceanTiles(): { Tile }
	local list: { Tile } = {}
	local tile = Island.OCEAN_TILE
	local count = Island.OCEAN_HALF * 2 // tile
	for i = 0, count - 1 do
		for k = 0, count - 1 do
			table.insert(list, {
				X = -Island.OCEAN_HALF + (i + 0.5) * tile,
				Z = -Island.OCEAN_HALF + (k + 0.5) * tile,
				Size = tile,
			})
		end
	end
	return list
end

-- 지형 재질 색(SetMaterialColor, RGB): 게임 전체의 밝은 만화풍에 맞춤
Island.COLORS = {
	Grass = { 106, 190, 78 }, -- 싱싱한 잔디
	LeafyGrass = { 126, 198, 84 }, -- 잔디 무늬(조금 밝은 연두). 부지·길 밑 칠하기에도 씀(풀잎 장식 없음)
	Sand = { 240, 220, 168 }, -- 밝고 따뜻한 모래
	Rock = { 150, 146, 140 }, -- 따뜻한 회색 바위
	Mud = { 58, 116, 128 }, -- 깊은 바다·연못 바닥(물 너머로 짙은 청록)
	Salt = { 222, 214, 196 }, -- 바위 정원 자갈(따뜻한 흰색)
}

-- 물 속성(Terrain.WaterColor 등)
Island.WATER = {
	Color = { 38, 178, 196 }, -- 청록
	Transparency = 0.5,
	Reflectance = 0.45,
	WaveSize = 0.08,
	WaveSpeed = 8,
}

return Island
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">Plan</string>
            <string name="Source"><![CDATA[--!strict
-- 주변 풍경 배치 계획(순수 계산: Instance 없이 숫자 표만 만듦). Scenery/init.luau 가 이 표대로 파트·지형을 만듭니다.
-- 섬 모양(해안선·땅 높이·물가 바위·먼 작은 섬)은 Scenery/Island 가 정하고, 여기서는 그 위에 무엇을 둘지 정합니다.
--
-- 구역(광장 중심에서의 거리 r):
--   r 62~115    안쪽 잔디: 산책로 고리(r 84), 부지 길 양옆 산울타리(한쪽은 꽃 핀), 길 입구 덤불, 틈 앞 꽃밭·벤치,
--               작은 꽃나무
--   r 115~205   이웃 부지 사이 쐐기 틈 8곳: 틈마다 주제가 다른 정원(분수 광장/꽃 정원/과수원/연못과 다리/
--               소풍 잔디/바위 정원/토피어리 길/정자) + 가운데 오솔길(정원마다 재질이 다름)
--               + 틈 양옆(부지 울타리 쪽) 심은 무더기 넷(작은 나무 + 덤불 + 들꽃)
--   r 205~212   바깥 산책로 고리. 부지 뒤마다 벤치 + 정원등 + 양옆 산울타리(망원경 / 들꽃·꽃 산울타리 번갈아)
--   212~풀밭 끝  숲띠: 부지 뒤 양옆 숲 무리(큰 나무 가운데 + 둘레 작은 나무·기둥 나무, 가끔 분홍 꽃나무 무리)
--               + 빈터 바위·들꽃, 숲 가장자리 덤불, 모래 쪽은 야자수
--   모래사장    등대(곶 바위 위), 부두(T자 끝 + 구명 튜브 + 매어 둔 배), 파라솔·선베드 묶음, 간식 가게, 모래성, 구조대 망루,
--               야자수 무리(1~3 그루씩), 물가 바위 턱 위 둥근 화강암 바윗돌 무더기
--   바다        돛단배, 수영 구역 부표 줄, 먼 작은 섬(지형: 길쭉한 모래섬 + 치우친 풀 언덕) 위 야자수·덤불
-- 모든 장식은 ParkLayout.blocked(부지·간판·길·광장)와 산책로를 비켜 가고, 서로 겹치지 않게 놓습니다.
-- 난수는 구역마다 고정 시드(Rng)라서 한 구역을 고쳐도 다른 구역 배치는 그대로입니다.

local Island = require(script.Parent.Island)
local ParkLayout = require(script.Parent.Parent.ParkLayout)
local Rng = require(script.Parent.Rng)

type Rng = Rng.Rng

local Plan = {}

local TAU = math.pi * 2
local WATER = Island.WATER_LEVEL

-- 조절 값 ---------------------------------------------------------------------
local T = {
	SEED = 8128,

	-- 산책로. 고리는 짧은 곧은 판 Segments 개(이음매마다 조금만 꺾여서 둥글게 보임).
	-- 이웃 판끼리 윗면 높이를 0.05 씩 번갈아(겹치는 모서리가 같은 높이에서 깜빡이지 않게).
	-- 안쪽 고리는 원이 아니라 느린 물결 셋을 겹친 구불구불한 고리(반지름 Radius ± Wobble: 약 71~95,
	-- 광장 둘레 나무 고리(62)와 부지 입구 간판 자리(104) 사이). 바깥 고리는 부지 뒤 좁은 자리라 원
	-- 재질: 안쪽은 밝은 돌길, 바깥(숲띠 속)은 짙은 모래색 자갈길(흰 원이 눈에 띄지 않게)
	INNER_RING = { Radius = 82, Width = 7, Segments = 80, Wobble = 15, Material = "Cobblestone" },
	OUTER_RING = {
		Radius = 208.5,
		Width = 7,
		Segments = 96,
		Wobble = 0,
		Material = "Pebble",
		Color = { 196, 174, 136 },
	},
	RING_TOP = 0.15, -- 고리 윗면(홀수 번째 판은 0.1). 부지 길(0.2)보다 낮아서 겹치는 곳은 부지 길이 보임
	TRAIL_TOP = 0.18, -- 정원 오솔길 윗면(고리 위로 살짝 올라탐)
	DISC_TOP = 0.12, -- 분수 광장 원판 윗면(오솔길 끝이 그 위로 올라탐)
	ROUTE_HEIGHT = 0.3, -- 산책로 판 두께
	WALKWAY_MATERIAL = "Cobblestone",
	TRAIL_WIDTH = 5,
	ROUTE_MARGIN = 1.5, -- 산책로 양옆 여유(벤치·정원등은 따로 더 가깝게)
	EDGE_MARGIN = 2, -- 풀밭 끝(모래 시작) 안쪽 여유
	SPACING = 0.6, -- 장식끼리 최소 틈
	CORRIDOR_HALF_WIDTH = 10, -- 광장에서 틈 방향으로 바다가 보이게 큰 나무를 두지 않는 반폭(바깥 고리 너머)

	-- 틈 정원 주제(ParkLayout.gapAngles() 순서: 270도 = 지구본 뒤, 315도(등대 쪽), 0도, ... 225도)
	GARDEN_THEMES = { "Fountain", "Flowers", "Orchard", "Pond", "Picnic", "Rockery", "Topiary", "Gazebo" },

	-- 숲띠
	BELT = {
		GroveRadius = 14, -- 숲 무리 반지름
		BlossomGroves = 0.25, -- 큰 무리가 꽃나무(분홍) 무리일 확률
		SlimChance = 0.3, -- 초록 무리 둘레 나무가 기둥 나무(Style 5)일 확률
		Trees = 76, -- 넓은잎나무 최대 수(보통 무리 크기로 정해짐)
		Palms = 10, -- 모래 쪽 야자수 최대 수
		TreeScale = { 1.05, 1.45 },
		PalmScale = { 1.05, 1.35 },
		BushChance = 0.3, -- 나무마다 옆에 덤불을 둘 확률
		Rocks = 7,
		Meadows = 7, -- 빈터 들꽃 자리 수(자리마다 무더기 1~2)
		-- 풀밭 끝(모래 시작) 덤불 띠: FringeStep 스터드마다 한 자리, 띠 밀도(각도 물결)가 FringeCut 보다 큰 곳에만
		-- (덤불 무리와 트인 곳이 번갈아: 고르게 흩뿌리지 않음)
		FringeStep = 11,
		FringeCut = 0.2,
	},

	BEACH = {
		PalmGroves = 13, -- 모래사장 야자수 무리 수(섬 둘레에 고르지 않은 간격으로, 무리마다 1~3 그루)
		-- 파라솔 묶음 자리(도)
		SetZones = {
			{ From = 163, To = 184, Count = 4 },
			{ From = 21, To = 37, Count = 3 },
			{ From = 212, To = 228, Count = 3 },
		},
		Surfboards = { 199, 44, 188 }, -- 서핑보드 거치대(도, 풀밭 끝 가까운 모래)
		-- 모래 오솔길(지형 칠하기): 바깥 산책로에서 모래사장으로 굽이쳐 내려감(도). 등대 쪽은 등대까지
		Footpaths = { 315, 135, 173.5, 38, 217.3 },
		FootpathHalf = 3,
		Driftwood = 6, -- 떠밀려 온 나무(물가 가까운 모래)
		KioskAngle = 142,
		LifeguardAngle = 191, -- 구조대 망루(수영 구역 부표 옆 모래사장)
		PierLength = 48, -- 물가에서 바다 쪽으로(부두 T자 끝까지)
		PierWidth = 5,
		PierHead = { Width = 13, Depth = 7 }, -- T자 끝 판
		DeckTop = 0.4, -- 부두 윗면
		Buoys = { From = 166, To = 198, Count = 7, Offset = 24 }, -- 수영 구역 부표(물가에서 바다 쪽 거리)
	},

	SEA = {
		Boats = { -- Scale = 크기 배율(멀리 있는 배는 크게 해서 수평선에서도 보이게)
			{ Angle = 172, Offset = 55, Heading = 70, Scale = 1.2 },
			{ Angle = 24, Offset = 70, Heading = 130, Scale = 1.4 },
			{ Angle = 252, Offset = 120, Heading = -20, Scale = 1.8 },
			{ Angle = 300, Offset = 210, Heading = 35, Scale = 2.2 },
			{ Angle = 95, Offset = 170, Heading = 170, Scale = 2 },
		},
	},

	-- 보이지 않는 벽: 물가 + Offset 을 Step 도 간격으로 짚은 뒤, 곧게 펴도 Tolerance 이상 안 벗어나는 점은 뺌
	WALL = { Step = 1, Tolerance = 1.2, Offset = 3, Height = 60, Bottom = -14, PierGap = 0.4 },
}
Plan.Tuning = T

-- 장식 하나. Kind 별 모양은 Scenery/Props.luau
export type Item = {
	Kind: string,
	Zone: string, -- 파트 개수를 셀 때 묶는 구역
	X: number,
	Y: number, -- 서 있는 땅의 윗면 높이(비탈이면 발밑 가장 낮은 곳)
	Z: number,
	Radius: number, -- 바닥 반지름(비켜 가기·간격)
	Scale: number,
	Turn: number, -- 방향(라디안). (cos, sin) = 앞(벤치·배)이나 기우는 쪽(나무)
	Tint: number, -- 0~1 색·모양 변화
	Style: number, -- 종류 안의 모양/색 번호
	Height: number, -- 산울타리·부두·다리: 길이
	Layer: string, -- "Solid"(서로 안 겹침) / "Free"(검사 안 함)
}

-- 산책로 판: 고리(곧은 판 Segments 개), 곧은 길 조각, 둥근 광장 원판
-- 고리: Points = 가운데 선 꼭짓점(닫힌 꺾은선, 각도가 커지는 순서), 판은 꼭짓점 사이마다 하나
export type Ring = {
	Radius: number,
	Width: number,
	Segments: number,
	Top: number,
	Material: string,
	Color: { number }?, -- 없으면 재질 기본색(Scenery/init 의 ROUTE_COLORS)
	Points: { { number } },
}
export type Segment = { X1: number, Z1: number, X2: number, Z2: number, Width: number, Top: number, Material: string }
export type Disc = { X: number, Z: number, R: number, Top: number, Material: string }

export type Result = {
	Items: { Item },
	Rings: { Ring },
	Trails: { Segment },
	Discs: { Disc },
	Wall: { Points: { { number } }, Height: number, Bottom: number }, -- 닫힌 꺾은선(안쪽 면이 선 위)
	Paint: { Island.Shape }, -- 지형 윗면 칠하기
	Ponds: { Island.Pond }, -- 지형 연못(물 윗면 y = 0)
	Skipped: { [string]: number }, -- 자리가 없어 못 놓은 장식 수("구역/종류" 별)
}

type Circle = { X: number, Z: number, R: number }
type Capsule = { X1: number, Z1: number, X2: number, Z2: number, R: number }

type Ctx = {
	Items: { Item },
	Cells: { [number]: { Item } },
	Big: { Item },
	Keep: { Circle }, -- 아무것도 두지 않을 원(부두 발판, 바위, 연못)
	Capsules: { Capsule }, -- 산울타리처럼 긴 장식
	Paint: { Island.Shape },
	Skipped: { [string]: number },
}

-- 놓을 장식 설명. Region: "Island"(풀밭) / "Beach"(마른 모래) / "Free"
type Spec = {
	Kind: string,
	Zone: string,
	Region: string,
	X: number,
	Z: number,
	Y: number?,
	Radius: number,
	Scale: number?,
	Turn: number?,
	Tint: number?,
	Style: number?,
	Height: number?,
	Layer: string?,
	RouteMargin: number?, -- 산책로 여유를 따로(벤치·정원등)
	OnRoute: boolean?, -- 산책로 위에 일부러 두는 것(분수·정자·다리·연못 꾸밈·아치): 산책로 검사를 건너뜀
	Tall: boolean?, -- 큰 나무: 광장에서 바다가 보이는 틈 방향(시야)을 비켜 감
	Flat: number?, -- 납작한 장식: 이 반지름만큼 지형을 풀잎 없는 재질로 칠함
	Foot: number?, -- 발밑 높이를 잴 반지름(기본 min(Radius, 1.5))
}

local GAP_ANGLES = ParkLayout.gapAngles()
local FOOTPRINTS = ParkLayout.footprints()
local RINGS = { T.INNER_RING, T.OUTER_RING }

type RingTuning = {
	Radius: number,
	Width: number,
	Segments: number,
	Wobble: number,
	Material: string,
	Color: { number }?,
}

-- 고리 가운데 선의 반지름(각도 = 라디안). 물결 셋(2·3·5 번 도는)을 겹쳐서 한 바퀴 돌면 제자리, 최대 ±Wobble
local function ringRadius(ring: RingTuning, angle: number): number
	local wobble = ring.Wobble
	if wobble == 0 then
		return ring.Radius
	end
	local n = 0.5 * math.sin(2 * angle + 0.7) + 0.35 * math.sin(3 * angle + 2.1) + 0.15 * math.sin(5 * angle + 4)
	return ring.Radius + wobble * n
end
Plan.ringRadius = ringRadius

-- 고리마다 가운데 선 꼭짓점(모듈을 불러올 때 한 번)
local RING_POINTS: { { { number } } } = {}
for i, ring in RINGS do
	local points = {}
	for k = 0, ring.Segments - 1 do
		local a = k / ring.Segments * TAU
		local r = ringRadius(ring, a)
		table.insert(points, { math.cos(a) * r, math.sin(a) * r })
	end
	RING_POINTS[i] = points
end

local CELL = 24
local BIG = 12 -- 이보다 큰 장식은 격자 대신 따로 모아 둠

-- 도움 함수 -------------------------------------------------------------------

local function polar(angle: number, distance: number): (number, number)
	return math.cos(angle) * distance, math.sin(angle) * distance
end

-- angle 방향 축을 따라 along 만큼 가고, 옆(각도가 커지는 쪽이 +)으로 side 만큼 간 곳
local function onAxis(angle: number, along: number, side: number): (number, number)
	local dx, dz = math.cos(angle), math.sin(angle)
	return dx * along - dz * side, dz * along + dx * side
end

-- (x, z) 에서 (tx, tz) 를 바라보는 방향(라디안)
local function facing(x: number, z: number, tx: number, tz: number): number
	return math.atan2(tz - z, tx - x)
end

-- 선분 (x1, z1)-(x2, z2) 까지 거리
local function segmentDistance(x: number, z: number, x1: number, z1: number, x2: number, z2: number): number
	local vx, vz = x2 - x1, z2 - z1
	local length2 = vx * vx + vz * vz
	local t = if length2 > 0 then math.clamp(((x - x1) * vx + (z - z1) * vz) / length2, 0, 1) else 0
	local px, pz = x1 + vx * t - x, z1 + vz * t - z
	return math.sqrt(px * px + pz * pz)
end

-- 고리 index 가운데 선까지 거리(각도로 가까운 판 셋만 봄)
local function ringDistance(index: number, x: number, z: number): number
	local points = RING_POINTS[index]
	local n = #points
	local k = math.floor((math.atan2(z, x) % TAU) / TAU * n)
	local best = math.huge
	for d = -1, 1 do
		local i = (k + d) % n
		local p, q = points[i + 1], points[(i + 1) % n + 1]
		best = math.min(best, segmentDistance(x, z, p[1], p[2], q[1], q[2]))
	end
	return best
end

-- 정원 오솔길 모양 -------------------------------------------------------------------
-- 오솔길은 틈 가운데 선(안쪽 고리 r 84 → 바깥 고리 r 208.5). Cut = 오솔길을 끊는 구간(rho),
-- Disc = 그 자리의 광장 원판(Build 면 산책로처럼 만듦, 아니면 장식이 바닥을 만듦), Bridge = 연못 위 다리
-- Curve = 오솔길이 넓은 곳(rho 140 너머)에서 옆으로 굽이치는 폭(0 이면 곧게). 한 조각이 길면 S 자, 짧으면 한 번 휨
type ThemeRoute = {
	Material: string,
	Curve: number?,
	Cut: { number }?,
	Disc: { Rho: number, R: number, Top: number?, Material: string?, Build: boolean }?,
	Bridge: { From: number, To: number, Width: number }?,
	Pond: { Rho: number, R: number, Depth: number }?,
}
local THEME_ROUTES: { [string]: ThemeRoute } = {
	Fountain = {
		Material = "Cobblestone",
		Cut = { 158, 182 },
		Disc = { Rho = 170, R = 13, Build = true },
	},
	Flowers = { Material = "Brick", Curve = 6 },
	Orchard = { Material = "Pebble", Curve = 7 },
	Pond = {
		Material = "Cobblestone",
		Cut = { 155, 185 },
		Bridge = { From = 153, To = 187, Width = 4.6 },
		Pond = { Rho = 170, R = 11.5, Depth = 3.5 },
	},
	Picnic = { Material = "Pebble", Curve = 7 },
	Rockery = { Material = "Slate", Curve = 6 },
	Topiary = { Material = "Brick" },
	Gazebo = {
		Material = "Cobblestone",
		Curve = 4,
		Cut = { 170, 182 },
		Disc = { Rho = 176, R = 7.5, Top = 0.4, Material = "WoodPlanks", Build = false },
	},
}

local CURVE_FROM = 140 -- 틈이 넓어지는 곳(여기부터 오솔길이 굽이침)

-- 오솔길 한 조각(rho a → b)을 곧은 판 여러 개로. curve ~= 0 이면 CURVE_FROM 너머에서 옆으로 굽이침(양 끝은 가운데 선).
-- 이음매에서 꺾이는 만큼 판을 늘려 바깥 틈을 덮고, 이웃 판끼리 윗면을 0.04 씩 번갈아(겹친 곳이 깜빡이지 않게)
local function trailPieces(angle: number, a: number, b: number, curve: number, material: string): { Segment }
	local points: { { number } } = {}
	local start = math.max(a, CURVE_FROM)
	if curve == 0 or b - start < 12 then
		points = { { a, 0 }, { b, 0 } }
	else
		if start > a then
			table.insert(points, { a, 0 })
		end
		local waves = if b - start > 45 then 2 else 1 -- 길면 S 자
		local steps = math.max(4, math.ceil((b - start) / 4))
		for k = 0, steps do
			local u = k / steps
			local side = curve * math.sin(math.pi * waves * u) * (if waves == 2 then 1 else 0.8)
			table.insert(points, { start + (b - start) * u, side })
		end
	end
	local world: { { number } } = {}
	for _, p in points do
		local x, z = onAxis(angle, p[1], p[2])
		table.insert(world, { x, z })
	end
	local half = T.TRAIL_WIDTH / 2
	local function unit(p: { number }, q: { number }): (number, number)
		local dx, dz = q[1] - p[1], q[2] - p[2]
		local length = math.sqrt(dx * dx + dz * dz)
		return dx / length, dz / length
	end
	local function bend(k: number): number
		if k <= 1 or k >= #world then
			return 0
		end
		local ux, uz = unit(world[k - 1], world[k])
		local vx, vz = unit(world[k], world[k + 1])
		return half * math.tan(math.acos(math.clamp(ux * vx + uz * vz, -1, 1)) / 2) + 0.05
	end
	local list: { Segment } = {}
	for k = 1, #world - 1 do
		local p, q = world[k], world[k + 1]
		local dx, dz = unit(p, q)
		local e1, e2 = bend(k), bend(k + 1)
		table.insert(list, {
			X1 = p[1] - dx * e1,
			Z1 = p[2] - dz * e1,
			X2 = q[1] + dx * e2,
			Z2 = q[2] + dz * e2,
			Width = T.TRAIL_WIDTH,
			Top = T.TRAIL_TOP + (k % 2) * 0.04,
			Material = material,
		})
	end
	return list
end

-- 산책로 판정용 모양(모듈을 불러올 때 한 번 계산): 오솔길 조각·다리, 광장 원판
local ROUTE_SEGMENTS: { Segment } = {}
local ROUTE_DISCS: { Disc } = {}
local TRAILS: { Segment } = {}
local DISCS: { Disc } = {}
local PONDS: { Island.Pond } = {}
local GAP_PONDS: { [number]: Island.Pond } = {} -- 틈 번호 → 그 틈의 연못
for j, angle in GAP_ANGLES do
	local theme = T.GARDEN_THEMES[(j - 1) % #T.GARDEN_THEMES + 1]
	local route = THEME_ROUTES[theme] or { Material = T.WALKWAY_MATERIAL }
	local from, to = ringRadius(T.INNER_RING, angle), ringRadius(T.OUTER_RING, angle)
	local pieces = { { from, to } }
	local cut = route.Cut
	if cut then
		pieces = { { from, cut[1] }, { cut[2], to } }
	end
	-- 정원 좌우 뒤집기(gardens() 의 첫 난수와 같은 값): 굽이치는 쪽도 정원 장식과 같이 뒤집힘
	local m = Rng.new(T.SEED + 200 + j):Sign()
	for _, piece in pieces do
		for _, trail in trailPieces(angle, piece[1], piece[2], (route.Curve or 0) * m, route.Material) do
			table.insert(TRAILS, trail)
			table.insert(ROUTE_SEGMENTS, trail)
		end
	end
	local disc = route.Disc
	if disc then
		local x, z = polar(angle, disc.Rho)
		local entry: Disc = {
			X = x,
			Z = z,
			R = disc.R,
			Top = disc.Top or T.DISC_TOP,
			Material = disc.Material or route.Material,
		}
		table.insert(ROUTE_DISCS, entry)
		if disc.Build then
			table.insert(DISCS, entry)
		end
	end
	local bridge = route.Bridge
	if bridge then
		local x1, z1 = polar(angle, bridge.From)
		local x2, z2 = polar(angle, bridge.To)
		table.insert(
			ROUTE_SEGMENTS,
			{ X1 = x1, Z1 = z1, X2 = x2, Z2 = z2, Width = bridge.Width, Top = 0.6, Material = "WoodPlanks" }
		)
	end
	local pond = route.Pond
	if pond then
		local x, z = polar(angle, pond.Rho)
		local entry: Island.Pond = { X = x, Z = z, R = pond.R, Depth = pond.Depth, Seed = 40 + j * 1.7 }
		table.insert(PONDS, entry)
		GAP_PONDS[j] = entry
	end
end

-- 산책로(고리 둘, 정원 오솔길·다리, 광장 원판) 위이거나 너무 가까운지. margin 기본은 ROUTE_MARGIN
function Plan.onRoute(x: number, z: number, pad: number?, margin: number?): boolean
	local m = (pad or 0) + (margin or T.ROUTE_MARGIN)
	for i, ring in RINGS do
		if ringDistance(i, x, z) <= ring.Width / 2 + m then
			return true
		end
	end
	for _, segment in ROUTE_SEGMENTS do
		if segmentDistance(x, z, segment.X1, segment.Z1, segment.X2, segment.Z2) <= segment.Width / 2 + m then
			return true
		end
	end
	for _, disc in ROUTE_DISCS do
		local dx, dz = x - disc.X, z - disc.Z
		local reach = disc.R + m
		if reach > 0 and dx * dx + dz * dz <= reach * reach then
			return true
		end
	end
	return false
end

-- 풀밭 자리 검사: 광장·부지·간판·길(ParkLayout) + 산책로 + 풀밭 끝(모래 시작). 막히면 true 와 이유
function Plan.islandBlocked(x: number, z: number, pad: number?, routeMargin: number?): (boolean, string?)
	local p = pad or 0
	local hit, why = ParkLayout.blocked(x, z, p)
	if hit then
		return true, why
	end
	if Plan.onRoute(x, z, p, routeMargin) then
		return true, "route"
	end
	if math.sqrt(x * x + z * z) + p > Island.grassEdge(math.atan2(z, x)) - T.EDGE_MARGIN then
		return true, "edge"
	end
	return false, nil
end

-- 바깥 고리 너머, 틈 방향 시야 안인지(큰 나무 금지)
local function inCorridor(x: number, z: number, pad: number): boolean
	for _, angle in GAP_ANGLES do
		local dx, dz = math.cos(angle), math.sin(angle)
		local along = x * dx + z * dz
		local side = z * dx - x * dz
		if along > T.OUTER_RING.Radius and math.abs(side) <= T.CORRIDOR_HALF_WIDTH + pad then
			return true
		end
	end
	return false
end

-- 배치 ---------------------------------------------------------------------------

local function cellKey(cx: number, cz: number): number
	return (cx + 5000) * 10000 + (cz + 5000)
end

local function overlaps(ctx: Ctx, x: number, z: number, r: number, gap: number): boolean
	for _, other in ctx.Big do
		local limit = r + other.Radius + gap
		if (other.X - x) ^ 2 + (other.Z - z) ^ 2 < limit * limit then
			return true
		end
	end
	local reach = r + BIG + gap
	for cx = math.floor((x - reach) / CELL), math.floor((x + reach) / CELL) do
		for cz = math.floor((z - reach) / CELL), math.floor((z + reach) / CELL) do
			local list = ctx.Cells[cellKey(cx, cz)]
			if list then
				for _, other in list do
					local limit = r + other.Radius + gap
					if (other.X - x) ^ 2 + (other.Z - z) ^ 2 < limit * limit then
						return true
					end
				end
			end
		end
	end
	for _, capsule in ctx.Capsules do
		if segmentDistance(x, z, capsule.X1, capsule.Z1, capsule.X2, capsule.Z2) < r + capsule.R + gap then
			return true
		end
	end
	return false
end

-- 마른 모래 위인지: 가운데와 둘레 네 곳이 모두 물 위 + 풀밭 끝 바깥
local function onBeach(x: number, z: number, r: number): boolean
	local distance = math.sqrt(x * x + z * z)
	local angle = math.atan2(z, x)
	if distance - r < Island.grassEdge(angle) + 0.5 then
		return false
	end
	if distance + r > Island.coastRadius(angle) - 1.5 then
		return false
	end
	for k = 0, 3 do
		local a = k / 4 * TAU
		if not Island.isDry(x + math.cos(a) * r, z + math.sin(a) * r) then
			return false
		end
	end
	return true
end

local function fits(ctx: Ctx, spec: Spec, x: number, z: number): boolean
	local r = spec.Radius
	local region = spec.Region
	if region == "Island" then
		if spec.OnRoute then
			if ParkLayout.blocked(x, z, r) then
				return false
			end
		elseif Plan.islandBlocked(x, z, r, spec.RouteMargin) then
			return false
		end
	elseif region == "Beach" then
		if not onBeach(x, z, r) then
			return false
		end
	end
	if spec.Tall and inCorridor(x, z, r) then
		return false
	end
	for _, circle in ctx.Keep do
		local limit = r + circle.R
		if (circle.X - x) ^ 2 + (circle.Z - z) ^ 2 < limit * limit then
			return false
		end
	end
	if (spec.Layer or "Solid") == "Solid" then
		return not overlaps(ctx, x, z, r, T.SPACING)
	end
	return true
end

local function insert(ctx: Ctx, item: Item)
	table.insert(ctx.Items, item)
	if item.Layer == "Solid" then
		if item.Radius > BIG then
			table.insert(ctx.Big, item)
		else
			local key = cellKey(math.floor(item.X / CELL), math.floor(item.Z / CELL))
			local list = ctx.Cells[key]
			if not list then
				list = {}
				ctx.Cells[key] = list
			end
			table.insert(list, item)
		end
	end
end

-- 발밑 높이: 공원(평지)은 0, 그 밖은 발밑 원 안에서 가장 낮은 땅(비탈에서 뜨지 않게)
local function groundY(x: number, z: number, foot: number): number
	if x * x + z * z <= (Island.FLAT_RADIUS - foot) ^ 2 then
		return 0
	end
	return Island.lowestAround(x, z, foot)
end

-- spec 자리에 놓아 보고, 안 되면 jitter 안에서 tries 번 더 흔들어 봄. 끝내 안 되면 nil(quiet 가 아니면 Skipped 에 셈)
local function place(ctx: Ctx, rng: Rng, spec: Spec, tries: number?, jitter: number?, quiet: boolean?): Item?
	local x, z = spec.X, spec.Z
	local spread = jitter or spec.Radius
	for attempt = 0, tries or 0 do
		if attempt > 0 then
			x = spec.X + rng:NextNumber(-spread, spread)
			z = spec.Z + rng:NextNumber(-spread, spread)
		end
		if fits(ctx, spec, x, z) then
			local item: Item = {
				Kind = spec.Kind,
				Zone = spec.Zone,
				X = x,
				Y = spec.Y or groundY(x, z, spec.Foot or math.min(spec.Radius, 1.5)),
				Z = z,
				Radius = spec.Radius,
				Scale = spec.Scale or 1,
				Turn = spec.Turn or 0,
				Tint = spec.Tint or 0.5,
				Style = spec.Style or 1,
				Height = spec.Height or 0,
				Layer = spec.Layer or "Solid",
			}
			insert(ctx, item)
			if spec.Flat then
				table.insert(
					ctx.Paint,
					{ Kind = "Circle", X = x, Z = z, R = spec.Flat, Material = "LeafyGrass", Margin = 2 }
				)
			end
			return item
		end
	end
	if quiet then
		return nil
	end
	local key = spec.Zone .. "/" .. spec.Kind
	ctx.Skipped[key] = (ctx.Skipped[key] or 0) + 1
	if Plan.debugSkipped then
		table.insert(Plan.debugSkipped, spec)
	end
	return nil
end

-- 긴 장식(산울타리): (x1, z1) → (x2, z2), 굵기 반지름 r. 풀밭 검사는 양 끝과 가운데
local function placeHedge(ctx: Ctx, zone: string, x1: number, z1: number, x2: number, z2: number, style: number): Item?
	local r = 0.9
	local length = math.sqrt((x2 - x1) ^ 2 + (z2 - z1) ^ 2)
	local steps = math.max(2, math.ceil(length / 3))
	for s = 0, steps do
		local t = s / steps
		local x, z = x1 + (x2 - x1) * t, z1 + (z2 - z1) * t
		local blocked, why = Plan.islandBlocked(x, z, r, 0.5)
		if blocked or overlaps(ctx, x, z, r, 0.3) then
			ctx.Skipped[zone .. "/Hedge"] = (ctx.Skipped[zone .. "/Hedge"] or 0) + 1
			if Plan.debugSkipped then
				table.insert(Plan.debugSkipped, { Kind = "Hedge", X = x, Z = z, Why = why or "overlap" })
			end
			return nil
		end
	end
	local cx, cz = (x1 + x2) / 2, (z1 + z2) / 2
	local item: Item = {
		Kind = "Hedge",
		Zone = zone,
		X = cx,
		Y = groundY(cx, cz, length / 2),
		Z = cz,
		Radius = r,
		Scale = 1,
		Turn = math.atan2(z2 - z1, x2 - x1),
		Tint = 0.5,
		Style = style,
		Height = length,
		Layer = "Free",
	}
	insert(ctx, item)
	table.insert(ctx.Capsules, { X1 = x1, Z1 = z1, X2 = x2, Z2 = z2, R = r })
	return item
end

-- 장식 종류별 바닥 반지름(비켜 가기·간격)
local TREE_RADIUS = 2.4 -- 넓은잎나무(잎은 약 4 x Scale 까지 퍼져서 무리 지으면 살짝 겹침)
local PALM_RADIUS = 1.6
local BUSH_RADIUS = 2.2

local function treeSpec(
	zone: string,
	region: string,
	x: number,
	z: number,
	scale: number,
	style: number,
	rng: Rng
): Spec
	return {
		Kind = "Tree",
		Zone = zone,
		Region = region,
		X = x,
		Z = z,
		Radius = TREE_RADIUS * scale,
		Scale = scale,
		Turn = rng:NextNumber(0, TAU),
		Tint = rng:NextNumber(),
		Style = style,
		Tall = true,
		Foot = 1,
	}
end

local function palmSpec(zone: string, region: string, x: number, z: number, scale: number, rng: Rng): Spec
	return {
		Kind = "Palm",
		Zone = zone,
		Region = region,
		X = x,
		Z = z,
		Radius = PALM_RADIUS * scale,
		Scale = scale,
		-- 바다 쪽으로 기움
		Turn = math.atan2(z, x) + rng:NextNumber(-0.7, 0.7),
		Tint = rng:NextNumber(),
		Style = 1,
		Foot = 0.8,
	}
end

local function bushSpec(zone: string, x: number, z: number, scale: number, flowering: boolean, rng: Rng): Spec
	return {
		Kind = "Bush",
		Zone = zone,
		Region = "Island",
		X = x,
		Z = z,
		Radius = BUSH_RADIUS * scale,
		Scale = scale,
		Turn = rng:NextNumber(0, TAU),
		Tint = rng:NextNumber(),
		Style = if flowering then rng:NextInteger(2, 4) else 1, -- 2~4 = 꽃 색(분홍/하양/노랑)
	}
end

-- 심은 무더기 하나: (x, z) 에 작은 나무(treeStyle 이 nil 이면 나무 없이) + 둘레 덤불 둘(하나는 꽃 덤불)
-- + 광장 쪽 앞 들꽃 무더기. 흩뿌리지 않고 모아 심어서 넓은 잔디에 초점을 만듦. 자리가 없으면 조용히 건너뜀
local function cluster(ctx: Ctx, rng: Rng, zone: string, x: number, z: number, treeStyle: number?)
	local cx, cz, reach = x, z, 2
	if treeStyle then
		local spec = treeSpec(zone, "Island", x, z, rng:NextNumber(0.8, 0.95), treeStyle, rng)
		local center = place(ctx, rng, spec, 5, 3, true)
		if center then
			cx, cz, reach = center.X, center.Z, center.Radius
		end
	end
	local out = math.atan2(cz, cx) -- 광장에서 먼 쪽
	for k = 1, 2 do
		local scale = rng:NextNumber(0.75, 1)
		local a = out + (k - 1.5) * 2.2 + rng:NextNumber(-0.3, 0.3)
		local d = reach + BUSH_RADIUS * scale + 0.8
		place(ctx, rng, bushSpec(zone, cx + math.cos(a) * d, cz + math.sin(a) * d, scale, k == 1, rng), 3, 1, true)
	end
	local a = out + math.pi + rng:NextNumber(-0.5, 0.5)
	local d = reach + 2.6
	place(ctx, rng, {
		Kind = "FlowerBed",
		Zone = zone,
		Region = "Island",
		X = cx + math.cos(a) * d,
		Z = cz + math.sin(a) * d,
		Radius = 2.2,
		Turn = rng:NextNumber(0, TAU),
		Style = if rng:NextNumber() < 0.5 then 3 else 6,
		Flat = 2.2,
	}, 3, 1, true)
end

-- 안쪽 잔디(광장 ~ 부지 입구) ---------------------------------------------------------------

-- 후보 자리들을 차례로(각각 tries 번 흔들어) 놓아 봄. 모두 안 되면 첫 후보를 Skipped 에 셈
local function placeFirst(ctx: Ctx, rng: Rng, specs: { Spec }, tries: number, jitter: number): Item?
	for _, spec in specs do
		local item = place(ctx, rng, spec, tries, jitter, true)
		if item then
			return item
		end
	end
	local key = specs[1].Zone .. "/" .. specs[1].Kind
	ctx.Skipped[key] = (ctx.Skipped[key] or 0) + 1
	if Plan.debugSkipped then
		for _, spec in specs do
			table.insert(Plan.debugSkipped, spec)
		end
	end
	return nil
end

local LAWN_IN = ParkLayout.PLAZA_CLEAR + 1 -- 안쪽 잔디 시작(광장 둘레 나무 고리 바깥)

local function innerLawn(ctx: Ctx)
	local rng = Rng.new(T.SEED + 100)
	local inner = T.INNER_RING
	local half = inner.Width / 2
	local function spec(
		kind: string,
		rho: number,
		side: number,
		angle: number,
		radius: number,
		extra: { [string]: any }?
	): Spec
		local x, z = onAxis(angle, rho, side)
		local result: Spec = { Kind = kind, Zone = "Inner", Region = "Island", X = x, Z = z, Radius = radius }
		if extra then
			for key, value in extra do
				(result :: any)[key] = value
			end
		end
		return result
	end
	for j, angle in GAP_ANGLES do
		local ring = ringRadius(inner, angle)
		local inEdge, outEdge = ring - half, ring + half
		local room = inEdge - LAWN_IN -- 고리 안쪽(광장 쪽) 잔디 폭
		local s = if j % 2 == 0 then 1 else -1
		-- 벤치 + 정원등: 오솔길이 시작되는 곳. 안쪽이 넉넉하면 고리 안쪽에서 정원 쪽을, 아니면 바깥 오솔길 옆에서 광장 쪽을 봄
		local benchSpecs = {
			spec("Bench", inEdge - 4.4, 0, angle, 2.8, { Turn = angle, RouteMargin = 0.4 }),
			spec("Bench", outEdge + 4.4, s * 7.5, angle, 2.8, { Turn = angle + math.pi, RouteMargin = 0.4 }),
			spec("Bench", outEdge + 4.4, -s * 7.5, angle, 2.8, { Turn = angle + math.pi, RouteMargin = 0.4 }),
		}
		if room < 8 then
			benchSpecs = { benchSpecs[2], benchSpecs[3], benchSpecs[1] }
		end
		local benchItem = placeFirst(ctx, rng, benchSpecs, 3, 0.8)
		if benchItem then
			local rho = benchItem.X * math.cos(angle) + benchItem.Z * math.sin(angle)
			local side = benchItem.Z * math.cos(angle) - benchItem.X * math.sin(angle)
			placeFirst(ctx, rng, {
				spec("Lamp", rho, side + s * 4.2, angle, 0.6, { RouteMargin = 0.3 }),
				spec("Lamp", rho, side - s * 4.2, angle, 0.6, { RouteMargin = 0.3 }),
			}, 2, 0.6)
		end
		-- 꽃섬(꽃밭 + 뒤에 작은 꽃나무 + 덤불 둘): 고리 안쪽이 넓으면 안쪽, 아니면 바깥(오솔길 반대쪽 옆)
		local rho, side
		if room >= 13 then
			rho, side = LAWN_IN + room * 0.5, -s * 11
		else
			rho, side = outEdge + 7.5, -s * 11
		end
		local style = j % 6 + 1
		local bed = placeFirst(ctx, rng, {
			spec("FlowerBed", rho, side, angle, 3.3, { Turn = rng:NextNumber(0, TAU), Style = style, Flat = 3.3 }),
			spec(
				"FlowerBed",
				outEdge + 7.5,
				side,
				angle,
				3.3,
				{ Turn = rng:NextNumber(0, TAU), Style = style, Flat = 3.3 }
			),
		}, 4, 1.5)
		if bed then
			-- 무리: 꽃밭 뒤(광장에서 먼 쪽) 작은 꽃나무, 양옆 덤불
			local bx, bz = bed.X, bed.Z
			local out = math.atan2(bz, bx)
			local tx, tz =
				bx + math.cos(out) * 5.2 - math.sin(out) * s * 2, bz + math.sin(out) * 5.2 + math.cos(out) * s * 2
			place(
				ctx,
				rng,
				treeSpec("Inner", "Island", tx, tz, rng:NextNumber(0.72, 0.85), if j % 3 == 0 then 1 else 4, rng),
				4,
				1.2,
				true
			)
			for _, k in { -1, 1 } do
				local a = out + k * 1.9 + rng:NextNumber(-0.3, 0.3)
				local d = 3.3 + BUSH_RADIUS * 0.85 + 0.8
				place(
					ctx,
					rng,
					bushSpec(
						"Inner",
						bx + math.cos(a) * d,
						bz + math.sin(a) * d,
						rng:NextNumber(0.75, 0.95),
						k > 0,
						rng
					),
					3,
					1,
					true
				)
			end
		end
		-- 부지 입구 쪽 작은 꽃나무(틈마다 한쪽씩 번갈아)
		local ex, ez = onAxis(angle, 103 + rng:NextNumber(-1.5, 1.5), s * (12 + rng:NextNumber(-1, 1)))
		placeFirst(ctx, rng, { treeSpec("Inner", "Island", ex, ez, rng:NextNumber(0.75, 0.85), 4, rng) }, 6, 2.5)
	end
	for _, footprint in FOOTPRINTS do
		local a = footprint.Angle
		for _, s in { -1, 1 } do
			-- 길 양옆 줄: 광장 쪽 끝에 꽃 덤불 + 이어서 산울타리. 고리 안쪽(광장 ~ 고리)과 바깥(고리 ~ 부지 입구)
			-- 중 긴 쪽에. 옆으로 비킨 자리의 고리 반지름으로 잼(고리가 구불구불해서 길 가운데와 다름)
			local side = s * (ParkLayout.PATH_WIDTH / 2 + ParkLayout.PATH_MARGIN + 1)
			local ring = ringRadius(inner, a + math.atan2(side, ringRadius(inner, a)))
			local inEdge, outEdge = ring - half - 3.4, ring + half + 3.4
			local scale = rng:NextNumber(0.9, 1.05)
			local r = BUSH_RADIUS * scale
			local bushSide = s * (7.6 + r)
			local first, last
			if inEdge - LAWN_IN >= 103 - outEdge then
				first, last = LAWN_IN, inEdge
			else
				first, last = outEdge, 103
			end
			local x, z = onAxis(a, first + r + 1, bushSide)
			place(ctx, rng, bushSpec("Inner", x, z, scale, true, rng), 3, 0.5)
			local from = first + 2 * r + 4.5
			if last - from >= 7 then
				local x1, z1 = onAxis(a, from, side)
				local x2, z2 = onAxis(a, last, side)
				placeHedge(ctx, "Inner", x1, z1, x2, z2, if s > 0 then 3 else 1)
			end
		end
	end
	-- 넓은 잔디 양옆(부지 길 쪽) 심은 무더기(길 옆 덤불·산울타리를 놓은 뒤 남은 자리): 고리 바깥이 넓으면 바깥,
	-- 아니면 고리 안쪽. 한쪽만 작은 나무
	for j, angle in GAP_ANGLES do
		local ring = ringRadius(inner, angle)
		local inEdge, outEdge = ring - half, ring + half
		local s = if j % 2 == 0 then 1 else -1
		for _, side in { -1, 1 } do
			local rho = if 101 - outEdge >= 10 then (outEdge + 101) / 2 else (LAWN_IN + inEdge) / 2
			local x, z = onAxis(angle, rho, side * 21)
			cluster(ctx, rng, "Inner", x, z, if side == s then 1 else nil)
		end
	end
end

-- 틈 정원 --------------------------------------------------------------------

type Garden = {
	ctx: Ctx,
	rng: Rng,
	angle: number,
	m: number, -- 좌우 뒤집기(-1 / 1)
	pond: Island.Pond?, -- 이 틈의 지형 연못(연못 정원만)
}

-- 정원 좌표(rho = 광장 중심에서 틈 방향 거리, side = 옆, m 을 곱해서 뒤집힘)
local function at(g: Garden, rho: number, side: number): (number, number)
	return onAxis(g.angle, rho, side * g.m)
end

-- 정원 좌표에 장식 하나
local function put(g: Garden, kind: string, rho: number, side: number, radius: number, extra: { [string]: any }?): Item?
	local x, z = at(g, rho, side)
	local spec: Spec = {
		Kind = kind,
		Zone = "Gardens",
		Region = "Island",
		X = x,
		Z = z,
		Radius = radius,
		Turn = g.rng:NextNumber(0, TAU),
		Tint = g.rng:NextNumber(),
	}
	if extra then
		for key, value in extra do
			(spec :: any)[key] = value
		end
	end
	return place(g.ctx, g.rng, spec, 3, 1.5)
end

-- 넓은잎나무. style: 1 초록, 2 과일나무, 3 단풍(빨강), 4 꽃나무(분홍), 5 기둥 나무(가늘고 키 큼)
local function tree(g: Garden, rho: number, side: number, scale: number, style: number?): Item?
	local x, z = at(g, rho, side)
	local spec = treeSpec("Gardens", "Island", x, z, scale, style or 1, g.rng)
	return place(g.ctx, g.rng, spec, 3, 1.5)
end

-- (rho, side) 에 벤치를 두고 (tRho, tSide) 를 바라보게
local function bench(g: Garden, rho: number, side: number, tRho: number, tSide: number): Item?
	local x, z = at(g, rho, side)
	local tx, tz = at(g, tRho, tSide)
	return put(g, "Bench", rho, side, 2.8, { Turn = facing(x, z, tx, tz), RouteMargin = 0.6 })
end

local function lamp(g: Garden, rho: number, side: number): Item?
	return put(g, "Lamp", rho, side, 0.6, { RouteMargin = 0.3 })
end

local function bed(g: Garden, rho: number, side: number, radius: number, style: number): Item?
	return put(g, "FlowerBed", rho, side, radius, { Style = style, Flat = radius })
end

local function bush(g: Garden, rho: number, side: number, scale: number, flowering: boolean?): Item?
	local x, z = at(g, rho, side)
	return place(g.ctx, g.rng, bushSpec("Gardens", x, z, scale, flowering == true, g.rng), 3, 1.5)
end

local function rock(g: Garden, rho: number, side: number, scale: number): Item?
	return put(g, "Rock", rho, side, 1.8 * scale, { Scale = scale, Style = g.rng:NextInteger(1, 3) })
end

local function topiary(g: Garden, rho: number, side: number, style: number, scale: number?): Item?
	local s = scale or 1
	return put(g, "Topiary", rho, side, 1.3 * s, { Scale = s, Style = style, RouteMargin = 0.8 })
end

local function hedge(g: Garden, rho1: number, side1: number, rho2: number, side2: number)
	local x1, z1 = at(g, rho1, side1)
	local x2, z2 = at(g, rho2, side2)
	placeHedge(g.ctx, "Gardens", x1, z1, x2, z2, 2)
end

-- 검사 없이 그 자리에 바로 두는 장식(연못 꾸밈·다리처럼 자리가 정해진 것). 방향은 틈 방향
local function fixed(g: Garden, kind: string, rho: number, side: number, fields: { [string]: any })
	local x, z = at(g, rho, side)
	local item: Item = {
		Kind = kind,
		Zone = "Gardens",
		X = x,
		Y = 0,
		Z = z,
		Radius = 1,
		Scale = 1,
		Turn = g.angle,
		Tint = g.rng:NextNumber(),
		Style = 1,
		Height = 0,
		Layer = "Free",
	}
	for key, value in fields do
		(item :: any)[key] = value
	end
	insert(g.ctx, item)
end

local THEMES: { [string]: (Garden) -> () } = {}

-- 분수 광장: 오솔길이 둥근 돌 광장으로 이어지고 가운데 3단 분수. 대각선 벤치 넷, 옆 정원등 둘, 꽃밭, 토피어리
THEMES.Fountain = function(g)
	put(g, "Fountain", 170, 0, 5.6, { OnRoute = true, Y = T.DISC_TOP })
	for _, a in { 45, 135, 225, 315 } do
		local r = math.rad(a)
		local rho, side = 170 + math.cos(r) * 16.5, math.sin(r) * 16.5
		bench(g, rho, side, 170, 0)
	end
	lamp(g, 170, 14.6)
	lamp(g, 170, -14.6)
	bed(g, 192, 13, 3.2, 1)
	bed(g, 192, -13, 3.2, 3)
	bed(g, 150, 11, 2.8, 5)
	topiary(g, 150, 4.9, 1)
	topiary(g, 150, -4.9, 1)
	tree(g, 196, 30, 1.2, 1)
	tree(g, 186, -26, 1.1, 1)
	bush(g, 147, -12, 1, true)
end

-- 꽃 정원: 오솔길 입구 장미 아치, 크기·색이 다른 꽃밭 무리, 꽃 덤불, 분홍 꽃나무, 새 물통, 벤치
THEMES.Flowers = function(g)
	put(g, "Arch", 136, 0, 0.8, { Turn = g.angle, OnRoute = true, Layer = "Free", Y = T.TRAIL_TOP })
	bed(g, 146, 10.5, 2.8, 1)
	bed(g, 150, -8.6, 3.2, 2)
	bed(g, 162, 15, 3.6, 3)
	bed(g, 166, -12.5, 3.2, 5)
	bed(g, 178, 17, 3.8, 4)
	bed(g, 182, -13.5, 3.2, 6)
	bed(g, 196, 9, 3, 2)
	bed(g, 194, -24, 3.6, 1)
	bush(g, 170, 21, 1.1, true)
	bush(g, 153, 14.5, 0.9, true)
	put(g, "Birdbath", 170, -21, 1.3)
	tree(g, 192, 27, 1.15, 4)
	tree(g, 188, -29, 1.05, 4)
	bench(g, 184, 10.5, 184, 30)
	lamp(g, 158, -5.2)
end

-- 과수원: 과일나무 두 줄(엇갈려서) + 과일 상자 + 나무 그늘 벤치
THEMES.Orchard = function(g)
	tree(g, 146, 10, 0.95, 2)
	tree(g, 160, -14, 1, 2)
	tree(g, 168, 17, 1.05, 2)
	tree(g, 182, -22, 1.1, 2)
	tree(g, 190, 26, 1.1, 2)
	tree(g, 198, -34, 1.05, 2)
	tree(g, 200, 10, 1, 2)
	put(g, "Crate", 174, -8, 1.4, { Turn = g.angle + 0.4 })
	bench(g, 176, 7.5, 176, 20)
	bush(g, 152, -8, 0.9)
	lamp(g, 164, -3.5)
end

-- 연못: 지형 연못(물 윗면 = 땅) 위로 나무 다리, 둘레 돌·수련·부들, 연못을 보는 벤치, 징검돌
THEMES.Pond = function(g)
	local pond = g.pond :: Island.Pond
	fixed(g, "PondDeco", 170, 0, { Scale = pond.R, Height = pond.Seed })
	fixed(g, "Bridge", 170, 0, { Height = 34 })
	bench(g, 172, 20, 170, 0)
	put(g, "Stones", 157, 12, 3, { Turn = g.angle + g.m * 0.7, Flat = 3 })
	lamp(g, 186, 16)
	bush(g, 193, 21, 1.1)
	bush(g, 188, -20, 1)
	bush(g, 150, -9, 0.9, true)
	rock(g, 191, 10.5, 1)
	tree(g, 198, 30, 1.3, 1)
	tree(g, 192, -31, 1.1, 1)
end

-- 소풍 잔디: 격자무늬 돗자리 둘(바구니·접시), 그늘 나무 아래 소풍 탁자, 꽃밭
THEMES.Picnic = function(g)
	put(g, "Blanket", 165, 14, 3.4, { Turn = g.angle + 0.35, Style = 1, Flat = 3.4 })
	put(g, "Blanket", 182, -15, 3.4, { Turn = g.angle - 0.5, Style = 2, Flat = 3.4 })
	put(g, "PicnicTable", 190, 18, 3.4, { Turn = g.angle + math.pi / 2 })
	tree(g, 194, 30, 1.4, 1)
	tree(g, 152, -11, 0.95, 1)
	bed(g, 196, 8, 2.8, 5)
	bush(g, 176, -23, 1.1)
	bush(g, 146, 11.5, 0.9, true)
	lamp(g, 172, -5.2)
end

-- 바위 정원: 흰 자갈밭(지형 칠하기) 위 크고 작은 바위 무리, 석등, 단풍나무, 벤치
THEMES.Rockery = function(g)
	local gx, gz = at(g, 178, 16)
	table.insert(g.ctx.Paint, { Kind = "Blob", X = gx, Z = gz, R = 11, Material = "Salt", Margin = 0 })
	rock(g, 172, 13, 1.6)
	rock(g, 176, 18.5, 0.9)
	rock(g, 184, 12, 1.1)
	rock(g, 186, 22, 1.4)
	rock(g, 160, -9, 1.2)
	rock(g, 194, -18, 1)
	put(g, "Lantern", 164, 12, 0.9)
	put(g, "Lantern", 192, 7, 0.9)
	tree(g, 170, -18, 0.95, 3)
	tree(g, 198, 32, 1.1, 3)
	tree(g, 148, -9, 0.8, 3)
	bench(g, 184, -14, 184, 16)
	bush(g, 196, -30, 1)
end

-- 토피어리 길: 오솔길 양옆 낮은 산울타리 + 막대 사탕·두 공·세 단 토피어리 줄 + 벤치
THEMES.Topiary = function(g)
	for _, s in { -1, 1 } do
		hedge(g, 128, s * 5.4, 150, s * 5.4)
		hedge(g, 158, s * 5.4, 180, s * 5.4)
		hedge(g, 188, s * 5.4, 200, s * 5.4)
	end
	for k, rho in { 154, 184 } do
		for _, s in { -1, 1 } do
			topiary(g, rho, s * 5.6, if k == 1 then 3 else 2, 1.1)
		end
	end
	topiary(g, 168, 14, 1, 1.2)
	topiary(g, 168, -14, 1, 1.2)
	topiary(g, 194, 22, 3, 1.3)
	topiary(g, 194, -22, 3, 1.3)
	bench(g, 176, 14, 176, 30)
	bed(g, 180, -20, 3, 6)
	tree(g, 196, -31, 1.15, 5)
	lamp(g, 142, 8)
end

-- 정자: 오솔길이 지나가는 흰 팔각 정자(나무 마루 + 기둥 + 둥근 지붕), 둘레 꽃 덤불·정원등·나무
THEMES.Gazebo = function(g)
	put(g, "Gazebo", 176, 0, 1, { Layer = "Free", OnRoute = true, Y = 0, Turn = g.angle, Flat = 8 })
	bush(g, 176, 12, 1, true)
	bush(g, 176, -12, 1, true)
	bush(g, 190, 14, 0.9, true)
	bush(g, 162, -12, 0.9, true)
	lamp(g, 160, -5.2)
	lamp(g, 192, -5.2)
	bed(g, 150, 11, 2.8, 4)
	tree(g, 198, 28, 1.25, 4)
	tree(g, 196, -30, 1.2, 1)
	bench(g, 186, -22, 176, 0)
end

-- 정원 가장자리 심은 무더기: 주제 장식을 다 놓은 뒤, 틈 양옆(부지 울타리 쪽) 빈 잔디 네 곳에 무더기 하나씩
-- (넓은 잔디가 비어 보이지 않게). 나무 색은 정원 주제를 따르고, 꽃 정원은 나무 없이(꽃밭이 그늘에 가려지지 않게)
local PLANTING_TREE = { Orchard = 2, Rockery = 3, Flowers = 4, Gazebo = 4 }
local function plantings(g: Garden, theme: string)
	local rng = g.rng
	for _, rho in { 158, 190 } do
		for _, s in { -1, 1 } do
			local half = ParkLayout.gapHalfWidth(rho)
			local side = s * (half - ParkLayout.PLOT_MARGIN - 5.5)
			local x, z = onAxis(g.angle, rho + rng:NextNumber(-4, 4), side)
			local style = PLANTING_TREE[theme] or (if rng:NextNumber() < 0.3 then 4 else 1)
			cluster(g.ctx, rng, "Gardens", x, z, if theme == "Flowers" then nil else style)
		end
	end
end

local function gardens(ctx: Ctx)
	for j, angle in GAP_ANGLES do
		local rng = Rng.new(T.SEED + 200 + j)
		local theme = T.GARDEN_THEMES[(j - 1) % #T.GARDEN_THEMES + 1]
		local build = THEMES[theme]
		if build then
			local g = { ctx = ctx, rng = rng, angle = angle, m = rng:Sign(), pond = GAP_PONDS[j] }
			build(g)
			plantings(g, theme)
		end
	end
end

-- 숲띠 -------------------------------------------------------------------------

local function belt(ctx: Ctx)
	local rng = Rng.new(T.SEED + 300)
	local outer = T.OUTER_RING
	local ringOut = outer.Radius + outer.Width / 2

	-- 부지 뒤: 벤치 + 옆 정원등 + 양옆 산울타리(산책로 바깥 가장자리를 따라). 여덟 곳이 똑같지 않게 번갈아:
	--   홀수 부지 = 부지를 보는 벤치 + 바다 쪽 동전 망원경 + 민 산울타리
	--   짝수 부지 = 바다를 보는 벤치 + 옆 들꽃 무더기 + 꽃 핀 산울타리
	for i, footprint in FOOTPRINTS do
		local a = footprint.Angle
		local odd = i % 2 == 1
		local x, z = onAxis(a, ringOut + 3.3, 0)
		place(ctx, rng, {
			Kind = "Bench",
			Zone = "Belt",
			Region = "Island",
			X = x,
			Z = z,
			Radius = 2.8,
			Turn = if odd then a + math.pi else a,
			RouteMargin = 0.4,
		})
		x, z = onAxis(a, ringOut + 1.2, 4.2)
		place(
			ctx,
			rng,
			{ Kind = "Lamp", Zone = "Belt", Region = "Island", X = x, Z = z, Radius = 0.6, RouteMargin = 0.2 }
		)
		if odd then
			-- 벤치 옆 동전 망원경(바다 쪽을 봄)
			x, z = onAxis(a, ringOut + 2.2, -5.2)
			place(ctx, rng, {
				Kind = "Telescope",
				Zone = "Belt",
				Region = "Island",
				X = x,
				Z = z,
				Radius = 0.8,
				Turn = a,
				RouteMargin = 0.3,
			}, 2, 0.5)
		else
			x, z = onAxis(a, ringOut + 3, -5.6)
			place(ctx, rng, {
				Kind = "FlowerBed",
				Zone = "Belt",
				Region = "Island",
				X = x,
				Z = z,
				Radius = 1.6,
				Turn = rng:NextNumber(0, TAU),
				Style = if i % 4 == 0 then 3 else 6,
				Flat = 1.6,
				RouteMargin = 0.3,
			}, 2, 0.5)
		end
		-- 벤치 양옆 뒤 낮은 덤불 무더기(나무 없이: 부지에서 보는 바다 전망은 그대로)
		for _, s in { -1, 1 } do
			local cx, cz = onAxis(a, ringOut + 10 + rng:NextNumber(-1, 1), s * 15)
			cluster(ctx, rng, "Belt", cx, cz, nil)
		end
		for _, s in { -1, 1 } do
			local r = ringOut + 2
			local a1 = a + s * math.rad(2.4)
			local a2 = a + s * math.rad(8.5)
			local x1, z1 = polar(a1, r)
			local x2, z2 = polar(a2, r)
			placeHedge(ctx, "Belt", x1, z1, x2, z2, if odd then 1 else 3)
		end
	end

	-- 숲 무리: 부지마다 뒤쪽 양옆(부지 가운데 선과 틈 시야 사이)에 큰 무리 하나 + 작은 무리 하나.
	-- 무리 가운데에 큰 나무, 둘레에 작은 나무(모래 가까우면 야자수). 무리 사이는 빈터(잔디 언덕·바위)
	local B = T.BELT
	local trees, palms = 0, 0
	local placed: { Item } = {}
	local centers: { { number } } = {}
	local function grove(a: number, count: number, style: number)
		local grass = Island.grassEdge(a)
		local inner = ringOut + 7
		local d = rng:NextNumber(inner, math.max(inner, grass - 7))
		local cx, cz = polar(a, d)
		table.insert(centers, { cx, cz })
		local done = 0
		for attempt = 1, count * 8 do
			if done >= count then
				break
			end
			-- 첫 그루는 무리 가운데 가까이(크게), 나머지는 둘레(작게)
			local spread = if done == 0 then 3 else B.GroveRadius
			local ga, gr = rng:NextNumber(0, TAU), math.sqrt(rng:NextNumber()) * spread
			local x, z = cx + math.cos(ga) * gr, cz + math.sin(ga) * gr
			local edge = Island.grassEdge(math.atan2(z, x))
			local item: Item? = nil
			if edge - math.sqrt(x * x + z * z) < 11 and palms < B.Palms and rng:NextNumber() < 0.6 then
				local scale = rng:NextNumber(B.PalmScale[1], B.PalmScale[2])
				item = place(ctx, rng, palmSpec("Belt", "Island", x, z, scale, rng), 0, 0, true)
				if item then
					palms += 1
				end
			elseif trees < B.Trees then
				local scale = if done == 0
					then rng:NextNumber(1.3, B.TreeScale[2])
					else rng:NextNumber(B.TreeScale[1], 1.25)
				-- 초록 무리의 둘레 나무는 가끔 가늘고 키 큰 기둥 나무(한 가지 모양만 되풀이되지 않게)
				local kind = if style == 1 and done > 0 and rng:NextNumber() < B.SlimChance then 5 else style
				item = place(ctx, rng, treeSpec("Belt", "Island", x, z, scale, kind, rng), 0, 0, true)
				if item then
					trees += 1
					table.insert(placed, item)
				end
			end
			if item then
				done += 1
			end
		end
	end
	for i, footprint in FOOTPRINTS do
		local side = if i % 2 == 0 then 1 else -1
		local style = if rng:NextNumber() < B.BlossomGroves then 4 else 1
		grove(footprint.Angle + side * math.rad(rng:NextNumber(10, 16)), rng:NextInteger(5, 7), style)
		grove(footprint.Angle - side * math.rad(rng:NextNumber(11, 15)), rng:NextInteger(3, 4), 1)
	end

	-- 숲 가장자리 덤불(나무 옆, 가끔 꽃 덤불)
	for _, item in placed do
		if rng:NextNumber() < B.BushChance then
			local a = rng:NextNumber(0, TAU)
			local d = item.Radius + rng:NextNumber(2.5, 4.5)
			local scale = rng:NextNumber(0.9, 1.25)
			local spec =
				bushSpec("Belt", item.X + math.cos(a) * d, item.Z + math.sin(a) * d, scale, rng:NextNumber() < 0.3, rng)
			place(ctx, rng, spec, 3, 1.5, true)
		end
	end

	-- 빈터(무리 가운데에서 먼 곳)의 바위
	local rocks = 0
	for _ = 1, 300 do
		if rocks >= B.Rocks then
			break
		end
		local a = rng:NextNumber(0, TAU)
		local d = rng:NextNumber(ringOut + 4, Island.grassEdge(a) - 3)
		local x, z = polar(a, d)
		local open = true
		for _, c in centers do
			if (c[1] - x) ^ 2 + (c[2] - z) ^ 2 < 22 * 22 then
				open = false
				break
			end
		end
		if open then
			local scale = rng:NextNumber(0.9, 1.5)
			local item = place(ctx, rng, {
				Kind = "Rock",
				Zone = "Belt",
				Region = "Island",
				X = x,
				Z = z,
				Radius = 1.8 * scale,
				Scale = scale,
				Turn = rng:NextNumber(0, TAU),
				Tint = rng:NextNumber(),
				Style = rng:NextInteger(1, 3),
			}, 0, 0, true)
			if item then
				rocks += 1
			end
		end
	end

	-- 빈터 들꽃: 숲 무리 사이 트인 잔디(바다 전망은 그대로)에 낮은 들꽃 무더기. 한 곳에 둘씩 붙여서(흩뿌리지 않게)
	local meadows = 0
	for _ = 1, 400 do
		if meadows >= B.Meadows then
			break
		end
		local a = rng:NextNumber(0, TAU)
		local d = rng:NextNumber(ringOut + 5, Island.grassEdge(a) - 4)
		local x, z = polar(a, d)
		local open = true
		for _, c in centers do
			if (c[1] - x) ^ 2 + (c[2] - z) ^ 2 < 16 * 16 then
				open = false
				break
			end
		end
		if open then
			local first = place(ctx, rng, {
				Kind = "FlowerBed",
				Zone = "Belt",
				Region = "Island",
				X = x,
				Z = z,
				Radius = rng:NextNumber(2, 2.6),
				Turn = rng:NextNumber(0, TAU),
				Style = if rng:NextNumber() < 0.5 then 3 else 6,
				Flat = 2.6,
			}, 0, 0, true)
			if first then
				meadows += 1
				local b = rng:NextNumber(0, TAU)
				local gap = first.Radius + 2.4
				place(ctx, rng, {
					Kind = "FlowerBed",
					Zone = "Belt",
					Region = "Island",
					X = x + math.cos(b) * gap,
					Z = z + math.sin(b) * gap,
					Radius = 1.6,
					Turn = rng:NextNumber(0, TAU),
					Style = if first.Style == 3 then 6 else 3,
					Flat = 1.6,
				}, 3, 0.8, true)
			end
		end
	end
end

-- 모래 오솔길: 바깥 산책로 바깥 가장자리에서 모래사장(등대 쪽은 등대 받침)까지 지형을 모래로 칠한 굽이치는 길.
-- 파트가 없어서 언덕을 그대로 따라가고, 둘레 장식(숲 무리·덤불 띠)은 이 길을 비켜 감
local function footpaths(ctx: Ctx)
	local B = T.BEACH
	local ringOut = T.OUTER_RING.Radius + T.OUTER_RING.Width / 2
	local half = B.FootpathHalf
	for k, angle in B.Footpaths do
		local a = math.rad(angle)
		local to = Island.grassEdge(a) + 2.5
		if angle == Island.LIGHTHOUSE_ANGLE then
			to = Island.coastRadius(a) - 6 - 5 -- 등대 받침 가장자리
		end
		local from = ringOut - 1
		local steps = math.max(3, math.ceil((to - from) / 6))
		local wiggle = 3.5 * (if k % 2 == 0 then 1 else -1)
		local previous: { number }? = nil
		for step = 0, steps do
			local u = step / steps
			local x, z = onAxis(a, from + (to - from) * u, wiggle * math.sin(math.pi * 1.5 * u))
			if previous then
				local px, pz = previous[1], previous[2]
				table.insert(ctx.Paint, {
					Kind = "Segment",
					X1 = px,
					Z1 = pz,
					X2 = x,
					Z2 = z,
					Half = half,
					Material = "Sand",
					Margin = 0.5,
				})
				table.insert(ctx.Capsules, { X1 = px, Z1 = pz, X2 = x, Z2 = z, R = half + 0.5 })
			end
			previous = { x, z }
		end
	end
end

-- 풀밭 끝 덤불 띠: 모래사장 바로 안쪽 풀밭 가장자리를 따라 덤불(가끔 꽃 덤불·작은 나무) 무리.
-- 띠 밀도는 각도 물결이라 덤불이 모인 곳과 바다가 트인 곳이 번갈아 나옴
local function fringe(ctx: Ctx)
	local B = T.BELT
	local rng = Rng.new(T.SEED + 350)
	local circumference = TAU * 250
	local steps = math.floor(circumference / B.FringeStep)
	for k = 0, steps - 1 do
		local a = (k + rng:NextNumber(-0.3, 0.3)) / steps * TAU
		local density = 0.55 * math.sin(3 * a + 1.3) + 0.45 * math.sin(7 * a + 0.4)
		if density > B.FringeCut then
			local d = Island.grassEdge(a) - rng:NextNumber(3.5, 6.5)
			local x, z = polar(a, d)
			local roll = rng:NextNumber()
			if roll < 0.12 then
				place(ctx, rng, treeSpec("Belt", "Island", x, z, rng:NextNumber(0.8, 1.05), 1, rng), 2, 1.5, true)
			else
				local scale = rng:NextNumber(0.75, 1.25)
				place(ctx, rng, bushSpec("Belt", x, z, scale, roll > 0.8, rng), 2, 1.5, true)
			end
		end
	end
end

-- 모래사장·바다 --------------------------------------------------------------------

-- 부두 기준: 풀밭 끝에서 시작해 물가 너머 PierLength 까지. 반환: 방향, 시작 거리, 끝 거리
local function pierLine(): (number, number, number)
	local a = math.rad(Island.PIER_ANGLE)
	return a, Island.grassEdge(a) - 1, Island.coastRadius(a) + T.BEACH.PierLength
end
Plan.pierLine = pierLine

local function beach(ctx: Ctx)
	local B = T.BEACH
	local rng = Rng.new(T.SEED + 500)

	-- 물가 바위와 연못 자리는 비워 둠. 등대 받침(1 번) 말고는 지형 바위 위에 모난 바윗돌 덩어리
	for i, rock in Island.ROCKS do
		table.insert(ctx.Keep, { X = rock.X, Z = rock.Z, R = rock.R * 1.35 })
		if i > 1 then
			local top = rock.Base + rock.Height
			insert(ctx, {
				Kind = "ShoreRock",
				Zone = "Sea",
				X = rock.X,
				Y = top,
				Z = rock.Z,
				Radius = rock.R,
				Scale = rock.R,
				Turn = i * 2.3,
				Tint = 0.5,
				Style = 1,
				Height = top,
				Layer = "Free",
			})
		end
	end

	-- 등대: 곶의 큰 바위 위(물가보다 6 안쪽)
	local la = math.rad(Island.LIGHTHOUSE_ANGLE)
	local lx, lz = polar(la, Island.coastRadius(la) - 6)
	insert(ctx, {
		Kind = "Lighthouse",
		Zone = "Beach",
		X = lx,
		Y = Island.lowestAround(lx, lz, 3.5),
		Z = lz,
		Radius = 4.5,
		Scale = 1,
		Turn = la + math.pi,
		Tint = 0.5,
		Style = 1,
		Height = 0,
		Layer = "Solid",
	})

	-- 부두: 풀밭 끝 → 바다(T자 끝). 모래 위 부분은 다른 장식이 비켜 가게 막아 둠
	local pa, pierFrom, pierTo = pierLine()
	local px, pz = polar(pa, pierFrom)
	insert(ctx, {
		Kind = "Pier",
		Zone = "Beach",
		X = px,
		Y = B.DeckTop,
		Z = pz,
		Radius = B.PierWidth / 2,
		Scale = 1,
		Turn = pa,
		Tint = 0.5,
		Style = 1,
		Height = pierTo - pierFrom,
		Layer = "Free",
	})
	for d = pierFrom - 2, Island.coastRadius(pa) + 2, 3 do
		local kx, kz = polar(pa, d)
		table.insert(ctx.Keep, { X = kx, Z = kz, R = B.PierWidth / 2 + 2 })
	end
	local ex, ez = polar(pa, pierFrom + 6)
	table.insert(ctx.Paint, {
		Kind = "Segment",
		X1 = px,
		Z1 = pz,
		X2 = ex,
		Z2 = ez,
		Half = B.PierWidth / 2,
		Material = "LeafyGrass",
		Margin = 2,
	})
	-- 부두 끝에 매어 둔 작은 배(T자 끝 옆)
	local bx, bz = onAxis(pa, pierTo - B.PierHead.Depth / 2, B.PierHead.Width / 2 + 3.2)
	insert(ctx, {
		Kind = "Boat",
		Zone = "Sea",
		X = bx,
		Y = WATER,
		Z = bz,
		Radius = 3,
		Scale = 0.9,
		Turn = pa + math.pi,
		Tint = 0.2,
		Style = 2,
		Height = 0,
		Layer = "Free",
	})

	-- 구조대 망루: 수영 구역 옆 모래사장 가운데, 바다를 봄
	local ga = math.rad(B.LifeguardAngle)
	local gx, gz = polar(ga, (Island.grassEdge(ga) + Island.coastRadius(ga)) / 2)
	place(ctx, rng, {
		Kind = "Lifeguard",
		Zone = "Beach",
		Region = "Beach",
		X = gx,
		Z = gz,
		Radius = 2.4,
		Turn = ga,
		Foot = 1.8,
	}, 10, 3)

	-- 간식 가게(부두 옆, 풀밭 끝 가까이)
	local ka = math.rad(B.KioskAngle)
	local kx, kz = polar(ka, Island.grassEdge(ka) + 5)
	place(ctx, rng, {
		Kind = "Kiosk",
		Zone = "Beach",
		Region = "Beach",
		X = kx,
		Z = kz,
		Radius = 4.2,
		Turn = ka + math.pi, -- 계산대가 풀밭(섬 안쪽)을 봄
		Foot = 3,
	}, 8, 3)

	-- 파라솔 묶음(파라솔 + 선베드 둘 + 수건): 바다를 보고, 물가와 나란히
	for zi, zone in B.SetZones do
		local from, to = math.rad(zone.From), math.rad(zone.To)
		for k = 1, zone.Count do
			local a = from + (to - from) * (k - 0.5) / zone.Count + rng:NextNumber(-0.03, 0.03)
			local grass, coast = Island.grassEdge(a), Island.coastRadius(a)
			local d = grass + (coast - grass) * rng:NextNumber(0.35, 0.5)
			local x, z = polar(a, d)
			place(ctx, rng, {
				Kind = "BeachSet",
				Zone = "Beach",
				Region = "Beach",
				X = x,
				Z = z,
				Radius = 3.6,
				Turn = a + rng:NextNumber(-0.15, 0.15),
				Style = (zi * 3 + k) % 4 + 1,
				Tint = rng:NextNumber(),
				Foot = 2,
			}, 8, 3)
		end
		-- 모래성 하나
		local a = (from + to) / 2 + rng:NextNumber(-0.1, 0.1)
		local grass, coast = Island.grassEdge(a), Island.coastRadius(a)
		local x, z = polar(a, (grass + coast) / 2 + 2)
		place(ctx, rng, {
			Kind = "Sandcastle",
			Zone = "Beach",
			Region = "Beach",
			X = x,
			Z = z,
			Radius = 1.8,
			Turn = rng:NextNumber(0, TAU),
		}, 10, 5)
	end

	-- 서핑보드 거치대(풀밭 끝 가까운 모래, 보드 앞면이 섬 안쪽을 봄)
	for k, angle in B.Surfboards do
		local a = math.rad(angle)
		local x, z = polar(a, Island.grassEdge(a) + 4)
		place(ctx, rng, {
			Kind = "Surfboards",
			Zone = "Beach",
			Region = "Beach",
			X = x,
			Z = z,
			Radius = 3,
			Turn = a + math.pi + rng:NextNumber(-0.2, 0.2),
			Style = k,
			Foot = 2.5,
		}, 10, 4)
	end

	-- 모래사장 야자수: 섬 둘레에 무리(1~3 그루)를 고르지 않은 간격으로, 풀밭 끝 가까운 모래 위, 바다 쪽으로 기움
	local start = rng:NextNumber(0, TAU)
	for grove = 1, B.PalmGroves do
		local a = start + (grove - 0.5) / B.PalmGroves * TAU + rng:NextNumber(-0.3, 0.3)
		for _ = 1, rng:NextInteger(1, 3) do
			local pa2 = a + rng:NextNumber(-0.04, 0.04)
			local grass = Island.grassEdge(pa2)
			local x, z = polar(pa2, grass + rng:NextNumber(1.5, 6))
			local scale = rng:NextNumber(1.05, 1.45)
			place(ctx, rng, palmSpec("Beach", "Beach", x, z, scale, rng), 5, 2.5, true)
		end
	end

	-- 떠밀려 온 나무(물가 가까운 모래, 아무 방향)
	local placed = 0
	for _ = 1, 80 do
		if placed >= B.Driftwood then
			break
		end
		local a = rng:NextNumber(0, TAU)
		local grass, coast = Island.grassEdge(a), Island.coastRadius(a)
		local x, z = polar(a, grass + (coast - grass) * rng:NextNumber(0.55, 0.75))
		local scale = rng:NextNumber(0.8, 1.2)
		local item = place(ctx, rng, {
			Kind = "Driftwood",
			Zone = "Beach",
			Region = "Beach",
			X = x,
			Z = z,
			Radius = 2.8 * scale,
			Scale = scale,
			Turn = a + math.pi / 2 + rng:NextNumber(-0.6, 0.6),
			Foot = 2,
		}, 0, 0, true)
		if item then
			placed += 1
		end
	end

	-- 수영 구역 부표(빨강·하양 번갈아)
	local buoys = B.Buoys
	for k = 0, buoys.Count - 1 do
		local ba = math.rad(buoys.From + (buoys.To - buoys.From) * k / (buoys.Count - 1))
		local x, z = polar(ba, Island.coastRadius(ba) + buoys.Offset)
		insert(ctx, {
			Kind = "Buoy",
			Zone = "Sea",
			X = x,
			Y = WATER,
			Z = z,
			Radius = 0.6,
			Scale = 1,
			Turn = 0,
			Tint = 0.5,
			Style = k % 2 + 1,
			Height = 0,
			Layer = "Free",
		})
	end
end

local function sea(ctx: Ctx)
	local rng = Rng.new(T.SEED + 600)
	for _, boat in T.SEA.Boats do
		local a = math.rad(boat.Angle)
		local x, z = polar(a, Island.coastRadius(a) + boat.Offset)
		insert(ctx, {
			Kind = "Boat",
			Zone = "Sea",
			X = x,
			Y = WATER,
			Z = z,
			Radius = 4 * boat.Scale,
			Scale = boat.Scale,
			Turn = math.rad(boat.Heading),
			Tint = rng:NextNumber(),
			Style = rng:NextInteger(1, 3),
			Height = 0,
			Layer = "Free",
		})
	end
	-- 먼 작은 섬 위: 풀 언덕에 야자수 무리(크게, 바다 쪽으로 기움) + 큰 덤불 몇 개(언덕이 비어 보이지 않게)
	for _, islet in Island.islets() do
		local palms = if islet.R > 40 then 4 else 3
		local bushes = if islet.R > 40 then 5 else 3
		local size = islet.R / 24
		local spots: { { number } } = {}
		local function spot(spacing: number): (number?, number?)
			for _ = 1, 30 do
				local a = rng:NextNumber(0, TAU)
				local d = math.sqrt(rng:NextNumber()) * islet.R * 0.5
				local x, z = islet.HillX + math.cos(a) * d, islet.HillZ + math.sin(a) * d
				local _, material = Island.surface(x, z)
				local free = material == "Grass"
				for _, p in spots do
					if free and (p[1] - x) ^ 2 + (p[2] - z) ^ 2 < spacing * spacing then
						free = false
					end
				end
				if free then
					table.insert(spots, { x, z })
					return x, z
				end
			end
			return nil, nil
		end
		for _ = 1, palms do
			local x, z = spot(4 * size)
			if x and z then
				insert(ctx, {
					Kind = "Palm",
					Zone = "Sea",
					X = x,
					Y = Island.lowestAround(x, z, 1),
					Z = z,
					Radius = 1,
					Scale = size * rng:NextNumber(0.95, 1.25),
					-- 섬 가운데에서 바깥쪽으로 기움
					Turn = math.atan2(z - islet.Z, x - islet.X) + rng:NextNumber(-0.5, 0.5),
					Tint = rng:NextNumber(),
					Style = 2, -- 먼 야자수(파트 적게)
					Height = 0,
					Layer = "Free",
				})
			end
		end
		for _ = 1, bushes do
			local x, z = spot(3.5 * size)
			if x and z then
				insert(ctx, {
					Kind = "Bush",
					Zone = "Sea",
					X = x,
					Y = Island.lowestAround(x, z, 1.5),
					Z = z,
					Radius = 2,
					Scale = size * rng:NextNumber(0.9, 1.4),
					Turn = rng:NextNumber(0, TAU),
					Tint = rng:NextNumber(),
					Style = 1,
					Height = 0,
					Layer = "Free",
				})
			end
		end
	end
end

-- 보이지 않는 벽 -----------------------------------------------------------------------

-- 닫힌 꺾은선 줄이기: 앞 점에서 곧게 이어도 사이 점들이 tolerance 안에 들면 그 사이 점을 뺌(fixed 점은 남김)
local function simplifyLoop(points: { { number } }, fixed: { boolean }, tolerance: number): { { number } }
	local n = #points
	-- 남길 첫 점: fixed 점이 있으면 그 점부터(한 바퀴 돌아 제자리로)
	local first = 1
	for i = 1, n do
		if fixed[i] then
			first = i
			break
		end
	end
	local order: { number } = {}
	for k = 0, n do
		table.insert(order, (first - 1 + k) % n + 1)
	end
	local kept: { { number } } = { points[order[1]] }
	local anchor = 1
	local j = 2
	while j <= n do
		-- anchor → j+1 로 곧게 가도 되는지(사이 점이 모두 tolerance 안이고, j 가 fixed 가 아니면)
		local nextIndex = j + 1
		local ok = not fixed[order[j]] and nextIndex <= n + 1
		if ok then
			local a, b = points[order[anchor]], points[order[nextIndex]]
			for m = anchor + 1, nextIndex - 1 do
				local p = points[order[m]]
				if segmentDistance(p[1], p[2], a[1], a[2], b[1], b[2]) > tolerance then
					ok = false
					break
				end
			end
		end
		if not ok then
			table.insert(kept, points[order[j]])
			anchor = j
		end
		j += 1
	end
	return kept
end

-- 물가 + Offset 을 따라 도는 닫힌 꺾은선. 부두 자리는 부두 양옆·끝을 감싸고 돌아감(부두 끝까지 걸어갈 수 있고
-- 부두에서 뛰어내려도 벽 안). 반환: {{x, z}, ...}(각도가 커지는 순서)
function Plan.wallPath(): { { number } }
	local W, B = T.WALL, T.BEACH
	local pa, _, pierTo = pierLine()
	local ux, uz = math.cos(pa), math.sin(pa) -- 부두 방향
	local sx, sz = -uz, ux -- 옆(각도가 커지는 쪽)
	local half = B.PierWidth / 2 + W.PierGap
	local headHalf = B.PierHead.Width / 2 + W.PierGap
	local headFrom = pierTo - B.PierHead.Depth - W.PierGap
	local headTo = pierTo + W.PierGap
	local function local2(along: number, side: number): { number }
		return { ux * along + sx * side, uz * along + sz * side }
	end

	local points: { { number } } = {}
	local fixed: { boolean } = {} -- 줄이지 않을 점(부두 감싸기)
	local count = math.floor(360 / W.Step)
	local detoured = false
	for k = 0, count - 1 do
		local a = math.rad(k * W.Step)
		local d = Island.coastRadius(a) + W.Offset
		local x, z = polar(a, d)
		local side = x * sx + z * sz
		local along = x * ux + z * uz
		if along > 0 and math.abs(side) < headHalf + 2 then
			-- 부두 자리: 처음 만났을 때 한 번에 감싸는 길을 넣음(오른쪽 옆 → 끝 → 왼쪽 옆)
			if not detoured then
				detoured = true
				local wallAt = Island.coastRadius(pa) + W.Offset
				for _, p in
					{
						local2(wallAt, -headHalf - 2),
						local2(wallAt, -half),
						local2(headFrom, -half),
						local2(headFrom, -headHalf),
						local2(headTo, -headHalf),
						local2(headTo, headHalf),
						local2(headFrom, headHalf),
						local2(headFrom, half),
						local2(wallAt, half),
						local2(wallAt, headHalf + 2),
					}
				do
					table.insert(points, p)
					fixed[#points] = true
				end
			end
		else
			table.insert(points, { x, z })
		end
	end
	return simplifyLoop(points, fixed, W.Tolerance)
end

-- 지형 칠하기: 공원 파트(광장·부지·길) 밑 + 산책로 밑은 풀잎 없는 LeafyGrass
local function parkPaint(ctx: Ctx)
	local paint = ctx.Paint
	table.insert(paint, { Kind = "Circle", X = 0, Z = 0, R = 48, Material = "LeafyGrass" })
	for _, footprint in FOOTPRINTS do
		table.insert(paint, {
			Kind = "Box",
			X = footprint.CenterX,
			Z = footprint.CenterZ,
			DirX = footprint.DirX,
			DirZ = footprint.DirZ,
			HalfX = footprint.HalfWidth,
			HalfZ = footprint.HalfDepth,
			Material = "LeafyGrass",
		})
		local x1, z1 = polar(footprint.Angle, footprint.PathFrom)
		local x2, z2 = polar(footprint.Angle, footprint.PathTo)
		table.insert(paint, {
			Kind = "Segment",
			X1 = x1,
			Z1 = z1,
			X2 = x2,
			Z2 = z2,
			Half = ParkLayout.PATH_WIDTH / 2,
			Material = "LeafyGrass",
		})
	end
	for i, ring in RINGS do
		local points = RING_POINTS[i]
		for k, p in points do
			local q = points[k % #points + 1]
			table.insert(paint, {
				Kind = "Segment",
				X1 = p[1],
				Z1 = p[2],
				X2 = q[1],
				Z2 = q[2],
				Half = ring.Width / 2,
				Material = "LeafyGrass",
			})
		end
	end
	for _, segment in ROUTE_SEGMENTS do
		table.insert(paint, {
			Kind = "Segment",
			X1 = segment.X1,
			Z1 = segment.Z1,
			X2 = segment.X2,
			Z2 = segment.Z2,
			Half = segment.Width / 2,
			Material = "LeafyGrass",
		})
	end
	for _, disc in ROUTE_DISCS do
		table.insert(paint, { Kind = "Circle", X = disc.X, Z = disc.Z, R = disc.R, Material = "LeafyGrass" })
	end
	for _, pond in PONDS do
		table.insert(ctx.Keep, { X = pond.X, Z = pond.Z, R = pond.R * 1.2 })
	end
end

-- 계획 만들기 -------------------------------------------------------------------

-- 디버그: 표를 넣어 두면 못 놓은 장식 설명(Spec)을 모아 둠
Plan.debugSkipped = nil :: { any }?

function Plan.make(): Result
	local result: Result = {
		Items = {},
		Rings = {},
		Trails = {},
		Discs = {},
		Wall = { Points = Plan.wallPath(), Height = T.WALL.Height, Bottom = T.WALL.Bottom },
		Paint = {},
		Ponds = {},
		Skipped = {},
	}
	for i, ring in RINGS do
		local points = {}
		for _, p in RING_POINTS[i] do
			table.insert(points, table.clone(p))
		end
		table.insert(result.Rings, {
			Radius = ring.Radius,
			Width = ring.Width,
			Segments = ring.Segments,
			Top = T.RING_TOP,
			Material = ring.Material,
			Color = ring.Color,
			Points = points,
		})
	end
	for _, trail in TRAILS do
		table.insert(result.Trails, table.clone(trail))
	end
	for _, disc in DISCS do
		table.insert(result.Discs, table.clone(disc))
	end
	for _, pond in PONDS do
		table.insert(result.Ponds, table.clone(pond))
	end

	local ctx: Ctx = {
		Items = result.Items,
		Cells = {},
		Big = {},
		Keep = {},
		Capsules = {},
		Paint = result.Paint,
		Skipped = result.Skipped,
	}
	parkPaint(ctx)
	footpaths(ctx)
	-- 큰 것(물가 명물)부터 놓고, 작은 장식이 사이를 채움
	beach(ctx)
	sea(ctx)
	gardens(ctx)
	innerLawn(ctx)
	belt(ctx)
	fringe(ctx)
	return result
end

-- 종류별 개수(디버그·테스트용)
function Plan.countKinds(result: Result): { [string]: number }
	local counts = {}
	for _, item in result.Items do
		counts[item.Kind] = (counts[item.Kind] or 0) + 1
	end
	return counts
end

return Plan
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">Props</string>
            <string name="Source"><![CDATA[-- 풍경 장식 파트 만들기(Plan 의 Item 하나 → 파트 몇 개). 게임 전체와 같은 통통하고 밝은 만화풍이지만
-- Roblox 기본 재질 질감(LeafyGrass 잎, Wood/WoodPlanks 나무, Slate/Rock 바위, Fabric 천, Cobblestone 돌)을 씀.
-- 공·원기둥·상자·쐐기만(메시·데칼·에셋 Id 없음). 모두 Anchored.
-- 잎·꽃·작은 소품은 CanCollide/CanQuery/CanTouch 끔(카메라가 잎에 걸려 당겨지지 않음).
-- 줄기·바위·벤치·건물처럼 부딪혀도 되는 것만 solid(산책로 위에는 Plan 이 두지 않음).
-- 그림자: 나무·덤불·건물처럼 땅 위에 선 것만(SHADOW_KINDS). 그중에도 가장 긴 변이 1.2 보다 작은 조각은 끔.
-- 비탈(숲띠 언덕·모래사장) 위 장식은 Island.height 로 조각마다 발밑 높이를 다시 잼.

local Island = require(script.Parent.Island)
local Rng = require(script.Parent.Rng)

local Props = {}

-- 색 ------------------------------------------------------------------------
local rgb = Color3.fromRGB

local TRUNK = rgb(128, 86, 52)
local TRUNK_DARK = rgb(98, 66, 42)
-- 나무 잎(Style 별: 1 초록, 2 과일나무, 3 단풍, 4 꽃나무). 아래 → 위로 밝아짐
local CANOPY = {
	[1] = { rgb(52, 150, 66), rgb(80, 186, 78), rgb(138, 218, 98) },
	[2] = { rgb(58, 156, 70), rgb(92, 192, 80), rgb(146, 220, 104) },
	[3] = { rgb(206, 72, 52), rgb(236, 118, 56), rgb(250, 176, 74) },
	[4] = { rgb(234, 130, 172), rgb(255, 172, 204), rgb(255, 214, 230) },
	[5] = { rgb(38, 118, 70), rgb(58, 146, 78), rgb(104, 184, 92) }, -- 기둥 나무(짙은 청록빛 초록)
}
local FRUITS = { rgb(255, 150, 40), rgb(232, 62, 62), rgb(255, 204, 60) }
local PALM_TRUNK = rgb(186, 140, 92)
local PALM_RING = rgb(146, 104, 66)
local PALM_LEAF = rgb(58, 172, 82)
local PALM_LEAF_LIGHT = rgb(112, 204, 90)
local COCONUT = rgb(116, 80, 46)
local BUSH = { rgb(50, 142, 64), rgb(78, 180, 76), rgb(132, 214, 96) }
local HEDGE = rgb(62, 158, 70) -- 토피어리 잎
-- 산울타리 잎(짙음 → 밝음): 몸통은 1·2 사이, 윗면 잎 공은 셋을 섞음. Roblox 의 LeafyGrass 가 색을 어둡게 그려서 조금 밝게 잡음
local HEDGE_LUMPS = { rgb(70, 164, 72), rgb(86, 178, 78), rgb(106, 194, 88) }
local BLOSSOMS = { rgb(255, 128, 176), rgb(255, 250, 240), rgb(255, 214, 72), rgb(180, 130, 255) }
local SOIL = rgb(126, 88, 60)
local ROCK = rgb(160, 158, 156)
local ROCK_DARK = rgb(120, 122, 128)
local MOSS = rgb(98, 160, 72)
local STONE = rgb(214, 208, 196)
local MARBLE = rgb(244, 240, 232)
local WOOD = rgb(196, 138, 82) -- 따뜻한 나무(벤치·부두·가게)
local WOOD_LIGHT = rgb(226, 186, 136)
local WOOD_DARK = rgb(116, 78, 48)
local PAINT_WHITE = rgb(250, 248, 242)
local IRON = rgb(52, 56, 66)
local GARDEN_GREEN = rgb(46, 86, 66) -- 정원등 기둥(광장 가로등보다 짙은 초록·가늘게)
local LAMP_LIGHT = rgb(255, 232, 180)
local WATER = rgb(96, 200, 236)
local WATER_LIGHT = rgb(170, 232, 255)
local LILY = rgb(70, 176, 84)
local PINK = rgb(255, 140, 190)
local WHITE = rgb(255, 252, 245)
local CORAL = rgb(255, 94, 91)
local SUN = rgb(255, 197, 61)
local SKY = rgb(70, 170, 255)
local MINT = rgb(120, 220, 190)
local TEAL = rgb(64, 168, 160)
local SAND = rgb(236, 214, 160)
local RED = rgb(226, 64, 58)
local NAVY = rgb(40, 60, 110)

-- 꽃밭 색 짝(Style 1~6)
local FLOWER_PAIRS = {
	{ CORAL, SUN },
	{ PINK, WHITE },
	{ rgb(170, 120, 255), SUN },
	{ SKY, WHITE },
	{ SUN, CORAL },
	{ PINK, rgb(170, 120, 255) },
}
-- 파라솔·돗자리·배 색(Style)
local CANVAS = { CORAL, SKY, SUN, rgb(120, 200, 120) }

local UPRIGHT = CFrame.Angles(0, 0, math.rad(90)) -- 원기둥(X 축 기둥)을 세움
local ALONG_LOOK = CFrame.Angles(0, math.rad(90), 0) -- lookAt 뒤에 곱하면 원기둥이 앞(-Z) 방향
local UP = Vector3.new(0, 1, 0)

-- 파트 수 세기(구역별) --------------------------------------------------------------
local counts: { [string]: number } = {}
local zone = "Misc"
local castShadow = false -- 지금 만드는 장식이 그림자를 드리우는지(Props.build 가 종류별로 정함)

local SHADOW_KINDS = {
	Tree = true,
	Palm = true,
	Bush = true,
	Hedge = true,
	Topiary = true,
	Rock = true,
	ShoreRock = true,
	Bench = true,
	Lamp = true,
	Fountain = true,
	Gazebo = true,
	PicnicTable = true,
	Arch = true,
	Lantern = true,
	Birdbath = true,
	Lighthouse = true,
	Pier = true,
	Bridge = true,
	Kiosk = true,
	Lifeguard = true,
	BeachSet = true,
	Sandcastle = true,
	Boat = true,
	Crate = true,
	Telescope = true,
	Surfboards = true,
	Driftwood = true,
}

function Props.setZone(name: string)
	zone = name
end

function Props.counts(): { [string]: number }
	return counts
end

function Props.resetCounts()
	counts = {}
end

-- 파트 헬퍼 ----------------------------------------------------------------------

-- solid: 부딪힘(줄기·바위·벤치 등). 아니면 충돌·검색·터치 모두 끔
local function setup(
	part: BasePart,
	parent: Instance,
	name: string,
	color: Color3,
	material: Enum.Material,
	solid: boolean?
)
	part.Name = name
	part.Color = color
	part.Material = material
	part.Anchored = true
	part.CanCollide = solid == true
	part.CanTouch = false
	if not solid then
		part.CanQuery = false
	end
	local size = part.Size
	part.CastShadow = castShadow and math.max(size.X, size.Y, size.Z) >= 1.2
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	counts[zone] = (counts[zone] or 0) + 1
end

function Props.part(
	parent: Instance,
	name: string,
	shape: Enum.PartType,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material,
	solid: boolean?
): Part
	local part = Instance.new("Part")
	part.Shape = shape
	part.Size = size
	part.CFrame = cframe
	setup(part, parent, name, color, material, solid)
	return part
end
local part = Props.part

function Props.block(
	parent: Instance,
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material?,
	solid: boolean?
): Part
	return part(parent, name, Enum.PartType.Block, size, cframe, color, material or Enum.Material.SmoothPlastic, solid)
end
local block = Props.block

local function ball(
	parent: Instance,
	name: string,
	center: Vector3,
	diameter: number,
	color: Color3,
	material: Enum.Material?,
	solid: boolean?
): Part
	return part(
		parent,
		name,
		Enum.PartType.Ball,
		Vector3.new(diameter, diameter, diameter),
		CFrame.new(center),
		color,
		material or Enum.Material.SmoothPlastic,
		solid
	)
end

-- bottom(바닥 중앙)에서 위로 height 만큼 세운 원기둥
local function disc(
	parent: Instance,
	name: string,
	bottom: Vector3,
	height: number,
	diameter: number,
	color: Color3,
	material: Enum.Material?,
	solid: boolean?
): Part
	return part(
		parent,
		name,
		Enum.PartType.Cylinder,
		Vector3.new(height, diameter, diameter),
		CFrame.new(bottom + Vector3.new(0, height / 2, 0)) * UPRIGHT,
		color,
		material or Enum.Material.SmoothPlastic,
		solid
	)
end

-- a 에서 b 까지 이어지는 원기둥(지름 d). 완전히 수직인 막대는 disc 를 씀
local function rod(
	parent: Instance,
	name: string,
	a: Vector3,
	b: Vector3,
	d: number,
	color: Color3,
	material: Enum.Material,
	solid: boolean?
): Part
	local length = (b - a).Magnitude
	return part(
		parent,
		name,
		Enum.PartType.Cylinder,
		Vector3.new(length, d, d),
		CFrame.lookAt((a + b) / 2, b) * ALONG_LOOK,
		color,
		material,
		solid
	)
end

-- 쐐기: 높은 면이 +Z(뒤), 경사면이 -Z(앞) 쪽을 봄
local function wedge(
	parent: Instance,
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material?,
	solid: boolean?
): WedgePart
	local piece = Instance.new("WedgePart")
	piece.Size = size
	piece.CFrame = cframe
	setup(piece, parent, name, color, material or Enum.Material.SmoothPlastic, solid)
	return piece
end

Props.wedge = wedge

-- 수평 회전: (x, z) 를 turn 만큼(각도가 커지는 쪽으로) 돌림
local function spin(x: number, z: number, turn: number): (number, number)
	local c, s = math.cos(turn), math.sin(turn)
	return x * c - z * s, x * s + z * c
end

-- 바닥 중앙 base 에서 turn 방향(앞 = LookVector = -Z)을 보는 CFrame
local function heading(base: Vector3, turn: number): CFrame
	return CFrame.lookAt(base, base + Vector3.new(math.cos(turn), 0, math.sin(turn)))
end

local function basePoint(item): Vector3
	return Vector3.new(item.X, item.Y, item.Z)
end

-- 장식마다 고정된 난수(자리로 시드를 정해서 미리보기와 게임이 같음)
local function itemRng(item, salt: number): Rng.Rng
	return Rng.new(math.floor(item.X * 37 + 0.5) * 7919 + math.floor(item.Z * 53 + 0.5) + salt)
end

-- 그 자리 땅 높이(지형): 발밑이 비탈인 조각(선베드·부두 기둥)용
local function groundAt(x: number, z: number): number
	return Island.height(x, z)
end

-- 비탈 위에 눕힌 납작한 물건(수건)의 자리: cf 의 가운데·방향을 쓰고, 네 귀퉁이(반폭 halfX, 반길이 halfZ)
-- 땅 높이로 기울기를 맞춤. 반환 CFrame 의 원점 = 땅 위 가운데, UpVector = 땅의 위쪽
local function onGround(cf: CFrame, halfX: number, halfZ: number): CFrame
	local function at(x: number, z: number): Vector3
		local p = cf * Vector3.new(x, 0, z)
		return Vector3.new(p.X, groundAt(p.X, p.Z), p.Z)
	end
	local a, b = at(-halfX, -halfZ), at(halfX, halfZ)
	local c, d = at(halfX, -halfZ), at(-halfX, halfZ)
	local center = (a + b + c + d) / 4
	local up = (b - a):Cross(c - d).Unit
	if up.Y < 0 then
		up = -up
	end
	local forward = (a + c) / 2 - (b + d) / 2 -- 로컬 -Z 쪽(앞)
	return CFrame.lookAt(center, center + forward, up)
end

local MAT = Enum.Material
local LEAVES = MAT.LeafyGrass

-- 모양별 만들기 --------------------------------------------------------------------
local BUILD = {}

-- 넓은잎나무: 살짝 기운 두 마디 줄기(마디는 둥근 옹이로 감춤) + 가지 1~2 + 잎 공 5~7(아래는 짙게, 위는 밝게).
-- Style = 잎 색(CANOPY). 과일나무(2)는 잎 둘레에 열매, 크기는 Scale(0.75~1.45)
-- item.Face(라디안, 없어도 됨) = 주로 보는 쪽(광장 나무 → 광장 가운데): 둘레 잎 공 중 가장 높은(밝은) 공과
-- 위 밝은 공을 그쪽으로 돌림(없으면 둘레는 난수 방향, 위 공은 해 쪽)
-- 기둥 나무(Style 5): 짧은 줄기 + 위로 갈수록 작아지는 잎 공 넷을 쌓고(살짝 비뚤게) 아래쪽 옆에 작은 공 둘.
-- 넓은잎나무보다 가늘고 키가 커서 숲 무리의 윤곽이 들쭉날쭉해짐
local function slimTree(parent: Instance, item)
	local s, base = item.Scale, basePoint(item)
	local rng = itemRng(item, 13)
	local colors = CANOPY[5]
	local lean = Vector3.new(math.cos(item.Turn), 0, math.sin(item.Turn)) * 0.05
	rod(
		parent,
		"TreeTrunk",
		base - Vector3.new(0, 0.6, 0),
		base + Vector3.new(0, 3 * s, 0),
		1 * s,
		TRUNK,
		MAT.Wood,
		true
	)
	local y = 3.6
	for k, d in { 3.9, 3.5, 2.9, 2.1 } do
		local jitter = Vector3.new(rng:NextNumber(-0.25, 0.25), 0, rng:NextNumber(-0.25, 0.25)) * s
		local center = base + Vector3.new(0, y * s, 0) + lean * (y * s) + jitter
		ball(parent, "TreeLeaves", center, d * s, colors[1]:Lerp(colors[3], (k - 1) / 4), LEAVES)
		y += d * 0.62
	end
	local start = rng:NextNumber(0, math.pi * 2)
	for k = 1, 2 do
		local a = start + k * math.pi + rng:NextNumber(-0.4, 0.4)
		local offset = Vector3.new(math.cos(a) * 1.3, 4.6 + k * 0.8, math.sin(a) * 1.3) * s
		ball(parent, "TreeLeaves", base + offset, 2.3 * s, colors[2], LEAVES)
	end
end

function BUILD.Tree(parent: Instance, item)
	if item.Style == 5 then
		slimTree(parent, item)
		return
	end
	local s, base = item.Scale, basePoint(item)
	local rng = itemRng(item, 1)
	local colors = CANOPY[item.Style] or CANOPY[1]
	local lean = Vector3.new(math.cos(item.Turn), 0, math.sin(item.Turn)) * (0.06 + 0.1 * item.Tint)
	local knee = base + Vector3.new(0, 3 * s, 0) + lean * (3 * s)
	local top = knee + Vector3.new(0, 2.6 * s, 0) + lean * (4 * s)
	rod(parent, "TreeTrunk", base - Vector3.new(0, 0.6, 0), knee, 1.5 * s, TRUNK, MAT.Wood, true)
	rod(parent, "TreeTrunk", knee, top, 1.1 * s, TRUNK, MAT.Wood, true)
	-- 두 마디가 만나는 곳: 아래 줄기와 같은 굵기의 공 = 둥근 어깨(굵은 줄기의 납작한 끝이 턱처럼 보이지 않게,
	-- 꺾인 틈도 덮음). 더 굵으면 볼록한 혹처럼 보임
	ball(parent, "TreeTrunk", knee, 1.5 * s, TRUNK, MAT.Wood)
	-- 가지: 줄기 위쪽에서 기운 반대쪽으로 비스듬히(끝은 잎 공 속)
	local branches = if item.Scale > 1.2 then 2 else 1
	for k = 1, branches do
		local a = item.Turn + math.pi + (k - 1.5) * 1.6 + rng:NextNumber(-0.3, 0.3)
		local from = knee + (top - knee) * 0.35
		local to = from + Vector3.new(math.cos(a) * 2 * s, 1.6 * s, math.sin(a) * 2 * s)
		rod(parent, "TreeBranch", from, to, 0.5 * s, TRUNK_DARK, MAT.Wood)
	end
	-- 잎: 가운데 큰 공 + 둘레 공(3~5) + 위 밝은 공(1~2)
	local center = top + Vector3.new(0, 1.3 * s, 0)
	ball(parent, "TreeLeaves", center, 6 * s, colors[2], LEAVES)
	local ring = if item.Scale < 0.9 then 3 elseif item.Scale < 1.25 then 4 else 4 + rng:NextInteger(0, 1)
	local start = rng:NextNumber(0, math.pi * 2)
	local around = {}
	for k = 1, ring do
		local a = start + (k - 1) / ring * math.pi * 2 + rng:NextNumber(-0.3, 0.3)
		local out = 2.3 * s * rng:NextNumber(0.9, 1.1)
		local lift = rng:NextNumber(-0.9, 0.4) * s
		around[k] = { a, out, lift, rng:NextNumber(3.6, 4.5) * s }
	end
	local turn = 0
	if item.Face then
		local highest = around[1]
		for _, leaf in around do
			if leaf[3] > highest[3] then
				highest = leaf
			end
		end
		turn = item.Face - highest[1]
	end
	for _, leaf in around do
		local a, out, lift = leaf[1] + turn, leaf[2], leaf[3]
		local offset = Vector3.new(math.cos(a) * out, lift, math.sin(a) * out)
		local color = if lift < -0.3 * s then colors[1] else colors[1]:Lerp(colors[2], 0.6)
		ball(parent, "TreeLeaves", center + offset, leaf[4], color, LEAVES)
	end
	-- 위 밝은 공: 해 쪽(+X, +Z 조금), Face 가 있으면 그쪽으로 치우침
	local tops = if item.Scale > 1.3 then 2 else 1
	for k = 1, tops do
		local a = (item.Face or 0.6) + (k - 1) * 2.4 + rng:NextNumber(-0.4, 0.4)
		local offset = Vector3.new(math.cos(a) * 1.1 * s, 2.1 * s, math.sin(a) * 1.1 * s)
		ball(parent, "TreeLeaves", center + offset, rng:NextNumber(3.2, 3.8) * s, colors[3], LEAVES)
	end
	if item.Style == 2 then
		-- 열매: 잎 겉(위쪽 반구)에 작은 공
		for k = 1, 4 do
			local a = start + k * 1.57 + rng:NextNumber(-0.3, 0.3)
			local up = rng:NextNumber(-0.2, 0.6)
			local dir = Vector3.new(math.cos(a), up, math.sin(a)).Unit
			ball(parent, "Fruit", center + dir * 3.1 * s, 0.75 * s, FRUITS[k % #FRUITS + 1])
		end
	end
end

-- 야자수: 휘어 올라가는 줄기(가늘어지는 원기둥 5마디, 마디 색 살짝 다르게) + 늘어진 잎 6장(잎마다 세 마디:
-- 솟는 잎자루 → 둥글게 휘는 가운데 → 늘어지며 뾰족한 쐐기 끝) + 잎 뭉치 + 코코넛 둘.
-- Turn = 기우는 쪽. Style 2 = 먼 섬용(파트 적게)
function BUILD.Palm(parent: Instance, item)
	local s, base = item.Scale, basePoint(item)
	local rng = itemRng(item, 2)
	local far = item.Style == 2
	local lean = Vector3.new(math.cos(item.Turn), 0, math.sin(item.Turn))
	local height = 9 * s * (0.9 + 0.2 * item.Tint)
	local bend = 3 * s * (0.7 + 0.6 * rng:NextNumber())
	local function trunkAt(t: number): Vector3
		return base + Vector3.new(0, height * t - 0.5, 0) + lean * (bend * t * t)
	end
	local segments = if far then 2 else 5
	for k = 0, segments - 1 do
		local a, b = trunkAt(k / segments), trunkAt((k + 1) / segments)
		local dir = (b - a).Unit
		local d = s * (1.25 - 0.4 * k / (segments - 1))
		-- 마디끼리 조금씩 겹쳐서(아래 마디가 조금 굵음) 이음매가 줄기 마디 고리로 보임. 색은 마디마다 살짝만 다르게
		rod(
			parent,
			"PalmTrunk",
			a - dir * 0.15 * s,
			b + dir * 0.2 * s,
			d,
			PALM_TRUNK:Lerp(PALM_RING, if k % 2 == 0 then 0.1 else 0.3),
			MAT.Wood,
			true
		)
	end
	local crown = trunkAt(1) + Vector3.new(0, 0.2 * s, 0)
	ball(parent, "PalmCrown", crown, 1.5 * s, PALM_LEAF:Lerp(COCONUT, 0.3), LEAVES)
	if not far then
		for k = 1, 2 do
			local a = item.Turn + k * 3.1
			ball(
				parent,
				"Coconut",
				crown + Vector3.new(math.cos(a) * 0.6 * s, -0.55 * s, math.sin(a) * 0.6 * s),
				0.72 * s,
				COCONUT
			)
		end
	end
	local fronds = if far then 7 else 6
	local start = rng:NextNumber(0, math.pi * 2)
	for k = 1, fronds do
		local a = start + (k - 1) / fronds * math.pi * 2 + rng:NextNumber(-0.18, 0.18)
		local length = s * rng:NextNumber(0.85, 1.1)
		local lift = rng:NextNumber(-0.12, 0.1) -- 잎마다 솟는 정도를 조금씩 다르게
		local color = if k % 2 == 0 then PALM_LEAF else PALM_LEAF:Lerp(PALM_LEAF_LIGHT, 0.5)
		local out = Vector3.new(math.cos(a), 0, math.sin(a))
		local p1 = crown + out * 0.3 * s
		local function piece(from: Vector3, to: Vector3): CFrame
			return CFrame.lookAt((from + to) / 2, to, UP)
		end
		if far then
			-- 두 마디(솟는 넓은 잎 → 늘어지는 뾰족한 끝): 멀리 옆에서 봐도 잎이 보이게(납작하게 누우면 막대만 보임)
			local p2 = p1 + (out * 0.85 + Vector3.new(0, 0.42 + lift, 0)).Unit * 3 * length
			local p3 = p2 + (out * 0.7 + Vector3.new(0, -0.72, 0)).Unit * 3.2 * length
			block(
				parent,
				"PalmLeaf",
				Vector3.new(1.9 * s, 0.2 * s, (p2 - p1).Magnitude + 0.3 * s),
				piece(p1, p2),
				color,
				LEAVES
			)
			wedge(
				parent,
				"PalmLeafTip",
				Vector3.new(0.2 * s, 1.9 * s, (p3 - p2).Magnitude + 0.3 * s),
				piece(p2, p3) * CFrame.Angles(0, 0, math.rad(90)),
				color:Lerp(PALM_LEAF_LIGHT, 0.3),
				LEAVES
			)
			continue
		end
		-- 세 마디(솟는 잎자루 → 둥글게 휘는 가운데 → 늘어지며 뾰족해지는 끝): 마디마다 조금씩 겹쳐 이음매를 덮음
		local p2 = p1 + (out * 0.88 + Vector3.new(0, 0.5 + lift, 0)).Unit * 2.2 * length
		local p3 = p2 + (out + Vector3.new(0, 0.02 + lift, 0)).Unit * 2.5 * length
		local p4 = p3 + (out * 0.66 + Vector3.new(0, -0.75, 0)).Unit * 2.6 * length
		block(
			parent,
			"PalmLeaf",
			Vector3.new(0.9 * s, 0.14 * s, (p2 - p1).Magnitude + 0.3 * s),
			piece(p1, p2),
			color:Lerp(COCONUT, 0.15),
			LEAVES
		)
		block(
			parent,
			"PalmLeaf",
			Vector3.new(1.7 * s, 0.14 * s, (p3 - p2).Magnitude + 0.35 * s),
			piece(p2, p3),
			color,
			LEAVES
		)
		-- 끝: 쐐기를 잎 면에 눕힘(넓은 쪽이 이음매, 뾰족한 쪽이 끝)
		wedge(
			parent,
			"PalmLeafTip",
			Vector3.new(0.14 * s, 1.7 * s, (p4 - p3).Magnitude + 0.25 * s),
			piece(p3, p4) * CFrame.Angles(0, 0, math.rad(90)),
			color:Lerp(PALM_LEAF_LIGHT, 0.3),
			LEAVES
		)
	end
end

-- 잎 공(가운데 center, 지름 size) 겉에 반쯤 박힌 작은 꽃 count 송이(윗쪽 반구에 고루, 두 색 번갈아)
local function blossoms(
	parent: Instance,
	center: Vector3,
	size: number,
	count: number,
	flower: number,
	colors: { Color3 },
	rng: Rng.Rng
)
	local start = rng:NextNumber(0, math.pi * 2)
	for k = 1, count do
		local a = start + k / count * math.pi * 2 + rng:NextNumber(-0.35, 0.35)
		local up = rng:NextNumber(0.35, 0.95)
		local dir = Vector3.new(math.cos(a) * math.sqrt(1 - up * up), up, math.sin(a) * math.sqrt(1 - up * up))
		local d = flower * rng:NextNumber(0.85, 1.1)
		ball(parent, "Flower", center + dir * (size / 2 - d * 0.2), d, colors[k % #colors + 1])
	end
end

-- 덤불: 공 4개 뭉치(짙은 초록 → 밝은 초록). Style 2~4 = 꽃 덤불(겉에 작은 꽃 세 송이: 분홍/하양/노랑)
function BUILD.Bush(parent: Instance, item)
	local s, base = item.Scale, basePoint(item)
	local rng = itemRng(item, 3)
	local t = item.Turn
	local pieces = {
		{ 0, 0, 1.05, 3.1, BUSH[2] },
		{ 1.1, 0.6, 0.8, 2.3, BUSH[1] },
		{ -1.0, 0.9, 0.75, 2.2, BUSH[1]:Lerp(BUSH[2], 0.5) },
		{ 0.3, -0.4, 1.9, 1.9, BUSH[3] },
	}
	for _, p in pieces do
		local ox, oz = spin(p[1], p[2], t)
		ball(parent, "Bush", base + Vector3.new(ox * s, p[3] * s, oz * s), p[4] * s, p[5], LEAVES)
	end
	-- 꽃 덤불(Style 2~4): 가운데 큰 공 겉에 작은 꽃 세 송이(분홍/하양/노랑)
	if item.Style >= 2 then
		local color = BLOSSOMS[(item.Style - 2) % #BLOSSOMS + 1]
		local center = base + Vector3.new(0, 1.05 * s, 0)
		blossoms(parent, center, 3.1 * s, 3, 0.6 * s, { color, color:Lerp(WHITE, 0.35) }, rng)
	end
end

-- 산울타리(다듬은 생울타리): 길이 Height·폭 1.62 네모 잎 몸통(부딪힘, 땅에서 키 1.4) + 윗면을 따라 1.85 스터드
-- 이하 간격으로 얹은 잎 공(가운데가 몸통 윗면 높이 → 반구 줄이 몸통보다 살짝 넓게 부풀어 둥글고 조금 울퉁불퉁한 윗면.
-- 초록 세 가지, 크기·높이·옆 위치를 조금씩 흔듦). 양 끝 공은 끝면에 맞춰서 윗모서리가 둥긂.
-- 공 지름 <= 1.74 · 옆 흔들림 <= 0.03 이라 폭은 Plan 의 반지름 0.9 안, 꼭대기는 땅에서 2.1~2.3. Turn = 길이 방향.
-- 가로로 누운 원기둥(높은 데서 보면 통나무처럼 보임)은 쓰지 않음.
-- Style 2 = 조금 짙은 초록, 3 = 꽃 핀 산울타리(잎 공 옆·위에 작은 꽃이 드문드문, 색은 Tint. 꽃도 폭 1.8 안)
local HEDGE_WIDTH = 1.62
local HEDGE_BODY = 1.6 -- 몸통 키(땅속 0.2 포함) → 윗면이 땅에서 1.4
local HEDGE_LUMP_STEP = 1.85 -- 잎 공 사이 간격 상한
function BUILD.Hedge(parent: Instance, item)
	local length = item.Height
	local cf = CFrame.new(basePoint(item)) * CFrame.Angles(0, -item.Turn, 0)
	local rng = itemRng(item, 12)
	local dark = if item.Style == 2 then 0.25 else 0
	local top = HEDGE_BODY - 0.2
	block(
		parent,
		"Hedge",
		Vector3.new(length, HEDGE_BODY, HEDGE_WIDTH),
		cf * CFrame.new(0, top - HEDGE_BODY / 2, 0),
		HEDGE_LUMPS[1]:Lerp(HEDGE_LUMPS[2], 0.4):Lerp(BUSH[1], dark),
		LEAVES,
		true
	)
	-- 잎 공: 양 끝 공은 끝면에 맞추고 사이는 고르게(간격 <= HEDGE_LUMP_STEP) + 조금씩 흔듦
	local first = rng:NextNumber(1.64, 1.74)
	local lumps = math.max(2, math.ceil((length - first) / HEDGE_LUMP_STEP) + 1)
	local from, to = -length / 2 + first / 2, length / 2 - first / 2
	local centers: { Vector3 } = {}
	local sizes: { number } = {}
	local shade = rng:NextInteger(1, 3)
	for k = 1, lumps do
		local d = if k == 1 or k == lumps then first else rng:NextNumber(1.48, 1.74)
		local along = from + (to - from) * (k - 1) / (lumps - 1)
		if k > 1 and k < lumps then
			along += rng:NextNumber(-0.2, 0.2)
		end
		local center = Vector3.new(along, top - 0.08 + rng:NextNumber(-0.1, 0.08), rng:NextNumber(-0.03, 0.03))
		shade = (shade + rng:NextInteger(0, 1)) % 3 + 1 -- 옆 공과 같은 색이 길게 이어지지 않게
		local color = HEDGE_LUMPS[shade]:Lerp(HEDGE_LUMPS[2], rng:NextNumber(0, 0.3))
		ball(parent, "HedgeTop", cf * center, d, color:Lerp(BUSH[1], dark), LEAVES)
		centers[k], sizes[k] = center, d
	end
	if item.Style == 3 then
		local color = BLOSSOMS[math.floor(item.Tint * #BLOSSOMS) % #BLOSSOMS + 1]
		local count = math.max(3, math.floor(length / 1.8))
		for k = 1, count do
			local size = rng:NextNumber(0.42, 0.52)
			local j = math.clamp(math.floor((k - 0.5) / count * lumps) + 1, 1, lumps)
			local a = (if k % 2 == 0 then 1 else -1) * math.pi / 2 + rng:NextNumber(-0.7, 0.7)
			local up = rng:NextNumber(0.3, 0.9)
			local flat = math.sqrt(1 - up * up)
			local offset = centers[j]
				+ Vector3.new(math.cos(a) * flat, up, math.sin(a) * flat) * (sizes[j] / 2 - size * 0.25)
			-- 옆으로 폭 1.8 을 넘지 않게(Plan 의 산울타리 반지름 0.9: 길 옆 여유 안)
			local limit = 0.9 - size / 2
			offset = Vector3.new(offset.X, offset.Y, math.clamp(offset.Z, -limit, limit))
			ball(parent, "Flower", cf * offset, size, if k % 4 == 0 then WHITE else color)
		end
	end
end

-- 꽃밭 두 가지(Style 로 정함, 같은 모양이 줄지어 반복되지 않게):
--   돌 테두리 꽃밭(Style 1, 2, 4, 5): 흙 + 둘레에 손으로 쌓은 듯한 납작 돌(크기·각도·색이 조금씩 다름, 원이 아니라 울퉁불퉁)
--     + 낮은 잎 둔덕 셋 + 둔덕마다 겉에 박힌 작은 꽃 두세 송이(두 색)
--   들꽃 무더기(Style 3, 6): 테두리·흙 없이 잔디 위에 크기가 다른 잎 둔덕 4~5개를 비뚤게 모으고 꽃을 많이
function BUILD.FlowerBed(parent: Instance, item)
	local r, base = item.Radius, basePoint(item)
	local rng = itemRng(item, 4)
	local colors = FLOWER_PAIRS[(item.Style - 1) % #FLOWER_PAIRS + 1]
	local flower = math.clamp(r * 0.2, 0.5, 0.72)
	if item.Style % 3 == 0 then
		local mounds = if r > 3 then 5 else 4
		for k = 1, mounds do
			local a = item.Turn + k / mounds * math.pi * 2 + rng:NextNumber(-0.4, 0.4)
			local d = if k == 1 then 0 else r * rng:NextNumber(0.35, 0.62)
			local size = r * (if k == 1 then 0.95 else rng:NextNumber(0.55, 0.8))
			local x, z = base.X + math.cos(a) * d, base.Z + math.sin(a) * d
			-- 숲띠 언덕 비탈이면 둔덕마다 발밑(가운데 + 둘레 넷) 가장 높은 땅에 맞춤(아래쪽 꽃이 땅에 묻히지 않게)
			local ground = math.max(base.Y, groundAt(x, z))
			for q = 0, 3 do
				local qa = q * math.pi / 2
				ground = math.max(ground, groundAt(x + math.cos(qa) * size * 0.45, z + math.sin(qa) * size * 0.45))
			end
			local center = Vector3.new(x, ground - size * 0.18, z)
			ball(parent, "FlowerLeaves", center, size, BUSH[1]:Lerp(BUSH[3], rng:NextNumber(0.1, 0.45)), LEAVES)
			blossoms(parent, center, size, if k == 1 then 3 else 2, flower * 0.95, { colors[1], colors[2] }, rng)
		end
		return
	end
	disc(parent, "FlowerSoil", base - Vector3.new(0, 0.3, 0), 0.55, r * 2, SOIL, MAT.Ground)
	-- 테두리 돌: 둘레를 따라 한 줄(돌마다 반지름·높이·방향을 조금씩 흔듦)
	local stones = math.max(8, math.floor(r * 2 * math.pi / 1.7 + 0.5))
	local start = rng:NextNumber(0, math.pi * 2)
	for k = 1, stones do
		local a = start + k / stones * math.pi * 2 + rng:NextNumber(-0.08, 0.08)
		local d = r + 0.15 + rng:NextNumber(-0.12, 0.12)
		local length = 2 * math.pi * r / stones * rng:NextNumber(1.05, 1.3)
		local height = rng:NextNumber(0.5, 0.75)
		block(
			parent,
			"FlowerEdge",
			Vector3.new(0.85, height, length),
			CFrame.new(base.X + math.cos(a) * d, base.Y - 0.2 + height / 2, base.Z + math.sin(a) * d)
				* CFrame.Angles(0, -a + rng:NextNumber(-0.15, 0.15), 0)
				* CFrame.Angles(rng:NextNumber(-0.1, 0.1), 0, rng:NextNumber(-0.12, 0.12)),
			STONE:Lerp(ROCK, rng:NextNumber(0, 0.45)),
			MAT.Slate
		)
	end
	local soilTop = base.Y + 0.25
	for k = 1, 3 do
		local a = item.Turn + k / 3 * math.pi * 2 + rng:NextNumber(-0.25, 0.25)
		local d = r * 0.44
		local size = r * rng:NextNumber(0.95, 1.05)
		local center = Vector3.new(base.X + math.cos(a) * d, soilTop - size * 0.12, base.Z + math.sin(a) * d)
		ball(parent, "FlowerLeaves", center, size, BUSH[1]:Lerp(BUSH[2], 0.25 + 0.2 * k), LEAVES)
		blossoms(parent, center, size, if k == 1 then 3 else 2, flower, { colors[1], colors[2] }, rng)
	end
end

-- 토피어리(화분 + 다듬은 나무). Style 1 막대 사탕, 2 공 두 개, 3 세 단 원뿔(공 셋)
function BUILD.Topiary(parent: Instance, item)
	local s, base = item.Scale, basePoint(item)
	disc(parent, "TopiaryPot", base, 0.9 * s, 1.5 * s, rgb(214, 110, 72), MAT.Brick, true)
	local green = HEDGE:Lerp(BUSH[1], 0.2)
	if item.Style == 3 then
		ball(parent, "Topiary", base + Vector3.new(0, 1.9 * s, 0), 2.7 * s, green, LEAVES)
		ball(parent, "Topiary", base + Vector3.new(0, 3.5 * s, 0), 2 * s, green:Lerp(BUSH[2], 0.4), LEAVES)
		ball(parent, "Topiary", base + Vector3.new(0, 4.7 * s, 0), 1.3 * s, BUSH[3], LEAVES)
		return
	end
	disc(parent, "TopiaryStem", base + Vector3.new(0, 0.8 * s, 0), 2 * s, 0.35 * s, WOOD_DARK, MAT.Wood, true)
	ball(parent, "Topiary", base + Vector3.new(0, 3.4 * s, 0), 2.5 * s, green, LEAVES)
	if item.Style == 2 then
		ball(parent, "Topiary", base + Vector3.new(0, 5.1 * s, 0), 1.5 * s, BUSH[3], LEAVES)
	end
end

-- 둥근 바윗돌 하나: 크기가 다른 공 셋(가운데 큰 공 + 옆으로 비킨 작은 공 둘)을 겹쳐 아래를 땅에 묻음.
-- 윗부분만 보여서 낮고 넓적한 바위 덩어리(모난 상자보다 게임 전체의 통통한 모양과 어울림). center = 바닥 가운데
local function boulder(parent: Instance, name: string, center: Vector3, size: number, rng: Rng.Rng, tint: number)
	local color = ROCK:Lerp(ROCK_DARK, tint)
	ball(parent, name, center + Vector3.new(0, 0.05 * size, 0), 1.25 * size, color, MAT.Rock, true)
	local start = rng:NextNumber(0, math.pi * 2)
	for k = 1, 2 do
		local a = start + k * 2.5 + rng:NextNumber(-0.4, 0.4)
		local d = size * rng:NextNumber(0.42, 0.55)
		local ds = size * rng:NextNumber(0.72, 0.9)
		local x, z = center.X + math.cos(a) * d, center.Z + math.sin(a) * d
		-- 옆 공 자리의 땅이 더 높으면(지형 바위 턱 비탈) 그만큼 올림: 땅속에 다 묻히지 않게
		local y = math.max(center.Y - 0.12 * size, groundAt(x, z) - 0.2 * ds)
		ball(
			parent,
			name,
			Vector3.new(x, y, z),
			ds,
			color:Lerp(if k == 1 then ROCK_DARK else STONE, 0.25),
			if k == 1 then MAT.Slate else MAT.Rock,
			true
		)
	end
end

-- 바위: 둥근 바윗돌(몸통, 아래 반쯤 묻음) + 옆 작은 돌 1~2 + 윗면 이끼. 회색 두세 가지를 섞음
function BUILD.Rock(parent: Instance, item)
	local s, base = item.Scale, basePoint(item)
	local rng = itemRng(item, 5)
	local t = item.Turn
	-- 비탈(숲띠 언덕)이면 조각마다 그 자리 땅 높이에 맞춤(윗쪽 조각이 땅에 묻히지 않게)
	local function floorAt(ox: number, oz: number): number
		return math.max(base.Y, groundAt(base.X + ox, base.Z + oz))
	end
	local size = 2.4 * s
	boulder(parent, "Rock", Vector3.new(base.X, floorAt(0, 0) - 0.25 * size, base.Z), size, rng, 0.2 + item.Tint * 0.4)
	for k = 1, math.min(item.Style, 2) do
		local ox, oz = spin(if k == 1 then 2.2 else -1.9, if k == 1 then 1.1 else -1.4, t)
		local d = s * rng:NextNumber(0.9, 1.3)
		ball(
			parent,
			"Rock",
			Vector3.new(base.X + ox * s, floorAt(ox * s, oz * s) - 0.1 * d, base.Z + oz * s),
			d,
			ROCK:Lerp(if k == 1 then ROCK_DARK else STONE, 0.4),
			MAT.Slate,
			true
		)
	end
	-- 이끼: 몸통 윗면(해 반대쪽)에 반쯤 박힌 납작한 초록 공
	local mx, mz = spin(-0.35, 0.3, t)
	ball(
		parent,
		"Moss",
		Vector3.new(base.X + mx * size, floorAt(0, 0) + 0.3 * size, base.Z + mz * size),
		0.7 * size,
		MOSS,
		LEAVES
	)
end

-- 물가 바위 무더기: 지형 바위 턱(낮고 울퉁불퉁한 둔덕) 위에 크고 작은 둥근 바윗돌 셋(열대 바닷가의 매끈한 화강암처럼,
-- 아래 반쯤은 턱·물속에 묻힘). 따뜻한 회색 셋을 섞음. Scale = 지형 바위 반지름, Height = 지형 바위 꼭대기 높이
local GRANITE = { rgb(164, 156, 146), rgb(138, 136, 132), rgb(178, 168, 156) }
function BUILD.ShoreRock(parent: Instance, item)
	local r, top = item.Scale, item.Height
	local rng = itemRng(item, 11)
	local t = item.Turn
	local stones = {
		{ 0, 0, 0.66 }, -- 옆, 옆(바위 반지름 비율), 크기(비율)
		{ 0.62, 0.3, 0.44 },
		{ -0.5, -0.42, 0.36 },
	}
	for k, stone in stones do
		local ox, oz = spin(stone[1] * r, stone[2] * r, t)
		local x, z = item.X + ox, item.Z + oz
		local size = stone[3] * r
		local floor = math.max(math.min(top, groundAt(x, z)), Island.WATER_LEVEL - 0.2 * size)
		local color = GRANITE[k]
		ball(parent, "ShoreRock", Vector3.new(x, floor - 0.1 * size, z), 1.2 * size, color, MAT.Rock, true)
		-- 옆에 붙은 작은 공(둥근 돌 두 개가 붙은 모양): 바위마다 방향이 다름
		local a = t + k * 2.1 + rng:NextNumber(-0.5, 0.5)
		local d = 0.5 * size
		local px, pz = x + math.cos(a) * d, z + math.sin(a) * d
		local pfloor = math.max(math.min(top, groundAt(px, pz)), Island.WATER_LEVEL - 0.2 * size)
		ball(
			parent,
			"ShoreRock",
			Vector3.new(px, pfloor - 0.2 * size, pz),
			0.85 * size,
			color:Lerp(ROCK_DARK, 0.2),
			MAT.Rock,
			true
		)
	end
end

-- 정원등: 가는 짙은 초록 기둥 + 등 + 모자(광장 가로등보다 가늘고 낮게, 따뜻한 빛)
function BUILD.Lamp(parent: Instance, item)
	local base = basePoint(item)
	disc(parent, "LampPost", base, 6.6, 0.42, GARDEN_GREEN, MAT.Metal, true)
	local bulb = ball(parent, "LampBulb", base + Vector3.new(0, 7, 0), 1.3, LAMP_LIGHT, MAT.Neon)
	disc(parent, "LampCap", base + Vector3.new(0, 7.55, 0), 0.3, 1.6, GARDEN_GREEN, MAT.Metal)
	local light = Instance.new("PointLight")
	light.Color = LAMP_LIGHT
	light.Range = 14
	light.Brightness = 0.9
	light.Parent = bulb
end

-- 벤치: 나무판 앉는 판 + 등받이 + 쇠 다리 둘. Turn = 앉은 사람이 보는 쪽
function BUILD.Bench(parent: Instance, item)
	local cf = heading(basePoint(item), item.Turn)
	block(parent, "BenchSeat", Vector3.new(5, 0.35, 1.6), cf * CFrame.new(0, 1.5, 0), WOOD, MAT.WoodPlanks, true)
	block(
		parent,
		"BenchBack",
		Vector3.new(5, 1.2, 0.3),
		cf * CFrame.new(0, 2.5, 0.78) * CFrame.Angles(math.rad(-10), 0, 0),
		WOOD,
		MAT.WoodPlanks,
		true
	)
	for _, x in { -2.1, 2.1 } do
		block(parent, "BenchLeg", Vector3.new(0.35, 1.4, 1.5), cf * CFrame.new(x, 0.7, 0.05), IRON, MAT.Metal, true)
		-- 등받이를 받치는 쇠 기둥(앉는 판 뒤 가장자리 → 등받이 위까지, 등받이와 같이 뒤로 기움)
		block(
			parent,
			"BenchFrame",
			Vector3.new(0.3, 1.9, 0.3),
			cf * CFrame.new(x, 2.25, 0.62) * CFrame.Angles(math.rad(-10), 0, 0),
			IRON,
			MAT.Metal,
			true
		)
	end
end

-- 3단 분수: 대리석 수반(찰랑이는 물) + 기둥 + 가운데 접시(물) + 위 작은 접시 + 물줄기
function BUILD.Fountain(parent: Instance, item)
	local r, base = item.Radius, basePoint(item)
	disc(parent, "FountainBasin", base, 1.3, r * 2, MARBLE, MAT.Marble, true)
	local water = disc(parent, "FountainWater", base + Vector3.new(0, 0.2, 0), 1.0, r * 2 - 1.2, WATER, MAT.Glass)
	water.Transparency = 0.25
	disc(parent, "FountainColumn", base, 3.4, 1.4, MARBLE, MAT.Marble, true)
	disc(parent, "FountainBowl", base + Vector3.new(0, 3.2, 0), 0.5, 4.6, MARBLE, MAT.Marble)
	local bowlWater = disc(parent, "FountainWater", base + Vector3.new(0, 3.3, 0), 0.45, 4, WATER, MAT.Glass)
	bowlWater.Transparency = 0.25
	disc(parent, "FountainColumn", base + Vector3.new(0, 3.6, 0), 1.7, 0.8, MARBLE, MAT.Marble)
	disc(parent, "FountainBowl", base + Vector3.new(0, 5.2, 0), 0.4, 2.3, MARBLE, MAT.Marble)
	local jet = ball(parent, "FountainJet", base + Vector3.new(0, 6.1, 0), 1.3, WATER_LIGHT, MAT.Glass)
	jet.Transparency = 0.3
	-- 가운데 접시에서 떨어지는 물(반투명 원기둥 벽 대신 얇은 물줄기 넷)
	for k = 0, 3 do
		local a = item.Turn + k * math.pi / 2
		local p = base + Vector3.new(math.cos(a) * 2.2, 0, math.sin(a) * 2.2)
		local fall = block(
			parent,
			"FountainFall",
			Vector3.new(0.5, 2.2, 0.12),
			CFrame.lookAt(p + Vector3.new(0, 2.2, 0), base + Vector3.new(0, 2.2, 0)),
			WATER_LIGHT,
			MAT.Glass
		)
		fall.Transparency = 0.35
	end
end

-- 지형 연못 꾸밈(물은 지형): 둘레 납작 돌(다리 자리는 비움) + 수련 잎·꽃 + 부들 두 무더기.
-- Scale = 연못 반지름, Height = 연못 시드(Island.pondRadius 와 같은 구불구불 가장자리)
function BUILD.PondDeco(parent: Instance, item)
	local r, base, t = item.Scale, basePoint(item), item.Turn
	local rng = itemRng(item, 6)
	local pond = { X = item.X, Z = item.Z, R = r, Depth = 0, Seed = item.Height }
	for k = 0, 13 do
		local a = t + (k + 0.5) / 14 * math.pi * 2
		-- 다리(Turn 방향 앞뒤)와 겹치는 돌은 뺌
		local across = math.abs(math.sin(a - t))
		if across > 0.3 then
			local edge = Island.pondRadius(pond, a) + 0.4
			local size = rng:NextNumber(1.5, 2.3)
			block(
				parent,
				"PondStone",
				Vector3.new(size, 0.7, size * rng:NextNumber(0.7, 1)),
				CFrame.new(base + Vector3.new(math.cos(a) * edge, 0.05, math.sin(a) * edge))
					* CFrame.Angles(rng:NextNumber(-0.12, 0.12), rng:NextNumber(0, 6.28), rng:NextNumber(-0.12, 0.12)),
				STONE:Lerp(ROCK, rng:NextNumber()),
				MAT.Slate,
				true
			)
		end
	end
	local pads = 0
	for k = 1, 12 do
		if pads >= 6 then
			break
		end
		local a = rng:NextNumber(0, math.pi * 2)
		local d = r * rng:NextNumber(0.3, 0.72)
		local side = math.abs(math.sin(a - t)) * d
		if side > 3.4 then
			pads += 1
			local p = base + Vector3.new(math.cos(a) * d, 0, math.sin(a) * d)
			-- 물 윗면(0) 위로 살짝(잔물결에 가려지지 않게)
			disc(parent, "LilyPad", p + Vector3.new(0, 0.04, 0), 0.1, rng:NextNumber(1.5, 2.2), LILY, LEAVES)
			if pads % 3 == 1 then
				ball(parent, "LilyFlower", p + Vector3.new(0, 0.3, 0), 0.65, PINK)
			end
		end
	end
	-- 부들(줄기 + 갈색 이삭) 두 무더기: 다리 옆쪽 물가
	for _, side in { -1, 1 } do
		local a = t + side * math.rad(118)
		local edge = Island.pondRadius(pond, a) - 0.8
		for k = 1, 2 do
			local p = base + Vector3.new(math.cos(a + k * 0.09) * edge, 0, math.sin(a + k * 0.09) * edge)
			local h = 2.2 + k * 0.5
			disc(parent, "Reed", p - Vector3.new(0, 0.5, 0), h + 0.5, 0.16, LILY:Lerp(BUSH[1], 0.4))
			disc(parent, "Cattail", p + Vector3.new(0, h - 0.9, 0), 0.8, 0.38, COCONUT)
		end
	end
end

-- 연못 위 아치 나무다리: 오르막 + 평평한 가운데 + 내리막(윗면 최고 1.2) + 양옆 난간(기둥 + 손잡이)
function BUILD.Bridge(parent: Instance, item)
	local length, width = item.Height, 4.6
	local cf = heading(basePoint(item), item.Turn)
	local rise, third = 1.2, length / 3
	local slope = math.atan2(rise, third)
	local rampLength = math.sqrt(third * third + rise * rise)
	-- 로컬 -Z = 앞. 오르막(뒤 → 가운데), 가운데, 내리막
	local deck = {
		{ cf * CFrame.new(0, rise / 2, third) * CFrame.Angles(slope, 0, 0), rampLength },
		{ cf * CFrame.new(0, rise, 0), third },
		{ cf * CFrame.new(0, rise / 2, -third) * CFrame.Angles(-slope, 0, 0), rampLength },
	}
	for _, piece in deck do
		block(
			parent,
			"BridgeDeck",
			Vector3.new(width, 0.4, piece[2] + 0.25),
			piece[1] * CFrame.new(0, -0.2, 0),
			WOOD,
			MAT.WoodPlanks,
			true
		)
		for _, side in { -1, 1 } do
			block(
				parent,
				"BridgeRail",
				Vector3.new(0.25, 0.25, piece[2]),
				piece[1] * CFrame.new(side * (width / 2 - 0.15), 2.2, 0),
				WOOD_LIGHT,
				MAT.Wood,
				true
			)
		end
	end
	for _, z in { third * 1.5, third * 0.5, -third * 0.5, -third * 1.5 } do
		local y = if math.abs(z) < third then rise else rise * (1.5 - math.abs(z) / third) * 2 / 2
		for _, side in { -1, 1 } do
			disc(
				parent,
				"BridgePost",
				(cf * CFrame.new(side * (width / 2 - 0.15), y - 1.5, z)).Position,
				3.7,
				0.4,
				WOOD_DARK,
				MAT.Wood,
				true
			)
		end
	end
end

-- 징검돌 다섯(납작 돌, 살짝 휘어진 줄). Turn = 줄 방향
function BUILD.Stones(parent: Instance, item)
	local base = basePoint(item)
	local rng = itemRng(item, 7)
	for k = -2, 2 do
		local along = k * 1.8
		local side = math.sin(k * 0.9) * 0.6
		local ox, oz = spin(along, side, item.Turn)
		disc(
			parent,
			"SteppingStone",
			base + Vector3.new(ox, -0.2, oz),
			0.34,
			rng:NextNumber(1.25, 1.6),
			STONE:Lerp(ROCK, rng:NextNumber(0, 0.5)),
			MAT.Slate,
			true
		)
	end
end

-- 소풍 돗자리: 격자무늬(흰 줄 가로·세로 둘씩) + 바구니(뚜껑) + 접시 둘 + 과일
function BUILD.Blanket(parent: Instance, item)
	local cf = heading(basePoint(item), item.Turn)
	local color = if item.Style == 2 then SKY else RED
	-- 땅(지형 윗면 0)에서 0.05 띄움: 지형 면과 겹쳐 깜빡이지 않게. 줄끼리도 윗면 0.03 씩 차이
	block(parent, "Blanket", Vector3.new(4.4, 0.08, 3.6), cf * CFrame.new(0, 0.09, 0), color, MAT.Fabric)
	for _, x in { -1.1, 1.1 } do
		block(parent, "BlanketStripe", Vector3.new(0.5, 0.1, 3.6), cf * CFrame.new(x, 0.11, 0), WHITE, MAT.Fabric)
	end
	for _, z in { -0.9, 0.9 } do
		block(parent, "BlanketStripe", Vector3.new(4.4, 0.1, 0.5), cf * CFrame.new(0, 0.14, z), WHITE, MAT.Fabric)
	end
	block(parent, "Basket", Vector3.new(1.3, 0.8, 0.9), cf * CFrame.new(1.2, 0.45, -0.6), WOOD, MAT.WoodPlanks)
	block(parent, "BasketLid", Vector3.new(1.4, 0.15, 1), cf * CFrame.new(1.2, 0.9, -0.6), WOOD_DARK, MAT.WoodPlanks)
	for _, x in { -1.2, -0.1 } do
		disc(parent, "Plate", (cf * CFrame.new(x, 0.13, 0.5)).Position, 0.1, 0.9, WHITE, MAT.SmoothPlastic)
	end
	ball(parent, "Fruit", (cf * CFrame.new(-1.2, 0.35, 0.5)).Position, 0.45, FRUITS[2])
end

-- 파라솔: 기둥 + 팔각 원뿔 지붕(쐐기 여덟 장, 색·하양 번갈아 = 줄무늬) + 꼭지 공
local UMBRELLA_RADIUS = 3.9
local UMBRELLA_RISE = 1.7 -- 지붕 가장자리 → 꼭대기
local UMBRELLA_RIM = 5.2 -- 지붕 가장자리 높이(발밑 기준)
local function umbrella(parent: Instance, base: Vector3, turn: number, color: Color3)
	disc(
		parent,
		"UmbrellaPole",
		base - Vector3.new(0, 0.6, 0),
		UMBRELLA_RIM + UMBRELLA_RISE + 0.3,
		0.3,
		PAINT_WHITE,
		MAT.Wood,
		true
	)
	local width = 2 * UMBRELLA_RADIUS * math.tan(math.pi / 8) * 1.02
	for k = 0, 7 do
		local a = turn + (k + 0.5) / 8 * math.pi * 2
		local out = Vector3.new(math.cos(a), 0, math.sin(a))
		-- 쐐기 높은 면(+Z)이 기둥 쪽, 비탈이 바깥(-Z)을 봄
		local center = base + Vector3.new(0, UMBRELLA_RIM + UMBRELLA_RISE / 2, 0) + out * (UMBRELLA_RADIUS / 2)
		wedge(
			parent,
			"UmbrellaCanopy",
			Vector3.new(width, UMBRELLA_RISE, UMBRELLA_RADIUS),
			CFrame.lookAt(center, center + out),
			if k % 2 == 0 then color else WHITE,
			MAT.Fabric
		)
	end
	ball(parent, "UmbrellaTop", base + Vector3.new(0, UMBRELLA_RIM + UMBRELLA_RISE + 0.1, 0), 0.7, WHITE)
end

-- 소풍 탁자: 나무판 윗판 + 긴 의자 둘 + A자 다리 둘 + 가운데 줄무늬 파라솔. Turn = 탁자 길이에 수직
function BUILD.PicnicTable(parent: Instance, item)
	local cf = heading(basePoint(item), item.Turn)
	block(parent, "PicnicTop", Vector3.new(5.6, 0.35, 2.6), cf * CFrame.new(0, 2.3, 0), WOOD, MAT.WoodPlanks, true)
	for _, z in { -2.2, 2.2 } do
		block(parent, "PicnicSeat", Vector3.new(5.6, 0.3, 0.9), cf * CFrame.new(0, 1.3, z), WOOD, MAT.WoodPlanks, true)
	end
	for _, x in { -2.2, 2.2 } do
		block(parent, "PicnicLeg", Vector3.new(0.4, 2.1, 5), cf * CFrame.new(x, 1.05, 0), WOOD_DARK, MAT.Wood, true)
	end
	umbrella(parent, basePoint(item), item.Turn, CORAL)
end

-- 장미 아치(오솔길 위): 흰 기둥 둘 + 둥근 윗부분(세 토막) + 잎 뭉치 + 장미. Turn = 오솔길 방향
function BUILD.Arch(parent: Instance, item)
	local cf = heading(basePoint(item), item.Turn)
	local half = 3.3
	for _, side in { -1, 1 } do
		disc(parent, "ArchPost", (cf * CFrame.new(side * half, 0, 0)).Position, 4.6, 0.35, PAINT_WHITE, MAT.Wood, true)
	end
	-- 반원(4.6 위에서 반지름 half): 60도씩 세 토막
	local points = {}
	for k = 0, 3 do
		local a = math.pi - k / 3 * math.pi
		table.insert(points, (cf * CFrame.new(math.cos(a) * half, 4.6 + math.sin(a) * half * 0.8, 0)).Position)
	end
	for k = 1, 3 do
		rod(parent, "ArchTop", points[k], points[k + 1], 0.35, PAINT_WHITE, MAT.Wood)
	end
	local roses = { PINK, CORAL, WHITE }
	for k = 0, 6 do
		local a = math.pi - (k + 0.5) / 7 * math.pi
		local p = (cf * CFrame.new(math.cos(a) * half, 4.6 + math.sin(a) * half * 0.8, (k % 2 - 0.5) * 0.4)).Position
		if k % 2 == 0 then
			ball(parent, "ArchLeaves", p, 1.2, BUSH[2], LEAVES)
		else
			ball(parent, "Rose", p + Vector3.new(0, 0.2, 0), 0.7, roses[k % 3 + 1])
		end
	end
	for _, side in { -1, 1 } do
		ball(parent, "ArchLeaves", (cf * CFrame.new(side * half, 2.2, 0)).Position, 1.1, BUSH[1], LEAVES)
		ball(parent, "Rose", (cf * CFrame.new(side * half, 2.9, -0.4)).Position, 0.6, PINK)
	end
end

-- 새 물통: 대리석 기둥 + 접시 + 물 + 작은 새(몸통 + 머리 + 부리)
function BUILD.Birdbath(parent: Instance, item)
	local base = basePoint(item)
	disc(parent, "BirdbathFoot", base, 0.4, 1.4, MARBLE, MAT.Marble, true)
	disc(parent, "BirdbathPillar", base, 2.4, 0.7, MARBLE, MAT.Marble, true)
	disc(parent, "BirdbathBowl", base + Vector3.new(0, 2.4, 0), 0.4, 2.4, MARBLE, MAT.Marble, true)
	disc(parent, "BirdbathWater", base + Vector3.new(0, 2.45, 0), 0.4, 2, WATER, MAT.Glass)
	local cf = heading(base + Vector3.new(0, 2.8, 0), item.Turn) * CFrame.new(0.85, 0, 0)
	ball(parent, "Bird", (cf * CFrame.new(0, 0.2, 0)).Position, 0.5, SKY)
	ball(parent, "BirdHead", (cf * CFrame.new(0, 0.5, -0.2)).Position, 0.34, SKY)
	block(parent, "BirdBeak", Vector3.new(0.1, 0.1, 0.22), cf * CFrame.new(0, 0.5, -0.43), SUN)
end

-- 과일 상자: 나무 상자 + 위에 과일 다섯
function BUILD.Crate(parent: Instance, item)
	local cf = heading(basePoint(item), item.Turn)
	block(parent, "Crate", Vector3.new(2.4, 1.1, 1.6), cf * CFrame.new(0, 0.55, 0), WOOD_LIGHT, MAT.WoodPlanks, true)
	for k = 0, 4 do
		local x = -0.8 + (k % 3) * 0.8
		local z = if k < 3 then -0.3 else 0.35
		ball(
			parent,
			"Fruit",
			(cf * CFrame.new(x + (if k >= 3 then 0.4 else 0), 1.25, z)).Position,
			0.6,
			FRUITS[k % 3 + 1]
		)
	end
end

-- 석등(바위 정원): 받침 + 기둥 + 불 상자(안에 빛) + 넓은 지붕 + 꼭지
function BUILD.Lantern(parent: Instance, item)
	local base = basePoint(item)
	local cf = CFrame.new(base) * CFrame.Angles(0, item.Turn, 0)
	block(parent, "LanternBase", Vector3.new(1.6, 0.4, 1.6), cf * CFrame.new(0, 0.2, 0), STONE, MAT.Slate, true)
	disc(parent, "LanternPillar", base + Vector3.new(0, 0.4, 0), 1.6, 0.7, STONE, MAT.Slate, true)
	block(
		parent,
		"LanternBox",
		Vector3.new(1.3, 1, 1.3),
		cf * CFrame.new(0, 2.5, 0),
		STONE:Lerp(ROCK, 0.3),
		MAT.Slate,
		true
	)
	local glow =
		block(parent, "LanternLight", Vector3.new(1.34, 0.45, 0.6), cf * CFrame.new(0, 2.5, 0), LAMP_LIGHT, MAT.Neon)
	local light = Instance.new("PointLight")
	light.Color = LAMP_LIGHT
	light.Range = 8
	light.Brightness = 0.7
	light.Parent = glow
	block(
		parent,
		"LanternRoof",
		Vector3.new(2.3, 0.45, 2.3),
		cf * CFrame.new(0, 3.2, 0) * CFrame.Angles(0, math.rad(45), 0),
		ROCK,
		MAT.Slate,
		true
	)
	ball(parent, "LanternKnob", base + Vector3.new(0, 3.65, 0), 0.6, ROCK, MAT.Slate)
end

-- 정자: 돌 턱 + 나무 마루(윗면 0.4) + 흰 기둥 여덟(오솔길 방향 앞뒤로 드나듦) + 난간 여섯 + 세 단 지붕 + 꼭지
-- + 안쪽 양옆 벤치 + 가운데 매단 등. Turn = 오솔길 방향
function BUILD.Gazebo(parent: Instance, item)
	local base = basePoint(item)
	local cf = heading(base, item.Turn)
	disc(parent, "GazeboStep", base - Vector3.new(0, 0.3, 0), 0.5, 16.2, STONE, MAT.Cobblestone, true)
	disc(parent, "GazeboFloor", base - Vector3.new(0, 0.1, 0), 0.5, 15, WOOD_LIGHT, MAT.WoodPlanks, true)
	local postR = 6.8
	local posts = {}
	for k = 0, 7 do
		local a = (k + 0.5) / 8 * math.pi * 2 -- 앞뒤(0, 180도)는 기둥 사이
		local p = (cf * CFrame.new(math.sin(a) * postR, 0.4, -math.cos(a) * postR)).Position
		posts[k + 1] = p
		disc(parent, "GazeboPost", p, 6, 0.55, PAINT_WHITE, MAT.Wood, true)
	end
	-- 난간: 앞뒤 입구(기둥 8-1, 4-5 사이)만 비움
	for k = 1, 8 do
		local nextK = k % 8 + 1
		if k ~= 8 and k ~= 4 then
			-- 이웃 난간끼리 기둥에서 겹치는 끝이 같은 높이로 깜빡이지 않게 번갈아 0.05 차이
			local lift = Vector3.new(0, 1.3 + (k % 2) * 0.05, 0)
			local a, b = posts[k] + lift, posts[nextK] + lift
			block(
				parent,
				"GazeboRail",
				Vector3.new(0.25, 0.25, (b - a).Magnitude),
				CFrame.lookAt((a + b) / 2, b),
				PAINT_WHITE,
				MAT.Wood,
				true
			)
		end
	end
	local roof = rgb(84, 172, 156)
	disc(parent, "GazeboRoof", base + Vector3.new(0, 6.3, 0), 0.6, 16.4, PAINT_WHITE, MAT.Wood)
	disc(parent, "GazeboRoof", base + Vector3.new(0, 6.9, 0), 0.9, 13.4, roof, MAT.WoodPlanks)
	disc(parent, "GazeboRoof", base + Vector3.new(0, 7.8, 0), 0.9, 9.6, roof:Lerp(PAINT_WHITE, 0.15), MAT.WoodPlanks)
	disc(parent, "GazeboRoof", base + Vector3.new(0, 8.7, 0), 0.9, 5.6, roof:Lerp(PAINT_WHITE, 0.3), MAT.WoodPlanks)
	ball(parent, "GazeboFinial", base + Vector3.new(0, 10, 0), 1.3, SUN, MAT.Metal)
	disc(parent, "GazeboChain", base + Vector3.new(0, 5.8, 0), 0.7, 0.14, IRON, MAT.Metal) -- 지붕에 매단 줄
	local lamp = ball(parent, "GazeboLamp", base + Vector3.new(0, 5.4, 0), 1.2, LAMP_LIGHT, MAT.Neon)
	local light = Instance.new("PointLight")
	light.Color = LAMP_LIGHT
	light.Range = 14
	light.Brightness = 0.8
	light.Parent = lamp
	for _, side in { -1, 1 } do
		local seat = cf * CFrame.new(side * 4.6, 0.4, 0) * CFrame.Angles(0, side * math.rad(90), 0)
		block(
			parent,
			"BenchSeat",
			Vector3.new(4.2, 0.35, 1.4),
			seat * CFrame.new(0, 1.3, 0),
			WOOD,
			MAT.WoodPlanks,
			true
		)
		block(parent, "BenchLeg", Vector3.new(3.6, 1.2, 1), seat * CFrame.new(0, 0.6, 0), WOOD_DARK, MAT.Wood, true)
	end
end

-- 등대: 돌 받침(곶 바위에 묻힘) + 빨강·하양 줄무늬 탑 넷(위로 가늘게) + 문·창 + 쇠 발코니 + 팔각 난간
-- + 빛나는 등 + 빨간 지붕 돔 + 꼭지. Turn = 문 쪽(섬 안쪽)
function BUILD.Lighthouse(parent: Instance, item)
	local base = basePoint(item)
	local cf = heading(base, item.Turn)
	disc(parent, "LighthousePlinth", base - Vector3.new(0, 1.6, 0), 3, 9, ROCK:Lerp(STONE, 0.4), MAT.Cobblestone, true)
	local y = 1.4
	local radius = 3.1
	for k, diameter in { 6.2, 5.8, 5.4, 5 } do
		disc(
			parent,
			"LighthouseTower",
			base + Vector3.new(0, y, 0),
			5,
			diameter,
			if k % 2 == 1 then RED else PAINT_WHITE,
			MAT.SmoothPlastic,
			true
		)
		y += 5
	end
	block(
		parent,
		"LighthouseDoor",
		Vector3.new(1.8, 3, 0.4),
		cf * CFrame.new(0, 2.9, -radius + 0.05),
		WOOD_DARK,
		MAT.WoodPlanks
	)
	for _, h in { 9, 14 } do
		local w = cf * CFrame.new(0, h, -(if h > 10 then 2.72 else 2.92) + 0.02)
		block(parent, "LighthouseWindow", Vector3.new(1, 1.4, 0.3), w, NAVY, MAT.Glass)
	end
	disc(parent, "LighthouseGallery", base + Vector3.new(0, y, 0), 0.5, 7.6, IRON, MAT.Metal, true)
	for k = 0, 7 do
		local a1, a2 = k / 8 * math.pi * 2, (k + 1) / 8 * math.pi * 2
		local p1 = base + Vector3.new(math.cos(a1) * 3.6, y + 1.5, math.sin(a1) * 3.6)
		local p2 = base + Vector3.new(math.cos(a2) * 3.6, y + 1.5, math.sin(a2) * 3.6)
		block(
			parent,
			"LighthouseRail",
			Vector3.new(0.2, 1.1, (p2 - p1).Magnitude + 0.1),
			CFrame.lookAt((p1 + p2) / 2, p2) * CFrame.new(0, -0.45 + (k % 2) * 0.05, 0),
			IRON,
			MAT.Metal,
			true
		)
	end
	local lantern = disc(parent, "LighthouseLantern", base + Vector3.new(0, y + 0.5, 0), 3, 3.8, LAMP_LIGHT, MAT.Neon)
	local light = Instance.new("PointLight")
	light.Color = LAMP_LIGHT
	light.Range = 40
	light.Brightness = 2
	light.Parent = lantern
	disc(parent, "LighthouseRoof", base + Vector3.new(0, y + 3.5, 0), 0.7, 5, RED, MAT.SmoothPlastic)
	ball(parent, "LighthouseDome", base + Vector3.new(0, y + 4.2, 0), 4, RED, MAT.SmoothPlastic)
	disc(parent, "LighthouseSpire", base + Vector3.new(0, y + 5.8, 0), 1.4, 0.3, IRON, MAT.Metal)
	ball(parent, "LighthouseTop", base + Vector3.new(0, y + 7.3, 0), 0.7, SUN, MAT.Metal)
end

-- 구명 튜브: 빨강·하양 번갈아 여섯 토막 고리. cf = 고리 가운데, 고리 면 = cf 의 XY 평면
local function lifebuoy(parent: Instance, cf: CFrame)
	for k = 0, 5 do
		local a1, a2 = k / 6 * math.pi * 2, (k + 1) / 6 * math.pi * 2
		local p1 = (cf * CFrame.new(math.cos(a1) * 0.85, math.sin(a1) * 0.85, 0)).Position
		local p2 = (cf * CFrame.new(math.cos(a2) * 0.85, math.sin(a2) * 0.85, 0)).Position
		rod(parent, "Lifebuoy", p1, p2, 0.42, if k % 2 == 0 then CORAL else WHITE, MAT.SmoothPlastic)
	end
end

-- 부두: 풀밭 끝에서 바다로 뻗은 나무판(윗면 Y) + T자 끝 판 + 바닥까지 박힌 기둥(물 위로 난간 기둥이 됨)
-- + 난간 손잡이 + 끝에 정원등 둘·벤치·구명 튜브. Height = 전체 길이, Radius = 반폭, Turn = 바다 쪽
function BUILD.Pier(parent: Instance, item)
	local length, half = item.Height, item.Radius
	local top = item.Y
	local ground = Vector3.new(item.X, 0, item.Z)
	local cf = heading(ground, item.Turn)
	local headDepth, headHalf = 7, 6.5
	local main = length - headDepth
	block(
		parent,
		"PierDeck",
		Vector3.new(half * 2, 0.5, main + 0.2), -- T자 끝 판과 맞닿기만(겹치면 같은 높이라 깜빡임)
		cf * CFrame.new(0, top - 0.25, -(main - 0.2) / 2),
		WOOD,
		MAT.WoodPlanks,
		true
	)
	block(
		parent,
		"PierHead",
		Vector3.new(headHalf * 2, 0.5, headDepth),
		cf * CFrame.new(0, top - 0.25, -(main + headDepth / 2)),
		WOOD,
		MAT.WoodPlanks,
		true
	)
	-- 기둥: 땅이 판 밑보다 0.5 이상 낮은 곳만. 물가 쪽(땅이 판 가까이)은 난간 없음
	local railFrom = nil
	local function post(localX: number, localZ: number, rail: boolean)
		local p = cf * Vector3.new(localX, 0, localZ)
		local floor = groundAt(p.X, p.Z)
		if floor > top - 0.9 and not rail then
			return
		end
		local bottom = math.min(floor, top - 0.9) - 1
		local height = top - bottom + (if rail then 2.6 else -0.2)
		disc(parent, "PierPost", Vector3.new(p.X, bottom, p.Z), height, 0.7, WOOD_DARK, MAT.Wood, true)
	end
	for z = 6, main, 7 do
		local p = cf * Vector3.new(0, 0, -z)
		local rail = groundAt(p.X, p.Z) < top - 1.6
		if rail and not railFrom then
			railFrom = z
		end
		for _, side in { -1, 1 } do
			post(side * (half - 0.3), -z, rail)
		end
	end
	for _, x in { -headHalf + 0.3, headHalf - 0.3 } do
		for _, z in { main + 0.3, length - 0.3 } do
			post(x, -z, true)
		end
	end
	post(0, -(length - 0.3), true)
	-- 난간 손잡이(양옆 긴 것 + T자 끝 앞·옆)
	local railY = top + 2.3
	local from = railFrom or 6
	for _, side in { -1, 1 } do
		local x = side * (half - 0.3)
		block(
			parent,
			"PierRail",
			Vector3.new(0.3, 0.3, main - from),
			cf * CFrame.new(x, railY, -(from + main) / 2),
			WOOD_LIGHT,
			MAT.Wood,
			true
		)
		block(
			parent,
			"PierRail",
			Vector3.new(0.3, 0.3, headDepth),
			cf * CFrame.new(side * (headHalf - 0.3), railY, -(main + headDepth / 2)),
			WOOD_LIGHT,
			MAT.Wood,
			true
		)
		block(
			parent,
			"PierRail",
			Vector3.new(headHalf - half, 0.3, 0.3),
			cf * CFrame.new(side * (half + headHalf) / 2, railY - 0.05, -(main + 0.3)),
			WOOD_LIGHT,
			MAT.Wood,
			true
		)
	end
	block(
		parent,
		"PierRail",
		Vector3.new(headHalf * 2, 0.3, 0.3),
		cf * CFrame.new(0, railY - 0.05, -(length - 0.3)),
		WOOD_LIGHT,
		MAT.Wood,
		true
	)
	-- 끝: 양쪽 모서리 정원등, 바다를 보는 벤치, 난간에 건 구명 튜브(빨강·하양 여섯 토막)
	for _, side in { -1, 1 } do
		BUILD.Lamp(parent, {
			X = (cf * Vector3.new(side * (headHalf - 1.2), 0, -(length - 1.2))).X,
			Y = top,
			Z = (cf * Vector3.new(side * (headHalf - 1.2), 0, -(length - 1.2))).Z,
		})
	end
	BUILD.Bench(parent, {
		X = (cf * Vector3.new(0, 0, -(length - 2.4))).X,
		Y = top,
		Z = (cf * Vector3.new(0, 0, -(length - 2.4))).Z,
		Turn = item.Turn,
	})
	lifebuoy(
		parent,
		cf * CFrame.new(headHalf - 0.1, top + 1.4, -(main + headDepth / 2)) * CFrame.Angles(0, math.rad(90), 0)
	)
end

-- 구조대 망루: 흰 다리 넷(비탈이면 다리 길이를 땅에 맞춤) + 나무 발판 + 빨간 의자(받침 + 앉는 판 + 등받이)
-- + 뒤쪽 비스듬한 사다리 판 + 깃발 + 앞에 건 구명 튜브. Turn = 바다 쪽
function BUILD.Lifeguard(parent: Instance, item)
	local base = basePoint(item)
	local cf = heading(base, item.Turn)
	local deck = 4.2
	for _, c in { { -1.3, -1.1 }, { 1.3, -1.1 }, { -1.3, 1.1 }, { 1.3, 1.1 } } do
		local p = cf * Vector3.new(c[1], 0, c[2])
		local floor = groundAt(p.X, p.Z)
		local bottom = floor - 0.5
		disc(
			parent,
			"LifeguardLeg",
			Vector3.new(p.X, bottom, p.Z),
			base.Y + deck - bottom,
			0.4,
			PAINT_WHITE,
			MAT.Wood,
			true
		)
	end
	block(
		parent,
		"LifeguardDeck",
		Vector3.new(3.4, 0.35, 3.1),
		cf * CFrame.new(0, deck + 0.17, 0),
		WOOD,
		MAT.WoodPlanks,
		true
	)
	block(
		parent,
		"LifeguardSeatBox",
		Vector3.new(2.2, 1, 1.3),
		cf * CFrame.new(0, deck + 0.85, 0.5),
		PAINT_WHITE,
		MAT.WoodPlanks,
		true
	)
	block(
		parent,
		"LifeguardSeat",
		Vector3.new(2.3, 0.3, 1.4),
		cf * CFrame.new(0, deck + 1.5, 0.45),
		RED,
		MAT.WoodPlanks,
		true
	)
	block(
		parent,
		"LifeguardBack",
		Vector3.new(2.3, 1.7, 0.3),
		cf * CFrame.new(0, deck + 2.4, 1.2) * CFrame.Angles(math.rad(-12), 0, 0),
		RED,
		MAT.WoodPlanks,
		true
	)
	-- 사다리: 뒤쪽 땅에서 발판 뒤 가장자리까지 비스듬한 판(가로대 무늬는 WoodPlanks)
	local foot = cf * Vector3.new(0, 0, 3.6)
	local from = Vector3.new(foot.X, groundAt(foot.X, foot.Z), foot.Z)
	local to = (cf * CFrame.new(0, deck + 0.1, 1.5)).Position
	block(
		parent,
		"LifeguardLadder",
		Vector3.new(1.3, 0.25, (to - from).Magnitude),
		CFrame.lookAt((from + to) / 2, to),
		WOOD_LIGHT,
		MAT.WoodPlanks,
		true
	)
	local pole = (cf * CFrame.new(1.45, deck + 0.35, 1.3)).Position
	disc(parent, "LifeguardFlagPole", pole, 4.2, 0.16, PAINT_WHITE, MAT.Metal)
	block(
		parent,
		"LifeguardFlag",
		Vector3.new(0.08, 0.9, 1.4),
		cf * CFrame.new(1.45, deck + 4, 2.05),
		CORAL,
		MAT.Fabric
	)
	lifebuoy(parent, cf * CFrame.new(1.3, deck - 1.4, -1.42)) -- 앞 다리에 걸어 둠(고리가 다리에 닿음)
end

-- 간식 가게: 나무 마루 + 벽 셋(민트 판자) + 흰 계산대 + 줄무늬 차양 + 지붕 + 지붕 위 아이스크림 간판 + 의자 둘.
-- Turn = 계산대가 보는 쪽
function BUILD.Kiosk(parent: Instance, item)
	local base = basePoint(item)
	local cf = heading(base, item.Turn)
	block(parent, "KioskFloor", Vector3.new(7.4, 0.6, 6.4), cf * CFrame.new(0, 0.1, 0), WOOD, MAT.WoodPlanks, true)
	block(parent, "KioskWall", Vector3.new(7, 5, 0.4), cf * CFrame.new(0, 2.9, 2.9), MINT, MAT.WoodPlanks, true)
	for _, side in { -1, 1 } do
		block(
			parent,
			"KioskWall",
			Vector3.new(0.4, 4.9, 6),
			cf * CFrame.new(side * 3.3, 2.85, 0),
			MINT,
			MAT.WoodPlanks,
			true
		)
	end
	block(
		parent,
		"KioskCounter",
		Vector3.new(6.2, 2.4, 1),
		cf * CFrame.new(0, 1.6, -2.5),
		PAINT_WHITE,
		MAT.WoodPlanks,
		true
	)
	block(
		parent,
		"KioskCounterTop",
		Vector3.new(6.8, 0.3, 1.6),
		cf * CFrame.new(0, 2.95, -2.6),
		WOOD,
		MAT.WoodPlanks,
		true
	)
	block(parent, "KioskRoof", Vector3.new(8, 0.5, 7.2), cf * CFrame.new(0, 5.65, 0.1), CORAL, MAT.WoodPlanks, true)
	-- 차양: 앞으로 비스듬히 내려오는 줄무늬 다섯 조각
	for k = 0, 4 do
		local x = -3.2 + k * 1.6
		block(
			parent,
			"KioskAwning",
			Vector3.new(1.6, 0.15, 2.6),
			cf * CFrame.new(x, 5.1, -4) * CFrame.Angles(math.rad(-22), 0, 0),
			if k % 2 == 0 then CORAL else WHITE,
			MAT.Fabric
		)
	end
	-- 아이스크림 간판: 거꾸로 선 원뿔(원판 셋) + 공 둘
	local sign = cf * CFrame.new(0, 5.9, 0.5)
	for k, d in { 0.5, 1, 1.5 } do
		disc(
			parent,
			"IceCreamCone",
			(sign * CFrame.new(0, k * 0.6 - 0.6, 0)).Position,
			0.6,
			d,
			SUN:Lerp(WOOD, 0.4),
			MAT.WoodPlanks
		)
	end
	ball(parent, "IceCream", (sign * CFrame.new(0, 1.9, 0)).Position, 1.7, PINK)
	ball(parent, "IceCream", (sign * CFrame.new(0, 3.1, 0)).Position, 1.3, MINT)
	for _, x in { -1.8, 1.8 } do
		local p = cf * Vector3.new(x, 0, -5)
		local floor = groundAt(p.X, p.Z)
		disc(parent, "StoolLeg", Vector3.new(p.X, floor - 0.3, p.Z), 1.9, 0.25, IRON, MAT.Metal, true)
		disc(parent, "StoolSeat", Vector3.new(p.X, floor + 1.6, p.Z), 0.3, 1.2, CORAL, MAT.Fabric, true)
	end
end

-- 선베드 하나: 머리 쪽(head) → 발 쪽(foot) 땅을 따라 기울임. 틀 + 받침 + 등받이 + 쿠션
local function lounger(parent: Instance, head: Vector3, foot: Vector3, cushion: Color3)
	local h1 = Vector3.new(head.X, groundAt(head.X, head.Z) + 0.75, head.Z)
	local h2 = Vector3.new(foot.X, groundAt(foot.X, foot.Z) + 0.75, foot.Z)
	local cf = CFrame.lookAt((h1 + h2) / 2, h2, UP)
	local length = (h2 - h1).Magnitude
	block(parent, "LoungerFrame", Vector3.new(1.7, 0.3, length), cf, PAINT_WHITE, MAT.WoodPlanks, true)
	block(parent, "LoungerLegs", Vector3.new(1.3, 1.1, length - 0.8), cf * CFrame.new(0, -0.6, 0), WOOD_DARK, MAT.Wood)
	block(
		parent,
		"LoungerBack",
		Vector3.new(1.6, 0.3, 1.9),
		cf * CFrame.new(0, 0.6, length / 2 - 0.7) * CFrame.Angles(math.rad(40), 0, 0),
		PAINT_WHITE,
		MAT.WoodPlanks,
		true
	)
	block(
		parent,
		"LoungerCushion",
		Vector3.new(1.45, 0.2, length - 1.9),
		cf * CFrame.new(0, 0.24, -0.9),
		cushion,
		MAT.Fabric
	)
end

-- 파라솔 묶음: 줄무늬 파라솔 + 양옆 선베드 + 앞 수건. Turn = 바다 쪽(선베드가 바다를 봄)
function BUILD.BeachSet(parent: Instance, item)
	local base = basePoint(item)
	local color = CANVAS[(item.Style - 1) % #CANVAS + 1]
	local cf = heading(base, item.Turn)
	umbrella(parent, base, item.Turn, color)
	for _, side in { -1, 1 } do
		local head = cf * Vector3.new(side * 1.25, 0, 2.4)
		local foot = cf * Vector3.new(side * 1.25, 0, -2.2)
		lounger(parent, head, foot, if side < 0 then color else CANVAS[item.Style % #CANVAS + 1])
	end
	local towelCf = onGround(cf * CFrame.new(3.4, 0, -3.2) * CFrame.Angles(0, 0.35, 0), 1.1, 2)
	block(
		parent,
		"Towel",
		Vector3.new(2.2, 0.12, 4),
		towelCf * CFrame.new(0, 0.1, 0),
		CANVAS[(item.Style + 1) % #CANVAS + 1],
		MAT.Fabric
	)
	block(parent, "TowelStripe", Vector3.new(2.2, 0.14, 0.5), towelCf * CFrame.new(0, 0.11, 1.2), WHITE, MAT.Fabric)
end

-- 모래성: 모래 받침 + 모퉁이 탑 넷 + 가운데 큰 탑 + 깃발
function BUILD.Sandcastle(parent: Instance, item)
	local base = basePoint(item)
	local cf = CFrame.new(base) * CFrame.Angles(0, item.Turn, 0)
	block(parent, "Sandcastle", Vector3.new(3, 1, 3), cf * CFrame.new(0, 0.3, 0), SAND, MAT.Sand, true)
	for _, c in { { -1.3, -1.3 }, { 1.3, -1.3 }, { -1.3, 1.3 }, { 1.3, 1.3 } } do
		disc(parent, "SandTower", (cf * CFrame.new(c[1], 0.5, c[2])).Position, 1.2, 0.9, SAND, MAT.Sand)
	end
	disc(parent, "SandKeep", base + Vector3.new(0, 0.6, 0), 1.9, 1.6, SAND, MAT.Sand)
	disc(parent, "FlagPole", base + Vector3.new(0, 2.4, 0), 1.3, 0.1, WOOD_DARK, MAT.Wood)
	block(parent, "Flag", Vector3.new(0.05, 0.45, 0.7), cf * CFrame.new(0, 3.45, -0.35), CORAL, MAT.Fabric)
end

-- 동전 망원경(부지 뒤 바다 전망): 쇠 받침 + 기둥 + 머리 상자 + 바다 쪽으로 살짝 치켜든 통 + 눈대개. Turn = 바다 쪽
function BUILD.Telescope(parent: Instance, item)
	local base = basePoint(item)
	local cf = heading(base, item.Turn)
	disc(parent, "TelescopeFoot", base - Vector3.new(0, 0.2, 0), 0.5, 1.4, IRON, MAT.Metal, true)
	disc(parent, "TelescopePost", base, 3.5, 0.45, TEAL, MAT.Metal, true)
	block(parent, "TelescopeHead", Vector3.new(1, 1, 1.1), cf * CFrame.new(0, 3.9, 0), TEAL, MAT.Metal, true)
	local front = (cf * CFrame.new(0, 4.25, -1.9)).Position
	local back = (cf * CFrame.new(0, 3.75, 0.3)).Position
	rod(parent, "TelescopeTube", back, front, 0.75, SUN:Lerp(WOOD, 0.3), MAT.Metal, true)
	local eye = (cf * CFrame.new(0, 3.62, 1)).Position
	rod(parent, "TelescopeEye", back, eye, 0.4, IRON, MAT.Metal)
end

-- 서핑보드 거치대: 낮은 나무 받침 + 모래에 꽂혀 기운 보드 셋(판 + 둥근 끝 원판). 색이 다름. Turn = 보드 면이 보는 쪽
function BUILD.Surfboards(parent: Instance, item)
	local base = basePoint(item)
	local cf = heading(base, item.Turn)
	local colors = { CORAL, SUN, SKY, MINT }
	block(parent, "SurfRack", Vector3.new(5.2, 0.5, 1), cf * CFrame.new(0, 1.6, 0.9), WOOD, MAT.WoodPlanks, true)
	for _, x in { -2.3, 2.3 } do
		disc(parent, "SurfRackPost", (cf * CFrame.new(x, -0.4, 0.9)).Position, 2.3, 0.4, WOOD_DARK, MAT.Wood, true)
	end
	for k = 1, 3 do
		local x = (k - 2) * 1.7
		local board = cf * CFrame.new(x, 2, 0.35) * CFrame.Angles(math.rad(-14), 0, math.rad((k - 2) * 6))
		local color = colors[(k + item.Style) % #colors + 1]
		block(parent, "Surfboard", Vector3.new(1.4, 4.4, 0.22), board, color, MAT.SmoothPlastic, true)
		-- 둥근 끝(원판을 보드 면에 세움)
		part(
			parent,
			"SurfboardTip",
			Enum.PartType.Cylinder,
			Vector3.new(0.2, 1.4, 1.4),
			board * CFrame.new(0, 2.2, 0) * CFrame.Angles(0, math.rad(90), 0),
			color,
			MAT.SmoothPlastic
		)
		block(parent, "SurfboardStripe", Vector3.new(0.3, 4.1, 0.26), board, WHITE, MAT.SmoothPlastic)
	end
end

-- 떠밀려 온 나무(모래 위에 누운 줄기: 굵은 밑동 → 가는 끝 두 토막 + 뿌리 혹 + 곁가지 둘, 햇볕에 바랜 색). Turn = 누운 방향
function BUILD.Driftwood(parent: Instance, item)
	local s, base = item.Scale, basePoint(item)
	local dx, dz = math.cos(item.Turn), math.sin(item.Turn)
	local half = 2.6 * s
	local function onSand(x: number, z: number, lift: number): Vector3
		return Vector3.new(x, groundAt(x, z) + lift, z)
	end
	local a = onSand(base.X - dx * half, base.Z - dz * half, 0.25 * s)
	local b = onSand(base.X + dx * half, base.Z + dz * half, 0.18 * s)
	local mid = a:Lerp(b, 0.45) + Vector3.new(0, 0.05 * s, 0)
	local bleached = rgb(196, 180, 154)
	rod(parent, "Driftwood", a, mid, 0.8 * s, bleached, MAT.Wood, true)
	rod(parent, "Driftwood", mid, b, 0.55 * s, bleached:Lerp(WOOD_LIGHT, 0.2), MAT.Wood, true)
	ball(parent, "Driftwood", a - Vector3.new(dx, 0, dz) * 0.2 * s, 1.05 * s, bleached:Lerp(WOOD_DARK, 0.15), MAT.Wood)
	for k, t in { 0.35, 0.7 } do
		local from = a:Lerp(b, t)
		local side = if k == 1 then 1 else -1
		local to = from
			+ Vector3.new(
				-dz * side * 1.5 * s + dx * 0.7 * s,
				(0.45 - 0.15 * k) * s,
				dx * side * 1.5 * s + dz * 0.7 * s
			)
		rod(parent, "Driftwood", from, to, (0.34 - 0.06 * k) * s, bleached:Lerp(WOOD_DARK, 0.1 * k), MAT.Wood)
	end
end

-- 수영 구역 부표: 반쯤 잠긴 공 + 작은 꼭지(빨강/하양)
function BUILD.Buoy(parent: Instance, item)
	local base = basePoint(item)
	local color = if item.Style == 1 then CORAL else WHITE
	ball(parent, "Buoy", base + Vector3.new(0, 0.15, 0), 1.3, color)
	disc(parent, "BuoyTop", base + Vector3.new(0, 0.6, 0), 0.7, 0.3, if item.Style == 1 then WHITE else CORAL)
end

-- 돛단배: 배 몸통 + 뾰족한 뱃머리(쐐기 둘) + 테두리 + 돛대 + 큰 돛 + 앞 돛 + 깃발. Turn = 뱃머리 쪽, Scale = 크기
function BUILD.Boat(parent: Instance, item)
	local s = item.Scale
	local cf = heading(basePoint(item), item.Turn)
	local function at(x: number, y: number, z: number): CFrame
		return cf * CFrame.new(x * s, y * s, z * s)
	end
	local hull = if item.Tint < 0.4 then WHITE elseif item.Tint < 0.7 then CORAL else SKY
	local trim = if hull == SKY then WHITE else SKY
	block(parent, "BoatHull", Vector3.new(3.2, 1.3, 5.2) * s, at(0, 0.1, 0.8), hull, MAT.WoodPlanks)
	for _, side in { -1, 1 } do
		-- 쐐기를 Z 축으로 눕혀서(쐐기 +Y → 바깥 옆) 위에서 보면 삼각형(뱃머리 반쪽, 끝이 가운데 앞)
		wedge(
			parent,
			"BoatBow",
			Vector3.new(1.3, 1.6, 2.6) * s,
			at(side * 0.8, 0.1, -3.1) * CFrame.Angles(0, 0, -side * math.rad(90)),
			hull,
			MAT.WoodPlanks
		)
	end
	block(parent, "BoatRim", Vector3.new(3.3, 0.25, 5.3) * s, at(0, 0.8, 0.8), trim, MAT.Wood)
	disc(parent, "BoatMast", at(0, 0.75, 0).Position, 7 * s, 0.3 * s, WOOD_DARK, MAT.Wood)
	local sail = if item.Style == 3 then SUN:Lerp(WHITE, 0.4) else WHITE
	wedge(
		parent,
		"BoatSail",
		Vector3.new(0.12, 5.6, 3.6) * s,
		at(0, 4.2, 1.9) * CFrame.Angles(0, math.pi, 0),
		sail,
		MAT.Fabric
	)
	wedge(
		parent,
		"BoatJib",
		Vector3.new(0.12, 4.2, 2.4) * s,
		at(0, 3.4, -1.3),
		if item.Style == 2 then CORAL else SKY,
		MAT.Fabric
	)
	block(parent, "BoatFlag", Vector3.new(0.06, 0.5, 0.9) * s, at(0, 7.9, 0.45), CORAL, MAT.Fabric)
end

Props.BUILD = BUILD

-- item 하나 만들기. 모르는 종류면 false
function Props.build(parent: Instance, item): boolean
	local build = BUILD[item.Kind]
	if not build then
		return false
	end
	castShadow = SHADOW_KINDS[item.Kind] == true
	build(parent, item)
	castShadow = false
	return true
end

-- 곧은 길 조각(Plan.Segment 모양): 윗면 Top, 두께 height. solid 면 걸을 수 있음
function Props.segment(
	parent: Instance,
	name: string,
	segment,
	height: number,
	color: Color3,
	material: Enum.Material,
	solid: boolean?
): Part
	local a = Vector3.new(segment.X1, segment.Top - height / 2, segment.Z1)
	local b = Vector3.new(segment.X2, segment.Top - height / 2, segment.Z2)
	local length = (b - a).Magnitude
	return block(
		parent,
		name,
		Vector3.new(segment.Width, height, length),
		CFrame.lookAt((a + b) / 2, b),
		color,
		material,
		solid
	)
end

-- 둥근 판(광장 원판): 윗면 top
function Props.disc(
	parent: Instance,
	name: string,
	x: number,
	z: number,
	radius: number,
	top: number,
	height: number,
	color: Color3,
	material: Enum.Material,
	solid: boolean?
): Part
	return disc(parent, name, Vector3.new(x, top - height, z), height, radius * 2, color, material, solid)
end

return Props
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">Rng</string>
            <string name="Source"><![CDATA[--!strict
-- 풍경 배치용 고정 시드 난수(순수 Luau). Roblox 의 Random 과 같은 모양(NextNumber / NextInteger)이지만
-- 알고리즘을 직접 갖고 있어서 Roblox 밖의 미리보기 도구(가짜 환경)에서도 게임과 똑같은 배치가 나옵니다.
-- 선형 합동 생성기(mod 2^32). 곱이 2^53 보다 작아서 실수 계산으로도 정확합니다.

local MODULUS = 4294967296 -- 2^32
local MULTIPLIER = 1664525
local INCREMENT = 1013904223

export type Rng = {
	State: number,
	NextNumber: (self: Rng, min: number?, max: number?) -> number,
	NextInteger: (self: Rng, min: number, max: number) -> number,
	Pick: <T>(self: Rng, list: { T }) -> T,
	Sign: (self: Rng) -> number,
}

local Rng = {}

local function step(self: Rng): number
	self.State = (self.State * MULTIPLIER + INCREMENT) % MODULUS
	return self.State / MODULUS
end

-- [min, max) 실수. 인자가 없으면 [0, 1)
local function nextNumber(self: Rng, min: number?, max: number?): number
	local value = step(self)
	if min and max then
		return min + (max - min) * value
	end
	return value
end

-- [min, max] 정수
local function nextInteger(self: Rng, min: number, max: number): number
	return math.min(max, min + math.floor(step(self) * (max - min + 1)))
end

local function pick<T>(self: Rng, list: { T }): T
	return list[nextInteger(self, 1, #list)]
end

-- -1 또는 1
local function sign(self: Rng): number
	return if step(self) < 0.5 then -1 else 1
end

function Rng.new(seed: number): Rng
	local self: Rng = {
		State = math.floor(math.abs(seed)) % MODULUS,
		NextNumber = nextNumber,
		NextInteger = nextInteger,
		Pick = pick,
		Sign = sign,
	}
	-- 비슷한 시드끼리 첫 값이 닮지 않게 몇 번 섞어 둠
	for _ = 1, 4 do
		step(self)
	end
	return self
end

return Rng
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="35">
        <Properties>
          <string name="Name">World</string>
          <string name="Source"><![CDATA[-- 광장(스폰) + 받침대 위의 거대 지구본 + 광장 둘레 나무 + 뉴스 속보 홀로그램
-- 회전은 클라이언트가 "LandmarkSpin" 태그가 붙은 Model 을 제자리에서 돌려서 보여 줍니다(서버 복제 부담 없음).
-- 홀로그램 제목은 글자 최소: "속보!" 딱지 + 명소 이름. Shared/ImageIds.news 그림이 있으면 딱지 옆에 신문 아이콘.

local CollectionService = game:GetService("CollectionService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Landmarks = require(Shared.Landmarks)
local Models = require(Shared.Models)
local Props = require(script.Parent.Scenery.Props)

-- 그림 Id 표 (없거나 깨져도 코드로 그린 모양으로 동작)
local function loadImageIds(): { [string]: any }
	local module = Shared:FindFirstChild("ImageIds")
	if module and module:IsA("ModuleScript") then
		local ok, result = pcall(require, module)
		if ok and type(result) == "table" then
			return result
		end
	end
	return {}
end
local ImageIds = loadImageIds()

-- 그림 Id ("rbxassetid://...") 또는 nil
local function imageId(name: string): string?
	local value = ImageIds[name]
	if type(value) == "number" then
		return "rbxassetid://" .. tostring(value)
	elseif type(value) == "string" and value ~= "" then
		return if value:match("^%d+$") then "rbxassetid://" .. value else value
	end
	return nil
end

local SPIN_TAG = "LandmarkSpin"

local PLAZA_RADIUS = 45
local PLAZA_TOP = 1 -- 광장 윗면 높이. 스폰 지점(두께 1)이 이 위에 놓임
local RIM_WIDTH = 3 -- 광장 둘레의 낮은 계단(윗면 0.5)
local EARTH_SPOT = Vector3.new(0, PLAZA_TOP, -26) -- 지구본 받침대 바닥 중앙(스폰 정면 = -Z)
local EARTH_SIZE = 26
local EARTH_FACING = 175 -- 지구본 처음 방향(수직축, 도): 스폰에서 아프리카가 보임(아래 PivotTo 참고)
local LAMP_COUNT = 16
local LAMP_RADIUS = PLAZA_RADIUS - 3
local TREE_COUNT = 8
local TREE_RADIUS = PLAZA_RADIUS + RIM_WIDTH + 8 -- 광장 둘레 계단 바로 바깥 잔디
local TREE_SCALE = 1.2 -- 풍경 넓은잎나무 Scale(1 = 높이 약 11) → 예전 광장 나무 높이(약 13)

local HOLOGRAM_SIZE = 60
local HOLOGRAM_HEIGHT = 60 -- 홀로그램 바닥 높이(지구본과 겹치면 그 위로 올림)
local HOLOGRAM_LIFETIME = 12
local HOLOGRAM_TRANSPARENCY = 0.35
local TITLE_WIDTH = 80 -- 홀로그램 제목 크기(스터드)
local TITLE_HEIGHT = 20

local PLAZA_COLOR = Color3.fromRGB(234, 224, 202) -- 따뜻한 크림색 포석(Pavement)
local RIM_COLOR = Color3.fromRGB(184, 170, 148) -- 둘레 계단(돌길 Cobblestone)
local STONE_DARK = Color3.fromRGB(70, 74, 88)
local MARBLE = Color3.fromRGB(240, 238, 232)
local GOLD = Color3.fromRGB(235, 190, 80)
local LAMP_POLE = Color3.fromRGB(46, 86, 66) -- 짙은 초록(풍경 정원등과 같은 색)
local LAMP_LIGHT = Color3.fromRGB(255, 235, 190)

-- UI 스타일 가이드 v2 팔레트(홀로그램 제목)
local INK = Color3.fromRGB(30, 27, 46)
local WHITE = Color3.new(1, 1, 1)
local CORAL = Color3.fromRGB(255, 94, 91)
local CORAL_SHADOW = Color3.fromRGB(201, 58, 56)

-- 원기둥 파트는 X 축이 기둥 방향이므로 세우려면 Z 축으로 90도 돌림
local UPRIGHT = CFrame.Angles(0, 0, math.rad(90))

local World = {}

local folder: Folder? = nil
local earthTop = PLAZA_TOP + EARTH_SIZE -- 지구본 꼭대기 높이(모형을 만든 뒤 실제 값으로 바뀜)
local hologram: Model? = nil

local function newPart(
	parent: Instance,
	name: string,
	shape: Enum.PartType,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material
): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Shape = shape
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

-- bottom(바닥 중앙)에서 위로 height 만큼 세운 원기둥
local function disc(
	parent: Instance,
	name: string,
	bottom: Vector3,
	height: number,
	diameter: number,
	color: Color3,
	material: Enum.Material
): Part
	return newPart(
		parent,
		name,
		Enum.PartType.Cylinder,
		Vector3.new(height, diameter, diameter),
		CFrame.new(bottom + Vector3.new(0, height / 2, 0)) * UPRIGHT,
		color,
		material
	)
end

local function lamp(parent: Instance, base: Vector3)
	local pole = newPart(
		parent,
		"LampPost",
		Enum.PartType.Block,
		Vector3.new(0.6, 9, 0.6),
		CFrame.new(base + Vector3.new(0, 4.5, 0)),
		LAMP_POLE,
		Enum.Material.Metal
	)
	pole.CastShadow = false
	local bulb = newPart(
		parent,
		"LampBulb",
		Enum.PartType.Ball,
		Vector3.new(1.8, 1.8, 1.8),
		CFrame.new(base + Vector3.new(0, 9.6, 0)),
		LAMP_LIGHT,
		Enum.Material.Neon
	)
	bulb.CanCollide = false
	bulb.CastShadow = false
	local light = Instance.new("PointLight")
	light.Color = LAMP_LIGHT
	light.Range = 18
	light.Brightness = 1.2
	light.Parent = bulb
end

-- 광장 둘레 나무: 섬 풍경의 넓은잎나무와 같은 모양(Scenery/Props 의 Tree — 살짝 기운 두 마디 줄기 + 가지 +
-- 짙은·보통·밝은 초록 잎 공 여러 개). 줄기는 부딪히고 잎은 충돌·검색 없음(머리·카메라에 걸리지 않게).
-- scale 로 크기(1 = 예전 나무 높이 약 13), turn(라디안) = 기우는 쪽(광장 바깥으로).
-- 밝은 잎 공은 광장 가운데 쪽(Face)으로 — 광장에서 보면 나무마다 짙은 공이 앞에 오던 것
local function tree(parent: Instance, base: Vector3, scale: number, turn: number)
	Props.build(parent, {
		Kind = "Tree",
		X = base.X,
		Y = base.Y,
		Z = base.Z,
		Scale = scale * TREE_SCALE,
		Turn = turn,
		Face = turn + math.pi,
		Tint = 0.4,
		Style = 1,
	})
end

-- 서버 시작 시 한 번: 광장, 가로등, 둘레 나무, 받침대 + 거대 지구본
function World.build()
	if folder then
		return
	end
	local world = Instance.new("Folder")
	world.Name = "World"
	folder = world

	-- 광장: 둘레 계단(윗면 0.5) 위에 광장(윗면 1). 한 번에 0.5 씩이라 걸어서 오를 수 있음
	disc(
		world,
		"PlazaRim",
		Vector3.zero,
		PLAZA_TOP / 2,
		(PLAZA_RADIUS + RIM_WIDTH) * 2,
		RIM_COLOR,
		Enum.Material.Cobblestone
	)
	disc(world, "Plaza", Vector3.zero, PLAZA_TOP, PLAZA_RADIUS * 2, PLAZA_COLOR, Enum.Material.Pavement)

	-- 가로등: 공원으로 가는 길(22.5도 간격) 사이사이에
	for i = 1, LAMP_COUNT do
		local angle = (i - 0.5) / LAMP_COUNT * math.pi * 2
		lamp(world, Vector3.new(math.cos(angle) * LAMP_RADIUS, PLAZA_TOP, math.sin(angle) * LAMP_RADIUS))
	end

	-- 나무: 광장 바로 바깥 잔디, 길(22.5도마다) 사이 틈 하나 건너 하나에(가로등 바로 뒤)
	for i = 1, TREE_COUNT do
		local angle = (i - 0.75) / TREE_COUNT * math.pi * 2 -- 11.25도 + 45도 간격
		local base = Vector3.new(math.cos(angle) * TREE_RADIUS, 0, math.sin(angle) * TREE_RADIUS)
		tree(world, base, if i % 2 == 0 then 1 else 0.85, angle)
	end

	-- 지구본 받침대
	disc(world, "PedestalBase", EARTH_SPOT, 1.5, 18, STONE_DARK, Enum.Material.Slate)
	disc(world, "PedestalColumn", EARTH_SPOT + Vector3.new(0, 1.5, 0), 5, 10, MARBLE, Enum.Material.Marble)
	disc(world, "PedestalTop", EARTH_SPOT + Vector3.new(0, 6.5, 0), 1, 15, GOLD, Enum.Material.Metal)
	local pedestalTop = EARTH_SPOT.Y + 7.5

	-- 거대 지구본 (모형 코드에 문제가 있어도 광장은 만들어지도록 pcall)
	local ok, err = pcall(function()
		local earth = Models.create(Landmarks.Globe, EARTH_SIZE)
		earth.Name = "Earth"
		-- 처음(클라이언트가 돌리기 전) 스폰 쪽(+Z)으로 경도 25도(아프리카)가 보이게(태평양만 보이지 않게).
		-- 모형 정면(-Z)은 경도 20도라 경도 L 이 +Z 를 보려면 수직축으로 200 - L 도
		earth:PivotTo(CFrame.new(EARTH_SPOT.X, pedestalTop, EARTH_SPOT.Z) * CFrame.Angles(0, math.rad(EARTH_FACING), 0))
		earthTop = pedestalTop + earth:GetExtentsSize().Y
		-- 보기만 하는 장식: 광선·닿음 검사에서 빼서(충돌은 Models.create 가 이미 끔) 매 프레임 돌릴 때 부담을 줄임
		for _, part in earth:GetDescendants() do
			if part:IsA("BasePart") then
				part.CanQuery = false
				part.CanTouch = false
			end
		end
		CollectionService:AddTag(earth, SPIN_TAG)
		-- 스트리밍이 켜져 있어도 통째로 내려받게 해야 클라이언트 회전 때 일부 파트만 어긋나지 않음
		earth.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
		earth.Parent = world
	end)
	if not ok then
		warn("[World] 지구본 모형을 만들지 못했습니다: " .. tostring(err))
	end

	world.Parent = Workspace
end

-- 광장으로 순간이동할 때 캐릭터 피벗(HumanoidRootPart) 위치: 스폰 바로 앞에서 지구본을 바라봄
function World.plazaCFrame(): CFrame
	local position = Vector3.new(0, PLAZA_TOP + 3.5, 10)
	return CFrame.lookAt(position, Vector3.new(EARTH_SPOT.X, position.Y, EARTH_SPOT.Z))
end

-- 통통한 상자: 둥근 모서리 + Ink 테두리. position 은 윗변 가운데
local function chunkyBox(
	parent: Instance,
	name: string,
	size: UDim2,
	position: UDim2,
	color: Color3,
	zIndex: number
): Frame
	local box = Instance.new("Frame")
	box.Name = name
	box.AnchorPoint = Vector2.new(0.5, 0)
	box.Size = size
	box.Position = position
	box.BackgroundColor3 = color
	box.BorderSizePixel = 0
	box.ZIndex = zIndex
	local round = Instance.new("UICorner")
	round.CornerRadius = UDim.new(0.3, 0)
	round.Parent = box
	local line = Instance.new("UIStroke")
	line.Thickness = 5
	line.Color = INK
	line.Parent = box
	box.Parent = parent
	return box
end

-- 위쪽이 살짝 밝은 그라데이션
local function shine(box: Frame)
	local gradient = Instance.new("UIGradient")
	gradient.Color = ColorSequence.new(WHITE, Color3.fromRGB(214, 214, 214))
	gradient.Rotation = 90 -- 위 → 아래
	gradient.Parent = box
end

-- 흰 LuckiestGuy 글자 + 굵은 Ink 글자 테두리
local function bigText(parent: Frame, text: string, thickness: number)
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.LuckiestGuy
	label.TextScaled = true
	label.Text = text
	label.TextColor3 = WHITE
	local line = Instance.new("UIStroke")
	line.Thickness = thickness
	line.Color = INK
	line.Parent = label
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0.05, 0)
	pad.PaddingRight = UDim.new(0.05, 0)
	pad.PaddingTop = UDim.new(0.16, 0)
	pad.PaddingBottom = UDim.new(0.16, 0)
	pad.Parent = label
	label.Parent = parent
end

-- 홀로그램 제목: 빨간 "속보!" 딱지(살짝 기울임) + 등급 색 리본 위에 명소 이름
local function titleBillboard(parent: BasePart, landmark: Landmarks.Landmark)
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "Title"
	billboard.Adornee = parent
	billboard.Size = UDim2.fromScale(TITLE_WIDTH, TITLE_HEIGHT)
	billboard.StudsOffset = Vector3.new(0, 2 - TITLE_HEIGHT / 2, 0) -- 윗변이 기준점 조금 위, 나머지는 아래로
	billboard.LightInfluence = 0
	billboard.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

	local text = landmark.Name
	-- 리본 너비: 글자 수 × 글자 높이(약 8.6 스터드) + 여백
	local chars = utf8.len(text) or #text
	local ribbonWidth = math.clamp((chars * 8.6 + 12) / TITLE_WIDTH, 0.4, 1)
	local ribbonSize = UDim2.fromScale(ribbonWidth, 0.6)
	local tier = landmark.Tier.Color
	chunkyBox(billboard, "RibbonShadow", ribbonSize, UDim2.fromScale(0.5, 0.36), tier:Lerp(INK, 0.4), 1)
	local ribbon = chunkyBox(billboard, "Ribbon", ribbonSize, UDim2.fromScale(0.5, 0.3), tier, 2)
	shine(ribbon)
	bigText(ribbon, text, 6)

	local tagSize = UDim2.fromScale(0.24, 0.3)
	local tagShadow = chunkyBox(billboard, "TagShadow", tagSize, UDim2.fromScale(0.5, 0.05), CORAL_SHADOW, 3)
	local tag = chunkyBox(billboard, "Tag", tagSize, UDim2.fromScale(0.5, 0.02), CORAL, 4)
	tagShadow.Rotation = -4
	tag.Rotation = -4
	shine(tag)
	bigText(tag, "속보!", 4)

	local newsId = imageId("news")
	if newsId then
		-- 딱지 왼쪽에 신문 아이콘(딱지보다 조금 크게)
		local news = Instance.new("ImageLabel")
		news.Name = "NewsIcon"
		news.BackgroundTransparency = 1
		news.Image = newsId
		news.ScaleType = Enum.ScaleType.Fit
		news.SizeConstraint = Enum.SizeConstraint.RelativeYY
		news.Size = UDim2.fromScale(1.4, 1.4)
		news.AnchorPoint = Vector2.new(0.75, 0.5)
		news.Position = UDim2.fromScale(0, 0.5)
		news.Rotation = -10
		news.ZIndex = 5
		news.Parent = tag
	end

	billboard.Parent = parent
end

-- 광장 하늘에 거대한 반투명 홀로그램(한 번에 하나, 12초 뒤 사라짐)
function World.hologram(landmark: Landmarks.Landmark)
	if hologram then
		hologram:Destroy()
		hologram = nil
	end

	local ok, result = pcall(Models.create, landmark, HOLOGRAM_SIZE)
	if not ok then
		warn("[World] 홀로그램 모형을 만들지 못했습니다: " .. tostring(result))
		return
	end
	local model = result :: Model
	model.Name = "Hologram"
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			-- 원래 투명한 파트(Root 등)는 그대로 두고, 보이는 파트만 색은 유지한 채 홀로그램 재질로
			if descendant.Transparency < 1 then
				descendant.Transparency = math.max(descendant.Transparency, HOLOGRAM_TRANSPARENCY)
				descendant.Material = Enum.Material.ForceField
			end
			descendant.Anchored = true
			descendant.CanCollide = false
			descendant.CanQuery = false
			descendant.CanTouch = false
			descendant.CastShadow = false
		end
	end

	local bottom = math.max(HOLOGRAM_HEIGHT, earthTop + 10)
	model:PivotTo(CFrame.new(0, bottom, 0))

	-- 제목은 홀로그램 바로 아래(땅에서 올려다볼 때 잘 보이게). 회전축 위에 있어서 돌려도 제자리
	local anchor = Instance.new("Part")
	anchor.Name = "TitleAnchor"
	anchor.Size = Vector3.new(1, 1, 1)
	anchor.CFrame = CFrame.new(0, bottom - 5, 0)
	anchor.Transparency = 1
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Parent = model
	titleBillboard(anchor, landmark)

	CollectionService:AddTag(model, SPIN_TAG)
	model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	model.Parent = folder or Workspace
	hologram = model

	task.delay(HOLOGRAM_LIFETIME, function()
		if hologram == model then
			hologram = nil
		end
		model:Destroy()
	end)
end

return World
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="36">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="37">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="38">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[-- 클라이언트 진입점: 상태 동기화, 굴리기/자동 굴리기, 메뉴 연결, 뉴스 속보, 회전 모형,
-- 환생 · Robux 상품 구매 요청 · 서버 행운 알림 (DESIGN.md v3), 3D 공원 배치 모드(ParkEdit: 내 공원에서 명소를
-- 직접 집어 옮김 — 여기서는 서버 요청·알림·HUD 연결만)
-- (화면 글자에는 이모지를 쓰지 않음 — DESIGN.md UI 스타일 가이드 v2)
-- 알림은 [아이콘] + 8글자 안팎 ("구매 완료", "코인 부족", "대표 지정"), 문장은 쓰지 않음

local CollectionService = game:GetService("CollectionService")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TextChatService = game:GetService("TextChatService")
local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Format = require(Shared.Format)
local Landmarks = require(Shared.Landmarks)
local Net = require(Shared.Net)
local PlayerState = require(Shared.PlayerState)

local Hud = require(script.Hud)
local Icons = require(script.Icons)
local Panels = require(script.Panels)
local ParkEdit = require(script.ParkEdit)
local Perks = require(script.Perks)
local Ui = require(script.Ui)

local SPIN_TAG = "LandmarkSpin"
local SPIN_SPEED = math.rad(20) -- 태그 붙은 모형(광장 지구본, 홀로그램)의 초당 회전 각도

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local state: PlayerState.Snapshot? = nil -- 서버에서 받은 최신 Snapshot
local stateReceivedAt = 0
local deferredState: { Snapshot: any, ReceivedAt: number }? = nil -- 연출 중에 도착한 재동기화 상태
local rolling = false
local revealing = false
local autoRoll = false -- AUTO 켬(플레이어가 고른 것 — 굴리기 줄 [AUTO] · T 키)
-- 3D 배치 모드 동안 자동 굴리기는 쉼(나가면 AUTO 가 켜져 있으면 다시 돎): 배치 띠에는 이미 [자동](자동 배치)이 있어서
-- 자동 굴리기 스위치를 하나 더 두면 아이들이 헷갈리고, 쉬는 동안은 새 명소가 빈 칸에 들어와 들고 있는 칸이 바뀌지도 않음
local autoPaused = false
-- 마지막 굴림을 보낸 시각(다음 굴림은 이 시각 + 굴림 간격부터). 굴림 간격을 기다렸다 보냈으면 "원래 보낼 수 있던 시각"
-- (task.wait 는 다음 프레임에 깨서 조금 늦음 — 그 늦음이 굴림마다 쌓여 AUTO 가 굴림 간격보다 느려지지 않게)
local lastRollSentAt = -math.huge
local SEND_SLACK = 0.05 -- 기다림이 이만큼(프레임 몇 개) 늦게 끝난 것까지는 원래 시각으로 침
local heldAnnouncements = {} -- 내 굴림 연출 중에 도착한 "내" 속보 (연출이 끝나면 표시)
local location = "Plaza" -- 지금 있는 곳: "Plaza" | "Park"
local teleporting = false
local rebirthing = false

local function currentCoins(): number
	if not state then
		return 0
	end
	return state.Coins + state.Income * math.max(0, time() - stateReceivedAt)
end

-- 자동 발견으로 도감에 새로 들어온 명소 수: 서버는 확률(1/N)이 영구 행운 이하인 명소를 발견으로 침(PlayerState.autoDiscover —
-- 환생·지구본·도장으로 행운이 오르면 그보다 흔한 명소는 굴림에서 다시 안 나옴). 클라이언트는 직접 계산하지 않고 서버가 보낸
-- Discovered 를 그대로 씀(도감·도장 숫자가 서버와 같음). 굴려서 얻은 명소(보유)는 연출이 이미 보여 줬으니 뺌
local function autoDiscovered(before: PlayerState.Snapshot, after: PlayerState.Snapshot): number
	local count = 0
	for _, landmark in Landmarks.List do
		local id = landmark.Id
		if
			PlayerState.isDiscovered(after, id)
			and not PlayerState.isDiscovered(before, id)
			and (after.Inventory[id] or 0) <= 0
		then
			count += 1
		end
	end
	return count
end

-- 새로 받은 대륙 도장(Landmarks.Regions 순서). 도장 규칙은 PlayerState.completedRegions 그대로(서버 Discovered 기준)
local function newStamps(before: PlayerState.Snapshot, after: PlayerState.Snapshot): { Landmarks.Region }
	local had = {}
	for _, id in PlayerState.completedRegions(before) do
		had[id] = true
	end
	local added = {}
	for _, id in PlayerState.completedRegions(after) do
		local region = Landmarks.RegionById[id]
		if region and not had[id] then
			table.insert(added, region)
		end
	end
	return added
end

-- 도감을 그 대륙 탭으로 열기(도장 알림을 눌렀을 때). 배치 모드면 먼저 나감(다른 창을 열 때와 같게)
local function openStampRegion(regionId: string)
	ParkEdit.exit()
	Panels.open("Collection", regionId)
end

-- 서버 상태 반영. Revision 이 더 큰 것만 받아서 늦게 도착한 옛 상태가 덮어쓰지 않게 함.
-- receivedAt: 스냅샷을 실제로 받은 시각(코인 표시 기준). 늦게 반영할 때 넘겨줌.
local function applyState(snapshot: any, receivedAt: number?)
	if type(snapshot) ~= "table" or type(snapshot.Revision) ~= "number" then
		return
	end
	if state and snapshot.Revision <= state.Revision then
		return
	end
	local previous = state
	state = snapshot
	stateReceivedAt = receivedAt or time()
	Hud.render(snapshot, stateReceivedAt)
	Hud.setCoins(currentCoins())
	Panels.render(snapshot)
	ParkEdit.render(snapshot)
	-- 자동 발견: [도감] "도감 +12" (환생 직후처럼 행운이 크게 오를 때 도감 숫자가 왜 늘었는지)
	local added = if previous then autoDiscovered(previous, snapshot) else 0
	if added > 0 then
		Hud.toast("도감 +" .. added, Ui.colorPair("Sky").Face, 3, "album")
	end
	-- 대륙 도장을 새로 받음(굴림 연출이 끝난 뒤 · 자동 발견): [도장 그림] "도장 +25%" — 누르면 도감의 그 대륙 탭
	if previous then
		for _, region in newStamps(previous, snapshot) do
			Hud.stampToast(region, function()
				openStampRegion(region.Id)
			end)
		end
	end
end

-- 서버가 보내는 재동기화. 내 굴림 연출 중이면 결과가 미리 보이지 않게 연출이 끝난 뒤 반영
local function onStateEvent(snapshot: any)
	if type(snapshot) ~= "table" or type(snapshot.Revision) ~= "number" then
		return
	end
	if revealing then
		if not deferredState or snapshot.Revision > deferredState.Snapshot.Revision then
			deferredState = { Snapshot = snapshot, ReceivedAt = time() }
		end
		return
	end
	applyState(snapshot)
end

-- 원격 찾기. 서버가 아직 모르는 원격(예: 옛 서버에 Rebirth 가 없음)이면 영원히 기다리지 않고 nil
local remoteFolder: Instance? = nil
local function findRemote(name: string, seconds: number): Instance?
	if not remoteFolder then
		remoteFolder = Net.fn("GetState").Parent
	end
	local folder = remoteFolder
	if not folder then
		return nil
	end
	return folder:FindFirstChild(name) or folder:WaitForChild(name, seconds)
end

local function invoke(name: string, ...: any): any
	local remote = findRemote(name, 5)
	if not remote or not remote:IsA("RemoteFunction") then
		warn("[LandmarkRNG] 원격 없음: " .. name)
		Hud.toast("연결 오류", Ui.Theme.Bad, nil, "close")
		return nil
	end
	local ok, result = pcall(remote.InvokeServer, remote, ...)
	if not ok then
		warn("[LandmarkRNG] " .. name .. " 실패: " .. tostring(result))
		Hud.toast("연결 오류", Ui.Theme.Bad, nil, "close")
		return nil
	end
	return result
end

local function feature(landmarkId: string?)
	local response = invoke("Feature", landmarkId)
	if type(response) ~= "table" then
		return
	end
	applyState(response.State)
	if not response.Ok then
		Hud.toast("지정 실패", Ui.Theme.Bad, 2, "close")
	elseif landmarkId then
		local landmark = Landmarks.ById[landmarkId]
		if landmark then
			Hud.toast("대표 지정", landmark.Tier.Color, 2, "star")
		end
	else
		Hud.toast("대표 해제", Ui.Theme.Ink, 2, "star_empty")
	end
end

local function showAnnouncement(info: any, landmark: Landmarks.Landmark)
	local name = tostring(info.Name)
	Hud.news(name, landmark, tonumber(info.Rolls) or 0)

	-- 채팅창에도 시스템 메시지 (새 TextChatService 를 쓰는 경우)
	pcall(function()
		local channels = TextChatService:FindFirstChild("TextChannels")
		local general = channels and channels:FindFirstChild("RBXGeneral")
		if general then
			general:DisplaySystemMessage(
				string.format(
					'[속보] %s · <font color="%s"><b>%s</b></font> · %s · #%s',
					Format.escape(name),
					Format.hex(landmark.Tier.Color),
					Format.escape(landmark.Name),
					Format.oneIn(landmark.OneIn),
					Format.commas(tonumber(info.Rolls) or 0)
				)
			)
		end
	end)
end

-- 직접 배치 중 이번 판에 처음 얻은 명소가 공원이 꽉 차서 전시되지 못했으면 연출이 끝난 뒤 "공원 꽉 참" 알림
-- (더 좋은 명소면 [배치] 버튼 숫자 배지도 늘어 있음)
local function parkFullNotice(landmark: Landmarks.Landmark)
	local current = state
	if current and PlayerState.missedByFullPark(current, landmark.Id) then
		Hud.toast("공원 꽉 참", Ui.Theme.Gold, 3, "park")
	end
end

-- 더 희귀한 명소를 발견했으면 자동으로 대표 지정 (설정이 켜져 있을 때)
local function autoFeature(landmark: Landmarks.Landmark)
	local current = state
	if not current or not current.Settings.AutoFeature then
		return
	end
	local featured = if current.Featured then Landmarks.ById[current.Featured] else nil
	if not featured or landmark.OneIn > featured.OneIn then
		feature(landmark.Id)
	end
end

-- fromAuto: 자동 굴리기가 부른 굴림(자동 루프 · AUTO 켜기). 굴림 간격을 기다리는 동안 AUTO 를 끄거나 배치 모드에
-- 들어가면 요청을 보내지 않고 그만둠(끈 뒤에 굴림이 하나 더 나가 원래 길이 연출이 뜨지 않게). 그 사이 [굴리기]·R 을
-- 눌렀으면(manualAsked) 그만두지 않고 그 굴림으로 보냄
local manualAsked = false
local function roll(fromAuto: boolean?)
	if rolling or not state then
		if rolling and not fromAuto then
			manualAsked = true
		end
		return
	end
	rolling = true
	manualAsked = false
	Hud.setRolling(true)

	-- 쿨타임이 남았으면 기다렸다가 요청. 자동 굴림은 연출이 끝나면 바로 여기로 돌아와 남은 굴림 간격(Cooldown)만 기다림
	-- (서버가 거절하면 RetryIn). 이미 발견한 명소는 AUTO 에서 결과 카드만 퐁 하고 기다리지 않으므로(Hud.reveal 빠른 결과 —
	-- Config.AUTO_QUICK_REVEAL) AUTO 속도 = 서버 굴림 간격(여행사·빠른 굴림). 기다렸으면 기준은 원래 보낼 수 있던 시각이라
	-- 평균 간격이 굴림 간격 그대로(프레임 늦음이 쌓이지 않음). 서버는 허용 오차 안에서 받음(RollLogic.cooldownGate)
	local readyAt = lastRollSentAt + (state :: PlayerState.Snapshot).Cooldown
	local waitFor = readyAt - time()
	if waitFor > 0 then
		task.wait(waitFor)
	end
	if fromAuto and not manualAsked and (not autoRoll or autoPaused) then
		rolling = false
		Hud.setRolling(false)
		return
	end
	local now = time()
	lastRollSentAt = if waitFor > 0 then math.max(readyAt, now - SEND_SLACK) else now
	-- 빠른 결과(AUTO)인지는 보낼 때 정함: 응답을 기다리는 사이 AUTO 를 꺼도 이 결과는 AUTO 결과(이미 발견 = 카드만 퐁)
	local fast = autoRoll and not autoPaused
	local response = invoke("Roll")
	local receivedAt = time()

	local landmark = if type(response) == "table" and response.Ok then Landmarks.ById[response.LandmarkId] else nil
	if landmark then
		if type(response.State) == "table" then
			Hud.startCooldown(response.State.Cooldown)
		end
		revealing = true
		local ok, err = pcall(Hud.reveal, landmark, {
			Fast = fast,
			IsNew = response.IsNew == true,
			StarUp = response.StarUp == true,
			Stars = tonumber(response.Stars) or 0,
			Bonus = tonumber(response.Bonus) or 0,
			Luck = tonumber(response.Luck) or 1,
		})
		if not ok then
			warn("[LandmarkRNG] 굴림 연출 오류: " .. tostring(err))
		end
		revealing = false

		-- 연출이 끝난 뒤에 숫자 갱신(스포일러 방지)
		applyState(response.State, receivedAt)
		local deferred = deferredState
		deferredState = nil
		if deferred then
			applyState(deferred.Snapshot, deferred.ReceivedAt)
		end
		for _, held in heldAnnouncements do
			showAnnouncement(held.Info, held.Landmark)
		end
		table.clear(heldAnnouncements)

		parkFullNotice(landmark)
		autoFeature(landmark)
	elseif type(response) == "table" and response.Ok then
		applyState(response.State, receivedAt) -- 모르는 명소 Id (클라가 옛 버전일 때)
	elseif type(response) == "table" and response.Reason == "cooldown" then
		task.wait(tonumber(response.RetryIn) or 0.2)
		lastRollSentAt = -math.huge -- 이미 RetryIn 만큼 기다렸으니 다음 요청에서 또 기다리지 않음
	else
		task.wait(1) -- 데이터 불러오는 중이거나 통신 실패: 자동 굴리기가 요청을 퍼붓지 않게
	end

	rolling = false
	-- AUTO 가 계속 굴리면 굴리기 버튼의 지구본은 계속 돎(굴림마다 멈췄다 0° 로 돌아가는 떨림 없이). 끄면 toggleAuto 가 멈춤
	if not (autoRoll and not autoPaused) then
		Hud.setRolling(false)
	end
end

local function toggleAuto()
	autoRoll = not autoRoll
	Hud.setAuto(autoRoll)
	if not autoRoll then
		Hud.setRolling(rolling)
	end
	if autoPaused then
		-- 배치 모드(T 키): 굴리기 줄이 숨어 있으니 알림으로. 나가면 적용
		Hud.toast(if autoRoll then "AUTO ON" else "AUTO OFF", Ui.Theme.Ink, 2, "auto")
		return
	end
	if autoRoll and not rolling then
		task.spawn(roll, true)
	end
end

-- 서버가 준 실패 이유(문장 또는 코드) -> 짧은 알림 글자 + 아이콘
local function buyFailure(reason: any): (string, string)
	local text = string.lower(tostring(reason or ""))
	if text:find("코인") or text:find("coin") then
		return "코인 부족", "coin"
	elseif text:find("최대") or text:find("max") then
		return "MAX", "check"
	elseif text:find("불러") or text:find("load") then
		return "로딩 중", "globe"
	end
	return "구매 실패", "close"
end

local function buy(upgradeId: string)
	local response = invoke("BuyUpgrade", upgradeId)
	if type(response) ~= "table" then
		return
	end
	applyState(response.State)
	if response.Ok then
		-- 성공: 업그레이드 아이콘 + "Lv 3"
		local level = if state then PlayerState.upgradeLevel(state, upgradeId) else nil
		local icon = Icons.UPGRADE[upgradeId] or "check"
		Hud.toast(if level then "Lv " .. level else "구매 완료", Ui.Theme.Good, 2, icon)
	else
		local text, icon = buyFailure(response.Reason)
		Hud.toast(text, Ui.Theme.Bad, 2, icon)
	end
end

local function toggleAutoFeature()
	if not state then
		return
	end
	local response = invoke("SetSetting", "AutoFeature", not (state :: PlayerState.Snapshot).Settings.AutoFeature)
	if type(response) == "table" then
		applyState(response.State)
	end
end

-- 공원 배치 ----------------------------------------------------------------------
-- 3D 배치 모드(ParkEdit)가 누르는 즉시 미리 보여 주고, 여기서 서버에 요청(기다림)한 뒤 응답 상태를 반영하고 결과를 돌려줌

-- 서버가 준 실패 이유 -> 짧은 알림 ("stale" 은 따로: 중립 알림 "공원 바뀜" + 새 상태로 다시 그림)
local function parkFailure(reason: any): (string, string)
	local text = string.lower(tostring(reason or ""))
	if text:find("잠긴") then
		return "잠긴 칸", "lock"
	elseif text:find("busy") then
		return "잠시 후", "auto"
	elseif text:find("불러") or text:find("load") then
		return "로딩 중", "globe"
	end
	return "배치 실패", "close"
end

-- expected: 화면에서 그 칸에 보이던 명소 Id(빈 칸 ""), expectedFrom: 옮기는 명소가 있던 칸(0 = 보관함).
-- 그사이 서버에서 그 칸이 바뀌었으면(예: 자동 굴림이 빈 칸에 새 명소를 놓음) 서버가 Reason "stale" + 새 상태로 거절
-- -> 배치 모드가 미리 보기를 버리고 새 상태로 다시 그림. 반환: 받아들였는지, stale 인지
local function setDisplay(
	slot: number,
	landmarkId: string?,
	expected: string,
	expectedFrom: number?
): (boolean, boolean)
	local response = invoke("SetDisplay", slot, landmarkId, expected, expectedFrom)
	local stale = false
	if type(response) == "table" then
		stale = response.Reason == "stale"
		if stale then
			-- 굴림 연출 중이면(자동 굴림이 방금 놓은 명소가 이유) 새 상태는 연출이 끝난 뒤 반영 — 결과가 미리 보이지 않게
			onStateEvent(response.State)
			Hud.toast("공원 바뀜", Ui.Theme.Ink, 2, "park")
		else
			applyState(response.State)
		end
		if not stale and not response.Ok then
			local text, icon = parkFailure(response.Reason)
			Hud.toast(text, Ui.Theme.Bad, 2, icon)
		end
	end
	return type(response) == "table" and response.Ok == true, stale
end

local function setAutoPark(on: boolean): boolean
	local response = invoke("SetSetting", "AutoPark", on)
	if type(response) ~= "table" then
		return false
	end
	applyState(response.State)
	if not response.Ok then
		Hud.toast("잠시 후", Ui.Theme.Bad, 2, "auto")
	end
	return response.Ok == true
end

-- 환생 -------------------------------------------------------------------------

-- 서버가 준 실패 이유 -> 짧은 알림. 이유가 애매하면 지금 상태로 판단
local function rebirthFailure(reason: any): (string, string)
	local text = string.lower(tostring(reason or ""))
	if text:find("코인") or text:find("coin") then
		return "코인 부족", "coin"
	elseif text:find("명소") or text:find("landmark") or text:find("missing") then
		return "명소 부족", "lock"
	elseif text:find("불러") or text:find("load") then
		return "로딩 중", "globe"
	end
	if state then
		local _, missing, short = Perks.rebirthCheck(state, currentCoins())
		if #missing > 0 then
			return "명소 부족", "lock"
		elseif short > 0 then
			return "코인 부족", "coin"
		end
	end
	return "환생 실패", "close"
end

local function rebirth()
	if rebirthing then
		return
	end
	rebirthing = true
	local response = invoke("Rebirth")
	rebirthing = false
	if type(response) ~= "table" then
		return
	end
	applyState(response.State)
	if response.Ok then
		Hud.flash(Ui.colorPair("Coral").Face, 0.55)
		Hud.toast("환생!", Ui.colorPair("Coral").Face, 3, "rebirth")
	else
		local text, icon = rebirthFailure(response.Reason)
		Hud.toast(text, Ui.Theme.Bad, 2, icon)
	end
end

-- Robux 상품 --------------------------------------------------------------------
-- 서버가 구매 창을 띄움. 지급 결과는 State(부스트·패스·코인) / ServerLuck 이벤트로 들어옴

local function buyRobux(remoteName: string, key: string)
	local response = invoke(remoteName, key)
	if type(response) ~= "table" then
		return
	end
	if type(response.State) == "table" then
		applyState(response.State)
	end
	if response.Ok == false then
		-- 서버가 구매 창을 안 띄운 이유: "max" 시간 부스트가 최대(3시간)까지 참, "owned" 이미 가진 게임패스
		-- (서버가 방금 확인해서 상태도 보냄), "loading" 데이터를 불러오는 중, 그 밖 = 실패
		local item = Perks.item(key)
		local icon = if item then item.Icon else "close"
		if response.Reason == "max" then
			Hud.toast("MAX", Ui.Theme.Bad, 2, icon)
		elseif response.Reason == "owned" then
			Hud.toast("보유", Ui.Theme.Good, 2, icon)
		elseif response.Reason == "loading" then
			Hud.toast("불러오는 중", Ui.Theme.Bad, 2, "auto")
		else
			Hud.toast("구매 실패", Ui.Theme.Bad, 2, "close")
		end
	end
end

-- 구매 창에서 실제로 샀을 때: [상품 아이콘] "구매 완료"
local function purchased(kind: string, id: any)
	local item = Perks.itemById(kind, tonumber(id) or 0)
	Hud.toast("구매 완료", Ui.Theme.Good, 3, if item then item.Icon else "check")
end

-- 광장 / 내 공원으로 이동(기다림). 성공하면 true
local function travel(target: string): boolean
	if teleporting then
		return false
	end
	teleporting = true
	local response = invoke("Teleport", target)
	local ok = type(response) == "table" and response.Ok == true
	if ok then
		location = target
		Hud.setLocation(location)
	elseif response ~= nil then
		Hud.toast("이동 실패", Ui.Theme.Bad, 2, "close")
	end
	teleporting = false
	return ok
end

-- 광장 <-> 내 공원 이동 버튼
local function teleport()
	if location == "Park" then
		ParkEdit.exit() -- 공원을 떠나면 배치 모드도 끝(부지 밖 감지보다 먼저)
	end
	travel(if location == "Plaza" then "Park" else "Plaza")
end

-- 화면 만들기 ---------------------------------------------------------------

local gui = Hud.init(playerGui, {
	Roll = function()
		task.spawn(roll)
	end,
	ToggleAuto = toggleAuto,
	Menu = function(name: string)
		ParkEdit.exit() -- 다른 창을 열면 배치 모드 끝
		Panels.toggle(name)
	end,
	Teleport = function()
		task.spawn(teleport)
	end,
	Arrange = function()
		ParkEdit.toggle()
	end,
})
Panels.init(gui, {
	Feature = function(landmarkId: string?)
		task.spawn(feature, landmarkId)
	end,
	Buy = function(upgradeId: string)
		task.spawn(buy, upgradeId)
	end,
	ToggleAutoFeature = function()
		task.spawn(toggleAutoFeature)
	end,
	Rebirth = function()
		task.spawn(rebirth)
	end,
	BuyPass = function(key: string)
		task.spawn(buyRobux, "BuyPass", key)
	end,
	BuyProduct = function(key: string)
		task.spawn(buyRobux, "BuyProduct", key)
	end,
	Toast = function(text: string, icon: string?, color: Color3?)
		Hud.toast(text, color or Ui.Theme.Bad, 2, icon)
	end,
	Arrange = function()
		Panels.close()
		ParkEdit.enter(nil)
	end,
})
ParkEdit.init(gui, {
	SetDisplay = setDisplay,
	SetAutoPark = setAutoPark,
	GoToPark = function(): boolean
		return travel("Park")
	end,
	Toast = function(text: string, icon: string?, color: Color3?)
		Hud.toast(text, color or Ui.Theme.Bad, 2, icon)
	end,
	Changed = function(editing: boolean)
		if editing then
			Panels.close()
		end
		Hud.setEditing(editing)
		autoPaused = editing
		if editing then
			Hud.setRolling(rolling) -- AUTO 가 쉬는 동안 지구본 아이콘도 멈춤(굴리던 것이 끝나면 roll 이 멈춤)
		end
		if editing and autoRoll then
			Hud.toast("AUTO 쉬는 중", Ui.Theme.Ink, 2, "auto") -- 나가면 다시 돎
		end
	end,
})

-- 다시 태어나면 광장(스폰 지점)에서 시작
player.CharacterAdded:Connect(function()
	location = "Plaza"
	Hud.setLocation(location)
end)

-- 키보드: R = 굴리기, T = 자동 굴리기(배치 모드 동안은 켜고 끄기만 — 나가면 적용)
UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if input.KeyCode == Enum.KeyCode.R then
		task.spawn(roll)
	elseif input.KeyCode == Enum.KeyCode.T then
		toggleAuto()
	end
end)

-- 서버 이벤트 ---------------------------------------------------------------

Net.event("State").OnClientEvent:Connect(onStateEvent)

Net.event("Announce").OnClientEvent:Connect(function(info)
	local landmark = if type(info) == "table" then Landmarks.ById[info.LandmarkId] else nil
	if not landmark then
		return
	end
	-- 내가 발견한 속보가 내 연출보다 먼저 오면 결과가 미리 보이므로 연출이 끝날 때까지 보류
	if info.UserId == player.UserId and revealing then
		table.insert(heldAnnouncements, { Info = info, Landmark = landmark })
		return
	end
	showAnnouncement(info, landmark)
end)

-- 서버 행운 { Name, Until, Left }: 위쪽 띠 + "<이름> 서버 행운!"
-- (남은 초 Left 를 먼저 씀: 시계 동기화 오차가 없음. 옛 서버에 이벤트가 없어도 멈추지 않게 따로 기다림)
task.spawn(function()
	local remote = findRemote("ServerLuck", 30)
	if not remote or not remote:IsA("RemoteEvent") then
		return
	end
	remote.OnClientEvent:Connect(function(info)
		if type(info) ~= "table" then
			return
		end
		local left = tonumber(info.Left)
		local untilTime = if left and left > 0 then left else tonumber(info.Until)
		if untilTime then
			Hud.serverLuck(tostring(info.Name or ""), untilTime)
		end
	end)
end)

-- 내 공원 ---------------------------------------------------------------------
-- 서버(ParkService)가 부지 모델에 OwnerUserId(주인)·Origin(부지 CFrame), 칸 모델에 Slot·Look 속성을 붙여 둠.
-- 내 부지를 찾으면 HUD [배치] 버튼을 보이고 ParkEdit 에 넘김(내 부지의 열린 칸에만 이 클라이언트에서 ClickDetector —
-- 남의 공원 받침대에는 손가락 커서가 안 뜸, 누르면 서버를 거치지 않고 바로 배치 모드 + 그 명소를 집음)
local myPlot: Instance? = nil

local function setMyPlot(plot: Instance?)
	if plot == myPlot then
		return
	end
	myPlot = plot
	Hud.setPlotOwned(plot ~= nil)
	ParkEdit.setPlot(plot)
end

task.spawn(function()
	local parks = workspace:WaitForChild("Parks", 60)
	if not parks then
		return
	end
	local function check()
		local found: Instance? = nil
		for _, plot in parks:GetChildren() do
			if plot:GetAttribute("OwnerUserId") == player.UserId then
				found = plot
				break
			end
		end
		setMyPlot(found)
	end
	local function watchPlot(plot: Instance)
		plot:GetAttributeChangedSignal("OwnerUserId"):Connect(check)
	end
	for _, plot in parks:GetChildren() do
		watchPlot(plot)
	end
	parks.ChildAdded:Connect(function(plot)
		watchPlot(plot)
		check()
	end)
	parks.ChildRemoved:Connect(check)
	check()
end)

-- 구매 창이 닫힐 때 알림만 (지급은 서버의 ProcessReceipt). 연결에 실패해도 아래 루프는 돌아야 하므로 pcall
pcall(function()
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(who, passId, wasPurchased)
		if who == player and wasPurchased then
			purchased("Pass", passId)
		end
	end)
	MarketplaceService.PromptProductPurchaseFinished:Connect(function(userId, productId, isPurchased)
		if userId == player.UserId and isPurchased then
			purchased("Product", productId)
		end
	end)
end)

-- 루프 ---------------------------------------------------------------------

-- "LandmarkSpin" 태그 모형 목록 (태그가 붙고 떨어질 때만 갱신 → 매 프레임 목록을 새로 만들지 않음)
local spinModels: { [Instance]: boolean } = {}
for _, instance in CollectionService:GetTagged(SPIN_TAG) do
	spinModels[instance] = true
end
CollectionService:GetInstanceAddedSignal(SPIN_TAG):Connect(function(instance)
	spinModels[instance] = true
end)
CollectionService:GetInstanceRemovedSignal(SPIN_TAG):Connect(function(instance)
	spinModels[instance] = nil
end)

RunService.RenderStepped:Connect(function(dt)
	-- 태그 모형을 제자리에서 수직축으로 회전 (이 화면에서만 보이는 효과)
	local turn = CFrame.Angles(0, SPIN_SPEED * dt, 0)
	for model in spinModels do
		if model:IsA("Model") and model:IsDescendantOf(workspace) then
			local pivot = model:GetPivot()
			model:PivotTo(CFrame.new(pivot.Position) * turn * (pivot - pivot.Position))
		end
	end

	-- 코인: 받은 값 + 초당 수입 × 지난 시간 (부드럽게 올라감)
	if state then
		Hud.setCoins(currentCoins())
	end
end)

-- 업그레이드 버튼 "살 수 있음" 색, 환생 조건, 부스트·서버 행운 타이머 (가벼운 갱신)
task.spawn(function()
	while true do
		if state then
			local coins = currentCoins()
			Panels.refreshCoins(coins)
			Hud.tick(coins)
		else
			Hud.tick(nil)
		end
		task.wait(0.25)
	end
end)

-- 자동 굴리기(배치 모드 동안은 쉼)
task.spawn(function()
	while true do
		if autoRoll and not autoPaused and not rolling then
			roll(true)
		end
		task.wait(0.05)
	end
end)

-- 처음 상태 받아오기 (서버 데이터 로드가 끝날 때까지 서버 쪽에서 기다려 줌)
applyState(invoke("GetState"))
]]></string>
