		CellPadding = UDim2.fromOffset(PASSPORT_GAP, PASSPORT_GAP),
		FillDirectionMaxCells = REBIRTH_COLUMNS,
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Parent = rebirthGrid,
