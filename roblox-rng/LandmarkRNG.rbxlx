          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--!strict
-- 게임 전체 밸런스/설정 값. 숫자만 바꿔서 난이도를 조절할 수 있습니다.

-- n 번째 환생 조건(코인 + 이번 판에 보유해야 하는 명소 Id)
export type RebirthStep = {
	Coins: number,
	Landmarks: { string },
}

-- 게임패스(한 번 사면 영구). PassId 가 0 이면 비활성(화면에 안 나옴)
export type GamePass = {
	Id: string,
	Name: string,
	PassId: number,
	LuckMult: number?, -- 행운 배율
	CooldownMult: number?, -- 굴림 간격 배율
	IncomeMult: number?, -- 관광 수입 배율
}

-- 개발자 상품(여러 번 구매). ProductId 가 0 이면 비활성(화면에 안 나옴)
export type Product = {
	Id: string,
	Name: string,
	ProductId: number,
	Seconds: number?, -- 시간 부스트 길이(초). 같은 부스트를 또 사면 시간이 더해짐
	LuckMult: number?, -- 부스트 중 행운 배율
	ServerWide: boolean?, -- true 면 서버 전체 부스트(저장 안 하는 서버 변수), 아니면 개인 부스트(Data.Boosts)
	IncomeSeconds: number?, -- 코인 팩: 초당 관광 수입 × 이 초만큼 코인
	MinCoins: number?, -- 코인 팩: 최소 코인
}

local Config = {
	-- 굴리기(지구본 돌리기) ----------------------------------------------
	ROLL_COOLDOWN = 1.2, -- 굴리기 사이 최소 간격(초). 서버가 강제합니다.
	COOLDOWN_TOLERANCE = 0.15, -- 네트워크 지연을 감안한 허용 오차(초)
	BASE_LUCK = 1,

	-- 1/N 이상 희귀한 명소를 발견하면 서버 전체에 "뉴스 속보"
	ANNOUNCE_ONE_IN = 1000,
	-- 1/N 이상이면 광장 하늘에 거대한 홀로그램까지 띄움
	HOLOGRAM_ONE_IN = 10000,

	-- 새 명소를 처음 발견했을 때 보너스 코인 = ceil(DISCOVERY_BONUS_MULT * N ^ 0.5)
	DISCOVERY_BONUS_MULT = 5,

	-- 관광 공원(타이쿤) ------------------------------------------------------
	BASE_SLOTS = 6, -- 처음 전시 칸 수 (공원 확장 업그레이드로 늘어남)
	PARK_GRID = 6, -- 공원 전시 격자 한 변의 칸 수(6×6 = 최대 36칸). 명소가 더 많으면 희귀한 순서로 36개만 전시
	-- 등급(Rank 1~7)별 명소 1개의 초당 관광 수입
	TIER_INCOME = { 1, 2, 5, 12, 30, 80, 250 },
	-- 같은 명소를 여러 번 발견하면 별(★)이 오름. 별 k 개가 되는 누적 발견 수
	STAR_THRESHOLDS = { 1, 3, 10, 30, 100 },
	STAR_INCOME_BONUS = 0.5, -- 별 1개 추가마다 그 명소 수입 +50%

	-- 여권 도장: 한 대륙에서 이 등급(Rank) 이하의 명소를 모두 발견하면 영구 행운 보너스(대륙마다 더해짐).
	-- 5 = 불가사의까지. 그보다 희귀한 전설급은 도장에 필요 없는 보너스 수집.
	STAMP_MAX_RANK = 5,
	REGION_LUCK_BONUS = 0.25,

	-- 업그레이드(영구). 가격 = floor(BasePrice * Growth ^ 현재레벨)
	Upgrades = {
		{
			Id = "Globe",
			Name = "지구본",
			Emoji = "🌐",
			Description = "행운 +10%",
			BasePrice = 400,
			Growth = 1.7,
			MaxLevel = 20,
			PerLevel = 0.10,
		},
		{
			Id = "Agency",
			Name = "여행사",
			Emoji = "✈️",
			Description = "굴림 간격 -5%",
			BasePrice = 300,
			Growth = 1.8,
			MaxLevel = 10,
			PerLevel = 0.05,
		},
		{
			Id = "Park",
			Name = "공원 확장",
			Emoji = "🏞️",
			Description = "전시 칸 +3",
			BasePrice = 250,
			Growth = 2.0,
			MaxLevel = 10, -- 6 + 3*10 = 36칸 = 격자(6×6) 가득
			PerLevel = 3,
		},
		{
			Id = "Ticket",
			Name = "입장료",
			Emoji = "🎟️",
			Description = "관광 수입 +20%",
			BasePrice = 500,
			Growth = 1.9,
			MaxLevel = 15,
			PerLevel = 0.20,
		},
	},

	-- 환생 ---------------------------------------------------------------
	-- REBIRTHS[n] = n 번째 환생 조건. 요구 명소는 이번 판에 보유하고 있어야 함(환생하면 보유 명소는 비워짐).
	-- 목록을 넘어서면 마지막 단계의 명소 + 코인 × REBIRTH_COIN_GROWTH 씩 증가.
	-- (명소 목록이 늘어나도 그대로 쓸 수 있는 명소 Id 만 사용)
	REBIRTHS = {
		{ Coins = 5000, Landmarks = { "eiffel", "liberty" } },
		{ Coins = 30000, Landmarks = { "colosseum", "tajmahal" } },
		{ Coins = 150000, Landmarks = { "sphinx", "greatwall" } },
		{ Coins = 600000, Landmarks = { "pyramid", "chichen", "machupicchu" } },
		{ Coins = 2500000, Landmarks = { "petra", "moai", "stonehenge" } },
		{ Coins = 10000000, Landmarks = { "alexandria", "reef" } },
		{ Coins = 40000000, Landmarks = { "babylon", "rhodes", "nanmadol" } },
		{ Coins = 160000000, Landmarks = { "babel" } },
	} :: { RebirthStep },
	REBIRTH_COIN_GROWTH = 4,
	REBIRTH_LUCK_BONUS = 0.2, -- 환생 1회마다 행운 +20% (행운 × (1 + 0.2 × 환생 수))
	REBIRTH_INCOME_BONUS = 0.5, -- 환생 1회마다 관광 수입 +50% (수입 × (1 + 0.5 × 환생 수))

	-- 유료 상품(Robux) ----------------------------------------------------
	-- Creator Hub 에서 만든 뒤 PassId / ProductId 를 넣으세요. 0 이면 그 상품은 비활성(화면에 안 나옴).
	-- 추천 가격(Robux): LuckVIP 399, FastRoll 199, DoubleIncome 299
	GamePasses = {
		{ Id = "LuckVIP", Name = "행운 VIP", PassId = 0, LuckMult = 2 },
		{ Id = "FastRoll", Name = "빠른 굴림", PassId = 0, CooldownMult = 0.7 },
		{ Id = "DoubleIncome", Name = "수입 2배", PassId = 0, IncomeMult = 2 },
	} :: { GamePass },
	-- 추천 가격(Robux): LuckBoost 49, ServerLuck 99, CoinPack 79
	Products = {
		{ Id = "LuckBoost", Name = "행운 부스트", ProductId = 0, Seconds = 900, LuckMult = 2 },
		{ Id = "ServerLuck", Name = "서버 행운", ProductId = 0, Seconds = 900, LuckMult = 2, ServerWide = true },
		{ Id = "CoinPack", Name = "코인 팩", ProductId = 0, IncomeSeconds = 1800, MinCoins = 1000 },
	} :: { Product },
	MAX_BOOST_SECONDS = 3 * 60 * 60, -- 시간 부스트(개인·서버)는 남은 시간이 이 이상 쌓이지 않음
	MAX_RECEIPTS = 50, -- 중복 지급 방지용으로 기억하는 최근 구매 영수증(PurchaseId) 수

	-- 저장 ---------------------------------------------------------------
	DATASTORE_NAME = "LandmarkRNG_v1",
	AUTOSAVE_INTERVAL = 120,
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Format</string>
          <string name="Source"><![CDATA[--!strict
-- 숫자/시간 표시용 포맷 함수

local Format = {}

-- 1234567 -> "1,234,567"
function Format.commas(n: number): string
	local negative = n < 0
	local digits = tostring(math.floor(math.abs(n)))
	local out = digits:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if out:sub(1, 1) == "," then
		out = out:sub(2)
	end
	return if negative then "-" .. out else out
end

local SUFFIXES = {
	{ 1e12, "T" },
	{ 1e9, "B" },
	{ 1e6, "M" },
	{ 1e3, "K" },
}

-- 2500000 -> "2.5M", 404040 -> "404K". 반올림 대신 버림(999.95K 가 "1000K" 가 되지 않도록).
function Format.short(n: number): string
	for _, entry in SUFFIXES do
		local unit = entry[1] :: number
		if n >= unit then
			local value = n / unit
			local text
			if value >= 100 then
				text = tostring(math.floor(value))
			else
				text = string.format("%.1f", math.floor(value * 10) / 10):gsub("%.0$", "")
			end
			return text .. (entry[2] :: string)
		end
	end
	return Format.commas(n)
end

-- 확률 표기: 1,000,000 미만은 콤마, 이상은 축약 ("1 in 2,500", "1 in 10M")
function Format.oneIn(n: number): string
	if n >= 1e6 then
		return "1 in " .. Format.short(n)
	end
	return "1 in " .. Format.commas(n)
end

-- 1.5 -> "x1.5", 2 -> "x2", 1.25 -> "x1.25"
function Format.multiplier(x: number): string
	local text = string.format("%.2f", x):gsub("0+$", ""):gsub("%.$", "")
	return "x" .. text
end

-- 초 -> "4:05" / "1:02:03"
function Format.duration(seconds: number): string
	local total = math.max(0, math.ceil(seconds))
	local h = total // 3600
	local m = (total % 3600) // 60
	local s = total % 60
	if h > 0 then
		return string.format("%d:%02d:%02d", h, m, s)
	end
	return string.format("%d:%02d", m, s)
end

-- Color3 -> "#rrggbb" (RichText 용)
function Format.hex(color: Color3): string
	return string.format(
		"#%02x%02x%02x",
		math.floor(color.R * 255 + 0.5),
		math.floor(color.G * 255 + 0.5),
		math.floor(color.B * 255 + 0.5)
	)
end

-- RichText 에 넣을 문자열 이스케이프
function Format.escape(text: string): string
	return (text:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"):gsub('"', "&quot;"))
end

return Format
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">ImageIds</string>
          <string name="Source"><![CDATA[--!strict
-- 그림 에셋 Id 표 (이름 -> "rbxassetid://<숫자>").
-- tools/upload_images.py 가 art/png/*.png 를 올린 뒤 이 파일의 빈 문자열을 채웁니다(손으로 넣어도 됨).
-- 빈 문자열이면 코드로 그린 기본 모양을 씁니다: 아이콘은 3D 미니 모형(Icons.luau), 스킨은 Frame + UICorner + UIStroke.
-- 한 줄에 하나씩 `이름 = "..."`, 형식을 유지해 주세요(도구가 이 줄을 찾아 바꿉니다).

local ImageIds: { [string]: string } = {
	-- 아이콘 (정사각형, 투명 배경)
	coin = "",
	globe = "",
	passport = "",
	album = "",
	hammer = "",
	park = "",
	plaza = "",
	dice = "",
	clover = "",
	star = "",
	star_empty = "",
	news = "",
	lock = "",
	auto = "",
	close = "",
	check = "",
	arrow_up = "",
	stamp_home = "",
	stamp_europe = "",
	stamp_asia = "",
	stamp_africa = "",
	stamp_americas = "",
	stamp_oceania = "",
	stamp_legend = "",
	-- (선택) 업그레이드 아이콘. 비어 있으면 3D 모형
	plane = "",
	ticket = "",

	-- 스킨 (256x256, 9-slice SliceCenter = 64,64,192,192). 회색 바탕 그림을 ImageColor3 로 물들여 씀.
	-- sunburst 는 9-slice 없이 통째로 늘여 씀.
	button_face = "",
	button_shadow = "",
	panel_paper = "",
	pill = "",
	ribbon = "",
	sunburst = "",
	tag = "",
}

return ImageIds
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Landmarks</string>
          <string name="Source"><![CDATA[--!strict
-- 명소(뽑기 결과) 목록. OneIn = "1/N 확률"의 N.
-- 새 명소를 추가하려면 DEFINITIONS 에 한 줄만 넣으면 됩니다(Id는 저장 키이므로 게시 후엔 바꾸지 마세요).
-- 모형: Shape 이름으로 Models.luau 가 코드로 임시 모형을 만듭니다.
--       ReplicatedStorage.LandmarkModels 폴더에 Id 와 같은 이름의 Model 을 넣으면 그 모형(예: AI 메쉬)을 대신 씁니다.

export type Tier = {
	Rank: number,
	Name: string,
	MinOneIn: number,
	Color: Color3,
}

export type Region = {
	Id: string,
	Name: string,
	Emoji: string,
	Color: Color3,
}

export type Landmark = {
	Id: string,
	Name: string,
	Subtitle: string, -- 영문 이름
	OneIn: number,
	Region: string, -- Region.Id (대륙)
	Shape: string, -- Models.luau 의 임시 모형 종류
	Primary: Color3, -- 주 색
	Secondary: Color3, -- 보조 색
	Accent: Color3, -- 강조 색(빛/장식)
	Material: Enum.Material, -- 주 재질
	Tier: Tier,
}

local Landmarks = {}

-- 등급: OneIn 이 MinOneIn 이상이면 해당 등급(높은 등급부터 검사)
Landmarks.Tiers = {
	{ Rank = 1, Name = "일반 명소", MinOneIn = 1, Color = Color3.fromRGB(190, 200, 210) },
	{ Rank = 2, Name = "도시 명소", MinOneIn = 10, Color = Color3.fromRGB(110, 215, 120) },
	{ Rank = 3, Name = "국가 명소", MinOneIn = 100, Color = Color3.fromRGB(80, 165, 255) },
	{ Rank = 4, Name = "세계 명소", MinOneIn = 1000, Color = Color3.fromRGB(185, 110, 255) },
	{ Rank = 5, Name = "불가사의", MinOneIn = 10000, Color = Color3.fromRGB(255, 175, 45) },
	{ Rank = 6, Name = "잃어버린 유산", MinOneIn = 100000, Color = Color3.fromRGB(255, 85, 110) },
	{ Rank = 7, Name = "전설", MinOneIn = 1000000, Color = Color3.fromRGB(120, 255, 235) },
} :: { Tier }

-- 여권에 나오는 대륙(도장 대상). 순서 = 여권/지구본 연출 순서
Landmarks.Regions = {
	{ Id = "Asia", Name = "아시아", Emoji = "🏯", Color = Color3.fromRGB(255, 120, 120) },
	{ Id = "Europe", Name = "유럽", Emoji = "🏰", Color = Color3.fromRGB(110, 150, 255) },
	{ Id = "Africa", Name = "아프리카", Emoji = "🐪", Color = Color3.fromRGB(240, 190, 90) },
	{ Id = "Americas", Name = "아메리카", Emoji = "🗽", Color = Color3.fromRGB(90, 210, 150) },
	{ Id = "Oceania", Name = "오세아니아", Emoji = "🏝️", Color = Color3.fromRGB(70, 200, 235) },
} :: { Region }

Landmarks.RegionById = {} :: { [string]: Region }
for _, region in Landmarks.Regions do
	Landmarks.RegionById[region.Id] = region
end

local function tierFor(oneIn: number): Tier
	for i = #Landmarks.Tiers, 1, -1 do
		local tier = Landmarks.Tiers[i]
		if oneIn >= tier.MinOneIn then
			return tier
		end
	end
	return Landmarks.Tiers[1]
end

local rgb = Color3.fromRGB
local M = Enum.Material

-- stylua: ignore
local DEFINITIONS = {
	-- Id,           이름,               영문,                          N,         지역,       모형,         주 색,               보조 색,              강조 색,              재질
	{ "clocktower",  "홍콩 시계탑",      "Clock Tower, Hong Kong",      2,         "Asia",     "clocktower", rgb(200, 170, 140), rgb(90, 70, 60),    rgb(255, 245, 210), M.Brick },
	{ "lighthouse",  "희망봉 등대",      "Cape Point Lighthouse",       3,         "Africa",   "lighthouse", rgb(240, 240, 240), rgb(210, 60, 60),   rgb(255, 240, 150), M.SmoothPlastic },
	{ "harbourbridge", "하버 브리지",    "Sydney Harbour Bridge",       4,         "Oceania",  "bridge",     rgb(150, 155, 160), rgb(95, 100, 110),  rgb(255, 225, 150), M.Metal },
	{ "windmill",    "풍차 마을",        "Kinderdijk Windmills",        5,         "Europe",   "windmill",   rgb(230, 220, 200), rgb(140, 90, 60),   rgb(250, 250, 250), M.WoodPlanks },
	{ "fountain",    "버킹엄 분수",      "Buckingham Fountain",         7,         "Americas", "fountain",   rgb(215, 205, 185), rgb(80, 170, 255),  rgb(200, 240, 255), M.Marble },

	{ "arc",         "개선문",           "Arc de Triomphe",             12,        "Europe",   "arch",       rgb(225, 210, 180), rgb(190, 175, 150), rgb(255, 230, 160), M.Limestone },
	{ "bigben",      "빅벤",             "Big Ben",                     20,        "Europe",   "clocktower", rgb(200, 175, 120), rgb(40, 60, 50),    rgb(255, 230, 140), M.Sandstone },
	{ "skytower",    "스카이타워",       "Sky Tower, Auckland",         25,        "Oceania",  "needle",     rgb(230, 230, 235), rgb(80, 85, 95),    rgb(120, 220, 255), M.Concrete },
	{ "sungnyemun",  "숭례문",           "Sungnyemun Gate",             30,        "Asia",     "gate",       rgb(170, 160, 150), rgb(60, 120, 90),   rgb(200, 50, 45),   M.Slate },
	{ "pisa",        "피사의 사탑",      "Leaning Tower of Pisa",       45,        "Europe",   "leaning",    rgb(240, 235, 220), rgb(200, 190, 170), rgb(255, 250, 235), M.Marble },
	{ "liberty",     "자유의 여신상",    "Statue of Liberty",           70,        "Americas", "statue",     rgb(120, 190, 160), rgb(160, 140, 110), rgb(255, 200, 80),  M.Metal },

	{ "namsan",      "남산타워",         "N Seoul Tower",               120,       "Asia",     "needle",     rgb(235, 235, 240), rgb(60, 60, 70),    rgb(90, 200, 255),  M.SmoothPlastic },
	{ "eiffel",      "에펠탑",           "Eiffel Tower",                200,       "Europe",   "lattice",    rgb(120, 95, 70),   rgb(90, 70, 50),    rgb(255, 210, 120), M.Metal },
	{ "apostles",    "12사도 바위",      "Twelve Apostles",             250,       "Oceania",  "seastacks",  rgb(210, 160, 110), rgb(50, 140, 200),  rgb(240, 230, 210), M.Sandstone },
	{ "colosseum",   "콜로세움",         "Colosseum",                   350,       "Europe",   "ring",       rgb(215, 190, 150), rgb(170, 145, 110), rgb(255, 225, 170), M.Limestone },
	{ "tajmahal",    "타지마할",         "Taj Mahal",                   600,       "Asia",     "dome",       rgb(250, 248, 240), rgb(220, 215, 200), rgb(255, 215, 120), M.Marble },
	{ "angkor",      "앙코르와트",       "Angkor Wat",                  850,       "Asia",     "temple",     rgb(150, 140, 110), rgb(100, 110, 80),  rgb(230, 200, 120), M.Sandstone },

	{ "sphinx",      "스핑크스",         "Great Sphinx",                1200,      "Africa",   "sphinx",     rgb(215, 180, 120), rgb(190, 155, 100), rgb(80, 120, 200),  M.Sandstone },
	{ "greatwall",   "만리장성",         "Great Wall",                  1600,      "Asia",     "wall",       rgb(160, 150, 135), rgb(90, 130, 70),   rgb(220, 60, 50),   M.Cobblestone },
	{ "pyramid",     "기자 피라미드",    "Pyramids of Giza",            2200,      "Africa",   "pyramid",    rgb(225, 195, 130), rgb(200, 170, 110), rgb(255, 225, 120), M.Sandstone },
	{ "reef",        "그레이트 배리어 리프", "Great Barrier Reef",      2800,      "Oceania",  "reef",       rgb(255, 120, 150), rgb(40, 170, 210),  rgb(255, 215, 90),  M.SmoothPlastic },
	{ "chichen",     "치첸이트사",       "Chichen Itza",                3000,      "Americas", "steps",      rgb(190, 180, 160), rgb(80, 140, 80),   rgb(230, 220, 190), M.Limestone },
	{ "machupicchu", "마추픽추",         "Machu Picchu",                4000,      "Americas", "terraces",   rgb(150, 145, 135), rgb(90, 160, 80),   rgb(200, 230, 255), M.Slate },
	{ "petra",       "페트라",           "Petra",                       5500,      "Asia",     "facade",     rgb(215, 130, 100), rgb(180, 100, 75),  rgb(255, 200, 150), M.Sandstone },
	{ "moai",        "모아이 석상",      "Moai",                        7000,      "Oceania",  "moai",       rgb(110, 105, 100), rgb(80, 150, 90),   rgb(200, 60, 50),   M.Basalt },
	{ "stonehenge",  "스톤헨지",         "Stonehenge",                  9000,      "Europe",   "stones",     rgb(150, 150, 145), rgb(90, 150, 80),   rgb(200, 220, 255), M.Slate },

	{ "alexandria",  "알렉산드리아 등대", "Lighthouse of Alexandria",   15000,     "Africa",   "lighthouse", rgb(245, 240, 225), rgb(220, 200, 160), rgb(255, 170, 60),  M.Marble },
	{ "babylon",     "바빌론 공중정원",  "Hanging Gardens of Babylon",  30000,     "Asia",     "gardens",    rgb(210, 180, 130), rgb(60, 170, 70),   rgb(120, 200, 255), M.Sandstone },
	{ "nanmadol",    "난마돌",           "Nan Madol",                   45000,     "Oceania",  "ruins",      rgb(70, 70, 78),    rgb(40, 150, 175),  rgb(110, 200, 110), M.Basalt },
	{ "rhodes",      "로도스 거상",      "Colossus of Rhodes",          60000,     "Europe",   "statue",     rgb(190, 130, 60),  rgb(230, 225, 210), rgb(255, 140, 40),  M.Foil },

	{ "babel",       "바벨탑",           "Tower of Babel",              150000,    "Asia",     "spiral",     rgb(200, 170, 120), rgb(150, 120, 90),  rgb(255, 230, 180), M.Sandstone },
	{ "atlantis",    "아틀란티스",       "Atlantis",                    400000,    "Europe",   "island",     rgb(230, 240, 250), rgb(40, 120, 200),  rgb(90, 255, 230),  M.Marble },
	{ "eldorado",    "엘도라도",         "El Dorado",                   800000,    "Americas", "steps",      rgb(255, 200, 60),  rgb(200, 140, 30),  rgb(255, 250, 180), M.Foil },

	{ "mu",          "무 대륙",          "Lost Continent of Mu",        3000000,   "Oceania",  "island",     rgb(175, 165, 125), rgb(30, 110, 170),  rgb(255, 210, 90),  M.Slate },
	{ "yonggung",    "용궁",             "Dragon King's Palace",        2000000,   "Asia",     "pagoda",     rgb(230, 70, 70),   rgb(40, 130, 150),  rgb(120, 255, 220), M.Glass },
	{ "skyisland",   "사하라 신기루 성", "Mirage Citadel of the Sahara", 5000000,  "Africa",   "skyisland",  rgb(235, 200, 130), rgb(190, 140, 80),  rgb(170, 240, 255), M.Sand },
	{ "shangrila",   "샹그릴라",         "Shangri-La",                  10000000,  "Asia",     "pagoda",     rgb(250, 250, 250), rgb(255, 200, 70),  rgb(255, 240, 180), M.Marble },
	{ "worldtree",   "세계수",           "World Tree",                  40000000,  "Europe",   "tree",       rgb(120, 90, 60),   rgb(90, 220, 120),  rgb(255, 255, 200), M.Wood },
}

Landmarks.List = {} :: { Landmark }
Landmarks.ById = {} :: { [string]: Landmark }

for _, def in DEFINITIONS do
	local oneIn = def[4] :: number
	local landmark: Landmark = {
		Id = def[1] :: string,
		Name = def[2] :: string,
		Subtitle = def[3] :: string,
		OneIn = oneIn,
		Region = def[5] :: string,
		Shape = def[6] :: string,
		Primary = def[7] :: Color3,
		Secondary = def[8] :: Color3,
		Accent = def[9] :: Color3,
		Material = def[10] :: Enum.Material,
		Tier = tierFor(oneIn),
	}
	assert(Landmarks.ById[landmark.Id] == nil, "중복된 명소 Id: " .. landmark.Id)
	assert(Landmarks.RegionById[landmark.Region], "없는 지역: " .. landmark.Region)
	table.insert(Landmarks.List, landmark)
	Landmarks.ById[landmark.Id] = landmark
end

-- 흔한 것 → 희귀한 것 순서(여권/표시용)
table.sort(Landmarks.List, function(a, b)
	return a.OneIn < b.OneIn
end)

-- 희귀한 것 → 흔한 것 순서(굴림 판정용)
Landmarks.RarestFirst = table.clone(Landmarks.List)
table.sort(Landmarks.RarestFirst, function(a, b)
	return a.OneIn > b.OneIn
end)

-- 지역별 목록(흔한 것 → 희귀한 것)
Landmarks.ByRegion = {} :: { [string]: { Landmark } }
for _, region in Landmarks.Regions do
	Landmarks.ByRegion[region.Id] = {}
end
for _, landmark in Landmarks.List do
	table.insert(Landmarks.ByRegion[landmark.Region], landmark)
end

Landmarks.Common = Landmarks.List[1]

-- 장식용 지구본(뽑기·수집 대상 아님): 광장의 거대 지구본, 굴림 연출의 도는 지구본에 씀.
-- Models.create 에 명소처럼 넘길 수 있게 같은 모양의 표. LandmarkModels 폴더에 "globe" 로 교체 가능.
Landmarks.Globe = {
	Id = "globe",
	Name = "지구본",
	Subtitle = "Globe",
	OneIn = 0,
	Region = Landmarks.Regions[1].Id,
	Shape = "globe",
	Primary = rgb(40, 110, 220),
	Secondary = rgb(70, 190, 90),
	Accent = rgb(255, 255, 255),
	Material = M.SmoothPlastic,
	Tier = Landmarks.Tiers[1],
} :: Landmark
Landmarks.tierFor = tierFor

return Landmarks
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Models</string>
          <string name="Source"><![CDATA[-- 명소 3D 모형 (서버·클라이언트 공용, 양보(yield) 없음)
--
-- Models.build(landmark): 에셋 없이 기본 파트(Block/Ball/Cylinder/Wedge)만으로 만든 임시 미니어처.
--   설계 공간: 바닥 가로·세로 10 스터드(원점 중심) 안, 높이 22 스터드 이하, 바닥 y = 0, 정면은 -Z 쪽.
--   투명한 "Root" 파트(10 x 0.2 x 10)가 바닥 중앙에 있고 PrimaryPart(피벗 = 바닥 중앙).
--   모든 파트 Anchored = true, CanCollide = false. 색은 명소의 Primary / Secondary / Accent, 재질은 Material.
-- Models.create(landmark, size, opts?): 실제로 쓰는 함수.
--   ReplicatedStorage.LandmarkModels 에 명소 Id 와 같은 이름의 Model 이 있으면 복제(AI 메쉬 교체용), 없으면 build().
--   가로·세로 중 큰 쪽이 size 스터드가 되도록 Model:ScaleTo(높이는 size * 2.2 까지). 피벗 = 바닥 중앙, 부모 없음.
--   opts.Anchored == false 면 모든 BasePart: Anchored/CanCollide/CanQuery/CanTouch 끔 + Massless(캐릭터에 용접할 때).

local Landmarks = require(script.Parent.Landmarks)

type Landmark = Landmarks.Landmark

local Models = {}

local DESIGN_WIDTH = 10 -- 설계 공간 가로·세로(스터드)
local MAX_HEIGHT_RATIO = 2.2 -- 높이 한도 = size * 2.2 (설계 공간 22 / 10)
local OVERRIDE_FOLDER = "LandmarkModels"

local V = Vector3.new
local rgb = Color3.fromRGB
local Mat = Enum.Material
local PI = math.pi
local TAU = math.pi * 2

local UPRIGHT = CFrame.Angles(0, 0, PI / 2) -- 원기둥(길이 축 = X)을 세움
local ALONG_Z = CFrame.Angles(0, PI / 2, 0) -- 원기둥 길이 축을 Z 로(정면을 보는 원판)
local CORNERS = { { 1, 1 }, { 1, -1 }, { -1, 1 }, { -1, -1 } }

-- 명소 색으로 표현하기 어려운 자연물/그늘 색
local GRASS = rgb(96, 168, 78)
local LEAF = rgb(58, 132, 62)
local WATER = rgb(60, 145, 225)
local DARK = rgb(38, 32, 30)
local TILE = rgb(62, 66, 74)
local ROCK = rgb(120, 114, 106)
local WOOD = rgb(105, 72, 48)
local SAND = rgb(226, 204, 156)
local CLOUD = rgb(248, 250, 255)
local BLACK = rgb(0, 0, 0)
local WHITE = rgb(255, 255, 255)

type Ctx = {
	model: Model,
	id: string, -- 명소 Id(같은 모형을 쓰는 명소끼리 작은 차이를 줄 때)
	origin: CFrame, -- 파트 좌표에 앞에서 곱하는 기준 좌표계(기울어진 탑 등)
	P: Color3, -- 주 색
	S: Color3, -- 보조 색
	A: Color3, -- 강조 색(빛/장식)
	M: Enum.Material, -- 주 재질
	grand: boolean, -- 불가사의 이상 등급: 같은 모형을 쓰는 흔한 명소보다 웅장하게
}

local function mix(a: Color3, b: Color3, t: number): Color3
	return Color3.new(a.R + (b.R - a.R) * t, a.G + (b.G - a.G) * t, a.B + (b.B - a.B) * t)
end

-- 파트 생성 헬퍼 ------------------------------------------------------------

local function add(
	c: Ctx,
	part: BasePart,
	cf: CFrame,
	size: Vector3,
	color: Color3,
	material: Enum.Material?,
	transparency: number?
): BasePart
	part.Anchored = true
	part.CanCollide = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Size = size
	part.CFrame = c.origin * cf
	part.Color = color
	part.Material = material or c.M
	part.Transparency = transparency or 0
	part.Parent = c.model
	return part
end

local function shaped(
	c: Ctx,
	shape: Enum.PartType,
	cf: CFrame,
	size: Vector3,
	color: Color3,
	material: Enum.Material?,
	transparency: number?
): BasePart
	local part = Instance.new("Part")
	part.Shape = shape -- 크기보다 먼저(공 모양은 크기가 균일해짐)
	return add(c, part, cf, size, color, material, transparency)
end

-- 중심 좌표계 cf 에 놓는 직육면체
local function block(c: Ctx, cf: CFrame, size: Vector3, color: Color3, material: Enum.Material?, transparency: number?)
	return shaped(c, Enum.PartType.Block, cf, size, color, material, transparency)
end

-- 바닥 중앙이 (x, y, z) 인 직육면체
local function box(
	c: Ctx,
	x: number,
	y: number,
	z: number,
	sx: number,
	sy: number,
	sz: number,
	color: Color3,
	material: Enum.Material?,
	transparency: number?
)
	return block(c, CFrame.new(x, y + sy / 2, z), V(sx, sy, sz), color, material, transparency)
end

-- 중심이 (x, y, z), 지름 d 인 공
local function ball(
	c: Ctx,
	x: number,
	y: number,
	z: number,
	d: number,
	color: Color3,
	material: Enum.Material?,
	transparency: number?
)
	return shaped(c, Enum.PartType.Ball, CFrame.new(x, y, z), V(d, d, d), color, material, transparency)
end

-- 길이 축이 cf 의 X 축인 원기둥
local function cyl(
	c: Ctx,
	cf: CFrame,
	length: number,
	d: number,
	color: Color3,
	material: Enum.Material?,
	transparency: number?
)
	return shaped(c, Enum.PartType.Cylinder, cf, V(length, d, d), color, material, transparency)
end

-- 바닥 중앙이 (x, y, z) 인 세운 원기둥(높이 h, 지름 d)
local function col(
	c: Ctx,
	x: number,
	y: number,
	z: number,
	h: number,
	d: number,
	color: Color3,
	material: Enum.Material?,
	transparency: number?
)
	return cyl(c, CFrame.new(x, y + h / 2, z) * UPRIGHT, h, d, color, material, transparency)
end

-- 쐐기: 높은 면이 +Z(뒤), 경사면이 -Z(앞, cf.LookVector) 쪽을 봄
local function wedge(c: Ctx, cf: CFrame, size: Vector3, color: Color3, material: Enum.Material?, transparency: number?)
	return add(c, Instance.new("WedgePart"), cf, size, color, material, transparency)
end

-- a 에서 b 까지 이어지는 각재(단면 t x t)
local function beam(
	c: Ctx,
	a: Vector3,
	b: Vector3,
	t: number,
	color: Color3,
	material: Enum.Material?,
	transparency: number?
)
	local delta = b - a
	local length = delta.Magnitude
	local mid = (a + b) / 2
	local cf
	if math.abs(delta.Y) > length * 0.999 then
		cf = CFrame.new(mid) * CFrame.Angles(PI / 2, 0, 0) -- 수직이면 lookAt 대신 직접 세움
	else
		cf = CFrame.lookAt(mid, b)
	end
	return block(c, cf, V(t, t, length), color, material, transparency)
end

-- (dx, dz) 쪽을 정면(LookVector)으로 보는 회전
local function facing(dx: number, dz: number): CFrame
	return CFrame.Angles(0, math.atan2(-dx, -dz), 0)
end

-- 개구부 위쪽 모서리를 채우는 쐐기(아치처럼 보이게). xWall = 벽면 x, side = -1(왼쪽 벽) / 1(오른쪽 벽)
local function archCorner(
	c: Ctx,
	xWall: number,
	yTop: number,
	z: number,
	leg: number,
	depth: number,
	color: Color3,
	side: number
)
	-- 뒤집은(roll 180도) 쐐기를 벽 쪽으로 돌림: 직각이 벽과 천장이 만나는 모서리에 옴
	local cf = CFrame.new(xWall - side * leg / 2, yTop - leg / 2, z)
		* CFrame.Angles(0, side * PI / 2, 0)
		* CFrame.Angles(0, 0, PI)
	return wedge(c, cf, V(depth, leg, leg), color)
end

-- 기와지붕: 처마 판 + 앞뒤 경사 + 용마루 + 네 귀퉁이 들린 추녀. 바닥이 y, 전체 높이 ≈ 0.3 + h + 0.2
local function roof(c: Ctx, x: number, y: number, z: number, w: number, d: number, h: number, color: Color3)
	box(c, x, y, z, w, 0.3, d, color)
	local top = y + 0.3
	wedge(c, CFrame.new(x, top + h / 2, z - d / 4), V(w - 0.3, h, d / 2), color)
	wedge(c, CFrame.new(x, top + h / 2, z + d / 4) * CFrame.Angles(0, PI, 0), V(w - 0.3, h, d / 2), color)
	box(c, x, top + h - 0.2, z, w - 0.2, 0.4, 0.45, mix(color, BLACK, 0.25))
	for _, s in CORNERS do
		local cf = CFrame.new(x + s[1] * (w / 2 - 0.35), top + 0.3, z + s[2] * (d / 2 - 0.35))
		wedge(c, cf * CFrame.Angles(0, math.atan2(s[1], s[2]), 0), V(0.55, 0.6, 1.1), color)
	end
end

-- 박공지붕(쐐기 두 개). 바닥이 y
local function gable(c: Ctx, x: number, y: number, z: number, w: number, d: number, h: number, color: Color3)
	wedge(c, CFrame.new(x, y + h / 2, z - d / 4), V(w, h, d / 2), color)
	wedge(c, CFrame.new(x, y + h / 2, z + d / 4) * CFrame.Angles(0, PI, 0), V(w, h, d / 2), color)
end

-- 나무: 줄기 + 잎 공
local function plant(c: Ctx, x: number, y: number, z: number, h: number, d: number, leaf: Color3)
	col(c, x, y, z, h, math.max(0.2, d * 0.22), WOOD, Mat.Wood)
	ball(c, x, y + h + d * 0.3, z, d, leaf, Mat.Grass)
end

-- 계단식 피라미드(steps 단). 꼭대기 높이를 돌려줌
local function stepped(
	c: Ctx,
	x: number,
	z: number,
	y: number,
	base: number,
	height: number,
	steps: number,
	color: Color3
)
	local stepHeight = height / steps
	for i = 0, steps - 1 do
		local w = base * (1 - i / steps)
		box(c, x, y + i * stepHeight, z, w, stepHeight, w, color)
	end
	return y + height
end

-- 시계 판: cf 는 벽면 중앙, -Z 가 바깥
local function clockFace(c: Ctx, cf: CFrame, d: number)
	cyl(c, cf * CFrame.new(0, 0, -0.1) * ALONG_Z, 0.2, d, c.A, Mat.Neon)
	block(c, cf * CFrame.new(0, d * 0.14, -0.25), V(d * 0.08, d * 0.3, 0.1), c.S)
	block(c, cf * CFrame.Angles(0, 0, -2.1) * CFrame.new(0, d * 0.2, -0.27), V(d * 0.06, d * 0.42, 0.1), c.S)
end

-- 모형들 ------------------------------------------------------------------

local BUILDERS: { [string]: (Ctx) -> () } = {}

-- 시계탑 / 빅벤: 기단 + 탑신 + 네 면 시계 + 종루 + 뾰족 지붕
function BUILDERS.clocktower(c)
	box(c, 0, 0, 0, 6, 0.6, 6, c.S)
	box(c, 0, 0.6, 0, 3.6, 10, 3.6, c.P)
	for _, s in CORNERS do
		box(c, s[1] * 1.8, 0.6, s[2] * 1.8, 0.6, 10, 0.6, c.S)
	end
	box(c, 0, 5.4, 0, 3.9, 0.3, 3.9, c.S)
	box(c, 0, 10.6, 0, 4.4, 3.6, 4.4, c.P)
	for i = 0, 3 do
		clockFace(c, CFrame.Angles(0, i * PI / 2, 0) * CFrame.new(0, 12.4, -2.2), 3)
	end
	box(c, 0, 14.2, 0, 5, 0.4, 5, c.S)
	box(c, 0, 14.6, 0, 3.6, 1.6, 3.6, c.P)
	for i = 0, 3 do
		block(c, CFrame.Angles(0, i * PI / 2, 0) * CFrame.new(0, 15.4, -1.8), V(1.8, 1, 0.1), DARK)
	end
	box(c, 0, 16.2, 0, 4, 0.3, 4, c.S)
	local y = 16.5
	for _, step in { { 3, 0.9 }, { 2.2, 0.9 }, { 1.4, 1 }, { 0.7, 1 } } do
		box(c, 0, y, 0, step[1], step[2], step[1], c.S)
		y += step[2]
	end
	col(c, 0, y, 0, 1, 0.25, c.A, Mat.Metal)
	ball(c, 0, y + 1.25, 0, 0.5, c.A, Mat.Neon)
end

-- 등대 / 알렉산드리아 등대: 줄무늬 탑(흔한 것) 또는 3단 석탑(불가사의) + 유리 등롱 + 불빛 줄기
function BUILDERS.lighthouse(c)
	local top
	if c.grand then
		box(c, 0, 0, 0, 9.6, 0.6, 9.6, c.S)
		box(c, 0, 0.6, 0, 6.4, 6.4, 6.4, c.P)
		for i = 0, 3 do
			block(c, CFrame.Angles(0, i * PI / 2, 0) * CFrame.new(0, 4.6, -3.2), V(0.6, 1.6, 0.1), DARK)
		end
		box(c, 0, 7, 0, 6.9, 0.5, 6.9, c.S)
		box(c, 0, 7.5, 0, 4.4, 4.2, 4.4, c.P)
		block(c, CFrame.new(0, 9.6, 0) * CFrame.Angles(0, PI / 4, 0), V(4.4, 4.2, 4.4), c.P)
		col(c, 0, 11.7, 0, 0.4, 5.2, c.S)
		col(c, 0, 12.1, 0, 3.8, 3.2, c.P)
		top = 15.9
	else
		col(c, 0, 0, 0, 0.8, 8.6, ROCK, Mat.Slate)
		box(c, 2.2, 0.8, 1.3, 2, 1.4, 1.8, c.P)
		gable(c, 2.2, 2.2, 1.3, 2.3, 2.1, 0.9, c.S)
		local y = 0.8
		for i = 0, 5 do
			col(c, 0, y, 0, 1.9, 3.4 - i * 0.18, if i % 2 == 0 then c.P else c.S)
			y += 1.9
		end
		top = y
	end
	col(c, 0, top, 0, 0.3, 3.8, c.S)
	col(c, 0, top + 0.3, 0, 1.8, 2.2, c.A, Mat.Glass, 0.45)
	ball(c, 0, top + 1.2, 0, 1.3, c.A, Mat.Neon)
	col(c, 0, top + 2.1, 0, 0.3, 2.6, c.S)
	col(c, 0, top + 2.4, 0, 0.6, 1.6, c.S)
	if c.grand then
		-- 꼭대기의 신상
		col(c, 0, top + 3, 0, 1.1, 0.5, c.P)
		ball(c, 0, top + 4.3, 0, 0.45, c.P)
	else
		col(c, 0, top + 3, 0, 0.5, 0.8, c.S)
		ball(c, 0, top + 3.7, 0, 0.5, c.A, Mat.Neon)
	end
	block(c, CFrame.new(0, top + 1.2, 0) * CFrame.Angles(0, math.rad(30), 0), V(9.4, 0.5, 0.5), c.A, Mat.Neon, 0.6)
end

-- 풍차: 잔디 + 원뿔형 탑 + 둥근 지붕 + 네 날개
function BUILDERS.windmill(c)
	col(c, 0, 0, 0, 0.4, 9.4, GRASS, Mat.Grass)
	col(c, 0, 0.4, 0, 3, 5.4, c.P)
	col(c, 0, 3.4, 0, 3, 4.8, c.P)
	col(c, 0, 6.4, 0, 3, 4.2, c.P)
	col(c, 0, 3.3, 0, 0.3, 6.2, c.S)
	ball(c, 0, 9.4, 0, 4.4, c.S)
	box(c, 0, 0.4, -2.65, 1.1, 1.8, 0.3, c.S)
	box(c, 0, 4.4, -2.35, 0.7, 0.9, 0.2, DARK)
	box(c, 0, 7.2, -2.05, 0.6, 0.8, 0.2, DARK)
	local hub = CFrame.new(0, 9.6, -2.4)
	cyl(c, hub * ALONG_Z, 1.2, 0.8, c.S)
	for i = 0, 3 do
		local arm = CFrame.new(0, 9.6, -3.1) * CFrame.Angles(0, 0, PI / 4 + i * PI / 2)
		block(c, arm * CFrame.new(0, 2.5, 0), V(0.25, 5, 0.25), c.S)
		block(c, arm * CFrame.new(0.55, 2.9, -0.05), V(0.9, 3.8, 0.1), c.A, nil, 0.05)
	end
end

-- 분수대: 팔각 수반 + 2단 물받이 + 물줄기(유리/네온)
function BUILDERS.fountain(c)
	col(c, 0, 0, 0, 0.3, 9.8, c.P)
	local r = 4
	local side = 2 * r * math.tan(PI / 8) + 0.1
	for i = 0, 7 do
		block(c, CFrame.Angles(0, i * PI / 4, 0) * CFrame.new(0, 0.85, -r), V(side, 1.1, 0.5), c.P)
	end
	col(c, 0, 0.3, 0, 0.6, 7.5, c.S, Mat.Glass, 0.25)
	col(c, 0, 0.3, 0, 3.2, 1.2, c.P)
	col(c, 0, 3.1, 0, 0.4, 2.6, c.P)
	col(c, 0, 3.5, 0, 0.5, 4.6, c.P)
	col(c, 0, 4, 0, 0.12, 4, c.S, Mat.Glass, 0.2)
	col(c, 0, 0.9, 0, 3, 4.5, c.A, Mat.Glass, 0.65)
	col(c, 0, 4, 0, 1.8, 0.7, c.P)
	col(c, 0, 5.8, 0, 0.35, 2.4, c.P)
	col(c, 0, 6.15, 0, 0.1, 2, c.S, Mat.Glass, 0.2)
	col(c, 0, 4.12, 0, 1.68, 2.3, c.A, Mat.Glass, 0.65)
	col(c, 0, 6.15, 0, 2.2, 0.35, c.A, Mat.Neon, 0.3)
	ball(c, 0, 8.4, 0, 1, c.A, Mat.Glass, 0.45)
	for i = 0, 3 do
		local rot = CFrame.Angles(0, i * PI / 2 + PI / 4, 0)
		beam(c, rot * V(0, 1.4, -3.4), rot * V(0, 2.8, -2.3), 0.2, c.A, Mat.Neon, 0.3)
	end
end

-- 개선문: 원형 광장 + 네 기둥(앞뒤·옆 아치) + 코니스 + 아틱
function BUILDERS.arch(c)
	col(c, 0, 0, 0, 0.2, 9.8, c.S)
	box(c, 0, 0.2, 0, 9.2, 0.35, 5, c.S)
	local y = 0.55
	for _, sx in { -1, 1 } do
		local x = sx * 3
		box(c, x, y, -1.55, 3.2, 7, 1.3, c.P)
		box(c, x, y, 1.55, 3.2, 7, 1.3, c.P)
		box(c, x, y + 4, 0, 3.2, 3, 1.8, c.P)
		box(c, x, y + 1.2, -2.25, 1.8, 2.2, 0.15, c.S)
		box(c, x, y + 1.2, 2.25, 1.8, 2.2, 0.15, c.S)
	end
	box(c, 0, y + 5.6, 0, 2.8, 1.4, 4.4, c.P)
	archCorner(c, -1.4, y + 5.6, 0, 1.1, 4.4, c.P, -1)
	archCorner(c, 1.4, y + 5.6, 0, 1.1, 4.4, c.P, 1)
	box(c, 0, 7.55, 0, 9.6, 0.5, 4.8, c.S)
	box(c, 0, 8.05, 0, 9.2, 1.9, 4.4, c.P)
	box(c, 0, 8.6, -2.22, 8.4, 0.35, 0.1, c.A, Mat.Metal)
	box(c, 0, 8.6, 2.22, 8.4, 0.35, 0.1, c.A, Mat.Metal)
	box(c, 0, 9.95, 0, 9.6, 0.3, 4.8, c.S)
	ball(c, 0, 0.75, 0, 0.4, c.A, Mat.Neon)
end

-- 숭례문: 홍예문이 뚫린 석축 + 붉은 문루 2층 + 들린 추녀의 기와지붕 2겹
function BUILDERS.gate(c)
	box(c, -2.8, 0, 0, 3.6, 3.6, 4.6, c.P)
	box(c, 2.8, 0, 0, 3.6, 3.6, 4.6, c.P)
	box(c, 0, 2.3, 0, 2, 1.3, 4.6, c.P)
	archCorner(c, -1, 2.3, 0, 0.7, 4.6, c.P, -1)
	archCorner(c, 1, 2.3, 0, 0.7, 4.6, c.P, 1)
	box(c, 0, 3.6, 0, 9.2, 0.25, 4.8, mix(c.P, WHITE, 0.2))
	box(c, 0, 3.85, 0, 7.4, 0.25, 3.6, WOOD, Mat.Wood)
	box(c, 0, 4.1, 0, 6.8, 1.6, 3, c.A)
	box(c, 0, 5.4, 0, 7, 0.35, 3.2, c.S)
	roof(c, 0, 5.75, 0, 9, 5, 1.3, TILE)
	box(c, 0, 6.6, 0, 5.6, 1.6, 2.4, c.A)
	box(c, 0, 7.3, -1.22, 0.9, 0.6, 0.1, DARK)
	box(c, 0, 8.2, 0, 5.8, 0.3, 2.6, c.S)
	roof(c, 0, 8.5, 0, 8.2, 4.4, 1.5, TILE)
end

-- 피사의 사탑: 잔디 광장 위에 기울어진 원통형 8층 탑
function BUILDERS.leaning(c)
	box(c, 0, 0, 0, 9.6, 0.25, 9.6, GRASS, Mat.Grass)
	col(c, 0, 0.25, 0, 0.4, 5, c.S)
	c.origin = CFrame.new(0, 0.65, 0) * CFrame.Angles(0, 0, math.rad(-7))
	col(c, 0, 0, 0, 2.2, 3.6, c.P)
	local y = 2.2
	for _ = 1, 6 do
		col(c, 0, y, 0, 0.25, 4, c.S)
		col(c, 0, y + 0.25, 0, 1.45, 3.4, c.P)
		y += 1.7
	end
	col(c, 0, y, 0, 0.25, 3.6, c.S)
	col(c, 0, y + 0.25, 0, 1.5, 2.6, c.P)
	col(c, 0, y + 1.75, 0, 0.3, 2.9, c.S)
	c.origin = CFrame.new()
end

-- 서 있는 인물의 상체(어깨 윗면 높이 y): 목, 머리, 햇살 왕관, 횃불 든 오른팔, 서판 든 왼팔
local function figureTop(c: Ctx, y: number)
	col(c, 0, y, 0, 0.5, 0.6, c.P)
	local head = V(0, y + 0.95, 0)
	ball(c, 0, head.Y, 0, 1.2, c.P)
	col(c, 0, head.Y + 0.2, 0, 0.25, 1.35, c.P)
	for k = -3, 3 do
		local angle = k * PI / 7
		local dir = V(math.sin(angle), 0.45, -math.cos(angle)).Unit
		beam(c, head + dir * 0.5, head + dir * 1.25, 0.14, c.P)
	end
	beam(c, V(1, y - 0.2, 0), V(1.5, y + 2.6, 0), 0.5, c.P)
	col(c, 1.5, y + 2.4, 0, 0.9, 0.35, c.P)
	col(c, 1.5, y + 3.2, 0, 0.3, 0.75, c.A, Mat.Metal)
	ball(c, 1.5, y + 3.85, 0, 0.8, c.A, Mat.Neon)
	beam(c, V(-1, y - 0.2, 0), V(-1.2, y - 2, -0.6), 0.45, c.P)
	block(c, CFrame.new(-1.35, y - 1.4, -0.4) * CFrame.Angles(0, 0, 0.12), V(0.3, 1.5, 1), c.P)
end

-- 자유의 여신상(별 모양 요새 + 받침대) / 로도스 거상(항구를 가로질러 두 다리로 선 청동상)
function BUILDERS.statue(c)
	if c.grand then
		box(c, 0, 0, 0, 9.8, 0.3, 9.8, WATER, Mat.Glass, 0.15)
		for _, sx in { -1, 1 } do
			box(c, sx * 3.3, 0, 0, 2.8, 1, 9.6, c.S)
			box(c, sx * 2.2, 1, 0, 2, 2.4, 2, c.S)
			beam(c, V(sx * 2.2, 3.3, 0), V(sx * 0.6, 8.3, 0), 0.9, c.P)
		end
		box(c, 0, 7.8, 0, 2, 1.2, 1.2, c.P)
		box(c, 0, 9, 0, 2.2, 2.4, 1.3, c.P)
		figureTop(c, 11.4)
	else
		box(c, 0, 0, 0, 6.8, 0.6, 6.8, c.S)
		block(c, CFrame.new(0, 0.3, 0) * CFrame.Angles(0, PI / 4, 0), V(6.8, 0.6, 6.8), c.S)
		box(c, 0, 0.6, 0, 4.2, 0.8, 4.2, c.S)
		box(c, 0, 1.4, 0, 3.4, 4, 3.4, c.S)
		box(c, 0, 5.4, 0, 3.9, 0.4, 3.9, c.S)
		col(c, 0, 5.8, 0, 2.8, 2.6, c.P)
		col(c, 0, 8.6, 0, 2.6, 2.2, c.P)
		box(c, 0, 10.8, 0, 2.3, 1.3, 1.3, c.P)
		figureTop(c, 12.1)
	end
end

-- 스카이타워: 오클랜드 도심 블록(도로 + 빌딩들 + 뒤쪽 스카이시티) 위에 바로 선 탑.
--   밑동의 네 다리 + 긴 탑신 + 아래가 벌어진 전망대(유리 2층 + 빛 띠) + 긴 안테나
local function skyTower(c: Ctx)
	box(c, 0, 0, 0, 9.8, 0.3, 9.8, rgb(96, 100, 108), Mat.Concrete)
	box(c, 0, 0.3, 0, 3.8, 0.08, 3.8, rgb(190, 188, 182), Mat.Concrete)
	local glass = rgb(120, 160, 200)
	-- 빌딩: { x, z, 가로, 높이, 세로, 색, 재질 }
	local buildings = {
		{ -3.3, 3.3, 2.8, 4.8, 2.6, glass, Mat.Glass },
		{ 3.3, 3.3, 2.8, 3.8, 2.6, rgb(215, 205, 185), Mat.Concrete },
		{ 3.5, -0.1, 2.2, 5.6, 2.4, mix(c.S, glass, 0.5), Mat.Glass },
		{ -3.5, -0.3, 2.2, 2.6, 2.6, rgb(200, 190, 175), Mat.Concrete },
		{ -3.4, -3.6, 2.4, 1.6, 2, rgb(225, 225, 220), Mat.Concrete },
		{ 3.4, -3.6, 2.4, 2.2, 2, mix(glass, WHITE, 0.3), Mat.Glass },
	}
	for _, b in buildings do
		box(c, b[1], 0.3, b[2], b[3], b[4], b[5], b[6], b[7])
	end
	box(c, 0, 0.3, 3.1, 3.4, 1.6, 2.6, mix(c.P, c.S, 0.35))
	for _, s in CORNERS do
		beam(c, V(s[1] * 1.1, 0.35, s[2] * 1.1), V(s[1] * 0.3, 3.2, s[2] * 0.3), 0.45, c.P)
	end
	col(c, 0, 0.3, 0, 11, 1.15, c.P)
	col(c, 0, 11.2, 0, 0.5, 1.9, c.P)
	col(c, 0, 11.7, 0, 0.5, 2.7, c.P)
	col(c, 0, 12.2, 0, 1.1, 3.2, c.S, Mat.Glass)
	col(c, 0, 12.6, 0, 0.3, 3.3, c.A, Mat.Neon)
	col(c, 0, 13.3, 0, 0.35, 3.4, c.P)
	col(c, 0, 13.65, 0, 0.7, 2.4, c.S, Mat.Glass)
	col(c, 0, 14.35, 0, 0.35, 2, c.P)
	col(c, 0, 14.7, 0, 1.2, 0.9, c.P)
	col(c, 0, 15.9, 0, 4.2, 0.45, c.P)
	col(c, 0, 20.1, 0, 1, 0.22, c.A)
	ball(c, 0, 21.3, 0, 0.4, c.A, Mat.Neon)
end

-- 남산타워: 계단식 초록 언덕 + 가느다란 탑신 + 전망대 원반 + 안테나 (스카이타워는 도심 블록 위 버전)
function BUILDERS.needle(c)
	if c.id == "skytower" then
		skyTower(c)
		return
	end
	col(c, 0, 0, 0, 1.2, 9.8, GRASS, Mat.Grass)
	col(c, 0.3, 1.2, 0.2, 1.1, 7.4, GRASS, Mat.Grass)
	col(c, 0.2, 2.3, 0.1, 1, 4.8, GRASS, Mat.Grass)
	for i = 0, 5 do
		local angle = i * TAU / 6 + 0.4
		local r = if i % 2 == 0 then 4.1 else 3.1
		ball(c, math.cos(angle) * r, if i % 2 == 0 then 1.6 else 2.6, math.sin(angle) * r, 1.1, LEAF, Mat.Grass)
	end
	col(c, 0, 3.3, 0, 1, 2.6, c.P)
	col(c, 0, 4.3, 0, 7.6, 1.1, c.P)
	col(c, 0, 11.9, 0, 0.4, 2.6, c.S)
	col(c, 0, 12.3, 0, 1.5, 3.2, c.S, Mat.Glass)
	col(c, 0, 12.8, 0, 0.35, 3.3, c.A, Mat.Neon)
	col(c, 0, 13.8, 0, 0.5, 3.4, c.P)
	col(c, 0, 14.3, 0, 0.8, 1.6, c.P)
	col(c, 0, 15.1, 0, 2.6, 0.6, c.P)
	col(c, 0, 17.7, 0, 1.8, 0.35, c.A)
	ball(c, 0, 19.7, 0, 0.45, c.A, Mat.Neon)
end

-- 에펠탑: 네 다리가 모이며 가늘어지는 격자 탑 + 다리 사이 아치 + 전망대 3곳
function BUILDERS.lattice(c)
	box(c, 0, 0, 0, 9.8, 0.2, 9.8, GRASS, Mat.Grass)
	local function legAt(y: number): number
		return 4 - 1.5 * (y - 0.5) / 3.7
	end
	for _, s in CORNERS do
		local sx, sz = s[1], s[2]
		beam(c, V(sx * 4, 0.5, sz * 4), V(sx * 2.5, 4.2, sz * 2.5), 0.9, c.P)
		beam(c, V(sx * 2.4, 4.6, sz * 2.4), V(sx * 1.3, 9.2, sz * 1.3), 0.6, c.P)
		beam(c, V(sx * 1.2, 9.6, sz * 1.2), V(sx * 0.35, 17, sz * 0.35), 0.4, c.P)
	end
	-- 다리 사이 아치(3토막)
	for i = 0, 3 do
		local rot = CFrame.Angles(0, i * PI / 2, 0)
		local low, high = legAt(1), legAt(3.2)
		local points = { V(-low, 1, -low), V(-1.7, 3.2, -high), V(1.7, 3.2, -high), V(low, 1, -low) }
		for k = 1, 3 do
			beam(c, rot * points[k], rot * points[k + 1], 0.35, c.S)
		end
	end
	box(c, 0, 4.2, 0, 6, 0.5, 6, c.S)
	box(c, 0, 4.05, 0, 6.2, 0.15, 6.2, c.A, Mat.Neon)
	box(c, 0, 9.2, 0, 3.3, 0.45, 3.3, c.S)
	box(c, 0, 9.05, 0, 3.5, 0.15, 3.5, c.A, Mat.Neon)
	box(c, 0, 13, 0, 1.9, 0.25, 1.9, c.S)
	box(c, 0, 17, 0, 1.3, 0.4, 1.3, c.S)
	box(c, 0, 17.4, 0, 0.8, 0.9, 0.8, c.P)
	col(c, 0, 18.3, 0, 2.6, 0.22, c.P)
	ball(c, 0, 21.05, 0, 0.45, c.A, Mat.Neon)
end

-- 콜로세움: 타원형 아케이드(기둥 + 층 띠), 앞쪽은 무너져 낮고 뒤쪽은 3층, 안쪽 관중석과 모래 경기장
function BUILDERS.ring(c)
	local a, b = 4.5, 3.7
	local count = 14
	local function point(i: number): Vector3
		local t = i / count * TAU
		return V(a * math.cos(t), 0, b * math.sin(t))
	end
	local function tall(i: number): boolean
		return i % count <= 8 -- 뒤쪽(+Z) 절반 남짓만 온전함
	end
	box(c, 0, 0, 0, 9.8, 0.2, 8.4, c.S)
	box(c, 0, 0.2, 0, 5.2, 0.15, 3.8, c.A)
	for i = 0, count - 1 do
		local t = i / count * TAU
		local p = point(i)
		local h = if tall(i) then 5.4 else 3.6
		local yaw = math.atan2(-b * math.cos(t), -a * math.sin(t))
		block(c, CFrame.new(p.X, 0.2 + h / 2, p.Z) * CFrame.Angles(0, yaw, 0), V(0.62, h, 0.7), c.P)
	end
	for j = 0, count / 2 - 1 do
		local i1, i2 = 2 * j, 2 * j + 2
		local p1, p2 = point(i1), point(i2)
		local levels = if tall(i1) and tall(i2) then { 1.9, 3.4, 5.2 } else { 1.9, 3.4 }
		for _, y in levels do
			local mid = (p1 + p2) / 2
			local cf = CFrame.lookAt(V(mid.X, y + 0.2, mid.Z), V(p2.X, y + 0.2, p2.Z))
			block(c, cf, V(0.75, 0.4, (p2 - p1).Magnitude + 0.3), c.P)
		end
	end
	-- 관중석(안쪽으로 기운 쐐기)
	local seats = 7
	for j = 0, seats - 1 do
		local t1, t2 = j / seats * TAU, (j + 1) / seats * TAU
		local q1 = V(3.5 * math.cos(t1), 0, 2.75 * math.sin(t1))
		local q2 = V(3.5 * math.cos(t2), 0, 2.75 * math.sin(t2))
		local mid = (q1 + q2) / 2
		local chord = q2 - q1
		local inward = V(chord.Z, 0, -chord.X).Unit
		if inward:Dot(mid) > 0 then
			inward = -inward
		end
		wedge(c, CFrame.new(mid.X, 1.2, mid.Z) * facing(inward.X, inward.Z), V(chord.Magnitude + 0.2, 2, 1.2), c.S)
	end
end

-- 타지마할: 대리석 기단 + 본당(아치 입구) + 양파 돔 + 작은 정자 4 + 첨탑 4 + 연못
function BUILDERS.dome(c)
	box(c, 0, 0, 0, 9.6, 1, 9.6, c.S)
	box(c, 0, 1, 0, 5.6, 4, 5.6, c.P)
	local portal = mix(c.S, BLACK, 0.3)
	for i = 0, 3 do
		block(c, CFrame.Angles(0, i * PI / 2, 0) * CFrame.new(0, 2.6, -2.8), V(2, 3, 0.12), portal)
	end
	col(c, 0, 5, 0, 1.2, 3.8, c.P)
	ball(c, 0, 8.2, 0, 4.8, c.P)
	ball(c, 0, 10.4, 0, 2.2, c.P)
	col(c, 0, 11.3, 0, 1.3, 0.25, c.A, Mat.Metal)
	ball(c, 0, 12.75, 0, 0.4, c.A, Mat.Neon)
	for _, s in CORNERS do
		local x, z = s[1] * 2, s[2] * 2
		col(c, x, 5, z, 0.8, 0.9, c.P)
		ball(c, x, 6.05, z, 1, c.P)
	end
	for _, s in CORNERS do
		local x, z = s[1] * 4.2, s[2] * 4.2
		col(c, x, 1, z, 8, 0.8, c.P)
		col(c, x, 4.4, z, 0.2, 1.2, c.S)
		col(c, x, 9, z, 0.3, 1.2, c.S)
		ball(c, x, 9.75, z, 0.9, c.P)
	end
	box(c, 0, 1, -3.9, 0.9, 0.08, 1.7, WATER, Mat.Glass, 0.1)
end

-- 앙코르와트: 해자 + 섬 + 3단 기단 + 정면 계단 + 연꽃 봉오리 탑 5개(가운데가 가장 높음)
function BUILDERS.temple(c)
	box(c, 0, 0, 0, 9.8, 0.25, 9.8, WATER, Mat.Glass, 0.1)
	box(c, 0, 0.25, 0, 8.4, 0.3, 8.4, c.S)
	box(c, 0, 0.25, -4.55, 1.2, 0.3, 0.7, c.P)
	box(c, 0, 0.55, 0, 7.2, 1, 7.2, c.P)
	box(c, 0, 1.55, 0, 5.6, 1.1, 5.6, c.P)
	box(c, 0, 2.65, 0, 4, 1.2, 4, c.P)
	wedge(c, CFrame.new(0, 0.55 + 1.65, -3.1), V(1, 3.3, 2.2), c.A)
	local function lotus(x: number, z: number, base: number, tiers: number)
		local y = 3.85
		box(c, x, y, z, base, base * 0.8, base, c.P)
		y += base * 0.8
		for k = 1, tiers do
			local w = base * (1 - k / (tiers + 1.5))
			local h = base * 0.55
			box(c, x, y, z, w, h, w, c.P)
			y += h
		end
		ball(c, x, y + 0.1, z, base * 0.28, c.A)
	end
	lotus(0, 0, 1.8, 4)
	for _, s in CORNERS do
		lotus(s[1] * 1.35, s[2] * 1.35, 1.2, 3)
	end
	plant(c, -3.9, 0.55, -3.9, 1.4, 1.1, LEAF)
	plant(c, 3.9, 0.55, -3.9, 1.4, 1.1, LEAF)
end

-- 스핑크스: 엎드린 사자 몸 + 앞발 + 사람 머리(네메스 두건, 파란 줄무늬)
function BUILDERS.sphinx(c)
	box(c, 0, 0, 0, 9.8, 0.3, 7, c.S)
	local y = 0.3
	box(c, 0, y, 1.5, 2.8, 1.9, 5.4, c.P)
	cyl(c, CFrame.new(0, 2, 1.6) * ALONG_Z, 5, 2.8, c.P)
	ball(c, -1, y + 1.4, 3.2, 2.2, c.P)
	ball(c, 1, y + 1.4, 3.2, 2.2, c.P)
	box(c, 0, y, -1.9, 2.6, 3.1, 1.6, c.P)
	box(c, -0.85, y, -3.5, 0.8, 0.7, 2.6, c.P)
	box(c, 0.85, y, -3.5, 0.8, 0.7, 2.6, c.P)
	box(c, 0, 3.3, -1.95, 1.5, 1.9, 1.5, c.P)
	box(c, 0, 3.6, -1.6, 2.2, 2, 1.5, c.S)
	box(c, -0.95, 2.6, -2.75, 0.5, 1.6, 0.6, c.S)
	box(c, 0.95, 2.6, -2.75, 0.5, 1.6, 0.6, c.S)
	for _, sx in { -1, 1 } do
		box(c, sx * 1.12, 3.9, -1.6, 0.05, 0.25, 1.4, c.A)
		box(c, sx * 1.12, 4.5, -1.6, 0.05, 0.25, 1.4, c.A)
		box(c, sx * 0.35, 4.45, -2.72, 0.3, 0.15, 0.08, DARK)
	end
	box(c, 1.55, y, 2.8, 0.3, 0.3, 2.4, c.P)
end

-- 만리장성: 초록 봉우리 두 개를 넘어 지그재그로 이어지는 성벽(앞쪽 성가퀴, 뒤쪽 여장) + 봉우리 망루 + 골짜기 초소
function BUILDERS.wall(c)
	local ground = 0.3
	box(c, 0, 0, 0, 9.8, ground, 9.8, mix(c.S, WHITE, 0.25), Mat.Grass)
	local path = {
		V(-3.6, ground, -2),
		V(-1.9, 2.4, 0.2),
		V(0.1, ground, -1),
		V(2.2, 3, 1.4),
		V(3.7, ground, -0.8),
	}
	local dark = mix(c.P, BLACK, 0.2)
	for k = 1, #path - 1 do
		local p1, p2 = path[k], path[k + 1]
		-- 성벽 아래 비탈(쐐기): 높은 면이 봉우리 쪽
		local high, low = p2, p1
		if p1.Y > p2.Y then
			high, low = p1, p2
		end
		local flat = V(high.X - low.X, 0, high.Z - low.Z)
		local rise = high.Y - ground
		local mid = V((high.X + low.X) / 2, ground + rise / 2, (high.Z + low.Z) / 2)
		wedge(c, CFrame.lookAt(mid, mid - flat), V(2.8, rise, flat.Magnitude), c.S, Mat.Grass)
		-- 성벽 몸체 + 뒤쪽 여장 + 앞쪽 성가퀴 3개 (경로가 +X 로 가므로 로컬 -X 가 정면)
		local cf = CFrame.lookAt((p1 + p2) / 2, p2)
		local length = (p2 - p1).Magnitude + 0.3
		block(c, cf * CFrame.new(0, 0.5, 0), V(1.1, 1, length), c.P)
		block(c, cf * CFrame.new(0.46, 1.15, 0), V(0.18, 0.3, length), dark)
		for _, t in { -1, 0, 1 } do
			block(c, cf * CFrame.new(-0.46, 1.2, t * length / 3.2), V(0.18, 0.4, 0.45), dark)
		end
	end
	-- 봉우리 망루(깃발) + 골짜기 초소
	for _, k in { 2, 4 } do
		local p = path[k]
		box(c, p.X, p.Y - 0.3, p.Z, 1.7, 2, 1.7, c.P)
		box(c, p.X, p.Y + 1.7, p.Z, 2, 0.35, 2, dark)
		col(c, p.X + 0.6, p.Y + 2.05, p.Z + 0.6, 1.2, 0.1, DARK)
		box(c, p.X + 0.9, p.Y + 2.8, p.Z + 0.6, 0.6, 0.4, 0.05, c.A)
	end
	box(c, path[3].X, ground, path[3].Z, 1.4, 1.5, 1.4, c.P)
	box(c, path[3].X, ground + 1.5, path[3].Z, 1.6, 0.3, 1.6, dark)
	ball(c, -3.6, 0.9, 2.8, 1.2, LEAF, Mat.Grass)
	ball(c, 3.7, 0.9, 3.4, 1.3, LEAF, Mat.Grass)
	ball(c, 1, 0.8, -3.8, 1, LEAF, Mat.Grass)
end

-- 기자 피라미드: 모래 바닥 + 크기가 다른 계단식 피라미드 3개(금빛 꼭대기) + 야자수
function BUILDERS.pyramid(c)
	box(c, 0, 0, 0, 9.8, 0.3, 9.8, c.S, Mat.Sand)
	local top = stepped(c, -2.4, 1.4, 0.3, 4.8, 3.9, 8, c.P)
	box(c, -2.4, top, 1.4, 0.4, 0.3, 0.4, c.A, Mat.Neon)
	top = stepped(c, 2.1, 0.9, 0.3, 4.2, 3.4, 7, c.P)
	box(c, 2.1, top, 0.9, 0.35, 0.3, 0.35, c.A, Mat.Neon)
	stepped(c, 0.4, -3.3, 0.3, 2.6, 2.1, 5, mix(c.P, c.S, 0.5))
	plant(c, -3.9, 0.3, -2.4, 1.6, 1.1, LEAF)
	plant(c, -2.9, 0.3, -3.8, 1.2, 0.9, LEAF)
end

-- 치첸이트사 / 엘도라도: 9단 계단 피라미드 + 사면 계단 + 꼭대기 신전 (+ 불가사의 등급은 황금 태양)
function BUILDERS.steps(c)
	box(c, 0, 0, 0, 9.8, 0.25, 9.8, c.S, Mat.Grass)
	local y = 0.25
	for i = 0, 8 do
		local w = 7.8 - i * 0.55
		box(c, 0, y, 0, w, 0.72, w, c.P)
		y += 0.72
	end
	local rise = y - 0.25
	for i = 0, 3 do
		local rot = CFrame.Angles(0, i * PI / 2, 0)
		wedge(c, rot * CFrame.new(0, 0.25 + rise / 2, -3.15), V(1.4, rise, 2.9), c.A)
	end
	box(c, -0.85, 0.25, -4.45, 0.35, 0.5, 0.35, c.A)
	box(c, 0.85, 0.25, -4.45, 0.35, 0.5, 0.35, c.A)
	box(c, 0, y, 0, 2.6, 1.7, 2.6, c.P)
	box(c, 0, y + 1.7, 0, 3, 0.35, 3, c.P)
	box(c, 0, y, -1.28, 1, 1.1, 0.1, DARK)
	box(c, 0, y, 1.28, 1, 1.1, 0.1, DARK)
	for _, s in CORNERS do
		plant(c, s[1] * 4.3, 0.25, s[2] * 4.3, 1, 1.2, c.S)
	end
	if c.grand then
		cyl(c, CFrame.new(0, y + 3.6, 0) * ALONG_Z, 0.3, 2.4, c.A, Mat.Neon)
		for _, s in CORNERS do
			ball(c, s[1] * 1.3, y + 0.35, s[2] * 1.3, 0.5, c.A, Mat.Neon)
		end
	end
end

-- 마추픽추: 앞으로 내려가는 계단식 밭 + 뒤쪽의 뾰족한 와이나픽추 봉우리 + 돌집 유적
function BUILDERS.terraces(c)
	box(c, 0, 0, 0, 9.8, 0.25, 9.8, mix(c.S, BLACK, 0.2), Mat.Grass)
	for i = 0, 4 do
		local top = 3.4 - i * 0.65
		local front = -0.6 - i * 0.95
		local depth = 4.7 - front
		local w = 9.2 - i * 0.6
		local z = (front + 4.7) / 2
		box(c, 0, 0.25, z, w, top - 0.45, depth, c.P)
		box(c, 0, top - 0.2, z, w, 0.2, depth, c.S, Mat.Grass)
	end
	-- 와이나픽추: 조금씩 비틀어 쌓은 바위 덩어리로 만든 가파른 봉우리(위로 갈수록 바위색)
	local crags = {
		{ 3.8, 3, 3.4, 0.3 },
		{ 3, 2.7, 2.8, -0.35 },
		{ 2.2, 2.5, 2.1, 0.55 },
		{ 1.4, 2, 1.4, -0.2 },
		{ 0.7, 1, 0.7, 0.4 },
	}
	local y = 3.2
	for k, crag in crags do
		local color = mix(c.S, c.P, (k - 1) / 4)
		local cf = CFrame.new(2.2 + k * 0.1, y + crag[2] / 2, 2.3 + k * 0.05) * CFrame.Angles(0.06, crag[4], -0.05)
		block(c, cf, V(crag[1], crag[2], crag[3]), color, if k < 4 then Mat.Grass else nil)
		y += crag[2] * 0.85
	end
	box(c, -3.2, 3.4, 0.6, 1.6, 0.8, 1.2, c.P)
	box(c, -1.4, 3.4, 1.5, 1.2, 0.9, 1.6, c.P)
	box(c, -3, 3.4, 3.3, 1.8, 1, 1.4, c.P)
	box(c, -0.6, 3.4, 3.8, 1, 0.7, 1, c.P)
	box(c, -1.2, 3.4, -0.1, 1.3, 0.9, 1, c.P)
	gable(c, -1.2, 4.3, -0.1, 1.5, 1.2, 0.7, rgb(180, 150, 90))
end

-- 페트라(알카즈네): 붉은 절벽 + 협곡 벽 + 바위를 깎은 2층 신전 정면(기둥, 박공, 원형 정자)
function BUILDERS.facade(c)
	box(c, 0, 0, 0, 9.8, 0.25, 9.8, mix(c.P, SAND, 0.6), Mat.Sand)
	box(c, 0, 0.25, 3.2, 9.8, 14, 3.2, c.S)
	block(c, CFrame.new(-2.5, 14.6, 3.4) * CFrame.Angles(0, 0, 0.3), V(4.2, 2.2, 2.6), c.S)
	block(c, CFrame.new(2.6, 14.9, 3) * CFrame.Angles(0.2, 0, -0.25), V(3.6, 2.6, 2.4), c.S)
	box(c, -4.35, 0.25, 0.5, 1.1, 11, 2.2, c.S)
	box(c, 4.35, 0.25, 0.5, 1.1, 12, 2.2, c.S)
	-- 아래층: 기둥 6개 + 엔타블러처 + 박공 + 입구
	box(c, 0, 0.25, 1.1, 6.6, 0.45, 1.3, c.P)
	for k = 0, 5 do
		col(c, -2.75 + k * 1.1, 0.7, 0.85, 4.3, 0.55, c.P)
	end
	box(c, 0, 5, 1, 6.8, 0.7, 1.2, c.P)
	wedge(c, CFrame.new(-1.15, 6.3, 1) * CFrame.Angles(0, PI / 2, 0), V(1, 1.2, 2.3), c.P)
	wedge(c, CFrame.new(1.15, 6.3, 1) * CFrame.Angles(0, -PI / 2, 0), V(1, 1.2, 2.3), c.P)
	box(c, 0, 0.7, 1.57, 1.3, 2.6, 0.06, DARK)
	-- 위층: 양쪽 누각(반쪽 박공) + 가운데 원형 정자와 항아리
	box(c, 0, 6.9, 1, 6.8, 0.4, 1.2, c.P)
	for _, sx in { -1, 1 } do
		box(c, sx * 2.6, 7.3, 1, 1.6, 3, 1, c.P)
		wedge(c, CFrame.new(sx * 2.6, 10.7, 1) * CFrame.Angles(0, -sx * PI / 2, 0), V(1, 0.8, 1.6), c.P)
	end
	col(c, 0, 7.3, 1, 3.2, 1.9, c.P)
	col(c, 0, 10.5, 1, 0.35, 2.3, c.P)
	col(c, 0, 10.85, 1, 0.8, 1.4, c.P)
	ball(c, 0, 12, 1, 0.7, c.A)
end

-- 모아이: 잔디 + 뒤쪽 바다 + 제단(아후) 위에 긴 얼굴의 석상 5개(일부는 붉은 모자 푸카오)
function BUILDERS.moai(c)
	box(c, 0, 0, -0.95, 9.8, 0.3, 7.9, c.S, Mat.Grass)
	box(c, 0, 0, 3.95, 9.8, 0.2, 1.9, WATER, Mat.Glass, 0.1)
	box(c, 0, 0.3, 1.2, 9.6, 0.8, 2.2, mix(c.P, WHITE, 0.15))
	local xs = { -3.7, -1.85, 0, 1.85, 3.7 }
	local scales = { 0.9, 1, 1.12, 1, 0.92 }
	for k, x in xs do
		local s = scales[k]
		local y = 1.1
		box(c, x, y, 1.2, 1.3 * s, 1.5 * s, s, c.P)
		local headY = y + 1.5 * s
		local depth = 1.05 * s
		local front = 1.25 - depth / 2
		box(c, x, headY, 1.25, 1.15 * s, 2.3 * s, depth, c.P)
		box(c, x, headY + 1.35 * s, front - 0.1, 1.2 * s, 0.35 * s, 0.35 * s, c.P)
		wedge(c, CFrame.new(x, headY + 0.85 * s, front - 0.2 * s), V(0.35 * s, 0.9 * s, 0.4 * s), c.P)
		for _, sx in { -1, 1 } do
			box(c, x + sx * (0.575 * s + 0.05), headY + 0.8 * s, 1.25, 0.12, 1 * s, 0.35 * s, c.P)
		end
		if k % 2 == 1 then
			col(c, x, headY + 2.3 * s, 1.25, 0.55 * s, s, c.A)
		end
	end
end

-- 스톤헨지: 둥근 잔디 + 상인방을 얹은 바깥 원(일부 무너짐) + 안쪽 말굽 모양 삼석탑 5개 + 제단석 + 힐스톤
function BUILDERS.stones(c)
	col(c, 0, 0, 0, 0.25, 9.8, c.S, Mat.Grass)
	local y = 0.25
	local r = 3.9
	local count = 12
	local missing = { [4] = true, [9] = true }
	for i = 0, count - 1 do
		if not missing[i] then
			block(c, CFrame.Angles(0, i / count * TAU, 0) * CFrame.new(0, y + 1.1, -r), V(0.75, 2.2, 0.5), c.P)
		end
	end
	local chord = 2 * r * math.sin(PI / count) + 0.5
	for _, i in { 0, 1, 2, 5, 6, 10, 11 } do
		local cf = CFrame.Angles(0, (i + 0.5) / count * TAU, 0) * CFrame.new(0, y + 2.4, -r * math.cos(PI / count))
		block(c, cf, V(chord, 0.4, 0.5), c.P)
	end
	block(c, CFrame.Angles(0, 4 / count * TAU, 0) * CFrame.new(0, y + 0.25, -r), V(2, 0.5, 0.75), c.P)
	-- 안쪽 말굽(정면 -Z 쪽이 열림)
	for k, angle in { PI, PI - 0.9, PI + 0.9, PI - 1.8, PI + 1.8 } do
		local h = if k == 1 then 3.2 elseif k <= 3 then 2.8 else 2.5
		local frame = CFrame.Angles(0, angle, 0) * CFrame.new(0, y, -2)
		block(c, frame * CFrame.new(-0.45, h / 2, 0), V(0.55, h, 0.5), c.P)
		block(c, frame * CFrame.new(0.45, h / 2, 0), V(0.55, h, 0.5), c.P)
		block(c, frame * CFrame.new(0, h + 0.2, 0), V(1.6, 0.4, 0.55), c.P)
	end
	box(c, 0, y, 0.6, 1.4, 0.25, 0.5, mix(c.P, BLACK, 0.2))
	block(c, CFrame.new(0.9, y + 0.9, -4.6) * CFrame.Angles(0, 0, 0.12), V(0.7, 1.8, 0.5), c.P)
end

-- 바빌론 공중정원: 4단 테라스(그늘진 회랑 띠) + 초록 정원 + 늘어진 덩굴 + 정면 폭포 + 연못
function BUILDERS.gardens(c)
	box(c, 0, 0, 0, 9.8, 0.3, 9.8, mix(c.P, WHITE, 0.15))
	box(c, 0, 0.3, -4.4, 4, 0.12, 0.9, c.A, Mat.Glass, 0.2)
	local sizes = { 8.2, 6.4, 4.6, 2.8 }
	local shade = mix(c.P, BLACK, 0.45)
	local y = 0.3
	for i, w in sizes do
		box(c, 0, y, 0, w, 2, w, c.P)
		box(c, 0, y + 0.5, 0, w + 0.06, 0.8, w + 0.06, shade)
		box(c, 0, y + 2, 0, w - 0.2, 0.25, w - 0.2, c.S, Mat.Grass)
		box(c, 0, y, -w / 2 - 0.08, 0.9, 2.3, 0.12, c.A, Mat.Neon, 0.35)
		if i < #sizes then
			for _, sx in { -1, 1 } do
				box(c, sx * w * 0.3, y + 0.9, -w / 2 - 0.08, 0.6, 1.35, 0.15, c.S, Mat.Grass)
				ball(c, sx * (w / 2 - 0.45), y + 2.6, -(w / 2 - 0.45), 0.9, c.S, Mat.Grass)
			end
		end
		y += 2
	end
	box(c, 0, y + 0.25, 0, 1.2, 1.2, 1.2, c.P)
	plant(c, 0.9, y + 0.25, 0.9, 1.6, 1.2, c.S)
end

-- 바벨탑: 점점 좁아지는 원통 5층(어두운 회랑 + 밝은 난간) + 층 사이를 감아 오르는 경사로 + 미완성 꼭대기
function BUILDERS.spiral(c)
	local diameters = { 9.4, 7.6, 5.8, 4, 2.4 }
	local h = 3
	local shade = mix(c.S, BLACK, 0.2)
	for k, d in diameters do
		local y = (k - 1) * h
		col(c, 0, y, 0, h, d, shade)
		col(c, 0, y + h - 0.45, 0, 0.45, d + 0.1, c.P)
		col(c, 0, y, 0, 0.5, d + 0.1, c.P)
	end
	-- 경사로: 층 k 의 윗면(난간 고리)에서 한 바퀴 돌며 다음 층 윗면까지 올라감
	for k = 1, #diameters - 1 do
		local outer, inner = diameters[k] / 2, diameters[k + 1] / 2
		local segments = 9 - k
		local r = (outer + inner) / 2 / math.cos(PI / segments)
		local base = k * h
		for j = 0, segments - 1 do
			local t1 = (j / segments + k * 0.3) * TAU
			local t2 = ((j + 1) / segments + k * 0.3) * TAU
			local p1 = V(r * math.cos(t1), base + j / segments * h, r * math.sin(t1))
			local p2 = V(r * math.cos(t2), base + (j + 1) / segments * h, r * math.sin(t2))
			local cf = CFrame.lookAt((p1 + p2) / 2, p2)
			block(c, cf * CFrame.new(0, 0.15, 0), V(0.7, 0.3, (p2 - p1).Magnitude + 0.1), c.P)
		end
	end
	local top = #diameters * h
	box(c, -0.4, top, 0.3, 1, 1.4, 0.9, c.P)
	block(c, CFrame.new(0.5, top + 0.4, -0.3) * CFrame.Angles(0, 0.4, 0.2), V(0.8, 0.8, 0.8), c.P)
end

-- 무 대륙: 가라앉는 밀림 대륙(바다 + 얕은 여울 + 두 덩어리 땅) + 가운데 계단식 석조 신전(금 지붕, 금빛 태양 원반)
--   + 금빛 화로 + 밀림 나무 + 물에 잠겨 가는 무너진 돌기둥과 돌문
local function lostContinent(c: Ctx)
	local jungle = rgb(62, 140, 70)
	col(c, 0, 0, 0, 0.3, 9.8, c.S, Mat.Glass, 0.1)
	col(c, 0, 0, 0, 0.35, 8.8, mix(c.S, WHITE, 0.3), Mat.Glass, 0.1)
	col(c, 0.3, 0, 0.5, 0.75, 7.2, c.P)
	col(c, 0.3, 0.75, 0.5, 0.2, 6.9, jungle, Mat.Grass)
	col(c, -2.5, 0, -2.2, 0.55, 3.2, c.P)
	col(c, -2.5, 0.55, -2.2, 0.15, 2.9, jungle, Mat.Grass)
	local ground = 0.95
	local tx, tz = 0.4, 0.9
	local y = ground
	for _, tier in { { 4.4, 0.8 }, { 3.5, 0.8 }, { 2.6, 0.8 }, { 1.8, 0.7 } } do
		box(c, tx, y, tz, tier[1], tier[2], tier[1], c.P)
		y += tier[2]
	end
	wedge(c, CFrame.new(tx, (ground + y) / 2, tz - 1.95), V(1, y - ground, 2.1), mix(c.P, WHITE, 0.2))
	for _, s in CORNERS do
		ball(c, tx + s[1] * 1.55, ground + 1.8, tz + s[2] * 1.55, 0.4, c.A, Mat.Neon)
	end
	box(c, tx, y, tz + 0.1, 1.3, 1, 1.2, mix(c.P, WHITE, 0.12))
	box(c, tx, y, tz - 0.51, 0.45, 0.7, 0.05, DARK)
	box(c, tx, y + 1, tz + 0.1, 1.6, 0.2, 1.5, c.A, Mat.Metal)
	box(c, tx, y + 1.2, tz + 0.1, 0.9, 0.3, 0.9, c.A, Mat.Metal)
	cyl(c, CFrame.new(tx, y + 1.95, tz + 0.1) * ALONG_Z, 0.12, 0.9, c.A, Mat.Neon)
	-- 밀림: { x, z, 줄기 높이, 잎 지름, 바닥 높이 }
	for k, t in
		{
			{ -2.6, 2.7, 1.4, 1.6, ground },
			{ 2.9, 2.8, 1.2, 1.4, ground },
			{ 3.2, -0.9, 1.6, 1.5, ground },
			{ -2.8, 0.4, 1.1, 1.3, ground },
			{ -2.6, -2.3, 1.2, 1.3, 0.7 },
			{ 2.1, -2.2, 1, 1.2, ground },
		}
	do
		plant(c, t[1], t[5], t[2], t[3], t[4], if k % 2 == 0 then LEAF else jungle)
	end
	ball(c, -1, ground + 0.15, 3.3, 1, LEAF, Mat.Grass)
	ball(c, 3.3, ground + 0.1, 1.2, 0.9, jungle, Mat.Grass)
	ball(c, -1.4, 0.8, -3, 0.8, LEAF, Mat.Grass)
	-- 물에 잠겨 가는 유적
	block(c, CFrame.new(3, 0.95, -3.1) * CFrame.Angles(0.25, 0.3, 0.35), V(0.55, 1.6, 0.55), c.P)
	col(c, 3.9, 0, -1.9, 0.9, 0.5, c.P)
	box(c, -3.9, 0, 1, 0.45, 1.5, 0.45, c.P)
	box(c, -3.9, 0, 2.2, 0.45, 1.2, 0.45, c.P)
	block(c, CFrame.new(-3.9, 1.55, 1.6) * CFrame.Angles(0.12, 0, 0), V(0.55, 0.35, 1.8), c.P)
end

-- 아틀란티스: 물과 땅이 번갈아 도는 동심원 섬 + 가운데 원형 신전(빛나는 수정 첨탑) + 흰 탑 6개 + 다리
-- (무 대륙은 밀림 + 계단식 석조 신전 버전)
function BUILDERS.island(c)
	if c.id == "mu" then
		lostContinent(c)
		return
	end
	col(c, 0, 0, 0, 0.3, 9.8, c.S, Mat.Glass, 0.1)
	col(c, 0, 0, 0, 0.55, 8.4, c.P)
	col(c, 0, 0, 0, 0.6, 6.8, c.S, Mat.Glass, 0.1)
	col(c, 0, 0, 0, 0.8, 5.4, GRASS, Mat.Grass)
	col(c, 0, 0, 0, 0.85, 4, c.S, Mat.Glass, 0.1)
	col(c, 0, 0, 0, 1.2, 2.8, c.P)
	box(c, 0, 0.6, -2.45, 0.5, 0.15, 2.3, c.P)
	col(c, 0, 1.2, 0, 0.3, 2.4, c.P)
	for i = 0, 5 do
		local angle = i * TAU / 6
		col(c, 0.9 * math.cos(angle), 1.5, 0.9 * math.sin(angle), 1.5, 0.25, c.P)
	end
	col(c, 0, 1.5, 0, 1.5, 0.9, c.A, Mat.Neon)
	col(c, 0, 3, 0, 0.3, 2.4, c.P)
	ball(c, 0, 3.3, 0, 1.9, c.P)
	col(c, 0, 4.1, 0, 2.6, 0.35, c.A, Mat.Neon)
	ball(c, 0, 6.8, 0, 0.6, c.A, Mat.Neon)
	for i = 0, 5 do
		local angle = i * TAU / 6 + PI / 6
		local x, z = 3.8 * math.cos(angle), 3.8 * math.sin(angle)
		col(c, x, 0.55, z, 1.8, 0.55, c.P)
		ball(c, x, 2.5, z, 0.45, c.A, Mat.Neon)
	end
end

-- 용궁 / 샹그릴라: 계단 기단 위 3층 전각(들린 추녀 기와지붕) + 꼭대기 보주 + 등롱 + 떠다니는 빛 구슬
function BUILDERS.pagoda(c)
	box(c, 0, 0, 0, 9.6, 0.6, 9.6, c.S)
	box(c, 0, 0.6, 0, 7.4, 0.4, 7, mix(c.P, WHITE, 0.5))
	wedge(c, CFrame.new(0, 0.5, -4.2), V(1.6, 1, 1.2), mix(c.P, WHITE, 0.5))
	box(c, 0, 1, 0, 6, 2, 5.2, c.P)
	box(c, 0, 1, -2.62, 1.4, 1.5, 0.1, DARK)
	roof(c, 0, 3, 0, 8.4, 7.2, 1.4, c.S)
	box(c, 0, 4.2, 0, 4.4, 1.9, 3.8, c.P)
	roof(c, 0, 6.1, 0, 6.6, 5.6, 1.3, c.S)
	box(c, 0, 7.2, 0, 3, 1.7, 2.6, c.P)
	roof(c, 0, 8.9, 0, 4.8, 4, 1.2, c.S)
	col(c, 0, 10.3, 0, 1.4, 0.3, c.A, Mat.Metal)
	ball(c, 0, 12, 0, 0.7, c.A, Mat.Neon)
	for _, sx in { -1, 1 } do
		col(c, sx * 4.2, 0.6, -4.2, 1.2, 0.2, DARK)
		ball(c, sx * 4.2, 2, -4.2, 0.5, c.A, Mat.Neon)
	end
	ball(c, -4.1, 7.5, 1.5, 0.9, c.A, Mat.Glass, 0.5)
	ball(c, 4.2, 9.2, -0.8, 0.7, c.A, Mat.Glass, 0.5)
	ball(c, 3.6, 11.4, 2.4, 0.6, c.A, Mat.Glass, 0.5)
end

-- 하늘섬: 땅에 닿지 않고 떠 있는 바위섬(아래로 뾰족) + 잔디 + 나무 + 연못과 폭포 + 구름 + 작은 신전
function BUILDERS.skyisland(c)
	local rock = Mat.Slate
	col(c, 0, 7.2, 0, 1.2, 9, c.S, rock)
	col(c, 0.3, 5.8, -0.2, 1.4, 7, c.S, rock)
	col(c, -0.2, 4.4, 0.3, 1.4, 5, c.S, rock)
	col(c, 0.2, 3.1, 0.1, 1.3, 3, c.S, rock)
	ball(c, 0.1, 2.8, 0.1, 1.6, c.S, rock)
	ball(c, -2.6, 6.8, 1.6, 2.4, c.S, rock)
	ball(c, 2.4, 6.2, -1.8, 2.2, c.S, rock)
	col(c, 0, 8.4, 0, 0.5, 9.4, c.P)
	col(c, 1.8, 8.9, 1.6, 2.8, 0.6, WOOD, Mat.Wood)
	ball(c, 1.8, 12.4, 1.6, 2.6, mix(c.P, BLACK, 0.25))
	ball(c, 1, 11.8, 2.3, 1.8, mix(c.P, BLACK, 0.15))
	ball(c, 2.6, 11.9, 1, 1.7, mix(c.P, BLACK, 0.15))
	col(c, -1.2, 8.85, -2.6, 0.12, 2.2, WATER, Mat.Glass, 0.15)
	box(c, -1.2, 8.85, -4.1, 0.9, 0.12, 1.4, WATER, Mat.Glass, 0.15)
	box(c, -1.2, 2.4, -4.75, 1, 6.55, 0.2, c.A, Mat.Neon, 0.35)
	ball(c, -1.2, 2.4, -4.3, 1.2, c.A, Mat.SmoothPlastic, 0.4)
	ball(c, -3, 3.4, -1.5, 2, CLOUD, Mat.SmoothPlastic, 0.2)
	ball(c, 3, 4, 1.8, 2.4, CLOUD, Mat.SmoothPlastic, 0.2)
	ball(c, 0.6, 2.2, 2.6, 1.8, CLOUD, Mat.SmoothPlastic, 0.2)
	box(c, -2.9, 8.9, 1.2, 0.35, 1.6, 0.35, CLOUD, Mat.Marble)
	box(c, -1.7, 8.9, 1.2, 0.35, 1.6, 0.35, CLOUD, Mat.Marble)
	box(c, -2.3, 10.5, 1.2, 1.7, 0.3, 0.6, CLOUD, Mat.Marble)
	ball(c, 4.2, 6.6, -2.8, 0.9, c.S, rock)
	ball(c, -4.2, 9.8, -0.8, 0.7, c.S, rock)
end

-- 세계수: 뻗은 뿌리 + 굵은 줄기 + 가지 + 잎 공 캐노피 + 빛나는 열매
function BUILDERS.tree(c)
	col(c, 0, 0, 0, 0.3, 9.6, mix(c.S, BLACK, 0.4), Mat.Grass)
	for i = 0, 5 do
		local angle = i * TAU / 6 + 0.3
		local dir = V(math.cos(angle), 0, math.sin(angle))
		beam(c, dir * 0.9 + V(0, 2.2, 0), dir * 4.1 + V(0, 0.45, 0), 0.85, c.P)
	end
	col(c, 0, 0.3, 0, 5.2, 3, c.P)
	col(c, 0, 5.5, 0, 3, 2.4, c.P)
	col(c, 0, 8.5, 0, 2.5, 1.8, c.P)
	local leaves = {}
	for i = 0, 4 do
		local angle = i * TAU / 5 + 0.2
		local dir = V(math.cos(angle), 0, math.sin(angle))
		beam(c, V(0, 9.3, 0), dir * 2.8 + V(0, 12.4, 0), 0.8, c.P)
		table.insert(leaves, dir * 2.9 + V(0, 13.2, 0))
	end
	ball(c, 0, 15, 0, 7, c.S, Mat.Grass)
	ball(c, 0, 18.6, 0, 4.4, c.S, Mat.Grass)
	for _, p in leaves do
		ball(c, p.X, p.Y, p.Z, 3.8, mix(c.S, BLACK, 0.12), Mat.Grass)
	end
	-- 열매: 잎 공 표면 바로 바깥
	local fruits = {
		V(0, 15, 0) + V(-0.6, 0.3, -1).Unit * 3.5,
		V(0, 15, 0) + V(0.8, 0.6, -0.4).Unit * 3.5,
		V(0, 18.6, 0) + V(-0.3, 0.5, -1).Unit * 2.2,
		leaves[1] + V(0.2, 0.4, -1).Unit * 1.9,
		leaves[2] + V(-0.4, 0.2, -1).Unit * 1.9,
		leaves[3] + V(-1, 0.3, -0.2).Unit * 1.9,
		leaves[4] + V(0.3, -0.2, -1).Unit * 1.9,
	}
	for _, p in fruits do
		ball(c, p.X, p.Y, p.Z, 0.7, c.A, Mat.Neon)
	end
	col(c, 0, 0.3, 0, 0.08, 6, c.A, Mat.Neon, 0.5)
end

-- 하버 브리지: 항구 물 + 양쪽 기슭 + 끝마다 화강암 탑문 2개 + 나란한 강철 아치 두 줄(끝은 두껍고 꼭대기는 얇음)
--   + 아치를 꿰뚫고 지나는 도로 상판 + 아치에 매단 멜대 + 아치 사이 가새
--   (오페라하우스는 건물 이미지 상표 문제로 넣지 않음)
function BUILDERS.bridge(c)
	local granite = rgb(208, 196, 172)
	local deckY, deckTop = 2.2, 2.55
	box(c, 0, 0, 0, 9.8, 0.25, 9.8, WATER, Mat.Glass, 0.1)
	for _, sx in { -1, 1 } do
		box(c, sx * 4.2, 0, 0, 1.4, 0.6, 9.8, GRASS, Mat.Grass)
		box(c, sx * 4.3, 0.6, 0, 1.2, deckY - 0.6, 4.4, granite, Mat.Granite)
		for _, sz in { -1, 1 } do
			box(c, sx * 4.3, deckY, sz * 1.75, 1.1, 1.85, 0.9, granite, Mat.Granite)
			box(c, sx * 4.3, deckY + 1.85, sz * 1.75, 0.8, 0.4, 0.65, granite, Mat.Granite)
		end
	end
	box(c, 0, deckY, 0, 9.8, deckTop - deckY, 2.6, c.S)
	-- 아치: 위·아래 현(포물선) 사이를 비스듬한 토막으로 채움. 발은 탑문 아래 기슭(x = ±span)
	local span = 3.7
	local function curve(x: number, crown: number, foot: number): number
		local u = x / span
		return crown - (crown - foot) * u * u
	end
	local function upper(x: number): number
		return curve(x, 5.9, 3.3)
	end
	local function lower(x: number): number
		return curve(x, 5.3, 0.6)
	end
	local function middle(x: number): number
		return (upper(x) + lower(x)) / 2
	end
	local segments = 7
	for _, sz in { -1, 1 } do
		for k = 0, segments - 1 do
			local x1 = span * (2 * k / segments - 1)
			local x2 = span * (2 * (k + 1) / segments - 1)
			local p1, p2 = V(x1, middle(x1), sz), V(x2, middle(x2), sz)
			local along = p2 - p1
			local depth = (upper(x1) - lower(x1) + upper(x2) - lower(x2)) / 2 * math.abs(along.X) / along.Magnitude
			block(c, CFrame.lookAt((p1 + p2) / 2, p2), V(0.35, depth, along.Magnitude + depth * 0.4), c.P)
		end
		-- 멜대(아치 아래 현에서 상판까지)
		for _, x in { -2.1, -0.8, 0.8, 2.1 } do
			box(c, x, deckTop, sz, 0.12, lower(x) - deckTop + 0.1, 0.12, c.S)
		end
	end
	for _, x in { -2.4, 0, 2.4 } do
		beam(c, V(x, middle(x), -1), V(x, middle(x), 1), 0.2, c.S)
	end
	beam(c, V(-2.4, middle(-2.4), -1), V(0, middle(0), 1), 0.16, c.S)
	beam(c, V(2.4, middle(2.4), -1), V(0, middle(0), 1), 0.16, c.S)
end

-- 12사도 바위: 바다 + 왼쪽(-X)을 두른 사암 절벽(덤불 윗면, 아래가 젖어 어두움) + 절벽 밑 모래 해변과 물거품
--   + 탁 트인 바다에 흩어져 솟은 사암 기둥들(밑동은 파도에 파먹히고 위로 갈수록 좁고 비틀림) + 무너진 기둥 밑동
function BUILDERS.seastacks(c)
	box(c, 0, 0, 0, 9.8, 0.3, 9.8, c.S, Mat.Glass, 0.1)
	local wet = mix(c.P, BLACK, 0.22)
	local pale = mix(c.P, WHITE, 0.15)
	local cliff = mix(c.P, ROCK, 0.25)
	local scrub = mix(LEAF, c.P, 0.2)
	-- 절벽: { x, z, 가로, 깊이, 높이 }
	local cliffs = {
		{ -4, 0.9, 1.8, 8, 5.2 },
		{ -2.4, 4.1, 1.6, 1.6, 4.6 },
		{ -4.2, -4, 1.4, 1.8, 2.8 },
	}
	for _, cl in cliffs do
		local x, z, w, d, h = cl[1], cl[2], cl[3], cl[4], cl[5]
		box(c, x, 0, z, w, h * 0.25, d, wet)
		box(c, x, h * 0.25, z, w - 0.2, h * 0.75, d - 0.2, cliff)
		box(c, x, h, z, w - 0.3, 0.3, d - 0.3, scrub, Mat.Grass)
	end
	box(c, -2.75, 0.3, 0.4, 0.7, 0.12, 5.2, SAND, Mat.Sand)
	box(c, -2.3, 0.3, 0.4, 0.3, 0.1, 5.2, c.A, Mat.SmoothPlastic, 0.15)
	-- 바위 기둥: 밑동(파먹혀 가늘고 젖음) → 몸통(가장 넓음) → 꼭대기(좁고 비틀림)
	local function stack(x: number, z: number, h: number, w: number, twist: number)
		col(c, x, 0.3, z, 0.1, w * 1.35, c.A, Mat.SmoothPlastic, 0.2)
		local y = 0.3
		block(c, CFrame.new(x, y + h * 0.12, z) * CFrame.Angles(0, twist, 0), V(w * 0.7, h * 0.24 + 0.1, w * 0.68), wet)
		y += h * 0.24
		local cf = CFrame.new(x + w * 0.05, y + h * 0.2, z - w * 0.04) * CFrame.Angles(0, twist + 0.3, 0.035)
		block(c, cf, V(w, h * 0.42, w * 0.88), c.P)
		y += h * 0.4
		cf = CFrame.new(x - w * 0.06, y + h * 0.17, z + w * 0.05) * CFrame.Angles(0.04, twist - 0.25, -0.04)
		block(c, cf, V(w * 0.66, h * 0.34, w * 0.6), pale)
	end
	stack(-1.3, 2.5, 5.4, 1.2, 0.2)
	stack(0.6, 3.6, 4.2, 1.05, -0.4)
	stack(0, 0.5, 6.4, 1.3, 0.6)
	stack(2.4, 1.7, 4.8, 1.1, 0.1)
	stack(1.7, -1.6, 5.6, 1.2, -0.3)
	stack(-1.4, -1.7, 3.4, 1, 0.9)
	stack(3.4, -3.5, 3, 1, 0.4)
	-- 무너진 기둥(밑동만)
	col(c, 0, 0.3, -3.6, 0.1, 1.6, c.A, Mat.SmoothPlastic, 0.2)
	block(c, CFrame.new(0, 0.75, -3.6) * CFrame.Angles(0.1, 0.4, 0.08), V(1, 1, 0.9), wet)
end

-- 그레이트 배리어 리프: 짙은 바다 + 밝은 청록 산호 여울 + 가지 산호(분홍·주황) + 뇌 산호(노랑·보라 공)
--   + 탁자 산호 + 부채 산호 + 관 산호 + 헤엄치는 바다거북. 낮고 넓게(위에서 잘 보이도록)
function BUILDERS.reef(c)
	local purple = rgb(150, 90, 215)
	local orange = rgb(255, 140, 60)
	local tableColor = rgb(110, 205, 170)
	box(c, 0, 0, 0, 9.8, 0.3, 9.8, mix(c.S, rgb(20, 60, 140), 0.45), Mat.Glass, 0.1)
	local shallow = mix(c.S, WHITE, 0.4)
	col(c, -1.4, 0.3, 1.2, 0.15, 6, shallow, Mat.Sand)
	col(c, 2.2, 0.3, -1.4, 0.15, 4.6, shallow, Mat.Sand)
	col(c, -2.6, 0.3, -2.4, 0.15, 3, shallow, Mat.Sand)
	local ground = 0.45
	-- 가지 산호: 밑동에서 위·바깥으로 뻗는 가지 + 동그란 끝
	local function branching(x: number, z: number, h: number, color: Color3, count: number, turn: number)
		for k = 0, count - 1 do
			local angle = k / count * TAU + turn
			local lean = if k % 2 == 0 then 0.7 else 0.45
			local rise = if k % 2 == 0 then 0.8 else 1
			local tip = V(x + math.cos(angle) * h * lean, ground + h * rise, z + math.sin(angle) * h * lean)
			beam(c, V(x, ground - 0.1, z), tip, 0.22, color)
			ball(c, tip.X, tip.Y, tip.Z, 0.3, color)
		end
	end
	branching(-2.4, 2.2, 1.8, c.P, 4, 0.3)
	branching(2.9, 0, 1.5, orange, 3, 0.9)
	branching(-2.7, -2.5, 1.3, c.P, 3, 0.5)
	-- 뇌 산호(바닥에 얹힌 공): { x, z, 지름, 색 }
	for _, b in
		{
			{ -0.3, 2.9, 1.6, c.A },
			{ -1.2, 0.2, 1, purple },
			{ 1.4, -2.6, 1.3, purple },
			{ 3.4, -2.4, 1.1, mix(c.P, WHITE, 0.3) },
			{ -3.5, -0.4, 1.2, c.A },
		}
	do
		ball(c, b[1], b[3] / 2, b[2], b[3], b[4])
	end
	-- 탁자 산호(줄기 + 넓은 판)
	col(c, 0.5, ground, 1.2, 0.7, 0.25, tableColor)
	col(c, 0.5, ground + 0.7, 1.2, 0.15, 1.7, tableColor)
	col(c, 1.2, ground, -0.6, 0.45, 0.2, tableColor)
	col(c, 1.2, ground + 0.45, -0.6, 0.12, 1.2, tableColor)
	-- 부채 산호(바닥에 반쯤 묻힌 얇은 원판)
	cyl(c, CFrame.new(-3.6, 0.75, 3.5) * CFrame.Angles(0, 0.4, 0) * ALONG_Z, 0.08, 1.5, purple)
	cyl(c, CFrame.new(3.8, 0.6, 1.6) * CFrame.Angles(0, -1.2, 0) * ALONG_Z, 0.08, 1.2, orange)
	-- 관 산호
	for k, t in { { -3.9, 0.9, 0.9 }, { -3.5, 1.4, 0.6 }, { -4.1, 1.6, 0.7 } } do
		col(c, t[1], ground - 0.1, t[2], t[3] + 0.1, 0.35 - k * 0.03, orange)
	end
	-- 바다거북(앞쪽 깊은 물 위를 헤엄침, 정면을 봄)
	local turtle = CFrame.new(0.9, 1.2, -3.7) * CFrame.Angles(0, 0.35, 0)
	local shell = rgb(125, 105, 60)
	local skin = rgb(175, 170, 115)
	cyl(c, turtle * UPRIGHT, 0.25, 1.5, shell)
	cyl(c, turtle * CFrame.new(0, 0.2, 0) * UPRIGHT, 0.2, 1.05, mix(shell, BLACK, 0.15))
	local head = turtle * V(0, 0.05, -0.95)
	ball(c, head.X, head.Y, head.Z, 0.5, skin)
	for _, sx in { -1, 1 } do
		block(c, turtle * CFrame.new(sx * 0.95, 0, -0.35) * CFrame.Angles(0, sx * 0.5, 0), V(0.9, 0.08, 0.35), skin)
		block(c, turtle * CFrame.new(sx * 0.6, 0, 0.7) * CFrame.Angles(0, -sx * 0.5, 0), V(0.45, 0.08, 0.28), skin)
	end
end

-- 난마돌: 물길 사이 인공섬들 + 가운데 큰 섬의 현무암 기둥 성벽(통나무집처럼 가로세로 엇갈려 쌓음, 정면 입구)
--   + 안쪽 단과 무덤 + 작은 섬들의 낮은 벽 + 성벽을 덮은 초록 수풀
function BUILDERS.ruins(c)
	box(c, 0, 0, 0, 9.8, 0.3, 9.8, c.S, Mat.Glass, 0.1)
	local rubble = mix(c.P, ROCK, 0.55)
	local d = 0.5 -- 현무암 기둥 굵기
	local n = 0
	-- 누운 현무암 기둥. along = "x" 또는 "z"(길이 축). 조금씩 비틀고 색을 달리해 돌기둥처럼
	local function log(x: number, y: number, z: number, length: number, along: string, diameter: number?)
		n += 1
		local cf = CFrame.new(x, y, z) * CFrame.Angles(0, (n % 3 - 1) * 0.025, 0)
		if along == "z" then
			cf *= CFrame.Angles(0, PI / 2, 0)
		end
		local color = if n % 2 == 0 then c.P else mix(c.P, ROCK, 0.18)
		cyl(c, cf, length + (n % 4 - 1.5) * 0.08, (diameter or d) * (0.92 + n % 3 * 0.06), color)
	end
	-- 가운데 큰 섬 + 성벽(앞뒤 기둥 층과 옆 기둥 층이 반 단씩 엇갈림)
	local cx, cz = 0.6, 0.8
	local hx, hz = 2.3, 2.1
	local base = 0.6
	box(c, cx, 0, cz, 6, base, 5.8, rubble)
	for k = 0, 3 do
		local y = base + d / 2 + k * d
		for _, sz in { -1, 1 } do
			if sz == -1 and k < 2 then
				for _, sx in { -1, 1 } do
					log(cx + sx * 1.675, y, cz - hz, 2.15, "x")
				end
			else
				log(cx, y, cz + sz * hz, 2 * hx + 0.7, "x")
			end
		end
		for _, sx in { -1, 1 } do
			log(cx + sx * hx, y + d / 2, cz, 2 * hz + 0.7, "z")
		end
	end
	box(c, cx, base, cz + 0.4, 2.6, 0.6, 2.2, mix(c.P, BLACK, 0.12))
	box(c, cx, base + 0.6, cz + 0.4, 1.1, 0.35, 1.1, c.P)
	plant(c, cx + 1.4, base, cz + 1.3, 2.3, 1.8, c.A)
	plant(c, cx - 1.3, base, cz + 1.2, 1.7, 1.3, mix(c.A, LEAF, 0.4))
	ball(c, cx - hx, base + 4 * d + 0.1, cz - hz, 0.9, c.A, Mat.Grass)
	ball(c, cx + 2.8, base + 0.1, cz - 2.3, 0.8, c.A, Mat.Grass)
	ball(c, cx - 2.8, base + 0.1, cz + 2.4, 0.9, c.A, Mat.Grass)
	-- 작은 섬들: { x, z, 가로, 세로 }
	local islets = {
		{ -3.8, -3.7, 1.9, 1.8 },
		{ -3.9, 1.6, 1.6, 2.6 },
		{ 2, -3.9, 2.6, 1.5 },
	}
	for k, islet in islets do
		local x, z, w, depth = islet[1], islet[2], islet[3], islet[4]
		box(c, x, 0, z, w, 0.45, depth, rubble)
		log(x, 0.45 + 0.2, z - depth / 2 + 0.25, w + 0.1, "x", 0.4)
		log(x - w / 2 + 0.25, 0.45 + 0.4, z, depth + 0.1, "z", 0.4)
		if k == 2 then
			plant(c, x + 0.3, 0.45, z + 0.5, 1.3, 1.2, c.A)
		else
			ball(c, x + 0.35, 0.75, z + 0.3, 0.9, c.A, Mat.Grass)
		end
	end
end

-- 지구: 받침대 + 23.5도 기운 파란 공 + 대륙 덩어리(살짝 튀어나온 공) + 극지방 얼음 + 자오선 반원 고리 + 대기 + 달
function BUILDERS.globe(c)
	local metal = mix(c.A, BLACK, 0.2)
	col(c, 0, 0, 0, 0.5, 4.2, metal, Mat.Metal)
	col(c, 0, 0.5, 0, 0.4, 2.6, metal, Mat.Metal)
	col(c, 0, 0.9, 0, 1.6, 0.6, metal, Mat.Metal)
	local radius = 4
	local tilt = CFrame.new(0, 7, 0) * CFrame.Angles(0, 0, math.rad(23.5))
	ball(c, 0, 7, 0, radius * 2, c.P)
	cyl(c, tilt * UPRIGHT, 9.4, 0.2, metal, Mat.Metal)
	-- 자오선 반원 고리(+X 쪽)
	local ring = 4.5
	local pieces = 6
	for k = 0, pieces - 1 do
		local a1 = -PI / 2 + k / pieces * PI
		local a2 = -PI / 2 + (k + 1) / pieces * PI
		local p1 = tilt * V(ring * math.cos(a1), ring * math.sin(a1), 0)
		local p2 = tilt * V(ring * math.cos(a2), ring * math.sin(a2), 0)
		beam(c, p1, p2, 0.25, metal, Mat.Metal)
	end
	-- 위도/경도(도) → 지구 표면 위치. 경도 20도(아프리카)가 정면(-Z), 동쪽이 정면에서 볼 때 오른쪽
	local function surface(lat: number, lon: number, r: number): Vector3
		local phi, lambda = math.rad(lat), math.rad(lon - 20)
		return tilt * V(-r * math.cos(phi) * math.sin(lambda), r * math.sin(phi), -r * math.cos(phi) * math.cos(lambda))
	end
	local lands = {
		{ 5, 20, 2.4 }, -- 아프리카
		{ -18, 26, 1.9 },
		{ 50, 15, 1.6 }, -- 유럽
		{ 48, 70, 2.6 }, -- 아시아
		{ 30, 100, 2.2 },
		{ 62, 110, 2.2 },
		{ 20, 78, 1.2 }, -- 인도
		{ -25, 135, 1.8 }, -- 오스트레일리아
		{ 45, -100, 2.6 }, -- 북아메리카
		{ 62, -115, 2 },
		{ 25, -100, 1.3 },
		{ -10, -60, 2.2 }, -- 남아메리카
		{ -32, -66, 1.5 },
	}
	for _, land in lands do
		local d = land[3]
		local p = surface(land[1], land[2], radius - d / 2 + 0.28)
		ball(c, p.X, p.Y, p.Z, d, c.S, Mat.Grass)
	end
	for _, lat in { 90, -90 } do
		local p = surface(lat, 0, radius - 1.1 + 0.25)
		ball(c, p.X, p.Y, p.Z, 2.2, c.A)
	end
	for _, cloud in { { 20, -20 }, { -40, 60 }, { 35, 40 } } do
		local p = surface(cloud[1], cloud[2], radius - 0.4 + 0.3)
		ball(c, p.X, p.Y, p.Z, 0.8, c.A, Mat.SmoothPlastic, 0.3)
	end
	ball(c, 0, 7, 0, radius * 2 + 0.6, mix(c.P, WHITE, 0.6), Mat.Neon, 0.88)
	ball(c, -4.2, 11.8, 1.5, 1, rgb(200, 200, 195))
end

-- 모르는 모형: 기단 + 오벨리스크
local function fallback(c: Ctx)
	box(c, 0, 0, 0, 5, 1, 5, c.S)
	box(c, 0, 1, 0, 1.4, 7, 1.4, c.P)
	box(c, 0, 8, 0, 1, 0.5, 1, c.A)
	box(c, 0, 8.5, 0, 0.5, 0.5, 0.5, c.A, Mat.Neon)
end

-- 공개 API ------------------------------------------------------------------

-- 코드로 만든 모형이 있는 Shape 이름 집합
Models.SHAPES = {} :: { [string]: boolean }
for name in BUILDERS do
	Models.SHAPES[name] = true
end

function Models.build(landmark: Landmark): Model
	local model = Instance.new("Model")
	model.Name = landmark.Id

	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = V(DESIGN_WIDTH, 0.2, DESIGN_WIDTH)
	root.CFrame = CFrame.new(0, 0.1, 0)
	root.PivotOffset = CFrame.new(0, -0.1, 0) -- 피벗 = 바닥 중앙(y = 0)
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.Parent = model
	model.PrimaryPart = root

	local ctx: Ctx = {
		model = model,
		id = landmark.Id,
		origin = CFrame.new(),
		P = landmark.Primary or rgb(200, 200, 200),
		S = landmark.Secondary or rgb(140, 140, 140),
		A = landmark.Accent or rgb(255, 240, 180),
		M = landmark.Material or Mat.SmoothPlastic,
		grand = landmark.Tier ~= nil and landmark.Tier.Rank >= 5,
	}
	local builder = BUILDERS[landmark.Shape] or fallback
	local ok, err = pcall(builder, ctx)
	if not ok then
		-- 모형 코드에 문제가 있어도 게임은 계속되도록: 만들던 파트를 지우고 기본 모형으로
		warn(
			"[Models] "
				.. tostring(landmark.Id)
				.. " 모형 생성 실패, 기본 모형으로 대체: "
				.. tostring(err)
		)
		for _, child in model:GetChildren() do
			if child ~= root then
				child:Destroy()
			end
		end
		ctx.origin = CFrame.new()
		fallback(ctx)
	end
	return model
end

local function findOverride(landmark: Landmark): Model?
	local folder = game:GetService("ReplicatedStorage"):FindFirstChild(OVERRIDE_FOLDER)
	local source = folder and folder:FindFirstChild(landmark.Id)
	if source and source:IsA("Model") then
		return source
	end
	return nil
end

-- 교체 모형: 경계 상자의 바닥 중앙을 피벗으로. 경계 상자 크기를 돌려줌
local function pivotToBottom(model: Model): Vector3
	local cf, extents = model:GetBoundingBox()
	local bottom = cf * CFrame.new(0, -extents.Y / 2, 0)
	local primary = model.PrimaryPart
	if primary then
		-- PrimaryPart 가 있으면 WorldPivot 은 무시되므로 PrimaryPart 의 피벗을 옮김
		primary.PivotOffset = primary.CFrame:ToObjectSpace(bottom)
	else
		model.WorldPivot = bottom
	end
	return extents
end

function Models.create(landmark: Landmark, size: number, opts: { Anchored: boolean? }?): Model
	local model: Model? = nil
	local source = findOverride(landmark)
	if source then
		local clone = source:Clone()
		if clone and clone:FindFirstChildWhichIsA("BasePart", true) then
			model = clone
		end
	end

	local extents
	if model then
		extents = pivotToBottom(model)
		if math.max(extents.X, extents.Z) <= 1e-3 then
			model:Destroy()
			model = nil
		end
	end
	local built = model == nil
	if not model then
		model = Models.build(landmark)
		local _, buildExtents = (model :: Model):GetBoundingBox()
		extents = buildExtents
	end
	local result = model :: Model

	-- 가로·세로 중 큰 쪽이 size, 단 높이는 size * 2.2 까지
	local factor = size / math.max(extents.X, extents.Z)
	if extents.Y * factor > size * MAX_HEIGHT_RATIO then
		factor = size * MAX_HEIGHT_RATIO / extents.Y
	end
	if factor > 0 and factor < math.huge and math.abs(factor - 1) > 1e-4 then
		result:ScaleTo(result:GetScale() * factor)
	end

	-- 크기를 바꾼 뒤에도 피벗이 정확히 바닥 중앙이도록 다시 맞춤
	if built then
		local root = result.PrimaryPart :: BasePart
		root.PivotOffset = CFrame.new(0, -root.Size.Y / 2, 0)
	else
		pivotToBottom(result)
	end

	local loose = opts ~= nil and opts.Anchored == false
	for _, descendant in result:GetDescendants() do
		if descendant:IsA("BasePart") then
			if loose then
				descendant.Anchored = false
				descendant.Massless = true
				descendant.CanCollide = false
				descendant.CanQuery = false
				descendant.CanTouch = false
			else
				descendant.Anchored = true
				descendant.CanCollide = false
			end
		end
	end

	result.Name = landmark.Id
	return result
end

return Models
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[-- 원격 통신 객체. 서버가 처음 require 할 때 만들고, 클라이언트는 생길 때까지 기다립니다.
-- (Rojo 없이 Studio 에 직접 복사해도 따로 RemoteEvent 를 만들 필요가 없도록)

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local FOLDER_NAME = "LandmarkRNGRemotes"

local FUNCTIONS = {
	"GetState", -- () -> Snapshot?
	"Roll", -- () -> RollResponse (DESIGN.md 참고)
	"Feature", -- (landmarkId?) -> { Ok, State }
	"BuyUpgrade", -- (upgradeId) -> { Ok, Reason?, State }
	"SetSetting", -- (key, value) -> { Ok, State }
	"Teleport", -- ("Park" | "Plaza") -> { Ok }
	"Rebirth", -- () -> { Ok, Reason?, State }
	"BuyPass", -- (passKey) -> { Ok } (서버가 게임패스 구매 창을 띄움)
	"BuyProduct", -- (productKey) -> { Ok } (서버가 개발자 상품 구매 창을 띄움)
}

local EVENTS = {
	"State", -- 서버 -> 클라: Snapshot (관광 수입 등 서버 쪽 변화)
	"Announce", -- 서버 -> 모두: 희귀 명소 발견 "뉴스 속보"
	"ServerLuck", -- 서버 -> 모두: 서버 행운 시작/연장 { UserId, Name, Until, Left }
}

local folder: Folder
if RunService:IsServer() then
	folder = Instance.new("Folder")
	folder.Name = FOLDER_NAME
	for _, name in FUNCTIONS do
		local remote = Instance.new("RemoteFunction")
		remote.Name = name
		remote.Parent = folder
	end
	for _, name in EVENTS do
		local remote = Instance.new("RemoteEvent")
		remote.Name = name
		remote.Parent = folder
	end
	folder.Parent = ReplicatedStorage
else
	folder = ReplicatedStorage:WaitForChild(FOLDER_NAME) :: Folder
end

local Net = {}

function Net.fn(name: string): RemoteFunction
	return folder:WaitForChild(name) :: RemoteFunction
end

function Net.event(name: string): RemoteEvent
	return folder:WaitForChild(name) :: RemoteEvent
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">PlayerState</string>
          <string name="Source"><![CDATA[--!strict
-- 플레이어 데이터와 그 데이터를 바꾸는 규칙(순수 함수). 서버가 유일한 진실의 원천이고,
-- 클라이언트는 Snapshot 만 받아서 화면에 그립니다. Roblox 서비스에 의존하지 않아 테스트 가능.
-- 읽기 전용 함수(luck, park, stars, incomePerSecond 등)는 Data 대신 Snapshot 을 넘겨도 됩니다.
-- luck / cooldown / incomePerSecond / addIncome / snapshot 은 선택 인자 mods(게임패스·서버 행운)를 받습니다.
-- mods 가 없으면 게임패스·서버 행운 없이 계산합니다. Snapshot 은 Passes/ServerLuck 필드가 있어서
-- PlayerState.luck(snapshot, snapshot) 처럼 mods 자리에 그대로 넘겨도 됩니다.

local Config = require(script.Parent.Config)
local Landmarks = require(script.Parent.Landmarks)

type Landmark = Landmarks.Landmark
type GamePass = Config.GamePass
type Product = Config.Product

export type Settings = {
	AutoFeature: boolean, -- 더 희귀한 명소를 발견하면 자동으로 대표 명소로 지정
}

-- 세션에만 있는 효과(저장 안 함). 서버가 만들어서 넘김
export type Mods = {
	Passes: { [string]: boolean }?, -- 가진 게임패스 Id -> true
	ServerLuck: boolean?, -- 서버 전체 행운 부스트 중인지
}

export type RebirthRequirement = {
	Coins: number,
	Landmarks: { string }, -- 이번 판에 보유해야 하는 명소 Id
}

-- 상품 지급 결과(grantProduct)
export type Grant = {
	Product: string, -- 상품 Id (Config.Products 의 Id)
	Coins: number, -- 더해진 코인(코인 팩)
	Seconds: number, -- 더해진 부스트 시간(초)
	ServerWide: boolean, -- true 면 서버가 서버 행운 타이머에 Seconds 를 더해야 함(Data 는 안 바뀜)
}

export type Data = {
	Rolls: number,
	Coins: number, -- 관광 수입이 초 단위로 쌓이므로 소수일 수 있음(표시할 때 버림)
	Inventory: { [string]: number }, -- 이번 판에 보유한 명소 Id -> 발견 횟수 (환생하면 비움)
	Discovered: { [string]: boolean }, -- 한 번이라도 발견한 명소 Id -> true (환생해도 유지. 도감·여권 기준)
	Featured: string?, -- 대표 명소(캐릭터 옆에 떠 다님)
	Upgrades: { [string]: number }, -- 업그레이드 Id -> 레벨
	Settings: Settings,
	Rebirths: number, -- 환생 횟수
	Boosts: { [string]: number }, -- 개인 시간 부스트 상품 Id -> 남은 초(접속 중에만 줄어듦)
	Receipts: { string }, -- 최근에 지급한 구매 영수증 PurchaseId (중복 지급 방지, 최근 MAX_RECEIPTS 개)
}

export type Snapshot = {
	Revision: number,
	Rolls: number,
	Coins: number,
	Inventory: { [string]: number },
	Discovered: { [string]: boolean },
	Featured: string?,
	Upgrades: { [string]: number },
	Settings: Settings,
	Rebirths: number,
	Boosts: { [string]: number }, -- 개인 부스트 남은 초
	Passes: { [string]: boolean }, -- 가진 게임패스
	ServerLuck: boolean, -- 서버 행운 부스트 중인지
	NextRebirth: RebirthRequirement, -- 다음 환생 조건
	Luck: number, -- mods 반영
	Cooldown: number, -- mods 반영
	Income: number, -- 초당 관광 수입(mods 반영)
}

export type Upgrade = typeof(Config.Upgrades[1])

local PlayerState = {}

PlayerState.UpgradesById = {} :: { [string]: Upgrade }
for _, upgrade in Config.Upgrades do
	PlayerState.UpgradesById[upgrade.Id] = upgrade
end

PlayerState.PassesById = {} :: { [string]: GamePass }
for _, pass in Config.GamePasses do
	PlayerState.PassesById[pass.Id] = pass
end

PlayerState.ProductsById = {} :: { [string]: Product }
for _, product in Config.Products do
	PlayerState.ProductsById[product.Id] = product
end

function PlayerState.new(): Data
	local upgrades = {}
	for _, upgrade in Config.Upgrades do
		upgrades[upgrade.Id] = 0
	end
	return {
		Rolls = 0,
		Coins = 0,
		Inventory = {},
		Discovered = {},
		Featured = nil,
		Upgrades = upgrades,
		Settings = { AutoFeature = true },
		Rebirths = 0,
		Boosts = {},
		Receipts = {},
	}
end

local function nonNegativeInt(value: any): number?
	if type(value) == "number" and value == value and value >= 0 and value < math.huge then
		return math.floor(value)
	end
	return nil
end

-- 개인 시간 부스트 상품인지(Data.Boosts 에 남은 시간이 쌓이는 상품)
local function isPersonalBoost(product: Product): boolean
	return product.Seconds ~= nil and not product.ServerWide
end

local function trimReceipts(receipts: { string })
	while #receipts > Config.MAX_RECEIPTS do
		table.remove(receipts, 1)
	end
end

-- DataStore 에서 읽은 값(형식 보장 없음)을 안전한 Data 로 정리합니다.
-- 모르는 명소 Id 의 발견 횟수는 지우지 않고 보존합니다(명소를 잠시 뺐다가 다시 넣어도 안전).
function PlayerState.reconcile(raw: any): Data
	local data = PlayerState.new()
	if type(raw) ~= "table" then
		return data
	end

	data.Rolls = nonNegativeInt(raw.Rolls) or 0
	data.Coins = nonNegativeInt(raw.Coins) or 0
	data.Rebirths = nonNegativeInt(raw.Rebirths) or 0

	if type(raw.Inventory) == "table" then
		for id, count in raw.Inventory do
			local n = nonNegativeInt(count)
			if type(id) == "string" and n and n > 0 then
				data.Inventory[id] = n
			end
		end
	end

	if type(raw.Discovered) == "table" then
		for id, flag in raw.Discovered do
			if type(id) == "string" and flag == true then
				data.Discovered[id] = true
			end
		end
	end
	-- 보유한 명소는 항상 발견한 명소(Discovered 가 없던 예전 저장도 여기서 채워짐)
	for id in data.Inventory do
		data.Discovered[id] = true
	end

	if type(raw.Featured) == "string" and Landmarks.ById[raw.Featured] and data.Inventory[raw.Featured] then
		data.Featured = raw.Featured
	end

	if type(raw.Upgrades) == "table" then
		for _, upgrade in Config.Upgrades do
			local level = nonNegativeInt(raw.Upgrades[upgrade.Id])
			if level then
				data.Upgrades[upgrade.Id] = math.min(level, upgrade.MaxLevel)
			end
		end
	end

	if type(raw.Settings) == "table" and type(raw.Settings.AutoFeature) == "boolean" then
		data.Settings.AutoFeature = raw.Settings.AutoFeature
	end

	if type(raw.Boosts) == "table" then
		for _, product in Config.Products do
			local left = raw.Boosts[product.Id]
			if isPersonalBoost(product) and type(left) == "number" and left == left and left > 0 then
				data.Boosts[product.Id] = math.min(left, Config.MAX_BOOST_SECONDS)
			end
		end
	end

	if type(raw.Receipts) == "table" then
		for _, purchaseId in ipairs(raw.Receipts) do
			if type(purchaseId) == "string" then
				table.insert(data.Receipts, purchaseId)
			end
		end
		trimReceipts(data.Receipts)
	end

	return data
end

-- 업그레이드 ---------------------------------------------------------------

function PlayerState.upgradeLevel(data: Data | Snapshot, upgradeId: string): number
	return data.Upgrades[upgradeId] or 0
end

-- 현재 레벨에서 다음 레벨로 가는 가격. 최대 레벨이면 nil.
function PlayerState.upgradePrice(upgradeId: string, level: number): number?
	local upgrade = PlayerState.UpgradesById[upgradeId]
	if not upgrade or level >= upgrade.MaxLevel then
		return nil
	end
	return math.floor(upgrade.BasePrice * upgrade.Growth ^ level)
end

-- 반환: 성공 여부, 실패 사유(표시용)
function PlayerState.buyUpgrade(data: Data, upgradeId: any): (boolean, string?)
	local upgrade = if type(upgradeId) == "string" then PlayerState.UpgradesById[upgradeId] else nil
	if not upgrade then
		return false, "존재하지 않는 업그레이드입니다"
	end
	local level = PlayerState.upgradeLevel(data, upgrade.Id)
	local price = PlayerState.upgradePrice(upgrade.Id, level)
	if not price then
		return false, "이미 최대 레벨입니다"
	end
	if data.Coins < price then
		return false, "코인이 부족합니다"
	end
	data.Coins -= price
	data.Upgrades[upgrade.Id] = level + 1
	return true, nil
end

-- 발견 기록 / 여권 도장 -------------------------------------------------------

-- 한 번이라도 발견한 명소인지(환생해도 유지). 도감의 발견/미발견과 여권은 이것 기준.
function PlayerState.isDiscovered(data: Data | Snapshot, landmarkId: string): boolean
	local discovered = data.Discovered
	if discovered and discovered[landmarkId] then
		return true
	end
	return (data.Inventory[landmarkId] or 0) > 0
end

-- 이 명소가 여권 도장 조건에 들어가는지 (전설급은 보너스 수집이라 제외)
function PlayerState.countsForStamp(landmark: Landmark): boolean
	return landmark.Tier.Rank <= Config.STAMP_MAX_RANK
end

-- 대륙의 도장 진행도: 발견한 수, 필요한 수 (도장 조건에 드는 명소만, 역대 발견 기록 기준)
function PlayerState.regionProgress(data: Data | Snapshot, regionId: string): (number, number)
	local found, required = 0, 0
	for _, landmark in Landmarks.ByRegion[regionId] or {} do
		if PlayerState.countsForStamp(landmark) then
			required += 1
			if PlayerState.isDiscovered(data, landmark.Id) then
				found += 1
			end
		end
	end
	return found, required
end

-- 도장을 받은 대륙 Id 목록 (Landmarks.Regions 순서)
function PlayerState.completedRegions(data: Data | Snapshot): { string }
	local completed = {}
	for _, region in Landmarks.Regions do
		local found, required = PlayerState.regionProgress(data, region.Id)
		if required > 0 and found >= required then
			table.insert(completed, region.Id)
		end
	end
	return completed
end

-- 부스트 / 게임패스 -----------------------------------------------------------

local function rebirthsOf(data: Data | Snapshot): number
	return data.Rebirths or 0
end

-- mods 에 있는 게임패스 목록(Config.GamePasses 순서)
local function ownedPasses(mods: Mods?): { GamePass }
	local list = {}
	local passes = if mods then mods.Passes else nil
	if passes then
		for _, pass in Config.GamePasses do
			if passes[pass.Id] == true then
				table.insert(list, pass)
			end
		end
	end
	return list
end

-- 개인 부스트 남은 초(없으면 0)
function PlayerState.boostLeft(data: Data | Snapshot, productKey: string): number
	local boosts = data.Boosts
	return if boosts then boosts[productKey] or 0 else 0
end

-- 개인 시간 부스트(예: LuckBoost)의 남은 시간을 더함(MAX_BOOST_SECONDS 까지). 개인 부스트 상품이 아니면 false.
function PlayerState.addBoost(data: Data, productKey: any): boolean
	local product = if type(productKey) == "string" then PlayerState.ProductsById[productKey] else nil
	if not product or not isPersonalBoost(product) then
		return false
	end
	local left = data.Boosts[product.Id] or 0
	data.Boosts[product.Id] = math.min(Config.MAX_BOOST_SECONDS, left + (product.Seconds or 0))
	return true
end

-- 접속 중 dt 초만큼 부스트 시간을 줄임. 끝난 부스트가 있으면 true.
function PlayerState.tickBoosts(data: Data, dt: number): boolean
	if not (dt > 0) then
		return false
	end
	local expired = false
	for id, left in data.Boosts do
		local after = left - dt
		if after > 0 then
			data.Boosts[id] = after
		else
			data.Boosts[id] = nil
			expired = true
		end
	end
	return expired
end

-- 행운 / 속도 -----------------------------------------------------------------

-- 이번 굴림에 적용할 행운 = 기본 × 지구본 × 여권 도장 × 환생 × VIP × 행운 부스트 × 서버 행운
function PlayerState.luck(data: Data | Snapshot, mods: Mods?): number
	local globe = PlayerState.UpgradesById.Globe
	local globeMult = 1 + globe.PerLevel * PlayerState.upgradeLevel(data, "Globe")
	local regionMult = 1 + Config.REGION_LUCK_BONUS * #PlayerState.completedRegions(data)
	local rebirthMult = 1 + Config.REBIRTH_LUCK_BONUS * rebirthsOf(data)
	local luck = Config.BASE_LUCK * globeMult * regionMult * rebirthMult
	for _, pass in ownedPasses(mods) do
		luck *= pass.LuckMult or 1
	end
	local serverLuck = mods ~= nil and mods.ServerLuck == true
	for _, product in Config.Products do
		if product.ServerWide then
			if serverLuck then
				luck *= product.LuckMult or 1
			end
		elseif product.Seconds and PlayerState.boostLeft(data, product.Id) > 0 then
			luck *= product.LuckMult or 1
		end
	end
	return luck
end

function PlayerState.cooldown(data: Data | Snapshot, mods: Mods?): number
	local agency = PlayerState.UpgradesById.Agency
	local cooldown = Config.ROLL_COOLDOWN * (1 - agency.PerLevel * PlayerState.upgradeLevel(data, "Agency"))
	for _, pass in ownedPasses(mods) do
		cooldown *= pass.CooldownMult or 1
	end
	return cooldown
end

-- 관광 공원 ---------------------------------------------------------------

function PlayerState.slots(data: Data | Snapshot): number
	local park = PlayerState.UpgradesById.Park
	return Config.BASE_SLOTS + park.PerLevel * PlayerState.upgradeLevel(data, "Park")
end

-- 발견 횟수 -> 별 개수(0~5). 0 이면 미발견.
function PlayerState.stars(count: number): number
	local stars = 0
	for i, threshold in Config.STAR_THRESHOLDS do
		if count >= threshold then
			stars = i
		end
	end
	return stars
end

-- 공원에 전시되는 명소 Id 목록: 이번 판에 가진 것 중 희귀한 순서로 전시 칸 수만큼
function PlayerState.park(data: Data | Snapshot): { string }
	local result = {}
	local slots = PlayerState.slots(data)
	for _, landmark in Landmarks.RarestFirst do
		if #result >= slots then
			break
		end
		if (data.Inventory[landmark.Id] or 0) > 0 then
			table.insert(result, landmark.Id)
		end
	end
	return result
end

-- 명소 1개의 초당 수입 (입장료 업그레이드 제외)
function PlayerState.landmarkIncome(landmark: Landmark, count: number): number
	local stars = PlayerState.stars(count)
	if stars == 0 then
		return 0
	end
	local base = Config.TIER_INCOME[landmark.Tier.Rank] or 0
	return base * (1 + Config.STAR_INCOME_BONUS * (stars - 1))
end

-- 초당 관광 수입 = 전시 명소 합 × 입장료 × 환생 × 수입 2배 게임패스
function PlayerState.incomePerSecond(data: Data | Snapshot, mods: Mods?): number
	local total = 0
	for _, id in PlayerState.park(data) do
		total += PlayerState.landmarkIncome(Landmarks.ById[id], data.Inventory[id])
	end
	local ticket = PlayerState.UpgradesById.Ticket
	local income = total
		* (1 + ticket.PerLevel * PlayerState.upgradeLevel(data, "Ticket"))
		* (1 + Config.REBIRTH_INCOME_BONUS * rebirthsOf(data))
	for _, pass in ownedPasses(mods) do
		income *= pass.IncomeMult or 1
	end
	return income
end

-- dt 초 동안의 관광 수입을 더하고, 더한 양을 반환
function PlayerState.addIncome(data: Data, dt: number, mods: Mods?): number
	local amount = PlayerState.incomePerSecond(data, mods) * math.max(0, dt)
	data.Coins += amount
	return amount
end

-- 굴림 --------------------------------------------------------------------

function PlayerState.discoveryBonus(landmark: Landmark): number
	return math.ceil(Config.DISCOVERY_BONUS_MULT * landmark.OneIn ^ 0.5)
end

-- 굴림 결과 반영. 반환: 보너스 코인, 역대 처음 발견인지(보너스는 이때만), 별이 올랐는지
-- (환생 뒤 예전에 발견했던 명소를 다시 얻으면 처음 발견도 별 상승도 아님)
function PlayerState.applyRoll(data: Data, landmark: Landmark): (number, boolean, boolean)
	local before = data.Inventory[landmark.Id] or 0
	local after = before + 1
	local isNew = not PlayerState.isDiscovered(data, landmark.Id)
	data.Inventory[landmark.Id] = after
	data.Discovered[landmark.Id] = true
	data.Rolls += 1
	local bonus = if isNew then PlayerState.discoveryBonus(landmark) else 0
	data.Coins += bonus
	local starUp = before > 0 and PlayerState.stars(after) > PlayerState.stars(before)
	return bonus, isNew, starUp
end

-- 가장 희귀한 보유 명소(이번 판)
function PlayerState.best(data: Data | Snapshot): Landmark?
	for _, landmark in Landmarks.RarestFirst do
		if (data.Inventory[landmark.Id] or 0) > 0 then
			return landmark
		end
	end
	return nil
end

-- landmarkId 가 nil 이면 해제. 보유한 명소만 대표로 지정 가능.
function PlayerState.feature(data: Data, landmarkId: any): boolean
	if landmarkId == nil then
		data.Featured = nil
		return true
	end
	if type(landmarkId) == "string" and Landmarks.ById[landmarkId] and (data.Inventory[landmarkId] or 0) > 0 then
		data.Featured = landmarkId
		return true
	end
	return false
end

function PlayerState.setSetting(data: Data, key: any, value: any): boolean
	if key == "AutoFeature" and type(value) == "boolean" then
		data.Settings.AutoFeature = value
		return true
	end
	return false
end

-- 환생 --------------------------------------------------------------------

-- rebirths 번 환생한 플레이어의 다음 환생 조건(복사본)
function PlayerState.rebirthRequirement(rebirths: number): RebirthRequirement
	local steps = Config.REBIRTHS
	local n = math.max(0, math.floor(rebirths)) + 1
	local step = steps[math.min(n, #steps)]
	local coins = step.Coins
	if n > #steps then
		coins *= Config.REBIRTH_COIN_GROWTH ^ (n - #steps)
	end
	return { Coins = coins, Landmarks = table.clone(step.Landmarks) }
end

-- 반환: 환생 가능 여부, 이번 판에 없는 요구 명소 Id 목록, 모자란 코인(0 이상)
function PlayerState.canRebirth(data: Data | Snapshot): (boolean, { string }, number)
	local requirement = PlayerState.rebirthRequirement(rebirthsOf(data))
	local missing = {}
	for _, id in requirement.Landmarks do
		if (data.Inventory[id] or 0) <= 0 then
			table.insert(missing, id)
		end
	end
	local coinsShort = math.max(0, math.ceil(requirement.Coins - data.Coins))
	return #missing == 0 and coinsShort == 0, missing, coinsShort
end

-- 환생: 코인·업그레이드·보유 명소·대표 명소 초기화, 환생 수 +1.
-- 유지: 발견 기록(Discovered = 도감·여권 도장), 설정, 굴림 수, 부스트, 영수증.
-- 반환: 성공 여부, 실패 사유(표시용)
function PlayerState.rebirth(data: Data): (boolean, string?)
	local ok, missing = PlayerState.canRebirth(data)
	if not ok then
		if #missing > 0 then
			return false, "필요한 명소가 없습니다"
		end
		return false, "코인이 부족합니다"
	end
	for id in data.Inventory do
		data.Discovered[id] = true
	end
	table.clear(data.Inventory)
	data.Featured = nil
	data.Coins = 0
	for _, upgrade in Config.Upgrades do
		data.Upgrades[upgrade.Id] = 0
	end
	data.Rebirths = rebirthsOf(data) + 1
	return true, nil
end

-- 구매 영수증 / 상품 지급 --------------------------------------------------------

function PlayerState.hasReceipt(data: Data, purchaseId: any): boolean
	return table.find(data.Receipts, tostring(purchaseId)) ~= nil
end

-- 지급한 영수증을 기록(이미 있으면 그대로). 최근 MAX_RECEIPTS 개만 보관.
function PlayerState.addReceipt(data: Data, purchaseId: any)
	local key = tostring(purchaseId)
	if table.find(data.Receipts, key) then
		return
	end
	table.insert(data.Receipts, key)
	trimReceipts(data.Receipts)
end

-- 개발자 상품 효과를 data 에 적용. productKey 는 Config.Products 의 Id.
-- 개인 부스트는 남은 시간 추가, 코인 팩은 max(MinCoins, 초당 수입(mods 반영) × IncomeSeconds) 코인,
-- 서버 전체 부스트는 data 를 바꾸지 않고 Grant.ServerWide 로 알려 줌(서버가 서버 변수에 반영).
-- 영수증 기록(addReceipt)은 따로 해야 함.
function PlayerState.grantProduct(data: Data, productKey: any, mods: Mods?): (boolean, Grant?)
	local product = if type(productKey) == "string" then PlayerState.ProductsById[productKey] else nil
	if not product then
		return false, nil
	end
	if product.ServerWide then
		return true, { Product = product.Id, Coins = 0, Seconds = product.Seconds or 0, ServerWide = true }
	end
	if isPersonalBoost(product) then
		local before = PlayerState.boostLeft(data, product.Id)
		PlayerState.addBoost(data, product.Id)
		local added = PlayerState.boostLeft(data, product.Id) - before
		return true, { Product = product.Id, Coins = 0, Seconds = added, ServerWide = false }
	end
	if product.IncomeSeconds or product.MinCoins then
		local fromIncome = PlayerState.incomePerSecond(data, mods) * (product.IncomeSeconds or 0)
		local amount = math.floor(math.max(product.MinCoins or 0, fromIncome))
		data.Coins += amount
		return true, { Product = product.Id, Coins = amount, Seconds = 0, ServerWide = false }
	end
	return false, nil
end

-- 스냅샷 --------------------------------------------------------------------

function PlayerState.snapshot(data: Data, revision: number, mods: Mods?): Snapshot
	local passes = {}
	for _, pass in ownedPasses(mods) do
		passes[pass.Id] = true
	end
	return {
		Revision = revision,
		Rolls = data.Rolls,
		Coins = data.Coins,
		Inventory = table.clone(data.Inventory),
		Discovered = table.clone(data.Discovered),
		Featured = data.Featured,
		Upgrades = table.clone(data.Upgrades),
		Settings = table.clone(data.Settings),
		Rebirths = data.Rebirths,
		Boosts = table.clone(data.Boosts),
		Passes = passes,
		ServerLuck = mods ~= nil and mods.ServerLuck == true,
		NextRebirth = PlayerState.rebirthRequirement(data.Rebirths),
		Luck = PlayerState.luck(data, mods),
		Cooldown = PlayerState.cooldown(data, mods),
		Income = PlayerState.incomePerSecond(data, mods),
	}
end

return PlayerState
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">RollLogic</string>
          <string name="Source"><![CDATA[--!strict
-- 굴림 판정 (순수 함수 — 서버/테스트에서 공용)
--
-- 방식: 가장 희귀한 오라부터 차례로 "luck / N" 확률 판정을 하고, 처음 성공한 오라를 줍니다.
-- 모두 실패하면 가장 흔한 오라. 그래서 행운 1 에서 희귀 오라는 거의 정확히 1/N,
-- 행운이 L 배면 희귀 오라 확률도 약 L 배가 됩니다. 행운이 N 이상이면 그보다 흔한 오라는 안 나옵니다.

export type Rollable = { Id: string, OneIn: number }

local RollLogic = {}

-- rarestFirst: OneIn 내림차순 목록. nextNumber: [0, 1) 난수 함수.
function RollLogic.roll<T>(rarestFirst: { T & Rollable }, luck: number, nextNumber: () -> number): T & Rollable
	local count = #rarestFirst
	for i = 1, count - 1 do
		local aura = rarestFirst[i]
		-- nextNumber() < luck / OneIn 과 같지만 나눗셈 오차가 없음
		if nextNumber() * aura.OneIn < luck then
			return aura
		end
	end
	return rarestFirst[count]
end

-- 주어진 행운에서 각 오라가 실제로 나올 확률 { [Id] = p } (합계 1)
function RollLogic.probabilities(rarestFirst: { Rollable }, luck: number): { [string]: number }
	local result = {}
	local remaining = 1
	local count = #rarestFirst
	for i = 1, count - 1 do
		local aura = rarestFirst[i]
		local p = math.min(1, luck / aura.OneIn)
		result[aura.Id] = remaining * p
		remaining *= 1 - p
	end
	result[rarestFirst[count].Id] = remaining
	return result
end

return RollLogic
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="13">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="14">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- 서버 진입점: 플레이어 데이터, 굴림 판정(서버 권위), 관광 수입, 업그레이드, 환생, 유료 상품,
-- 공원/대표 명소 표시, 뉴스 속보

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Landmarks = require(Shared.Landmarks)
local Net = require(Shared.Net)
local PlayerState = require(Shared.PlayerState)
local RollLogic = require(Shared.RollLogic)

local DataService = require(script.DataService)
local FeaturedDisplay = require(script.FeaturedDisplay)
local ParkService = require(script.ParkService)
local World = require(script.World)

-- 세계 명소(Rank 4) 이상은 굴린 사람의 연출(최대 약 4초)이 끝난 뒤에 공원/리더보드/뉴스/홀로그램에 반영
-- (굴린 본인의 클라이언트는 연출이 끝날 때까지 자기 뉴스 속보를 따로 보류함)
local REVEAL_GRACE = 4.5
local REVEAL_RANK = 4
-- 관광 수입은 서버가 1초마다 쌓고, 클라이언트는 Income 으로 코인을 부드럽게 올려 보여 줌.
-- 마지막으로 상태를 보낸 뒤 이만큼 지나면 다시 보내서 오차를 바로잡음(매초 보내지 않음)
local RESYNC_INTERVAL = 10
local TELEPORT_COOLDOWN = 1

type Session = {
	Data: PlayerState.Data,
	LockId: string?, -- nil 이면 저장하지 않음(Studio 등)
	LastRoll: number,
	Revision: number,
	LastSync: number, -- 마지막으로 Snapshot 을 만든(보낸) 시각
	LastTeleport: number,
	Stats: { Rolls: IntValue, Rebirths: IntValue, Best: StringValue },
	Plot: number?, -- 배정된 공원 부지 번호(부지가 모자라면 nil)
	-- 연출이 아직 안 끝나 공원/리더보드에 공개하지 않은 발견(명소 Id -> 횟수)
	Hidden: { [string]: number },
	-- 가진 게임패스 Id -> true (세션에만 저장. 접속 시 확인 + 구매 완료 이벤트로 갱신)
	Passes: { [string]: boolean },
}

local sessions: { [Player]: Session } = {}
local started: { [Player]: boolean } = {}
-- 게임패스 소유 정보. 데이터 로드와 동시에 확인하므로 세션보다 먼저 만들어 두고 세션이 같은 표를 씀
local passesByPlayer: { [Player]: { [string]: boolean } } = {}
local rng = Random.new()

-- 서버 행운(서버 전원에게 적용, 저장 안 함). os.clock() 기준 끝나는 시각
local serverLuckUntil = 0
local serverLuckOn = false -- 마지막으로 모두에게 알린 상태(끝날 때 한 번 상태를 다시 보내기 위함)
local serverLuckBy: { UserId: number, Name: string }? = nil -- 마지막 구매자

local function nextNumber(): number
	return rng:NextNumber()
end

local function serverLuckLeft(): number
	return math.max(0, serverLuckUntil - os.clock())
end

local function modsFor(session: Session): PlayerState.Mods
	return { Passes = session.Passes, ServerLuck = serverLuckLeft() > 0 }
end

local function snapshot(session: Session): PlayerState.Snapshot
	session.Revision += 1
	session.LastSync = time()
	return PlayerState.snapshot(session.Data, session.Revision, modsFor(session))
end

local function pushState(player: Player)
	local session = sessions[player]
	if session then
		Net.event("State"):FireClient(player, snapshot(session))
	end
end

local function pushStateAll()
	for player in sessions do
		pushState(player)
	end
end

-- 연출 중인 발견을 뺀 "남에게 보이는" 데이터. 공원·간판·리더보드로 결과가 미리 새지 않게 함.
-- (예: 세계 명소를 뽑고 1초 뒤 흔한 명소를 뽑아도 공원에는 세계 명소가 아직 안 나타남)
local function visibleData(session: Session): PlayerState.Data
	if next(session.Hidden) == nil then
		return session.Data
	end
	local inventory = table.clone(session.Data.Inventory)
	for id, count in session.Hidden do
		local left = (inventory[id] or 0) - count
		inventory[id] = if left > 0 then left else nil
	end
	local view = table.clone(session.Data)
	view.Inventory = inventory
	return view
end

-- 공원 전시 + 간판 + 리더보드 "최고"
local function refreshVisible(player: Player, session: Session)
	local visible = visibleData(session)
	local best = PlayerState.best(visible)
	session.Stats.Best.Value = if best then best.Name else "-"
	local ok, err = pcall(ParkService.update, player, visible, modsFor(session))
	if not ok then
		warn("[LandmarkRNG] 공원 갱신 실패: " .. tostring(err))
	end
end

local function refreshFeatured(player: Player)
	local session = sessions[player]
	local featured = if session and session.Data.Featured then Landmarks.ById[session.Data.Featured] else nil
	local ok, err = pcall(FeaturedDisplay.apply, player.Character, featured)
	if not ok then
		warn("[LandmarkRNG] 대표 명소 표시 실패: " .. tostring(err))
	end
end

local function createLeaderstats(player: Player): { Rolls: IntValue, Rebirths: IntValue, Best: StringValue }
	local folder = Instance.new("Folder")
	folder.Name = "leaderstats"
	local rolls = Instance.new("IntValue")
	rolls.Name = "굴림"
	rolls.Parent = folder
	local rebirths = Instance.new("IntValue")
	rebirths.Name = "환생"
	rebirths.Parent = folder
	local best = Instance.new("StringValue")
	best.Name = "최고"
	best.Value = "-"
	best.Parent = folder
	folder.Parent = player
	return { Rolls = rolls, Rebirths = rebirths, Best = best }
end

local function onCharacter(player: Player, character: Model)
	-- 머리/몸통이 생길 때까지 기다린 뒤 대표 명소를 붙임
	character:WaitForChild("Head", 10)
	character:WaitForChild("HumanoidRootPart", 10)
	if player.Character == character then
		refreshFeatured(player)
	end
end

-- BindToClose 가 진행 중인 저장을 기다릴 수 있도록 개수를 셈
local savesInFlight = 0

local function trackedSave(player: Player, data: PlayerState.Data, lockId: string, release: boolean): boolean
	savesInFlight += 1
	local ok, saved = pcall(DataService.save, player, data, lockId, release)
	savesInFlight -= 1
	if not ok then
		warn("[LandmarkRNG] 저장 오류: " .. tostring(saved))
		return false
	end
	return saved == true
end

-- 게임패스 ----------------------------------------------------------------

local function passByPassId(passId: number): Config.GamePass?
	for _, pass in Config.GamePasses do
		if pass.PassId > 0 and pass.PassId == passId then
			return pass
		end
	end
	return nil
end

-- 접속 시 게임패스 소유 확인. owned 는 세션과 같은 표라서 확인이 끝나는 대로 반영됨
local function loadPasses(player: Player, owned: { [string]: boolean })
	local found = false
	for _, pass in Config.GamePasses do
		if pass.PassId > 0 then
			local ok, result = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, pass.PassId)
			end)
			if ok and result == true then
				owned[pass.Id] = true
				found = true
			elseif not ok then
				warn(
					string.format(
						"[LandmarkRNG] %s 게임패스(%s) 확인 실패: %s",
						player.Name,
						pass.Id,
						tostring(result)
					)
				)
			end
		end
	end
	-- 세션이 아직 없으면 세션을 만들 때 보내는 첫 상태에 포함됨
	if found and sessions[player] then
		pushState(player)
	end
end

MarketplaceService.PromptGamePassPurchaseFinished:Connect(
	function(player: Player, passId: number, wasPurchased: boolean)
		if not wasPurchased then
			return
		end
		local pass = passByPassId(passId)
		local owned = passesByPlayer[player]
		if pass and owned then
			owned[pass.Id] = true
			pushState(player)
		end
	end
)

-- 서버 행운 ----------------------------------------------------------------

-- 클라이언트용 서버 행운 정보. Until 은 workspace:GetServerTimeNow() 기준 끝나는 시각, Left 는 보낼 때 남은 초
local function serverLuckInfo()
	local left = serverLuckLeft()
	return {
		UserId = if serverLuckBy then serverLuckBy.UserId else 0,
		Name = if serverLuckBy then serverLuckBy.Name else "",
		Until = workspace:GetServerTimeNow() + left,
		Left = left,
	}
end

local function extendServerLuck(buyer: Player, seconds: number)
	local now = os.clock()
	serverLuckUntil = math.min(math.max(serverLuckUntil, now) + seconds, now + Config.MAX_BOOST_SECONDS)
	serverLuckOn = true
	serverLuckBy = { UserId = buyer.UserId, Name = buyer.DisplayName }
	Net.event("ServerLuck"):FireAllClients(serverLuckInfo())
	pushStateAll()
	print(string.format("[LandmarkRNG] %s 님이 서버 행운 %d초 추가", buyer.Name, seconds))
end

-- 플레이어 입장/퇴장 -----------------------------------------------------------

local function onPlayerAdded(player: Player)
	if started[player] then
		return
	end
	started[player] = true

	-- 게임패스 확인은 데이터 로드와 동시에 진행
	local passes = {}
	passesByPlayer[player] = passes
	task.spawn(loadPasses, player, passes)

	local data, lockId = DataService.load(player)
	if player.Parent == nil then
		-- 불러오는 동안 나감: 방금 건 세션 잠금을 풀어 둬야 다음 접속이 기다리지 않음
		started[player] = nil
		passesByPlayer[player] = nil
		if data and lockId then
			trackedSave(player, data, lockId, true)
		end
		return
	end
	if not data then
		player:Kick("데이터를 불러오지 못했습니다. 잠시 후 다시 접속해 주세요.")
		return
	end

	local session: Session = {
		Data = data,
		LockId = lockId,
		LastRoll = -math.huge,
		Revision = 0,
		LastSync = time(),
		LastTeleport = -math.huge,
		Stats = createLeaderstats(player),
		Plot = nil,
		Hidden = {},
		Passes = passes,
	}
	sessions[player] = session
	session.Stats.Rolls.Value = data.Rolls
	session.Stats.Rebirths.Value = data.Rebirths

	-- 공원 부지 배정 + 전시
	local ok, result = pcall(ParkService.assign, player)
	if ok then
		session.Plot = result
	else
		warn("[LandmarkRNG] 공원 부지 배정 실패: " .. tostring(result))
	end
	refreshVisible(player, session)

	player.CharacterAdded:Connect(function(character)
		onCharacter(player, character)
	end)
	-- 일부 아바타(다이나믹 헤드 등)는 외형 로딩 중 머리를 교체하므로 로딩이 끝난 뒤 한 번 더 붙임
	player.CharacterAppearanceLoaded:Connect(function(character)
		if player.Character == character then
			refreshFeatured(player)
		end
	end)
	if player.Character then
		task.spawn(onCharacter, player, player.Character)
	end
	pushState(player)
	-- 서버 행운이 이미 진행 중이면 남은 시간을 알려 줌
	if serverLuckLeft() > 0 then
		Net.event("ServerLuck"):FireClient(player, serverLuckInfo())
	end
end

local function saveAndRelease(player: Player)
	started[player] = nil
	passesByPlayer[player] = nil
	local ok, err = pcall(ParkService.release, player)
	if not ok then
		warn("[LandmarkRNG] 공원 부지 정리 실패: " .. tostring(err))
	end
	local session = sessions[player]
	if not session then
		return
	end
	sessions[player] = nil
	if session.LockId then
		trackedSave(player, session.Data, session.LockId, true)
	end
end

-- 월드(광장 + 지구본)와 공원 부지. 실패해도 굴리기/저장은 되도록 pcall
do
	local ok, err = pcall(World.build)
	if not ok then
		warn("[LandmarkRNG] 광장을 만들지 못했습니다: " .. tostring(err))
	end
	ok, err = pcall(ParkService.init)
	if not ok then
		warn("[LandmarkRNG] 공원 부지를 만들지 못했습니다: " .. tostring(err))
	end
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(saveAndRelease)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

-- 서버 종료 시 남은 플레이어를 병렬로 저장하고, 퇴장 처리 중인 저장까지 끝나길 기다림(최대 약 25초)
game:BindToClose(function()
	for player in sessions do
		task.spawn(saveAndRelease, player)
	end
	local deadline = os.clock() + 25
	while savesInFlight > 0 and os.clock() < deadline do
		task.wait(0.1)
	end
end)

-- 자동 저장
task.spawn(function()
	while true do
		task.wait(Config.AUTOSAVE_INTERVAL)
		for player, session in sessions do
			if session.LockId then
				task.spawn(DataService.save, player, session.Data, session.LockId, false)
			end
		end
	end
end)

-- 관광 수입 + 시간 부스트 (접속 중에만). 상태는 매초 보내지 않고 RESYNC_INTERVAL 마다 재동기화만.
-- 굴리는 중인 플레이어는 굴림 응답마다 상태를 받으므로 재동기화가 연출 도중에 끼어들지 않음.
-- 부스트가 끝나거나 서버 행운이 끝나면 행운이 바뀌므로 바로 상태를 보냄.
task.spawn(function()
	while true do
		local dt = task.wait(1)
		local now = time()
		local serverLuckEnded = serverLuckOn and serverLuckLeft() <= 0
		if serverLuckEnded then
			serverLuckOn = false
		end
		for player, session in sessions do
			PlayerState.addIncome(session.Data, dt, modsFor(session))
			local expired = PlayerState.tickBoosts(session.Data, dt)
			if expired or serverLuckEnded or now - session.LastSync >= RESYNC_INTERVAL then
				pushState(player)
			end
		end
	end
end)

local function announce(player: Player, landmark: Landmarks.Landmark, rollNumber: number)
	local hologram = landmark.OneIn >= Config.HOLOGRAM_ONE_IN
	Net.event("Announce"):FireAllClients({
		UserId = player.UserId,
		Name = player.DisplayName,
		LandmarkId = landmark.Id,
		Rolls = rollNumber,
		Hologram = hologram,
	})
	if hologram then
		local ok, err = pcall(World.hologram, landmark)
		if not ok then
			warn("[LandmarkRNG] 홀로그램 실패: " .. tostring(err))
		end
	end
	print(
		string.format(
			"[LandmarkRNG] %s 님이 %s (%s) 발견 — %d번째 굴림",
			player.Name,
			landmark.Name,
			Format.oneIn(landmark.OneIn),
			rollNumber
		)
	)
end

-- 희귀 발견을 연출이 끝날 때까지 숨겼다가 공개
local function revealLater(player: Player, session: Session, landmark: Landmarks.Landmark)
	session.Hidden[landmark.Id] = (session.Hidden[landmark.Id] or 0) + 1
	task.delay(REVEAL_GRACE, function()
		local left = (session.Hidden[landmark.Id] or 1) - 1
		session.Hidden[landmark.Id] = if left > 0 then left else nil
		if sessions[player] == session then
			refreshVisible(player, session)
		end
	end)
end

-- 개발자 상품 구매 처리 --------------------------------------------------------
-- 지급 + 저장 성공 후에만 PurchaseGranted. 같은 PurchaseId 는 Data.Receipts 로 한 번만 지급.
-- 저장이 실패하면 NotProcessedYet → Roblox 가 나중에 다시 부르고, 그때는 영수증이 이미 있으니 저장만 다시 시도.

local function productByProductId(productId: number): Config.Product?
	for _, product in Config.Products do
		if product.ProductId > 0 and product.ProductId == productId then
			return product
		end
	end
	return nil
end

local function processReceipt(receiptInfo: { [string]: any }): Enum.ProductPurchaseDecision
	local player = Players:GetPlayerByUserId(receiptInfo.PlayerId)
	local session = if player then sessions[player] else nil
	if not player or not session then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local purchaseId = tostring(receiptInfo.PurchaseId)
	if not PlayerState.hasReceipt(session.Data, purchaseId) then
		local product = productByProductId(receiptInfo.ProductId)
		if not product then
			warn("[LandmarkRNG] 모르는 개발자 상품: " .. tostring(receiptInfo.ProductId))
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		local ok, grant = PlayerState.grantProduct(session.Data, product.Id, modsFor(session))
		if not ok or not grant then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		PlayerState.addReceipt(session.Data, purchaseId)
		if grant.ServerWide then
			extendServerLuck(player, grant.Seconds)
		else
			pushState(player)
		end
	end

	-- Studio(저장 안 함)에서는 효과만 적용되고 완료 처리는 되지 않음
	if not session.LockId then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if trackedSave(player, session.Data, session.LockId, false) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	return Enum.ProductPurchaseDecision.NotProcessedYet
end

MarketplaceService.ProcessReceipt = function(receiptInfo)
	local ok, decision = pcall(processReceipt, receiptInfo)
	if ok then
		return decision
	end
	warn("[LandmarkRNG] 구매 처리 오류: " .. tostring(decision))
	return Enum.ProductPurchaseDecision.NotProcessedYet
end

-- 원격 함수 --------------------------------------------------------------

Net.fn("GetState").OnServerInvoke = function(player: Player)
	-- 클라이언트가 데이터 로드보다 먼저 시작할 수 있으므로 최대 30초 대기
	local deadline = os.clock() + 30
	while not sessions[player] and player.Parent and os.clock() < deadline do
		task.wait(0.2)
	end
	local session = sessions[player]
	return if session then snapshot(session) else nil
end

Net.fn("Roll").OnServerInvoke = function(player: Player)
	local session = sessions[player]
	if not session then
		return { Ok = false, Reason = "loading" }
	end

	-- 쿨타임: 허용 오차만큼 일찍 와도 받아주되, 기준 시각은 "원래 가능했던 시각"으로 밀어서
	-- 오차를 반복 악용해도 평균 속도가 빨라지지 않게 합니다.
	local mods = modsFor(session)
	local now = time()
	local cooldown = PlayerState.cooldown(session.Data, mods)
	local readyAt = session.LastRoll + cooldown
	if now < readyAt - Config.COOLDOWN_TOLERANCE then
		return { Ok = false, Reason = "cooldown", RetryIn = readyAt - now }
	end
	session.LastRoll = math.max(now, readyAt)

	local luck = PlayerState.luck(session.Data, mods)
	local landmark = RollLogic.roll(Landmarks.RarestFirst, luck, nextNumber)
	local bonus, isNew, starUp = PlayerState.applyRoll(session.Data, landmark)
	local rollNumber = session.Data.Rolls
	session.Stats.Rolls.Value = rollNumber

	-- 세계 명소 이상은 연출이 끝난 뒤에 공원/리더보드("최고")에 반영해야 결과가 미리 새지 않음
	if landmark.Tier.Rank >= REVEAL_RANK then
		revealLater(player, session, landmark)
	else
		refreshVisible(player, session)
	end
	if landmark.OneIn >= Config.ANNOUNCE_ONE_IN then
		task.delay(REVEAL_GRACE, announce, player, landmark, rollNumber)
	end

	return {
		Ok = true,
		LandmarkId = landmark.Id,
		Luck = luck,
		Bonus = bonus,
		IsNew = isNew,
		StarUp = starUp,
		Stars = PlayerState.stars(session.Data.Inventory[landmark.Id] or 0),
		State = snapshot(session),
	}
end

-- 대표 명소 지정/해제. 자동 지정 여부는 클라이언트가 연출 뒤에 판단해서 요청함(서버는 검증만).
Net.fn("Feature").OnServerInvoke = function(player: Player, landmarkId: any)
	local session = sessions[player]
	if not session then
		return { Ok = false }
	end
	local before = session.Data.Featured
	local ok = PlayerState.feature(session.Data, landmarkId)
	if ok and session.Data.Featured ~= before then
		refreshFeatured(player)
	end
	return { Ok = ok, State = snapshot(session) }
end

Net.fn("BuyUpgrade").OnServerInvoke = function(player: Player, upgradeId: any)
	local session = sessions[player]
	if not session then
		return { Ok = false, Reason = "데이터를 불러오는 중입니다" }
	end
	local ok, reason = PlayerState.buyUpgrade(session.Data, upgradeId)
	if ok then
		-- 공원 확장(칸 수), 입장료(간판의 수입) 등이 바뀔 수 있음. 바뀐 칸만 다시 만듦
		refreshVisible(player, session)
	end
	return { Ok = ok, Reason = reason, State = snapshot(session) }
end

Net.fn("SetSetting").OnServerInvoke = function(player: Player, key: any, value: any)
	local session = sessions[player]
	if not session then
		return { Ok = false }
	end
	local ok = PlayerState.setSetting(session.Data, key, value)
	return { Ok = ok, State = snapshot(session) }
end

-- 환생: 코인·업그레이드·보유 명소·대표 명소 초기화 → 공원/간판/리더보드/대표 명소 표시 갱신
Net.fn("Rebirth").OnServerInvoke = function(player: Player)
	local session = sessions[player]
	if not session then
		return { Ok = false, Reason = "데이터를 불러오는 중입니다" }
	end
	local ok, reason = PlayerState.rebirth(session.Data)
	if ok then
		session.Stats.Rebirths.Value = session.Data.Rebirths
		refreshVisible(player, session)
		refreshFeatured(player)
		pushState(player)
		print(string.format("[LandmarkRNG] %s 님 %d번째 환생", player.Name, session.Data.Rebirths))
	end
	return { Ok = ok, Reason = reason, State = snapshot(session) }
end

-- 구매 창 띄우기. 결과는 구매 완료 이벤트 / ProcessReceipt 에서 State(+ServerLuck) 이벤트로 반영됨
Net.fn("BuyPass").OnServerInvoke = function(player: Player, passKey: any)
	local pass = if type(passKey) == "string" then PlayerState.PassesById[passKey] else nil
	if not pass or pass.PassId <= 0 then
		return { Ok = false }
	end
	local owned = passesByPlayer[player]
	if owned and owned[pass.Id] then
		return { Ok = false }
	end
	local ok, err = pcall(function()
		MarketplaceService:PromptGamePassPurchase(player, pass.PassId)
	end)
	if not ok then
		warn("[LandmarkRNG] 게임패스 구매 창 실패: " .. tostring(err))
	end
	return { Ok = ok }
end

Net.fn("BuyProduct").OnServerInvoke = function(player: Player, productKey: any)
	local product = if type(productKey) == "string" then PlayerState.ProductsById[productKey] else nil
	if not product or product.ProductId <= 0 then
		return { Ok = false }
	end
	local session = sessions[player]
	if not session then
		return { Ok = false }
	end
	-- 시간 부스트는 최대 시간을 넘겨서 사면 남는 시간이 버려지므로 구매 창을 띄우지 않음
	local seconds = product.Seconds
	if seconds then
		local left = if product.ServerWide then serverLuckLeft() else PlayerState.boostLeft(session.Data, product.Id)
		if left + seconds > Config.MAX_BOOST_SECONDS then
			return { Ok = false }
		end
	end
	local ok, err = pcall(function()
		MarketplaceService:PromptProductPurchase(player, product.ProductId)
	end)
	if not ok then
		warn("[LandmarkRNG] 개발자 상품 구매 창 실패: " .. tostring(err))
	end
	return { Ok = ok }
end

Net.fn("Teleport").OnServerInvoke = function(player: Player, where: any)
	if where ~= "Park" and where ~= "Plaza" then
		return { Ok = false }
	end
	local session = sessions[player]
	if not session then
		return { Ok = false }
	end
	local now = time()
	if now - session.LastTeleport < TELEPORT_COOLDOWN then
		return { Ok = false }
	end

	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not character or not humanoid or humanoid.Health <= 0 or not root then
		return { Ok = false }
	end

	local target: CFrame
	if where == "Park" then
		local entrance = ParkService.entranceCFrame(player)
		if not entrance then
			return { Ok = false }
		end
		target = entrance + Vector3.new(0, 3, 0) -- 캐릭터 피벗(HumanoidRootPart)은 발바닥보다 약 3 스터드 위
	else
		target = World.plazaCFrame()
	end

	session.LastTeleport = now
	humanoid.Sit = false
	character:PivotTo(target)
	return { Ok = true }
end
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[-- DataStore 저장/불러오기 + 세션 잠금
--
-- 저장 형식: { Data = PlayerState.Data, Lock = { Id, JobId, Time }? }
-- 세션 잠금: 불러올 때마다 새 잠금 Id 를 발급하고, 저장은 그 Id 가 기록에 그대로 있을 때만 합니다.
--   · 이전 세션(다른 서버든 같은 서버 재접속이든)이 아직 저장 중이면 잠시 기다렸다가 불러옴
--   · 퇴장 저장으로 잠금이 풀린 뒤 늦게 도착한 자동 저장은 무시됨(잠금을 다시 걸지 않음)
--   · 잠금이 만료되어 다른 세션이 가져갔으면 그쪽 데이터를 덮어쓰지 않음

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local PlayerState = require(Shared.PlayerState)

local LOCK_EXPIRE_SECONDS = Config.AUTOSAVE_INTERVAL * 3
local LOAD_ATTEMPTS = 6
local SAVE_ATTEMPTS = 3

local DataService = {}

local store: DataStore? = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DATASTORE_NAME)
	end)
	if ok then
		store = result
	else
		warn("[DataService] DataStore 를 열 수 없습니다: " .. tostring(result))
	end
end

local function keyFor(player: Player): string
	return "player_" .. player.UserId
end

local function newLock(lockId: string)
	return { Id = lockId, JobId = game.JobId, Time = os.time() }
end

-- 반환: data(실패 시 nil), lockId(nil 이면 저장하지 않음)
-- Studio 에서 API 접근이 꺼져 있으면 새 데이터로 플레이만 하고 저장은 하지 않습니다.
function DataService.load(player: Player): (PlayerState.Data?, string?)
	if not store then
		if RunService:IsStudio() then
			return PlayerState.new(), nil
		end
		return nil, nil
	end

	local lockId = HttpService:GenerateGUID(false)
	for attempt = 1, LOAD_ATTEMPTS do
		local steal = attempt == LOAD_ATTEMPTS
		local blocked = false
		local loaded: any = nil

		local ok, err = pcall(function()
			store:UpdateAsync(keyFor(player), function(record)
				-- UpdateAsync 는 충돌 시 이 함수를 다시 부를 수 있으므로 결과 변수는 매번 초기화
				blocked = false
				loaded = nil
				record = if type(record) == "table" then record else {}
				local lock = record.Lock
				if
					not steal
					and type(lock) == "table"
					and lock.Id ~= lockId
					and os.time() - (tonumber(lock.Time) or 0) < LOCK_EXPIRE_SECONDS
				then
					blocked = true
					return nil -- 쓰기 취소
				end
				loaded = record.Data
				record.Lock = newLock(lockId)
				return record
			end)
		end)

		if ok and not blocked then
			return PlayerState.reconcile(loaded), lockId
		end
		if not ok then
			warn(
				string.format(
					"[DataService] %s 불러오기 실패(%d/%d): %s",
					player.Name,
					attempt,
					LOAD_ATTEMPTS,
					tostring(err)
				)
			)
			if RunService:IsStudio() then
				-- 게시 안 된 place 이거나 API 접근이 꺼진 경우: 테스트는 되도록 저장 없이 진행
				warn(
					"[DataService] Studio 에서는 저장 없이 진행합니다. 저장까지 테스트하려면 게임을 게시하고 "
						.. "Game Settings > Security > 'Enable Studio Access to API Services' 를 켜세요."
				)
				return PlayerState.new(), nil
			end
		end
		if player.Parent == nil then
			return nil, nil
		end
		task.wait(if blocked then 5 else attempt * 1.5)
	end
	return nil, nil
end

-- lockId: load 가 돌려준 값. release=true 면 잠금을 풀어 다음 세션이 바로 불러갈 수 있게 합니다(퇴장 시).
function DataService.save(player: Player, data: PlayerState.Data, lockId: string, release: boolean): boolean
	if not store then
		return false
	end
	for attempt = 1, SAVE_ATTEMPTS do
		local stale = false
		local ok, err = pcall(function()
			store:UpdateAsync(keyFor(player), function(record)
				stale = false
				record = if type(record) == "table" then record else {}
				local lock = record.Lock
				if type(lock) ~= "table" or lock.Id ~= lockId then
					-- 이미 풀린 잠금(퇴장 저장 완료)이거나 다른 세션이 가져간 경우: 덮어쓰지 않음
					stale = true
					return nil
				end
				record.Data = data
				record.Lock = if release then nil else newLock(lockId)
				return record
			end)
		end)
		if ok then
			if stale then
				warn(
					"[DataService] "
						.. player.Name
						.. " 의 세션이 이미 끝났거나 다른 세션이 데이터를 사용 중이라 저장을 건너뜁니다."
				)
				return false
			end
			return true
		end
		warn(
			string.format(
				"[DataService] %s 저장 실패(%d/%d): %s",
				player.Name,
				attempt,
				SAVE_ATTEMPTS,
				tostring(err)
			)
		)
		if attempt < SAVE_ATTEMPTS then
			task.wait(attempt * 2)
		end
	end
	return false
end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">FeaturedDisplay</string>
          <string name="Source"><![CDATA[-- 대표 명소를 캐릭터에 표시: 오른쪽 어깨 옆에 작은 모형이 붙어 다니고, 머리 위에 명소 이름표
-- 모형은 HumanoidRootPart 에 용접(Weld)해서 캐릭터와 함께 움직입니다(무게 없음, 충돌 없음).
-- 이름표는 UI 스타일 가이드 v2 를 따름: 등급 색 통통한 딱지 + 흰 FredokaOne 글자 + Ink 테두리(이모지 없음).
-- Shared/ImageIds.star 그림이 있으면 이름 왼쪽에 작은 별 아이콘을 붙임.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Landmarks = require(Shared.Landmarks)
local Models = require(Shared.Models)

-- 그림 Id 표 (없거나 깨져도 코드로 그린 모양으로 동작)
local function loadImageIds(): { [string]: any }
	local module = Shared:FindFirstChild("ImageIds")
	if module and module:IsA("ModuleScript") then
		local ok, result = pcall(require, module)
		if ok and type(result) == "table" then
			return result
		end
	end
	return {}
end
local ImageIds = loadImageIds()

-- 그림 Id ("rbxassetid://...") 또는 nil
local function imageId(name: string): string?
	local value = ImageIds[name]
	if type(value) == "number" then
		return "rbxassetid://" .. tostring(value)
	elseif type(value) == "string" and value ~= "" then
		return if value:match("^%d+$") then "rbxassetid://" .. value else value
	end
	return nil
end

local FX_NAME = "FeaturedLandmark"
local MODEL_SIZE = 2.4
local MAX_DIMENSION = 2.6 -- 가로·세로·높이 중 가장 긴 쪽 상한(키 큰 명소가 캐릭터만큼 커지지 않게)
local SHOULDER_OFFSET = CFrame.new(2.4, 0.9, 0) -- HumanoidRootPart 기준: 오른쪽 어깨 옆(모형 바닥 높이)
local LABEL_DISTANCE = 80
local TAG_HEIGHT = 1.1 -- 이름표 높이(스터드). 너비는 이름 길이에 맞춤

local INK = Color3.fromRGB(30, 27, 46)
local WHITE = Color3.new(1, 1, 1)

local FeaturedDisplay = {}

local function clear(character: Model)
	for _, descendant in character:GetDescendants() do
		if descendant.Name == FX_NAME then
			descendant:Destroy()
		end
	end
end

local function attachModel(character: Model, landmark: Landmarks.Landmark)
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then
		return
	end
	local ok, result = pcall(Models.create, landmark, MODEL_SIZE, { Anchored = false })
	if not ok then
		warn("[FeaturedDisplay] " .. landmark.Id .. " 모형을 만들지 못했습니다: " .. tostring(result))
		return
	end
	local model = result :: Model
	model.Name = FX_NAME
	local extents = model:GetExtentsSize()
	local longest = math.max(extents.X, extents.Y, extents.Z)
	if longest > MAX_DIMENSION then
		model:ScaleTo(model:GetScale() * MAX_DIMENSION / longest)
	end
	model:PivotTo(root.CFrame * SHOULDER_OFFSET)

	-- 파트마다 지금 위치 그대로 HumanoidRootPart 에 고정
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.Anchored = false
			descendant.Massless = true
			descendant.CanCollide = false
			descendant.CastShadow = false
			local weld = Instance.new("Weld")
			weld.C0 = root.CFrame:ToObjectSpace(descendant.CFrame)
			weld.Part0 = root
			weld.Part1 = descendant
			weld.Parent = descendant
		end
	end
	model.Parent = character
end

local function corner(gui: GuiObject)
	local round = Instance.new("UICorner")
	round.CornerRadius = UDim.new(0.5, 0) -- 캡슐 모양
	round.Parent = gui
end

local function stroke(gui: GuiObject, thickness: number)
	local line = Instance.new("UIStroke")
	line.Thickness = thickness
	line.Color = INK
	line.Parent = gui
end

-- 머리 위 이름표: 어두운 그림자 판 위에 등급 색 앞면(위쪽이 살짝 밝음), 흰 이름 + Ink 글자 테두리
local function attachLabel(character: Model, landmark: Landmarks.Landmark)
	local head = character:FindFirstChild("Head")
	if not head or not head:IsA("BasePart") then
		return
	end
	-- 한글 한 글자 폭 ≈ 글자 높이(약 0.7 스터드) + 양옆 여백. 별 아이콘이 있으면 그만큼 넓힘
	local chars = utf8.len(landmark.Name) or #landmark.Name
	local starId = imageId("star")
	local iconWidth = if starId then TAG_HEIGHT * 0.9 else 0
	local width = math.clamp(chars * 0.72 + 0.9, 2.6, 8) + iconWidth

	local billboard = Instance.new("BillboardGui")
	billboard.Name = FX_NAME
	billboard.Adornee = head
	billboard.Size = UDim2.fromScale(width, TAG_HEIGHT)
	billboard.StudsOffset = Vector3.new(0, 2.7, 0)
	billboard.MaxDistance = LABEL_DISTANCE
	billboard.LightInfluence = 0
	billboard.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

	local tier = landmark.Tier.Color
	local shadow = Instance.new("Frame")
	shadow.Name = "Shadow"
	shadow.Size = UDim2.fromScale(1, 0.86)
	shadow.Position = UDim2.fromScale(0, 0.14)
	shadow.BackgroundColor3 = tier:Lerp(INK, 0.4)
	shadow.BorderSizePixel = 0
	shadow.ZIndex = 1
	corner(shadow)
	stroke(shadow, 2)
	shadow.Parent = billboard

	local face = Instance.new("Frame")
	face.Name = "Face"
	face.Size = UDim2.fromScale(1, 0.86)
	face.BackgroundColor3 = tier
	face.BorderSizePixel = 0
	face.ZIndex = 2
	corner(face)
	stroke(face, 2)
	local shine = Instance.new("UIGradient")
	shine.Color = ColorSequence.new(WHITE, Color3.fromRGB(214, 214, 214))
	shine.Rotation = 90 -- 위 → 아래
	shine.Parent = face
	face.Parent = billboard

	local label = Instance.new("TextLabel")
	label.Name = "Name"
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.Text = landmark.Name
	label.TextColor3 = WHITE
	stroke(label, 2)
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0.08 + iconWidth / width, 0)
	pad.PaddingRight = UDim.new(0.08, 0)
	pad.PaddingTop = UDim.new(0.14, 0)
	pad.PaddingBottom = UDim.new(0.14, 0)
	pad.Parent = label
	label.Parent = face

	if starId then
		-- 이름 왼쪽 별 (딱지 높이보다 조금 커서 위아래로 살짝 삐져나옴)
		local star = Instance.new("ImageLabel")
		star.Name = "Star"
		star.BackgroundTransparency = 1
		star.Image = starId
		star.ScaleType = Enum.ScaleType.Fit
		star.SizeConstraint = Enum.SizeConstraint.RelativeYY
		star.Size = UDim2.fromScale(1.3, 1.3)
		star.AnchorPoint = Vector2.new(0, 0.5)
		star.Position = UDim2.new(0, 0, 0.5, 0)
		star.ZIndex = 3
		star.Parent = face
	end

	billboard.Parent = head
end

-- 이전 표시를 지우고, landmark 가 있으면 새로 붙임(nil 이면 지우기만)
function FeaturedDisplay.apply(character: Model?, landmark: Landmarks.Landmark?)
	if not character then
		return
	end
	clear(character)
	if landmark then
		attachModel(character, landmark)
		attachLabel(character, landmark)
	end
end

return FeaturedDisplay
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">ParkService</string>
          <string name="Source"><![CDATA[-- 관광 공원 부지: 광장을 둘러싼 원형 배치. 플레이어마다 부지 하나를 배정하고 미니어처를 전시합니다.
--
-- 배치: 안쪽 고리 8칸(반지름 115), 바깥 고리 16칸(반지름 210). 반지름은 광장 중심에서 부지 "입구"
--   (광장 쪽 가장자리)까지 거리입니다. 부지 중심까지로 잡으면 이웃 부지끼리 겹치기 때문.
-- 부지 좌표계: 부지 중앙 바닥이 원점, -Z(LookVector)가 광장 쪽 = 입구.
-- 전시 칸: 6x6 격자. 입구에 가까운 줄부터, 한 줄 안에서는 가운데에 가까운 칸부터 채워서
--   가장 희귀한 명소가 입구 정면에 오도록 합니다.
-- update 는 칸마다 이전 상태를 기억해 두고 바뀐 칸만 다시 만듭니다(별 개수는 이름표 글자만 바꿈).
-- 간판: 주인이 있으면 입구 아치(나무 판자 + Ink 테두리 + 크림 글자판: 공원 아이콘 + 이름, 초록 알약: 동전 + "+X/s"),
--   빈 부지는 길 옆 낮은 말뚝 간판("빈 부지")만 세워서 빈 부지가 20곳 넘어도 광장에서 볼 때 어지럽지 않게 합니다.
-- 그림: Shared/ImageIds 에 park/coin 아이콘, panel_paper/pill 스킨 Id 가 있으면 간판에 그 그림을 씀(없으면 코드로 그림).
-- 장식: 둘레 색 띠 + 네 귀퉁이 덤불 + 옆·뒤 낮은 울타리(입구 쪽은 비움). 위에서 봐도 부지가 구분됩니다.
-- 글자 스타일은 DESIGN.md "UI 스타일 가이드 v2" 를 따름(FredokaOne, Ink 테두리, 이모지 없음).

local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Landmarks = require(Shared.Landmarks)
local Models = require(Shared.Models)
local PlayerState = require(Shared.PlayerState)

-- 그림 Id 표 (없거나 깨져도 코드로 그린 모양으로 동작)
local function loadImageIds(): { [string]: any }
	local module = Shared:FindFirstChild("ImageIds")
	if module and module:IsA("ModuleScript") then
		local ok, result = pcall(require, module)
		if ok and type(result) == "table" then
			return result
		end
	end
	return {}
end
local ImageIds = loadImageIds()

local INNER_RADIUS = 115
local OUTER_RADIUS = 210
local PLAZA_EDGE = 44 -- 길이 시작되는 곳(광장 둘레 계단 아래에서부터)

local PLOT_WIDTH = 76
local PLOT_DEPTH = 80
local BASE_TOP = 0.6 -- 부지 윗면 높이
local BORDER = 1.5 -- 부지 둘레 색 띠 폭

local GRID = Config.PARK_GRID
local SPACING = 12
local FRONT_MARGIN = 6 -- 입구와 첫 줄 사이 빈 공간
local PEDESTAL_SIZE = 10
local PEDESTAL_HEIGHT = 0.6
local MINIATURE_SIZE = 9
local LABEL_DISTANCE = 60
local PATH_WIDTH = 10

local MAX_STARS = #Config.STAR_THRESHOLDS

-- 간판 배치(부지 좌표)
local SIGN_Z = -PLOT_DEPTH / 2 - BORDER - 1 -- 입구 바로 앞(잔디 위)
local BOARD_SIZE = Vector3.new(28, 6, 0.8) -- 주인 간판 판자
local BOARD_Y = 10.5 -- 판자 중심 높이(판자 아래 7.5 스터드: 사람이 밑으로 지나감)
local FRAME = 0.6 -- 판자 둘레 Ink 테두리 굵기
local POST = 1.6 -- 간판 기둥 굵기
local STAKE_BOARD = Vector3.new(6, 2.6, 0.4) -- 빈 부지 말뚝 간판
local STAKE_X = 9 -- 말뚝 간판 위치: 길(폭 10) 바로 옆
local STAKE_TILT = math.rad(-4) -- 말뚝을 살짝 기울여서 장난스럽게
local FENCE_HEIGHT = 2.2
local RAIL = Vector3.new(0.35, 0.35, 0.35) -- 울타리 가로대 단면

local LABEL_WIDTH = 10 -- 전시 이름표 크기(스터드)
local LABEL_HEIGHT = 2.6

local BASE_COLOR = Color3.fromRGB(226, 220, 204)
local PATH_COLOR = Color3.fromRGB(215, 198, 165)
local PEDESTAL_COLOR = Color3.fromRGB(236, 234, 228)
local LOCKED_COLOR = Color3.fromRGB(120, 124, 138)

-- UI 스타일 가이드 v2 팔레트
local INK = Color3.fromRGB(30, 27, 46)
local CREAM = Color3.fromRGB(255, 244, 220)
local WHITE = Color3.new(1, 1, 1)
local SUN = Color3.fromRGB(255, 197, 61)
local GRASS = Color3.fromRGB(76, 217, 100)
local GRASS_SHADOW = Color3.fromRGB(46, 158, 69)
local STAR_EMPTY = Color3.fromRGB(150, 146, 170) -- 아직 못 딴 별

-- 월드 소품 색
local WOOD = Color3.fromRGB(181, 120, 66) -- 간판 판자(따뜻한 갈색)
local WOOD_DARK = Color3.fromRGB(122, 78, 45) -- 기둥, 말뚝
local FENCE_COLOR = Color3.fromRGB(255, 250, 240)
local BUSH_COLOR = Color3.fromRGB(72, 184, 84)
local BUSH_LIGHT = Color3.fromRGB(122, 214, 104)

local FONT = Enum.Font.FredokaOne
local EMPTY_STAR_HEX = Format.hex(STAR_EMPTY)

local EMPTY_TITLE = "빈 부지"
local COIN_DEEP = Color3.fromRGB(217, 144, 15)
local SLICE_CENTER = Rect.new(64, 64, 192, 192) -- 스킨 그림(256x256) 9-slice
local SKIN_RADIUS = 50 -- 스킨 그림 속 모서리 반지름(px)

-- 칸 상태 키: 명소 Id 이거나 아래 둘 중 하나(명소 Id 는 '#' 으로 시작하지 않음)
local KEY_LOCKED = "#locked"
local KEY_EMPTY = "#empty"

type Slot = {
	Key: string,
	Container: Model,
	StarLabel: TextLabel?,
	Stars: number,
}

type Plot = {
	Index: number,
	CFrame: CFrame,
	Model: Model,
	SlotFolder: Folder,
	OwnerSign: Model, -- 주인이 있을 때만 부지 모델 아래에 둠
	EmptySign: Model, -- 빈 부지일 때만 부지 모델 아래에 둠
	TitleLabels: { TextLabel },
	IncomeLabels: { TextLabel },
	Owner: Player?,
	Slots: { Slot },
}

type Layout = { Angle: number, Radius: number, Path: boolean }

-- 부지 순서 = 배정 순서(가장 작은 빈 번호부터). 첫 부지는 스폰 정면(-Z = 270도) 근처.
local LAYOUT: { Layout } = {}
for i = 0, 7 do
	table.insert(LAYOUT, { Angle = math.rad(247.5 + 45 * i), Radius = INNER_RADIUS, Path = true })
end
-- 바깥 고리: 안쪽 부지 사이 틈으로 광장에서 바로 보이는 8칸 먼저, 안쪽 부지 뒤에 있는 8칸은 나중에
for i = 0, 7 do
	table.insert(LAYOUT, { Angle = math.rad(270 + 45 * i), Radius = OUTER_RADIUS, Path = true })
end
for i = 0, 7 do
	table.insert(LAYOUT, { Angle = math.rad(247.5 + 45 * i), Radius = OUTER_RADIUS, Path = false })
end

-- 전시 칸 위치(부지 좌표, Y = 부지 윗면). 입구 쪽 줄부터, 줄 안에서는 가운데부터.
local SLOT_OFFSETS: { Vector3 } = {}
do
	local columns = {}
	for c = 1, GRID do
		table.insert(columns, (c - (GRID + 1) / 2) * SPACING)
	end
	table.sort(columns, function(a, b)
		if math.abs(a) ~= math.abs(b) then
			return math.abs(a) < math.abs(b)
		end
		return a < b
	end)
	local firstRow = -PLOT_DEPTH / 2 + FRONT_MARGIN + SPACING / 2
	for row = 0, GRID - 1 do
		for _, x in columns do
			table.insert(SLOT_OFFSETS, Vector3.new(x, BASE_TOP, firstRow + row * SPACING))
		end
	end
end

local ParkService = {}

local folder: Folder? = nil
local plots: { Plot } = {}
local plotByPlayer: { [Player]: Plot } = {}

local function newPart(
	parent: Instance,
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material
): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

-- 장식용 공(덤불, 꼭지). 걸리적거리지 않게 충돌 없음
local function ball(parent: Instance, name: string, diameter: number, cframe: CFrame, color: Color3): Part
	local part =
		newPart(parent, name, Vector3.new(diameter, diameter, diameter), cframe, color, Enum.Material.SmoothPlastic)
	part.Shape = Enum.PartType.Ball
	part.CanCollide = false
	return part
end

-- GUI 헬퍼 ---------------------------------------------------------------

local function textLabel(parent: Instance, size: UDim2, position: UDim2, color: Color3): TextLabel
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = size
	label.Position = position
	label.Font = FONT
	label.TextScaled = true
	label.TextColor3 = color
	label.Text = ""
	label.Parent = parent
	return label
end

local function frame(parent: Instance, size: UDim2, position: UDim2, color: Color3): Frame
	local box = Instance.new("Frame")
	box.Size = size
	box.Position = position
	box.BackgroundColor3 = color
	box.BorderSizePixel = 0
	box.Parent = parent
	return box
end

local function corner(gui: GuiObject, radius: UDim)
	local round = Instance.new("UICorner")
	round.CornerRadius = radius
	round.Parent = gui
end

-- Ink 테두리: 글자에 붙이면 글자 테두리, 상자에 붙이면 상자 테두리
local function stroke(gui: GuiObject, thickness: number)
	local line = Instance.new("UIStroke")
	line.Thickness = thickness
	line.Color = INK
	line.Parent = gui
end

local function padding(gui: GuiObject, x: UDim, y: UDim)
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = x
	pad.PaddingRight = x
	pad.PaddingTop = y
	pad.PaddingBottom = y
	pad.Parent = gui
end

-- 그림 Id ("rbxassetid://...") 또는 nil
local function imageId(name: string): string?
	local value = ImageIds[name]
	if type(value) == "number" then
		return "rbxassetid://" .. tostring(value)
	elseif type(value) == "string" and value ~= "" then
		return if value:match("^%d+$") then "rbxassetid://" .. value else value
	end
	return nil
end

-- 스킨 그림(9-slice)을 깔고 상자의 바탕·테두리·그라데이션은 끔. 그림이 없으면 아무것도 안 함.
-- radius: 화면에서 보일 모서리 반지름(px, 간판은 PixelsPerStud 기준)
local function skin(gui: GuiObject, name: string, color: Color3, radius: number, height: number?)
	local id = imageId(name)
	if not id then
		return
	end
	gui.BackgroundTransparency = 1
	for _, child in gui:GetChildren() do
		if child:IsA("UIStroke") or child:IsA("UIGradient") then
			child.Enabled = false
		end
	end
	local scale = radius / SKIN_RADIUS
	if height then
		scale = math.min(scale, height / 2 / 64)
	end
	local image = Instance.new("ImageLabel")
	image.Name = "Skin"
	image.BackgroundTransparency = 1
	image.Size = UDim2.fromScale(1, 1)
	image.Image = id
	image.ImageColor3 = color
	image.ScaleType = Enum.ScaleType.Slice
	image.SliceCenter = SLICE_CENTER
	image.SliceScale = scale
	image.ZIndex = 0
	image.Parent = gui
end

-- 그림이 없을 때 쓰는 동전: 해 색 동그라미 + Ink 테두리 + 안쪽 진한 고리
local function drawCoin(box: Frame)
	local coin = frame(box, UDim2.fromScale(1, 1), UDim2.new(), SUN)
	coin.ZIndex = 3
	corner(coin, UDim.new(0.5, 0))
	stroke(coin, 4)
	local ring = frame(coin, UDim2.fromScale(0.58, 0.58), UDim2.fromScale(0.5, 0.5), SUN)
	ring.AnchorPoint = Vector2.new(0.5, 0.5)
	ring.BackgroundTransparency = 1
	ring.ZIndex = 4
	corner(ring, UDim.new(0.5, 0))
	local line = Instance.new("UIStroke")
	line.Thickness = 5
	line.Color = COIN_DEEP
	line.Parent = ring
end

-- 그림이 없을 때 쓰는 공원 아이콘: 동그란 나무(초록 잎 + 갈색 줄기)
local function drawTree(box: Frame)
	local trunk = frame(box, UDim2.fromScale(0.22, 0.42), UDim2.fromScale(0.5, 1), WOOD_DARK)
	trunk.AnchorPoint = Vector2.new(0.5, 1)
	trunk.ZIndex = 3
	stroke(trunk, 4)
	local leaves = frame(box, UDim2.fromScale(0.86, 0.72), UDim2.fromScale(0.5, 0), BUSH_COLOR)
	leaves.AnchorPoint = Vector2.new(0.5, 0)
	leaves.ZIndex = 4
	corner(leaves, UDim.new(0.5, 0))
	stroke(leaves, 4)
end

-- 정사각 아이콘 자리(부모 높이 기준 크기). 그림 Id 가 있으면 ImageLabel, 없으면 fallback 으로 그림
local function icon(
	parent: GuiObject,
	name: string,
	size: number,
	position: UDim2,
	anchor: Vector2,
	fallback: (Frame) -> ()
): Frame
	local box = Instance.new("Frame")
	box.Name = "Icon"
	box.BackgroundTransparency = 1
	box.SizeConstraint = Enum.SizeConstraint.RelativeYY
	box.Size = UDim2.fromScale(size, size)
	box.Position = position
	box.AnchorPoint = anchor
	box.ZIndex = 3
	local id = imageId(name)
	if id then
		local image = Instance.new("ImageLabel")
		image.Name = "Image"
		image.BackgroundTransparency = 1
		image.Size = UDim2.fromScale(1, 1)
		image.Image = id
		image.ScaleType = Enum.ScaleType.Fit
		image.ZIndex = 3
		image.Parent = box
	else
		fallback(box)
	end
	box.Parent = parent
	return box
end

-- 통통한 딱지: 어두운 그림자 판(drop 만큼 아래) 위에 색 앞면(위쪽이 살짝 밝음).
-- position 은 딱지 윗변 가운데. skinName/pixelHeight 를 주면 그 스킨 그림을 씀(간판처럼 픽셀 크기가 고정된 곳만).
-- 반환: 앞면(글자를 넣을 곳)
local function chunky(
	parent: Instance,
	size: UDim2,
	position: UDim2,
	drop: UDim,
	color: Color3,
	shadowColor: Color3,
	thickness: number,
	skinName: string?,
	pixelHeight: number?
): Frame
	local shadow = frame(parent, size, position + UDim2.new(UDim.new(), drop), shadowColor)
	shadow.Name = "Shadow"
	shadow.AnchorPoint = Vector2.new(0.5, 0)
	shadow.ZIndex = 1
	corner(shadow, UDim.new(0.5, 0))
	stroke(shadow, thickness)

	local face = frame(parent, size, position, color)
	face.Name = "Face"
	face.AnchorPoint = Vector2.new(0.5, 0)
	face.ZIndex = 2
	corner(face, UDim.new(0.5, 0))
	stroke(face, thickness)
	local shine = Instance.new("UIGradient")
	shine.Color = ColorSequence.new(WHITE, Color3.fromRGB(214, 214, 214))
	shine.Rotation = 90 -- 위 → 아래
	shine.Parent = face

	if skinName and pixelHeight then
		skin(shadow, skinName, shadowColor, pixelHeight / 2, pixelHeight)
		skin(face, skinName, color, pixelHeight / 2, pixelHeight)
	end
	return face
end

-- 채운 별은 해 색, 못 딴 별은 흐린 색(RichText)
local function starText(stars: number): string
	local text = string.rep("★", stars)
	if stars < MAX_STARS then
		text ..= `<font color="{EMPTY_STAR_HEX}">{string.rep("★", MAX_STARS - stars)}</font>`
	end
	return text
end

-- 초당 수입 짧게: "+13.5/s", "+12.5K/s"
local function incomeText(income: number): string
	if income < 100 then
		local text = string.format("%.1f", math.floor(income * 10) / 10):gsub("%.0$", "")
		return "+" .. text .. "/s"
	end
	return "+" .. Format.short(income) .. "/s"
end

-- 간판 ---------------------------------------------------------------------

local function surfaceGui(board: BasePart, face: Enum.NormalId): SurfaceGui
	local gui = Instance.new("SurfaceGui")
	gui.Name = "SignGui"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = board
	return gui
end

-- 주인 간판 한 면: 가장자리에 나무가 보이는 크림 글자판 + [공원 아이콘] 이름(Ink) + 초록 알약 [동전] "+X/s".
-- 반환: 제목, 수입 라벨
local PANEL_HEIGHT = BOARD_SIZE.Y * 40 - 36 -- 글자판 높이(px, PixelsPerStud 40)
local TITLE_SIDE = 130 -- 제목 양옆 여백(px): 왼쪽엔 공원 아이콘, 오른쪽은 가운데 정렬용

local function signFace(board: BasePart, face: Enum.NormalId): (TextLabel, TextLabel)
	local gui = surfaceGui(board, face)
	local panel = frame(gui, UDim2.new(1, -40, 1, -36), UDim2.fromScale(0.5, 0.5), CREAM)
	panel.Name = "Panel"
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	corner(panel, UDim.new(0, 24))
	stroke(panel, 6)
	skin(panel, "panel_paper", WHITE, 24)

	icon(panel, "park", 0.42, UDim2.new(0, 34, 0.06, 0), Vector2.new(0, 0), drawTree)
	local title = textLabel(panel, UDim2.new(1, -TITLE_SIDE * 2, 0.46, 0), UDim2.new(0, TITLE_SIDE, 0.06, 0), INK)
	title.Name = "Title"

	local pill = chunky(
		panel,
		UDim2.fromScale(0.62, 0.34),
		UDim2.fromScale(0.5, 0.56),
		UDim.new(0, 6),
		GRASS,
		GRASS_SHADOW,
		4,
		"pill",
		math.floor(PANEL_HEIGHT * 0.34)
	)
	icon(pill, "coin", 0.82, UDim2.new(0, 10, 0.5, 0), Vector2.new(0, 0.5), drawCoin)
	local income = textLabel(pill, UDim2.fromScale(1, 1), UDim2.new(), WHITE)
	income.Name = "Income"
	padding(income, UDim.new(0.14, 0), UDim.new(0.14, 0))
	stroke(income, 3)
	return title, income
end

-- 주인 간판(입구 아치): 나무 판자 + Ink 테두리 + 양옆 기둥(부지 색 모자, 금색 꼭지).
-- 반환: 간판 모델, 제목 라벨들, 수입 라벨들(앞뒤 두 면)
local function buildOwnerSign(cf: CFrame, color: Color3): (Model, { TextLabel }, { TextLabel })
	local sign = Instance.new("Model")
	sign.Name = "Sign"
	local base = cf * CFrame.new(0, 0, SIGN_Z) -- 간판 바닥 가운데(땅 높이)
	local width, height = BOARD_SIZE.X, BOARD_SIZE.Y

	local board = newPart(sign, "Board", BOARD_SIZE, base * CFrame.new(0, BOARD_Y, 0), WOOD, Enum.Material.Wood)

	-- Ink 테두리: 판자보다 두꺼워서 앞뒤로 살짝 튀어나온 액자. 위아래 막대가 모서리까지 덮음
	local depth = BOARD_SIZE.Z + 0.4
	for _, side in { -1, 1 } do
		newPart(
			sign,
			"BoardFrame",
			Vector3.new(width + FRAME * 2, FRAME, depth),
			base * CFrame.new(0, BOARD_Y + side * (height + FRAME) / 2, 0),
			INK,
			Enum.Material.SmoothPlastic
		)
		newPart(
			sign,
			"BoardFrame",
			Vector3.new(FRAME, height, depth),
			base * CFrame.new(side * (width + FRAME) / 2, BOARD_Y, 0),
			INK,
			Enum.Material.SmoothPlastic
		)
	end

	-- 판자 양옆 기둥 + 부지 색 모자 + 금색 꼭지
	local postX = width / 2 + FRAME + POST / 2
	local postTop = BOARD_Y + height / 2 + FRAME + 0.6
	for _, side in { -1, 1 } do
		newPart(
			sign,
			"Post",
			Vector3.new(POST, postTop, POST),
			base * CFrame.new(side * postX, postTop / 2, 0),
			WOOD_DARK,
			Enum.Material.Wood
		)
		newPart(
			sign,
			"PostCap",
			Vector3.new(POST + 0.8, 0.7, POST + 0.8),
			base * CFrame.new(side * postX, postTop + 0.35, 0),
			color,
			Enum.Material.SmoothPlastic
		)
		ball(sign, "PostKnob", 1.3, base * CFrame.new(side * postX, postTop + 1.2, 0), SUN)
	end

	local frontTitle, frontIncome = signFace(board, Enum.NormalId.Front)
	local backTitle, backIncome = signFace(board, Enum.NormalId.Back)
	return sign, { frontTitle, backTitle }, { frontIncome, backIncome }
end

-- 빈 부지 말뚝 간판: 길 옆에 낮게, 살짝 기울여서. 광장 쪽 면에만 글자
local function buildEmptySign(cf: CFrame): Model
	local sign = Instance.new("Model")
	sign.Name = "EmptySign"
	local base = cf * CFrame.new(STAKE_X, 0, SIGN_Z) * CFrame.Angles(0, 0, STAKE_TILT)
	local boardY = 2 + STAKE_BOARD.Y / 2

	-- 말뚝은 판자 뒤(부지 쪽)에 붙임
	newPart(
		sign,
		"Stake",
		Vector3.new(0.5, boardY, 0.5),
		base * CFrame.new(0, boardY / 2, STAKE_BOARD.Z / 2 + 0.25),
		WOOD_DARK,
		Enum.Material.Wood
	)
	local board = newPart(sign, "Board", STAKE_BOARD, base * CFrame.new(0, boardY, 0), WOOD, Enum.Material.Wood)

	local gui = surfaceGui(board, Enum.NormalId.Front)
	local panel = frame(gui, UDim2.new(1, -16, 1, -16), UDim2.fromScale(0.5, 0.5), CREAM)
	panel.Name = "Panel"
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	corner(panel, UDim.new(0, 14))
	stroke(panel, 4)
	skin(panel, "panel_paper", WHITE, 14)

	local title = textLabel(panel, UDim2.new(1, -24, 0.7, 0), UDim2.new(0, 12, 0.15, 0), INK)
	title.Text = EMPTY_TITLE
	title.TextTransparency = 0.15
	return sign
end

local function setSign(plot: Plot, title: string, subtitle: string)
	for _, label in plot.TitleLabels do
		label.Text = title
	end
	for _, label in plot.IncomeLabels do
		label.Text = subtitle
	end
end

-- 주인이 있으면 입구 아치 간판, 없으면 말뚝 간판만 보이게
local function showSign(plot: Plot, owned: boolean)
	plot.OwnerSign.Parent = if owned then plot.Model else nil
	plot.EmptySign.Parent = if owned then nil else plot.Model
end

-- 부지 장식 ---------------------------------------------------------------

type FenceSide = { Center: Vector3, Axis: Vector3, Length: number }

-- 위에서 봐도 부지가 보이게: 둘레 띠 위에 옆·뒤 낮은 울타리 + 네 귀퉁이 덤불. 입구(앞) 쪽은 비워 둠.
-- 부지 하나에 파트 20개(가로대 6, 기둥 6, 덤불 8)
local function decorate(model: Model, cf: CFrame)
	local edgeX = PLOT_WIDTH / 2 + BORDER / 2 -- 둘레 띠 가운데
	local edgeZ = PLOT_DEPTH / 2 + BORDER / 2
	local ground = BASE_TOP - 0.2 -- 둘레 띠 윗면

	local sides: { FenceSide } = {
		{ Center = Vector3.new(-edgeX, ground, 0), Axis = Vector3.new(0, 0, 1), Length = edgeZ * 2 },
		{ Center = Vector3.new(edgeX, ground, 0), Axis = Vector3.new(0, 0, 1), Length = edgeZ * 2 },
		{ Center = Vector3.new(0, ground, edgeZ), Axis = Vector3.new(1, 0, 0), Length = edgeX * 2 },
	}
	for _, side in sides do
		-- 가로대 두 줄(양 끝은 귀퉁이 덤불에 묻힘)
		for _, y in { 0.9, 1.8 } do
			newPart(
				model,
				"FenceRail",
				RAIL + side.Axis * (side.Length - RAIL.X),
				cf * CFrame.new(side.Center + Vector3.new(0, y, 0)),
				FENCE_COLOR,
				Enum.Material.SmoothPlastic
			)
		end
		-- 기둥은 3등분 지점에 두 개
		for _, t in { -1, 1 } do
			newPart(
				model,
				"FencePost",
				Vector3.new(0.6, FENCE_HEIGHT, 0.6),
				cf * CFrame.new(side.Center + side.Axis * (t * side.Length / 6) + Vector3.new(0, FENCE_HEIGHT / 2, 0)),
				FENCE_COLOR,
				Enum.Material.SmoothPlastic
			)
		end
	end

	-- 귀퉁이 덤불: 큰 공 + 위에 작은 밝은 공
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			local spot = Vector3.new(sx * edgeX, ground, sz * edgeZ)
			ball(model, "Bush", 3.4, cf * CFrame.new(spot + Vector3.new(0, 1.2, 0)), BUSH_COLOR)
			ball(model, "Bush", 2.2, cf * CFrame.new(spot + Vector3.new(-sx * 0.7, 2.5, -sz * 0.5)), BUSH_LIGHT)
		end
	end
end

-- 부지 바닥, 둘레 색 띠, 장식, 간판(주인용/빈 부지용), 광장까지 길
local function buildPlot(parent: Instance, index: number, layout: Layout): Plot
	local direction = Vector3.new(math.cos(layout.Angle), 0, math.sin(layout.Angle))
	local center = direction * (layout.Radius + PLOT_DEPTH / 2)
	local cf = CFrame.lookAt(center, Vector3.zero) -- -Z(LookVector)가 광장 쪽
	-- 이웃 부지와 색이 겹치지 않게 황금비 간격으로 색상환을 돔
	local color = Color3.fromHSV(((index - 1) * 0.618034) % 1, 0.6, 0.95)

	local model = Instance.new("Model")
	model.Name = "Plot" .. index

	-- 둘레 띠(윗면 0.4) 위에 부지 바닥(윗면 0.6): 계단처럼 걸어서 오를 수 있음
	newPart(
		model,
		"Border",
		Vector3.new(PLOT_WIDTH + BORDER * 2, BASE_TOP - 0.2, PLOT_DEPTH + BORDER * 2),
		cf * CFrame.new(0, (BASE_TOP - 0.2) / 2, 0),
		color,
		Enum.Material.SmoothPlastic
	)
	newPart(
		model,
		"Base",
		Vector3.new(PLOT_WIDTH, BASE_TOP, PLOT_DEPTH),
		cf * CFrame.new(0, BASE_TOP / 2, 0),
		BASE_COLOR,
		Enum.Material.Concrete
	)
	decorate(model, cf)

	-- 간판 두 종류를 미리 만들어 두고 주인 유무에 따라 하나만 부지 아래에 둠
	local ownerSign, titleLabels, incomeLabels = buildOwnerSign(cf, color)
	local emptySign = buildEmptySign(cf)

	-- 광장에서 입구까지 길(안쪽 고리와, 안쪽 부지 사이로 보이는 바깥 부지만). 부지/광장 아래로 살짝 들어감
	if layout.Path then
		local from, to = PLAZA_EDGE, layout.Radius + 1
		local length = to - from
		local mid = direction * ((from + to) / 2) + Vector3.new(0, 0.1, 0)
		local path = newPart(
			model,
			"Path",
			Vector3.new(PATH_WIDTH, 0.2, length),
			CFrame.lookAt(mid, Vector3.new(0, 0.1, 0)),
			PATH_COLOR,
			Enum.Material.Concrete
		)
		path.CastShadow = false
	end

	local slotFolder = Instance.new("Folder")
	slotFolder.Name = "Slots"
	slotFolder.Parent = model

	local plot: Plot = {
		Index = index,
		CFrame = cf,
		Model = model,
		SlotFolder = slotFolder,
		OwnerSign = ownerSign,
		EmptySign = emptySign,
		TitleLabels = titleLabels,
		IncomeLabels = incomeLabels,
		Owner = nil,
		Slots = {},
	}
	showSign(plot, false)
	model.Parent = parent
	return plot
end

-- 서버 시작 시 한 번: 모든 부지의 바닥/장식/간판/길을 만들어 둠(주인 없는 부지는 "빈 부지" 말뚝 간판)
function ParkService.init()
	if folder then
		return
	end
	local parks = Instance.new("Folder")
	parks.Name = "Parks"
	folder = parks
	for index, layout in LAYOUT do
		table.insert(plots, buildPlot(parks, index, layout))
	end
	parks.Parent = Workspace
end

-- 칸 위 작은 이름표: 등급 색 둥근 딱지(흰 이름 + Ink 테두리) + 그 아래 별(해 색 + Ink 테두리)
local function addLabel(pedestal: BasePart, landmark: Landmarks.Landmark, modelHeight: number): TextLabel
	local anchor = Instance.new("Attachment")
	anchor.Name = "LabelAnchor"
	anchor.Position = Vector3.new(0, PEDESTAL_HEIGHT / 2 + modelHeight + 1.4, 0)
	anchor.Parent = pedestal

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "Label"
	billboard.Adornee = anchor
	billboard.Size = UDim2.fromScale(LABEL_WIDTH, LABEL_HEIGHT)
	billboard.MaxDistance = LABEL_DISTANCE
	billboard.LightInfluence = 0
	billboard.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

	-- 딱지 너비는 이름 길이에 맞춤(한글 한 글자 폭 ≈ 글자 높이 ≈ 1 스터드)
	local chars = utf8.len(landmark.Name) or #landmark.Name
	local width = math.clamp((chars * 1.05 + 1.4) / LABEL_WIDTH, 0.3, 1)
	local tier = landmark.Tier.Color
	local tag = chunky(
		billboard,
		UDim2.fromScale(width, 0.52),
		UDim2.fromScale(0.5, 0),
		UDim.new(0.07, 0),
		tier,
		tier:Lerp(INK, 0.4),
		2
	)
	local name = textLabel(tag, UDim2.fromScale(1, 1), UDim2.new(), WHITE)
	name.Name = "Name"
	name.Text = landmark.Name
	padding(name, UDim.new(0.08, 0), UDim.new(0.14, 0))
	stroke(name, 2)

	local stars = textLabel(billboard, UDim2.fromScale(1, 0.34), UDim2.fromScale(0, 0.64), SUN)
	stars.Name = "Stars"
	stars.RichText = true
	stroke(stars, 2)

	billboard.Parent = anchor
	return stars
end

-- key: KEY_LOCKED(흐릿한 바닥) / KEY_EMPTY(빈 받침대) / 명소 Id(받침대 + 미니어처 + 이름표)
local function buildSlot(plot: Plot, index: number, key: string): Slot
	local floor = plot.CFrame * CFrame.new(SLOT_OFFSETS[index]) -- 칸 바닥 중앙(부지 윗면)
	local container = Instance.new("Model")
	container.Name = "Slot" .. index
	local slot: Slot = { Key = key, Container = container, StarLabel = nil, Stars = -1 }

	if key == KEY_LOCKED then
		local tile = newPart(
			container,
			"Locked",
			Vector3.new(PEDESTAL_SIZE, 0.1, PEDESTAL_SIZE),
			floor * CFrame.new(0, 0.08, 0),
			LOCKED_COLOR,
			Enum.Material.SmoothPlastic
		)
		tile.Transparency = 0.7
		tile.CanCollide = false
		tile.CastShadow = false
	else
		local pedestal = newPart(
			container,
			"Pedestal",
			Vector3.new(PEDESTAL_SIZE, PEDESTAL_HEIGHT, PEDESTAL_SIZE),
			floor * CFrame.new(0, PEDESTAL_HEIGHT / 2, 0),
			PEDESTAL_COLOR,
			Enum.Material.Marble
		)
		local landmark = if key ~= KEY_EMPTY then Landmarks.ById[key] else nil
		if landmark then
			pedestal.Color = landmark.Tier.Color:Lerp(PEDESTAL_COLOR, 0.6)
			-- 모형 하나가 잘못돼도 나머지 칸/이름표는 만들어지도록 pcall. 반환: 모형 높이
			local ok, result = pcall(function(): number
				local model = Models.create(landmark, MINIATURE_SIZE)
				model:PivotTo(floor * CFrame.new(0, PEDESTAL_HEIGHT, 0))
				model.Parent = container
				return model:GetExtentsSize().Y
			end)
			if not ok then
				warn("[ParkService] " .. landmark.Id .. " 모형을 만들지 못했습니다: " .. tostring(result))
			end
			slot.StarLabel = addLabel(pedestal, landmark, if ok then result else 0)
		end
	end

	container.Parent = plot.SlotFolder
	return slot
end

local function clearSlots(plot: Plot)
	for _, slot in plot.Slots do
		slot.Container:Destroy()
	end
	table.clear(plot.Slots)
end

-- 가장 작은 빈 부지 번호를 배정. 부지가 모자라면 nil(공원 없이 플레이).
function ParkService.assign(player: Player): number?
	ParkService.init()
	local existing = plotByPlayer[player]
	if existing then
		return existing.Index
	end
	for _, plot in plots do
		if not plot.Owner then
			plot.Owner = player
			plotByPlayer[player] = plot
			setSign(plot, player.DisplayName, incomeText(0))
			showSign(plot, true)
			return plot.Index
		end
	end
	warn("[ParkService] 빈 공원 부지가 없습니다: " .. player.Name)
	return nil
end

-- 퇴장: 전시물을 모두 치우고 부지를 비움
function ParkService.release(player: Player)
	local plot = plotByPlayer[player]
	if not plot then
		return
	end
	plotByPlayer[player] = nil
	plot.Owner = nil
	clearSlots(plot)
	showSign(plot, false)
	setSign(plot, "", "")
end

-- 전시 상태를 data 에 맞춤. data 는 Data 또는 같은 필드(Inventory, Upgrades)를 가진 표.
-- mods: 게임패스·서버 행운 등(없으면 기본). 간판의 수입 표시에 "수입 2배" 가 반영되도록
function ParkService.update(player: Player, data: PlayerState.Data, mods: PlayerState.Mods?)
	local plot = plotByPlayer[player]
	if not plot then
		return
	end
	local park = PlayerState.park(data)
	local unlocked = math.min(PlayerState.slots(data), #SLOT_OFFSETS)

	for index = 1, #SLOT_OFFSETS do
		local id = park[index]
		local key = if id then id elseif index <= unlocked then KEY_EMPTY else KEY_LOCKED
		local slot = plot.Slots[index]
		if not slot or slot.Key ~= key then
			if slot then
				slot.Container:Destroy()
			end
			slot = buildSlot(plot, index, key)
			plot.Slots[index] = slot
		end
		local starLabel = slot.StarLabel
		if id and starLabel then
			local stars = PlayerState.stars(data.Inventory[id] or 0)
			if stars ~= slot.Stars then
				slot.Stars = stars
				starLabel.Text = starText(stars)
			end
		end
	end

	setSign(plot, player.DisplayName, incomeText(PlayerState.incomePerSecond(data, mods)))
end

-- 공원 입구 안쪽 바닥(부지 윗면)에서 공원 안쪽을 바라보는 CFrame. 부지가 없으면 nil.
function ParkService.entranceCFrame(player: Player): CFrame?
	local plot = plotByPlayer[player]
	if not plot then
		return nil
	end
	local position = plot.CFrame:PointToWorldSpace(Vector3.new(0, BASE_TOP, -PLOT_DEPTH / 2 + 3))
	return CFrame.lookAt(position, position - plot.CFrame.LookVector)
end

return ParkService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">World</string>
          <string name="Source"><![CDATA[-- 광장(스폰) + 받침대 위의 거대 지구본 + 광장 둘레 나무 + 뉴스 속보 홀로그램
-- 회전은 클라이언트가 "LandmarkSpin" 태그가 붙은 Model 을 제자리에서 돌려서 보여 줍니다(서버 복제 부담 없음).
-- 홀로그램 제목은 글자 최소: "속보!" 딱지 + 명소 이름. Shared/ImageIds.news 그림이 있으면 딱지 옆에 신문 아이콘.

local CollectionService = game:GetService("CollectionService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Landmarks = require(Shared.Landmarks)
local Models = require(Shared.Models)

-- 그림 Id 표 (없거나 깨져도 코드로 그린 모양으로 동작)
local function loadImageIds(): { [string]: any }
	local module = Shared:FindFirstChild("ImageIds")
	if module and module:IsA("ModuleScript") then
		local ok, result = pcall(require, module)
		if ok and type(result) == "table" then
			return result
		end
	end
	return {}
end
local ImageIds = loadImageIds()

-- 그림 Id ("rbxassetid://...") 또는 nil
local function imageId(name: string): string?
	local value = ImageIds[name]
	if type(value) == "number" then
		return "rbxassetid://" .. tostring(value)
	elseif type(value) == "string" and value ~= "" then
		return if value:match("^%d+$") then "rbxassetid://" .. value else value
	end
	return nil
end

local SPIN_TAG = "LandmarkSpin"

local PLAZA_RADIUS = 45
local PLAZA_TOP = 1 -- 광장 윗면 높이. 스폰 지점(두께 1)이 이 위에 놓임
local RIM_WIDTH = 3 -- 광장 둘레의 낮은 계단(윗면 0.5)
local EARTH_SPOT = Vector3.new(0, PLAZA_TOP, -26) -- 지구본 받침대 바닥 중앙(스폰 정면 = -Z)
local EARTH_SIZE = 26
local LAMP_COUNT = 16
local LAMP_RADIUS = PLAZA_RADIUS - 3
local TREE_COUNT = 8
local TREE_RADIUS = PLAZA_RADIUS + RIM_WIDTH + 8 -- 광장 둘레 계단 바로 바깥 잔디

local HOLOGRAM_SIZE = 60
local HOLOGRAM_HEIGHT = 60 -- 홀로그램 바닥 높이(지구본과 겹치면 그 위로 올림)
local HOLOGRAM_LIFETIME = 12
local HOLOGRAM_TRANSPARENCY = 0.35
local TITLE_WIDTH = 80 -- 홀로그램 제목 크기(스터드)
local TITLE_HEIGHT = 20

local PLAZA_COLOR = Color3.fromRGB(214, 210, 200)
local RIM_COLOR = Color3.fromRGB(165, 160, 150)
local STONE_DARK = Color3.fromRGB(70, 74, 88)
local MARBLE = Color3.fromRGB(240, 238, 232)
local GOLD = Color3.fromRGB(235, 190, 80)
local LAMP_POLE = Color3.fromRGB(45, 48, 60)
local LAMP_LIGHT = Color3.fromRGB(255, 235, 190)
local TRUNK = Color3.fromRGB(122, 78, 45)
local LEAF = Color3.fromRGB(72, 184, 84)
local LEAF_LIGHT = Color3.fromRGB(122, 214, 104)

-- UI 스타일 가이드 v2 팔레트(홀로그램 제목)
local INK = Color3.fromRGB(30, 27, 46)
local WHITE = Color3.new(1, 1, 1)
local CORAL = Color3.fromRGB(255, 94, 91)
local CORAL_SHADOW = Color3.fromRGB(201, 58, 56)

-- 원기둥 파트는 X 축이 기둥 방향이므로 세우려면 Z 축으로 90도 돌림
local UPRIGHT = CFrame.Angles(0, 0, math.rad(90))

local World = {}

local folder: Folder? = nil
local earthTop = PLAZA_TOP + EARTH_SIZE -- 지구본 꼭대기 높이(모형을 만든 뒤 실제 값으로 바뀜)
local hologram: Model? = nil

local function newPart(
	parent: Instance,
	name: string,
	shape: Enum.PartType,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material
): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Shape = shape
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

-- bottom(바닥 중앙)에서 위로 height 만큼 세운 원기둥
local function disc(
	parent: Instance,
	name: string,
	bottom: Vector3,
	height: number,
	diameter: number,
	color: Color3,
	material: Enum.Material
): Part
	return newPart(
		parent,
		name,
		Enum.PartType.Cylinder,
		Vector3.new(height, diameter, diameter),
		CFrame.new(bottom + Vector3.new(0, height / 2, 0)) * UPRIGHT,
		color,
		material
	)
end

local function lamp(parent: Instance, base: Vector3)
	local pole = newPart(
		parent,
		"LampPost",
		Enum.PartType.Block,
		Vector3.new(0.6, 9, 0.6),
		CFrame.new(base + Vector3.new(0, 4.5, 0)),
		LAMP_POLE,
		Enum.Material.Metal
	)
	pole.CastShadow = false
	local bulb = newPart(
		parent,
		"LampBulb",
		Enum.PartType.Ball,
		Vector3.new(1.8, 1.8, 1.8),
		CFrame.new(base + Vector3.new(0, 9.6, 0)),
		LAMP_LIGHT,
		Enum.Material.Neon
	)
	bulb.CanCollide = false
	bulb.CastShadow = false
	local light = Instance.new("PointLight")
	light.Color = LAMP_LIGHT
	light.Range = 18
	light.Brightness = 1.2
	light.Parent = bulb
end

-- 동글동글한 나무: 줄기(원기둥) + 잎(큰 공 + 위에 작은 밝은 공). 잎은 머리에 걸리지 않게 충돌 없음.
-- scale 로 크기를, turn(라디안)으로 작은 공 방향을 바꿔서 나무마다 조금씩 다르게 보이게 함
local function tree(parent: Instance, base: Vector3, scale: number, turn: number)
	disc(parent, "TreeTrunk", base, 6 * scale, 1.6 * scale, TRUNK, Enum.Material.Wood)
	local leaves = {
		{ Offset = Vector3.new(0, 8, 0), Diameter = 7.5, Color = LEAF },
		{ Offset = Vector3.new(1.2, 11, -0.6), Diameter = 4.6, Color = LEAF_LIGHT },
	}
	for _, leaf in leaves do
		local offset = CFrame.Angles(0, turn, 0):VectorToWorldSpace(leaf.Offset) * scale
		local diameter = leaf.Diameter * scale
		local part = newPart(
			parent,
			"TreeLeaves",
			Enum.PartType.Ball,
			Vector3.new(diameter, diameter, diameter),
			CFrame.new(base + offset),
			leaf.Color,
			Enum.Material.SmoothPlastic
		)
		part.CanCollide = false
	end
end

-- 서버 시작 시 한 번: 광장, 가로등, 둘레 나무, 받침대 + 거대 지구본
function World.build()
	if folder then
		return
	end
	local world = Instance.new("Folder")
	world.Name = "World"
	folder = world

	-- 광장: 둘레 계단(윗면 0.5) 위에 광장(윗면 1). 한 번에 0.5 씩이라 걸어서 오를 수 있음
	disc(
		world,
		"PlazaRim",
		Vector3.zero,
		PLAZA_TOP / 2,
		(PLAZA_RADIUS + RIM_WIDTH) * 2,
		RIM_COLOR,
		Enum.Material.Concrete
	)
	disc(world, "Plaza", Vector3.zero, PLAZA_TOP, PLAZA_RADIUS * 2, PLAZA_COLOR, Enum.Material.Concrete)

	-- 가로등: 공원으로 가는 길(22.5도 간격) 사이사이에
	for i = 1, LAMP_COUNT do
		local angle = (i - 0.5) / LAMP_COUNT * math.pi * 2
		lamp(world, Vector3.new(math.cos(angle) * LAMP_RADIUS, PLAZA_TOP, math.sin(angle) * LAMP_RADIUS))
	end

	-- 나무: 광장 바로 바깥 잔디, 길(22.5도마다) 사이 틈 하나 건너 하나에(가로등 바로 뒤)
	for i = 1, TREE_COUNT do
		local angle = (i - 0.75) / TREE_COUNT * math.pi * 2 -- 11.25도 + 45도 간격
		local base = Vector3.new(math.cos(angle) * TREE_RADIUS, 0, math.sin(angle) * TREE_RADIUS)
		tree(world, base, if i % 2 == 0 then 1 else 0.85, angle)
	end

	-- 지구본 받침대
	disc(world, "PedestalBase", EARTH_SPOT, 1.5, 18, STONE_DARK, Enum.Material.Slate)
	disc(world, "PedestalColumn", EARTH_SPOT + Vector3.new(0, 1.5, 0), 5, 10, MARBLE, Enum.Material.Marble)
	disc(world, "PedestalTop", EARTH_SPOT + Vector3.new(0, 6.5, 0), 1, 15, GOLD, Enum.Material.Metal)
	local pedestalTop = EARTH_SPOT.Y + 7.5

	-- 거대 지구본 (모형 코드에 문제가 있어도 광장은 만들어지도록 pcall)
	local ok, err = pcall(function()
		local earth = Models.create(Landmarks.Globe, EARTH_SIZE)
		earth.Name = "Earth"
		earth:PivotTo(CFrame.new(EARTH_SPOT.X, pedestalTop, EARTH_SPOT.Z))
		earthTop = pedestalTop + earth:GetExtentsSize().Y
		CollectionService:AddTag(earth, SPIN_TAG)
		-- 스트리밍이 켜져 있어도 통째로 내려받게 해야 클라이언트 회전 때 일부 파트만 어긋나지 않음
		earth.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
		earth.Parent = world
	end)
	if not ok then
		warn("[World] 지구본 모형을 만들지 못했습니다: " .. tostring(err))
	end

	world.Parent = Workspace
end

-- 광장으로 순간이동할 때 캐릭터 피벗(HumanoidRootPart) 위치: 스폰 바로 앞에서 지구본을 바라봄
function World.plazaCFrame(): CFrame
	local position = Vector3.new(0, PLAZA_TOP + 3.5, 10)
	return CFrame.lookAt(position, Vector3.new(EARTH_SPOT.X, position.Y, EARTH_SPOT.Z))
end

-- 통통한 상자: 둥근 모서리 + Ink 테두리. position 은 윗변 가운데
local function chunkyBox(
	parent: Instance,
	name: string,
	size: UDim2,
	position: UDim2,
	color: Color3,
	zIndex: number
): Frame
	local box = Instance.new("Frame")
	box.Name = name
	box.AnchorPoint = Vector2.new(0.5, 0)
	box.Size = size
	box.Position = position
	box.BackgroundColor3 = color
	box.BorderSizePixel = 0
	box.ZIndex = zIndex
	local round = Instance.new("UICorner")
	round.CornerRadius = UDim.new(0.3, 0)
	round.Parent = box
	local line = Instance.new("UIStroke")
	line.Thickness = 5
	line.Color = INK
	line.Parent = box
	box.Parent = parent
	return box
end

-- 위쪽이 살짝 밝은 그라데이션
local function shine(box: Frame)
	local gradient = Instance.new("UIGradient")
	gradient.Color = ColorSequence.new(WHITE, Color3.fromRGB(214, 214, 214))
	gradient.Rotation = 90 -- 위 → 아래
	gradient.Parent = box
end

-- 흰 LuckiestGuy 글자 + 굵은 Ink 글자 테두리
local function bigText(parent: Frame, text: string, thickness: number)
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.LuckiestGuy
	label.TextScaled = true
	label.Text = text
	label.TextColor3 = WHITE
	local line = Instance.new("UIStroke")
	line.Thickness = thickness
	line.Color = INK
	line.Parent = label
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0.05, 0)
	pad.PaddingRight = UDim.new(0.05, 0)
	pad.PaddingTop = UDim.new(0.16, 0)
	pad.PaddingBottom = UDim.new(0.16, 0)
	pad.Parent = label
	label.Parent = parent
end

-- 홀로그램 제목: 빨간 "속보!" 딱지(살짝 기울임) + 등급 색 리본 위에 명소 이름
local function titleBillboard(parent: BasePart, landmark: Landmarks.Landmark)
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "Title"
	billboard.Adornee = parent
	billboard.Size = UDim2.fromScale(TITLE_WIDTH, TITLE_HEIGHT)
	billboard.StudsOffset = Vector3.new(0, 2 - TITLE_HEIGHT / 2, 0) -- 윗변이 기준점 조금 위, 나머지는 아래로
	billboard.LightInfluence = 0
	billboard.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

	local text = landmark.Name
	-- 리본 너비: 글자 수 × 글자 높이(약 8.6 스터드) + 여백
	local chars = utf8.len(text) or #text
	local ribbonWidth = math.clamp((chars * 8.6 + 12) / TITLE_WIDTH, 0.4, 1)
	local ribbonSize = UDim2.fromScale(ribbonWidth, 0.6)
	local tier = landmark.Tier.Color
	chunkyBox(billboard, "RibbonShadow", ribbonSize, UDim2.fromScale(0.5, 0.36), tier:Lerp(INK, 0.4), 1)
	local ribbon = chunkyBox(billboard, "Ribbon", ribbonSize, UDim2.fromScale(0.5, 0.3), tier, 2)
	shine(ribbon)
	bigText(ribbon, text, 6)

	local tagSize = UDim2.fromScale(0.24, 0.3)
	local tagShadow = chunkyBox(billboard, "TagShadow", tagSize, UDim2.fromScale(0.5, 0.05), CORAL_SHADOW, 3)
	local tag = chunkyBox(billboard, "Tag", tagSize, UDim2.fromScale(0.5, 0.02), CORAL, 4)
	tagShadow.Rotation = -4
	tag.Rotation = -4
	shine(tag)
	bigText(tag, "속보!", 4)

	local newsId = imageId("news")
	if newsId then
		-- 딱지 왼쪽에 신문 아이콘(딱지보다 조금 크게)
		local news = Instance.new("ImageLabel")
		news.Name = "NewsIcon"
		news.BackgroundTransparency = 1
		news.Image = newsId
		news.ScaleType = Enum.ScaleType.Fit
		news.SizeConstraint = Enum.SizeConstraint.RelativeYY
		news.Size = UDim2.fromScale(1.4, 1.4)
		news.AnchorPoint = Vector2.new(0.75, 0.5)
		news.Position = UDim2.fromScale(0, 0.5)
		news.Rotation = -10
		news.ZIndex = 5
		news.Parent = tag
	end

	billboard.Parent = parent
end

-- 광장 하늘에 거대한 반투명 홀로그램(한 번에 하나, 12초 뒤 사라짐)
function World.hologram(landmark: Landmarks.Landmark)
	if hologram then
		hologram:Destroy()
		hologram = nil
	end

	local ok, result = pcall(Models.create, landmark, HOLOGRAM_SIZE)
	if not ok then
		warn("[World] 홀로그램 모형을 만들지 못했습니다: " .. tostring(result))
		return
	end
	local model = result :: Model
	model.Name = "Hologram"
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			-- 원래 투명한 파트(Root 등)는 그대로 두고, 보이는 파트만 색은 유지한 채 홀로그램 재질로
			if descendant.Transparency < 1 then
				descendant.Transparency = math.max(descendant.Transparency, HOLOGRAM_TRANSPARENCY)
				descendant.Material = Enum.Material.ForceField
			end
			descendant.Anchored = true
			descendant.CanCollide = false
			descendant.CanQuery = false
			descendant.CanTouch = false
			descendant.CastShadow = false
		end
	end

	local bottom = math.max(HOLOGRAM_HEIGHT, earthTop + 10)
	model:PivotTo(CFrame.new(0, bottom, 0))

	-- 제목은 홀로그램 바로 아래(땅에서 올려다볼 때 잘 보이게). 회전축 위에 있어서 돌려도 제자리
	local anchor = Instance.new("Part")
	anchor.Name = "TitleAnchor"
	anchor.Size = Vector3.new(1, 1, 1)
	anchor.CFrame = CFrame.new(0, bottom - 5, 0)
	anchor.Transparency = 1
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Parent = model
	titleBillboard(anchor, landmark)

	CollectionService:AddTag(model, SPIN_TAG)
	model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	model.Parent = folder or Workspace
	hologram = model

	task.delay(HOLOGRAM_LIFETIME, function()
		if hologram == model then
			hologram = nil
		end
		model:Destroy()
	end)
end

return World
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="19">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="20">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="21">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[-- 클라이언트 진입점: 상태 동기화, 굴리기/자동 굴리기, 메뉴 연결, 뉴스 속보, 회전 모형,
-- 환생 · Robux 상품 구매 요청 · 서버 행운 알림 (DESIGN.md v3)
-- (화면 글자에는 이모지를 쓰지 않음 — DESIGN.md UI 스타일 가이드 v2)
-- 알림은 [아이콘] + 8글자 안팎 ("구매 완료", "코인 부족", "대표 지정"), 문장은 쓰지 않음

local CollectionService = game:GetService("CollectionService")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TextChatService = game:GetService("TextChatService")
local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Format = require(Shared.Format)
local Landmarks = require(Shared.Landmarks)
local Net = require(Shared.Net)
local PlayerState = require(Shared.PlayerState)

local Hud = require(script.Hud)
local Icons = require(script.Icons)
local Panels = require(script.Panels)
local Perks = require(script.Perks)
local Ui = require(script.Ui)

local SPIN_TAG = "LandmarkSpin"
local SPIN_SPEED = math.rad(20) -- 태그 붙은 모형(광장 지구본, 홀로그램)의 초당 회전 각도

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local state: PlayerState.Snapshot? = nil -- 서버에서 받은 최신 Snapshot
local stateReceivedAt = 0
local deferredState: { Snapshot: any, ReceivedAt: number }? = nil -- 연출 중에 도착한 재동기화 상태
local rolling = false
local revealing = false
local autoRoll = false
local lastRollSentAt = -math.huge
local heldAnnouncements = {} -- 내 굴림 연출 중에 도착한 "내" 속보 (연출이 끝나면 표시)
local location = "Plaza" -- 지금 있는 곳: "Plaza" | "Park"
local teleporting = false
local rebirthing = false

local function currentCoins(): number
	if not state then
		return 0
	end
	return state.Coins + state.Income * math.max(0, time() - stateReceivedAt)
end

-- 서버 상태 반영. Revision 이 더 큰 것만 받아서 늦게 도착한 옛 상태가 덮어쓰지 않게 함.
-- receivedAt: 스냅샷을 실제로 받은 시각(코인 표시 기준). 늦게 반영할 때 넘겨줌.
local function applyState(snapshot: any, receivedAt: number?)
	if type(snapshot) ~= "table" or type(snapshot.Revision) ~= "number" then
		return
	end
	if state and snapshot.Revision <= state.Revision then
		return
	end
	state = snapshot
	stateReceivedAt = receivedAt or time()
	Hud.render(snapshot, stateReceivedAt)
	Hud.setCoins(currentCoins())
	Panels.render(snapshot)
end

-- 서버가 보내는 재동기화. 내 굴림 연출 중이면 결과가 미리 보이지 않게 연출이 끝난 뒤 반영
local function onStateEvent(snapshot: any)
	if type(snapshot) ~= "table" or type(snapshot.Revision) ~= "number" then
		return
	end
	if revealing then
		if not deferredState or snapshot.Revision > deferredState.Snapshot.Revision then
			deferredState = { Snapshot = snapshot, ReceivedAt = time() }
		end
		return
	end
	applyState(snapshot)
end

-- 원격 찾기. 서버가 아직 모르는 원격(예: 옛 서버에 Rebirth 가 없음)이면 영원히 기다리지 않고 nil
local remoteFolder: Instance? = nil
local function findRemote(name: string, seconds: number): Instance?
	if not remoteFolder then
		remoteFolder = Net.fn("GetState").Parent
	end
	local folder = remoteFolder
	if not folder then
		return nil
	end
	return folder:FindFirstChild(name) or folder:WaitForChild(name, seconds)
end

local function invoke(name: string, ...: any): any
	local remote = findRemote(name, 5)
	if not remote or not remote:IsA("RemoteFunction") then
		warn("[LandmarkRNG] 원격 없음: " .. name)
		Hud.toast("연결 오류", Ui.Theme.Bad, nil, "close")
		return nil
	end
	local ok, result = pcall(remote.InvokeServer, remote, ...)
	if not ok then
		warn("[LandmarkRNG] " .. name .. " 실패: " .. tostring(result))
		Hud.toast("연결 오류", Ui.Theme.Bad, nil, "close")
		return nil
	end
	return result
end

local function feature(landmarkId: string?)
	local response = invoke("Feature", landmarkId)
	if type(response) ~= "table" then
		return
	end
	applyState(response.State)
	if not response.Ok then
		Hud.toast("지정 실패", Ui.Theme.Bad, 2, "close")
	elseif landmarkId then
		local landmark = Landmarks.ById[landmarkId]
		if landmark then
			Hud.toast("대표 지정", landmark.Tier.Color, 2, "star")
		end
	else
		Hud.toast("대표 해제", Ui.Theme.Ink, 2, "star_empty")
	end
end

local function showAnnouncement(info: any, landmark: Landmarks.Landmark)
	local name = tostring(info.Name)
	Hud.news(name, landmark, tonumber(info.Rolls) or 0)

	-- 채팅창에도 시스템 메시지 (새 TextChatService 를 쓰는 경우)
	pcall(function()
		local channels = TextChatService:FindFirstChild("TextChannels")
		local general = channels and channels:FindFirstChild("RBXGeneral")
		if general then
			general:DisplaySystemMessage(
				string.format(
					'[속보] %s · <font color="%s"><b>%s</b></font> · %s · #%s',
					Format.escape(name),
					Format.hex(landmark.Tier.Color),
					Format.escape(landmark.Name),
					Format.oneIn(landmark.OneIn),
					Format.commas(tonumber(info.Rolls) or 0)
				)
			)
		end
	end)
end

-- 더 희귀한 명소를 발견했으면 자동으로 대표 지정 (설정이 켜져 있을 때)
local function autoFeature(landmark: Landmarks.Landmark)
	local current = state
	if not current or not current.Settings.AutoFeature then
		return
	end
	local featured = if current.Featured then Landmarks.ById[current.Featured] else nil
	if not featured or landmark.OneIn > featured.OneIn then
		feature(landmark.Id)
	end
end

local function roll()
	if rolling or not state then
		return
	end
	rolling = true
	Hud.setRolling(true)

	-- 쿨타임이 남았으면 기다렸다가 요청
	local waitFor = lastRollSentAt + (state :: PlayerState.Snapshot).Cooldown - time()
	if waitFor > 0 then
		task.wait(waitFor)
	end
	lastRollSentAt = time()
	local response = invoke("Roll")
	local receivedAt = time()

	local landmark = if type(response) == "table" and response.Ok then Landmarks.ById[response.LandmarkId] else nil
	if landmark then
		if type(response.State) == "table" then
			Hud.startCooldown(response.State.Cooldown)
		end
		revealing = true
		local ok, err = pcall(Hud.reveal, landmark, {
			Fast = autoRoll,
			IsNew = response.IsNew == true,
			StarUp = response.StarUp == true,
			Stars = tonumber(response.Stars) or 0,
			Bonus = tonumber(response.Bonus) or 0,
			Luck = tonumber(response.Luck) or 1,
		})
		if not ok then
			warn("[LandmarkRNG] 굴림 연출 오류: " .. tostring(err))
		end
		revealing = false

		-- 연출이 끝난 뒤에 숫자 갱신(스포일러 방지)
		applyState(response.State, receivedAt)
		local deferred = deferredState
		deferredState = nil
		if deferred then
			applyState(deferred.Snapshot, deferred.ReceivedAt)
		end
		for _, held in heldAnnouncements do
			showAnnouncement(held.Info, held.Landmark)
		end
		table.clear(heldAnnouncements)

		autoFeature(landmark)
	elseif type(response) == "table" and response.Ok then
		applyState(response.State, receivedAt) -- 모르는 명소 Id (클라가 옛 버전일 때)
	elseif type(response) == "table" and response.Reason == "cooldown" then
		task.wait(tonumber(response.RetryIn) or 0.2)
		lastRollSentAt = -math.huge -- 이미 RetryIn 만큼 기다렸으니 다음 요청에서 또 기다리지 않음
	else
		task.wait(1) -- 데이터 불러오는 중이거나 통신 실패: 자동 굴리기가 요청을 퍼붓지 않게
	end

	rolling = false
	Hud.setRolling(false)
end

local function toggleAuto()
	autoRoll = not autoRoll
	Hud.setAuto(autoRoll)
	if autoRoll and not rolling then
		task.spawn(roll)
	end
end

-- 서버가 준 실패 이유(문장 또는 코드) -> 짧은 알림 글자 + 아이콘
local function buyFailure(reason: any): (string, string)
	local text = string.lower(tostring(reason or ""))
	if text:find("코인") or text:find("coin") then
		return "코인 부족", "coin"
	elseif text:find("최대") or text:find("max") then
		return "MAX", "check"
	elseif text:find("불러") or text:find("load") then
		return "로딩 중", "globe"
	end
	return "구매 실패", "close"
end

local function buy(upgradeId: string)
	local response = invoke("BuyUpgrade", upgradeId)
	if type(response) ~= "table" then
		return
	end
	applyState(response.State)
	if response.Ok then
		-- 성공: 업그레이드 아이콘 + "Lv 3"
		local level = if state then PlayerState.upgradeLevel(state, upgradeId) else nil
		local icon = Icons.UPGRADE[upgradeId] or "check"
		Hud.toast(if level then "Lv " .. level else "구매 완료", Ui.Theme.Good, 2, icon)
	else
		local text, icon = buyFailure(response.Reason)
		Hud.toast(text, Ui.Theme.Bad, 2, icon)
	end
end

local function toggleAutoFeature()
	if not state then
		return
	end
	local response = invoke("SetSetting", "AutoFeature", not (state :: PlayerState.Snapshot).Settings.AutoFeature)
	if type(response) == "table" then
		applyState(response.State)
	end
end

-- 환생 -------------------------------------------------------------------------

-- 서버가 준 실패 이유 -> 짧은 알림. 이유가 애매하면 지금 상태로 판단
local function rebirthFailure(reason: any): (string, string)
	local text = string.lower(tostring(reason or ""))
	if text:find("코인") or text:find("coin") then
		return "코인 부족", "coin"
	elseif text:find("명소") or text:find("landmark") or text:find("missing") then
		return "명소 부족", "lock"
	elseif text:find("불러") or text:find("load") then
		return "로딩 중", "globe"
	end
	if state then
		local _, missing, short = Perks.rebirthCheck(state, currentCoins())
		if #missing > 0 then
			return "명소 부족", "lock"
		elseif short > 0 then
			return "코인 부족", "coin"
		end
	end
	return "환생 실패", "close"
end

local function rebirth()
	if rebirthing then
		return
	end
	rebirthing = true
	local response = invoke("Rebirth")
	rebirthing = false
	if type(response) ~= "table" then
		return
	end
	applyState(response.State)
	if response.Ok then
		Hud.flash(Ui.colorPair("Coral").Face, 0.55)
		Hud.toast("환생!", Ui.colorPair("Coral").Face, 3, "rebirth")
	else
		local text, icon = rebirthFailure(response.Reason)
		Hud.toast(text, Ui.Theme.Bad, 2, icon)
	end
end

-- Robux 상품 --------------------------------------------------------------------
-- 서버가 구매 창을 띄움. 지급 결과는 State(부스트·패스·코인) / ServerLuck 이벤트로 들어옴

local function buyRobux(remoteName: string, key: string)
	local response = invoke(remoteName, key)
	if type(response) ~= "table" then
		return
	end
	if type(response.State) == "table" then
		applyState(response.State)
	end
	if response.Ok == false then
		-- 시간 부스트는 최대 시간(3시간)이 차 있으면 서버가 구매 창을 안 띄움
		local item = Perks.item(key)
		if item and item.Seconds then
			Hud.toast("MAX", Ui.Theme.Bad, 2, item.Icon)
		else
			Hud.toast("구매 실패", Ui.Theme.Bad, 2, "close")
		end
	end
end

-- 구매 창에서 실제로 샀을 때: [상품 아이콘] "구매 완료"
local function purchased(kind: string, id: any)
	local item = Perks.itemById(kind, tonumber(id) or 0)
	Hud.toast("구매 완료", Ui.Theme.Good, 3, if item then item.Icon else "check")
end

-- 광장 <-> 내 공원 이동
local function teleport()
	if teleporting then
		return
	end
	teleporting = true
	local target = if location == "Plaza" then "Park" else "Plaza"
	local response = invoke("Teleport", target)
	if type(response) == "table" and response.Ok then
		location = target
		Hud.setLocation(location)
	elseif response ~= nil then
		Hud.toast("이동 실패", Ui.Theme.Bad, 2, "close")
	end
	teleporting = false
end

-- 화면 만들기 ---------------------------------------------------------------

local gui = Hud.init(playerGui, {
	Roll = function()
		task.spawn(roll)
	end,
	ToggleAuto = toggleAuto,
	Menu = Panels.toggle,
	Teleport = function()
		task.spawn(teleport)
	end,
})
Panels.init(gui, {
	Feature = function(landmarkId: string?)
		task.spawn(feature, landmarkId)
	end,
	Buy = function(upgradeId: string)
		task.spawn(buy, upgradeId)
	end,
	ToggleAutoFeature = function()
		task.spawn(toggleAutoFeature)
	end,
	Rebirth = function()
		task.spawn(rebirth)
	end,
	BuyPass = function(key: string)
		task.spawn(buyRobux, "BuyPass", key)
	end,
	BuyProduct = function(key: string)
		task.spawn(buyRobux, "BuyProduct", key)
	end,
	Toast = function(text: string, icon: string?)
		Hud.toast(text, Ui.Theme.Bad, 2, icon)
	end,
})

-- 다시 태어나면 광장(스폰 지점)에서 시작
player.CharacterAdded:Connect(function()
	location = "Plaza"
	Hud.setLocation(location)
end)

-- 키보드: R = 굴리기, T = 자동 굴리기
UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if input.KeyCode == Enum.KeyCode.R then
		task.spawn(roll)
	elseif input.KeyCode == Enum.KeyCode.T then
		toggleAuto()
	end
end)

-- 서버 이벤트 ---------------------------------------------------------------

Net.event("State").OnClientEvent:Connect(onStateEvent)

Net.event("Announce").OnClientEvent:Connect(function(info)
	local landmark = if type(info) == "table" then Landmarks.ById[info.LandmarkId] else nil
	if not landmark then
		return
	end
	-- 내가 발견한 속보가 내 연출보다 먼저 오면 결과가 미리 보이므로 연출이 끝날 때까지 보류
	if info.UserId == player.UserId and revealing then
		table.insert(heldAnnouncements, { Info = info, Landmark = landmark })
		return
	end
	showAnnouncement(info, landmark)
end)

-- 서버 행운 { Name, Until, Left }: 위쪽 띠 + "<이름> 서버 행운!"
-- (남은 초 Left 를 먼저 씀: 시계 동기화 오차가 없음. 옛 서버에 이벤트가 없어도 멈추지 않게 따로 기다림)
task.spawn(function()
	local remote = findRemote("ServerLuck", 30)
	if not remote or not remote:IsA("RemoteEvent") then
		return
	end
	remote.OnClientEvent:Connect(function(info)
		if type(info) ~= "table" then
			return
		end
		local left = tonumber(info.Left)
		local untilTime = if left and left > 0 then left else tonumber(info.Until)
		if untilTime then
			Hud.serverLuck(tostring(info.Name or ""), untilTime)
		end
	end)
end)

-- 구매 창이 닫힐 때 알림만 (지급은 서버의 ProcessReceipt). 연결에 실패해도 아래 루프는 돌아야 하므로 pcall
pcall(function()
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(who, passId, wasPurchased)
		if who == player and wasPurchased then
			purchased("Pass", passId)
		end
	end)
	MarketplaceService.PromptProductPurchaseFinished:Connect(function(userId, productId, isPurchased)
		if userId == player.UserId and isPurchased then
			purchased("Product", productId)
		end
	end)
end)

-- 루프 ---------------------------------------------------------------------

-- "LandmarkSpin" 태그 모형 목록 (태그가 붙고 떨어질 때만 갱신 → 매 프레임 목록을 새로 만들지 않음)
local spinModels: { [Instance]: boolean } = {}
for _, instance in CollectionService:GetTagged(SPIN_TAG) do
	spinModels[instance] = true
end
CollectionService:GetInstanceAddedSignal(SPIN_TAG):Connect(function(instance)
	spinModels[instance] = true
end)
CollectionService:GetInstanceRemovedSignal(SPIN_TAG):Connect(function(instance)
	spinModels[instance] = nil
end)

RunService.RenderStepped:Connect(function(dt)
	-- 태그 모형을 제자리에서 수직축으로 회전 (이 화면에서만 보이는 효과)
	local turn = CFrame.Angles(0, SPIN_SPEED * dt, 0)
	for model in spinModels do
		if model:IsA("Model") and model:IsDescendantOf(workspace) then
			local pivot = model:GetPivot()
			model:PivotTo(CFrame.new(pivot.Position) * turn * (pivot - pivot.Position))
		end
	end

	-- 코인: 받은 값 + 초당 수입 × 지난 시간 (부드럽게 올라감)
	if state then
		Hud.setCoins(currentCoins())
	end
end)

-- 업그레이드 버튼 "살 수 있음" 색, 환생 조건, 부스트·서버 행운 타이머 (가벼운 갱신)
task.spawn(function()
	while true do
		if state then
			local coins = currentCoins()
			Panels.refreshCoins(coins)
			Hud.tick(coins)
		else
			Hud.tick(nil)
		end
		task.wait(0.25)
	end
end)

-- 자동 굴리기
task.spawn(function()
	while true do
		if autoRoll and not rolling then
			roll()
		end
		task.wait(0.05)
	end
end)

-- 처음 상태 받아오기 (서버 데이터 로드가 끝날 때까지 서버 쪽에서 기다려 줌)
applyState(invoke("GetState"))
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">Hud</string>
            <string name="Source"><![CDATA[-- 기본 화면(HUD): 코인·수입·스탯, 메뉴 버튼, 굴리기 버튼, 지구본 굴림 연출, 뉴스 속보, 알림,
-- 환생 수·부스트 타이머·서버 행운 띠(v3), 상점 버튼(오른쪽, 팔 상품이 있을 때만)
-- 스타일은 DESIGN.md "UI 스타일 가이드 (v2)" — 통통한 버튼 + 굵은 Ink 테두리 + 아이콘, 이모지 없음
-- 글자는 최소로: 아이콘 + 숫자 위주, 버튼 글자는 2~3글자, 알림은 8글자 안팎. 설명 문장은 쓰지 않음.

local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Landmarks = require(Shared.Landmarks)
local PlayerState = require(Shared.PlayerState)

local Icons = require(script.Parent.Icons)
local Perks = require(script.Parent.Perks)
local Ui = require(script.Parent.Ui)
local Viewport = require(script.Parent.Viewport)
local Theme = Ui.Theme

-- 등급(Rank)별 지구본이 도는 시간(초). 빠른 모드(자동 굴림)에서는 세계 명소 미만만 절반으로 줄임.
local REVEAL_SECONDS = { 0.9, 1.1, 1.5, 2.1, 2.7, 3.1, 3.3 }
local LAND_SECONDS = 0.4 -- 결과 지역에 멈춘 뒤 결과가 나오기까지
local SUSPENSE_SECONDS = 0.9 -- 불가사의 이상 "? ? ?" 뜸 들이기
local NEWS_SECONDS = 7
local MAX_NEWS = 2
local MAX_TOASTS = 4
local TICK_SOUND = "rbxasset://sounds/electronicpingshort.wav"

local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)
local INCOME_GREEN = Color3.fromRGB(150, 255, 150)
local ODDS_COLOR = Color3.fromRGB(120, 112, 150)

local MENU_BUTTON = Vector2.new(84, 90) -- 앞면 84x84 + 그림자 6
local MENU_ICON = 58
local ROLL_BUTTON = Vector2.new(270, 90) -- 앞면 270x84
local AUTO_BUTTON = Vector2.new(140, 76) -- 앞면 140x70
local VIEW_SIZE = 230 -- 굴림 연출의 둥근 판 지름
local RAY_COUNT = 12 -- 햇살 막대 수 (막대 하나 = 가운데를 지나는 빛줄기 2개)

-- 햇살 막대: 가운데는 진하고 양 끝으로 갈수록 투명
local RAY_FADE = NumberSequence.new({
	NumberSequenceKeypoint.new(0, 1),
	NumberSequenceKeypoint.new(0.3, 0.55),
	NumberSequenceKeypoint.new(0.5, 0.2),
	NumberSequenceKeypoint.new(0.7, 0.55),
	NumberSequenceKeypoint.new(1, 1),
})

export type RevealInfo = {
	Fast: boolean,
	IsNew: boolean,
	StarUp: boolean,
	Stars: number,
	Bonus: number,
	Luck: number,
}

export type Handlers = {
	Roll: () -> (),
	ToggleAuto: () -> (),
	Menu: (string) -> (),
	Teleport: () -> (),
}

local Hud = {}

local gui: ScreenGui
local flashFrame: Frame
local refs: { [string]: any } = {}
local spinRandom = Random.new()
local hideToken = 0
local shownCoins = -1
local newsItems: { Frame } = {}
local newsOrder = 0
local toasts: { GuiObject } = {}
local toastOrder = 0
local burstTween: Tween? = nil

-- 타이머(부스트·서버 행운)와 환생 배지: render 에서 기준값을 받고 tick 에서 글자만 고침
local hudState: PlayerState.Snapshot? = nil
local boosts: { Perks.Boost } = {}
local boostsAt = 0 -- boosts 의 남은 시간을 잰 시각(time())
local boostChips: { [string]: Ui.Chip } = {}
local snapshotLuckUntil: number? = nil -- 스냅샷이 알려 준 서버 행운 끝 시각(유닉스 초)
local snapshotLuckOn = false -- 시각 없이 "켜짐"만 알 때
local eventLuckUntil = 0 -- ServerLuck 이벤트가 알려 준 끝 시각
local rebirthReady = false
local badgeTween: Tween? = nil

local function makeSound(pitch: number, volume: number): Sound
	return Ui.new("Sound", {
		SoundId = TICK_SOUND,
		PlaybackSpeed = pitch,
		Volume = volume,
		Parent = SoundService,
	})
end

local tickSound: Sound
local landSound: Sound
local revealSound: Sound
local rareSound: Sound
local newsSound: Sound
local luckSound: Sound

local function play(sound: Sound?)
	if sound then
		sound.TimePosition = 0
		sound:Play()
	end
end

-- 글자가 바뀔 때만 고침 (자주 부르는 타이머용)
local function setText(label: TextLabel, text: string)
	if label.Text ~= text then
		label.Text = text
	end
end

-- 서버 시계(유닉스 초). 서버 행운 끝 시각과 비교
local function serverNow(): number
	return workspace:GetServerTimeNow()
end

-- 화면 구석에 붙는 투명 컨테이너(화면 크기에 따라 자동 스케일)
local function anchor(name: string, anchorPoint: Vector2, position: UDim2, size: UDim2, zIndex: number?): Frame
	local frame = Ui.new("Frame", {
		Name = name,
		AnchorPoint = anchorPoint,
		Position = position,
		Size = size,
		BackgroundTransparency = 1,
		ZIndex = zIndex or 1,
		Parent = gui,
	})
	Ui.autoScale(frame)
	return frame
end

-- 초당 수입 표시: 작은 값은 소수 한 자리까지 ("1.8"), 큰 값은 축약 ("12.5K")
local function incomeText(income: number): string
	if income < 100 then
		local text = string.format("%.1f", math.floor(income * 10) / 10):gsub("%.0$", "")
		return text
	end
	return Format.short(income)
end

-- 왼쪽 위: [코인 알약][+수입/s] / [주사위 굴림 수][클로버 행운] -----------------

local COIN_PILL = Vector2.new(230, 52)

local function buildStats()
	local container = anchor("Stats", Vector2.new(0, 0), UDim2.fromOffset(14, 12), UDim2.fromOffset(420, 112))

	local coins = Ui.pill({
		Name = "Coins",
		Position = UDim2.fromOffset(20, 6),
		Size = UDim2.fromOffset(COIN_PILL.X, COIN_PILL.Y),
		Icon = "coin",
		IconSize = 68,
		IconSpin = 50,
		MaxTextSize = 36,
		BackgroundTransparency = 0.2,
		Parent = container,
	})
	refs.CoinLabel = coins.Label

	-- 초당 수입: 코인 바로 오른쪽 작은 칩 (위 화살표 + "+13.5/s")
	refs.IncomeChip = Ui.chip({
		Name = "Income",
		Color = Theme.Ink,
		TextColor3 = INCOME_GREEN,
		Icon = "arrow_up",
		Height = 30,
		TextSize = 18,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromOffset(20 + COIN_PILL.X + 8, 6 + COIN_PILL.Y / 2),
		Parent = container,
	})

	local chips = Ui.new("Frame", {
		Name = "Chips",
		Position = UDim2.fromOffset(24, 70),
		Size = UDim2.fromOffset(380, 36),
		BackgroundTransparency = 1,
		Parent = container,
	})
	Ui.list(Enum.FillDirection.Horizontal, 12).Parent = chips
	refs.StatChips = chips
	refs.RollsChip = Ui.chip({
		Name = "Rolls",
		Color = "Sky",
		Icon = "dice",
		Height = 30,
		TextSize = 18,
		LayoutOrder = 1,
		Parent = chips,
	})
	refs.LuckChip = Ui.chip({
		Name = "Luck",
		Color = "Grape",
		Icon = "clover",
		Height = 30,
		TextSize = 18,
		LayoutOrder = 2,
		Parent = chips,
	})
	-- (LayoutOrder 3: 부스트 타이머 딱지 "×2 12:34" — 처음 필요할 때 만듦)
	-- 환생 수 (1 이상일 때만)
	refs.RebirthChip = Ui.chip({
		Name = "Rebirths",
		Color = "Coral",
		Icon = "rebirth",
		Height = 30,
		TextSize = 18,
		LayoutOrder = 4,
		Visible = false,
		Parent = chips,
	})
end

-- 왼쪽 가운데: 네모 통통 버튼 5개 (큰 아이콘 + 2글자) -----------------------------

local MENU = {
	{ Id = "Collection", Text = "도감", Color = "Sky", Icon = "album" },
	{ Id = "Passport", Text = "여권", Color = "Grape", Icon = "passport" },
	{ Id = "Upgrade", Text = "강화", Color = "Sun", Icon = "hammer" },
	{ Id = "Rebirth", Text = "환생", Color = "Coral", Icon = "rebirth" },
}

local function buildMenu(onMenu: (string) -> (), onTeleport: () -> ())
	local count = #MENU + 1
	local gap = 12
	local container = anchor(
		"Menu",
		Vector2.new(0, 0.5),
		UDim2.new(0, 14, 0.5, 16),
		UDim2.fromOffset(MENU_BUTTON.X + 8, count * MENU_BUTTON.Y + (count - 1) * gap)
	)
	Ui.list(Enum.FillDirection.Vertical, gap).Parent = container

	for order, entry in MENU do
		local button = Ui.chunkyButton({
			Name = entry.Id,
			LayoutOrder = order,
			Size = UDim2.fromOffset(MENU_BUTTON.X, MENU_BUTTON.Y),
			Color = entry.Color,
			Icon = entry.Icon,
			IconSize = MENU_ICON,
			Vertical = true,
			Text = entry.Text,
			TextSize = 18,
			Parent = container,
		})
		button.Activated:Connect(function()
			onMenu(entry.Id)
		end)
		if entry.Id == "Passport" then
			-- 여권 도장 수 "1/6" 배지 (오른쪽 위)
			refs.PassportBadge = Ui.chip({
				Name = "Stamps",
				Color = Theme.Ink,
				Height = 24,
				TextSize = 15,
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(1, -6, 0, 2),
				Rotation = 8,
				ZIndex = 6,
				Visible = false,
				Parent = button.Face,
			})
		elseif entry.Id == "Rebirth" then
			-- 환생할 수 있으면 "!" 배지가 통통 뜀
			local badge = Ui.chip({
				Name = "Ready",
				Color = "Sun",
				Text = "!",
				Font = Theme.FontTitle,
				Height = 28,
				TextSize = 20,
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(1, -6, 0, 2),
				Rotation = 10,
				ZIndex = 6,
				Visible = false,
				Parent = button.Face,
			})
			refs.RebirthBadge = badge
			refs.RebirthBadgeScale = Ui.new("UIScale", { Parent = badge.Root })
		end
	end

	refs.TeleportButton = Ui.chunkyButton({
		Name = "Teleport",
		LayoutOrder = count,
		Size = UDim2.fromOffset(MENU_BUTTON.X, MENU_BUTTON.Y),
		Color = "Grass",
		Icon = "park",
		IconSize = MENU_ICON,
		Vertical = true,
		Text = "공원",
		TextSize = 18,
		Parent = container,
	})
	refs.TeleportButton.Activated:Connect(onTeleport)
end

-- 오른쪽 가운데: 상점 (Robux 상품이 하나도 없으면 안 만듦)
local function buildShop(onMenu: (string) -> ())
	if not Perks.anyForSale() then
		return
	end
	local container = anchor(
		"Shop",
		Vector2.new(1, 0.5),
		UDim2.new(1, -14, 0.5, 16),
		UDim2.fromOffset(MENU_BUTTON.X + 8, MENU_BUTTON.Y)
	)
	local button = Ui.chunkyButton({
		Name = "Shop",
		Size = UDim2.fromOffset(MENU_BUTTON.X, MENU_BUTTON.Y),
		Color = "Sun",
		Icon = "coin",
		IconSize = MENU_ICON,
		IconSpin = 45,
		Vertical = true,
		Text = "상점",
		TextSize = 18,
		Parent = container,
	})
	button.Activated:Connect(function()
		onMenu("Shop")
	end)
end

-- 아래 가운데: 굴리기 + 자동 (키보드가 있으면 버튼 모서리에 R / T 키캡) --------------

local function buildRollBar(onRoll: () -> (), onToggleAuto: () -> ())
	local width = ROLL_BUTTON.X + 2 * (AUTO_BUTTON.X + 16)
	local container = anchor("RollBar", Vector2.new(0.5, 1), UDim2.new(0.5, 0, 1, -14), UDim2.fromOffset(width, 100))

	local roll = Ui.chunkyButton({
		Name = "Roll",
		Position = UDim2.new(0.5, -ROLL_BUTTON.X / 2, 1, -ROLL_BUTTON.Y),
		Size = UDim2.fromOffset(ROLL_BUTTON.X, ROLL_BUTTON.Y),
		Color = "Grass",
		Icon = "globe",
		IconSize = 70,
		IconSpin = 60,
		Text = "굴리기",
		TextSize = 40,
		OutlineThickness = 3,
		Parent = container,
	})
	roll.Activated:Connect(onRoll)
	refs.RollButton = roll
	Ui.keyCap(roll.Face, "R", { Position = UDim2.fromOffset(4, 4) })
	-- 글자는 쿨타임 막대 위쪽에
	roll.Label.Position = UDim2.fromOffset(82, 2)
	roll.Label.Size = UDim2.new(1, -94, 1, -22)

	-- 쿨타임: 버튼 안 아래쪽 막대가 비었다가 가득 차면 다시 굴릴 수 있음
	local track = Ui.new("Frame", {
		Name = "Cooldown",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 84, 1, -9),
		Size = UDim2.new(1, -100, 0, 10),
		BackgroundColor3 = Theme.Ink,
		BackgroundTransparency = 0.5,
		BorderSizePixel = 0,
		ZIndex = 5,
		Parent = roll.Face,
	})
	Ui.round().Parent = track
	refs.CooldownFill = Ui.new("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		ZIndex = 6,
		Parent = track,
	})
	Ui.round().Parent = refs.CooldownFill

	local auto = Ui.chunkyButton({
		Name = "Auto",
		Position = UDim2.new(0.5, ROLL_BUTTON.X / 2 + 16, 1, -(ROLL_BUTTON.Y + AUTO_BUTTON.Y) / 2),
		Size = UDim2.fromOffset(AUTO_BUTTON.X, AUTO_BUTTON.Y),
		Color = "Gray",
		Icon = "auto",
		IconSize = 46,
		Text = "AUTO",
		TextSize = 24,
		Parent = container,
	})
	auto.Activated:Connect(onToggleAuto)
	refs.AutoButton = auto
	Ui.keyCap(auto.Face, "T", { Position = UDim2.fromOffset(4, 4) })
	refs.AutoBadge = Ui.chip({
		Name = "On",
		Color = "Coral",
		Text = "ON",
		Height = 24,
		TextSize = 16,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -10, 0, 2),
		Rotation = 12,
		ZIndex = 6,
		Visible = false,
		Parent = auto.Face,
	})
end

-- 굴림 연출 ------------------------------------------------------------------

local function buildReveal()
	local container = anchor(
		"Reveal",
		Vector2.new(0.5, 0.5),
		UDim2.fromScale(0.5, 0.45),
		UDim2.fromOffset(700, 500),
		8 -- 메뉴 창보다 위
	)
	container.Visible = false
	refs.Reveal = container

	local inner = Ui.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = container,
	})
	refs.RevealScale = Ui.new("UIScale", { Parent = inner })

	-- 지역 이름: 도는 동안은 지역 색 글자, 멈추면 지역 색 딱지
	local regionTag = Ui.new("Frame", {
		Name = "Region",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0),
		Size = UDim2.fromOffset(280, 48),
		BackgroundTransparency = 1,
		ZIndex = 4,
		Parent = inner,
	})
	Ui.round().Parent = regionTag
	refs.RegionStroke = Ui.stroke()
	refs.RegionStroke.Parent = regionTag
	refs.RegionTag = regionTag
	refs.RegionSkin = Ui.skin(regionTag, "tag", { Radius = 24, Height = 48 })
	if refs.RegionSkin then
		refs.RegionSkin.Visible = false
	end
	refs.RevealRegion = Ui.label({
		Position = UDim2.fromOffset(12, 4),
		Size = UDim2.new(1, -24, 1, -8),
		TextColor3 = WHITE,
		ZIndex = 2,
		Parent = regionTag,
	}, 34)
	Ui.outline(refs.RevealRegion, 3)

	local centerY = 62 + VIEW_SIZE / 2

	-- 뒤에서 도는 햇살 (막대 12개를 가운데 기준으로 돌려 놓음)
	local burst = Ui.new("Frame", {
		Name = "Burst",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0, centerY),
		Size = UDim2.fromOffset(500, 500),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 1,
		Parent = inner,
	})
	refs.Burst = burst
	refs.Rays = {}
	-- 햇살 그림이 있으면 그 그림 하나를 등급 색으로 물들여 돌림, 없으면 막대 12개
	refs.BurstImage = Ui.skin(burst, "sunburst")
	for i = 1, if refs.BurstImage then 0 else RAY_COUNT do
		local ray = Ui.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.new(0, 30, 1, 0),
			Rotation = (i - 1) * 180 / RAY_COUNT,
			BackgroundColor3 = WHITE,
			BorderSizePixel = 0,
			Parent = burst,
		})
		Ui.new("UIGradient", { Rotation = 90, Transparency = RAY_FADE, Parent = ray })
		table.insert(refs.Rays, ray)
	end

	-- 모형 뒤의 둥근 판
	local disc = Ui.new("Frame", {
		Name = "Disc",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0, centerY),
		Size = UDim2.fromOffset(VIEW_SIZE, VIEW_SIZE),
		BackgroundColor3 = Theme.Cream,
		ZIndex = 2,
		Parent = inner,
	})
	Ui.round().Parent = disc
	Ui.stroke(Theme.Ink, 5).Parent = disc
	local ring = Ui.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -18, 1, -18),
		BackgroundTransparency = 1,
		Parent = disc,
	})
	Ui.round().Parent = ring
	Ui.stroke(WHITE, 3, 0.15).Parent = ring
	refs.Disc = disc

	local viewProps = {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0, centerY),
		Size = UDim2.fromOffset(VIEW_SIZE - 16, VIEW_SIZE - 16),
		ZIndex = 3,
	}
	refs.EarthView = Viewport.new(inner, viewProps)
	Viewport.setLandmark(refs.EarthView, Landmarks.Globe, 10)
	refs.ResultView = Viewport.new(inner, viewProps)
	refs.ResultView.Visible = false

	-- 등급 리본 (판 아래쪽에 걸침)
	local ribbon = Ui.new("Frame", {
		Name = "TierRibbon",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0, centerY + VIEW_SIZE / 2),
		Size = UDim2.fromOffset(250, 44),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 4,
		Parent = inner,
	})
	refs.RibbonTails = {}
	for _, side in { 0, 1 } do
		local tail = Ui.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(side, if side == 0 then -14 else 14, 0.5, 9),
			Size = UDim2.fromOffset(42, 34),
			BorderSizePixel = 0,
			ZIndex = 1,
			Parent = ribbon,
		})
		Ui.corner(8).Parent = tail
		Ui.stroke().Parent = tail
		table.insert(refs.RibbonTails, tail)
	end
	local ribbonMain = Ui.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = ribbon,
	})
	Ui.corner(10).Parent = ribbonMain
	Ui.stroke().Parent = ribbonMain
	if Ui.skin(ribbonMain, "ribbon", { Radius = 12, Height = 44 }) then
		for _, tail in refs.RibbonTails do
			tail.Visible = false -- 리본 그림에 꼬리가 들어 있음
		end
	end
	refs.RibbonLabel = Ui.label({
		Position = UDim2.fromOffset(10, 4),
		Size = UDim2.new(1, -20, 1, -8),
		TextColor3 = WHITE,
		ZIndex = 3,
		Parent = ribbonMain,
	}, 28)
	Ui.outline(refs.RibbonLabel, 2.5)
	refs.Ribbon = ribbon
	refs.RibbonMain = ribbonMain

	local nameTop = centerY + VIEW_SIZE / 2 + 28
	refs.RevealName = Ui.label({
		Position = UDim2.fromOffset(0, nameTop),
		Size = UDim2.new(1, 0, 0, 66),
		Font = Theme.FontTitle,
		ZIndex = 4,
		Parent = inner,
	}, 62)
	Ui.outline(refs.RevealName, 4)
	refs.RevealOdds = Ui.label({
		Position = UDim2.fromOffset(0, nameTop + 66),
		Size = UDim2.new(1, 0, 0, 30),
		Font = Theme.FontTitle,
		TextColor3 = WHITE,
		ZIndex = 4,
		Parent = inner,
	}, 28)
	Ui.outline(refs.RevealOdds, 2.5)

	-- 딱지 줄: NEW / ★3 UP / 발견 보너스(코인 + 숫자)
	local tagRow = Ui.new("Frame", {
		Name = "Tags",
		Position = UDim2.fromOffset(0, nameTop + 104),
		Size = UDim2.new(1, 0, 0, 36),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 4,
		Parent = inner,
	})
	Ui.list(Enum.FillDirection.Horizontal, 14, Enum.HorizontalAlignment.Center).Parent = tagRow
	refs.TagRow = tagRow
	refs.NewChip = Ui.chip({
		Name = "New",
		Color = "Coral",
		Text = "NEW",
		Font = Theme.FontTitle,
		Height = 32,
		TextSize = 22,
		LayoutOrder = 1,
		Parent = tagRow,
	})
	refs.StarChip = Ui.chip({
		Name = "StarUp",
		Color = "Grape",
		Font = Theme.FontTitle,
		Height = 32,
		TextSize = 21,
		LayoutOrder = 2,
		Parent = tagRow,
	})
	refs.BonusPill = Ui.pill({
		Name = "Bonus",
		AutoWidth = true,
		Size = UDim2.fromOffset(0, 32),
		Icon = "coin",
		IconSize = 44,
		TextSize = 21,
		TextColor3 = Ui.colorPair("Sun").Face,
		LayoutOrder = 3,
		Parent = tagRow,
	})
end

-- 서버 행운 띠 / 뉴스 속보 / 알림 자리 ------------------------------------------

local function topList(parent: Instance, gap: number): UIListLayout
	local layout = Ui.list(Enum.FillDirection.Vertical, gap, Enum.HorizontalAlignment.Center)
	layout.VerticalAlignment = Enum.VerticalAlignment.Top
	layout.Parent = parent
	return layout
end

local function buildNotices()
	-- 위에서부터 [서버 행운 띠(켜졌을 때만)] [뉴스 속보] [알림] 순서로 쌓임. 띠가 뜨면 아래 둘이 함께 내려감
	local top = anchor("Top", Vector2.new(0.5, 0), UDim2.new(0.5, 0, 0, 10), UDim2.fromOffset(720, 380), 9)
	topList(top, 6)

	-- 서버 행운: 도는 지구본 + "서버 행운 ×2 · 12:34"
	refs.ServerLuck = Ui.chip({
		Name = "ServerLuck",
		Color = "Grape",
		Icon = "globe",
		IconSpin = 60,
		IconSize = 50,
		Height = 40,
		TextSize = 22,
		StrokeThickness = 3,
		LayoutOrder = 1,
		Visible = false,
		Parent = top,
	})

	-- 뉴스 속보
	local news = Ui.new("Frame", {
		Name = "News",
		LayoutOrder = 2,
		Size = UDim2.fromOffset(720, 118),
		BackgroundTransparency = 1,
		Parent = top,
	})
	topList(news, 8)
	refs.News = news

	-- 잠깐 떴다 사라지는 알림(뉴스 아래)
	local notices = Ui.new("Frame", {
		Name = "Notices",
		LayoutOrder = 3,
		Size = UDim2.fromOffset(600, 200),
		BackgroundTransparency = 1,
		Parent = top,
	})
	topList(notices, 8)
	refs.Notices = notices
end

function Hud.init(playerGui: PlayerGui, handlers: Handlers): ScreenGui
	gui = Ui.new("ScreenGui", {
		Name = "LandmarkRNG",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = playerGui,
	})
	local flashGui = Ui.new("ScreenGui", {
		Name = "LandmarkRNGFlash",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 5,
		Parent = playerGui,
	})
	flashFrame = Ui.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Parent = flashGui,
	})

	tickSound = makeSound(1.4, 0.25)
	landSound = makeSound(1.1, 0.4)
	revealSound = makeSound(0.9, 0.6)
	rareSound = makeSound(0.5, 1)
	newsSound = makeSound(0.7, 0.5)
	luckSound = makeSound(0.6, 0.7)

	buildStats()
	buildMenu(handlers.Menu, handlers.Teleport)
	buildShop(handlers.Menu)
	buildRollBar(handlers.Roll, handlers.ToggleAuto)
	buildReveal()
	buildNotices()
	Hud.render(nil)
	return gui
end

-- 환생 가능 배지: 켜질 때만 통통 뛰는 애니메이션을 돌림
local function setRebirthReady(ready: boolean)
	if ready == rebirthReady then
		return
	end
	rebirthReady = ready
	refs.RebirthBadge.Root.Visible = ready
	local tween = badgeTween
	if tween then
		tween:Cancel()
		badgeTween = nil
	end
	refs.RebirthBadgeScale.Scale = 1
	if ready then
		local pulse = TweenService:Create(
			refs.RebirthBadgeScale,
			TweenInfo.new(0.45, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
			{ Scale = 1.25 }
		)
		pulse:Play()
		badgeTween = pulse
	end
end

local function boostChip(boost: Perks.Boost): Ui.Chip
	local chip = boostChips[boost.Key]
	if not chip then
		chip = Ui.chip({
			Name = "Boost" .. boost.Key,
			Color = "Sun",
			Icon = boost.Icon,
			Height = 30,
			TextSize = 18,
			LayoutOrder = 3,
			Parent = refs.StatChips,
		})
		boostChips[boost.Key] = chip
	end
	return chip
end

-- 가벼운 갱신(0.25초마다): 부스트 남은 시간, 서버 행운 띠, 환생 배지. 글자는 바뀔 때만 고침
-- coins: 지금 보이는 코인(부드럽게 오르는 값). nil 이면 환생 배지는 그대로 둠
function Hud.tick(coins: number?)
	local elapsed = time() - boostsAt
	local active: { [string]: boolean } = {}
	for _, boost in boosts do
		local left = boost.Seconds - elapsed
		if left > 0 then
			active[boost.Key] = true
			local chip = boostChip(boost)
			setText(chip.Label, Ui.times(boost.Mult) .. " " .. Format.duration(left))
			chip.Root.Visible = true
		end
	end
	for key, chip in boostChips do
		if not active[key] then
			chip.Root.Visible = false
		end
	end

	-- 서버 행운: 스냅샷/이벤트 중 더 늦게 끝나는 쪽
	local banner = refs.ServerLuck
	local untilTime = math.max(snapshotLuckUntil or 0, eventLuckUntil)
	local left = untilTime - serverNow()
	local luckText = "서버 행운 " .. Ui.times(Perks.mult("ServerLuck", 2))
	if left > 0 then
		setText(banner.Label, luckText .. " · " .. Format.duration(left))
		banner.Root.Visible = true
	elseif snapshotLuckOn then
		setText(banner.Label, luckText)
		banner.Root.Visible = true
	else
		banner.Root.Visible = false
	end

	if coins and hudState then
		setRebirthReady((Perks.rebirthCheck(hudState, coins)))
	end
end

-- receivedAt: 스냅샷을 받은 시각(time()). 부스트·서버 행운의 "남은 초" 기준
function Hud.render(state: PlayerState.Snapshot?, receivedAt: number?)
	hudState = state
	if not state then
		refs.CoinLabel.Text = "..."
		refs.IncomeChip.Root.Visible = false
		refs.RollsChip.Root.Visible = false
		refs.LuckChip.Root.Visible = false
		refs.RebirthChip.Root.Visible = false
		refs.PassportBadge.Root.Visible = false
		setRebirthReady(false)
		shownCoins = -1
		return
	end
	local at = receivedAt or time()
	refs.IncomeChip.Label.Text = "+" .. incomeText(state.Income) .. "/s"
	refs.IncomeChip.Root.Visible = true
	refs.RollsChip.Label.Text = Format.commas(state.Rolls)
	refs.RollsChip.Root.Visible = true
	refs.LuckChip.Label.Text = Ui.times(state.Luck)
	refs.LuckChip.Root.Visible = true

	-- 여권 버튼 배지: 도장 수 (하나라도 있으면 금색 숫자)
	local stamps = #PlayerState.completedRegions(state)
	local badge = refs.PassportBadge
	badge.Label.Text = string.format("%d/%d", stamps, #Landmarks.Regions)
	badge.Label.TextColor3 = if stamps > 0 then Ui.colorPair("Sun").Face else WHITE
	badge.Root.Visible = true

	-- 환생 수 딱지 (0 이면 숨김)
	local rebirths = Perks.rebirths(state)
	refs.RebirthChip.Label.Text = Format.commas(rebirths)
	refs.RebirthChip.Root.Visible = rebirths > 0

	-- 부스트 / 서버 행운 기준값 (스냅샷을 받은 순간 기준)
	local snapshot = state :: any
	boosts = Perks.boosts(snapshot)
	boostsAt = at
	snapshotLuckUntil, snapshotLuckOn = Perks.serverLuck(snapshot.ServerLuck, serverNow() - (time() - at))
	Hud.tick(state.Coins + state.Income * math.max(0, time() - at))
end

-- ServerLuck 이벤트: 띠를 켜고 "<이름> 서버 행운!" 알림
-- untilValue: 끝나는 시각(서버 시계, 유닉스 초) 또는 남은 초
function Hud.serverLuck(name: string, untilValue: number)
	eventLuckUntil = math.max(eventLuckUntil, Perks.toEpoch(untilValue, serverNow()))
	Hud.tick(nil)
	local text = if name ~= "" then Format.escape(name) .. " 서버 행운!" else "서버 행운!"
	Hud.toast(text, Ui.colorPair("Grape").Face, 4, "globe")
	play(luckSound)
end

-- 매 프레임 호출: 부드럽게 올라가는 코인 표시 (정수가 바뀔 때만 글자 갱신)
function Hud.setCoins(amount: number)
	local whole = math.max(0, math.floor(amount))
	if whole == shownCoins then
		return
	end
	shownCoins = whole
	refs.CoinLabel.Text = Format.commas(whole)
end

function Hud.setAuto(enabled: boolean)
	refs.AutoButton.SetColor(if enabled then "Sun" else "Gray")
	refs.AutoBadge.Root.Visible = enabled
end

-- 굴리는 중에는 지구본 아이콘이 빠르게 돎 (글자는 그대로)
function Hud.setRolling(rolling: boolean)
	local icon = refs.RollButton.Icon
	if icon then
		Icons.setSpin(icon, if rolling then 420 else 60)
	end
end

-- where: 지금 있는 곳 ("Plaza" | "Park"). 버튼은 반대쪽으로 가는 버튼이 됨
function Hud.setLocation(where: string)
	local button = refs.TeleportButton
	if where == "Park" then
		button.SetText("광장")
		button.SetIcon("plaza")
	else
		button.SetText("공원")
		button.SetIcon("park")
	end
end

-- 쿨타임 막대가 비었다가 seconds 동안 가득 참
function Hud.startCooldown(seconds: number)
	local fill = refs.CooldownFill
	fill.Size = UDim2.fromScale(0, 1)
	TweenService:Create(fill, TweenInfo.new(seconds, Enum.EasingStyle.Linear), { Size = UDim2.fromScale(1, 1) }):Play()
end

local function flash(color: Color3, strength: number)
	flashFrame.BackgroundColor3 = color
	flashFrame.BackgroundTransparency = 1 - strength
	TweenService:Create(flashFrame, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		BackgroundTransparency = 1,
	}):Play()
end

-- 화면 전체 번쩍임 (환생 등)
function Hud.flash(color: Color3, strength: number)
	flash(color, strength)
end

-- landed: 결과 지역에 멈췄으면 지역 색 딱지, 아니면 지역 색 글자만
local function showRegion(region: Landmarks.Region, landed: boolean)
	local label = refs.RevealRegion
	label.Text = region.Name
	local skin: ImageLabel? = refs.RegionSkin
	if skin then
		skin.Visible = landed
		skin.ImageColor3 = region.Color
	else
		refs.RegionTag.BackgroundColor3 = region.Color
		refs.RegionTag.BackgroundTransparency = if landed then 0 else 1
		refs.RegionStroke.Enabled = landed
	end
	label.TextColor3 = if landed then WHITE else region.Color
end

local function showBurst(color: Color3)
	for _, ray in refs.Rays do
		ray.BackgroundColor3 = color
	end
	if refs.BurstImage then
		refs.BurstImage.ImageColor3 = color
	end
	refs.Burst.Visible = true
	if not burstTween then
		refs.Burst.Rotation = 0
		local tween = TweenService:Create(
			refs.Burst,
			TweenInfo.new(10, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1),
			{ Rotation = 360 }
		)
		tween:Play()
		burstTween = tween
	end
end

local function hideBurst()
	refs.Burst.Visible = false
	local tween = burstTween
	if tween then
		tween:Cancel()
		burstTween = nil
	end
end

local function showRibbon(tier: Landmarks.Tier)
	Ui.tint(refs.RibbonMain, tier.Color)
	for _, tail in refs.RibbonTails do
		tail.BackgroundColor3 = tier.Color:Lerp(Theme.Ink, 0.35)
	end
	refs.RibbonLabel.Text = tier.Name
	refs.Ribbon.Visible = true
end

-- 굴림 연출. 결과를 보여 줄 때까지 기다립니다(yield).
-- 1) 지구본이 빠르게 돌며 지역 이름이 바뀌다 점점 느려짐 → 2) 결과 지역에 멈춤 → 3) 명소 공개
function Hud.reveal(landmark: Landmarks.Landmark, info: RevealInfo)
	hideToken += 1
	local tier = landmark.Tier
	local rank = tier.Rank
	local duration = REVEAL_SECONDS[rank] or 3
	if info.Fast and rank < 4 then
		duration = math.max(0.35, duration * 0.5)
	end
	local region = Landmarks.RegionById[landmark.Region] or Landmarks.Regions[1]
	local regions = Landmarks.Regions

	local container = refs.Reveal
	container.Visible = true
	refs.RevealScale.Scale = 1
	hideBurst()
	refs.Ribbon.Visible = false
	refs.RevealName.Text = ""
	refs.RevealOdds.Text = ""
	refs.TagRow.Visible = false
	refs.Disc.BackgroundColor3 = Theme.Cream
	refs.ResultView.Visible = false
	Viewport.setSpin(refs.ResultView, 0)
	refs.EarthView.Visible = true

	-- 1) 지구본이 돌며 지역이 바뀜. 실제로 지난 시간을 더해야 연출 길이가 늘어지지 않음
	local index = spinRandom:NextInteger(1, #regions)
	local elapsed = 0
	while elapsed < duration do
		index = index % #regions + 1
		showRegion(regions[index], false)
		play(tickSound)
		local t = elapsed / duration
		Viewport.setSpin(refs.EarthView, 60 + 840 * (1 - t) * (1 - t))
		local interval = 0.05 + t * t * 0.22
		elapsed += task.wait(interval)
	end

	-- 2) 결과 지역에 착지
	showRegion(region, true)
	Viewport.setSpin(refs.EarthView, 30)
	play(landSound)
	task.wait(if info.Fast and rank < 4 then LAND_SECONDS * 0.5 else LAND_SECONDS)

	-- 불가사의 이상은 한 박자 뜸 들이기
	if rank >= 5 then
		refs.RevealName.Text = "? ? ?"
		refs.RevealName.TextColor3 = tier.Color
		showRibbon(tier)
		showBurst(tier.Color)
		flash(BLACK, 0.6)
		task.wait(SUSPENSE_SECONDS)
	end

	-- 3) 결과 공개: 지구본 → 명소 모형
	Viewport.setSpin(refs.EarthView, 0)
	refs.EarthView.Visible = false
	Viewport.setLandmark(refs.ResultView, landmark, 10)
	refs.ResultView.Visible = true
	Viewport.setSpin(refs.ResultView, 40)
	refs.Disc.BackgroundColor3 = tier.Color:Lerp(WHITE, 0.6)
	showBurst(tier.Color)
	showRibbon(tier)

	refs.RevealName.Text = landmark.Name
	refs.RevealName.TextColor3 = tier.Color
	refs.RevealOdds.Text = Format.oneIn(landmark.OneIn)

	local bonus = info.Bonus or 0
	refs.NewChip.Root.Visible = info.IsNew
	refs.StarChip.Root.Visible = info.StarUp
	if info.StarUp then
		local stars = math.clamp(math.floor(info.Stars or 0), 0, #Config.STAR_THRESHOLDS)
		refs.StarChip.Label.Text = string.format("★%d UP", stars)
	end
	refs.BonusPill.Root.Visible = bonus > 0
	if bonus > 0 then
		refs.BonusPill.Label.Text = "+" .. Format.commas(bonus)
	end
	refs.TagRow.Visible = info.IsNew or info.StarUp or bonus > 0

	refs.RevealScale.Scale = 1.35
	TweenService:Create(refs.RevealScale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Scale = 1,
	}):Play()
	if rank >= 4 then
		flash(tier.Color, math.min(0.25 + rank * 0.08, 0.8))
		play(rareSound)
	else
		play(revealSound)
	end

	-- 결과를 잠깐 보여 줌 (자동 굴림 중에도 희귀 명소는 바로 덮이지 않게)
	local hold = if rank >= 4 then (if info.Fast then 1.8 else 0.6) else (if info.Fast then 0.2 else 0.1)
	task.wait(hold)

	local token = hideToken
	task.delay(if info.Fast then 1 else 2.5, function()
		if token == hideToken then
			container.Visible = false
			Viewport.setSpin(refs.ResultView, 0)
			hideBurst()
		end
	end)
end

-- 잠깐 떴다 사라지는 알림: [아이콘][짧은 글자] 색 딱지. color 는 딱지 바탕색, icon 은 Icons 이름
function Hud.toast(text: string, color: Color3?, seconds: number?, icon: string?)
	toastOrder += 1
	while #toasts >= MAX_TOASTS do
		local oldest = table.remove(toasts, 1)
		if oldest then
			oldest:Destroy()
		end
	end

	local chip = Ui.chip({
		Name = "Toast",
		Color = color or Ui.colorPair("Sky").Face,
		Text = text,
		Icon = icon,
		IconSize = 48,
		Height = 40,
		TextSize = 22,
		StrokeThickness = 3,
		LayoutOrder = toastOrder,
		Parent = refs.Notices,
	})
	local box = chip.Root
	table.insert(toasts, box)
	local scale = Ui.new("UIScale", { Scale = 0.4, Parent = box })
	TweenService:Create(scale, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 })
		:Play()

	task.delay(seconds or 3, function()
		if not box.Parent then
			return -- 이미 밀려나서 지워짐
		end
		TweenService:Create(scale, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Scale = 0 })
			:Play()
		task.wait(0.18)
		local index = table.find(toasts, box)
		if index then
			table.remove(toasts, index)
		end
		box:Destroy()
	end)
end

-- 서버 전체 "속보": 신문 띠가 오른쪽에서 밀려 들어와 잠시 머문 뒤 쏙 사라짐
-- [속보 딱지] 이름 · 명소(등급 색) · 1 in N  [주사위 #굴림 수]
function Hud.news(playerName: string, landmark: Landmarks.Landmark, rollNumber: number)
	local tier = landmark.Tier
	newsOrder += 1

	-- 너무 많이 쌓이면 가장 오래된 것부터 지움
	while #newsItems >= MAX_NEWS do
		local oldest = table.remove(newsItems, 1)
		if oldest then
			oldest:Destroy()
		end
	end

	local item = Ui.new("Frame", {
		LayoutOrder = newsOrder,
		Size = UDim2.new(1, 0, 0, 54),
		BackgroundTransparency = 1,
		Parent = refs.News,
	})
	table.insert(newsItems, item)

	local slide = Ui.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(2, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = item,
	})
	local scale = Ui.new("UIScale", { Parent = slide })

	-- 신문 띠: 크림 바탕 + Ink 테두리 + Ink 글자
	local bar = Ui.new("Frame", {
		Position = UDim2.fromOffset(56, 4),
		Size = UDim2.new(1, -56, 1, -8),
		BackgroundColor3 = Theme.Cream,
		ZIndex = 1,
		Parent = slide,
	})
	Ui.corner(10).Parent = bar
	Ui.stroke(Theme.Ink, 3).Parent = bar
	Ui.skin(bar, "panel_paper", { Radius = 10, Height = 46 })
	Ui.label({
		Position = UDim2.fromOffset(66, 5),
		Size = UDim2.new(1, -66 - 130, 1, -10),
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = string.format(
			'%s · <font color="%s">%s</font> · <font color="%s">%s</font>',
			Format.escape(playerName),
			Format.hex(tier.Color:Lerp(Theme.Ink, 0.35)),
			Format.escape(landmark.Name),
			Format.hex(ODDS_COLOR),
			Format.oneIn(landmark.OneIn)
		),
		Parent = bar,
	}, 22)
	Ui.chip({
		Name = "Rolls",
		Color = "Sky",
		Icon = "dice",
		Text = "#" .. Format.commas(rollNumber),
		Height = 28,
		TextSize = 16,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		ZIndex = 2,
		Parent = bar,
	})

	-- 빨간 "속보" 도장 딱지 (살짝 기울임)
	local stamp = Ui.new("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.fromOffset(112, 46),
		BackgroundColor3 = Ui.colorPair("Coral").Face,
		Rotation = -6,
		ZIndex = 2,
		Parent = slide,
	})
	Ui.corner(10).Parent = stamp
	Ui.stroke(Theme.Ink, 3).Parent = stamp
	Ui.skin(stamp, "tag", { Radius = 10, Height = 46, Color = Ui.colorPair("Coral").Face })
	local stampRing = Ui.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -10, 1, -10),
		BackgroundTransparency = 1,
		Parent = stamp,
	})
	Ui.corner(7).Parent = stampRing
	Ui.stroke(WHITE, 2, 0.25).Parent = stampRing
	local stampLabel = Ui.label({
		Position = UDim2.fromOffset(8, 6),
		Size = UDim2.new(1, -16, 1, -12),
		Font = Theme.FontTitle,
		Text = "속보",
		TextColor3 = WHITE,
		ZIndex = 2,
		Parent = stamp,
	}, 26)
	Ui.outline(stampLabel, 2.5)

	play(newsSound)
	TweenService:Create(slide, TweenInfo.new(0.45, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
		Position = UDim2.fromScale(0.5, 0.5),
	}):Play()

	task.delay(NEWS_SECONDS, function()
		if not item.Parent then
			return -- 이미 밀려나서 지워짐
		end
		TweenService:Create(scale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
			Scale = 0,
		}):Play()
		task.wait(0.32)
		local index = table.find(newsItems, item)
		if index then
			table.remove(newsItems, index)
		end
		item:Destroy()
	end)
end

return Hud
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">Icons</string>
            <string name="Source"><![CDATA[-- 아이콘 (이모지 대신). 모든 아이콘은 Icons.view 하나로 그립니다(Ui.icon 도 이걸 부름).
--   Shared/ImageIds 에 그림 Id 가 있으면 ImageLabel(그린 그림), 없으면 기본 파트로 만든 3D 미니 모형(ViewportFrame).
--   Icons.view(parent, "coin", { Size = ..., Position = ..., AnchorPoint = ..., Spin = 60 }) -> Frame(이름 "Icon")
--   Icons.set(icon, "plaza")   -- 이미 만든 아이콘의 그림만 바꿈 (그림 <-> 3D 가 바뀌어도 됨)
--   Icons.setSpin(icon, 420)   -- 회전 속도(초당 도). 그림 아이콘은 빠를 때만 빙글 돌고, 느린 회전은 3D 에만 적용
-- 3D 모형은 이름별로 한 번만 만들어 두고 복제해서 씁니다. 파트 수는 아이콘마다 3~15개 정도로 작게 유지.
-- 아이콘: coin, globe(=roll), passport, album(=collection), hammer, park, plaza, dice, clover(=luck), star,
--   star_empty, news, lock, auto, close, check, arrow_up, plane, ticket, rebirth  (stamp_* 는 그림이 있을 때만 씀)

local RunService = game:GetService("RunService")

local Ui = require(script.Parent.Ui)
local Viewport = require(script.Parent.Viewport)

local Icons = {}

local V = Vector3.new
local rgb = Color3.fromRGB
local Mat = Enum.Material
local PI = math.pi

local UPRIGHT = CFrame.Angles(0, 0, PI / 2) -- 원기둥(길이 축 = X)을 세움
local ALONG_Z = CFrame.Angles(0, PI / 2, 0) -- 원기둥 길이 축을 Z 로 (정면을 보는 원판)
local FACE = CFrame.Angles(0, math.rad(-18), 0) -- 정면(-Z)을 카메라 쪽으로 살짝 돌려 옆면도 보이게

-- 색 (UI 테마와 맞춤)
local GOLD = rgb(255, 206, 64)
local GOLD_DEEP = rgb(222, 150, 24)
local OCEAN = rgb(57, 160, 255)
local LAND = rgb(76, 205, 96)
local SNOW = rgb(250, 252, 255)
local NAVY = rgb(38, 62, 140)
local CREAM = rgb(255, 244, 220)
local SKY = rgb(57, 160, 255)
local CORAL = rgb(255, 94, 91)
local SUN = rgb(255, 197, 61)
local GRAPE = rgb(155, 107, 255)
local GRASS = rgb(96, 196, 90)
local LEAF = rgb(58, 160, 74)
local LEAF_LIGHT = rgb(110, 210, 100)
local WOOD = rgb(150, 98, 58)
local WOOD_DARK = rgb(105, 68, 42)
local IRON = rgb(70, 70, 86)
local STEEL = rgb(160, 166, 184)
local MARBLE = rgb(246, 240, 228)
local MARBLE_SHADE = rgb(214, 204, 186)
local NEWSPRINT = rgb(236, 232, 220)
local INK = rgb(30, 27, 46)
local CLOVER = rgb(70, 190, 90)
local CLOVER_DARK = rgb(40, 140, 64)
local STAR_GRAY = rgb(196, 190, 212)

local function style(part: BasePart, cf: CFrame, size: Vector3, color: Color3, material: Enum.Material?)
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Size = size
	part.CFrame = cf
	part.Color = color
	part.Material = material or Mat.SmoothPlastic
end

local function part(
	model: Model,
	shape: Enum.PartType,
	cf: CFrame,
	size: Vector3,
	color: Color3,
	material: Enum.Material?
): BasePart
	local p = Instance.new("Part")
	p.Shape = shape -- 크기보다 먼저(공 모양은 크기가 균일해짐)
	style(p, cf, size, color, material)
	p.Parent = model
	return p
end

local function block(model: Model, cf: CFrame, size: Vector3, color: Color3, material: Enum.Material?): BasePart
	return part(model, Enum.PartType.Block, cf, size, color, material)
end

local function ball(model: Model, center: Vector3, d: number, color: Color3, material: Enum.Material?): BasePart
	return part(model, Enum.PartType.Ball, CFrame.new(center), V(d, d, d), color, material)
end

-- 길이 축이 cf 의 X 축인 원기둥
local function cyl(
	model: Model,
	cf: CFrame,
	length: number,
	d: number,
	color: Color3,
	material: Enum.Material?
): BasePart
	return part(model, Enum.PartType.Cylinder, cf, V(length, d, d), color, material)
end

local function wedge(model: Model, cf: CFrame, size: Vector3, color: Color3, material: Enum.Material?): BasePart
	local p = Instance.new("WedgePart")
	style(p, cf, size, color, material)
	p.Parent = model
	return p
end

local BUILDERS: { [string]: (Model) -> () } = {}

-- 동전: 모로 선 금화. 가운데 면 + 도드라진 테두리(조각 12개) + 가운데 마름모 문양
function BUILDERS.coin(m)
	local center = FACE * CFrame.new(0, 2.15, 0) * ALONG_Z -- 로컬 X = 동전 두께 방향
	cyl(m, center, 0.56, 4.1, GOLD)
	local pieces = 12
	local outer, width = 2.12, 0.42
	local chord = 2 * outer * math.sin(PI / pieces) + 0.06
	for k = 0, pieces - 1 do
		local cf = center * CFrame.Angles(k * 2 * PI / pieces, 0, 0) * CFrame.new(0, outer - width / 2, 0)
		block(m, cf, V(0.8, width, chord), GOLD_DEEP, Mat.Foil)
	end
	block(m, center * CFrame.Angles(PI / 4, 0, 0), V(0.66, 1.05, 1.05), GOLD_DEEP)
end

-- 지구본: 파란 공 + 튀어나온 초록 대륙 + 북극 얼음
function BUILDERS.globe(m)
	local radius = 2.1
	local center = V(0, radius, 0)
	ball(m, center, radius * 2, OCEAN)
	local function surface(lat: number, lon: number, r: number): Vector3
		local phi, lambda = math.rad(lat), math.rad(lon)
		return center
			+ V(r * math.cos(phi) * math.sin(lambda), r * math.sin(phi), -r * math.cos(phi) * math.cos(lambda))
	end
	local lands = {
		{ 12, 20, 1.9 },
		{ 45, 70, 2 },
		{ -18, 130, 1.5 },
		{ 38, -100, 2 },
		{ -22, -58, 1.6 },
		{ 55, 170, 1.4 },
	}
	for _, land in lands do
		local d = land[3]
		ball(m, surface(land[1], land[2], radius - d / 2 + 0.28), d, LAND)
	end
	ball(m, surface(90, 0, radius - 0.6 + 0.22), 1.2, SNOW)
end

-- 여권: 남색 수첩 + 오른쪽으로 보이는 종이 + 금색 문장
function BUILDERS.passport(m)
	local base = FACE * CFrame.new(0, 2.1, 0) * CFrame.Angles(0, 0, math.rad(-6))
	block(m, base, V(3, 4.2, 0.55), NAVY)
	block(m, base * CFrame.new(0.1, 0, 0), V(2.92, 4, 0.46), CREAM)
	cyl(m, base * CFrame.new(0, 0.5, -0.3) * ALONG_Z, 0.06, 1.5, GOLD)
	block(m, base * CFrame.new(0, -0.8, -0.3), V(1.7, 0.16, 0.06), GOLD)
	block(m, base * CFrame.new(0, -1.15, -0.3), V(1.2, 0.12, 0.06), GOLD)
end

-- 도감(컬렉션): 부채꼴로 펼친 카드 3장 (앞 카드에는 작은 그림)
function BUILDERS.album(m)
	local cards = {
		{ Angle = 20, Z = 0.3, Color = SKY },
		{ Angle = 0, Z = 0, Color = GRAPE },
		{ Angle = -20, Z = -0.3, Color = CORAL },
	}
	local front: CFrame? = nil
	for _, card in cards do
		local cf = FACE * CFrame.new(0, 0.2, card.Z) * CFrame.Angles(0, 0, math.rad(card.Angle)) * CFrame.new(0, 1.7, 0)
		block(m, cf, V(2.3, 3.2, 0.16), card.Color)
		block(m, cf * CFrame.new(0, 0.3, -0.05), V(1.8, 1.9, 0.14), CREAM)
		front = cf
	end
	if front then
		ball(m, (front * CFrame.new(0.45, 0.8, -0.12)).Position, 0.5, SUN)
		block(m, front * CFrame.new(0, -0.35, -0.08), V(1.8, 0.55, 0.16), GRASS)
	end
end

-- 망치(업그레이드): 나무 손잡이 + 빨간 손잡이 끝 + 쇠머리
function BUILDERS.hammer(m)
	local base = FACE * CFrame.new(0, 2.5, 0) * CFrame.Angles(0, 0, math.rad(-35))
	block(m, base * CFrame.new(0, -0.5, 0), V(0.55, 4, 0.55), WOOD)
	block(m, base * CFrame.new(0, -2.1, 0), V(0.68, 1.1, 0.68), CORAL)
	block(m, base * CFrame.new(0, 1.6, 0), V(2.8, 1.1, 1.1), STEEL, Mat.Metal)
	block(m, base * CFrame.new(1.45, 1.6, 0), V(0.3, 1.25, 1.25), IRON, Mat.Metal)
end

-- 공원: 잔디 원판 + 나무 + 벤치
function BUILDERS.park(m)
	cyl(m, CFrame.new(0, 0.2, 0) * UPRIGHT, 0.4, 5.2, GRASS)
	cyl(m, CFrame.new(-0.9, 1.4, 0.5) * UPRIGHT, 2, 0.6, WOOD)
	ball(m, V(-0.9, 3.1, 0.5), 2.6, LEAF)
	ball(m, V(-0.1, 2.5, -0.1), 1.6, LEAF_LIGHT)
	local bench = FACE * CFrame.new(1.05, 0, -0.9)
	block(m, bench * CFrame.new(0, 1, 0), V(1.9, 0.2, 0.7), WOOD_DARK)
	block(m, bench * CFrame.new(0, 1.45, 0.28), V(1.9, 0.5, 0.14), WOOD_DARK)
	block(m, bench * CFrame.new(-0.75, 0.65, 0), V(0.18, 0.5, 0.6), IRON)
	block(m, bench * CFrame.new(0.75, 0.65, 0), V(0.18, 0.5, 0.6), IRON)
end

-- 광장: 고전 기둥 (받침 + 기둥 + 소용돌이 머리)
function BUILDERS.plaza(m)
	local base = FACE
	block(m, base * CFrame.new(0, 0.25, 0), V(2.8, 0.5, 2.8), MARBLE_SHADE)
	block(m, base * CFrame.new(0, 0.65, 0), V(2.3, 0.3, 2.3), MARBLE)
	cyl(m, base * CFrame.new(0, 2.7, 0) * UPRIGHT, 3.8, 1.6, MARBLE)
	block(m, base * CFrame.new(0, 4.75, 0), V(2.2, 0.3, 2.2), MARBLE)
	cyl(m, base * CFrame.new(-1.05, 4.7, 0) * ALONG_Z, 2.2, 0.62, MARBLE_SHADE)
	cyl(m, base * CFrame.new(1.05, 4.7, 0) * ALONG_Z, 2.2, 0.62, MARBLE_SHADE)
	block(m, base * CFrame.new(0, 5.1, 0), V(2.9, 0.4, 2.9), MARBLE_SHADE)
end

-- 삼각형 화살촉: base 좌표계의 XY 평면에서 baseCenter(밑변 가운데)부터 dir 방향으로 length 만큼.
-- 직각 쐐기 두 개를 가운데 줄 양쪽에 붙임(쐐기의 직각 = 밑변 가운데, 세로 변 = dir, 가로 변 = 바깥 → 가운데)
local function arrowhead(
	model: Model,
	base: CFrame,
	baseCenter: Vector3,
	dir: Vector3,
	length: number,
	halfWidth: number,
	thickness: number,
	color: Color3
)
	local u = dir.Unit
	local v = V(-u.Y, u.X, 0)
	for _, side in { 1, -1 } do
		local yAxis = u
		local zAxis = v * -side
		local xAxis = yAxis:Cross(zAxis)
		local position = baseCenter + u * (length / 2) + v * (side * halfWidth / 2)
		wedge(model, base * CFrame.fromMatrix(position, xAxis, yAxis, zAxis), V(thickness, length, halfWidth), color)
	end
end

-- 별: 가운데 원판 + 뾰족한 끝 5개(직각 쐐기 2개씩)
local function buildStar(m: Model, color: Color3)
	local outerRadius, innerRadius, thickness = 2.2, 0.95, 0.7
	local center = FACE * CFrame.new(0, 2.2, 0) -- 별 평면 = 로컬 XY, 두께 = 로컬 Z
	cyl(m, center * ALONG_Z, thickness, innerRadius * 2, color)
	local apothem = innerRadius * math.cos(math.rad(36))
	local halfBase = innerRadius * math.sin(math.rad(36))
	local length = outerRadius - apothem
	for k = 0, 4 do
		local a = math.rad(90 + 72 * k)
		local u = V(math.cos(a), math.sin(a), 0) -- 뾰족한 방향
		local v = V(-math.sin(a), math.cos(a), 0) -- 가로 방향
		local mid = u * apothem -- 끝 밑변의 가운데(직각 꼭짓점)
		for _, side in { 1, -1 } do
			-- 쐐기의 직각 = 밑변 가운데, 세로 변(Y) = 뾰족한 방향, 가로 변(Z) = 바깥 꼭짓점 → 가운데
			local yAxis = u
			local zAxis = v * -side
			local xAxis = yAxis:Cross(zAxis)
			local position = mid + u * (length / 2) + v * (side * halfBase / 2)
			wedge(m, center * CFrame.fromMatrix(position, xAxis, yAxis, zAxis), V(thickness, length, halfBase), color)
		end
	end
end

function BUILDERS.star(m)
	buildStar(m, SUN)
end

-- 빈 별(아직 못 딴 별): 흐린 회색 별
function BUILDERS.star_empty(m)
	buildStar(m, STAR_GRAY)
end

-- 행운: 네잎클로버 (잎 원판 4장 + 가운데 + 줄기)
function BUILDERS.clover(m)
	local center = FACE * CFrame.new(0, 2.7, 0)
	for _, offset in { { -0.72, 0.72 }, { 0.72, 0.72 }, { -0.72, -0.72 }, { 0.72, -0.72 } } do
		cyl(m, center * CFrame.new(offset[1], offset[2], 0) * ALONG_Z, 0.35, 1.8, CLOVER)
	end
	ball(m, (center * CFrame.new(0, 0, -0.05)).Position, 0.75, CLOVER_DARK)
	block(m, center * CFrame.new(0.3, -1.75, 0) * CFrame.Angles(0, 0, math.rad(-12)), V(0.26, 2.1, 0.26), CLOVER_DARK)
end

-- 속보: 둘둘 만 신문 (빨간 띠 2개 + 앞쪽에 제목 줄)
function BUILDERS.news(m)
	local base = FACE * CFrame.new(0, 0.9, 0) * CFrame.Angles(0, 0, math.rad(8))
	cyl(m, base, 4.4, 1.6, NEWSPRINT)
	cyl(m, base * CFrame.new(-1.25, 0, 0), 0.3, 1.66, CORAL)
	cyl(m, base * CFrame.new(1.25, 0, 0), 0.3, 1.66, CORAL)
	block(m, base * CFrame.new(0, -0.15, -0.78), V(3.3, 0.95, 0.06), CREAM)
	block(m, base * CFrame.new(-0.35, 0.1, -0.82), V(1.8, 0.18, 0.04), INK)
	block(m, base * CFrame.new(-0.55, -0.25, -0.82), V(1.4, 0.1, 0.04), MARBLE_SHADE)
end

-- 비행기(여행사): 흰 동체 + 파란 날개 + 빨간 꼬리
function BUILDERS.plane(m)
	local base = FACE * CFrame.new(0, 1.4, 0) * CFrame.Angles(0, 0, math.rad(14)) -- 코(+X)가 살짝 위로
	cyl(m, base, 4.2, 0.95, SNOW)
	ball(m, (base * CFrame.new(2.1, 0, 0)).Position, 0.95, SNOW)
	block(m, base * CFrame.new(1.55, 0.3, 0), V(0.6, 0.3, 0.72), NAVY)
	block(m, base * CFrame.new(0.2, -0.1, 0), V(1.2, 0.14, 4.6), SKY)
	block(m, base * CFrame.new(-1.8, 0.75, 0), V(0.8, 1.2, 0.14), CORAL)
	block(m, base * CFrame.new(-1.8, 0.1, 0), V(0.6, 0.12, 1.8), SKY)
end

-- 입장권: 빨간 표 + 떼는 부분 + 가운데 크림 띠
function BUILDERS.ticket(m)
	local base = FACE * CFrame.new(0, 1.6, 0) * CFrame.Angles(0, 0, math.rad(12))
	block(m, base * CFrame.new(-0.45, 0, 0), V(2.9, 1.9, 0.18), CORAL)
	block(m, base * CFrame.new(1.55, 0, 0), V(0.95, 1.9, 0.18), SUN)
	block(m, base * CFrame.new(-0.45, 0, -0.04), V(2.1, 0.55, 0.16), CREAM)
end

-- 주사위(굴림 수): 흰 주사위, 앞 5 · 오른쪽 3 · 위 1(빨강). 앞과 오른쪽 면이 고루 보이게 조금 돌림
function BUILDERS.dice(m)
	local size = 3.4
	local h = size / 2
	local q = size * 0.26
	local pip = 0.74
	local center = CFrame.new(0, h, 0) * CFrame.Angles(0, math.rad(10), 0)
	block(m, center, V(size, size, size), SNOW)
	for _, p in { { -q, q }, { q, q }, { 0, 0 }, { -q, -q }, { q, -q } } do
		ball(m, (center * CFrame.new(p[1], p[2], -h)).Position, pip, INK)
	end
	for _, p in { { q, q }, { 0, 0 }, { -q, -q } } do
		ball(m, (center * CFrame.new(h, p[2], p[1])).Position, pip, INK)
	end
	ball(m, (center * CFrame.new(0, h, 0)).Position, pip * 1.3, CORAL)
end

-- 자물쇠: 금색 몸통 + 반원 쇠고리 + 열쇠 구멍
function BUILDERS.lock(m)
	local base = FACE
	block(m, base * CFrame.new(0, 1.3, 0), V(3.2, 2.6, 1.2), SUN)
	local radius, pieces = 1.05, 7
	local chord = 2 * radius * math.sin(PI / (2 * (pieces - 1))) + 0.1
	local arch = base * CFrame.new(0, 3.1, 0)
	for k = 0, pieces - 1 do
		local angle = k * PI / (pieces - 1)
		block(m, arch * CFrame.Angles(0, 0, angle) * CFrame.new(radius, 0, 0), V(0.5, chord, 0.5), STEEL, Mat.Metal)
	end
	for _, side in { -1, 1 } do
		block(m, base * CFrame.new(side * radius, 2.8, 0), V(0.5, 0.7, 0.5), STEEL, Mat.Metal)
	end
	cyl(m, base * CFrame.new(0, 1.55, -0.6) * ALONG_Z, 0.1, 0.62, INK)
	block(m, base * CFrame.new(0, 1.05, -0.6), V(0.28, 0.75, 0.1), INK)
end

-- 두 점을 잇는 굵은 막대 (base 좌표계의 XY 평면). 양 끝을 조금 늘려서 이음매가 비지 않게
local function bar(m: Model, base: CFrame, a: Vector3, b: Vector3, width: number, color: Color3)
	local d = b - a
	local angle = math.atan2(d.Y, d.X)
	block(m, base * CFrame.new((a + b) / 2) * CFrame.Angles(0, 0, angle), V(d.Magnitude + width, width, 0.8), color)
end

-- 체크: 초록 V 표시
function BUILDERS.check(m)
	local base = FACE * CFrame.new(0, 2.1, 0)
	bar(m, base, V(-1.7, 0.1, 0), V(-0.55, -1.05, 0), 0.95, GRASS)
	bar(m, base, V(-0.55, -1.05, 0), V(1.8, 1.45, 0), 0.95, GRASS)
end

-- 닫기/실패: 흰 X (빨간 바탕 위에 올라감)
function BUILDERS.close(m)
	local base = FACE * CFrame.new(0, 2, 0)
	bar(m, base, V(-1.4, -1.4, 0), V(1.4, 1.4, 0), 1, SNOW)
	bar(m, base, V(-1.4, 1.4, 0), V(1.4, -1.4, 0), 1, SNOW)
end

-- 위 화살표(수입·강화): 초록 기둥 + 화살촉
function BUILDERS.arrow_up(m)
	local base = FACE
	block(m, base * CFrame.new(0, 1.2, 0), V(1.2, 2.4, 0.8), GRASS)
	arrowhead(m, base, V(0, 2.3, 0), V(0, 1, 0), 2, 1.6, 0.8, GRASS)
end

-- 자동: 한 바퀴 도는 화살표(고리 조각 9개 + 화살촉). 오른쪽 위가 비어 있고 화살촉이 그쪽을 가리킴
function BUILDERS.auto(m)
	local center = FACE * CFrame.new(0, 2.3, 0)
	local radius, width, thickness = 1.65, 0.62, 0.7
	local pieces = 12
	local step = 2 * PI / pieces
	local chord = 2 * radius * math.sin(PI / pieces) + 0.08
	local start = math.rad(120)
	for k = 0, 8 do
		local cf = center * CFrame.Angles(0, 0, start + k * step) * CFrame.new(radius, 0, 0)
		block(m, cf, V(width, chord, thickness), SNOW)
	end
	local finish = start + 8 * step + step / 2
	local at = V(math.cos(finish), math.sin(finish), 0) * radius
	arrowhead(m, center, at, V(-math.sin(finish), math.cos(finish), 0), 1.3, 0.95, thickness, SNOW)
end

-- 환생: 금색 화살표 두 개가 원을 그리며 돎 + 가운데 초록 위 화살표 (파트 15개)
-- (ImageIds 에 "rebirth" 그림을 넣으면 그 그림을 씀)
function BUILDERS.rebirth(m)
	local center = FACE * CFrame.new(0, 2.3, 0)
	local radius, width, thickness = 1.9, 0.6, 0.7
	local step = 2 * PI / 12
	local chord = 2 * radius * math.sin(step / 2) + 0.08
	for _, start in { math.rad(100), math.rad(280) } do
		for k = 0, 3 do
			local cf = center * CFrame.Angles(0, 0, start + k * step) * CFrame.new(radius, 0, 0)
			block(m, cf, V(width, chord, thickness), SUN)
		end
		local finish = start + 3.5 * step
		local at = V(math.cos(finish), math.sin(finish), 0) * radius
		arrowhead(m, center, at, V(-math.sin(finish), math.cos(finish), 0), 1.1, 0.85, thickness, SUN)
	end
	block(m, center * CFrame.new(0, -0.45, 0), V(0.55, 0.9, 0.6), GRASS)
	arrowhead(m, center, V(0, 0, 0), V(0, 1, 0), 0.9, 0.75, 0.6, GRASS)
end

-- 예전 이름 -> 지금 이름 (ImageIds 와 같은 이름을 씀)
local ALIASES = {
	roll = "globe",
	collection = "album",
	luck = "clover",
}

-- 모든 파트를 옮겨서 경계 상자의 바닥 중앙이 원점에 오게 함 (Viewport 는 원점 기준으로 틀을 잡고 돌림)
local function recenter(model: Model)
	local minX, minY, minZ = math.huge, math.huge, math.huge
	local maxX, maxY, maxZ = -math.huge, -math.huge, -math.huge
	local parts = {}
	for _, child in model:GetChildren() do
		if child:IsA("BasePart") then
			table.insert(parts, child)
			local cf = child.CFrame
			local half = child.Size / 2
			local right, up, look = cf.RightVector, cf.UpVector, cf.LookVector
			local ex = math.abs(right.X) * half.X + math.abs(up.X) * half.Y + math.abs(look.X) * half.Z
			local ey = math.abs(right.Y) * half.X + math.abs(up.Y) * half.Y + math.abs(look.Y) * half.Z
			local ez = math.abs(right.Z) * half.X + math.abs(up.Z) * half.Y + math.abs(look.Z) * half.Z
			local p = cf.Position
			minX, maxX = math.min(minX, p.X - ex), math.max(maxX, p.X + ex)
			minY, maxY = math.min(minY, p.Y - ey), math.max(maxY, p.Y + ey)
			minZ, maxZ = math.min(minZ, p.Z - ez), math.max(maxZ, p.Z + ez)
		end
	end
	if #parts == 0 then
		return
	end
	local shift = V(-(minX + maxX) / 2, -minY, -(minZ + maxZ) / 2)
	for _, p in parts do
		p.CFrame += shift
	end
end

local templates: { [string]: Model } = {}

local function template(key: string): Model
	local cached = templates[key]
	if cached then
		return cached
	end
	local builder = BUILDERS[key]
	if not builder then
		warn("[LandmarkRNG] 모르는 아이콘: " .. tostring(key))
		key = "star"
		builder = BUILDERS.star
		if templates.star then
			return templates.star
		end
	end

	local model = Instance.new("Model")
	model.Name = "Icon_" .. key
	builder(model)
	recenter(model)

	-- 피벗 = 바닥 중앙(원점). Viewport.setModel 이 이 피벗을 돌림
	local root = Instance.new("Part")
	root.Name = "Root"
	style(root, CFrame.new(), V(0.05, 0.05, 0.05), INK)
	root.Transparency = 1
	root.Parent = model
	model.PrimaryPart = root

	templates[key] = model
	return model
end

-- 업그레이드 Id -> 아이콘 이름 (업그레이드 창, 구매 알림에서 같이 씀)
Icons.UPGRADE = {
	Globe = "globe",
	Agency = "plane",
	Park = "park",
	Ticket = "ticket",
} :: { [string]: string }

-- 그림 아이콘은 이 속도(초당 도) 이상일 때만 돌림. 천천히 도는 건 3D 모형에만 어울림
local FAST_SPIN = 180
local WHITE = Color3.new(1, 1, 1)

local imageSpins: { [ImageLabel]: number } = {}
local imageSpinConnection: RBXScriptConnection? = nil

local function stepImages(dt: number)
	for image, speed in imageSpins do
		if not image.Parent then
			imageSpins[image] = nil -- Destroy 된 아이콘
			continue
		end
		image.Rotation = (image.Rotation + speed * dt) % 360
	end
end

-- 그림 Id (없으면 nil). 예전 이름도 받아 줌
function Icons.imageId(name: string): string?
	return Ui.imageId(ALIASES[name] or name)
end

local function applySpin(icon: Frame)
	local value = icon:GetAttribute("Spin")
	local speed = if type(value) == "number" then value else 0
	local content = icon:FindFirstChild("Content")
	if not content then
		return
	end
	if content:IsA("ViewportFrame") then
		Viewport.setSpin(content, speed)
	elseif content:IsA("ImageLabel") then
		if math.abs(speed) >= FAST_SPIN then
			imageSpins[content] = speed
			if not imageSpinConnection then
				imageSpinConnection = RunService.RenderStepped:Connect(stepImages)
			end
		else
			imageSpins[content] = nil
			content.Rotation = 0
		end
	end
end

-- 색/투명도: 그림(ImageLabel)과 3D 화면(ViewportFrame) 둘 다 ImageColor3 / ImageTransparency 가 있음
local function applyLook(icon: Frame)
	local content = icon:FindFirstChild("Content")
	if content and (content:IsA("ImageLabel") or content:IsA("ViewportFrame")) then
		local color = icon:GetAttribute("Color")
		local transparency = icon:GetAttribute("Transparency")
		content.ImageColor3 = if typeof(color) == "Color3" then color else WHITE
		content.ImageTransparency = if type(transparency) == "number" then transparency else 0
	end
end

-- 이미 있는 아이콘의 그림을 바꿈. 그림이 있으면 ImageLabel, 없으면 3D 모형 (종류가 바뀌면 속을 새로 만듦)
function Icons.set(icon: Frame, name: string)
	local key = ALIASES[name] or name
	local id = Ui.imageId(key)
	local content = icon:FindFirstChild("Content")
	if id then
		local image: ImageLabel
		if content and content:IsA("ImageLabel") then
			image = content
		else
			if content then
				content:Destroy()
			end
			image = Ui.new("ImageLabel", {
				Name = "Content",
				BackgroundTransparency = 1,
				Size = UDim2.fromScale(1, 1),
				ScaleType = Enum.ScaleType.Fit,
				ZIndex = icon.ZIndex,
				Parent = icon,
			})
		end
		image.Image = id
	else
		local vf: ViewportFrame
		if content and content:IsA("ViewportFrame") then
			vf = content
		else
			if content then
				content:Destroy()
			end
			vf = Viewport.new(icon, {
				Name = "Content",
				ZIndex = icon.ZIndex,
				Ambient = rgb(196, 194, 208),
			})
		end
		Viewport.setModel(vf, template(key):Clone())
	end
	icon:SetAttribute("Icon", key)
	applyLook(icon)
	applySpin(icon)
end

-- 새 아이콘. props: { Size, Position, AnchorPoint, ZIndex, LayoutOrder, Rotation, Spin(초당 회전 각도),
--   Color?(ImageColor3), Transparency? }. 반환: 투명한 Frame(이름 "Icon") — 속은 그림 또는 3D 화면
function Icons.view(parent: Instance?, name: string, props: { [string]: any }?): Frame
	local options = props or {}
	local icon = Ui.new("Frame", {
		Name = "Icon",
		BackgroundTransparency = 1,
		Size = options.Size or UDim2.fromScale(1, 1),
		Position = options.Position or UDim2.new(),
		AnchorPoint = options.AnchorPoint or Vector2.new(0, 0),
		ZIndex = options.ZIndex or 1,
		LayoutOrder = options.LayoutOrder or 0,
		Rotation = options.Rotation or 0,
	})
	if type(options.Spin) == "number" then
		icon:SetAttribute("Spin", options.Spin)
	end
	if typeof(options.Color) == "Color3" then
		icon:SetAttribute("Color", options.Color)
	end
	if type(options.Transparency) == "number" then
		icon:SetAttribute("Transparency", options.Transparency)
	end
	Icons.set(icon, name)
	icon.Parent = parent
	return icon
end

-- 회전 속도 바꾸기 (0 이면 멈춤)
function Icons.setSpin(icon: Frame, degreesPerSecond: number)
	icon:SetAttribute("Spin", degreesPerSecond)
	applySpin(icon)
end

-- 흐리게/진하게 (0 = 진하게, 1 = 안 보임)
function Icons.setTransparency(icon: Frame, transparency: number)
	icon:SetAttribute("Transparency", transparency)
	applyLook(icon)
end

-- 물들이기 (흰색 = 원래 색)
function Icons.setColor(icon: Frame, color: Color3)
	icon:SetAttribute("Color", color)
	applyLook(icon)
end

return Icons
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">Panels</string>
            <string name="Source"><![CDATA[-- 메뉴 창: 도감(대표 지정), 여권(지역별 발견 현황 + 도장), 강화(업그레이드), 환생(조건 + 확인), 상점(Robux)
-- 크림색 창(Ui.window) 하나를 쓰고, 화면마다 리본 색과 제목(2글자)만 바꿉니다.
-- 글자는 최소로: 설명 문장 없이 아이콘 + 숫자 딱지로 보여 줍니다.
-- 화면마다 카드를 한 번 만들고 상태가 바뀌면 글자/색만 고칩니다. 썸네일(ViewportFrame)은
-- 새로 발견했을 때만 만들어서, 자동 굴림 중에 창을 열어 둬도 매번 다시 만들지 않습니다.

local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Landmarks = require(Shared.Landmarks)
local PlayerState = require(Shared.PlayerState)

local Icons = require(script.Parent.Icons)
local Perks = require(script.Parent.Perks)
local Ui = require(script.Parent.Ui)
local Viewport = require(script.Parent.Viewport)
local Theme = Ui.Theme

type Landmark = Landmarks.Landmark
type Snapshot = PlayerState.Snapshot

export type Handlers = {
	Feature: (string?) -> (),
	Buy: (string) -> (),
	ToggleAutoFeature: () -> (),
	Rebirth: () -> (), -- 확인까지 누른 뒤에만 부름
	BuyPass: (string) -> (), -- Config.GamePasses 키
	BuyProduct: (string) -> (), -- Config.Products 키
	Toast: (text: string, icon: string?) -> (), -- 짧은 실패 알림 (예: "코인 부족")
}

local REGION_BONUS = math.floor(Config.REGION_LUCK_BONUS * 100 + 0.5)

local HEADER_HEIGHT = 50 -- 창 본문 맨 위 딱지 줄 높이
local VIEWS = {
	Collection = { Title = "도감", Color = "Sky", Top = HEADER_HEIGHT },
	Passport = { Title = "여권", Color = "Grape", Top = HEADER_HEIGHT },
	Upgrade = { Title = "강화", Color = "Sun", Top = 4 },
	Rebirth = { Title = "환생", Color = "Coral", Top = HEADER_HEIGHT },
	Shop = { Title = "상점", Color = "Sun", Top = 4 },
}

local WHITE = Color3.new(1, 1, 1)
local FEATURED_BG = Color3.fromRGB(255, 218, 128)
local DIM_CHIP = Color3.fromRGB(172, 170, 190) -- 아직 못 받은 보너스 딱지

local WINDOW_SIZE = Vector2.new(760, 500)
local OPEN_OFFSET = -30 -- 창을 화면 가운데보다 조금 위로 (아래쪽 굴리기 버튼을 가리지 않게)
-- 스크롤 영역 안쪽 여백(오른쪽은 스크롤바 자리)
local PAD_X, PAD_RIGHT, PAD_Y = 6, 14, 6

local COLLECTION_CELL = Vector2.new(128, 184)
local COLLECTION_GAP = 12
local COLLECTION_COLUMNS = 5

local PASSPORT_CELL = Vector2.new(104, 124)
local PASSPORT_GAP = 8
local PASSPORT_COLUMNS = 6
local PASSPORT_HEADER = 98
local SECTION_PAD = 14
local SECTION_GAP = 16

local UPGRADE_ROW = 80
local UPGRADE_GAP = 10

local REBIRTH_COLUMNS = 6 -- 요구 명소 카드(여권 카드와 같은 크기)
local REBIRTH_FOOTER = 104 -- 창 아래 고정 줄: 보상 · 경고 · 환생 버튼
local COIN_BAR = Vector2.new(380, 40)
local CONFIRM_SECONDS = 3

local SHOP_CELL = Vector2.new(216, 196)
local SHOP_GAP = 12
local SHOP_COLUMNS = 3
local SHOP_BAND = 74
local BUY_COOLDOWN = 1

local Panels = {}

local win: Ui.Window
local window: Frame
local body: Frame
local loadingLabel: TextLabel
local handlers: Handlers
local openName: string? = nil
local lastState: Snapshot? = nil
local lastCoins = 0

type View = { Scroller: ScrollingFrame, Header: Frame, Extra: GuiObject? }
local views: { [string]: View } = {}

-- 도감 머리 줄
local collectionCount: Ui.Chip
local autoButton: Ui.ChunkyButton
local autoBadge: Ui.Chip
local emptyIcon: Frame

type CollectionCard = {
	Card: TextButton,
	Photo: Frame,
	Stars: TextLabel,
	Count: Ui.Chip,
	Shown: Ui.Chip?, -- 공원 전시 표시(처음 필요할 때 만듦)
	Dim: Frame?, -- 예전에 발견했지만 지금은 없음(환생 후): 사진을 어둡게 (처음 필요할 때 만듦)
	Badge: Ui.Chip,
}
local collectionCards: { [string]: CollectionCard } = {}

-- 여권 머리 줄
local stampCount: Ui.Chip
local stampBonus: Ui.Chip

type Stamp = {
	Frame: Frame,
	Stroke: UIStroke,
	RingStroke: UIStroke,
	Labels: { TextLabel },
	Outlines: { UIStroke },
	Art: Frame?, -- 도장 그림 아이콘(그림이 있을 때)
	Color: Color3,
}
type PassportSection = { Title: TextLabel, Fill: Frame, Bonus: Ui.Chip, Stamp: Stamp, Grid: Frame }
local passportSections: { [string]: PassportSection } = {}
local passportCards: { [string]: { Card: Frame, Known: boolean } } = {}

type UpgradeRow = {
	Level: Ui.Chip,
	Value: Ui.Chip,
	Step: Ui.Chip,
	Button: Ui.ChunkyButton,
	Price: number?,
}
local upgradeRows: { [string]: UpgradeRow } = {}

-- 환생
local rebirthCount: Ui.Chip
local rebirthLuck: Ui.Chip
local rebirthIncome: Ui.Chip
local rebirthSection: Frame
local rebirthGrid: Frame
local rebirthCoinFill: Frame
local rebirthCoinText: TextLabel
local rebirthCoinCheck: Frame
local rebirthWarning: Ui.Chip
local rebirthButton: Ui.ChunkyButton? = nil
local rebirthCards: { [string]: { Card: Frame, Look: string } } = {}
local confirmUntil = 0 -- 이 시각(os.clock)까지 한 번 더 누르면 환생
local confirmToken = 0
local rebirthLook = ""

-- 상점
type ShopCard = { Item: Perks.Item, Button: Ui.ChunkyButton, Effect: Ui.Chip, Owned: Ui.Chip? }
local shopCards: { ShopCard } = {}

local function owned(state: Snapshot, id: string): number
	return state.Inventory[id] or 0
end

local function gridHeight(count: number, columns: number, cellHeight: number, gap: number): number
	local rows = math.ceil(count / columns)
	if rows <= 0 then
		return 0
	end
	return rows * (cellHeight + gap) - gap
end

local function newScroller(name: string, top: number): ScrollingFrame
	local scroller = Ui.new("ScrollingFrame", {
		Name = name,
		Position = UDim2.fromOffset(0, top),
		Size = UDim2.new(1, 0, 1, -top),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = Theme.Ink,
		ScrollBarImageTransparency = 0.35,
		CanvasSize = UDim2.new(),
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Visible = false,
		Parent = body,
	})
	Ui.new("UIPadding", {
		PaddingLeft = UDim.new(0, PAD_X),
		PaddingRight = UDim.new(0, PAD_RIGHT),
		PaddingTop = UDim.new(0, PAD_Y),
		PaddingBottom = UDim.new(0, PAD_Y),
		Parent = scroller,
	})
	return scroller
end

-- 창 본문 맨 위 딱지 줄 (화면마다 하나)
local function newHeader(name: string): Frame
	return Ui.new("Frame", {
		Name = name .. "Header",
		Size = UDim2.new(1, 0, 0, HEADER_HEIGHT),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = body,
	})
end

-- 머리 줄의 아이콘 + 숫자 딱지
local function headerChip(parent: Instance, icon: string, color: any, order: number): Ui.Chip
	return Ui.chip({
		Color = color,
		Icon = icon,
		IconSize = 44,
		Height = 34,
		TextSize = 21,
		LayoutOrder = order,
		Parent = parent,
	})
end

local function chipRow(parent: Instance): Frame
	local row = Ui.new("Frame", {
		Name = "Chips",
		Position = UDim2.fromOffset(10, 0),
		Size = UDim2.new(1, -200, 1, -6),
		BackgroundTransparency = 1,
		Parent = parent,
	})
	Ui.list(Enum.FillDirection.Horizontal, 14).Parent = row
	return row
end

local function setCanvasHeight(scroller: ScrollingFrame, contentHeight: number)
	scroller.CanvasSize = UDim2.fromOffset(0, contentHeight + PAD_Y * 2)
end

-- 명소 썸네일을 담는 "사진 칸" (등급 색을 옅게 깐 바탕)
local function photo(parent: GuiObject, landmark: Landmark, position: UDim2, size: UDim2, radius: number): Frame
	local frame = Ui.new("Frame", {
		Name = "Photo",
		Position = position,
		Size = size,
		BackgroundColor3 = landmark.Tier.Color:Lerp(WHITE, 0.62),
		Parent = parent,
	})
	Ui.corner(radius).Parent = frame
	Ui.stroke(Theme.Ink, 2).Parent = frame
	Viewport.thumbnail(frame, landmark, {
		Position = UDim2.fromOffset(2, 2),
		Size = UDim2.new(1, -4, 1, -4),
	})
	return frame
end

-- 도감 -----------------------------------------------------------------------

local function buildCollection(): View
	local header = newHeader("Collection")
	local chips = chipRow(header)
	collectionCount = headerChip(chips, "album", Theme.Ink, 1)

	-- 자동 대표 지정: 별 아이콘 + "자동" (켜짐 = 초록 + ON 딱지, 꺼짐 = 회색)
	autoButton = Ui.chunkyButton({
		Name = "AutoFeature",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -8, 0, -4),
		Size = UDim2.fromOffset(136, 50),
		Color = "Gray",
		Icon = "star",
		IconSize = 36,
		Text = "자동",
		TextSize = 22,
		Parent = header,
	})
	autoButton.Activated:Connect(function()
		handlers.ToggleAutoFeature()
	end)
	autoBadge = Ui.chip({
		Name = "On",
		Color = "Coral",
		Text = "ON",
		Height = 22,
		TextSize = 15,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -8, 0, 2),
		Rotation = 12,
		ZIndex = 6,
		Visible = false,
		Parent = autoButton.Face,
	})

	-- 아직 아무것도 없을 때: 가운데에 천천히 도는 지구본
	emptyIcon = Icons.view(body, "globe", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, HEADER_HEIGHT / 2),
		Size = UDim2.fromOffset(150, 150),
		Spin = 40,
		Transparency = 0.2,
	})
	emptyIcon.Visible = false

	local scroller = newScroller("Collection", VIEWS.Collection.Top)
	Ui.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(COLLECTION_CELL.X, COLLECTION_CELL.Y),
		CellPadding = UDim2.fromOffset(COLLECTION_GAP, COLLECTION_GAP),
		FillDirectionMaxCells = COLLECTION_COLUMNS,
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Parent = scroller,
	})
	return { Scroller = scroller, Header = header }
end

local function collectionCard(parent: ScrollingFrame, landmark: Landmark): CollectionCard
	local tier = landmark.Tier
	local card = Ui.new("TextButton", {
		Name = landmark.Id,
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = Theme.Paper,
	})
	Ui.corner(12).Parent = card
	Ui.stroke(Theme.Ink, 3).Parent = card

	-- 등급 색 띠 + 확률 (위쪽 모서리만 둥글게: 아래 절반을 네모 판으로 덮음)
	local band = Ui.new("Frame", {
		Name = "Band",
		Size = UDim2.new(1, 0, 0, 26),
		BackgroundColor3 = tier.Color,
		BorderSizePixel = 0,
		Parent = card,
	})
	Ui.corner(12).Parent = band
	Ui.new("Frame", {
		Position = UDim2.new(0, 0, 1, -12),
		Size = UDim2.new(1, 0, 0, 12),
		BackgroundColor3 = tier.Color,
		BorderSizePixel = 0,
		Parent = band,
	})
	Ui.new("Frame", {
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 3),
		BackgroundColor3 = Theme.Ink,
		BorderSizePixel = 0,
		Parent = band,
	})
	local bandLabel = Ui.label({
		Position = UDim2.fromOffset(8, 4),
		Size = UDim2.new(1, -16, 1, -7),
		Text = Format.oneIn(landmark.OneIn),
		TextColor3 = WHITE,
		ZIndex = 2,
		Parent = band,
	}, 15)
	Ui.outline(bandLabel, 1.5)

	local picture = photo(card, landmark, UDim2.fromOffset(7, 33), UDim2.new(1, -14, 0, 84), 8)

	Ui.label({
		Position = UDim2.fromOffset(6, 122),
		Size = UDim2.new(1, -12, 0, 24),
		Text = landmark.Name,
		Parent = card,
	}, 19)
	local stars = Ui.label({
		Position = UDim2.fromOffset(6, 149),
		Size = UDim2.new(1, -12, 0, 24),
		Parent = card,
	}, 22)
	Ui.outline(stars, 2)

	local count = Ui.chip({
		Name = "Count",
		Color = Theme.Ink,
		Height = 22,
		TextSize = 14,
		StrokeThickness = 2,
		Outline = false,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -3, 0, 29),
		ZIndex = 3,
		Parent = card,
	})
	-- "대표" 도장 (왼쪽 위, 기울임)
	local badge = Ui.chip({
		Name = "Featured",
		Color = "Coral",
		Text = "대표",
		Height = 28,
		TextSize = 17,
		CornerRadius = 7,
		Rotation = -14,
		Position = UDim2.fromOffset(-8, 22),
		ZIndex = 4,
		Visible = false,
		Parent = card,
	})

	local hover = Ui.new("UIScale", { Parent = card })
	card.MouseEnter:Connect(function()
		hover.Scale = 1.04
	end)
	card.MouseLeave:Connect(function()
		hover.Scale = 1
	end)
	card.Activated:Connect(function()
		local state = lastState
		local featured = state ~= nil and state.Featured == landmark.Id
		if not featured and (not state or owned(state, landmark.Id) <= 0) then
			return -- 지금 없는 명소(환생 전에 발견)는 대표로 못 씀
		end
		handlers.Feature(if featured then nil else landmark.Id)
	end)

	card.Parent = parent
	return { Card = card, Photo = picture, Stars = stars, Count = count, Shown = nil, Dim = nil, Badge = badge }
end

-- 지금은 없는 명소: 사진 위에 어두운 막 (처음 필요할 때 만듦)
local function setDim(entry: CollectionCard, dim: boolean)
	local shade = entry.Dim
	if not shade then
		if not dim then
			return
		end
		shade = Ui.new("Frame", {
			Name = "Dim",
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Theme.Ink,
			BackgroundTransparency = 0.45,
			ZIndex = 2,
			Parent = entry.Photo,
		})
		Ui.corner(8).Parent = shade
		entry.Dim = shade
	end
	(shade :: Frame).Visible = dim
end

-- 공원에 전시 중: 사진 왼쪽 아래 초록 공원 아이콘 딱지 (처음 필요할 때 만듦)
local function setShown(entry: CollectionCard, shown: boolean)
	local chip = entry.Shown
	if not chip then
		if not shown then
			return
		end
		chip = Ui.chip({
			Name = "Shown",
			Color = "Grass",
			Icon = "park",
			IconOnly = true,
			IconSize = 30,
			Height = 24,
			StrokeThickness = 2,
			Position = UDim2.fromOffset(3, 94),
			ZIndex = 3,
			Parent = entry.Card,
		})
		entry.Shown = chip
	end
	(chip :: Ui.Chip).Root.Visible = shown
end

local function renderCollection(state: Snapshot)
	local scroller = views.Collection.Scroller
	local autoFeature = state.Settings.AutoFeature
	autoButton.SetColor(if autoFeature then "Grass" else "Gray")
	autoBadge.Root.Visible = autoFeature

	local inPark = {}
	for _, id in PlayerState.park(state) do
		inPark[id] = true
	end

	-- 도감은 역대 발견(Discovered) 기준. 별·개수·전시는 지금 보유(Inventory) 기준
	local shown = 0
	for _, landmark in Landmarks.RarestFirst do
		local count = owned(state, landmark.Id)
		local entry = collectionCards[landmark.Id]
		if Perks.discovered(state, landmark.Id) then
			shown += 1
			if not entry then
				entry = collectionCard(scroller, landmark)
				collectionCards[landmark.Id] = entry
			end
			local featured = state.Featured == landmark.Id
			entry.Card.LayoutOrder = shown
			entry.Card.BackgroundColor3 = if featured then FEATURED_BG else Theme.Paper
			entry.Badge.Root.Visible = featured
			entry.Stars.Text = Ui.starsRich(PlayerState.stars(count), #Config.STAR_THRESHOLDS)
			entry.Count.Label.Text = "×" .. Format.commas(count)
			entry.Count.Root.Visible = count > 0
			setShown(entry, inPark[landmark.Id] == true)
			setDim(entry, count <= 0)
		elseif entry then
			entry.Card:Destroy()
			collectionCards[landmark.Id] = nil
		end
	end

	collectionCount.Label.Text = string.format("%d/%d", shown, #Landmarks.List)
	emptyIcon.Visible = shown == 0
	setCanvasHeight(scroller, gridHeight(shown, COLLECTION_COLUMNS, COLLECTION_CELL.Y, COLLECTION_GAP))
end

-- 여권 -----------------------------------------------------------------------

-- 지역 도장: 그림(ImageIds.stamp_<지역>)이 있으면 그 그림, 없으면 지역 색 동그라미(기울임) + 흰 고리 + 지역 이름
local function makeStamp(parent: Frame, region: Landmarks.Region): Stamp
	local frame = Ui.new("Frame", {
		Name = "Stamp",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -18, 0, 6),
		Size = UDim2.fromOffset(88, 88),
		BackgroundColor3 = region.Color,
		Rotation = -12,
		ZIndex = 2,
		Parent = parent,
	})
	Ui.round().Parent = frame
	local stroke = Ui.stroke(Theme.Ink, 3)
	stroke.Parent = frame
	local ring = Ui.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -14, 1, -14),
		BackgroundTransparency = 1,
		Parent = frame,
	})
	Ui.round().Parent = ring
	local ringStroke = Ui.stroke(WHITE, 2)
	ringStroke.Parent = ring

	local stamp: Stamp = {
		Frame = frame,
		Stroke = stroke,
		RingStroke = ringStroke,
		Labels = {},
		Outlines = {},
		Art = nil,
		Color = region.Color,
	}

	local art = "stamp_" .. string.lower(region.Id)
	if Icons.imageId(art) then
		frame.BackgroundTransparency = 1
		stroke.Enabled = false
		ring.Visible = false
		stamp.Art = Icons.view(frame, art, {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(1.12, 1.12),
			ZIndex = 2,
		})
	else
		local name = Ui.label({
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(0.74, 0.4),
			Text = region.Name,
			TextColor3 = WHITE,
			ZIndex = 2,
			Parent = frame,
		}, 20)
		stamp.Labels = { name }
		stamp.Outlines = { Ui.outline(name, 2) }
	end
	return stamp
end

-- 다 모으면 진하게 찍힌 도장, 아니면 흐릿한 도장 자국
local function paintStamp(stamp: Stamp, complete: boolean)
	local art = stamp.Art
	if art then
		Icons.setColor(art, if complete then WHITE else Color3.fromRGB(150, 146, 160))
		Icons.setTransparency(art, if complete then 0 else 0.75)
		return
	end
	stamp.Frame.BackgroundTransparency = if complete then 0 else 0.8
	stamp.Stroke.Transparency = if complete then 0 else 0.65
	stamp.RingStroke.Color = if complete then WHITE else stamp.Color
	stamp.RingStroke.Transparency = if complete then 0.1 else 0.35
	for _, label in stamp.Labels do
		label.TextColor3 = if complete then WHITE else stamp.Color:Lerp(Theme.Ink, 0.25)
		label.TextTransparency = if complete then 0 else 0.35
	end
	for _, outline in stamp.Outlines do
		outline.Enabled = complete
	end
end

-- 행운 보너스 딱지 색: 받았으면 초록 + 진한 아이콘, 아직이면 회색 + 흐린 아이콘
local function paintBonus(chip: Ui.Chip, earned: boolean)
	Ui.tint(chip.Root, if earned then Ui.colorPair("Grass").Face else DIM_CHIP)
	if chip.Icon then
		Icons.setTransparency(chip.Icon, if earned then 0 else 0.45)
	end
end

local function buildPassport(): View
	local header = newHeader("Passport")
	local chips = chipRow(header)
	stampCount = headerChip(chips, "passport", Theme.Ink, 1)
	stampBonus = headerChip(chips, "clover", "Grass", 2)

	local scroller = newScroller("Passport", VIEWS.Passport.Top)
	local layout = Ui.list(Enum.FillDirection.Vertical, SECTION_GAP)
	layout.VerticalAlignment = Enum.VerticalAlignment.Top
	layout.Parent = scroller

	local total = 0
	for order, region in Landmarks.Regions do
		local list = Landmarks.ByRegion[region.Id]
		local height = PASSPORT_HEADER
			+ gridHeight(#list, PASSPORT_COLUMNS, PASSPORT_CELL.Y, PASSPORT_GAP)
			+ SECTION_PAD
		-- 여권 한 쪽
		local section = Ui.new("Frame", {
			Name = region.Id,
			LayoutOrder = order,
			Size = UDim2.new(1, 0, 0, height),
			BackgroundColor3 = Theme.Paper,
			Parent = scroller,
		})
		Ui.corner(14).Parent = section
		Ui.stroke(Theme.Ink, 3).Parent = section

		-- 지역 이름 + 발견 수 "3/7"
		local title = Ui.label({
			Position = UDim2.fromOffset(SECTION_PAD, 8),
			Size = UDim2.new(0.6, 0, 0, 34),
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = section,
		}, 28)
		-- 발견 진행 막대
		local track = Ui.new("Frame", {
			Position = UDim2.fromOffset(SECTION_PAD, 46),
			Size = UDim2.new(0.5, 0, 0, 14),
			BackgroundColor3 = Theme.Cream,
			Parent = section,
		})
		Ui.round().Parent = track
		Ui.stroke(Theme.Ink, 2).Parent = track
		local fill = Ui.new("Frame", {
			Size = UDim2.fromScale(0, 1),
			BackgroundColor3 = region.Color,
			BorderSizePixel = 0,
			Parent = track,
		})
		Ui.round().Parent = fill
		-- 도장 보너스 "+25%" (네잎클로버)
		local bonus = Ui.chip({
			Name = "Bonus",
			Color = DIM_CHIP,
			Icon = "clover",
			IconSize = 32,
			Text = string.format("+%d%%", REGION_BONUS),
			Height = 26,
			TextSize = 16,
			Position = UDim2.fromOffset(SECTION_PAD + 2, 66),
			Parent = section,
		})

		local stamp = makeStamp(section, region)

		local grid = Ui.new("Frame", {
			Position = UDim2.fromOffset(SECTION_PAD, PASSPORT_HEADER),
			Size = UDim2.new(1, -SECTION_PAD * 2, 1, -(PASSPORT_HEADER + SECTION_PAD)),
			BackgroundTransparency = 1,
			Parent = section,
		})
		Ui.new("UIGridLayout", {
			CellSize = UDim2.fromOffset(PASSPORT_CELL.X, PASSPORT_CELL.Y),
			CellPadding = UDim2.fromOffset(PASSPORT_GAP, PASSPORT_GAP),
			FillDirectionMaxCells = PASSPORT_COLUMNS,
			SortOrder = Enum.SortOrder.LayoutOrder,
			HorizontalAlignment = Enum.HorizontalAlignment.Left,
			Parent = grid,
		})
		passportSections[region.Id] = { Title = title, Fill = fill, Bonus = bonus, Stamp = stamp, Grid = grid }
		total += height + (if order > 1 then SECTION_GAP else 0)
	end
	setCanvasHeight(scroller, total)
	return { Scroller = scroller, Header = header }
end

local function passportCard(parent: Frame, landmark: Landmark, known: boolean, order: number): Frame
	local tier = landmark.Tier
	local card = Ui.new("Frame", {
		Name = landmark.Id,
		LayoutOrder = order,
		BackgroundColor3 = if known then Theme.Cream else Theme.Ink,
	})
	Ui.corner(10).Parent = card
	Ui.stroke(Theme.Ink, 2.5).Parent = card

	if known then
		photo(card, landmark, UDim2.fromOffset(5, 5), UDim2.new(1, -10, 0, 68), 7)
		Ui.label({
			Position = UDim2.fromOffset(4, 77),
			Size = UDim2.new(1, -8, 0, 20),
			Text = landmark.Name,
			Parent = card,
		}, 16)
		Ui.label({
			Position = UDim2.fromOffset(4, 99),
			Size = UDim2.new(1, -8, 0, 17),
			Text = Format.oneIn(landmark.OneIn),
			TextColor3 = tier.Color:Lerp(Theme.Ink, 0.45),
			Parent = card,
		}, 14)
	else
		-- 아직 못 찾은 명소: 어두운 카드 + 자물쇠 그림(있으면) 또는 "?" + 확률
		-- (3D 자물쇠는 카드가 많아 무거우니 그림이 있을 때만)
		if Icons.imageId("lock") then
			Icons.view(card, "lock", {
				AnchorPoint = Vector2.new(0.5, 0),
				Position = UDim2.new(0.5, 0, 0, 14),
				Size = UDim2.fromOffset(56, 56),
				Transparency = 0.15,
			})
		else
			Ui.label({
				Position = UDim2.fromOffset(5, 5),
				Size = UDim2.new(1, -10, 0, 74),
				Font = Theme.FontTitle,
				Text = "?",
				TextColor3 = Theme.Paper,
				TextTransparency = 0.2,
				Parent = card,
			}, 50)
		end
		Ui.label({
			Position = UDim2.fromOffset(4, 90),
			Size = UDim2.new(1, -8, 0, 20),
			Text = Format.oneIn(landmark.OneIn),
			TextColor3 = tier.Color,
			Parent = card,
		}, 16)
	end

	card.Parent = parent
	return card
end

local function renderPassport(state: Snapshot)
	local stamps = 0
	for _, region in Landmarks.Regions do
		local section = passportSections[region.Id]
		local list = Landmarks.ByRegion[region.Id]
		local discovered = 0
		for order, landmark in list do
			local known = Perks.discovered(state, landmark.Id)
			if known then
				discovered += 1
			end
			-- 발견 여부가 바뀐 카드만 다시 만듦
			local entry = passportCards[landmark.Id]
			if not entry or entry.Known ~= known then
				if entry then
					entry.Card:Destroy()
				end
				passportCards[landmark.Id] =
					{ Card = passportCard(section.Grid, landmark, known, order), Known = known }
			end
		end

		-- 도장은 전설급을 뺀 명소만 셈(PlayerState 규칙). 전설급은 카드로만 보이는 보너스 수집
		local found, required = PlayerState.regionProgress(state, region.Id)
		local complete = required > 0 and found >= required
		if complete then
			stamps += 1
		end
		section.Title.Text = string.format(
			'%s  <font color="%s">%d/%d</font>',
			region.Name,
			Format.hex(region.Color:Lerp(Theme.Ink, 0.3)),
			found,
			required
		)
		section.Fill.Size = UDim2.fromScale(if required > 0 then found / required else 0, 1)
		paintBonus(section.Bonus, complete)
		paintStamp(section.Stamp, complete)
	end

	stampCount.Label.Text = string.format("%d/%d", stamps, #Landmarks.Regions)
	stampBonus.Label.Text = string.format("+%d%%", stamps * REGION_BONUS)
	paintBonus(stampBonus, stamps > 0)
end

-- 강화 -----------------------------------------------------------------------

-- 숫자 뒤의 0 떼기: 1.20 -> "1.2", 0.60 -> "0.6"
local function trim(value: number): string
	local text = string.format("%.2f", value):gsub("0+$", ""):gsub("%.$", "")
	return text
end

-- 지금 레벨의 효과 값 (짧게): 행운 ×1.3 / 굴림 간격 1.14초 / 전시 9칸 / 수입 ×1.4
local function valueText(upgrade: PlayerState.Upgrade, level: number): string
	if upgrade.Id == "Agency" then
		return trim(Config.ROLL_COOLDOWN * (1 - upgrade.PerLevel * level)) .. "초"
	elseif upgrade.Id == "Park" then
		return string.format("%d칸", math.floor(Config.BASE_SLOTS + upgrade.PerLevel * level + 0.5))
	end
	return Ui.times(1 + upgrade.PerLevel * level)
end

-- 한 번 살 때 바뀌는 양: "+10%", "-5%", "+3칸"
local function stepText(upgrade: PlayerState.Upgrade): string
	if upgrade.Id == "Park" then
		return string.format("+%d칸", upgrade.PerLevel)
	end
	local percent = math.floor(upgrade.PerLevel * 100 + 0.5)
	return string.format(if upgrade.Id == "Agency" then "-%d%%" else "+%d%%", percent)
end

-- 살 수 있으면 Sun, 코인이 모자라면 Gray, 최대 레벨이면 Grape (같은 색이면 버튼이 알아서 건너뜀)
local function paintBuyButton(row: UpgradeRow, coins: number)
	local price = row.Price
	row.Button.SetColor(if price == nil then "Grape" elseif coins >= price then "Sun" else "Gray")
end

