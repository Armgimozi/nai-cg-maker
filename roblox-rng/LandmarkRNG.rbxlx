	headerChip(rewards, "coin", "Grass", 3).Label.Text =
		string.format("+%d%%", math.floor(Perks.REBIRTH_INCOME * 100 + 0.5))

	rebirthWarning = Ui.chip({
		Name = "Warning",
		Color = Theme.Ink,
		TextColor3 = Ui.colorPair("Coral").Face,
