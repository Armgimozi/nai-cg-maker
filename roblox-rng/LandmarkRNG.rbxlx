-- 소리
local pickSound: Sound
local dropSound: Sound
local cancelSound: Sound

local function makeSound(pitch: number, volume: number): Sound
	return Ui.new("Sound", { SoundId = SOUND_ID, PlaybackSpeed = pitch, Volume = volume, Parent = SoundService })
end

local function play(sound: Sound?)
	if sound then
		sound.TimePosition = 0
		sound:Play()
	end
end

local function disconnectAll(list: { RBXScriptConnection })
	for _, connection in list do
		connection:Disconnect()
	end
	table.clear(list)
end

-- 지금 화면에 보여 줄 배치: 응답을 기다리는 편집이 있으면 미리 보기, 아니면 서버 상태
local function viewState(): Snapshot?
	return preview or lastState
end

-- 화면 상태의 칸 모습("#locked" | "#empty" | 명소 Id, 상태가 없으면 nil). 매 프레임 가리키는 칸을 보므로
-- 상태 표(스냅샷·미리 보기 사본은 바뀌지 않고 새 표로 갈림)마다 parkSlots 를 한 번만 셈
local lookCache: { View: Snapshot?, Slots: { [number]: string }, Unlocked: number } =
	{ View = nil, Slots = {}, Unlocked = 0 }
local function viewLook(slot: number): string?
	local view = viewState()
	if not view then
		return nil
	end
	if lookCache.View ~= view then
		local slots, unlocked = PlayerState.parkSlots(view)
		lookCache.View, lookCache.Slots, lookCache.Unlocked = view, slots, unlocked
	end
	if slot < 1 or slot > PlayerState.MAX_SLOTS then
		return nil
	elseif slot > lookCache.Unlocked then
		return ParkGrid.LOOK_LOCKED
	end
	return lookCache.Slots[slot] or ParkGrid.LOOK_EMPTY
end

-- 캐릭터 · 부지 ------------------------------------------------------------------

local function rootPart(): BasePart?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return if root and root:IsA("BasePart") then root else nil
end

local function humanoid(): Humanoid?
	local character = player.Character
	return character and character:FindFirstChildOfClass("Humanoid")
end

-- 캐릭터가 내 부지(+ margin) 안에 있는지
local function atPlot(margin: number): boolean
	local root = rootPart()
	local cf = origin
	if not root or not cf then
		return false
	end
	local p = cf:PointToObjectSpace(root.Position)
	return ParkGrid.onPlot(p.X, p.Z, margin)
end

-- 칸 받침대 윗면 가운데(명소 피벗 자리). ParkService 가 미니어처를 놓는 자리와 같음
local function slotTop(slot: number): CFrame
	local x, z = ParkGrid.slotOffset(slot)
	return (origin :: CFrame) * CFrame.new(x, ParkGrid.BASE_TOP + ParkGrid.PEDESTAL_HEIGHT, z)
end

local function slotOf(container: Instance): number?
	local slot = container:GetAttribute("Slot")
	if type(slot) == "number" then
		return slot
	end
	local digits = container.Name:match("^Slot(%d+)$")
	return if digits then tonumber(digits) else nil
end

-- 월드 칸 모델의 모습("#locked" | "#empty" | 명소 Id). Look 속성이 없는 옛 서버는 모름(nil)
local function worldLook(slot: number): string?
	local container = containers[slot]
	if not container then
		return nil
	end
	local look = container:GetAttribute("Look")
	return if type(look) == "string" then look else nil
end

-- 월드 칸 모델의 명소를 이 화면에서만 숨기기/되돌리기. 받침대는 그대로(이름표는 paintLabels)
local function applyHidden(container: Instance, hide: boolean)
	for _, child in container:GetChildren() do
		if child:IsA("Model") then
			for _, descendant in child:GetDescendants() do
				if descendant:IsA("BasePart") or descendant:IsA("Decal") then
					descendant.LocalTransparencyModifier = if hide then 1 else 0
				end
			end
		end
	end
end

-- 칸 이름표(ParkService 가 받침대에 붙인 BillboardGui: 스터드 크기, MaxDistance 60) 켜기/끄기
local function setLabel(container: Instance, on: boolean)
	for _, child in container:GetChildren() do
		if child:IsA("BasePart") then
			for _, descendant in child:GetDescendants() do
				if descendant:IsA("BillboardGui") and descendant.Enabled ~= on then
					descendant.Enabled = on
				end
			end
		end
	end
end

-- 배치 모드 동안 칸 이름표는 모두 끔: 이름표는 스터드 크기라 가까운 카메라에서 크게 나와(MaxDistance 60 안) 12개가
-- 명소를 덮음. 대신 들고 있는 명소 / 가리키는 명소 하나만 화면 이름표(setTag). 밖에서는 모두 켬
local function paintLabels()
	for _, container in containers do
		setLabel(container, not editing)
	end
end

local function setHidden(container: Instance, hide: boolean)
	if (hidden[container] == true) == hide then
		return
	end
	hidden[container] = if hide then true else nil
	applyHidden(container, hide)
end

-- 부지 입구 간판(ParkService 의 "Sign": 내 이름·수입)을 이 화면에서만 숨기기/되돌리기. 위에서 보기에서는 간판이
-- 아래 띠 바로 위에 걸려 띠 딱지 뒤로 검은 판·기둥 끝이 삐져나옴(배치 모드 동안에는 필요 없는 정보)
local signHidden = false
local function hideSign(hide: boolean)
	local sign = plot and plot:FindFirstChild("Sign")
	if signHidden == hide or not sign then
		signHidden = hide and sign ~= nil
		return
	end
	signHidden = hide
	for _, descendant in sign:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.LocalTransparencyModifier = if hide then 1 else 0
		elseif descendant:IsA("SurfaceGui") then
			descendant.Enabled = not hide
		end
	end
end

-- 모형 ------------------------------------------------------------------------------

-- 이 화면에서만 쓰는 명소 모형(누를 수 없음, 그림자 없음). 못 만들면 nil
local function localModel(landmark: Landmark): Model?
	local ok, model = pcall(Models.create, landmark, ParkGrid.MINIATURE_SIZE)
	if not ok or typeof(model) ~= "Instance" or not model:IsA("Model") then
		warn("[LandmarkRNG] 배치 모형을 만들지 못했어요 (" .. landmark.Id .. "): " .. tostring(model))
		return nil
	end
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.Anchored = true
			descendant.CanCollide = false
			descendant.CanQuery = false
			descendant.CanTouch = false
			descendant.CastShadow = false
		end
	end
	return model
end

local function rig(model: Model): Rig
	local pivot = model:GetPivot()
	local parts: { BasePart } = {}
	local offsets: { CFrame } = {}
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			table.insert(parts, descendant)
			table.insert(offsets, pivot:ToObjectSpace(descendant.CFrame))
		end
	end
	return { Model = model, Parts = parts, Offsets = offsets, Pivot = pivot }
end

local moveBuffer: { CFrame } = {}
local function moveRig(target: Rig, cf: CFrame)
	target.Pivot = cf
	table.clear(moveBuffer)
	for index, offset in target.Offsets do
		moveBuffer[index] = cf * offset
	end
	-- BulkMoveTo: 파트 여러 개를 한 번에(가짜 환경처럼 없으면 하나씩)
	local ok = pcall(function()
		workspace:BulkMoveTo(target.Parts, moveBuffer, Enum.BulkMoveMode.FireCFrameChanged)
	end)
	if not ok then
		for index, part in target.Parts do
			part.CFrame = moveBuffer[index]
		end
	end
end

-- 들고 있는 반투명 복사본: 원래 색이 비치는 옅은 노란 강조 + 흰 테두리(이름 + 별은 화면 이름표 setTag)
local function makeGhost(landmark: Landmark): Ghost?
	local model = localModel(landmark)
	if not model then
		return nil
	end
	local height = 6
	pcall(function()
		height = model:GetExtentsSize().Y
	end)
	local originals: { [BasePart]: number } = {}
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			originals[descendant] = descendant.Transparency
			descendant.Transparency = descendant.Transparency + (1 - descendant.Transparency) * GHOST_FADE
		end
	end
	local light = Ui.new("Highlight", {
		Name = "Held",
		Adornee = model,
		FillColor = Ui.colorPair("Sun").Face,
		FillTransparency = GHOST_FILL,
		OutlineColor = WHITE,
		OutlineTransparency = 0,
		DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
		Parent = model,
	})
	return { Model = model, Rig = rig(model), Originals = originals, Light = light, Height = height }
end

-- 들고 있던 복사본을 원래 모습(불투명)으로: 받침대에 내려앉을 때
local function solidify(ghost: Ghost): Rig
	for part, transparency in ghost.Originals do
		part.Transparency = transparency
	end
	ghost.Light:Destroy()
	return ghost.Rig
end

-- 부지 회전(위쪽 = 월드 위쪽)만 남긴 CFrame
local function plotRotation(): CFrame
	local cf = origin :: CFrame
	return cf - cf.Position
end

-- proxy: 이 화면에서 옮긴 칸에 서버 칸이 맞을 때까지 보여 주는 모형
local function setProxy(slot: number, id: string?)
	local current = proxies[slot]
	if current and current.Id == id then
		return
	end
	if current then
		current.Model:Destroy()
		proxies[slot] = nil
	end
	local landmark = if id then Landmarks.ById[id] else nil
	if not landmark or not localFolder or not origin then
		return
	end
	local model = localModel(landmark)
	if model then
		model:PivotTo(slotTop(slot))
		model.Parent = localFolder
		proxies[slot] = { Id = landmark.Id, Model = model }
	end
end

-- 빛나는 판(놓을 자리) 칠하기. 가리키는 칸(hoverSlot)이 놓을 수 있는 칸이면 그 판만 진하게 숨 쉬듯(step)
local function paintMarkers(slots: { [number]: string }, unlocked: number, heldFrom: number)
	markerPulse = nil
	for slot, marker in markers do
		local locked = slot > unlocked
		local id = if locked then nil else slots[slot]
		local color: Color3? = nil
		local transparency = 1
		if held then
			if locked then
				-- 잠긴 칸은 아주 흐린 빨강(가리키면 강조·복사본이 빨개짐) — 잠긴 칸이 많아도 놓을 자리가 먼저 보이게
				color, transparency = Ui.colorPair("Coral").Face, 0.9
			elseif slot == heldFrom then
				color, transparency = WHITE, 0.5
			else
				-- 놓을 수 있는 칸: 빈 칸은 초록, 명소가 있으면(자리 바꿈) 노랑 — 은은하게, 가리키는 칸만 진하게.
				-- 보관함에서 집었으면(heldFrom 0) 명소 있는 칸 = 바꿔 넣을 곳이라 조금 더 또렷하게
				color = if id then Ui.colorPair("Sun").Face else Ui.colorPair("Grass").Face
				transparency = if not id then MARK_EMPTY elseif heldFrom == 0 then MARK_REPLACE else MARK_SWAP
				if slot == hoverSlot then
					transparency = MARK_TARGET
					markerPulse = marker
				end
			end
		elseif not locked and not id then
			color, transparency = Ui.colorPair("Grass").Face, 0.62 -- 빈 칸
		end
		if color then
			marker.Color = color
		end
		marker.Transparency = transparency
	end
end

-- 화면 상태(preview/서버)와 월드 칸 모델을 맞춤: 들고 있는 칸·날아오는 칸·이 화면에서 옮긴 칸은 월드 명소를 숨기고,
-- 옮긴 칸에 서버 칸이 아직 옛 모습이면 로컬 모형(proxy)을 둠. 빛나는 판도 다시 칠함
local function reconcile()
	if not editing then
		return
	end
	local view = viewState()
	if not view or not origin then
		return
	end
	local slots, unlocked = PlayerState.parkSlots(view)
	local heldFrom = 0
	if held then
		for slot = 1, unlocked do
			if slots[slot] == held.Id then
				heldFrom = slot
				break
			end
		end
	end
	local flying: { [number]: boolean } = {}
	for _, flyer in flyers do
		if flyer.Slot then
			flying[flyer.Slot] = true
		end
	end
	local now = os.clock()
	for slot = 1, PlayerState.MAX_SLOTS do
		local want = if slot > unlocked then ParkGrid.LOOK_LOCKED else slots[slot] or ParkGrid.LOOK_EMPTY
		local have = worldLook(slot)
		local edited = localEdits[slot]
		if edited and (have == want or now > edited) then
			localEdits[slot] = nil -- 서버 칸이 맞았거나 너무 오래 기다림
			edited = nil
		end
		local covered = slot == heldFrom or flying[slot] == true
		local mismatch = edited ~= nil and have ~= want
		local container = containers[slot]
		if container then
			setHidden(container, covered or mismatch)
		end
		setProxy(slot, if mismatch and not covered then want else nil)
	end
	for container in hidden do
		if not container.Parent then
			hidden[container] = nil -- 서버가 칸 모델을 다시 만듦
		end
	end
	painted = { Slots = slots, Unlocked = unlocked, HeldFrom = heldFrom }
	rayDirty = true -- 숨긴 명소·로컬 모형이 바뀌었을 수 있음
	paintMarkers(slots, unlocked, heldFrom)
	paintLabels()
end

-- 가리키는 칸이 바뀜: 판·이름표만 다시(칸 배치는 그대로)
local function repaintHover()
	local last = painted
	if editing and last then
		paintMarkers(last.Slots, last.Unlocked, last.HeldFrom)
		paintLabels()
	end
end

-- 날아가기(놓기·되돌아가기·자리 바꿈). 도착하면 그 칸 서버 모습이 아직 옛것이면 proxy 로 남음
local function fly(mover: Rig, from: CFrame, to: CFrame, slot: number?, id: string?, hop: number, fade: boolean?)
	table.insert(flyers, {
		Rig = mover,
		From = from,
		To = to,
		Start = os.clock(),
		Seconds = FLY_SECONDS,
		Hop = hop,
		Slot = slot,
		Id = id,
		Fade = fade == true,
	})
end

local function landFlyer(flyer: Flyer)
	local slot, id = flyer.Slot, flyer.Id
	local view = viewState()
	local adopt = false
	if slot and id and view and not flyer.Fade and not proxies[slot] then
		local want = ParkGrid.look(view, slot)
		adopt = want == id and worldLook(slot) ~= want and localEdits[slot] ~= nil
	end
	if adopt and slot and id then
		proxies[slot] = { Id = id, Model = flyer.Rig.Model }
	else
		flyer.Rig.Model:Destroy()
	end
end

-- 들고 있기 ------------------------------------------------------------------------

local renderBar: () -> ()

-- 들고 있는 명소를 원래 자리로 돌려놓음(취소). 전시 중이었으면 받침대로 날아가 앉음
local function returnHeld(silent: boolean?)
	local current = held
	if not current then
		return
	end
	held = nil
	local view = viewState()
	local from = if view then ParkGrid.slotOf(view, current.Id) else 0
	if from > 0 and origin and not silent then
		local mover = solidify(current.Ghost)
		fly(mover, mover.Pivot, slotTop(from), from, current.Id, 1)
	else
		current.Ghost.Model:Destroy()
	end
	if not silent then
		play(cancelSound)
	end
	reconcile()
	renderBar()
end

-- 명소 집기. from: 전시 칸(0 = 보관함). 이미 들고 있으면 그것은 제자리로
local function pickUp(id: string, from: number)
	local landmark = Landmarks.ById[id]
	local view = viewState()
	if not landmark or not view or not localFolder or not origin then
		return
	end
	if held then
		if held.Id == id then
			return
		end
		returnHeld()
	end
	local ghost = makeGhost(landmark)
	if not ghost then
		return
	end
	-- 처음 자리: 전시 칸이면 그 받침대 위, 보관함이면 첫 빈 칸(꽉 찼으면 가장 약한 전시 명소 칸) 위 — 가리키면 그리로 감
	local start = slotTop(if from > 0 then from else ParkGrid.storageStart(view)).Position
	moveRig(ghost.Rig, CFrame.new(start + Vector3.new(0, LIFT, 0)) * plotRotation())
	ghost.Model.Parent = localFolder
	held = { Id = id, Ghost = ghost, Position = start, Target = start, Lift = LIFT, Angle = 0 }
	play(pickSound)
	reconcile()
	renderBar()
end

-- 배치 편집 응답(성공·실패 모두). 기다리는 요청이 더 없으면(또는 stale 이면) 미리 보기를 버리고 서버 상태로
local function finishRequest(ok: boolean?, stale: boolean?)
	if autoFlip and ok and lastState and lastState.Settings.AutoPark == false then
		local button = autoButton
		if button then
			local scale = button.Root:FindFirstChildOfClass("UIScale")
			if scale then
				scale.Scale = 1
				TweenService
					:Create(scale, TweenInfo.new(0.18, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, 2, true), {
						Scale = 1.15,
					})
					:Play()
			end
		end
		if not autoNoticed then
			autoNoticed = true
			handlers.Toast("자동 꺼짐", "podium", Theme.Ink)
		end
	end
	if ok ~= nil then
		autoFlip = false
	end
	pending = math.max(0, pending - 1)
	if pending == 0 or stale then
		preview = nil
	end
	if ok == false or stale then
		table.clear(localEdits) -- 서버 상태로 되돌림(옮긴 칸 로컬 모형 치움)
		if editing then
			play(cancelSound)
		end
	end
	reconcile()
	renderBar()
end

-- 미리 보기를 걸고 서버에 보냄. edited: 이 편집으로 모습이 바뀌는 칸(서버 칸이 맞을 때까지 로컬 모형)
local function send(copy: Snapshot, wasAuto: boolean, edited: { number }, request: () -> (boolean?, boolean?))
	preview = copy
	pending += 1
	if wasAuto then
		autoFlip = true -- 알림은 서버가 받아들인 뒤(finishRequest)에만
	end
	local until_ = os.clock() + EDIT_HOLD
	for _, slot in edited do
		localEdits[slot] = until_
	end
	task.spawn(function()
		local ok, stale = request()
		finishRequest(ok, stale)
	end)
end

-- 놓기 계획 실행: 복사본이 받침대에 내려앉고, 자리 바꿈 상대는 원래 칸으로 폴짝, 바꿔 넣기 상대는 위로 사라짐
local function commit(plan: ParkGrid.DropPlan)
	local current = held
	local view = viewState()
	if not current or not view or not origin then
		return
	end
	local copy = ParkGrid.preview(view, function(c)
		return (PlayerState.setDisplay(c, plan.Slot, plan.Id, plan.Expected, plan.From))
	end)
	if not copy then
		handlers.Toast("배치 실패", "close")
		returnHeld()
		return
	end
	local wasAuto = view.Settings.AutoPark ~= false
	held = nil
	local edited = { plan.Slot }
	local mover = solidify(current.Ghost)
	fly(mover, mover.Pivot, slotTop(plan.Slot), plan.Slot, plan.Id, 0.6)
	local partner = if plan.Partner then Landmarks.ById[plan.Partner] else nil
	if partner then
		local other = localModel(partner)
		if other and localFolder then
			local partnerRig = rig(other)
			moveRig(partnerRig, slotTop(plan.Slot))
			other.Parent = localFolder
			if plan.From > 0 then
				fly(partnerRig, slotTop(plan.Slot), slotTop(plan.From), plan.From, partner.Id, HOP)
			else
				-- 보관함으로 밀려남: 위로 톡 튀어 오르며 사라짐
				fly(partnerRig, slotTop(plan.Slot), slotTop(plan.Slot) + Vector3.new(0, 7, 0), nil, nil, 1, true)
			end
		end
	end
	if plan.From > 0 then
		table.insert(edited, plan.From)
	end
	play(dropSound)
	send(copy, wasAuto, edited, function()
		return handlers.SetDisplay(plan.Slot, plan.Id, plan.Expected, plan.From)
	end)
	reconcile()
	renderBar()
end

-- 보관: 들고 있는 전시 명소를 보관함으로(보관함에서 집은 것이면 그냥 내려놓음)
local function storeHeld()
	local current = held
	local view = viewState()
	if not current or not view then
		return
	end
	local plan = ParkGrid.storePlan(view, current.Id)
	if not plan then
		returnHeld()
		return
	end
	local copy = ParkGrid.preview(view, function(c)
		return (PlayerState.setDisplay(c, plan.Slot, nil, plan.Expected))
	end)
	if not copy then
		returnHeld()
		return
	end
	local wasAuto = view.Settings.AutoPark ~= false
	held = nil
	local mover = solidify(current.Ghost)
	fly(mover, mover.Pivot, mover.Pivot + Vector3.new(0, 6, 0), nil, nil, 0, true)
	play(dropSound)
	send(copy, wasAuto, { plan.Slot }, function()
		return handlers.SetDisplay(plan.Slot, nil, plan.Expected, nil)
	end)
	reconcile()
	renderBar()
end

-- [자동]: 켜기/끄기. 끄면 지금 배치 그대로(화면 안 바뀜). 켜서 직접 고른 배치가 바뀌면 3초 안에 한 번 더 눌러야 함
local paintAuto: () -> ()
local function toggleAuto()
	local view = viewState()
	if not view then
		return
	end
	local on = view.Settings.AutoPark ~= false
	if not on and os.clock() >= confirmUntil and ParkGrid.autoWouldChange(view) then
		confirmUntil = os.clock() + CONFIRM_SECONDS
		confirmToken += 1
		local token = confirmToken
		paintAuto()
		task.delay(CONFIRM_SECONDS, function()
			if token == confirmToken then
				paintAuto()
			end
		end)
		return
	end
	confirmUntil = 0
	confirmToken += 1
	returnHeld()
	local want = not on
	local copy = ParkGrid.preview(view, function(c)
		PlayerState.setAutoPark(c, want)
		return true
	end)
	if not copy then
		return
	end
	send(copy, false, {}, function()
		handlers.SetAutoPark(want)
		return nil, nil
	end)
	reconcile()
	renderBar()
end

-- 입력 → 칸 ------------------------------------------------------------------------

type Hit = { Slot: number?, Ground: Vector3?, OnPlot: boolean }

local function guiInset(): Vector2
	local ok, inset = pcall(function()
		return (GuiService:GetGuiInset())
	end)
	return if ok and typeof(inset) == "Vector2" then inset else Vector2.zero
end

-- InputObject.Position(상단바 아래 기준) -> 뷰포트 좌표
local function toViewport(position: Vector3): Vector2
	return Vector2.new(position.X, position.Y) + guiInset()
end

-- 뷰포트 좌표가 아래 띠(+ 위 딱지 줄) 위인지
local function overBar(at: Vector2): boolean
	if not bar or not bar.Visible then
		return false
	end
	local p = at - guiInset()
	local top = tray.AbsolutePosition.Y - CHIP_ROW * Ui.scale()
	local left, right = tray.AbsolutePosition.X, tray.AbsolutePosition.X + tray.AbsoluteSize.X
	return p.X >= left and p.X <= right and p.Y >= top and p.Y <= tray.AbsolutePosition.Y + tray.AbsoluteSize.Y
end

local function containerOf(instance: Instance): Instance?
	local node: Instance? = instance
	local folder = slotsFolder
	while node and folder and node.Parent ~= folder do
		node = node.Parent
	end
	return node
end

-- 광선이 맞출 것: 내 칸 모델들. 단 이 화면에서 숨긴 명소(들고 있는 칸·날아와 앉을 칸 — 로컬 모형이 대신 서 있는
-- 칸은 빼고)는 받침대만: 안 보이는 원래 명소가 뒤쪽 받침대를 가려서, 거기에 놓으면 원래 칸으로 되돌아가던 것
local rayList: { Instance } = {}
local function rayTargets(folder: Instance): { Instance }
	if not rayDirty then
		return rayList
	end
	rayDirty = false
	local list: { Instance } = {}
	for _, container in folder:GetChildren() do
		local slot = slotOf(container)
		if hidden[container] and not (slot and proxies[slot]) then
			for _, child in container:GetChildren() do
				if not child:IsA("Model") then
					table.insert(list, child)
				end
			end
		else
			table.insert(list, container)
		end
	end
	rayList = list
	rayParams.FilterDescendantsInstances = list
	return list
end

-- 화면 한 점이 가리키는 칸: 먼저 내 부지 칸 모델(받침대·보이는 명소)에 광선을 쏘고, 안 맞으면 부지 바닥 높이 평면과
-- 만나는 점에서 가장 가까운 칸(ParkGrid.slotAt)
local function pick(at: Vector2): Hit
	local result: Hit = { Slot = nil, Ground = nil, OnPlot = false }
	local camera = workspace.CurrentCamera
	local cf = origin
	if not camera or not cf then
		return result
	end
	local ray = camera:ViewportPointToRay(at.X, at.Y)
	local groundY = cf.Position.Y + ParkGrid.BASE_TOP
	if ray.Direction.Y < -1e-4 then
		local t = (groundY - ray.Origin.Y) / ray.Direction.Y
		if t > 0 then
			local point = ray.Origin + ray.Direction * t
			local p = cf:PointToObjectSpace(point)
			result.Ground = point
			result.OnPlot = ParkGrid.onPlot(p.X, p.Z, 1)
			result.Slot = ParkGrid.slotAt(p.X, p.Z)
		end
	end
	local folder = slotsFolder
	if folder then
		rayTargets(folder)
		local hit = workspace:Raycast(ray.Origin, ray.Direction * RAY_LENGTH, rayParams)
		local container = if hit then containerOf(hit.Instance) else nil
		local slot = if container then slotOf(container) else nil
		if slot then
			result.Slot = slot
			result.OnPlot = true
		end
	end
	return result
end

-- 들고 있는 명소를 가리키는 곳에 놓음(누름 또는 끌어서 뗌): 다른 열린 칸 = 옮기기·자리 바꾸기, 같은 칸 · 부지 밖 = 내려놓기,
-- 잠긴 칸 = 알림(계속 들고 있음), 부지 안 칸 없는 곳 = 그대로
local function placeAt(hit: Hit)
	local current = held
	local view = viewState()
	if not current or not view then
		return
	end
	local slot = hit.Slot
	if not slot then
		if not hit.OnPlot then
			returnHeld() -- 부지 밖 = 취소
		end
		return
	end
	local plan = ParkGrid.dropPlan(view, current.Id, slot)
	if plan.Kind == "locked" then
		handlers.Toast("공원 확장", "lock")
	elseif plan.Kind == "cancel" then
		returnHeld() -- 같은 칸 = 제자리에 내려놓기
	else
		commit(plan)
	end
end

local function cancelOrExit()
	if held then
		returnHeld()
	else
		ParkEdit.exit()
	end
end

-- 채팅 등 글자 칸에 쓰는 중인지(빠져나온 직후 잠깐 포함: 빠져나오는 Esc 가 포커스가 풀린 뒤에 올 수 있음)
local function typing(): boolean
	if textFocused or os.clock() - textReleasedAt < TEXT_GRACE then
		return true
	end
	local ok, box = pcall(function()
		return UserInputService:GetFocusedTextBox()
	end)
	return ok and box ~= nil
end

-- 위에서 보기 배율을 바꾸고 카메라를 바로 옮김(들어갈 때 날아가는 중이면 배율만)
local function setZoom(value: number)
	zoom = math.clamp(value, ParkGrid.ZOOM_MIN, ParkGrid.ZOOM_MAX)
	local camera = workspace.CurrentCamera
	if camera and not cameraTween and viewMode == "Top" and origin then
		camera.CFrame = ParkEdit.topCFrame()
	end
end

-- 닿아 있는 손가락 둘(없으면 nil)의 사이 거리
local function touchSpan(): number?
	local first: Vector2? = nil
	for _, at in touches do
		if first then
			return (at - first).Magnitude
		end
		first = at
	end
	return nil
end

-- 두 손가락 모드의 기준(시작 거리·배율)을 지금으로: 손가락이 늘거나 줄면 배율이 튀지 않게
local function rebasePinch()
	local gesture = pinch
	if gesture then
		gesture.Distance = touchSpan() or 0
		gesture.Zoom = zoom
	end
end

-- 손가락이 닿음. 두 번째 손가락이면 두 손가락 모드: 진행 중인 집기·끌기를 취소(든 명소는 제자리로).
-- 이 손가락으로 집기·놓기를 해도 되면(한 손가락) true
local function touchBegan(input: InputObject): boolean
	for other in touches do
		-- 뗌(InputEnded)을 못 받고 끝난 손가락은 뺌
		local state = (other :: any).UserInputState
		if state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
			touches[other] = nil
		end
	end
	touches[input] = toViewport(input.Position)
	if pinch then
		rebasePinch()
		return false
	end
	if touchSpan() == nil then
		return true
	end
	press = nil
	pointer = nil
	pinch = { Distance = 0, Zoom = zoom }
	rebasePinch()
	if held then
		returnHeld()
	end
	return false
end

local function onInputBegan(input: InputObject, processed: boolean)
	local kind = input.UserInputType
	if kind == Enum.UserInputType.Keyboard then
		local key = input.KeyCode
		if typing() then
			return -- 채팅 입력 중(Esc = 글자 칸에서 빠져나오기, 배치 모드는 그대로)
		elseif key == Enum.KeyCode.Escape then
			cancelOrExit() -- Esc 는 로블록스 메뉴가 먼저 가져갈 수 있어서(processed) Q 도 같은 동작
		elseif processed then
			return
		elseif key == Enum.KeyCode.Q then
			cancelOrExit()
		elseif key == Enum.KeyCode.Backspace or key == Enum.KeyCode.Delete then
			storeHeld()
		end
		return
	end
	if processed then
		return -- 화면 버튼·조이스틱
	end
	local pointed = kind == Enum.UserInputType.MouseButton1 or kind == Enum.UserInputType.Touch
	local at = if kind == Enum.UserInputType.Touch
		then toViewport(input.Position)
		else UserInputService:GetMouseLocation()
	if pointed and overBar(at) then
		-- 띠 위 딱지 줄의 비친 곳(버튼이 아니라 processed 가 아님): 띠처럼 뒤의 명소를 집지 않고, 손가락으로도
		-- 세지 않음(띠에 손가락을 올려 둔 채 다른 손가락으로 칸을 톡 누르면 두 손가락으로 잘못 잡히지 않게)
		return
	end
	if kind == Enum.UserInputType.Touch and not touchBegan(input) then
		return -- 두 손가락
	end
	if pointed then
		pointerKind = if kind == Enum.UserInputType.Touch then "Touch" else "Mouse"
		pointer = at
		local current: Press = { Input = input, Kind = kind, Start = at, Moved = false, Picked = false }
		press = current
		-- 명소를 누르면 바로 집음(끌어서 놓거나, 손을 뗀 뒤 놓을 칸을 누름). 평소 카메라에서 터치로 끌면 화면이
		-- 돌아가므로 그때는 누를 때 집지 않고 톡 누르면(뗄 때) 집음
		if not held and not (kind == Enum.UserInputType.Touch and viewMode ~= "Top") then
			local hit = pick(at)
			local slot = hit.Slot
			local look = if slot then viewLook(slot) else nil
			if slot and look then
				if Landmarks.ById[look] then
					pickUp(look, slot)
					current.Picked = held ~= nil
				end
			end
		end
	elseif kind == Enum.UserInputType.MouseButton2 then
		rightStart = UserInputService:GetMouseLocation()
	end
end

local function onInputChanged(input: InputObject, processed: boolean)
	local kind = input.UserInputType
	if kind == Enum.UserInputType.MouseMovement then
		pointerKind = "Mouse"
	elseif kind == Enum.UserInputType.Touch then
		if touches[input] then
			touches[input] = toViewport(input.Position)
		end
		local gesture = pinch
		if gesture then
			-- 두 손가락: 위에서 보기면 벌리기/모으기 = 가까이/멀리(평소 카메라는 로블록스 카메라가 함)
			local span = touchSpan()
			if span and viewMode == "Top" and origin then
				if gesture.Distance <= 0 then
					rebasePinch()
				else
					setZoom(ParkGrid.pinchZoom(gesture.Zoom, gesture.Distance, span))
				end
			end
			return
		end
		local current = press
		if current and current.Input == input then
			local at = toViewport(input.Position)
			pointer = at
			if (at - current.Start).Magnitude > DRAG_PX then
				current.Moved = true
			end
		end
	elseif kind == Enum.UserInputType.MouseWheel and not processed and viewMode == "Top" and origin then
		-- 위에서 보기: 휠로 가까이/멀리
		setZoom(zoom - input.Position.Z * ZOOM_STEP)
	end
end

local function onInputEnded(input: InputObject, processed: boolean)
	local kind = input.UserInputType
	if kind == Enum.UserInputType.MouseButton2 then
		local start = rightStart
		rightStart = nil
		if held and start and (UserInputService:GetMouseLocation() - start).Magnitude <= DRAG_PX then
			returnHeld() -- 오른쪽 클릭 = 취소 (끌면 화면 돌리기)
		end
		return
	end
	if kind == Enum.UserInputType.Touch then
		touches[input] = nil
		if pinch then
			-- 두 손가락 모드: 손가락이 모두 떨어질 때까지 뗌은 무시(놓기·집기 없음)
			if next(touches) == nil then
				pinch = nil
			else
				rebasePinch()
			end
			return
		end
	end
	if kind ~= Enum.UserInputType.MouseButton1 and kind ~= Enum.UserInputType.Touch then
		return
	end
	local current = press
	if not current or current.Kind ~= kind or (kind == Enum.UserInputType.Touch and current.Input ~= input) then
		return
	end
	press = nil
	local at = if kind == Enum.UserInputType.Touch
		then toViewport(input.Position)
		else UserInputService:GetMouseLocation()
	local moved = current.Moved or (at - current.Start).Magnitude > DRAG_PX
	if kind == Enum.UserInputType.Touch then
		pointer = nil -- 터치는 손을 떼면 가리키는 곳이 없음(들고 있는 명소는 마지막 자리에 떠 있음)
	end
	if overBar(at) then
		if held and current.Picked and moved then
			storeHeld() -- 끌어서 아래 띠에 놓음 = 보관
		end
		return
	end
	if processed then
		return -- 다른 화면 버튼 위에서 뗌
	end
	local hit = pick(at)
	if current.Picked then
		-- 누르면서 집음: 끌어서 다른 칸에 놓으면 거기로, 거의 안 움직였으면 계속 들고 있음(다음 누름에 놓기)
		if held and moved then
			placeAt(hit)
		end
		return
	end
	if held then
		if kind == Enum.UserInputType.Touch and moved and viewMode ~= "Top" then
			return -- 평소 카메라: 터치로 끌면 화면 돌리기
		end
		placeAt(hit)
	elseif hit.Slot and not moved then
		local look = viewLook(hit.Slot)
		if look == ParkGrid.LOOK_LOCKED then
			handlers.Toast("공원 확장", "lock")
		elseif look and Landmarks.ById[look] then
			pickUp(look, hit.Slot) -- 평소 카메라에서 터치로 톡
		end
	end
end

-- 매 프레임 ------------------------------------------------------------------------

local function setHover(slot: number?, color: Color3, outline: Color3?)
	local light = hoverLight
	if not light then
		return
	end
	local target: Instance? = nil
	if slot then
		local proxy = proxies[slot]
		target = if proxy then proxy.Model else containers[slot]
	end
	local changed = hoverSlot ~= slot
	hoverSlot = slot
	if light.Adornee ~= target then
		light.Adornee = target
	end
	light.Enabled = target ~= nil
	light.OutlineColor = outline or color
	light.FillColor = color
	if changed then
		repaintHover()
	end
end

-- 칸에 서 있는 명소 모형의 높이(스터드, 받침대 윗면부터). 로컬 모형(proxy)이 있으면 그것. 없으면 0
local heightCache: { [Instance]: number } = setmetatable({}, { __mode = "k" }) :: any
local function statueHeight(slot: number): number
	local proxy = proxies[slot]
	local model: Instance? = if proxy then proxy.Model else nil
	if not model then
		local container = containers[slot]
		model = container and container:FindFirstChildWhichIsA("Model")
	end
	if not model or not model:IsA("Model") then
		return 0
	end
	local cached = heightCache[model]
	if cached then
		return cached
	end
	local height = 0
	pcall(function()
		height = (model :: Model):GetExtentsSize().Y
	end)
	heightCache[model] = height
	return height
end

-- 화면 이름표: 명소 id 의 이름 딱지(등급 색) + 별을 월드 점 point(모형 꼭대기 위) 바로 위에. 화면 밖으로 나가지 않게
-- 상단바 아래 ~ 아래 띠 위, 양옆 안쪽에 가둠. id 가 nil 이면 숨김
local function setTag(id: string?, point: Vector3?)
	local camera = workspace.CurrentCamera
	local landmark = if id then Landmarks.ById[id] else nil
	local view = viewState()
	tagAnchor = nil
	if not tag or not landmark or not point or not camera or not view then
		if tag then
			tag.Visible = false
		end
		return
	end
	local stars = PlayerState.stars(view.Inventory[landmark.Id] or 0)
	local key = landmark.Id .. "|" .. stars
	if key ~= tagKey then
		tagKey = key
		if tagChip then
			tagChip.Root:Destroy()
		end
		local chip = Ui.chip({
			Name = "Name",
			Color = landmark.Tier.Color,
			Text = landmark.Name,
			Height = 30,
			TextSize = 19,
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromScale(0.5, 0),
			ZIndex = 2,
			Parent = tag,
		})
		chip.Label.TextColor3 = WHITE
		tagChip = chip
		tagStars.Text = Ui.starsRich(stars, PlayerState.MAX_STARS)
	end
	local screen, _ = camera:WorldToViewportPoint(point)
	if screen.Z <= 0 then
		tag.Visible = false
		return
	end
	local inset = guiInset()
	local size = gui.AbsoluteSize
	local scale = Ui.scale()
	local half = TAG.X * scale / 2
	local x = math.clamp(screen.X - inset.X, half + TAG_EDGE, math.max(half + TAG_EDGE, size.X - half - TAG_EDGE))
	local lowest = (barTop or size.Y) - TAG_EDGE
	local y = math.clamp(screen.Y - inset.Y, TAG.Y * scale + TAG_EDGE, math.max(TAG.Y * scale + TAG_EDGE, lowest))
	tag.Position = UDim2.fromOffset(x, y)
	tag.Visible = true
	tagAnchor = point
end

local nextSweep = 0
local function step(dt: number)
	if not editing or not origin then
		return
	end
	local now = os.clock()
	if pointerKind == "Mouse" then
		pointer = UserInputService:GetMouseLocation()
		local current = press
		if current and pointer and (pointer - current.Start).Magnitude > DRAG_PX then
			current.Moved = true
		end
	end
	local at = pointer
	local hit: Hit? = nil
	if at and not overBar(at) then
		hit = pick(at)
	end
	local slot = hit and hit.Slot

	-- 들고 있는 명소가 갈 곳: 가리키는 칸 위(칸이 없으면 바닥 위 — 부지 밖이면 부지 가장자리에서 멈춤)
	local current = held
	local under: number? = nil -- 들고 있는 명소가 가는 곳 아래 칸(그 칸 명소 위로 뜸)
	if current then
		local cf = origin :: CFrame
		if hit and hit.Slot then
			current.Target = slotTop(hit.Slot).Position
		elseif hit and hit.Ground then
			local p = cf:PointToObjectSpace(hit.Ground)
			current.Target = cf:PointToWorldSpace(
				Vector3.new(
					math.clamp(p.X, -ParkGrid.PLOT_WIDTH / 2, ParkGrid.PLOT_WIDTH / 2),
					ParkGrid.BASE_TOP + ParkGrid.PEDESTAL_HEIGHT,
					math.clamp(p.Z, -ParkGrid.PLOT_DEPTH / 2, ParkGrid.PLOT_DEPTH / 2)
				)
			)
		end
		local resting = cf:PointToObjectSpace(current.Target)
		under = ParkGrid.slotAt(resting.X, resting.Z)
		if not at then
			-- 가리키는 곳이 없으면(터치를 뗌) 떠 있는 칸을 가리키는 칸으로: 그 칸 판·강조가 켜짐(보관함에서 집어
			-- 꽉 찬 공원의 가장 약한 명소 위에서 시작할 때 = 누르면 바꿔 넣을 곳)
			slot = under
		end
	end

	-- 가리키는 칸 강조: 잠긴 칸 빨강. 들고 있으면 놓을 칸 = 흰 테두리(빈 칸 초록 · 자리 바꿈 노랑 채우기 — 둘레에
	-- 노랗게 빛나는 판들 사이에서도 어느 칸인지 보이게), 아니면 명소 노랑 · 빈 칸 초록
	local look = if slot then viewLook(slot) else nil
	local occupied = look ~= nil and Landmarks.ById[look] ~= nil
	if slot and look then
		if look == ParkGrid.LOOK_LOCKED then
			setHover(slot, Ui.colorPair("Coral").Face)
		elseif held and look == held.Id then
			setHover(nil, HOVER_COLOR) -- 들고 나온 원래 칸: 누르면 그냥 내려놓기라 놓을 칸처럼 빛내지 않음
		elseif held then
			local fill = if occupied then Ui.colorPair("Sun").Face else Ui.colorPair("Grass").Face
			setHover(slot, fill, WHITE)
		else
			setHover(slot, if occupied then Ui.colorPair("Sun").Face else Ui.colorPair("Grass").Face)
		end
	elseif hoverSlot then
		setHover(nil, HOVER_COLOR)
	end

	-- 들고 있는 명소: 갈 곳으로 부드럽게 따라가며 오르내리고 돎
	if current then
		-- 아래 칸에 다른 명소가 있으면(자리 바꿈·바꿔 넣기) 그 명소 위로 떠서 둘 다 보이게
		local wantLift = LIFT
		local below = if under then viewLook(under) else nil
		if under and below and below ~= current.Id and Landmarks.ById[below] then
			wantLift = math.max(LIFT, statueHeight(under) + LIFT_CLEAR)
		end
		local follow = 1 - math.exp(-FOLLOW * dt)
		current.Position = current.Position:Lerp(current.Target, follow)
		current.Lift += (wantLift - current.Lift) * follow
		current.Angle = (current.Angle + SPIN_SPEED * dt) % (2 * math.pi)
		local lift = current.Lift + math.sin(now * BOB_SPEED) * BOB
		moveRig(
			current.Ghost.Rig,
			CFrame.new(current.Position + Vector3.new(0, lift, 0)) * plotRotation() * CFrame.Angles(0, current.Angle, 0)
		)
		local locked = look == ParkGrid.LOOK_LOCKED
		current.Ghost.Light.FillColor = if locked then Ui.colorPair("Coral").Face else Ui.colorPair("Sun").Face
		-- 가리키는 놓을 칸의 판이 진하게 숨 쉬듯 빛남
		local marker = markerPulse
		if marker then
			marker.Transparency = MARK_TARGET + math.sin(now * 5) * MARK_TARGET_PULSE
		end
		setTag(current.Id, current.Ghost.Rig.Pivot.Position + Vector3.new(0, current.Ghost.Height + TAG_GAP, 0))
	elseif slot and occupied and look then
		-- 들고 있지 않을 때: 가리키는 명소 이름 + 별
		setTag(look, slotTop(slot).Position + Vector3.new(0, statueHeight(slot) + TAG_GAP, 0))
	else
		setTag(nil)
	end

	-- 날아가는 모형
	local landed = false
	for index = #flyers, 1, -1 do
		local flyer = flyers[index]
		local t = math.clamp((now - flyer.Start) / flyer.Seconds, 0, 1)
		local eased = 1 - (1 - t) ^ 3
		local cf = flyer.From:Lerp(flyer.To, eased) + Vector3.new(0, 4 * flyer.Hop * t * (1 - t), 0)
		moveRig(flyer.Rig, cf)
		if flyer.Fade then
			for _, part in flyer.Rig.Parts do
				part.LocalTransparencyModifier = t
			end
		end
		if t >= 1 then
			table.remove(flyers, index)
			landFlyer(flyer)
			landed = true
		end
	end
	if landed or (next(localEdits) ~= nil and now >= nextSweep) then
		nextSweep = now + 0.25
		reconcile()
	end
end

-- 카메라 · 이동 ----------------------------------------------------------------------

-- 위에서 보기에서 맞출 줄 수: 열린 칸이 있는 줄 + 잠긴 줄 하나(칸이 적을 때 명소가 작게 보이지 않게)
local function wantRows(): number
	local view = viewState()
	if not view then
		return Config.PARK_GRID
	end
	local _, unlocked = PlayerState.parkSlots(view)
	return ParkGrid.topRows(unlocked)
end

-- 위에서 보기 카메라 자리: 상단바 아래 ~ 아래 띠 위 영역에 앞 fitRows 줄이 딱 들어오게(ParkGrid.topView), 휠로 가까이/멀리
function ParkEdit.topCFrame(): CFrame
	local cf = origin :: CFrame
	local camera = workspace.CurrentCamera
	local viewport = if camera then camera.ViewportSize else Vector2.new(1280, 720)
	local height = math.max(viewport.Y, 1)
	local inset = guiInset()
	local bottom = 0
	if barTop then
		bottom = (height - (barTop + inset.Y) + BAR_CLEAR) / height
	end
	local view = ParkGrid.topView({
		Aspect = viewport.X / height,
		Fov = EDIT_FOV,
		Top = (inset.Y + TOP_MARGIN) / height,
		Bottom = bottom,
		Left = SIDE_MARGIN,
		Right = SIDE_MARGIN,
		Rows = fitRows,
		Zoom = zoom,
	})
	local eye = Vector3.new(view.Eye[1], view.Eye[2], view.Eye[3])
	local target = Vector3.new(view.Target[1], view.Target[2], view.Target[3])
	return CFrame.lookAt(cf:PointToWorldSpace(eye), cf:PointToWorldSpace(target))
end

local function playerControls(): any
	if controls then
		return controls
	end
	local ok, result = pcall(function()
		local scripts = player:FindFirstChild("PlayerScripts")
		local module = scripts and scripts:FindFirstChild("PlayerModule")
		return if module and module:IsA("ModuleScript") then (require(module) :: any):GetControls() else nil
	end)
	if ok and result then
		controls = result
	end
	return controls
end

local function setMovement(enabled: boolean)
	local module = playerControls()
	if module then
		pcall(function()
			if enabled then
				module:Enable()
			else
				module:Disable()
			end
		end)
	end
end

local function stopCameraTween()
	local tween = cameraTween
	cameraTween = nil
	if tween then
		tween:Cancel()
	end
end

local function applyView()
	local camera = workspace.CurrentCamera
	if not camera or not origin then
		return
	end
	stopCameraTween()
	if viewMode == "Top" then
		fitRows = wantRows()
		camera.CameraType = Enum.CameraType.Scriptable
		local tween =
			TweenService:Create(camera, CAMERA_TWEEN, { CFrame = ParkEdit.topCFrame(), FieldOfView = EDIT_FOV })
		cameraTween = tween
		tween.Completed:Connect(function()
			if cameraTween == tween then
				cameraTween = nil
			end
		end)
		tween:Play()
		setMovement(false)
	else
		local saved = savedCamera
		camera.CameraType = if saved and saved.Type ~= Enum.CameraType.Scriptable
			then saved.Type
			else Enum.CameraType.Custom
		camera.CameraSubject = humanoid() or (saved and saved.Subject) or nil
		camera.FieldOfView = if saved then saved.Fov else 70
		setMovement(true)
	end
	if viewButton then
		viewButton.SetColor(if viewMode == "Top" then "Sky" else "Grape")
	end
end

-- 월드 칸 모델 · ClickDetector ---------------------------------------------------------

-- 배치 모드 밖: 내 부지의 열린 칸에 이 클라이언트에서만 ClickDetector (누르면 배치 모드 + 그 칸 명소를 집음).
-- 남의 공원 받침대에는 손가락 커서가 안 뜸
local function addDetector(container: Instance)
	local slot = slotOf(container)
	if not slot or not container:IsA("Model") or container:FindFirstChild("ParkClick") then
		return
	end
	if container:GetAttribute("Look") == ParkGrid.LOOK_LOCKED then
		return
	end
	local detector = Instance.new("ClickDetector")
	detector.Name = "ParkClick"
	detector.MaxActivationDistance = CLICK_DISTANCE
	detector.MouseClick:Connect(function()
		ParkEdit.enter(slot)
	end)
	detector.Parent = container
end

local function removeDetectors()
	for _, container in containers do
		local detector = container:FindFirstChild("ParkClick")
		if detector then
			detector:Destroy()
		end
	end
end

local function addDetectors()
	for _, container in containers do
		addDetector(container)
	end
end

local function onContainerAdded(container: Instance)
	local slot = slotOf(container)
	if not slot then
		return
	end
	containers[slot] = container
	if editing then
		reconcile()
	else
		addDetector(container)
	end
end

local function onContainerRemoved(container: Instance)
	local slot = slotOf(container)
	if slot and containers[slot] == container then
		containers[slot] = nil
	end
	hidden[container] = nil
	if editing then
		if hoverSlot == slot then
			setHover(nil, HOVER_COLOR)
		end
		reconcile()
	end
end

-- 부지 Origin 속성(없는 옛 서버면 바닥 파트에서 셈)
local function readOrigin(model: Instance): CFrame?
	local value = model:GetAttribute("Origin")
	if typeof(value) == "CFrame" then
		return value
	end
	local base = model:FindFirstChild("Base")
	if base and base:IsA("BasePart") then
		return base.CFrame * CFrame.new(0, -base.Size.Y / 2, 0)
	end
	return nil
end

-- 아래 띠 --------------------------------------------------------------------------

-- 초당 수입 짧게: "1.8", "12.5K"
local function incomeText(income: number): string
	if income < 100 then
		local text = string.format("%.1f", math.floor(income * 10) / 10):gsub("%.0$", "")
		return text
	end
	return Format.short(income)
end

function paintAuto()
	local view = viewState()
	if not view or not autoButton then
		return
	end
	local on = view.Settings.AutoPark ~= false
	local confirming = not on and os.clock() < confirmUntil
	autoButton.SetColor(if on then "Grass" elseif confirming then "Sun" else "Gray")
	autoButton.SetText(if confirming then "확인?" else "자동")
	autoBadge.Root.Visible = on
end

-- 보이는 카드(좌우 한 장 여유)만 3D 사진(ViewportFrame)을 만듦. 한 번 만든 사진은 그대로
local function loadThumbs()
	if not editing then
		return
	end
	local k = math.max(0.01, Ui.scale())
	local left = scroller.CanvasPosition.X / k
	local width = scroller.AbsoluteWindowSize.X / k
	if width <= 1 then
		width = BAR_MAX_WIDTH
	end
	for _, card in cards do
		if not card.Thumb and card.X + CARD.X >= left - CARD.X and card.X <= left + width + CARD.X then
			card.Thumb = Viewport.thumbnail(card.Photo, card.Landmark, {
				Position = UDim2.fromOffset(2, 2),
				Size = UDim2.new(1, -4, 1, -4),
			})
		end
	end
end

-- 보관함 카드: 사진(등급 색 바탕) + 별 + (더 좋은 명소면) 오른쪽 위 노란 위 화살표 딱지. 누르면 집음
local function newCard(landmark: Landmark): Card
	local button = Ui.new("TextButton", {
		Name = landmark.Id,
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.fromOffset(CARD.X, CARD.Y),
		BackgroundColor3 = Theme.Paper,
	})
	Ui.corner(12).Parent = button
	local stroke = Ui.stroke(Theme.Ink, 3)
	stroke.Parent = button
	local scale = Ui.new("UIScale", { Parent = button })
	local photo = Ui.new("Frame", {
		Name = "Photo",
		Position = UDim2.fromOffset(5, 5),
		Size = UDim2.new(1, -10, 0, CARD.Y - 34),
		BackgroundColor3 = landmark.Tier.Color:Lerp(WHITE, 0.62),
		Parent = button,
	})
	Ui.corner(8).Parent = photo
	Ui.stroke(Theme.Ink, 2).Parent = photo
	local stars = Ui.label({
		Name = "Stars",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -4),
		Size = UDim2.new(1, -8, 0, 22),
		Parent = button,
	}, 19)
	Ui.outline(stars, 2)
	local better = Ui.chip({
		Name = "Better",
		Color = "Sun",
		Icon = "arrow_up",
		IconOnly = true,
		IconSize = 30,
		Height = 24,
		StrokeThickness = 2,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -8, 0, 6),
		Rotation = 8,
		ZIndex = 4,
		Visible = false,
		Parent = button,
	})
	button.MouseEnter:Connect(function()
		if not (held and held.Id == landmark.Id) then
			scale.Scale = 1.05
		end
	end)
	button.MouseLeave:Connect(function()
		if not (held and held.Id == landmark.Id) then
			scale.Scale = 1
		end
	end)
	button.Activated:Connect(function()
		if held and held.Id == landmark.Id then
			returnHeld() -- 같은 카드를 다시 누름 = 내려놓기
		else
			pickUp(landmark.Id, 0)
		end
	end)
	button.Parent = scroller
	return {
		Button = button,
		Stroke = stroke,
		Scale = scale,
		Photo = photo,
		Thumb = nil,
		Stars = stars,
		Better = better,
		Landmark = landmark,
		X = 0,
	}
end

function renderBar()
	local view = viewState()
	if not editing or not view then
		return
	end
	local slots, unlocked = PlayerState.parkSlots(view)
	local shown = 0
	for slot = 1, unlocked do
		if slots[slot] then
			shown += 1
		end
	end
	countChip.Label.Text = string.format("%d/%d", shown, unlocked)
	incomeChip.Label.Text = "+" .. incomeText(PlayerState.incomePerSecond(view, view)) .. "/s"
	paintAuto()
	local heldShown = held ~= nil and ParkGrid.slotOf(view, held.Id) > 0
	storeButton.SetColor(if heldShown then "Coral" else "Gray")

	-- 보관함: 전시 안 된 명소(희귀한 순서). 더 좋은 명소(전시 칸의 가장 약한 명소보다 수입이 큼)는 노란 딱지
	local better: { [string]: boolean } = {}
	for _, id in PlayerState.betterHidden(view) do
		better[id] = true
	end
	local list = ParkGrid.storage(view)
	-- 들고 있는 보관함 명소는 카드 자리를 그대로 둠(눌러서 다시 내려놓을 수 있게)
	if held and not table.find(list, held.Id) and ParkGrid.slotOf(view, held.Id) == 0 then
		table.insert(list, held.Id)
	end
	local keep: { [string]: boolean } = {}
	for index, id in list do
		keep[id] = true
		local card = cards[id]
		local landmark = Landmarks.ById[id]
		if not card and landmark then
			card = newCard(landmark)
			cards[id] = card
		end
		if card then
			card.X = (index - 1) * (CARD.X + CARD_GAP)
			card.Button.LayoutOrder = index
			local picked = held ~= nil and held.Id == id
			card.Button.BackgroundColor3 = if picked then FEATURED_BG else Theme.Paper
			card.Stroke.Color = if picked then Ui.colorPair("Sun").Face else Theme.Ink
			card.Stroke.Thickness = if picked then 4 else 3
			card.Scale.Scale = if picked then 1.08 else 1
			card.Stars.Text = Ui.starsRich(PlayerState.stars(view.Inventory[id] or 0), PlayerState.MAX_STARS)
			card.Better.Root.Visible = better[id] == true
		end
	end
	for id, card in cards do
		if not keep[id] then
			card.Button:Destroy()
			cards[id] = nil
		end
	end
	scroller.CanvasSize = UDim2.fromOffset(math.max(0, #list * (CARD.X + CARD_GAP) - CARD_GAP + BAR_PAD * 2), 0)
	emptyHint.Visible = #list == 0
	loadThumbs()
	task.defer(loadThumbs) -- 처음 보이는 프레임에는 스크롤 영역 크기가 아직 0 일 수 있음
end

-- 띠 자리: 아래 가운데(배치 모드 동안 HUD 왼쪽 메뉴·굴리기 줄은 숨김). 터치 전용 기기는 오른쪽 아래 점프 버튼 자리를
-- 비움([시점] 으로 평소 카메라를 쓰면 이동 조이스틱·점프 버튼이 다시 나옴). 자리가 바뀌면 위에서 보기 카메라도 다시 맞춤
local function layoutBar()
	if not bar then
		return
	end
	local size = gui.AbsoluteSize
	if size.X <= 0 or size.Y <= 0 then
		return
	end
	local scale = Ui.scale()
	local left, right = BAR_EDGE, size.X - BAR_EDGE
	if Ui.touchOnly() then
		right -= if math.min(size.X, size.Y) <= 500 then BAR_JUMP.Small else BAR_JUMP.Large
	end
	local width = math.clamp(right - left, 200, BAR_MAX_WIDTH * scale)
	local center = math.clamp(size.X / 2, left + width / 2, right - width / 2)
	bar.Position = UDim2.fromOffset(center, size.Y - BAR_BOTTOM)
	bar.Size = UDim2.fromOffset(width / scale, BAR_HEIGHT)
	barTop = size.Y - BAR_BOTTOM - (BAR_HEIGHT + CHIP_ROW) * scale
	loadThumbs()
	-- 위에서 보기 중이면(들어갈 때 날아가는 중이 아니고, 카메라를 이미 넘겨받았을 때만) 새 띠 자리에 맞춰 카메라도 다시
	local camera = workspace.CurrentCamera
	if
		editing
		and viewMode == "Top"
		and origin
		and camera
		and not cameraTween
		and camera.CameraType == Enum.CameraType.Scriptable
	then
		camera.CFrame = ParkEdit.topCFrame()
	end
end

local function barButton(name: string, icon: string, text: string, color: string, x: number, anchorRight: boolean)
	return Ui.chunkyButton({
		Name = name,
		AnchorPoint = Vector2.new(if anchorRight then 1 else 0, 0.5),
		Position = if anchorRight then UDim2.new(1, -x, 0.5, 0) else UDim2.new(0, x, 0.5, 0),
		Size = UDim2.fromOffset(BUTTON.X, BUTTON.Y),
		Color = color,
		Icon = icon,
		IconSize = 54,
		Vertical = true,
		Text = text,
		TextSize = 20,
		ZIndex = 3,
		Parent = tray,
	})
end

local function buildBar()
	bar = Ui.new("Frame", {
		Name = "ParkEditBar",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -BAR_BOTTOM),
		Size = UDim2.fromOffset(BAR_MAX_WIDTH, BAR_HEIGHT),
		BackgroundTransparency = 1,
		ZIndex = 3,
		Visible = false,
		Parent = gui,
	})
	Ui.autoScale(bar)

	-- 크림 쟁반(창과 같은 바탕·테두리). 빈 곳을 누르면(또는 끌어 온 명소를 놓으면) 보관
	tray = Ui.new("TextButton", {
		Name = "Tray",
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Cream,
		ZIndex = 1,
		Parent = bar,
	})
	Ui.corner(18).Parent = tray
	Ui.stroke(Theme.Ink, 4).Parent = tray
	Ui.skin(tray, "panel_paper", { Radius = 18, Height = BAR_HEIGHT, CenterColor = Theme.Cream })
	tray.Activated:Connect(function()
		if held then
			storeHeld()
		end
	end)

	-- 왼쪽: [보관] [자동]
	storeButton = barButton("Store", "crate", "보관", "Gray", BAR_PAD, false)
	storeButton.Activated:Connect(storeHeld)
	autoButton = barButton("AutoPark", "podium", "자동", "Gray", BAR_PAD + BUTTON.X + BUTTON_GAP, false)
	autoButton.Activated:Connect(toggleAuto)
	autoBadge = Ui.chip({
		Name = "On",
		Color = "Coral",
		Text = "ON",
		Height = 22,
		TextSize = 15,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -8, 0, 2),
		Rotation = 12,
		ZIndex = 6,
		Visible = false,
		Parent = autoButton.Face,
	})

	-- 오른쪽: [시점] [완료]
	doneButton = barButton("Done", "check", "완료", "Grass", BAR_PAD, true)
	doneButton.Activated:Connect(function()
		ParkEdit.exit()
	end)
	viewButton = barButton("View", "camera", "시점", "Sky", BAR_PAD + BUTTON.X + BUTTON_GAP, true)
	viewButton.Activated:Connect(function()
		viewMode = if viewMode == "Top" then "Follow" else "Top"
		applyView()
	end)

	-- 가운데: 보관함 카드(가로 스크롤)
	local side = BAR_PAD + 2 * (BUTTON.X + BUTTON_GAP) + 4
	scroller = Ui.new("ScrollingFrame", {
		Name = "Storage",
		Position = UDim2.fromOffset(side, 4),
		Size = UDim2.new(1, -side * 2, 1, -8),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = Theme.Ink,
		ScrollBarImageTransparency = 0.4,
		ScrollingDirection = Enum.ScrollingDirection.X,
		CanvasSize = UDim2.new(),
		ElasticBehavior = Enum.ElasticBehavior.Always,
		ZIndex = 2,
		Parent = tray,
	})
	Ui.new("UIPadding", {
		PaddingLeft = UDim.new(0, BAR_PAD),
		PaddingRight = UDim.new(0, BAR_PAD),
		Parent = scroller,
	})
	Ui.list(Enum.FillDirection.Horizontal, CARD_GAP).Parent = scroller
	scroller:GetPropertyChangedSignal("CanvasPosition"):Connect(loadThumbs)
	scroller:GetPropertyChangedSignal("AbsoluteWindowSize"):Connect(loadThumbs)

	-- 보관함이 비었을 때: 천천히 도는 지구본 + 작은 "굴리기" 딱지(도감과 같은 지구본)
	emptyHint = Ui.new("Frame", {
		Name = "Empty",
		Position = UDim2.fromOffset(side, 0),
		Size = UDim2.new(1, -side * 2, 1, 0),
		BackgroundTransparency = 1,
		ZIndex = 2,
		Visible = false,
		Parent = tray,
	})
	Icons.view(emptyHint, "globe", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(0.5, -4, 0.5, 0),
		Size = UDim2.fromOffset(78, 78),
		Spin = 40,
		Transparency = 0.2,
		ZIndex = 3,
	})
	Ui.chip({
		Name = "Roll",
		Color = "Grass",
		Text = "굴리기",
		Height = 32,
		TextSize = 20,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0.5, 4, 0.5, 0),
		ZIndex = 3,
		Parent = emptyHint,
	})

	-- 쟁반 위 테두리에 걸친 딱지: [공원 전시 수/열린 칸] [동전 +X/s]
	local chips = Ui.new("Frame", {
		Name = "Chips",
		Position = UDim2.fromOffset(side + 6, -CHIP_ROW + 8),
		Size = UDim2.new(1, -(side + 6) * 2, 0, CHIP_ROW),
		BackgroundTransparency = 1,
		ZIndex = 4,
		Parent = bar,
	})
	Ui.list(Enum.FillDirection.Horizontal, 10).Parent = chips
	countChip = Ui.chip({
		Name = "Shown",
		Color = Theme.Ink,
		Icon = "park",
		IconSize = 38,
		Height = 30,
		TextSize = 19,
		LayoutOrder = 1,
		ZIndex = 4,
		Parent = chips,
	})
	incomeChip = Ui.chip({
		Name = "Income",
		Color = "Grass",
		Icon = "coin",
		IconSize = 38,
		Height = 30,
		TextSize = 19,
		LayoutOrder = 2,
		ZIndex = 4,
		Parent = chips,
	})

	-- 화면 이름표(띠보다 아래 층): setTag 가 자리·내용을 정함
	tag = Ui.new("Frame", {
		Name = "ParkEditTag",
		AnchorPoint = Vector2.new(0.5, 1),
		Size = UDim2.fromOffset(TAG.X, TAG.Y),
		BackgroundTransparency = 1,
		ZIndex = 2,
		Visible = false,
		Parent = gui,
	})
	Ui.autoScale(tag)
	tagStars = Ui.label({
		Name = "Stars",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 32),
		Size = UDim2.fromOffset(140, 24),
		ZIndex = 2,
		Parent = tag,
	}, 20)
	Ui.outline(tagStars, 2)

	gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(layoutBar)
	Ui.onRescale(function()
		layoutBar()
	end)
end

-- 들어가기 · 나가기 ------------------------------------------------------------------

local function connectEdit(signal: RBXScriptSignal, callback: (...any) -> ())
	table.insert(editConnections, signal:Connect(callback))
end

local function begin(slot: number?)
	if editing or not origin or not plot then
		return
	end
	editing = true
	editToken += 1
	local token = editToken
	viewMode = "Top"
	zoom = 1
	press, rightStart, pointer = nil, nil, nil
	table.clear(touches)
	pinch = nil
	rayDirty = true
	pointerKind = if UserInputService.MouseEnabled and not Ui.touchOnly() then "Mouse" else nil

	-- 이 화면에서만 있는 것: 칸마다 빛나는 판(받침대 둘레로 삐져나옴) + 가리키는 칸 강조
	local folder = Instance.new("Folder")
	folder.Name = "ParkEditLocal"
	localFolder = folder
	for index = 1, PlayerState.MAX_SLOTS do
		local x, z = ParkGrid.slotOffset(index)
		local marker = Instance.new("Part")
		marker.Name = "Mark" .. index
		marker.Anchored = true
		marker.CanCollide = false
		marker.CanQuery = false
		marker.CanTouch = false
		marker.CastShadow = false
		marker.Material = Enum.Material.Neon
		marker.Size = Vector3.new(MARKER_SIZE, 0.1, MARKER_SIZE)
		marker.CFrame = (origin :: CFrame) * CFrame.new(x, ParkGrid.BASE_TOP + 0.06, z)
		marker.Transparency = 1
		marker.Parent = folder
		markers[index] = marker
	end
	hoverLight = Ui.new("Highlight", {
		Name = "Hover",
		FillTransparency = 0.82,
		OutlineTransparency = 0,
		DepthMode = Enum.HighlightDepthMode.Occluded,
		Enabled = false,
		Parent = folder,
	})
	folder.Parent = workspace
	hideSign(true)

	removeDetectors()
	-- HUD 를 먼저 바꾸고(메뉴·굴리기 줄 숨김, 열린 창 닫기) 띠 자리를 잡은 뒤에 카메라(띠 위 영역에 맞춤)
	handlers.Changed(true)
	bar.Visible = true
	layoutBar()
	scroller.CanvasPosition = Vector2.zero
	local camera = workspace.CurrentCamera
	if camera then
		savedCamera = { Type = camera.CameraType, Subject = camera.CameraSubject, Fov = camera.FieldOfView }
	end
	applyView()

	connectEdit(UserInputService.InputBegan, onInputBegan)
	connectEdit(UserInputService.InputChanged, onInputChanged)
	connectEdit(UserInputService.InputEnded, onInputEnded)
	connectEdit(RunService.RenderStepped, step)
	local character = player.Character
	local body = character and character:FindFirstChildOfClass("Humanoid")
	if body then
		connectEdit(body.Died, function()
			ParkEdit.exit()
		end)
	end

	renderBar()
	reconcile()

	if slot then
		local view = viewState()
		local id = if view then PlayerState.parkSlots(view)[slot] else nil
		if id then
			pickUp(id, slot)
		end
	end

	-- 부지 밖으로 걸어가거나 순간 이동하면 끝
	task.spawn(function()
		while editing and token == editToken do
			if not atPlot(LEAVE_MARGIN) then
				ParkEdit.exit()
				break
			end
			task.wait(0.3)
		end
	end)
end

-- 배치 모드 켜기. slot: 받침대를 눌러 들어왔으면 그 칸 명소를 바로 집음. 내 공원 밖이면 먼저 순간 이동
function ParkEdit.enter(slot: number?)
	if editing then
		if slot then
			local view = viewState()
			local id = if view then PlayerState.parkSlots(view)[slot] else nil
			if id then
				pickUp(id, slot)
			end
		end
		return
	end
	if entering then
		return
	end
	if not plot or not origin then
		handlers.Toast("공원 없음", "park")
		return
	end
	if not lastState then
		handlers.Toast("로딩 중", "globe")
		return
	end
	entering = true
	entryToken += 1
	local token = entryToken
	task.spawn(function()
		if not atPlot(LEAVE_MARGIN) then
			local ok = handlers.GoToPark()
			if token ~= entryToken then
				return
			end
			if not ok then
				entering = false
				return
			end
			-- 순간 이동이 이 화면에 보일 때까지 잠깐 기다림
			local deadline = os.clock() + 2
			while not atPlot(LEAVE_MARGIN) and os.clock() < deadline do
				task.wait(0.05)
			end
			if token ~= entryToken then
				return
			end
		end
		entering = false
		begin(slot)
	end)
end

-- 배치 모드 끄기: 들고 있던 것 내려놓기(연출 없이), 로컬 모형·강조·연결 정리, 숨긴 명소 되돌리기, 카메라·이동 되돌리기
function ParkEdit.exit()
	entryToken += 1
	entering = false
	if not editing then
		return
	end
	editing = false
	editToken += 1
	returnHeld(true)
	disconnectAll(editConnections)
	for _, flyer in flyers do
		flyer.Rig.Model:Destroy()
	end
	table.clear(flyers)
	for _, proxy in proxies do
		proxy.Model:Destroy()
	end
	table.clear(proxies)
	for container in hidden do
		if container.Parent then
			applyHidden(container, false)
		end
	end
	table.clear(hidden)
	paintLabels() -- 배치 모드 밖: 칸 이름표 모두 다시 켬
	hideSign(false)
	table.clear(localEdits)
	table.clear(markers)
	markerPulse = nil
	painted = nil
	hoverLight = nil
	hoverSlot = nil
	local folder = localFolder
	localFolder = nil
	if folder then
		folder:Destroy()
	end
	press, rightStart, pointer = nil, nil, nil
	table.clear(touches)
	pinch = nil
	rayDirty = true
	table.clear(rayList)
	confirmUntil = 0
	confirmToken += 1

	stopCameraTween()
	local camera = workspace.CurrentCamera
	local saved = savedCamera
	savedCamera = nil
	if camera then
		camera.CameraType = if saved and saved.Type ~= Enum.CameraType.Scriptable
			then saved.Type
			else Enum.CameraType.Custom
		camera.CameraSubject = humanoid() or (saved and saved.Subject) or nil
		if saved then
			camera.FieldOfView = saved.Fov
		end
	end
	setMovement(true)

	bar.Visible = false
	tag.Visible = false
	tagKey = nil
	if tagChip then
		tagChip.Root:Destroy()
		tagChip = nil
	end
	addDetectors()
	handlers.Changed(false)
end

function ParkEdit.toggle()
	if editing or entering then
		ParkEdit.exit()
	else
		ParkEdit.enter(nil)
	end
end

function ParkEdit.isEditing(): boolean
	return editing
end

-- 화면 이름표가 붙은 월드 점(이름표 아래 끝, 화면 밖으로 안 나가게 가두기 전). 이름표가 없으면 nil — 스모크 테스트용
function ParkEdit.tagAnchor(): Vector3?
	return tagAnchor
end

-- 서버 상태가 바뀜(applyState). 들고 있던 명소를 더는 갖고 있지 않으면(환생) 내려놓음
function ParkEdit.render(state: Snapshot?)
	lastState = state
	local current = held
	if current and (not state or (state.Inventory[current.Id] or 0) <= 0) then
		returnHeld(true)
	end
	if editing then
		reconcile()
		renderBar()
		-- 공원 확장으로 열린 줄이 바뀌면 위에서 보기를 다시 맞춤
		if viewMode == "Top" and not cameraTween and wantRows() ~= fitRows then
			applyView()
		end
	end
end

-- 내 부지(workspace.Parks 의 OwnerUserId = 내 UserId 인 부지 모델, 없으면 nil)
function ParkEdit.setPlot(model: Instance?)
	if model == plot then
		return
	end
	ParkEdit.exit()
	disconnectAll(plotConnections)
	removeDetectors()
	table.clear(containers)
	plot = model
	origin = nil
	slotsFolder = nil
	if not model then
		return
	end
	origin = readOrigin(model)
	table.insert(
		plotConnections,
		model:GetAttributeChangedSignal("Origin"):Connect(function()
			origin = readOrigin(model)
		end)
	)
	task.spawn(function()
		local folder = model:FindFirstChild("Slots") or model:WaitForChild("Slots", 30)
		if plot ~= model or not folder then
			return
		end
		slotsFolder = folder
		origin = origin or readOrigin(model)
		table.insert(plotConnections, folder.ChildAdded:Connect(onContainerAdded))
		table.insert(plotConnections, folder.ChildRemoved:Connect(onContainerRemoved))
		for _, container in folder:GetChildren() do
			onContainerAdded(container)
		end
	end)
end

function ParkEdit.init(parent: ScreenGui, callbacks: Handlers)
	gui = parent
	handlers = callbacks
	-- 글자 칸(채팅 등)에 쓰는 중인지: 배치 모드 밖에서 포커스를 얻었어도 알도록 늘 지켜봄
	pcall(function()
		UserInputService.TextBoxFocused:Connect(function()
			textFocused = true
		end)
		UserInputService.TextBoxFocusReleased:Connect(function()
			textFocused = false
			textReleasedAt = os.clock()
		end)
	end)
	pickSound = makeSound(1.35, 0.3)
	dropSound = makeSound(0.9, 0.45)
	cancelSound = makeSound(0.65, 0.3)
	buildBar()
end

return ParkEdit
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">Perks</string>
            <string name="Source"><![CDATA[-- 환생 · 게임패스 · 개발자 상품 · 시간 부스트 · 서버 행운을 화면용으로 읽는 헬퍼 (DESIGN.md v3).
-- Snapshot/Config 를 방어적으로 읽습니다: 필드가 없거나 형식이 조금 달라도(숫자/표) 화면이 깨지지 않게.
--   Snapshot: Rebirths, NextRebirth = { Coins, Landmarks }, Discovered, Boosts = { [id] = 남은 초 },
--             Passes = { [passKey] = true }, ServerLuck (지금은 true/false. 남은 초 / 끝 시각 / 표도 받아 줌)
--   ServerLuck 이벤트: { Name, Until(workspace:GetServerTimeNow 기준 끝 시각), Left(남은 초) }
--   Config:   REBIRTH_LUCK_MULT, REBIRTH_INCOME_BONUS, MAX_REBIRTHS, REBIRTHS, GamePasses, Products
--             (상품 항목 { Id = "LuckVIP", Name, PassId/ProductId, LuckMult..., Price }. 번호가 0 이면 화면에 안 나옴)

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config) :: any
local Landmarks = require(Shared.Landmarks)
local PlayerState = require(Shared.PlayerState) :: any

local Perks = {}

local function number(value: any, default: number): number
	return if type(value) == "number" and value == value then value else default
end

-- 처음 나오는 숫자 필드 (없으면 nil)
local function pick(entry: any, keys: { string }): number?
	if type(entry) ~= "table" then
		return nil
	end
	for _, key in keys do
		local value = tonumber(entry[key])
		if value then
			return value
		end
	end
	return nil
end

-- 환생 1회마다: 행운 ×REBIRTH_LUCK_MULT(곱해짐 — 2^환생 수), 수입 +REBIRTH_INCOME(더해짐 — 1 + 0.5 × 환생 수)
Perks.REBIRTH_LUCK_MULT = number(Config.REBIRTH_LUCK_MULT, 2)
Perks.REBIRTH_INCOME = number(Config.REBIRTH_INCOME_BONUS, 0.5)

-- 서버 행운 이벤트/스냅샷의 시각이 이보다 크면 유닉스 시각(초), 작으면 남은 초로 봄
local EPOCH_MIN = 1e8

-- 상품 ------------------------------------------------------------------------

export type Item = {
	Key: string,
	Kind: string, -- "Pass" | "Product"
	Id: number,
	Name: string,
	Icon: string, -- 카드 큰 아이콘
	Color: string, -- 카드 띠 색 (Ui 색 이름)
	EffectIcon: string,
	Mult: number?, -- 배율 (×2, 굴림 간격 ×0.7)
	Seconds: number?, -- 시간 부스트 길이
	Price: number?, -- Robux 가격(Config). 상점이 GetProductInfo 로 실제 가격을 받으면 화면만 그 값으로 바꿈
}

-- 화면에 보여 줄 순서와 모양. 띠 색·아이콘은 구매 창에 나오는 상품 그림(art/products)에 맞추고, 한 줄 안에서는
-- 띠 색이 겹치지 않게(코인 팩 그림은 서버 행운처럼 금색 바탕이라 띠만 Coral).
-- 효과 숫자(Mult/Seconds)는 Config 항목에 있으면 그 값을 씀
local PASS_INFO = {
	{ Key = "LuckVIP", Name = "행운 VIP", Icon = "clover", Color = "Grape", EffectIcon = "clover", Mult = 2 },
	{ Key = "FastRoll", Name = "빠른 굴림", Icon = "dice", Color = "Sky", EffectIcon = "dice", Mult = 0.7 },
	{ Key = "DoubleIncome", Name = "수입 2배", Icon = "coin", Color = "Grass", EffectIcon = "arrow_up", Mult = 2 },
}
local PRODUCT_INFO = {
	{
		Key = "LuckBoost",
		Name = "행운 부스트",
		Icon = "clover",
		Color = "Grass",
		EffectIcon = "clover",
		Mult = 2,
		Seconds = 900,
	},
	{
		Key = "ServerLuck",
		Name = "서버 행운",
		Icon = "globe",
		Color = "Sun",
		EffectIcon = "clover",
		Mult = 2,
		Seconds = 900,
	},
	{ Key = "CoinPack", Name = "코인 팩", Icon = "coin", Color = "Coral", EffectIcon = "coin" },
}

-- Config.GamePasses / Products 에서 key 항목 찾기.
-- 지금 형식: { { Id = "LuckVIP", Name, PassId = 123, LuckMult = 2 }, ... }. { LuckVIP = 123 } 같은 형식도 받아 줌
local function lookup(group: any, key: string): any
	if type(group) ~= "table" then
		return nil
	end
	local entry = group[key]
	if entry ~= nil then
		return entry
	end
	for _, value in group do
		if type(value) == "table" and (value.Id == key or value.Key == key) then
			return value
		end
	end
	return nil
end

-- 로블록스 상품 번호 (없으면 0). 항목의 Id 는 문자열 키라서 숫자일 때만 번호로 봄
local function idOf(entry: any): number
	if type(entry) == "number" then
		return entry
	end
	return pick(entry, { "PassId", "ProductId", "AssetId", "Id" }) or 0
end

local MULT_KEYS = { "LuckMult", "CooldownMult", "IncomeMult", "Mult", "Multiplier" }

-- Id 가 0 인(아직 안 만든) 상품도 포함한 전체 목록
local function buildItems(group: any, infos: { any }, kind: string): { Item }
	local items = {}
	for _, info in infos do
		local entry = lookup(group, info.Key)
		table.insert(items, {
			Key = info.Key,
			Kind = kind,
			Id = idOf(entry),
			Name = if type(entry) == "table" and type(entry.Name) == "string" then entry.Name else info.Name,
			Icon = info.Icon,
			Color = info.Color,
			EffectIcon = info.EffectIcon,
			Mult = pick(entry, MULT_KEYS) or info.Mult,
			Seconds = pick(entry, { "Seconds", "Duration" }) or info.Seconds,
			Price = pick(entry, { "Price", "PriceInRobux" }),
		})
	end
	return items
end

local function forSale(items: { Item }): { Item }
	local list = {}
	for _, item in items do
		if item.Id ~= 0 then
			table.insert(list, item)
		end
	end
	return list
end

local allPasses = buildItems(Config.GamePasses, PASS_INFO, "Pass")
local allProducts = buildItems(Config.Products, PRODUCT_INFO, "Product")

-- 화면에 나오는 상품: Id 가 0 이 아닌 것만 (Config 는 바뀌지 않으므로 한 번만 만듦)
Perks.Passes = forSale(allPasses)
Perks.Products = forSale(allProducts)

local itemsByKey: { [string]: Item } = {}
for _, item in allPasses do
	itemsByKey[item.Key] = item
end
for _, item in allProducts do
	itemsByKey[item.Key] = item
end

-- 팔 상품이 하나라도 있는지 (없으면 상점 버튼을 숨김)
function Perks.anyForSale(): boolean
	return #Perks.Passes > 0 or #Perks.Products > 0
end

-- 구매 완료 이벤트(숫자 Id) -> 상품
function Perks.itemById(kind: string, id: number): Item?
	local list = if kind == "Pass" then Perks.Passes else Perks.Products
	for _, item in list do
		if item.Id == id then
			return item
		end
	end
	return nil
end

-- 판매 여부와 상관없이 상품 정보 (서버 행운 띠, 부스트 딱지의 배율)
function Perks.item(key: string): Item?
	return itemsByKey[key]
end

function Perks.mult(key: string, default: number): number
	local item = itemsByKey[key]
	return if item and item.Mult then item.Mult else default
end

-- 게임패스 보유 여부. Passes 의 키가 패스 이름이든 숫자 Id 든 받아 줌
function Perks.ownsPass(state: any, key: string): boolean
	local passes = if type(state) == "table" then state.Passes else nil
	if type(passes) ~= "table" then
		return false
	end
	if passes[key] then
		return true
	end
	local item = itemsByKey[key]
	return item ~= nil and (passes[item.Id] or passes[tostring(item.Id)]) and true or false
end

-- 코인 팩으로 받을 코인 = max(1000, 초당 수입 × 1800)
function Perks.coinPackAmount(income: number): number
	local entry = lookup(Config.Products, "CoinPack")
	local minimum = pick(entry, { "MinCoins", "Min" }) or 1000
	local seconds = pick(entry, { "IncomeSeconds", "Seconds" }) or 1800
	return math.max(minimum, math.floor(number(income, 0) * seconds))
end

-- 시간 부스트 ------------------------------------------------------------------

export type Boost = { Key: string, Seconds: number, Mult: number, Icon: string }

local BOOST_ICONS = { LuckBoost = "clover" }

-- 스냅샷을 받은 순간의 남은 시간 목록 (0 초 이하는 뺌). 키 이름 순서
function Perks.boosts(state: any): { Boost }
	local list = {}
	local boosts = if type(state) == "table" then state.Boosts else nil
	if type(boosts) ~= "table" then
		return list
	end
	for key, value in boosts do
		local seconds = if type(value) == "number" then value else pick(value, { "Remaining", "Seconds" })
		if type(key) == "string" and seconds and seconds > 0 then
			table.insert(list, {
				Key = key,
				Seconds = seconds,
				Mult = Perks.mult(key, 2),
				Icon = BOOST_ICONS[key] or "clover",
			})
		end
	end
	table.sort(list, function(a, b)
		return a.Key < b.Key
	end)
	return list
end

-- 서버 행운 -------------------------------------------------------------------

-- 시각 값 -> 끝나는 유닉스 시각. 큰 값은 그대로(유닉스 시각), 작은 값은 nowEpoch 기준 남은 초
function Perks.toEpoch(value: number, nowEpoch: number): number
	if value >= EPOCH_MIN then
		return value
	end
	return nowEpoch + value
end

-- 스냅샷의 ServerLuck -> (끝나는 유닉스 시각?, 시각 없이 "켜짐"만 알면 true)
-- receivedEpoch: 스냅샷을 받은 순간의 서버 시계(workspace:GetServerTimeNow 기준)
function Perks.serverLuck(value: any, receivedEpoch: number): (number?, boolean)
	if type(value) == "number" then
		if value <= 0 then
			return nil, false
		end
		return Perks.toEpoch(value, receivedEpoch), false
	elseif type(value) == "table" then
		local untilTime = pick(value, { "Until", "EndsAt" })
		if untilTime then
			return Perks.toEpoch(untilTime, receivedEpoch), false
		end
		local remaining = pick(value, { "Remaining", "Seconds" })
		if remaining then
			return receivedEpoch + remaining, false
		end
		return nil, value.Active == true
	elseif value == true then
		return nil, true
	end
	return nil, false
end

-- 환생 -----------------------------------------------------------------------

export type Need = { Coins: number, Landmarks: { string } }

function Perks.rebirths(state: any): number
	return if type(state) == "table" then math.max(0, math.floor(number(state.Rebirths, 0))) else 0
end

-- 환생 수 -> 지금 받는 (행운 배율, 수입 배율) = (2^환생 수, 1 + 0.5 × 환생 수). 서버와 같은 PlayerState 규칙
-- (MAX_REBIRTHS 에서 멈춤). PlayerState 에 함수가 없는 옛 모듈이면 같은 식으로 계산
function Perks.rebirthMults(rebirths: number): (number, number)
	if type(PlayerState.rebirthLuckMult) == "function" and type(PlayerState.rebirthIncomeMult) == "function" then
		return PlayerState.rebirthLuckMult(rebirths), PlayerState.rebirthIncomeMult(rebirths)
	end
	local n = math.clamp(math.floor(rebirths), 0, number(Config.MAX_REBIRTHS, math.huge))
	return Perks.REBIRTH_LUCK_MULT ^ n, 1 + Perks.REBIRTH_INCOME * n
end

-- 요구 명소 목록: 배열 { id, ... } 또는 { [id] = true } 둘 다 받음. 모르는 Id 는 뺌
local function landmarkList(value: any): { string }
	local list = {}
	if type(value) ~= "table" then
		return list
	end
	if #value > 0 then
		for _, id in value do
			if type(id) == "string" and Landmarks.ById[id] then
				table.insert(list, id)
			end
		end
	else
		for id, flag in value do
			if type(id) == "string" and flag and Landmarks.ById[id] then
				table.insert(list, id)
			end
		end
		-- 순서가 없는 표면 흔한 것부터
		table.sort(list, function(a, b)
			return Landmarks.ById[a].OneIn < Landmarks.ById[b].OneIn
		end)
	end
	return list
end

local function need(raw: any): Need?
	if type(raw) ~= "table" then
		return nil
	end
	return { Coins = math.max(0, number(tonumber(raw.Coins), 0)), Landmarks = landmarkList(raw.Landmarks) }
end

-- 다음 환생 조건: 스냅샷 NextRebirth -> PlayerState.rebirthRequirement -> Config.REBIRTHS 순서로 찾음
function Perks.rebirthNeed(state: any): Need?
	if type(state) ~= "table" then
		return nil
	end
	local rebirths = Perks.rebirths(state)
	if rebirths >= number(Config.MAX_REBIRTHS, math.huge) then
		return nil -- 최대까지 환생함
	end
	local fromSnapshot = need(state.NextRebirth)
	if fromSnapshot then
		return fromSnapshot
	end
	if type(PlayerState.rebirthRequirement) == "function" then
		local ok, result = pcall(PlayerState.rebirthRequirement, rebirths)
		local parsed = if ok then need(result) else nil
		if parsed then
			return parsed
		end
	end
	local steps = Config.REBIRTHS
	local step = if type(steps) == "table" then steps[rebirths + 1] else nil
	if type(step) == "table" and rebirths < number(Config.MAX_REBIRTHS, #steps) then
		return {
			Coins = number(tonumber(step.Coins), 0),
			Landmarks = landmarkList(step.Landmarks),
		}
	end
	return nil -- 최대까지 환생함
end

-- 이번 판에 보유한 수 (공원·별·환생 조건 기준)
function Perks.owned(state: any, id: string): number
	local inventory = if type(state) == "table" then state.Inventory else nil
	return if type(inventory) == "table" then number(inventory[id], 0) else 0
end

-- 역대 발견 여부 (도감·대륙 도장 기준). 스냅샷에 Discovered 가 없으면 보유 기준
function Perks.discovered(state: any, id: string): boolean
	local discovered = if type(state) == "table" then state.Discovered else nil
	if type(discovered) == "table" and discovered[id] then
		return true
	end
	return Perks.owned(state, id) > 0
end

-- 지금 환생할 수 있는지. 반환: 가능 여부, 없는 명소 Id 목록, 모자란 코인, 조건
function Perks.rebirthCheck(state: any, coins: number): (boolean, { string }, number, Need?)
	local nextNeed = Perks.rebirthNeed(state)
	if not nextNeed then
		return false, {}, 0, nil
	end
	local missing = {}
	for _, id in nextNeed.Landmarks do
		if Perks.owned(state, id) <= 0 then
			table.insert(missing, id)
		end
	end
	local short = math.max(0, nextNeed.Coins - math.floor(coins))
	return #missing == 0 and short <= 0, missing, short, nextNeed
end

return Perks
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">Ui</string>
            <string name="Source"><![CDATA[-- UI 생성 헬퍼와 테마. 모든 화면은 코드로 만들어서 .rbxm 없이도 동작합니다.
-- 스타일: 인기 로블록스 게임식 통통한 UI (밝은 색 + 굵은 Ink 테두리 + 눌리는 3D 버튼, 이모지 없음).
-- 자세한 규칙은 DESIGN.md 의 "UI 스타일 가이드 (v2)" 참고.
-- 그림 에셋: Shared/ImageIds 에 Id 가 들어 있으면 버튼·창·알약·리본·딱지는 9-slice 그림(Ui.skin)으로,
--   아이콘은 ImageLabel 로 그립니다(Ui.icon). 비어 있으면 지금처럼 Frame/3D 모형으로 그립니다.

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Format = require(Shared.Format)

local Ui = {}

-- 그림 Id 표. 모듈이 없거나 깨져도 기본 모양으로 동작하도록 빈 표로 대체
local function loadImageIds(): { [string]: any }
	local module = Shared:FindFirstChild("ImageIds") or Shared:WaitForChild("ImageIds", 5)
	if module and module:IsA("ModuleScript") then
		local ok, result = pcall(require, module)
		if ok and type(result) == "table" then
			return result
		end
		warn("[LandmarkRNG] ImageIds 를 읽지 못했어요: " .. tostring(result))
	end
	return {}
end
local imageIds = loadImageIds()

export type ColorPair = { Face: Color3, Shadow: Color3 }

local rgb = Color3.fromRGB
local WHITE = Color3.new(1, 1, 1)

-- 버튼/리본 색 (앞면 / 그림자)
local COLORS: { [string]: ColorPair } = {
	Sky = { Face = rgb(57, 160, 255), Shadow = rgb(31, 111, 204) },
	Grass = { Face = rgb(76, 217, 100), Shadow = rgb(46, 158, 69) },
	Sun = { Face = rgb(255, 197, 61), Shadow = rgb(217, 144, 15) },
	Coral = { Face = rgb(255, 94, 91), Shadow = rgb(201, 58, 56) },
	Grape = { Face = rgb(155, 107, 255), Shadow = rgb(106, 69, 201) },
	Gray = { Face = rgb(172, 170, 190), Shadow = rgb(116, 112, 138) },
}

Ui.Theme = {
	Ink = rgb(30, 27, 46), -- 모든 굵은 테두리·글자 테두리
	Cream = rgb(255, 244, 220), -- 창 바탕
	Paper = rgb(255, 230, 176), -- 카드/여권 종이
	PaperDark = rgb(222, 178, 104), -- 창 아래 두께(립), 빈 막대
	White = WHITE,
	Colors = COLORS,
	Font = Enum.Font.FredokaOne,
	FontTitle = Enum.Font.LuckiestGuy, -- 큰 제목(명소 공개, 속보)
	-- 알림 색 (init.client 에서 알림 알약 색으로 넘김)
	Good = COLORS.Grass.Face,
	Bad = COLORS.Coral.Face,
	Gold = COLORS.Sun.Face,
	SubText = COLORS.Gray.Face,
	Text = WHITE,
}

-- 화면 크기 기준 해상도. 이보다 작으면(휴대폰) 줄이고, 크면 조금 키웁니다.
local DESIGN_SIZE = Vector2.new(1280, 720)
local MIN_SCALE, MAX_SCALE = 0.55, 0.9

local SHADOW_DEPTH = 6 -- 통통 버튼: 그림자 판이 앞면보다 아래로 나온 두께
local PRESS_DEPTH = 4 -- 누르면 앞면이 내려가는 거리
local BUTTON_CORNER = 14

local PRESS_TWEEN = TweenInfo.new(0.06, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local RELEASE_TWEEN = TweenInfo.new(0.16, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local HOVER_TWEEN = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

-- 9-slice 스킨 그림(256x256)마다: 그림 속 바깥 모서리 반지름(Radius, px)과 SliceCenter 여백(Margin, px).
-- SliceCenter = Margin..(256 - Margin). 여백은 모서리 곡선(과 광택 줄)이 끝나는 곳 이상이어야 곧은 가장자리만 늘어남.
-- 여백 = 바깥 빈칸 + 반지름이면, 모서리 조각(여백 x SliceScale)을 높이의 절반까지 키웠을 때 끝이 딱 반원(캡슐)이 됨.
--   tag         빈칸 2 + 반지름 44 = 46 -> SliceCenter 46..210 (딱지가 캡슐로 나옴)
--   pill        빈칸 1 + 반지름 63 ≈ 64 (SliceScale = 높이/128 이면 반원)
--   button_*    반지름 50, 위 광택 줄이 y 56 까지라 여백 64
--   panel_paper 반지름 46, 여백 64
local SKIN_SIZE = 256
local SKINS: { [string]: { Radius: number, Margin: number } } = {
	button_face = { Radius = 50, Margin = 64 },
	button_shadow = { Radius = 50, Margin = 64 },
	panel_paper = { Radius = 46, Margin = 64 },
	pill = { Radius = 64, Margin = 64 },
	tag = { Radius = 44, Margin = 46 },
}
local DEFAULT_SKIN = { Radius = 50, Margin = 64 }

-- pill.png 는 이미 Ink 색 + 몸통 불투명도 62%(테두리는 불투명)라 물들이지 않음. 더 투명하게 해 달라고 할 때만 그만큼 더 투명하게
local PILL_ART_OPACITY = 0.62

-- 제목 리본(Ui.ribbon) 치수. 판 높이 50 기준이고 판 높이에 비례해 늘거나 줄어듦.
-- 꼬리 그림(ribbon_tail_l/r.png, 56x50)은 늘이지 않고 비율 그대로 판 양 끝 뒤에 붙임(안쪽 20 은 판 뒤에 숨음)
local RIBBON_BASE_HEIGHT = 50
local RIBBON_TAIL = { Size = Vector2.new(56, 50), Left = -36, Top = 17 } -- 오른쪽 꼬리는 왼쪽을 뒤집은 자리
local RIBBON_SHADE = 9 -- 판 아래 그림자 띠 두께
local RIBBON_CORNER = 12

-- close.png: 빨간 동그라미 닫기 버튼 완성 그림(지름 216/256, 아래 두께 포함)
local CLOSE_ART_SIZE = 60

-- Icons 는 Viewport -> Ui 를 require 하므로, 순환을 피하려고 처음 쓸 때 불러옴
local iconsModule: any = nil
local function icons(): any
	if not iconsModule then
		iconsModule = require(script.Parent:WaitForChild("Icons")) :: any
	end
	return iconsModule
end

-- 그림 Id ("rbxassetid://...") 또는 nil(아직 그림 없음). 숫자만 넣어 둬도 받아 줌
function Ui.imageId(name: string?): string?
	if not name then
		return nil
	end
	local value = imageIds[name]
	if type(value) == "number" then
		return "rbxassetid://" .. tostring(value)
	elseif type(value) == "string" and value ~= "" then
		return if value:match("^%d+$") then "rbxassetid://" .. value else value
	end
	return nil
end

-- Ui.new("Frame", { Size = ..., Parent = ... }, { 자식들 })
function Ui.new(className: string, props: { [string]: any }?, children: { Instance }?): any
	local instance = Instance.new(className)
	local parent = nil
	for key, value in props or {} do
		if key == "Parent" then
			parent = value
		else
			(instance :: any)[key] = value
		end
	end
	for _, child in children or {} do
		child.Parent = instance
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

function Ui.corner(radius: number?): UICorner
	return Ui.new("UICorner", { CornerRadius = UDim.new(0, radius or 12) })
end

-- 완전히 둥근 모서리(알약/동그라미)
function Ui.round(): UICorner
	return Ui.new("UICorner", { CornerRadius = UDim.new(0.5, 0) })
end

-- 테두리 선 (기본: Ink 3px)
function Ui.stroke(color: Color3?, thickness: number?, transparency: number?): UIStroke
	return Ui.new("UIStroke", {
		Color = color or Ui.Theme.Ink,
		Thickness = thickness or 3,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

-- 글자 테두리 (Contextual = 글자에 적용)
function Ui.outline(label: GuiObject, thickness: number?, color: Color3?): UIStroke
	return Ui.new("UIStroke", {
		Color = color or Ui.Theme.Ink,
		Thickness = thickness or 2,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
		Parent = label,
	})
end

function Ui.padding(px: number): UIPadding
	local u = UDim.new(0, px)
	return Ui.new("UIPadding", { PaddingTop = u, PaddingBottom = u, PaddingLeft = u, PaddingRight = u })
end

function Ui.list(direction: Enum.FillDirection, gap: number, hAlign: Enum.HorizontalAlignment?): UIListLayout
	return Ui.new("UIListLayout", {
		FillDirection = direction,
		Padding = UDim.new(0, gap),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = hAlign or Enum.HorizontalAlignment.Left,
		VerticalAlignment = Enum.VerticalAlignment.Center,
	})
end

-- 이름 -> 색 쌍 (모르는 이름이면 회색). 색 쌍 표({ Face, Shadow })를 주면 그대로(도감 대륙 탭처럼 테마에 없는 색)
function Ui.colorPair(name: (string | ColorPair)?): ColorPair
	if type(name) == "table" then
		return name
	end
	return COLORS[name or "Gray"] or COLORS.Gray
end

-- 위쪽이 살짝 밝은 세로 그라데이션. 배경색은 흰색으로 두고 이 그라데이션 색이 곧 면 색이 됨
function Ui.faceGradient(color: Color3): ColorSequence
	return ColorSequence.new({
		ColorSequenceKeypoint.new(0, color:Lerp(WHITE, 0.32)),
		ColorSequenceKeypoint.new(0.5, color),
		ColorSequenceKeypoint.new(1, color),
	})
end

-- 글자 크기 자동(TextScaled) + 최대 크기 제한. 기본 글꼴 FredokaOne, 기본 글자색 Ink(크림 바탕용)
function Ui.label(props: { [string]: any }, maxTextSize: number?): TextLabel
	local label = Ui.new("TextLabel", {
		Text = "",
		BackgroundTransparency = 1,
		Font = Ui.Theme.Font,
		TextColor3 = Ui.Theme.Ink,
		TextScaled = true,
		RichText = true,
	})
	for key, value in props do
		if key ~= "Parent" then
			(label :: any)[key] = value
		end
	end
	Ui.new("UITextSizeConstraint", { MaxTextSize = maxTextSize or 28, Parent = label })
	label.Parent = props.Parent
	return label
end

-- 텍스트에 명소 등급 색을 입힘
function Ui.paintTier(label: TextLabel | TextButton, tier: { Color: Color3 })
	label.TextColor3 = tier.Color
end

-- 별 개수(0~max) -> "★★★☆☆"
function Ui.stars(count: number, max: number?): string
	local total = max or 5
	local filled = math.clamp(math.floor(count), 0, total)
	return string.rep("★", filled) .. string.rep("☆", total - filled)
end

-- RichText 별: 채운 별은 Sun 색, 빈 별은 흐린 색 (글자 테두리와 함께 쓰면 통통한 별이 됨)
function Ui.starsRich(count: number, max: number?, emptyColor: Color3?): string
	local total = max or 5
	local filled = math.clamp(math.floor(count), 0, total)
	return string.format(
		'<font color="%s">%s</font><font color="%s">%s</font>',
		Format.hex(COLORS.Sun.Face),
		string.rep("★", filled),
		Format.hex(emptyColor or rgb(226, 212, 182)),
		string.rep("★", total - filled)
	)
end

-- 1.25 -> "×1.25", 100 이상은 소수 없이 콤마 자연수(버림): 1024 -> "×1,024", 15360.4 -> "×15,360"
-- (환생 행운이 ×2^환생 수라 후반 행운 딱지가 "×15360.4" 처럼 길어지지 않게)
function Ui.times(value: number): string
	if value >= 100 then
		return "×" .. Format.commas(math.floor(value + 1e-9))
	end
	return "×" .. Format.multiplier(value):sub(2)
end

-- 그림 --------------------------------------------------------------------------

-- 화면 모서리 반지름(px) -> SliceScale. height 를 주면 모서리 조각이 높이의 절반을 넘지 않게
local function sliceScale(name: string, radius: number, height: number?): number
	local spec = SKINS[name] or DEFAULT_SKIN
	local scale = radius / spec.Radius
	if height then
		scale = math.min(scale, height / 2 / spec.Margin)
	end
	return scale
end

-- 9-slice 설정. options: { Scale?(SliceScale 직접) 또는 Radius + Height?, CenterColor? }
-- CenterColor: 늘어나는 가운데 조각을 그 색 평면으로 덮음(종이 점무늬가 한쪽으로 몇 배씩 늘어나 얼룩지지 않게)
local function applySlice(image: ImageLabel, name: string, options: { [string]: any })
	local margin = (SKINS[name] or DEFAULT_SKIN).Margin
	local scale = options.Scale or sliceScale(name, options.Radius, options.Height)
	image.ScaleType = Enum.ScaleType.Slice
	image.SliceCenter = Rect.new(margin, margin, SKIN_SIZE - margin, SKIN_SIZE - margin)
	image.SliceScale = scale
	if options.CenterColor then
		local inset = margin * scale
		Ui.new("Frame", {
			Name = "Center",
			Position = UDim2.fromOffset(inset, inset),
			Size = UDim2.new(1, -2 * inset, 1, -2 * inset),
			BackgroundColor3 = options.CenterColor,
			BorderSizePixel = 0,
			Parent = image,
		})
	end
end

-- 스킨 그림을 대상 맨 뒤에 깔고 대상의 바탕·테두리(UIStroke)는 끔. 그림 Id 가 없으면 nil(기존 Frame 모양 그대로).
-- 테두리를 붙인 "뒤에" 불러야 함. 크기가 고정이고 UIPadding/UIListLayout 이 없는 상자용
-- (알약·딱지처럼 자동 크기/여백이 있는 상자는 Ui.box). props: { Radius?(화면에서 보일 모서리 반지름 px,
--   없으면 통째로 늘임), Height?(대상 높이 px), Scale?(SliceScale 직접), CenterColor?, Color?(ImageColor3), Transparency? }
function Ui.skin(target: GuiObject, name: string, props: { [string]: any }?): ImageLabel?
	local id = Ui.imageId(name)
	if not id then
		return nil
	end
	local options = props or {}
	target.BackgroundTransparency = 1
	for _, child in target:GetChildren() do
		if child:IsA("UIStroke") and child.ApplyStrokeMode == Enum.ApplyStrokeMode.Border then
			child.Enabled = false
		end
	end
	local image = Ui.new("ImageLabel", {
		Name = "Skin",
		BackgroundTransparency = 1,
		Image = id,
		ImageColor3 = options.Color or WHITE,
		ImageTransparency = options.Transparency or 0,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 0, -- 대상 안의 다른 것들(글자·아이콘)보다 뒤
	})
	if options.Radius or options.Scale then
		applySlice(image, name, options)
	else
		image.ScaleType = Enum.ScaleType.Stretch
	end
	image.Parent = target
	return image
end

-- 스킨 그림 "자체"가 상자인 ImageLabel(그림이 있을 때) 또는 평범한 Frame(없을 때).
-- 자동 크기(AutomaticSize)나 UIPadding/UIListLayout 이 붙는 상자(알약·딱지)용: 그림이 여백·배치에 밀리지 않음.
-- props: { Radius, Height?, Color?(Frame 바탕색 = 그림 색), Transparency?,
--          ImageColor?/ImageTransparency?(그림일 때만 다르게: 이미 색이 칠해진 그림용) }
-- 반환: 상자, 스킨 여부(Frame 이면 UICorner/UIStroke 는 부르는 쪽이 붙임)
function Ui.box(name: string, props: { [string]: any }): (GuiObject, boolean)
	local id = Ui.imageId(name)
	if not id then
		return Ui.new("Frame", {
			BackgroundColor3 = props.Color or WHITE,
			BackgroundTransparency = props.Transparency or 0,
		}),
			false
	end
	local image = Ui.new("ImageLabel", {
		BackgroundTransparency = 1,
		Image = id,
		ImageColor3 = props.ImageColor or props.Color or WHITE,
		ImageTransparency = props.ImageTransparency or props.Transparency or 0,
	})
	applySlice(image, name, props)
	image:SetAttribute("Skin", name)
	return image, true
end

export type Ribbon = { Root: Frame, Label: TextLabel, SetColor: (face: Color3, shadow: Color3) -> () }

-- 제목 리본: 코드로 그린 이름판(그림자 판 + 위가 밝은 앞면 + 광택 줄 + Ink 테두리) 양 끝 뒤에 V 꼬리 그림.
-- 판은 Frame 이라 화면 크기와 상관없이 또렷하고, 꼬리 그림은 9-slice 로 늘이지 않아 모양이 찌그러지지 않음.
-- 꼬리 그림(ImageIds.ribbon_tail_l/r)이 없으면 둥근 네모 Frame 꼬리.
-- props: { Size(오프셋: 가로 x 판 높이), Position, AnchorPoint, Name?, ZIndex?, Visible?, MaxTextSize?, Outline?, Parent? }
function Ui.ribbon(props: { [string]: any }): Ribbon
	local theme = Ui.Theme
	local size: UDim2 = props.Size
	local k = size.Y.Offset / RIBBON_BASE_HEIGHT
	local root = Ui.new("Frame", {
		Name = props.Name or "Ribbon",
		AnchorPoint = props.AnchorPoint or Vector2.new(0.5, 0.5),
		Position = props.Position or UDim2.new(),
		Size = size,
		BackgroundTransparency = 1,
		ZIndex = props.ZIndex or 1,
		Visible = props.Visible ~= false,
	})

	-- 꼬리 (판 뒤). 오른쪽은 왼쪽을 정확히 뒤집은 자리: 크기·위치를 먼저 정수로 반올림해 좌우가 1px 도 어긋나지 않게
	local tailImages: { ImageLabel } = {}
	local tailFrames: { Frame } = {}
	local tailW, tailH = math.round(RIBBON_TAIL.Size.X * k), math.round(RIBBON_TAIL.Size.Y * k)
	local tailLeft, tailTop = math.round(RIBBON_TAIL.Left * k), math.round(RIBBON_TAIL.Top * k)
	-- 그림 없을 때: 그림의 꼬리 몸통 자리(왼쪽 그림 56x50 중 x 3..54, y 5..41)에 둥근 네모
	local bodyX, bodyY = math.round(3 * k), math.round(5 * k)
	local bodyW, bodyH = math.round(51 * k), math.round(36 * k)
	for _, side in { "l", "r" } do
		local image = Ui.imageId("ribbon_tail_" .. side)
		local x, w, y, h
		if image then
			x, w, y, h = tailLeft, tailW, tailTop, tailH
		else
			x, w, y, h = tailLeft + bodyX, bodyW, tailTop + bodyY, bodyH
		end
		-- 왼쪽: 판 왼쪽 끝 + x / 오른쪽: 판 오른쪽 끝 - (x + w)
		local position = if side == "l" then UDim2.fromOffset(x, y) else UDim2.new(1, -(x + w), 0, y)
		if image then
			table.insert(
				tailImages,
				Ui.new("ImageLabel", {
					Name = "Tail",
					Position = position,
					Size = UDim2.fromOffset(w, h),
					BackgroundTransparency = 1,
					Image = image,
					ScaleType = Enum.ScaleType.Stretch,
					ZIndex = 1,
					Parent = root,
				})
			)
		else
			local tail = Ui.new("Frame", {
				Name = "Tail",
				Position = position,
				Size = UDim2.fromOffset(w, h),
				BorderSizePixel = 0,
				ZIndex = 1,
				Parent = root,
			})
			Ui.corner(8 * k).Parent = tail
			Ui.stroke(theme.Ink, 3).Parent = tail
			table.insert(tailFrames, tail)
		end
	end

	-- 판: 그림자 색 바탕 위에 아래 RIBBON_SHADE 만큼 짧은 앞면
	local plate = Ui.new("Frame", {
		Name = "Plate",
		Size = UDim2.fromScale(1, 1),
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = root,
	})
	Ui.corner(RIBBON_CORNER * k).Parent = plate
	Ui.stroke(theme.Ink, 3).Parent = plate
	local face = Ui.new("Frame", {
		Name = "Face",
		Size = UDim2.new(1, 0, 1, -RIBBON_SHADE * k),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		ZIndex = 1,
		Parent = plate,
	})
	Ui.corner(RIBBON_CORNER * k).Parent = face
	local gradient = Ui.new("UIGradient", { Rotation = 90, Parent = face })
	local gloss = Ui.new("Frame", {
		Name = "Gloss",
		Position = UDim2.fromOffset(10 * k, 5 * k),
		Size = UDim2.new(1, -20 * k, 0, 3 * k),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.45,
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = plate,
	})
	Ui.round().Parent = gloss
	local label = Ui.label({
		Name = "Title",
		Position = UDim2.fromOffset(12 * k, 3 * k),
		Size = UDim2.new(1, -24 * k, 1, -(RIBBON_SHADE + 5) * k),
		TextColor3 = WHITE,
		ZIndex = 3,
		Parent = plate,
	}, props.MaxTextSize or 30)
	Ui.outline(label, props.Outline or 3)

	local function setColor(faceColor: Color3, shadow: Color3)
		plate.BackgroundColor3 = shadow
		gradient.Color = Ui.faceGradient(faceColor)
		for _, tail in tailImages do
			tail.ImageColor3 = faceColor -- 회색 그림이라 앞면 색을 곱하면 한 단계 어두운 색
		end
		for _, tail in tailFrames do
			tail.BackgroundColor3 = shadow
		end
	end
	setColor(WHITE, WHITE)

	root.Parent = props.Parent
	return { Root = root, Label = label, SetColor = setColor }
end

-- 바탕색 바꾸기 (스킨 그림이면 그림 색을)
function Ui.tint(target: GuiObject, color: Color3)
	if target:IsA("ImageLabel") and target:GetAttribute("Skin") ~= nil then
		target.ImageColor3 = color
		return
	end
	target.BackgroundColor3 = color
	local skin = target:FindFirstChild("Skin")
	if skin and skin:IsA("ImageLabel") then
		skin.ImageColor3 = color
	end
end

-- 아이콘 하나: 그림이 있으면 ImageLabel, 없으면 3D 미니 모형. 자세한 건 Icons.view
-- props: { Size, Position, AnchorPoint, ZIndex, LayoutOrder, Spin?, Color?(그림 ImageColor3), Transparency? }
function Ui.icon(parent: Instance?, name: string, props: { [string]: any }?): Frame
	return icons().view(parent, name, props)
end

-- 키보드 단축키 키캡 (작은 크림색 네모 + Ink 글자). 키보드가 없는 기기에서는 숨김
-- props: { Size?(한 변 px), Position, AnchorPoint, Rotation?, ZIndex? }
function Ui.keyCap(parent: Instance, key: string, props: { [string]: any }?): Frame
	local options = props or {}
	local size = options.Size or 26
	local cap = Ui.new("Frame", {
		Name = "Key" .. key,
		AnchorPoint = options.AnchorPoint or Vector2.new(0.5, 0.5),
		Position = options.Position or UDim2.new(),
		Size = UDim2.fromOffset(size, size),
		BackgroundColor3 = Ui.Theme.Cream,
		Rotation = options.Rotation or -8,
		ZIndex = options.ZIndex or 7,
		Visible = UserInputService.KeyboardEnabled,
	})
	Ui.corner(7).Parent = cap
	Ui.stroke(Ui.Theme.Ink, 2.5).Parent = cap
	Ui.label({
		Name = "Key",
		Text = key,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 2,
		Parent = cap,
	}, math.floor(size * 0.72))
	cap.Parent = parent
	return cap
end

-- 통통 버튼 ------------------------------------------------------------------

export type ChunkyButton = {
	Root: Frame,
	Face: TextButton,
	Shadow: Frame,
	Label: TextLabel,
	Icon: Frame?,
	Activated: RBXScriptSignal,
	SetColor: (name: string | ColorPair) -> (), -- 색 이름 또는 색 쌍 표(같은 표를 다시 주면 건너뜀)
	SetText: (text: string) -> (),
	SetIcon: (name: string?) -> (),
}

-- 누른 채로 버튼 밖에서 손을 떼도 앞면이 다시 올라오도록, 눌린 버튼을 모아 두었다가 입력이 끝나면 모두 올림
local held: { [() -> ()]: boolean } = {}
UserInputService.InputEnded:Connect(function(input)
	local kind = input.UserInputType
	if kind ~= Enum.UserInputType.MouseButton1 and kind ~= Enum.UserInputType.Touch then
		return
	end
	local list = {}
	for release in held do
		table.insert(list, release)
	end
	table.clear(held)
	for _, release in list do
		release()
	end
end)

-- props: { Color = "Grass"|"Sky"|"Sun"|"Coral"|"Grape"|"Gray" 또는 색 쌍 표, Size, Position, AnchorPoint, LayoutOrder, Text,
--          TextSize?(최대 글자 크기), Parent, Icon?(Icons 이름), IconSize?, IconSpin?, Vertical?(아이콘 위·글자 아래),
--          Round?(동그라미), Name?, ZIndex?, Visible? }
-- Size 는 그림자까지 포함한 전체 크기(오프셋). 앞면 높이 = Size.Y - 6. 글자가 비어 있으면 아이콘을 가운데에.
-- 스킨: ImageIds.button_face / button_shadow 가 있으면 그 그림을 색으로 물들여 씀
function Ui.chunkyButton(props: { [string]: any }): ChunkyButton
	local size: UDim2 = props.Size or UDim2.fromOffset(160, 64)
	local faceHeight = math.max(12, size.Y.Offset - SHADOW_DEPTH)
	local radius = if props.Round then UDim.new(0.5, 0) else UDim.new(0, props.CornerRadius or BUTTON_CORNER)
	local vertical = props.Vertical == true
	local iconSize = props.IconSize or math.floor(faceHeight * (if vertical then 0.58 else 0.8))
	local skinRadius = if props.Round then faceHeight / 2 else (props.CornerRadius or BUTTON_CORNER)

	local root = Ui.new("Frame", {
		Name = props.Name or "Button",
		Size = size,
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.new(0, 0),
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = props.ZIndex or 1,
		Visible = props.Visible ~= false,
		BackgroundTransparency = 1,
	})
	local hover = Ui.new("UIScale", { Parent = root })

	local shadow = Ui.new("Frame", {
		Name = "Shadow",
		Position = UDim2.fromOffset(0, SHADOW_DEPTH),
		Size = UDim2.new(1, 0, 1, -SHADOW_DEPTH),
		BorderSizePixel = 0,
		ZIndex = 1,
		Parent = root,
	})
	Ui.new("UICorner", { CornerRadius = radius, Parent = shadow })
	Ui.stroke().Parent = shadow
	local shadowSkin = Ui.skin(shadow, "button_shadow", { Radius = skinRadius, Height = faceHeight })

	local face = Ui.new("TextButton", {
		Name = "Face",
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.new(1, 0, 1, -SHADOW_DEPTH),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = root,
	})
	Ui.new("UICorner", { CornerRadius = radius, Parent = face })
	Ui.stroke().Parent = face
	local gradient = Ui.new("UIGradient", { Rotation = 90, Parent = face })
	local faceSkin = Ui.skin(face, "button_face", { Radius = skinRadius, Height = faceHeight })

	-- 왼쪽 위 반짝이(만화풍 광택). 스킨 그림에는 광택이 그려져 있음
	if not props.Round and not faceSkin then
		local shine = Ui.new("Frame", {
			Name = "Shine",
			Position = UDim2.fromOffset(9, 5),
			Size = UDim2.new(0.32, 0, 0, 6),
			BackgroundColor3 = WHITE,
			BackgroundTransparency = 0.55,
			BorderSizePixel = 0,
			ZIndex = 1,
			Parent = face,
		})
		Ui.round().Parent = shine
	end

	local label = Ui.label({
		Name = "Label",
		Text = props.Text or "",
		TextColor3 = WHITE,
		ZIndex = 4,
		Parent = face,
	}, props.TextSize or 26)
	Ui.outline(label, props.OutlineThickness or 2.5)

	local button = {
		Root = root,
		Face = face,
		Shadow = shadow,
		Label = label,
		Icon = nil,
		Activated = face.Activated,
	} :: any

	local iconName: string? = nil
	local function layout()
		local icon = button.Icon
		if icon and label.Text == "" then
			icon.AnchorPoint = Vector2.new(0.5, 0.5)
			icon.Position = UDim2.fromScale(0.5, 0.5)
			icon.Size = UDim2.fromOffset(iconSize, iconSize)
		elseif icon and vertical then
			icon.AnchorPoint = Vector2.new(0.5, 0)
			icon.Position = UDim2.new(0.5, 0, 0, 3)
			icon.Size = UDim2.fromOffset(iconSize, iconSize)
			label.Position = UDim2.fromOffset(4, iconSize + 2)
			label.Size = UDim2.new(1, -8, 1, -(iconSize + 6))
		elseif icon then
			icon.AnchorPoint = Vector2.new(0, 0.5)
			icon.Position = UDim2.new(0, 6, 0.5, 0)
			icon.Size = UDim2.fromOffset(iconSize, iconSize)
			label.Position = UDim2.fromOffset(iconSize + 8, 4)
			label.Size = UDim2.new(1, -(iconSize + 16), 1, -8)
		else
			label.Position = UDim2.fromOffset(8, 4)
			label.Size = UDim2.new(1, -16, 1, -8)
		end
	end

	-- 아이콘 바꾸기 (nil 이면 아이콘 없이 글자만)
	local function setIcon(name: string?)
		if name == iconName then
			return
		end
		iconName = name
		local icon = button.Icon
		if name and icon then
			icons().set(icon, name)
		elseif name then
			button.Icon = icons().view(face, name, { ZIndex = 3, Spin = props.IconSpin })
		elseif icon then
			icon:Destroy()
			button.Icon = nil
		end
		layout()
	end

	local colorName: (string | ColorPair)? = nil
	local function setColor(name: string | ColorPair)
		if name == colorName then
			return
		end
		colorName = name
		local pair = Ui.colorPair(name)
		gradient.Color = Ui.faceGradient(pair.Face)
		shadow.BackgroundColor3 = pair.Shadow
		if faceSkin then
			faceSkin.ImageColor3 = pair.Face
		end
		if shadowSkin then
			shadowSkin.ImageColor3 = pair.Shadow
		end
	end

	-- 누름: 앞면이 4px 내려갔다가 올라옴 / 마우스를 올리면 1.05배
	local pressed = false
	local lastPress = 0
	local function release()
		held[release] = nil
		if not pressed then
			return
		end
		pressed = false
		TweenService:Create(face, RELEASE_TWEEN, { Position = UDim2.fromOffset(0, 0) }):Play()
	end
	local function press()
		lastPress = os.clock()
		if pressed then
			return
		end
		pressed = true
		held[release] = true
		TweenService:Create(face, PRESS_TWEEN, { Position = UDim2.fromOffset(0, PRESS_DEPTH) }):Play()
	end
	face.MouseButton1Down:Connect(press)
	face.MouseButton1Up:Connect(release)
	face.MouseEnter:Connect(function()
		if UserInputService.MouseEnabled then
			TweenService:Create(hover, HOVER_TWEEN, { Scale = 1.05 }):Play()
		end
	end)
	face.MouseLeave:Connect(function()
		release()
		TweenService:Create(hover, HOVER_TWEEN, { Scale = 1 }):Play()
	end)
	face.Activated:Connect(function()
		if pressed then
			release()
		elseif os.clock() - lastPress > 0.4 then
			-- 키보드/게임패드로 누른 경우: 짧게 눌렸다 올라옴
			press()
			task.delay(0.07, release)
		end
	end)

	button.SetColor = setColor
	button.SetText = function(text: string)
		if label.Text ~= text then
			local relayout = label.Text == "" or text == ""
			label.Text = text
			if relayout then
				layout()
			end
		end
	end
	button.SetIcon = setIcon

	setColor(props.Color or "Sky")
	setIcon(props.Icon)
	layout()

	root.Parent = props.Parent
	return button :: ChunkyButton
end

-- 창 -------------------------------------------------------------------------

-- 닫기 버튼: close 그림이 있으면 그림 한 장(ImageButton), 없으면 빨간 동그라미 통통 버튼
export type CloseButton = { Root: GuiObject, Activated: RBXScriptSignal }

export type Window = {
	Root: Frame,
	Panel: Frame,
	Body: Frame,
	Ribbon: Frame,
	Title: TextLabel,
	Close: CloseButton,
	SetColor: (name: string) -> (),
}

local RIBBON_HEIGHT = 50 -- 제목 리본 판 높이
local BODY_TOP = 45 -- 창 위 끝에서 본문까지 (리본 판 아래 25 + 꼬리가 처지는 만큼)

-- 그림 한 장이 곧 버튼(close.png 처럼 완성된 버튼 그림). 마우스를 올리면 1.08배, 누르면 0.9배
local function imageButton(props: { [string]: any }): ImageButton
	local button = Ui.new("ImageButton", {
		Name = props.Name or "ImageButton",
		AnchorPoint = props.AnchorPoint or Vector2.new(0.5, 0.5),
		Position = props.Position or UDim2.new(),
		Size = props.Size,
		BackgroundTransparency = 1,
		Image = props.Image,
		ScaleType = Enum.ScaleType.Fit,
		AutoButtonColor = false,
		ZIndex = props.ZIndex or 1,
	})
	local scale = Ui.new("UIScale", { Parent = button })
	local hovered = false
	local function scaleTo(value: number)
		TweenService:Create(scale, HOVER_TWEEN, { Scale = value }):Play()
	end
	local function release()
		held[release] = nil
		scaleTo(if hovered then 1.08 else 1)
	end
	button.MouseEnter:Connect(function()
		hovered = UserInputService.MouseEnabled
		scaleTo(if hovered then 1.08 else 1)
	end)
	button.MouseLeave:Connect(function()
		hovered = false
		release()
	end)
	button.MouseButton1Down:Connect(function()
		held[release] = true
		scaleTo(0.9)
	end)
	button.MouseButton1Up:Connect(release)
	button.Parent = props.Parent
	return button
end

-- props: { Size, Position, AnchorPoint, Title, Color(리본 색 이름), RibbonWidth?, Name?, ZIndex?, Visible?, Parent }
-- Cream 바탕 + Ink 테두리 4 + 모서리 18, 위 가운데에 색 리본 제목, 오른쪽 위에 빨간 동그라미 닫기 버튼
-- 스킨: ImageIds.panel_paper(창 바탕, 물들이지 않음) / ribbon_tail_l·r(리본 꼬리, Ui.ribbon) / close(닫기 버튼 그림 그대로)
function Ui.window(props: { [string]: any }): Window
	local theme = Ui.Theme
	local root = Ui.new("Frame", {
		Name = props.Name or "Window",
		Size = props.Size or UDim2.fromOffset(720, 480),
		Position = props.Position or UDim2.fromScale(0.5, 0.5),
		AnchorPoint = props.AnchorPoint or Vector2.new(0.5, 0.5),
		ZIndex = props.ZIndex or 1,
		Visible = props.Visible ~= false,
		BackgroundTransparency = 1,
	})

	-- 아래 두께(립): 종이 책처럼 두툼하게
	local lip = Ui.new("Frame", {
		Name = "Lip",
		Position = UDim2.fromOffset(0, 8),
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = theme.PaperDark,
		ZIndex = 1,
		Parent = root,
	})
	Ui.corner(18).Parent = lip
	Ui.stroke(theme.Ink, 4).Parent = lip
	Ui.skin(lip, "panel_paper", { Radius = 18, Color = theme.PaperDark })

	local panel = Ui.new("Frame", {
		Name = "Panel",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = theme.Cream,
		ZIndex = 2,
		Parent = root,
	})
	Ui.corner(18).Parent = panel
	Ui.stroke(theme.Ink, 4).Parent = panel
	-- 안쪽 종이 테두리
	local inner = Ui.new("Frame", {
		Name = "Inner",
		Position = UDim2.fromOffset(8, 8),
		Size = UDim2.new(1, -16, 1, -16),
		BackgroundTransparency = 1,
		Parent = panel,
	})
	Ui.corner(12).Parent = inner
	Ui.stroke(theme.Paper, 3).Parent = inner
	-- 종이 가운데 조각은 창 크기만큼(가로 약 5배) 늘어나 점무늬가 얼룩지므로 같은 크림색 평면으로 덮음
	if Ui.skin(panel, "panel_paper", { Radius = 18, CenterColor = theme.Cream }) then
		inner.Visible = false -- 종이 그림에 안쪽 테두리가 들어 있음
	end

	-- 리본 제목: 판 가운데가 창 위 끝에서 4px 아래
	local ribbon = Ui.ribbon({
		Name = "Ribbon",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0, 4),
		Size = UDim2.fromOffset(props.RibbonWidth or 340, RIBBON_HEIGHT),
		ZIndex = 3,
		MaxTextSize = 30,
		Outline = 3,
		Parent = root,
	})
	ribbon.Label.Text = props.Title or ""

	-- 닫기: close.png 는 빨간 동그라미 + X 가 다 그려진 버튼 그림이라 그대로 버튼으로 씀
	local closeImage = Ui.imageId("close")
	local close: CloseButton
	if closeImage then
		local button = imageButton({
			Name = "Close",
			Image = closeImage,
			Position = UDim2.new(1, -8, 0, 8),
			Size = UDim2.fromOffset(CLOSE_ART_SIZE, CLOSE_ART_SIZE),
			ZIndex = 4,
			Parent = root,
		})
		close = { Root = button, Activated = button.Activated }
	else
		close = Ui.chunkyButton({
			Name = "Close",
			Color = "Coral",
			Round = true,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(1, -8, 0, 8),
			Size = UDim2.fromOffset(52, 58),
			Text = "X",
			TextSize = 30,
			OutlineThickness = 3,
			ZIndex = 4,
			Parent = root,
		})
	end

	local top = BODY_TOP
	local body = Ui.new("Frame", {
		Name = "Body",
		Position = UDim2.fromOffset(18, top),
		Size = UDim2.new(1, -36, 1, -(top + 16)),
		BackgroundTransparency = 1,
		Parent = panel,
	})

	local colorName: string? = nil
	local function setColor(name: string)
		if name == colorName then
			return
		end
		colorName = name
		local pair = Ui.colorPair(name)
		ribbon.SetColor(pair.Face, pair.Shadow)
	end
	setColor(props.Color or "Sky")

	root.Parent = props.Parent
	return {
		Root = root,
		Panel = panel,
		Body = body,
		Ribbon = ribbon.Root,
		Title = ribbon.Label,
		Close = close,
		SetColor = setColor,
	}
end

-- 알약 / 칩 --------------------------------------------------------------------

export type Pill = { Root: GuiObject, Label: TextLabel, Icon: Frame? }

-- 캡슐 모양 반투명 Ink 바탕 + 흰 글자(테두리). 왼쪽에 테두리를 살짝 넘는 동그란 아이콘(선택).
-- 스킨: ImageIds.pill 이 있으면 그 그림을 씀. 그림이 이미 반투명 Ink(+ 불투명 테두리·광택)라 물들이지 않음
-- props: { Size(높이는 오프셋), Position, AnchorPoint, LayoutOrder, Parent, Text, TextColor3?, MaxTextSize?,
--          AutoWidth?(글자 길이에 맞춰 가로 자동, TextSize 사용), TextSize?, TextXAlignment?,
--          Icon?(Icons 이름), IconSize?, IconSpin?, IconBack?(아이콘 뒤 동그라미 색), BackgroundTransparency?, Name?, ZIndex?, Visible? }
function Ui.pill(props: { [string]: any }): Pill
	local theme = Ui.Theme
	local size: UDim2 = props.Size or UDim2.fromOffset(200, 40)
	local height = size.Y.Offset
	local autoWidth = props.AutoWidth == true
	local iconSize = props.IconSize or math.floor(height * 1.3)
	-- 아이콘 중심은 알약 왼쪽 끝에서 조금 안쪽 → 아이콘이 왼쪽 테두리를 살짝 넘어감
	local iconCenter = math.floor(iconSize * 0.28)
	local leftPad = if props.Icon then iconCenter + math.ceil(iconSize / 2) + 6 else 16

	local transparency = props.BackgroundTransparency or 0.3
	local root, skinned = Ui.box("pill", {
		Radius = height / 2,
		Height = height,
		Color = theme.Ink,
		Transparency = transparency,
		-- 그림은 물들이지 않고, 그림 몸통(불투명도 62%)보다 더 투명하게 해 달라고 할 때만 그만큼 더 투명하게
		ImageColor = WHITE,
		ImageTransparency = math.max(0, 1 - (1 - transparency) / PILL_ART_OPACITY),
	})
	root.Name = props.Name or "Pill"
	root.Size = if autoWidth then UDim2.fromOffset(0, height) else size
	root.AutomaticSize = if autoWidth then Enum.AutomaticSize.X else Enum.AutomaticSize.None
	root.Position = props.Position or UDim2.new()
	root.AnchorPoint = props.AnchorPoint or Vector2.new(0, 0)
	root.LayoutOrder = props.LayoutOrder or 0
	root.ZIndex = props.ZIndex or 1
	root.Visible = props.Visible ~= false
	if not skinned then
		Ui.round().Parent = root
		Ui.stroke(theme.Ink, 3).Parent = root
	end
	Ui.new("UIPadding", {
		PaddingLeft = UDim.new(0, leftPad),
		PaddingRight = UDim.new(0, props.PadRight or 16),
		Parent = root,
	})

	local label = Ui.label({
		Name = "Label",
		Text = props.Text or "",
		TextColor3 = props.TextColor3 or WHITE,
		TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left,
		TextScaled = not autoWidth,
		TextSize = props.TextSize or 20,
		AutomaticSize = if autoWidth then Enum.AutomaticSize.X else Enum.AutomaticSize.None,
		Size = if autoWidth then UDim2.fromScale(0, 1) else UDim2.fromScale(1, 1),
		ZIndex = 2,
		Parent = root,
	}, props.MaxTextSize or 30)
	Ui.outline(label, 2.5)

	local icon: Frame? = nil
	if props.Icon then
		-- UIPadding 만큼 안쪽에서 시작하므로 왼쪽 여백을 빼서 위치를 맞춤
		local position = UDim2.new(0, iconCenter - leftPad, 0.5, 0)
		if props.IconBack then
			local disc = Ui.new("Frame", {
				Name = "IconBack",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = position,
				Size = UDim2.fromOffset(iconSize, iconSize),
				BackgroundColor3 = props.IconBack,
				ZIndex = 3,
				Parent = root,
			})
			Ui.round().Parent = disc
			Ui.stroke(theme.Ink, 3).Parent = disc
			icon = icons().view(disc, props.Icon, {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromScale(0.84, 0.84),
				ZIndex = 4,
				Spin = props.IconSpin,
			})
		else
			icon = icons().view(root, props.Icon, {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = position,
				Size = UDim2.fromOffset(iconSize, iconSize),
				ZIndex = 3,
				Spin = props.IconSpin,
			})
		end
	end

	root.Parent = props.Parent
	return { Root = root, Label = label, Icon = icon }
end

export type Chip = { Root: GuiObject, Label: TextLabel, Icon: Frame? }

local CHIP_PAD = 0.42 -- 딱지 좌우 여백 (높이 대비)
local CHIP_ICON_PAD = 0.12 -- 아이콘 쪽 여백 (아이콘이 딱지 끝에 붙어 살짝 삐져나옴)

-- 작은 색 캡슐 딱지 (글자 길이에 맞춰 가로 자동). 흰 글자 + Ink 테두리. 아이콘을 주면 [아이콘][글자].
-- props: { Color = 색 이름 또는 Color3, Text, Height?, TextSize?, TextColor3?, Font?, Outline?(false 면 글자 테두리 없음),
--          StrokeThickness?, CornerRadius?, MinWidth?, Rotation?, Icon?(Icons 이름), IconSize?, IconOnly?(글자 없이 아이콘만),
--          Position, AnchorPoint, LayoutOrder, ZIndex, Visible, Parent }
-- 스킨: ImageIds.tag 가 있으면 그 그림을 바탕색으로 물들여 씀 (색을 바꿀 땐 Ui.tint(chip.Root, 색))
function Ui.chip(props: { [string]: any }): Chip
	local height = props.Height or 28
	local color = props.Color
	local background = if typeof(color) == "Color3" then color else Ui.colorPair(color or "Sky").Face
	local iconName = props.Icon
	local iconOnly = iconName ~= nil and props.IconOnly == true

	local root, skinned =
		Ui.box("tag", { Radius = props.CornerRadius or height / 2, Height = height, Color = background })
	root.Name = props.Name or "Chip"
	root.Size = UDim2.fromOffset(props.MinWidth or 0, height)
	root.AutomaticSize = Enum.AutomaticSize.X
	root.Position = props.Position or UDim2.new()
	root.AnchorPoint = props.AnchorPoint or Vector2.new(0, 0)
	root.LayoutOrder = props.LayoutOrder or 0
	root.Rotation = props.Rotation or 0
	root.ZIndex = props.ZIndex or 1
	root.Visible = props.Visible ~= false
	if not skinned then
		if props.CornerRadius then
			Ui.corner(props.CornerRadius).Parent = root
		else
			Ui.round().Parent = root
		end
		Ui.stroke(Ui.Theme.Ink, props.StrokeThickness or 2.5).Parent = root
	end
	local pad = math.floor(height * CHIP_PAD)
	local iconPad = math.floor(height * CHIP_ICON_PAD)
	Ui.new("UIPadding", {
		PaddingLeft = UDim.new(0, if iconName then iconPad else pad),
		PaddingRight = UDim.new(0, if iconOnly then iconPad else pad),
		Parent = root,
	})

	local label = Ui.label({
		Name = "Label",
		LayoutOrder = 2,
		Text = props.Text or "",
		Font = props.Font or Ui.Theme.Font,
		TextColor3 = props.TextColor3 or WHITE,
		TextScaled = false,
		TextSize = props.TextSize or math.floor(height * 0.62),
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromScale(0, 1),
		ZIndex = 2,
		Parent = root,
	}, 100)
	if props.Outline ~= false then
		Ui.outline(label, props.OutlineThickness or 2)
	end
	label.Visible = not iconOnly -- 안 보이는 글자는 UIListLayout 이 건너뜀

	local icon: Frame? = nil
	if iconName then
		-- 아이콘은 딱지보다 살짝 커서 위아래로 조금 삐져나옴
		Ui.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, math.floor(height * 0.14)),
			SortOrder = Enum.SortOrder.LayoutOrder,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Parent = root,
		})
		local iconSize = props.IconSize or math.floor(height * 1.2)
		icon = icons().view(root, iconName, {
			Size = UDim2.fromOffset(iconSize, iconSize),
			LayoutOrder = 1,
			ZIndex = 3,
			Spin = props.IconSpin,
		})
	end

	root.Parent = props.Parent
	return { Root = root, Label = label, Icon = icon }
end

-- 딱지 아이콘 보이기/숨기기 (숨기면 왼쪽 여백도 글자만 있는 딱지와 같게)
function Ui.showChipIcon(chip: Chip, visible: boolean)
	local icon = chip.Icon
	local padding = chip.Root:FindFirstChildOfClass("UIPadding")
	if not icon or not padding or icon.Visible == visible then
		return
	end
	icon.Visible = visible
	local height = chip.Root.Size.Y.Offset
	padding.PaddingLeft = UDim.new(0, math.floor(height * (if visible then CHIP_ICON_PAD else CHIP_PAD)))
end

-- 화면 크기 자동 스케일 -------------------------------------------------------

-- 화면 크기에 맞춰 크기를 조절하는 UIScale 을 붙임 (AnchorPoint 기준으로 커지고 작아짐)
local scalers: { UIScale } = {}

-- 화면(카메라 ViewportSize) 전체 크기 = 로블록스 상단바까지 포함. 카메라가 없으면 기준 해상도
function Ui.viewport(): Vector2
	local camera = workspace.CurrentCamera
	return if camera then camera.ViewportSize else DESIGN_SIZE
end

-- 터치 전용 기기(휴대폰·태블릿)인지. 이런 기기에서는 로블록스가 조이스틱(왼쪽 아래)·점프 버튼(오른쪽 아래)을 띄움.
-- 키보드가 붙어 있으면(터치 노트북 등) PC 로 봄 — 키캡(Ui.keyCap)을 보이는 기준과 같음
function Ui.touchOnly(): boolean
	return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

local function currentScale(): number
	local viewport = Ui.viewport()
	return math.clamp(math.min(viewport.X / DESIGN_SIZE.X, viewport.Y / DESIGN_SIZE.Y), MIN_SCALE, MAX_SCALE)
end

function Ui.autoScale(object: GuiObject)
	local scale = Ui.new("UIScale", { Scale = currentScale(), Parent = object })
	table.insert(scalers, scale)
end

-- 지금 자동 스케일 배율 (0.55~0.9)
function Ui.scale(): number
	return currentScale()
end

-- 화면 크기가 바뀌어 배율을 다시 잰 뒤 부를 함수 (배율에 따라 자리를 다시 잡는 HUD 용)
local rescaleCallbacks: { (number) -> () } = {}
function Ui.onRescale(callback: (number) -> ())
	table.insert(rescaleCallbacks, callback)
end

local function refreshScales()
	local value = currentScale()
	for _, scale in scalers do
		scale.Scale = value
	end
	for _, callback in rescaleCallbacks do
		task.spawn(callback, value)
	end
end

local cameraConnection: RBXScriptConnection? = nil
local function watchCamera()
	if cameraConnection then
		cameraConnection:Disconnect()
	end
	local camera = workspace.CurrentCamera
	if camera then
		cameraConnection = camera:GetPropertyChangedSignal("ViewportSize"):Connect(refreshScales)
	end
	refreshScales()
end
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(watchCamera)
watchCamera()

return Ui
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">Viewport</string>
            <string name="Source"><![CDATA[-- ViewportFrame 에 명소 모형을 띄우는 헬퍼.
-- 정적인 썸네일(도감 카드)은 한 번 찍고 끝(매 프레임 작업 없음),
-- 회전이 필요한 화면(굴림 연출)만 setSpin 으로 등록해서 RenderStepped 루프 하나로 돌립니다.

local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Landmarks = require(Shared.Landmarks)
local Models = require(Shared:WaitForChild("Models"))

local Ui = require(script.Parent.Ui)

local FIELD_OF_VIEW = 30 -- 세로 시야각(도). 좁을수록 원근 왜곡이 적어 미니어처처럼 보임
local YAW = math.rad(35) -- 정면(-Z)에서 오른쪽으로 돌아간 각도 (3/4 시점)
local PITCH = math.rad(22) -- 내려다보는 각도
local MARGIN = 1.04

-- 모형 틀 정보는 ViewportFrame 의 속성(Attribute)에 저장 → 모듈 쪽에 따로 들고 있을 필요가 없어서
-- 카드가 Destroy 되어도 정리할 것이 없음
local ATTR_HEIGHT_CENTER = "ViewCenterY"
local ATTR_FLAT = "ViewFlat"
local ATTR_HALF_HEIGHT = "ViewHalfHeight"

local Viewport = {}

type SpinEntry = { Speed: number, Angle: number }

-- 회전 중인 화면들. 부모가 사라지면(Destroy) 루프에서 알아서 빠짐
local spinning: { [ViewportFrame]: SpinEntry } = {}
local spinConnection: RBXScriptConnection? = nil

local function currentModel(vf: ViewportFrame): Model?
	return vf:FindFirstChildOfClass("Model")
end

-- 저장해 둔 틀 정보로 카메라 위치를 정함 (화면 비율이 바뀌면 다시 호출)
local function frameCamera(vf: ViewportFrame)
	local camera = vf.CurrentCamera
	local centerY = vf:GetAttribute(ATTR_HEIGHT_CENTER)
	local flat = vf:GetAttribute(ATTR_FLAT)
	local halfHeight = vf:GetAttribute(ATTR_HALF_HEIGHT)
	if not camera or type(centerY) ~= "number" or type(flat) ~= "number" or type(halfHeight) ~= "number" then
		return
	end

	local absolute = vf.AbsoluteSize
	local aspect = if absolute.X > 0 and absolute.Y > 0 then absolute.X / absolute.Y else 1
	local tanV = math.tan(math.rad(camera.FieldOfView / 2))
	local tanH = tanV * aspect

	-- 화면에 비치는 대략적인 반높이/반너비. 가로는 회전해도 넘지 않도록 수직축에서 가장 먼 모서리 기준
	local projectedHalfHeight = halfHeight * math.cos(PITCH) + flat * math.sin(PITCH)
	local distance = math.max(projectedHalfHeight / tanV + flat * 0.5, flat / tanH + flat) * MARGIN

	local target = Vector3.new(0, centerY, 0)
	local direction = Vector3.new(math.sin(YAW) * math.cos(PITCH), math.sin(PITCH), -math.cos(YAW) * math.cos(PITCH))
	camera.CFrame = CFrame.lookAt(target + direction * distance, target)
end

-- 새 ViewportFrame (카메라·조명 포함). props 로 Size/Position 등을 덮어씀
function Viewport.new(parent: Instance?, props: { [string]: any }?): ViewportFrame
	local vf = Ui.new("ViewportFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Ambient = Color3.fromRGB(165, 165, 180),
		LightColor = Color3.fromRGB(255, 248, 235),
		-- 빛이 나아가는 방향. 카메라와 같은 쪽(앞·위·오른쪽)에서 비추도록
		LightDirection = Vector3.new(-0.6, -1, 0.8),
	})
	for key, value in props or {} do
		if key ~= "Parent" then
			(vf :: any)[key] = value
		end
	end

	local camera = Ui.new("Camera", { FieldOfView = FIELD_OF_VIEW, Parent = vf })
	vf.CurrentCamera = camera

	vf:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		frameCamera(vf)
	end)

	vf.Parent = parent
	return vf
end

-- 모형을 화면에 올림. 이전 모형은 지움. 모형 피벗(바닥 중앙)을 원점에 놓고 3/4 각도로 카메라를 맞춤
function Viewport.setModel(vf: ViewportFrame, model: Model?)
	for _, child in vf:GetChildren() do
		if child:IsA("Model") and child ~= model then
			child:Destroy()
		end
	end
	if not model then
		vf:SetAttribute(ATTR_HEIGHT_CENTER, nil)
		return
	end

	local entry = spinning[vf]
	model:PivotTo(CFrame.Angles(0, if entry then entry.Angle else 0, 0))
	model.Parent = vf

	local ok, boxCFrame, size = pcall(function()
		return model:GetBoundingBox()
	end)
	if not ok then
		return
	end
	-- 회전축(피벗, 원점)에서 가장 먼 모서리까지의 가로 거리
	local center = boxCFrame.Position
	local reachX = math.abs(center.X) + size.X / 2
	local reachZ = math.abs(center.Z) + size.Z / 2
	vf:SetAttribute(ATTR_HEIGHT_CENTER, center.Y)
	vf:SetAttribute(ATTR_FLAT, math.max(0.5, math.sqrt(reachX * reachX + reachZ * reachZ)))
	vf:SetAttribute(ATTR_HALF_HEIGHT, math.max(0.5, size.Y / 2))
	frameCamera(vf)
end

-- 명소 모형을 만들어 올림. 모형을 못 만들면 false (화면은 비워 둠)
function Viewport.setLandmark(vf: ViewportFrame, landmark: Landmarks.Landmark, size: number?): boolean
	local ok, model = pcall(Models.create, landmark, size or 10)
	if not ok or typeof(model) ~= "Instance" or not model:IsA("Model") then
		warn("[LandmarkRNG] 모형을 만들지 못했어요 (" .. landmark.Id .. "): " .. tostring(model))
		Viewport.setModel(vf, nil)
		return false
	end
	Viewport.setModel(vf, model)
	return true
end

-- 카드용 정적 썸네일 (회전 없음)
function Viewport.thumbnail(parent: Instance?, landmark: Landmarks.Landmark, props: { [string]: any }?): ViewportFrame
	local vf = Viewport.new(nil, props)
	Viewport.setLandmark(vf, landmark, 10)
	vf.Parent = parent
	return vf
end

local function step(dt: number)
	for vf, entry in spinning do
		if not vf.Parent then
			spinning[vf] = nil -- Destroy 된 화면
			continue
		end
		local model = currentModel(vf)
		if model then
			entry.Angle = (entry.Angle + math.rad(entry.Speed) * dt) % (2 * math.pi)
			model:PivotTo(CFrame.Angles(0, entry.Angle, 0))
		end
	end
end

-- 초당 degreesPerSecond 도로 수직축 회전. 0 이면 멈춤(현재 각도 유지)
function Viewport.setSpin(vf: ViewportFrame, degreesPerSecond: number)
	if degreesPerSecond == 0 then
		spinning[vf] = nil
		return
	end
	local entry = spinning[vf]
	if entry then
		entry.Speed = degreesPerSecond
	else
		spinning[vf] = { Speed = degreesPerSecond, Angle = 0 }
	end
	if not spinConnection then
		spinConnection = RunService.RenderStepped:Connect(step)
	end
end

return Viewport
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
