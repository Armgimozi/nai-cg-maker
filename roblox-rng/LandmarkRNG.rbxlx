end

-- 왼쪽 가운데: 네모 통통 버튼 4개 ---------------------------------------------

local MENU = {
	{ Id = "Collection", Text = "컬렉션", Color = "Sky", Icon = "collection" },
	{ Id = "Passport", Text = "여권", Color = "Grape", Icon = "passport" },
	{ Id = "Upgrade", Text = "업그레이드", Color = "Sun", Icon = "hammer" },
}

local function buildMenu(onMenu: (string) -> (), onTeleport: () -> ())
	local count = #MENU + 1
	local gap = 12
	local container = anchor(
		"Menu",
		Vector2.new(0, 0.5),
		UDim2.new(0, 14, 0.5, 16),
		UDim2.fromOffset(MENU_BUTTON.X + 8, count * MENU_BUTTON.Y + (count - 1) * gap)
	)
	Ui.list(Enum.FillDirection.Vertical, gap).Parent = container

	for order, entry in MENU do
		local button = Ui.chunkyButton({
			Name = entry.Id,
			LayoutOrder = order,
			Size = UDim2.fromOffset(MENU_BUTTON.X, MENU_BUTTON.Y),
			Color = entry.Color,
			Icon = entry.Icon,
			Vertical = true,
			Text = entry.Text,
			TextSize = 18,
			Parent = container,
		})
		button.Activated:Connect(function()
			onMenu(entry.Id)
		end)
	end

	refs.TeleportButton = Ui.chunkyButton({
		Name = "Teleport",
		LayoutOrder = count,
		Size = UDim2.fromOffset(MENU_BUTTON.X, MENU_BUTTON.Y),
		Color = "Grass",
		Icon = "park",
		Vertical = true,
		Text = "내 공원",
		TextSize = 18,
		Parent = container,
	})
	refs.TeleportButton.Activated:Connect(onTeleport)
end

-- 아래 가운데: 굴리기 + 자동 + 여권 도장 알약 ----------------------------------

local function buildRollBar(onRoll: () -> (), onToggleAuto: () -> ())
	local width = ROLL_BUTTON.X + 2 * (AUTO_BUTTON.X + 16)
	local container = anchor("RollBar", Vector2.new(0.5, 1), UDim2.new(0.5, 0, 1, -14), UDim2.fromOffset(width, 140))

	-- 여권 도장 k/6 (+ 키 안내) 알약: 가운데 정렬
	local infoRow = Ui.new("Frame", {
		Name = "InfoRow",
		Size = UDim2.new(1, 0, 0, 36),
		BackgroundTransparency = 1,
		Parent = container,
	})
	Ui.list(Enum.FillDirection.Horizontal, 0, Enum.HorizontalAlignment.Center).Parent = infoRow
	refs.InfoPill = Ui.pill({
		Name = "Info",
		AutoWidth = true,
		Size = UDim2.fromOffset(0, 30),
		Icon = "passport",
		IconBack = Theme.Cream,
		IconSize = 42,
		TextSize = 17,
		Parent = infoRow,
	})

	local roll = Ui.chunkyButton({
		Name = "Roll",
		Position = UDim2.new(0.5, -ROLL_BUTTON.X / 2, 1, -ROLL_BUTTON.Y),
		Size = UDim2.fromOffset(ROLL_BUTTON.X, ROLL_BUTTON.Y),
		Color = "Grass",
		Icon = "globe",
		IconSize = 70,
		IconSpin = 60,
		Text = "굴리기",
		TextSize = 40,
		OutlineThickness = 3,
		Parent = container,
	})
	roll.Activated:Connect(onRoll)
	refs.RollButton = roll
	-- 글자는 쿨타임 막대 위쪽에
	roll.Label.Position = UDim2.fromOffset(82, 2)
	roll.Label.Size = UDim2.new(1, -94, 1, -22)

	-- 쿨타임: 버튼 안 아래쪽 막대가 비었다가 가득 차면 다시 굴릴 수 있음
	local track = Ui.new("Frame", {
		Name = "Cooldown",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 84, 1, -9),
		Size = UDim2.new(1, -100, 0, 10),
		BackgroundColor3 = Theme.Ink,
		BackgroundTransparency = 0.5,
		BorderSizePixel = 0,
		ZIndex = 5,
		Parent = roll.Face,
	})
	Ui.round().Parent = track
	refs.CooldownFill = Ui.new("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		ZIndex = 6,
		Parent = track,
	})
	Ui.round().Parent = refs.CooldownFill

	local auto = Ui.chunkyButton({
		Name = "Auto",
		Position = UDim2.new(0.5, ROLL_BUTTON.X / 2 + 16, 1, -(ROLL_BUTTON.Y + AUTO_BUTTON.Y) / 2),
		Size = UDim2.fromOffset(AUTO_BUTTON.X, AUTO_BUTTON.Y),
		Color = "Gray",
		Text = "자동",
		TextSize = 28,
		Parent = container,
	})
	auto.Activated:Connect(onToggleAuto)
	refs.AutoButton = auto
	refs.AutoBadge = Ui.chip({
		Name = "On",
		Color = "Coral",
		Text = "ON",
		Height = 24,
		TextSize = 16,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -10, 0, 2),
		Rotation = 12,
		ZIndex = 6,
		Visible = false,
		Parent = auto.Face,
	})
end

-- 굴림 연출 ------------------------------------------------------------------

local function buildReveal()
	local container = anchor(
		"Reveal",
		Vector2.new(0.5, 0.5),
		UDim2.fromScale(0.5, 0.45),
		UDim2.fromOffset(700, 500),
		8 -- 메뉴 창보다 위
	)
	container.Visible = false
	refs.Reveal = container

	local inner = Ui.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = container,
	})
	refs.RevealScale = Ui.new("UIScale", { Parent = inner })

	-- 지역 이름: 도는 동안은 지역 색 글자, 멈추면 지역 색 딱지
	local regionTag = Ui.new("Frame", {
		Name = "Region",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0),
		Size = UDim2.fromOffset(280, 48),
		BackgroundTransparency = 1,
		ZIndex = 4,
		Parent = inner,
	})
	Ui.round().Parent = regionTag
	refs.RegionStroke = Ui.stroke()
	refs.RegionStroke.Parent = regionTag
	refs.RegionTag = regionTag
	refs.RevealRegion = Ui.label({
		Position = UDim2.fromOffset(12, 4),
		Size = UDim2.new(1, -24, 1, -8),
		TextColor3 = WHITE,
		ZIndex = 2,
		Parent = regionTag,
	}, 34)
	Ui.outline(refs.RevealRegion, 3)

	local centerY = 62 + VIEW_SIZE / 2

	-- 뒤에서 도는 햇살 (막대 12개를 가운데 기준으로 돌려 놓음)
	local burst = Ui.new("Frame", {
		Name = "Burst",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0, centerY),
		Size = UDim2.fromOffset(500, 500),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 1,
		Parent = inner,
	})
	refs.Burst = burst
	refs.Rays = {}
	for i = 1, RAY_COUNT do
		local ray = Ui.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.new(0, 30, 1, 0),
			Rotation = (i - 1) * 180 / RAY_COUNT,
			BackgroundColor3 = WHITE,
			BorderSizePixel = 0,
			Parent = burst,
		})
		Ui.new("UIGradient", { Rotation = 90, Transparency = RAY_FADE, Parent = ray })
		table.insert(refs.Rays, ray)
	end

	-- 모형 뒤의 둥근 판
	local disc = Ui.new("Frame", {
		Name = "Disc",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0, centerY),
		Size = UDim2.fromOffset(VIEW_SIZE, VIEW_SIZE),
		BackgroundColor3 = Theme.Cream,
		ZIndex = 2,
		Parent = inner,
	})
	Ui.round().Parent = disc
	Ui.stroke(Theme.Ink, 5).Parent = disc
	local ring = Ui.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -18, 1, -18),
		BackgroundTransparency = 1,
		Parent = disc,
	})
	Ui.round().Parent = ring
	Ui.stroke(WHITE, 3, 0.15).Parent = ring
	refs.Disc = disc

	local viewProps = {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0, centerY),
		Size = UDim2.fromOffset(VIEW_SIZE - 16, VIEW_SIZE - 16),
		ZIndex = 3,
	}
	refs.EarthView = Viewport.new(inner, viewProps)
	Viewport.setLandmark(refs.EarthView, Landmarks.ById.earth, 10)
	refs.ResultView = Viewport.new(inner, viewProps)
	refs.ResultView.Visible = false

	-- 등급 리본 (판 아래쪽에 걸침)
	local ribbon = Ui.new("Frame", {
		Name = "TierRibbon",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0, centerY + VIEW_SIZE / 2),
		Size = UDim2.fromOffset(250, 44),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 4,
		Parent = inner,
	})
	refs.RibbonTails = {}
	for _, side in { 0, 1 } do
		local tail = Ui.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(side, if side == 0 then -14 else 14, 0.5, 9),
			Size = UDim2.fromOffset(42, 34),
			BorderSizePixel = 0,
			ZIndex = 1,
			Parent = ribbon,
		})
		Ui.corner(8).Parent = tail
		Ui.stroke().Parent = tail
		table.insert(refs.RibbonTails, tail)
	end
	local ribbonMain = Ui.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = ribbon,
	})
	Ui.corner(10).Parent = ribbonMain
	Ui.stroke().Parent = ribbonMain
	refs.RibbonLabel = Ui.label({
		Position = UDim2.fromOffset(10, 4),
		Size = UDim2.new(1, -20, 1, -8),
		TextColor3 = WHITE,
		ZIndex = 3,
		Parent = ribbonMain,
	}, 28)
	Ui.outline(refs.RibbonLabel, 2.5)
	refs.Ribbon = ribbon
	refs.RibbonMain = ribbonMain

	local nameTop = centerY + VIEW_SIZE / 2 + 28
	refs.RevealName = Ui.label({
		Position = UDim2.fromOffset(0, nameTop),
		Size = UDim2.new(1, 0, 0, 66),
		Font = Theme.FontTitle,
		ZIndex = 4,
		Parent = inner,
	}, 62)
	Ui.outline(refs.RevealName, 4)
	refs.RevealOdds = Ui.label({
		Position = UDim2.fromOffset(0, nameTop + 66),
		Size = UDim2.new(1, 0, 0, 30),
		Font = Theme.FontTitle,
		TextColor3 = WHITE,
		ZIndex = 4,
		Parent = inner,
	}, 28)
	Ui.outline(refs.RevealOdds, 2.5)
	refs.RevealSubtitle = Ui.label({
		Position = UDim2.fromOffset(0, nameTop + 96),
		Size = UDim2.new(1, 0, 0, 22),
		TextColor3 = Theme.Cream,
		ZIndex = 4,
		Parent = inner,
	}, 20)
	Ui.outline(refs.RevealSubtitle, 2)

	-- 딱지 줄: NEW / 별 상승 / 발견 보너스
	local tagRow = Ui.new("Frame", {
		Name = "Tags",
		Position = UDim2.fromOffset(0, nameTop + 126),
		Size = UDim2.new(1, 0, 0, 36),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 4,
		Parent = inner,
	})
	Ui.list(Enum.FillDirection.Horizontal, 14, Enum.HorizontalAlignment.Center).Parent = tagRow
	refs.TagRow = tagRow
	refs.NewChip = Ui.chip({
		Name = "New",
		Color = "Coral",
		Text = "NEW",
		Font = Theme.FontTitle,
		Height = 32,
		TextSize = 22,
		LayoutOrder = 1,
		Parent = tagRow,
	})
	refs.StarChip = Ui.chip({
		Name = "StarUp",
		Color = "Grape",
		Height = 32,
		TextSize = 19,
		LayoutOrder = 2,
		Parent = tagRow,
	})
	refs.BonusPill = Ui.pill({
		Name = "Bonus",
		AutoWidth = true,
		Size = UDim2.fromOffset(0, 32),
		Icon = "coin",
		IconSize = 44,
		TextSize = 21,
		TextColor3 = Ui.colorPair("Sun").Face,
		LayoutOrder = 3,
		Parent = tagRow,
	})
end

-- 뉴스 속보 / 알림 자리 ------------------------------------------------------

local function buildNotices()
	-- 뉴스 속보(맨 위)
	local news = anchor("News", Vector2.new(0.5, 0), UDim2.new(0.5, 0, 0, 10), UDim2.fromOffset(720, 118), 9)
	local newsLayout = Ui.list(Enum.FillDirection.Vertical, 8, Enum.HorizontalAlignment.Center)
	newsLayout.VerticalAlignment = Enum.VerticalAlignment.Top
	newsLayout.Parent = news
	refs.News = news

	-- 잠깐 떴다 사라지는 알림(뉴스 아래)
	local notices = anchor("Notices", Vector2.new(0.5, 0), UDim2.new(0.5, 0, 0, 134), UDim2.fromOffset(600, 200), 9)
	local layout = Ui.list(Enum.FillDirection.Vertical, 8, Enum.HorizontalAlignment.Center)
	layout.VerticalAlignment = Enum.VerticalAlignment.Top
	layout.Parent = notices
	refs.Notices = notices
end

function Hud.init(playerGui: PlayerGui, handlers: Handlers): ScreenGui
	gui = Ui.new("ScreenGui", {
		Name = "LandmarkRNG",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = playerGui,
	})
	local flashGui = Ui.new("ScreenGui", {
		Name = "LandmarkRNGFlash",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 5,
		Parent = playerGui,
	})
	flashFrame = Ui.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Parent = flashGui,
	})

	tickSound = makeSound(1.4, 0.25)
	landSound = makeSound(1.1, 0.4)
	revealSound = makeSound(0.9, 0.6)
	rareSound = makeSound(0.5, 1)
	newsSound = makeSound(0.7, 0.5)

	buildStats()
	buildMenu(handlers.Menu, handlers.Teleport)
	buildRollBar(handlers.Roll, handlers.ToggleAuto)
	buildReveal()
	buildNotices()
	Hud.render(nil)
	return gui
end

function Hud.render(state: PlayerState.Snapshot?)
	if not state then
		refs.CoinLabel.Text = "불러오는 중..."
		refs.IncomePill.Root.Visible = false
		refs.RollsChip.Root.Visible = false
		refs.LuckChip.Root.Visible = false
		refs.InfoPill.Root.Visible = false
		shownCoins = -1
		return
	end
	refs.IncomePill.Label.Text = "+" .. incomeText(state.Income) .. "/초"
	refs.IncomePill.Root.Visible = true
	refs.RollsChip.Label.Text = "굴림 " .. Format.commas(state.Rolls)
	refs.RollsChip.Root.Visible = true
	refs.LuckChip.Label.Text = "행운 " .. timesText(state.Luck)
	refs.LuckChip.Root.Visible = true

	local stamps = #PlayerState.completedRegions(state)
	local info = string.format(
		'여권 도장 <font color="%s">%d/%d</font>',
		Format.hex(if stamps > 0 then Ui.colorPair("Sun").Face else WHITE),
		stamps,
		#Landmarks.Regions
	)
	if UserInputService.KeyboardEnabled then
		info ..= string.format('   <font color="%s">R 굴리기 · T 자동</font>', Format.hex(HINT_COLOR))
	end
	refs.InfoPill.Label.Text = info
	refs.InfoPill.Root.Visible = true
end

-- 매 프레임 호출: 부드럽게 올라가는 코인 표시 (정수가 바뀔 때만 글자 갱신)
function Hud.setCoins(amount: number)
	local whole = math.max(0, math.floor(amount))
	if whole == shownCoins then
		return
	end
	shownCoins = whole
	refs.CoinLabel.Text = Format.commas(whole)
end

function Hud.setAuto(enabled: boolean)
	refs.AutoButton.SetColor(if enabled then "Sun" else "Gray")
	refs.AutoBadge.Root.Visible = enabled
end

function Hud.setRolling(rolling: boolean)
	local button = refs.RollButton
	button.SetText(if rolling then "굴리는 중" else "굴리기")
	if button.Icon then
		Viewport.setSpin(button.Icon, if rolling then 420 else 60)
	end
end

-- where: 지금 있는 곳 ("Plaza" | "Park"). 버튼은 반대쪽으로 가는 버튼이 됨
function Hud.setLocation(where: string)
	local button = refs.TeleportButton
	if where == "Park" then
		button.SetText("광장")
		button.SetIcon("plaza")
	else
		button.SetText("내 공원")
		button.SetIcon("park")
	end
end

-- 쿨타임 막대가 비었다가 seconds 동안 가득 참
function Hud.startCooldown(seconds: number)
	local fill = refs.CooldownFill
	fill.Size = UDim2.fromScale(0, 1)
	TweenService:Create(fill, TweenInfo.new(seconds, Enum.EasingStyle.Linear), { Size = UDim2.fromScale(1, 1) }):Play()
end

local function flash(color: Color3, strength: number)
	flashFrame.BackgroundColor3 = color
	flashFrame.BackgroundTransparency = 1 - strength
	TweenService:Create(flashFrame, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		BackgroundTransparency = 1,
	}):Play()
end

-- landed: 결과 지역에 멈췄으면 지역 색 딱지, 아니면 지역 색 글자만
local function showRegion(region: Landmarks.Region, landed: boolean)
	local label = refs.RevealRegion
	label.Text = region.Name
	if landed then
		refs.RegionTag.BackgroundColor3 = region.Color
		refs.RegionTag.BackgroundTransparency = 0
		refs.RegionStroke.Enabled = true
		label.TextColor3 = WHITE
	else
		refs.RegionTag.BackgroundTransparency = 1
		refs.RegionStroke.Enabled = false
		label.TextColor3 = region.Color
	end
end

local function showBurst(color: Color3)
	for _, ray in refs.Rays do
		ray.BackgroundColor3 = color
	end
	refs.Burst.Visible = true
	if not burstTween then
		refs.Burst.Rotation = 0
		local tween = TweenService:Create(
			refs.Burst,
			TweenInfo.new(10, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1),
			{ Rotation = 360 }
		)
		tween:Play()
		burstTween = tween
	end
end

local function hideBurst()
	refs.Burst.Visible = false
	local tween = burstTween
	if tween then
		tween:Cancel()
		burstTween = nil
	end
end

local function showRibbon(tier: Landmarks.Tier)
	refs.RibbonMain.BackgroundColor3 = tier.Color
	for _, tail in refs.RibbonTails do
		tail.BackgroundColor3 = tier.Color:Lerp(Theme.Ink, 0.35)
	end
	refs.RibbonLabel.Text = tier.Name
	refs.Ribbon.Visible = true
end

-- 굴림 연출. 결과를 보여 줄 때까지 기다립니다(yield).
-- 1) 지구본이 빠르게 돌며 지역 이름이 바뀌다 점점 느려짐 → 2) 결과 지역에 멈춤 → 3) 명소 공개
function Hud.reveal(landmark: Landmarks.Landmark, info: RevealInfo)
	hideToken += 1
	local tier = landmark.Tier
	local rank = tier.Rank
	local duration = REVEAL_SECONDS[rank] or 3
	if info.Fast and rank < 4 then
		duration = math.max(0.35, duration * 0.5)
	end
	local region = Landmarks.RegionById[landmark.Region] or Landmarks.Regions[1]
	local regions = Landmarks.Regions

	local container = refs.Reveal
	container.Visible = true
	refs.RevealScale.Scale = 1
	hideBurst()
	refs.Ribbon.Visible = false
	refs.RevealName.Text = ""
	refs.RevealOdds.Text = ""
	refs.RevealSubtitle.Text = ""
	refs.TagRow.Visible = false
	refs.Disc.BackgroundColor3 = Theme.Cream
	refs.ResultView.Visible = false
	Viewport.setSpin(refs.ResultView, 0)
	refs.EarthView.Visible = true

	-- 1) 지구본이 돌며 지역이 바뀜. 실제로 지난 시간을 더해야 연출 길이가 늘어지지 않음
	local index = spinRandom:NextInteger(1, #regions)
	local elapsed = 0
	while elapsed < duration do
		index = index % #regions + 1
		showRegion(regions[index], false)
		play(tickSound)
		local t = elapsed / duration
		Viewport.setSpin(refs.EarthView, 60 + 840 * (1 - t) * (1 - t))
		local interval = 0.05 + t * t * 0.22
		elapsed += task.wait(interval)
	end

	-- 2) 결과 지역에 착지
	showRegion(region, true)
	Viewport.setSpin(refs.EarthView, 30)
	play(landSound)
	task.wait(if info.Fast and rank < 4 then LAND_SECONDS * 0.5 else LAND_SECONDS)

	-- 불가사의 이상은 한 박자 뜸 들이기
	if rank >= 5 then
		refs.RevealName.Text = "? ? ?"
		refs.RevealName.TextColor3 = tier.Color
		showRibbon(tier)
		showBurst(tier.Color)
		flash(BLACK, 0.6)
		task.wait(SUSPENSE_SECONDS)
	end

	-- 3) 결과 공개: 지구본 → 명소 모형
	Viewport.setSpin(refs.EarthView, 0)
	refs.EarthView.Visible = false
	Viewport.setLandmark(refs.ResultView, landmark, 10)
	refs.ResultView.Visible = true
	Viewport.setSpin(refs.ResultView, 40)
	refs.Disc.BackgroundColor3 = tier.Color:Lerp(WHITE, 0.6)
	showBurst(tier.Color)
	showRibbon(tier)

	refs.RevealName.Text = landmark.Name
	refs.RevealName.TextColor3 = tier.Color
	refs.RevealOdds.Text = Format.oneIn(landmark.OneIn)
	refs.RevealSubtitle.Text = landmark.Subtitle

	local bonus = info.Bonus or 0
	refs.NewChip.Root.Visible = info.IsNew
	refs.StarChip.Root.Visible = info.StarUp
	if info.StarUp then
		refs.StarChip.Label.Text = "별 상승 "
			.. Ui.starsRich(info.Stars or 0, #Config.STAR_THRESHOLDS, STAR_EMPTY_ON_GRAPE)
	end
	refs.BonusPill.Root.Visible = bonus > 0
	if bonus > 0 then
		refs.BonusPill.Label.Text = "+" .. Format.commas(bonus)
	end
	refs.TagRow.Visible = info.IsNew or info.StarUp or bonus > 0

	refs.RevealScale.Scale = 1.35
	TweenService:Create(refs.RevealScale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Scale = 1,
	}):Play()
	if rank >= 4 then
		flash(tier.Color, math.min(0.25 + rank * 0.08, 0.8))
		play(rareSound)
	else
		play(revealSound)
	end

	-- 결과를 잠깐 보여 줌 (자동 굴림 중에도 희귀 명소는 바로 덮이지 않게)
	local hold = if rank >= 4 then (if info.Fast then 1.8 else 0.6) else (if info.Fast then 0.2 else 0.1)
	task.wait(hold)

	local token = hideToken
	task.delay(if info.Fast then 1 else 2.5, function()
		if token == hideToken then
			container.Visible = false
			Viewport.setSpin(refs.ResultView, 0)
			hideBurst()
		end
	end)
end

-- 잠깐 떴다 사라지는 알림: 색(종류) 알약. color 는 알약 바탕색
function Hud.toast(text: string, color: Color3?, seconds: number?)
	toastOrder += 1
	while #toasts >= MAX_TOASTS do
		local oldest = table.remove(toasts, 1)
		if oldest then
			oldest:Destroy()
		end
	end

	local chip = Ui.chip({
		Name = "Toast",
		Color = color or Ui.colorPair("Sky").Face,
		Text = text,
		Height = 40,
		TextSize = 20,
		StrokeThickness = 3,
		LayoutOrder = toastOrder,
		Parent = refs.Notices,
	})
	local box = chip.Root
	table.insert(toasts, box)
	local scale = Ui.new("UIScale", { Scale = 0.4, Parent = box })
	TweenService:Create(scale, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 })
		:Play()

	task.delay(seconds or 3, function()
		if not box.Parent then
			return -- 이미 밀려나서 지워짐
		end
		TweenService:Create(scale, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Scale = 0 })
			:Play()
		task.wait(0.18)
		local index = table.find(toasts, box)
		if index then
			table.remove(toasts, index)
		end
		box:Destroy()
	end)
end

-- 서버 전체 "속보": 신문 띠가 오른쪽에서 밀려 들어와 잠시 머문 뒤 쏙 사라짐
function Hud.news(playerName: string, landmark: Landmarks.Landmark, rollNumber: number)
	local tier = landmark.Tier
	newsOrder += 1

	-- 너무 많이 쌓이면 가장 오래된 것부터 지움
	while #newsItems >= MAX_NEWS do
		local oldest = table.remove(newsItems, 1)
		if oldest then
			oldest:Destroy()
		end
	end

	local item = Ui.new("Frame", {
		LayoutOrder = newsOrder,
		Size = UDim2.new(1, 0, 0, 54),
		BackgroundTransparency = 1,
		Parent = refs.News,
	})
	table.insert(newsItems, item)

	local slide = Ui.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(2, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = item,
	})
	local scale = Ui.new("UIScale", { Parent = slide })

	-- 신문 띠: 크림 바탕 + Ink 테두리 + Ink 글자
	local bar = Ui.new("Frame", {
		Position = UDim2.fromOffset(56, 4),
		Size = UDim2.new(1, -56, 1, -8),
		BackgroundColor3 = Theme.Cream,
		ZIndex = 1,
		Parent = slide,
	})
	Ui.corner(10).Parent = bar
	Ui.stroke(Theme.Ink, 3).Parent = bar
	Ui.label({
		Position = UDim2.fromOffset(66, 5),
		Size = UDim2.new(1, -66 - 56, 1, -10),
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = string.format(
			'%s 님이 <font color="%s">%s</font>(%s) 발견! · %s번째 탐험',
			Format.escape(playerName),
			Format.hex(tier.Color:Lerp(Theme.Ink, 0.35)),
			Format.escape(landmark.Name),
			Format.oneIn(landmark.OneIn),
			Format.commas(rollNumber)
		),
		Parent = bar,
	}, 22)
	Icons.view(bar, "news", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -6, 0.5, 0),
		Size = UDim2.fromOffset(46, 46),
		ZIndex = 2,
	})

	-- 빨간 "속보" 도장 딱지 (살짝 기울임)
	local stamp = Ui.new("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.fromOffset(112, 46),
		BackgroundColor3 = Ui.colorPair("Coral").Face,
		Rotation = -6,
		ZIndex = 2,
		Parent = slide,
	})
	Ui.corner(10).Parent = stamp
	Ui.stroke(Theme.Ink, 3).Parent = stamp
	local stampRing = Ui.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -10, 1, -10),
		BackgroundTransparency = 1,
		Parent = stamp,
	})
	Ui.corner(7).Parent = stampRing
	Ui.stroke(WHITE, 2, 0.25).Parent = stampRing
	local stampLabel = Ui.label({
		Position = UDim2.fromOffset(8, 6),
		Size = UDim2.new(1, -16, 1, -12),
		Font = Theme.FontTitle,
		Text = "속보",
		TextColor3 = WHITE,
		ZIndex = 2,
		Parent = stamp,
	}, 26)
	Ui.outline(stampLabel, 2.5)

	play(newsSound)
	TweenService:Create(slide, TweenInfo.new(0.45, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
		Position = UDim2.fromScale(0.5, 0.5),
	}):Play()

	task.delay(NEWS_SECONDS, function()
		if not item.Parent then
			return -- 이미 밀려나서 지워짐
		end
		TweenService:Create(scale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
			Scale = 0,
		}):Play()
		task.wait(0.32)
		local index = table.find(newsItems, item)
		if index then
			table.remove(newsItems, index)
		end
		item:Destroy()
	end)
end

return Hud
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">Icons</string>
            <string name="Source"><![CDATA[-- 3D 미니 아이콘 (이모지 대신). 기본 파트 몇 개로 만든 작은 모형을 ViewportFrame 에 띄웁니다.
--   Icons.view(parent, "coin", { Size = ..., Position = ..., AnchorPoint = ..., Spin = 60 }) -> ViewportFrame
--   Icons.set(vf, "plaza") -- 이미 만든 화면의 아이콘만 바꿈
-- 모형은 이름별로 한 번만 만들어 두고 복제해서 씁니다. 파트 수는 아이콘마다 3~15개 정도로 작게 유지.
-- 아이콘: coin, globe(=roll), passport, collection, hammer, park, plaza, star, luck, news, plane, ticket

local Viewport = require(script.Parent.Viewport)

local Icons = {}

local V = Vector3.new
local rgb = Color3.fromRGB
local Mat = Enum.Material
local PI = math.pi

local UPRIGHT = CFrame.Angles(0, 0, PI / 2) -- 원기둥(길이 축 = X)을 세움
local ALONG_Z = CFrame.Angles(0, PI / 2, 0) -- 원기둥 길이 축을 Z 로 (정면을 보는 원판)
local FACE = CFrame.Angles(0, math.rad(-18), 0) -- 정면(-Z)을 카메라 쪽으로 살짝 돌려 옆면도 보이게

-- 색 (UI 테마와 맞춤)
local GOLD = rgb(255, 206, 64)
local GOLD_DEEP = rgb(222, 150, 24)
local OCEAN = rgb(57, 160, 255)
local LAND = rgb(76, 205, 96)
local SNOW = rgb(250, 252, 255)
local NAVY = rgb(38, 62, 140)
local CREAM = rgb(255, 244, 220)
local SKY = rgb(57, 160, 255)
local CORAL = rgb(255, 94, 91)
local SUN = rgb(255, 197, 61)
local GRAPE = rgb(155, 107, 255)
local GRASS = rgb(96, 196, 90)
local LEAF = rgb(58, 160, 74)
local LEAF_LIGHT = rgb(110, 210, 100)
local WOOD = rgb(150, 98, 58)
local WOOD_DARK = rgb(105, 68, 42)
local IRON = rgb(70, 70, 86)
local STEEL = rgb(160, 166, 184)
local MARBLE = rgb(246, 240, 228)
local MARBLE_SHADE = rgb(214, 204, 186)
local NEWSPRINT = rgb(236, 232, 220)
local INK = rgb(30, 27, 46)
local CLOVER = rgb(70, 190, 90)
local CLOVER_DARK = rgb(40, 140, 64)

local function style(part: BasePart, cf: CFrame, size: Vector3, color: Color3, material: Enum.Material?)
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Size = size
	part.CFrame = cf
	part.Color = color
	part.Material = material or Mat.SmoothPlastic
end

local function part(
	model: Model,
	shape: Enum.PartType,
	cf: CFrame,
	size: Vector3,
	color: Color3,
	material: Enum.Material?
): BasePart
	local p = Instance.new("Part")
	p.Shape = shape -- 크기보다 먼저(공 모양은 크기가 균일해짐)
	style(p, cf, size, color, material)
	p.Parent = model
	return p
end

local function block(model: Model, cf: CFrame, size: Vector3, color: Color3, material: Enum.Material?): BasePart
	return part(model, Enum.PartType.Block, cf, size, color, material)
end

local function ball(model: Model, center: Vector3, d: number, color: Color3, material: Enum.Material?): BasePart
	return part(model, Enum.PartType.Ball, CFrame.new(center), V(d, d, d), color, material)
end

-- 길이 축이 cf 의 X 축인 원기둥
local function cyl(
	model: Model,
	cf: CFrame,
	length: number,
	d: number,
	color: Color3,
	material: Enum.Material?
): BasePart
	return part(model, Enum.PartType.Cylinder, cf, V(length, d, d), color, material)
end

local function wedge(model: Model, cf: CFrame, size: Vector3, color: Color3, material: Enum.Material?): BasePart
	local p = Instance.new("WedgePart")
	style(p, cf, size, color, material)
	p.Parent = model
	return p
end

local BUILDERS: { [string]: (Model) -> () } = {}

-- 동전: 모로 선 금화. 가운데 면 + 도드라진 테두리(조각 12개) + 가운데 마름모 문양
function BUILDERS.coin(m)
	local center = FACE * CFrame.new(0, 2.15, 0) * ALONG_Z -- 로컬 X = 동전 두께 방향
	cyl(m, center, 0.56, 4.1, GOLD)
	local pieces = 12
	local outer, width = 2.12, 0.42
	local chord = 2 * outer * math.sin(PI / pieces) + 0.06
	for k = 0, pieces - 1 do
		local cf = center * CFrame.Angles(k * 2 * PI / pieces, 0, 0) * CFrame.new(0, outer - width / 2, 0)
		block(m, cf, V(0.8, width, chord), GOLD_DEEP, Mat.Foil)
	end
	block(m, center * CFrame.Angles(PI / 4, 0, 0), V(0.66, 1.05, 1.05), GOLD_DEEP)
end

-- 지구본: 파란 공 + 튀어나온 초록 대륙 + 북극 얼음
function BUILDERS.globe(m)
	local radius = 2.1
	local center = V(0, radius, 0)
	ball(m, center, radius * 2, OCEAN)
	local function surface(lat: number, lon: number, r: number): Vector3
		local phi, lambda = math.rad(lat), math.rad(lon)
		return center
			+ V(r * math.cos(phi) * math.sin(lambda), r * math.sin(phi), -r * math.cos(phi) * math.cos(lambda))
	end
	local lands = {
		{ 12, 20, 1.9 },
		{ 45, 70, 2 },
		{ -18, 130, 1.5 },
		{ 38, -100, 2 },
		{ -22, -58, 1.6 },
		{ 55, 170, 1.4 },
	}
	for _, land in lands do
		local d = land[3]
		ball(m, surface(land[1], land[2], radius - d / 2 + 0.28), d, LAND)
	end
	ball(m, surface(90, 0, radius - 0.6 + 0.22), 1.2, SNOW)
end

-- 여권: 남색 수첩 + 오른쪽으로 보이는 종이 + 금색 문장
function BUILDERS.passport(m)
	local base = FACE * CFrame.new(0, 2.1, 0) * CFrame.Angles(0, 0, math.rad(-6))
	block(m, base, V(3, 4.2, 0.55), NAVY)
	block(m, base * CFrame.new(0.1, 0, 0), V(2.92, 4, 0.46), CREAM)
	cyl(m, base * CFrame.new(0, 0.5, -0.3) * ALONG_Z, 0.06, 1.5, GOLD)
	block(m, base * CFrame.new(0, -0.8, -0.3), V(1.7, 0.16, 0.06), GOLD)
	block(m, base * CFrame.new(0, -1.15, -0.3), V(1.2, 0.12, 0.06), GOLD)
end

-- 컬렉션: 부채꼴로 펼친 카드 3장 (앞 카드에는 작은 그림)
function BUILDERS.collection(m)
	local cards = {
		{ Angle = 20, Z = 0.3, Color = SKY },
		{ Angle = 0, Z = 0, Color = GRAPE },
		{ Angle = -20, Z = -0.3, Color = CORAL },
	}
	local front: CFrame? = nil
	for _, card in cards do
		local cf = FACE * CFrame.new(0, 0.2, card.Z) * CFrame.Angles(0, 0, math.rad(card.Angle)) * CFrame.new(0, 1.7, 0)
		block(m, cf, V(2.3, 3.2, 0.16), card.Color)
		block(m, cf * CFrame.new(0, 0.3, -0.05), V(1.8, 1.9, 0.14), CREAM)
		front = cf
	end
	if front then
		ball(m, (front * CFrame.new(0.45, 0.8, -0.12)).Position, 0.5, SUN)
		block(m, front * CFrame.new(0, -0.35, -0.08), V(1.8, 0.55, 0.16), GRASS)
	end
end

-- 망치(업그레이드): 나무 손잡이 + 빨간 손잡이 끝 + 쇠머리
function BUILDERS.hammer(m)
	local base = FACE * CFrame.new(0, 2.5, 0) * CFrame.Angles(0, 0, math.rad(-35))
	block(m, base * CFrame.new(0, -0.5, 0), V(0.55, 4, 0.55), WOOD)
	block(m, base * CFrame.new(0, -2.1, 0), V(0.68, 1.1, 0.68), CORAL)
	block(m, base * CFrame.new(0, 1.6, 0), V(2.8, 1.1, 1.1), STEEL, Mat.Metal)
	block(m, base * CFrame.new(1.45, 1.6, 0), V(0.3, 1.25, 1.25), IRON, Mat.Metal)
end

-- 공원: 잔디 원판 + 나무 + 벤치
function BUILDERS.park(m)
	cyl(m, CFrame.new(0, 0.2, 0) * UPRIGHT, 0.4, 5.2, GRASS)
	cyl(m, CFrame.new(-0.9, 1.4, 0.5) * UPRIGHT, 2, 0.6, WOOD)
	ball(m, V(-0.9, 3.1, 0.5), 2.6, LEAF)
	ball(m, V(-0.1, 2.5, -0.1), 1.6, LEAF_LIGHT)
	local bench = FACE * CFrame.new(1.05, 0, -0.9)
	block(m, bench * CFrame.new(0, 1, 0), V(1.9, 0.2, 0.7), WOOD_DARK)
	block(m, bench * CFrame.new(0, 1.45, 0.28), V(1.9, 0.5, 0.14), WOOD_DARK)
	block(m, bench * CFrame.new(-0.75, 0.65, 0), V(0.18, 0.5, 0.6), IRON)
	block(m, bench * CFrame.new(0.75, 0.65, 0), V(0.18, 0.5, 0.6), IRON)
end

-- 광장: 고전 기둥 (받침 + 기둥 + 소용돌이 머리)
function BUILDERS.plaza(m)
	local base = FACE
	block(m, base * CFrame.new(0, 0.25, 0), V(2.8, 0.5, 2.8), MARBLE_SHADE)
	block(m, base * CFrame.new(0, 0.65, 0), V(2.3, 0.3, 2.3), MARBLE)
	cyl(m, base * CFrame.new(0, 2.7, 0) * UPRIGHT, 3.8, 1.6, MARBLE)
	block(m, base * CFrame.new(0, 4.75, 0), V(2.2, 0.3, 2.2), MARBLE)
	cyl(m, base * CFrame.new(-1.05, 4.7, 0) * ALONG_Z, 2.2, 0.62, MARBLE_SHADE)
	cyl(m, base * CFrame.new(1.05, 4.7, 0) * ALONG_Z, 2.2, 0.62, MARBLE_SHADE)
	block(m, base * CFrame.new(0, 5.1, 0), V(2.9, 0.4, 2.9), MARBLE_SHADE)
end

-- 별: 가운데 원판 + 뾰족한 끝 5개(직각 쐐기 2개씩)
function BUILDERS.star(m)
	local outerRadius, innerRadius, thickness = 2.2, 0.95, 0.7
	local center = FACE * CFrame.new(0, 2.2, 0) -- 별 평면 = 로컬 XY, 두께 = 로컬 Z
	cyl(m, center * ALONG_Z, thickness, innerRadius * 2, SUN)
	local apothem = innerRadius * math.cos(math.rad(36))
	local halfBase = innerRadius * math.sin(math.rad(36))
	local length = outerRadius - apothem
	for k = 0, 4 do
		local a = math.rad(90 + 72 * k)
		local u = V(math.cos(a), math.sin(a), 0) -- 뾰족한 방향
		local v = V(-math.sin(a), math.cos(a), 0) -- 가로 방향
		local mid = u * apothem -- 끝 밑변의 가운데(직각 꼭짓점)
		for _, side in { 1, -1 } do
			-- 쐐기의 직각 = 밑변 가운데, 세로 변(Y) = 뾰족한 방향, 가로 변(Z) = 바깥 꼭짓점 → 가운데
			local yAxis = u
			local zAxis = v * -side
			local xAxis = yAxis:Cross(zAxis)
			local position = mid + u * (length / 2) + v * (side * halfBase / 2)
			wedge(m, center * CFrame.fromMatrix(position, xAxis, yAxis, zAxis), V(thickness, length, halfBase), SUN)
		end
	end
end

-- 행운: 네잎클로버 (잎 원판 4장 + 가운데 + 줄기)
function BUILDERS.luck(m)
	local center = FACE * CFrame.new(0, 2.7, 0)
	for _, offset in { { -0.72, 0.72 }, { 0.72, 0.72 }, { -0.72, -0.72 }, { 0.72, -0.72 } } do
		cyl(m, center * CFrame.new(offset[1], offset[2], 0) * ALONG_Z, 0.35, 1.8, CLOVER)
	end
	ball(m, (center * CFrame.new(0, 0, -0.05)).Position, 0.75, CLOVER_DARK)
	block(m, center * CFrame.new(0.3, -1.75, 0) * CFrame.Angles(0, 0, math.rad(-12)), V(0.26, 2.1, 0.26), CLOVER_DARK)
end

-- 속보: 둘둘 만 신문 (빨간 띠 2개 + 앞쪽에 제목 줄)
function BUILDERS.news(m)
	local base = FACE * CFrame.new(0, 0.9, 0) * CFrame.Angles(0, 0, math.rad(8))
	cyl(m, base, 4.4, 1.6, NEWSPRINT)
	cyl(m, base * CFrame.new(-1.25, 0, 0), 0.3, 1.66, CORAL)
	cyl(m, base * CFrame.new(1.25, 0, 0), 0.3, 1.66, CORAL)
	block(m, base * CFrame.new(0, -0.15, -0.78), V(3.3, 0.95, 0.06), CREAM)
	block(m, base * CFrame.new(-0.35, 0.1, -0.82), V(1.8, 0.18, 0.04), INK)
	block(m, base * CFrame.new(-0.55, -0.25, -0.82), V(1.4, 0.1, 0.04), MARBLE_SHADE)
end

-- 비행기(여행사): 흰 동체 + 파란 날개 + 빨간 꼬리
function BUILDERS.plane(m)
	local base = FACE * CFrame.new(0, 1.4, 0) * CFrame.Angles(0, 0, math.rad(14)) -- 코(+X)가 살짝 위로
	cyl(m, base, 4.2, 0.95, SNOW)
	ball(m, (base * CFrame.new(2.1, 0, 0)).Position, 0.95, SNOW)
	block(m, base * CFrame.new(1.55, 0.3, 0), V(0.6, 0.3, 0.72), NAVY)
	block(m, base * CFrame.new(0.2, -0.1, 0), V(1.2, 0.14, 4.6), SKY)
	block(m, base * CFrame.new(-1.8, 0.75, 0), V(0.8, 1.2, 0.14), CORAL)
	block(m, base * CFrame.new(-1.8, 0.1, 0), V(0.6, 0.12, 1.8), SKY)
end

-- 입장권: 빨간 표 + 떼는 부분 + 가운데 크림 띠
function BUILDERS.ticket(m)
	local base = FACE * CFrame.new(0, 1.6, 0) * CFrame.Angles(0, 0, math.rad(12))
	block(m, base * CFrame.new(-0.45, 0, 0), V(2.9, 1.9, 0.18), CORAL)
	block(m, base * CFrame.new(1.55, 0, 0), V(0.95, 1.9, 0.18), SUN)
	block(m, base * CFrame.new(-0.45, 0, -0.04), V(2.1, 0.55, 0.16), CREAM)
end

local ALIASES = {
	roll = "globe",
}

-- 모든 파트를 옮겨서 경계 상자의 바닥 중앙이 원점에 오게 함 (Viewport 는 원점 기준으로 틀을 잡고 돌림)
local function recenter(model: Model)
	local minX, minY, minZ = math.huge, math.huge, math.huge
	local maxX, maxY, maxZ = -math.huge, -math.huge, -math.huge
	local parts = {}
	for _, child in model:GetChildren() do
		if child:IsA("BasePart") then
			table.insert(parts, child)
			local cf = child.CFrame
			local half = child.Size / 2
			local right, up, look = cf.RightVector, cf.UpVector, cf.LookVector
			local ex = math.abs(right.X) * half.X + math.abs(up.X) * half.Y + math.abs(look.X) * half.Z
			local ey = math.abs(right.Y) * half.X + math.abs(up.Y) * half.Y + math.abs(look.Y) * half.Z
			local ez = math.abs(right.Z) * half.X + math.abs(up.Z) * half.Y + math.abs(look.Z) * half.Z
			local p = cf.Position
			minX, maxX = math.min(minX, p.X - ex), math.max(maxX, p.X + ex)
			minY, maxY = math.min(minY, p.Y - ey), math.max(maxY, p.Y + ey)
			minZ, maxZ = math.min(minZ, p.Z - ez), math.max(maxZ, p.Z + ez)
		end
	end
	if #parts == 0 then
		return
	end
	local shift = V(-(minX + maxX) / 2, -minY, -(minZ + maxZ) / 2)
	for _, p in parts do
		p.CFrame += shift
	end
end

local templates: { [string]: Model } = {}

local function template(name: string): Model
	local key = ALIASES[name] or name
	local cached = templates[key]
	if cached then
		return cached
	end
	local builder = BUILDERS[key]
	if not builder then
		warn("[LandmarkRNG] 모르는 아이콘: " .. tostring(name))
		key = "star"
		builder = BUILDERS.star
		if templates.star then
			return templates.star
		end
	end

	local model = Instance.new("Model")
	model.Name = "Icon_" .. key
	builder(model)
	recenter(model)

	-- 피벗 = 바닥 중앙(원점). Viewport.setModel 이 이 피벗을 돌림
	local root = Instance.new("Part")
	root.Name = "Root"
	style(root, CFrame.new(), V(0.05, 0.05, 0.05), INK)
	root.Transparency = 1
	root.Parent = model
	model.PrimaryPart = root

	templates[key] = model
	return model
end

-- 이미 있는 화면의 아이콘을 바꿈
function Icons.set(vf: ViewportFrame, name: string)
	Viewport.setModel(vf, template(name):Clone())
	vf:SetAttribute("Icon", name)
end

-- 새 아이콘 화면. props: { Size, Position, AnchorPoint, ZIndex, Spin(초당 회전 각도) }
function Icons.view(parent: Instance?, name: string, props: { [string]: any }?): ViewportFrame
	local options = props or {}
	local vf = Viewport.new(nil, {
		Name = "Icon",
		Size = options.Size or UDim2.fromScale(1, 1),
		Position = options.Position or UDim2.new(),
		AnchorPoint = options.AnchorPoint or Vector2.new(0, 0),
		ZIndex = options.ZIndex or 1,
		Ambient = rgb(196, 194, 208),
	})
	Icons.set(vf, name)
	local spin = options.Spin
	if type(spin) == "number" and spin ~= 0 then
		Viewport.setSpin(vf, spin)
	end
	vf.Parent = parent
	return vf
end

return Icons
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">Panels</string>
            <string name="Source"><![CDATA[-- 메뉴 창: 컬렉션(대표 지정), 여권(지역별 발견 현황 + 도장), 업그레이드
-- 크림색 창(Ui.window) 하나를 쓰고, 화면마다 리본 색과 제목만 바꿉니다.
-- 화면마다 카드를 한 번 만들고 상태가 바뀌면 글자/색만 고칩니다. 썸네일(ViewportFrame)은
-- 새로 발견했을 때만 만들어서, 자동 굴림 중에 창을 열어 둬도 매번 다시 만들지 않습니다.

local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Landmarks = require(Shared.Landmarks)
local PlayerState = require(Shared.PlayerState)

local Icons = require(script.Parent.Icons)
local Ui = require(script.Parent.Ui)
local Viewport = require(script.Parent.Viewport)
local Theme = Ui.Theme

type Landmark = Landmarks.Landmark
type Snapshot = PlayerState.Snapshot

export type Handlers = {
	Feature: (string?) -> (),
	Buy: (string) -> (),
	ToggleAutoFeature: () -> (),
}

local REGION_BONUS = math.floor(Config.REGION_LUCK_BONUS * 100 + 0.5)

local VIEWS = {
	Collection = {
		Title = "컬렉션",
		Color = "Sky",
		Hint = "카드를 누르면 대표 명소로 지정/해제돼요",
	},
	Passport = {
		Title = "여권",
		Color = "Grape",
		Hint = string.format(
			"한 지역의 명소를 모두 모으면 여권 도장 · 영구 행운 +%d%%",
			REGION_BONUS
		),
	},
	Upgrade = { Title = "업그레이드", Color = "Sun", Hint = "코인으로 사는 영구 강화" },
}

local WHITE = Color3.new(1, 1, 1)
local GOOD_DARK = Ui.colorPair("Grass").Shadow
local FEATURED_BG = Color3.fromRGB(255, 218, 128)

local WINDOW_SIZE = Vector2.new(760, 500)
local OPEN_OFFSET = -30 -- 창을 화면 가운데보다 조금 위로 (아래쪽 굴리기 버튼을 가리지 않게)
local BODY_TOP = 54 -- 창 본문 안에서 스크롤 영역이 시작하는 높이(위는 설명 + 머리 버튼)
-- 스크롤 영역 안쪽 여백(오른쪽은 스크롤바 자리)
local PAD_X, PAD_RIGHT, PAD_Y = 6, 14, 6

local COLLECTION_CELL = Vector2.new(128, 184)
local COLLECTION_GAP = 12
local COLLECTION_COLUMNS = 5

local PASSPORT_CELL = Vector2.new(104, 136)
local PASSPORT_GAP = 8
local PASSPORT_COLUMNS = 6
local PASSPORT_HEADER = 98
local SECTION_PAD = 14
local SECTION_GAP = 16

local UPGRADE_ROW = 84
local UPGRADE_GAP = 10
local UPGRADE_ICONS = { Globe = "globe", Agency = "plane", Park = "park", Ticket = "ticket" }

local Panels = {}

local win: Ui.Window
local window: Frame
local body: Frame
local hintLabel: TextLabel
local headerButton: Ui.ChunkyButton
local emptyLabel: TextLabel
local handlers: Handlers
local openName: string? = nil
local lastState: Snapshot? = nil
local lastCoins = 0

local scrollers: { [string]: ScrollingFrame } = {}

type CollectionCard = {
	Card: TextButton,
	Stars: TextLabel,
	Count: Ui.Chip,
	Shown: Ui.Chip,
	Badge: Ui.Chip,
}
local collectionCards: { [string]: CollectionCard } = {}

type Stamp = {
	Frame: Frame,
	Stroke: UIStroke,
	RingStroke: UIStroke,
	Labels: { TextLabel },
	Outlines: { UIStroke },
	Color: Color3,
}
type PassportSection = { Title: TextLabel, Note: TextLabel, Fill: Frame, Stamp: Stamp, Grid: Frame }
local passportSections: { [string]: PassportSection } = {}
local passportCards: { [string]: { Card: Frame, Known: boolean } } = {}

type UpgradeRow = {
	Level: Ui.Chip,
	Effect: TextLabel,
	Button: Ui.ChunkyButton,
	Price: number?,
}
local upgradeRows: { [string]: UpgradeRow } = {}

local function owned(state: Snapshot, id: string): number
	return state.Inventory[id] or 0
end

local function gridHeight(count: number, columns: number, cellHeight: number, gap: number): number
	local rows = math.ceil(count / columns)
	if rows <= 0 then
		return 0
	end
	return rows * (cellHeight + gap) - gap
end

local function newScroller(name: string): ScrollingFrame
	local scroller = Ui.new("ScrollingFrame", {
		Name = name,
		Position = UDim2.fromOffset(0, BODY_TOP),
		Size = UDim2.new(1, 0, 1, -BODY_TOP),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = Theme.Ink,
		ScrollBarImageTransparency = 0.35,
		CanvasSize = UDim2.new(),
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Visible = false,
		Parent = body,
	})
	Ui.new("UIPadding", {
		PaddingLeft = UDim.new(0, PAD_X),
		PaddingRight = UDim.new(0, PAD_RIGHT),
		PaddingTop = UDim.new(0, PAD_Y),
		PaddingBottom = UDim.new(0, PAD_Y),
		Parent = scroller,
	})
	return scroller
end

local function setCanvasHeight(scroller: ScrollingFrame, contentHeight: number)
	scroller.CanvasSize = UDim2.fromOffset(0, contentHeight + PAD_Y * 2)
end

-- 명소 썸네일을 담는 "사진 칸" (등급 색을 옅게 깐 바탕)
local function photo(parent: GuiObject, landmark: Landmark, position: UDim2, size: UDim2, radius: number): Frame
	local frame = Ui.new("Frame", {
		Name = "Photo",
		Position = position,
		Size = size,
		BackgroundColor3 = landmark.Tier.Color:Lerp(WHITE, 0.62),
		Parent = parent,
	})
	Ui.corner(radius).Parent = frame
	Ui.stroke(Theme.Ink, 2).Parent = frame
	Viewport.thumbnail(frame, landmark, {
		Position = UDim2.fromOffset(2, 2),
		Size = UDim2.new(1, -4, 1, -4),
	})
	return frame
end

-- 컬렉션 ---------------------------------------------------------------------

local function buildCollection(): ScrollingFrame
	local scroller = newScroller("Collection")
	Ui.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(COLLECTION_CELL.X, COLLECTION_CELL.Y),
		CellPadding = UDim2.fromOffset(COLLECTION_GAP, COLLECTION_GAP),
		FillDirectionMaxCells = COLLECTION_COLUMNS,
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Parent = scroller,
	})
	return scroller
end

local function collectionCard(parent: ScrollingFrame, landmark: Landmark): CollectionCard
	local tier = landmark.Tier
	local card = Ui.new("TextButton", {
		Name = landmark.Id,
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = Theme.Paper,
	})
	Ui.corner(12).Parent = card
	Ui.stroke(Theme.Ink, 3).Parent = card

	-- 등급 색 띠 (위쪽 모서리만 둥글게: 아래 절반을 네모 판으로 덮음)
	local band = Ui.new("Frame", {
		Name = "Band",
		Size = UDim2.new(1, 0, 0, 26),
		BackgroundColor3 = tier.Color,
		BorderSizePixel = 0,
		Parent = card,
	})
	Ui.corner(12).Parent = band
	Ui.new("Frame", {
		Position = UDim2.new(0, 0, 1, -12),
		Size = UDim2.new(1, 0, 0, 12),
		BackgroundColor3 = tier.Color,
		BorderSizePixel = 0,
		Parent = band,
	})
	Ui.new("Frame", {
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 3),
		BackgroundColor3 = Theme.Ink,
		BorderSizePixel = 0,
		Parent = band,
	})
	local bandLabel = Ui.label({
		Position = UDim2.fromOffset(8, 4),
		Size = UDim2.new(1, -16, 1, -7),
		Text = tier.Name,
		TextColor3 = WHITE,
		ZIndex = 2,
		Parent = band,
	}, 15)
	Ui.outline(bandLabel, 1.5)

	photo(card, landmark, UDim2.fromOffset(7, 33), UDim2.new(1, -14, 0, 84), 8)

	Ui.label({
		Position = UDim2.fromOffset(6, 122),
		Size = UDim2.new(1, -12, 0, 24),
		Text = landmark.Name,
		Parent = card,
	}, 19)
	local stars = Ui.label({
		Position = UDim2.fromOffset(6, 149),
		Size = UDim2.new(1, -12, 0, 24),
		Parent = card,
	}, 22)
	Ui.outline(stars, 2)

	local count = Ui.chip({
		Name = "Count",
		Color = Theme.Ink,
		Height = 22,
		TextSize = 14,
		StrokeThickness = 2,
		Outline = false,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -3, 0, 29),
		ZIndex = 3,
		Parent = card,
	})
	local shown = Ui.chip({
		Name = "Shown",
		Color = "Grass",
		Text = "전시 중",
		Height = 20,
		TextSize = 13,
		StrokeThickness = 2,
		Position = UDim2.fromOffset(3, 96),
		ZIndex = 3,
		Visible = false,
		Parent = card,
	})
	-- "대표" 도장 (왼쪽 위, 기울임)
	local badge = Ui.chip({
		Name = "Featured",
		Color = "Coral",
		Text = "대표",
		Height = 28,
		TextSize = 17,
		CornerRadius = 7,
		Rotation = -14,
		Position = UDim2.fromOffset(-8, 22),
		ZIndex = 4,
		Visible = false,
		Parent = card,
	})

	local hover = Ui.new("UIScale", { Parent = card })
	card.MouseEnter:Connect(function()
		hover.Scale = 1.04
	end)
	card.MouseLeave:Connect(function()
		hover.Scale = 1
	end)
	card.Activated:Connect(function()
		local state = lastState
		local featured = state ~= nil and state.Featured == landmark.Id
		handlers.Feature(if featured then nil else landmark.Id)
	end)

	card.Parent = parent
	return { Card = card, Stars = stars, Count = count, Shown = shown, Badge = badge }
end

local function renderCollection(state: Snapshot)
	local scroller = scrollers.Collection
	local autoFeature = state.Settings.AutoFeature
	headerButton.Root.Visible = true
	headerButton.SetText(if autoFeature then "자동 대표: 켬" else "자동 대표: 끔")
	headerButton.SetColor(if autoFeature then "Grass" else "Gray")

	local inPark = {}
	for _, id in PlayerState.park(state) do
		inPark[id] = true
	end

	local shown = 0
	for _, landmark in Landmarks.RarestFirst do
		local count = owned(state, landmark.Id)
		local entry = collectionCards[landmark.Id]
		if count > 0 then
			shown += 1
			if not entry then
				entry = collectionCard(scroller, landmark)
				collectionCards[landmark.Id] = entry
			end
			local featured = state.Featured == landmark.Id
			entry.Card.LayoutOrder = shown
			entry.Card.BackgroundColor3 = if featured then FEATURED_BG else Theme.Paper
			entry.Badge.Root.Visible = featured
			entry.Stars.Text = Ui.starsRich(PlayerState.stars(count), #Config.STAR_THRESHOLDS)
			entry.Count.Label.Text = "×" .. Format.commas(count)
			entry.Shown.Root.Visible = inPark[landmark.Id] == true
		elseif entry then
			entry.Card:Destroy()
			collectionCards[landmark.Id] = nil
		end
	end

	win.Title.Text = string.format("%s (%d종)", VIEWS.Collection.Title, shown)
	emptyLabel.Visible = shown == 0
	setCanvasHeight(scroller, gridHeight(shown, COLLECTION_COLUMNS, COLLECTION_CELL.Y, COLLECTION_GAP))
end

-- 여권 -----------------------------------------------------------------------

-- 지역 도장: 지역 색 동그라미(기울임) + 흰 안쪽 고리 + 지역 이름 + 보너스
local function makeStamp(parent: Frame, region: Landmarks.Region): Stamp
	local frame = Ui.new("Frame", {
		Name = "Stamp",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -18, 0, 6),
		Size = UDim2.fromOffset(88, 88),
		BackgroundColor3 = region.Color,
		Rotation = -12,
		ZIndex = 2,
		Parent = parent,
	})
	Ui.round().Parent = frame
	local stroke = Ui.stroke(Theme.Ink, 3)
	stroke.Parent = frame
	local ring = Ui.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -14, 1, -14),
		BackgroundTransparency = 1,
		Parent = frame,
	})
	Ui.round().Parent = ring
	local ringStroke = Ui.stroke(WHITE, 2)
	ringStroke.Parent = ring

	local name = Ui.label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.42),
		Size = UDim2.fromScale(0.78, 0.3),
		Text = region.Name,
		TextColor3 = WHITE,
		ZIndex = 2,
		Parent = frame,
	}, 18)
	local bonus = Ui.label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.7),
		Size = UDim2.fromScale(0.66, 0.18),
		Text = string.format("행운 +%d%%", REGION_BONUS),
		TextColor3 = WHITE,
		ZIndex = 2,
		Parent = frame,
	}, 13)
	return {
		Frame = frame,
		Stroke = stroke,
		RingStroke = ringStroke,
		Labels = { name, bonus },
		Outlines = { Ui.outline(name, 2), Ui.outline(bonus, 1.5) },
		Color = region.Color,
	}
end

-- 다 모으면 진하게 찍힌 도장, 아니면 흐릿한 도장 자국
local function paintStamp(stamp: Stamp, complete: boolean)
	stamp.Frame.BackgroundTransparency = if complete then 0 else 0.8
	stamp.Stroke.Transparency = if complete then 0 else 0.65
	stamp.RingStroke.Color = if complete then WHITE else stamp.Color
	stamp.RingStroke.Transparency = if complete then 0.1 else 0.35
	for _, label in stamp.Labels do
		label.TextColor3 = if complete then WHITE else stamp.Color:Lerp(Theme.Ink, 0.25)
		label.TextTransparency = if complete then 0 else 0.35
	end
	for _, outline in stamp.Outlines do
		outline.Enabled = complete
	end
end

local function buildPassport(): ScrollingFrame
	local scroller = newScroller("Passport")
	local layout = Ui.list(Enum.FillDirection.Vertical, SECTION_GAP)
	layout.VerticalAlignment = Enum.VerticalAlignment.Top
	layout.Parent = scroller

	local total = 0
	for order, region in Landmarks.Regions do
		local list = Landmarks.ByRegion[region.Id]
		local height = PASSPORT_HEADER
			+ gridHeight(#list, PASSPORT_COLUMNS, PASSPORT_CELL.Y, PASSPORT_GAP)
			+ SECTION_PAD
		-- 여권 한 쪽
		local section = Ui.new("Frame", {
			Name = region.Id,
			LayoutOrder = order,
			Size = UDim2.new(1, 0, 0, height),
			BackgroundColor3 = Theme.Paper,
			Parent = scroller,
		})
		Ui.corner(14).Parent = section
		Ui.stroke(Theme.Ink, 3).Parent = section

		local title = Ui.label({
			Position = UDim2.fromOffset(SECTION_PAD, 10),
			Size = UDim2.new(0.6, 0, 0, 34),
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = section,
		}, 28)
		-- 발견 진행 막대
		local track = Ui.new("Frame", {
			Position = UDim2.fromOffset(SECTION_PAD, 50),
			Size = UDim2.new(0.5, 0, 0, 14),
			BackgroundColor3 = Theme.Cream,
			Parent = section,
		})
		Ui.round().Parent = track
		Ui.stroke(Theme.Ink, 2).Parent = track
		local fill = Ui.new("Frame", {
			Size = UDim2.fromScale(0, 1),
			BackgroundColor3 = region.Color,
			BorderSizePixel = 0,
			Parent = track,
		})
		Ui.round().Parent = fill
		local note = Ui.label({
			Position = UDim2.fromOffset(SECTION_PAD, 70),
			Size = UDim2.new(0.6, 0, 0, 20),
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = section,
		}, 17)

		local stamp = makeStamp(section, region)

		local grid = Ui.new("Frame", {
			Position = UDim2.fromOffset(SECTION_PAD, PASSPORT_HEADER),
			Size = UDim2.new(1, -SECTION_PAD * 2, 1, -(PASSPORT_HEADER + SECTION_PAD)),
			BackgroundTransparency = 1,
			Parent = section,
		})
		Ui.new("UIGridLayout", {
			CellSize = UDim2.fromOffset(PASSPORT_CELL.X, PASSPORT_CELL.Y),
			CellPadding = UDim2.fromOffset(PASSPORT_GAP, PASSPORT_GAP),
			FillDirectionMaxCells = PASSPORT_COLUMNS,
			SortOrder = Enum.SortOrder.LayoutOrder,
			HorizontalAlignment = Enum.HorizontalAlignment.Left,
			Parent = grid,
		})
		passportSections[region.Id] = { Title = title, Note = note, Fill = fill, Stamp = stamp, Grid = grid }
		total += height + (if order > 1 then SECTION_GAP else 0)
	end
	setCanvasHeight(scroller, total)
	return scroller
end

local function passportCard(parent: Frame, landmark: Landmark, known: boolean, order: number): Frame
	local tier = landmark.Tier
	local card = Ui.new("Frame", {
		Name = landmark.Id,
		LayoutOrder = order,
		BackgroundColor3 = if known then Theme.Cream else Theme.Ink,
	})
	Ui.corner(10).Parent = card
	Ui.stroke(Theme.Ink, 2.5).Parent = card

	if known then
		photo(card, landmark, UDim2.fromOffset(5, 5), UDim2.new(1, -10, 0, 68), 7)
		Ui.label({
			Position = UDim2.fromOffset(4, 77),
			Size = UDim2.new(1, -8, 0, 20),
			Text = landmark.Name,
			Parent = card,
		}, 16)
		Ui.label({
			Position = UDim2.fromOffset(4, 98),
			Size = UDim2.new(1, -8, 0, 16),
			Text = Format.oneIn(landmark.OneIn),
			TextTransparency = 0.3,
			Parent = card,
		}, 14)
		Ui.label({
			Position = UDim2.fromOffset(4, 115),
			Size = UDim2.new(1, -8, 0, 16),
			Text = tier.Name,
			TextColor3 = tier.Color:Lerp(Theme.Ink, 0.4),
			Parent = card,
		}, 13)
	else
		-- 아직 못 찾은 명소: 어두운 카드 + "?" + 확률
		Ui.label({
			Position = UDim2.fromOffset(5, 5),
			Size = UDim2.new(1, -10, 0, 70),
			Font = Theme.FontTitle,
			Text = "?",
			TextColor3 = Theme.Paper,
			TextTransparency = 0.2,
			Parent = card,
		}, 50)
		Ui.label({
			Position = UDim2.fromOffset(4, 82),
			Size = UDim2.new(1, -8, 0, 20),
			Text = Format.oneIn(landmark.OneIn),
			TextColor3 = tier.Color,
			Parent = card,
		}, 16)
		Ui.label({
			Position = UDim2.fromOffset(4, 106),
			Size = UDim2.new(1, -8, 0, 18),
			Text = tier.Name,
			TextColor3 = Theme.Cream,
			TextTransparency = 0.4,
			Parent = card,
		}, 13)
	end

	card.Parent = parent
	return card
end

local function renderPassport(state: Snapshot)
	local found = 0
	for _, region in Landmarks.Regions do
		local section = passportSections[region.Id]
		local list = Landmarks.ByRegion[region.Id]
		local discovered = 0
		for order, landmark in list do
			local known = owned(state, landmark.Id) > 0
			if known then
				discovered += 1
			end
			-- 발견 여부가 바뀐 카드만 다시 만듦
			local entry = passportCards[landmark.Id]
			if not entry or entry.Known ~= known then
				if entry then
					entry.Card:Destroy()
				end
				passportCards[landmark.Id] =
					{ Card = passportCard(section.Grid, landmark, known, order), Known = known }
			end
		end
		found += discovered

		local complete = #list > 0 and discovered == #list
		section.Title.Text = string.format(
			'%s  <font color="%s">%d/%d</font>',
			region.Name,
			Format.hex(region.Color:Lerp(Theme.Ink, 0.3)),
			discovered,
			#list
		)
		section.Fill.Size = UDim2.fromScale(if #list > 0 then discovered / #list else 0, 1)
		if complete then
			section.Note.Text = string.format("도장 획득! 행운 +%d%%", REGION_BONUS)
			section.Note.TextColor3 = GOOD_DARK
		else
			section.Note.Text = string.format("도장까지 %d곳", #list - discovered)
			section.Note.TextColor3 = Theme.Ink
		end
		paintStamp(section.Stamp, complete)
	end
	win.Title.Text = string.format("%s (%d/%d 발견)", VIEWS.Passport.Title, found, #Landmarks.List)
end

-- 업그레이드 -----------------------------------------------------------------

-- 레벨별 효과 표시
local function effectText(upgrade: PlayerState.Upgrade, level: number): string
	if upgrade.Id == "Globe" then
		return string.format("행운 ×%.2f", 1 + upgrade.PerLevel * level)
	elseif upgrade.Id == "Agency" then
		return string.format("굴림 간격 %.2f초", Config.ROLL_COOLDOWN * (1 - upgrade.PerLevel * level))
	elseif upgrade.Id == "Park" then
		return string.format("전시 칸 %d", math.floor(Config.BASE_SLOTS + upgrade.PerLevel * level + 0.5))
	elseif upgrade.Id == "Ticket" then
		return string.format("관광 수입 ×%.2f", 1 + upgrade.PerLevel * level)
	end
	return "Lv " .. level
end

-- 살 수 있으면 Sun, 코인이 모자라면 Gray, 최대 레벨이면 Grape (같은 색이면 버튼이 알아서 건너뜀)
local function paintBuyButton(row: UpgradeRow, coins: number)
	local price = row.Price
	row.Button.SetColor(if price == nil then "Grape" elseif coins >= price then "Sun" else "Gray")
end

local function buildUpgrade(): ScrollingFrame
	local scroller = newScroller("Upgrade")
	local layout = Ui.list(Enum.FillDirection.Vertical, UPGRADE_GAP, Enum.HorizontalAlignment.Center)
	layout.VerticalAlignment = Enum.VerticalAlignment.Top
	layout.Parent = scroller

	for order, upgrade in Config.Upgrades do
		local row = Ui.new("Frame", {
			Name = upgrade.Id,
			LayoutOrder = order,
			Size = UDim2.new(1, 0, 0, UPGRADE_ROW),
			BackgroundColor3 = Theme.Paper,
			Parent = scroller,
		})
		Ui.corner(14).Parent = row
		Ui.stroke(Theme.Ink, 3).Parent = row

		-- 아이콘 동그라미
		local disc = Ui.new("Frame", {
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 12, 0.5, 0),
			Size = UDim2.fromOffset(64, 64),
			BackgroundColor3 = Theme.Cream,
			Parent = row,
		})
		Ui.round().Parent = disc
		Ui.stroke(Theme.Ink, 3).Parent = disc
		Icons.view(disc, UPGRADE_ICONS[upgrade.Id] or "star", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(0.86, 0.86),
		})

		-- 이름 + 레벨 칩
		local head = Ui.new("Frame", {
			Position = UDim2.fromOffset(90, 6),
			Size = UDim2.new(1, -290, 0, 30),
			BackgroundTransparency = 1,
			Parent = row,
		})
		Ui.list(Enum.FillDirection.Horizontal, 10).Parent = head
		Ui.label({
			LayoutOrder = 1,
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.fromScale(0, 1),
			TextScaled = false,
			TextSize = 24,
			Text = upgrade.Name,
			Parent = head,
		}, 100)
		local level = Ui.chip({
			Name = "Level",
			Color = Theme.Ink,
			Height = 24,
			TextSize = 15,
			StrokeThickness = 2,
			Outline = false,
			LayoutOrder = 2,
			Parent = head,
		})

		Ui.label({
			Position = UDim2.fromOffset(90, 38),
			Size = UDim2.new(1, -290, 0, 18),
			TextXAlignment = Enum.TextXAlignment.Left,
			Text = upgrade.Description,
			TextTransparency = 0.35,
			Parent = row,
		}, 17)
		local effect = Ui.label({
			Position = UDim2.fromOffset(90, 58),
			Size = UDim2.new(1, -290, 0, 22),
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = row,
		}, 19)

		local button = Ui.chunkyButton({
			Name = "Buy",
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -14, 0.5, 0),
			Size = UDim2.fromOffset(176, 62),
			Color = "Sun",
			Icon = "coin",
			IconSize = 44,
			TextSize = 26,
			Parent = row,
		})
		button.Activated:Connect(function()
			local entry = upgradeRows[upgrade.Id]
			if entry and entry.Price then
				handlers.Buy(upgrade.Id)
			end
		end)
		upgradeRows[upgrade.Id] = { Level = level, Effect = effect, Button = button }
	end
	setCanvasHeight(scroller, #Config.Upgrades * (UPGRADE_ROW + UPGRADE_GAP) - UPGRADE_GAP)
	return scroller
end

local function renderUpgrade(state: Snapshot)
	for _, upgrade in Config.Upgrades do
		local row = upgradeRows[upgrade.Id]
		local level = PlayerState.upgradeLevel(state, upgrade.Id)
		local price = PlayerState.upgradePrice(upgrade.Id, level)
		row.Level.Label.Text = string.format("Lv %d/%d", level, upgrade.MaxLevel)
		if price then
			row.Effect.Text = string.format(
				'%s  <font color="%s">→ %s</font>',
				effectText(upgrade, level),
				Format.hex(GOOD_DARK),
				effectText(upgrade, level + 1)
			)
			row.Button.SetText(Format.commas(price))
			row.Button.SetIcon("coin")
		else
			row.Effect.Text = effectText(upgrade, level) .. " (최대)"
			row.Button.SetText("최대")
			row.Button.SetIcon(nil)
		end
		row.Price = price
		paintBuyButton(row, lastCoins)
	end
end

-- 공통 -----------------------------------------------------------------------

local BUILDERS = {
	Collection = buildCollection,
	Passport = buildPassport,
	Upgrade = buildUpgrade,
}

local RENDERERS = {
	Collection = renderCollection,
	Passport = renderPassport,
	Upgrade = renderUpgrade,
}

local function render()
	local name = openName
	if not name then
		return
	end
	local view = VIEWS[name]
	win.SetColor(view.Color)
	win.Title.Text = view.Title
	hintLabel.Text = view.Hint
	headerButton.Root.Visible = false
	emptyLabel.Visible = false

	for other, scroller in scrollers do
		scroller.Visible = other == name
	end

	local state = lastState
	if not state then
		emptyLabel.Text = "불러오는 중..."
		emptyLabel.Visible = true
		return
	end
	emptyLabel.Text = "아직 발견한 명소가 없어요. 지구본을 돌려 보세요!"

	local scroller = scrollers[name]
	if not scroller then
		scroller = BUILDERS[name]()
		scrollers[name] = scroller
	end
	scroller.Visible = true
	RENDERERS[name](state)
end

function Panels.init(parent: ScreenGui, callbacks: Handlers)
	handlers = callbacks

	win = Ui.window({
		Name = "Window",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, OPEN_OFFSET),
		Size = UDim2.fromOffset(WINDOW_SIZE.X, WINDOW_SIZE.Y),
		Color = "Sky",
		RibbonWidth = 360,
		ZIndex = 5,
		Visible = false,
		Parent = parent,
	})
	window = win.Root
	body = win.Body
	Ui.autoScale(window)
	win.Close.Activated:Connect(Panels.close)

	hintLabel = Ui.label({
		Position = UDim2.fromOffset(4, 2),
		Size = UDim2.new(1, -250, 0, 40),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTransparency = 0.25,
		Parent = body,
	}, 18)

	headerButton = Ui.chunkyButton({
		Name = "AutoFeature",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -4, 0, -2),
		Size = UDim2.fromOffset(220, 50),
		Color = "Grass",
		TextSize = 20,
		Visible = false,
		Parent = body,
	})
	headerButton.Activated:Connect(function()
		handlers.ToggleAutoFeature()
	end)

	emptyLabel = Ui.label({
		Position = UDim2.fromOffset(0, BODY_TOP + 30),
		Size = UDim2.new(1, 0, 0, 40),
		TextTransparency = 0.3,
		Visible = false,
		Parent = body,
	}, 24)
end

-- 같은 창 버튼을 다시 누르면 닫힘
function Panels.toggle(name: string)
	if not VIEWS[name] then
		return
	end
	if openName == name then
		Panels.close()
		return
	end
	local wasOpen = window.Visible
	openName = name
	window.Visible = true
	if not wasOpen then
		-- 아래에서 톡 튀어 오르며 열림
		window.Position = UDim2.new(0.5, 0, 0.5, OPEN_OFFSET + 40)
		TweenService:Create(window, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
			Position = UDim2.new(0.5, 0, 0.5, OPEN_OFFSET),
		}):Play()
	end
	render()
end

function Panels.close()
	openName = nil
	window.Visible = false
end

-- 서버 상태가 실제로 바뀌었을 때만 호출됨 (열린 화면만 갱신, 나머지는 열 때 갱신)
function Panels.render(state: Snapshot?)
	lastState = state
	if state then
		lastCoins = state.Coins -- 곧 refreshCoins 가 부드러운 값으로 덮어씀
	end
	render()
end

-- 자주 호출해도 되는 가벼운 갱신: 업그레이드 버튼의 "살 수 있음" 색만 다시 칠함
function Panels.refreshCoins(coins: number)
	lastCoins = coins
	if openName ~= "Upgrade" then
		return
	end
	for _, row in upgradeRows do
		paintBuyButton(row, coins)
	end
end

return Panels
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">Ui</string>
            <string name="Source"><![CDATA[-- UI 생성 헬퍼와 테마. 모든 화면은 코드로 만들어서 .rbxm 없이도 동작합니다.
-- 스타일: 인기 로블록스 게임식 통통한 UI (밝은 색 + 굵은 Ink 테두리 + 눌리는 3D 버튼, 이모지 없음).
-- 자세한 규칙은 DESIGN.md 의 "UI 스타일 가이드 (v2)" 참고.

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Format = require(Shared.Format)

local Ui = {}

export type ColorPair = { Face: Color3, Shadow: Color3 }

local rgb = Color3.fromRGB
local WHITE = Color3.new(1, 1, 1)

-- 버튼/리본 색 (앞면 / 그림자)
local COLORS: { [string]: ColorPair } = {
	Sky = { Face = rgb(57, 160, 255), Shadow = rgb(31, 111, 204) },
	Grass = { Face = rgb(76, 217, 100), Shadow = rgb(46, 158, 69) },
	Sun = { Face = rgb(255, 197, 61), Shadow = rgb(217, 144, 15) },
	Coral = { Face = rgb(255, 94, 91), Shadow = rgb(201, 58, 56) },
	Grape = { Face = rgb(155, 107, 255), Shadow = rgb(106, 69, 201) },
	Gray = { Face = rgb(172, 170, 190), Shadow = rgb(116, 112, 138) },
}

Ui.Theme = {
	Ink = rgb(30, 27, 46), -- 모든 굵은 테두리·글자 테두리
	Cream = rgb(255, 244, 220), -- 창 바탕
	Paper = rgb(255, 230, 176), -- 카드/여권 종이
	PaperDark = rgb(222, 178, 104), -- 창 아래 두께(립), 빈 막대
	White = WHITE,
	Colors = COLORS,
	Font = Enum.Font.FredokaOne,
	FontTitle = Enum.Font.LuckiestGuy, -- 큰 제목(명소 공개, 속보)
	-- 알림 색 (init.client 에서 알림 알약 색으로 넘김)
	Good = COLORS.Grass.Face,
	Bad = COLORS.Coral.Face,
	Gold = COLORS.Sun.Face,
	SubText = COLORS.Gray.Face,
	Text = WHITE,
}

-- 화면 크기 기준 해상도. 이보다 작으면(휴대폰) 줄이고, 크면 조금 키웁니다.
local DESIGN_SIZE = Vector2.new(1280, 720)
local MIN_SCALE, MAX_SCALE = 0.55, 0.9

local SHADOW_DEPTH = 6 -- 통통 버튼: 그림자 판이 앞면보다 아래로 나온 두께
local PRESS_DEPTH = 4 -- 누르면 앞면이 내려가는 거리
local BUTTON_CORNER = 14

local PRESS_TWEEN = TweenInfo.new(0.06, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local RELEASE_TWEEN = TweenInfo.new(0.16, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local HOVER_TWEEN = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

-- Icons 는 Viewport -> Ui 를 require 하므로, 순환을 피하려고 처음 쓸 때 불러옴
local iconsModule: any = nil
local function icons(): any
	if not iconsModule then
		iconsModule = require(script.Parent:WaitForChild("Icons")) :: any
	end
	return iconsModule
end

-- Ui.new("Frame", { Size = ..., Parent = ... }, { 자식들 })
function Ui.new(className: string, props: { [string]: any }?, children: { Instance }?): any
	local instance = Instance.new(className)
	local parent = nil
	for key, value in props or {} do
		if key == "Parent" then
			parent = value
		else
			(instance :: any)[key] = value
		end
	end
	for _, child in children or {} do
		child.Parent = instance
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

function Ui.corner(radius: number?): UICorner
	return Ui.new("UICorner", { CornerRadius = UDim.new(0, radius or 12) })
end

-- 완전히 둥근 모서리(알약/동그라미)
function Ui.round(): UICorner
	return Ui.new("UICorner", { CornerRadius = UDim.new(0.5, 0) })
end

-- 테두리 선 (기본: Ink 3px)
function Ui.stroke(color: Color3?, thickness: number?, transparency: number?): UIStroke
	return Ui.new("UIStroke", {
		Color = color or Ui.Theme.Ink,
		Thickness = thickness or 3,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

-- 글자 테두리 (Contextual = 글자에 적용)
function Ui.outline(label: GuiObject, thickness: number?, color: Color3?): UIStroke
	return Ui.new("UIStroke", {
		Color = color or Ui.Theme.Ink,
		Thickness = thickness or 2,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
		Parent = label,
	})
end

function Ui.padding(px: number): UIPadding
	local u = UDim.new(0, px)
	return Ui.new("UIPadding", { PaddingTop = u, PaddingBottom = u, PaddingLeft = u, PaddingRight = u })
end

function Ui.list(direction: Enum.FillDirection, gap: number, hAlign: Enum.HorizontalAlignment?): UIListLayout
	return Ui.new("UIListLayout", {
		FillDirection = direction,
		Padding = UDim.new(0, gap),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = hAlign or Enum.HorizontalAlignment.Left,
		VerticalAlignment = Enum.VerticalAlignment.Center,
	})
end

-- 이름 -> 색 쌍 (모르는 이름이면 회색)
function Ui.colorPair(name: string?): ColorPair
	return COLORS[name or "Gray"] or COLORS.Gray
end

-- 위쪽이 살짝 밝은 세로 그라데이션. 배경색은 흰색으로 두고 이 그라데이션 색이 곧 면 색이 됨
function Ui.faceGradient(color: Color3): ColorSequence
	return ColorSequence.new({
		ColorSequenceKeypoint.new(0, color:Lerp(WHITE, 0.32)),
		ColorSequenceKeypoint.new(0.5, color),
		ColorSequenceKeypoint.new(1, color),
	})
end

-- 글자 크기 자동(TextScaled) + 최대 크기 제한. 기본 글꼴 FredokaOne, 기본 글자색 Ink(크림 바탕용)
function Ui.label(props: { [string]: any }, maxTextSize: number?): TextLabel
	local label = Ui.new("TextLabel", {
		Text = "",
		BackgroundTransparency = 1,
		Font = Ui.Theme.Font,
		TextColor3 = Ui.Theme.Ink,
		TextScaled = true,
		RichText = true,
	})
	for key, value in props do
		if key ~= "Parent" then
			(label :: any)[key] = value
		end
	end
	Ui.new("UITextSizeConstraint", { MaxTextSize = maxTextSize or 28, Parent = label })
	label.Parent = props.Parent
	return label
end

-- 텍스트에 명소 등급 색을 입힘
function Ui.paintTier(label: TextLabel | TextButton, tier: { Color: Color3 })
	label.TextColor3 = tier.Color
end

-- 별 개수(0~max) -> "★★★☆☆"
function Ui.stars(count: number, max: number?): string
	local total = max or 5
	local filled = math.clamp(math.floor(count), 0, total)
	return string.rep("★", filled) .. string.rep("☆", total - filled)
end

-- RichText 별: 채운 별은 Sun 색, 빈 별은 흐린 색 (글자 테두리와 함께 쓰면 통통한 별이 됨)
function Ui.starsRich(count: number, max: number?, emptyColor: Color3?): string
	local total = max or 5
	local filled = math.clamp(math.floor(count), 0, total)
	return string.format(
		'<font color="%s">%s</font><font color="%s">%s</font>',
		Format.hex(COLORS.Sun.Face),
		string.rep("★", filled),
		Format.hex(emptyColor or rgb(226, 212, 182)),
		string.rep("★", total - filled)
	)
end

-- 통통 버튼 ------------------------------------------------------------------

export type ChunkyButton = {
	Root: Frame,
	Face: TextButton,
	Shadow: Frame,
	Label: TextLabel,
	Icon: ViewportFrame?,
	Activated: RBXScriptSignal,
	SetColor: (name: string) -> (),
	SetText: (text: string) -> (),
	SetIcon: (name: string?) -> (),
}

-- 누른 채로 버튼 밖에서 손을 떼도 앞면이 다시 올라오도록, 눌린 버튼을 모아 두었다가 입력이 끝나면 모두 올림
local held: { [() -> ()]: boolean } = {}
UserInputService.InputEnded:Connect(function(input)
	local kind = input.UserInputType
	if kind ~= Enum.UserInputType.MouseButton1 and kind ~= Enum.UserInputType.Touch then
		return
	end
	local list = {}
	for release in held do
		table.insert(list, release)
	end
	table.clear(held)
	for _, release in list do
		release()
	end
end)

-- props: { Color = "Grass"|"Sky"|"Sun"|"Coral"|"Grape"|"Gray", Size, Position, AnchorPoint, LayoutOrder, Text,
--          TextSize?(최대 글자 크기), Parent, Icon?(Icons 이름), IconSize?, IconSpin?, Vertical?(아이콘 위·글자 아래),
--          Round?(동그라미), Name?, ZIndex?, Visible? }
-- Size 는 그림자까지 포함한 전체 크기(오프셋). 앞면 높이 = Size.Y - 6
function Ui.chunkyButton(props: { [string]: any }): ChunkyButton
	local size: UDim2 = props.Size or UDim2.fromOffset(160, 64)
	local faceHeight = math.max(12, size.Y.Offset - SHADOW_DEPTH)
	local radius = if props.Round then UDim.new(0.5, 0) else UDim.new(0, props.CornerRadius or BUTTON_CORNER)
	local vertical = props.Vertical == true
	local iconSize = props.IconSize or math.floor(faceHeight * (if vertical then 0.58 else 0.8))

	local root = Ui.new("Frame", {
		Name = props.Name or "Button",
		Size = size,
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.new(0, 0),
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = props.ZIndex or 1,
		Visible = props.Visible ~= false,
		BackgroundTransparency = 1,
	})
	local hover = Ui.new("UIScale", { Parent = root })

	local shadow = Ui.new("Frame", {
		Name = "Shadow",
		Position = UDim2.fromOffset(0, SHADOW_DEPTH),
		Size = UDim2.new(1, 0, 1, -SHADOW_DEPTH),
		BorderSizePixel = 0,
		ZIndex = 1,
		Parent = root,
	})
	Ui.new("UICorner", { CornerRadius = radius, Parent = shadow })
	Ui.stroke().Parent = shadow

	local face = Ui.new("TextButton", {
		Name = "Face",
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.new(1, 0, 1, -SHADOW_DEPTH),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = root,
	})
	Ui.new("UICorner", { CornerRadius = radius, Parent = face })
	Ui.stroke().Parent = face
	local gradient = Ui.new("UIGradient", { Rotation = 90, Parent = face })

	-- 왼쪽 위 반짝이(만화풍 광택)
	if not props.Round then
		local shine = Ui.new("Frame", {
			Name = "Shine",
			Position = UDim2.fromOffset(9, 5),
			Size = UDim2.new(0.32, 0, 0, 6),
			BackgroundColor3 = WHITE,
			BackgroundTransparency = 0.55,
			BorderSizePixel = 0,
			ZIndex = 1,
			Parent = face,
		})
		Ui.round().Parent = shine
	end

	local label = Ui.label({
		Name = "Label",
		Text = props.Text or "",
		TextColor3 = WHITE,
		ZIndex = 4,
		Parent = face,
	}, props.TextSize or 26)
	Ui.outline(label, props.OutlineThickness or 2.5)

	local button = {
		Root = root,
		Face = face,
		Shadow = shadow,
		Label = label,
		Icon = nil,
		Activated = face.Activated,
	} :: any

	local iconName: string? = nil
	local function layout()
		local icon = button.Icon
		if icon and vertical then
			icon.AnchorPoint = Vector2.new(0.5, 0)
			icon.Position = UDim2.new(0.5, 0, 0, 3)
			icon.Size = UDim2.fromOffset(iconSize, iconSize)
			label.Position = UDim2.fromOffset(4, iconSize + 2)
			label.Size = UDim2.new(1, -8, 1, -(iconSize + 6))
		elseif icon then
			icon.AnchorPoint = Vector2.new(0, 0.5)
			icon.Position = UDim2.new(0, 6, 0.5, 0)
			icon.Size = UDim2.fromOffset(iconSize, iconSize)
			label.Position = UDim2.fromOffset(iconSize + 8, 4)
			label.Size = UDim2.new(1, -(iconSize + 16), 1, -8)
		else
			label.Position = UDim2.fromOffset(8, 4)
			label.Size = UDim2.new(1, -16, 1, -8)
		end
	end

	-- 아이콘 바꾸기 (nil 이면 아이콘 없이 글자만)
	local function setIcon(name: string?)
		if name == iconName then
			return
		end
		iconName = name
		local icon = button.Icon
		if name and icon then
			icons().set(icon, name)
		elseif name then
			button.Icon = icons().view(face, name, { ZIndex = 3, Spin = props.IconSpin })
		elseif icon then
			icon:Destroy()
			button.Icon = nil
		end
		layout()
	end

	local colorName: string? = nil
	local function setColor(name: string)
		if name == colorName then
			return
		end
		colorName = name
		local pair = Ui.colorPair(name)
		gradient.Color = Ui.faceGradient(pair.Face)
		shadow.BackgroundColor3 = pair.Shadow
	end

	-- 누름: 앞면이 4px 내려갔다가 올라옴 / 마우스를 올리면 1.05배
	local pressed = false
	local lastPress = 0
	local function release()
		held[release] = nil
		if not pressed then
			return
		end
		pressed = false
		TweenService:Create(face, RELEASE_TWEEN, { Position = UDim2.fromOffset(0, 0) }):Play()
	end
	local function press()
		lastPress = os.clock()
		if pressed then
			return
		end
		pressed = true
		held[release] = true
		TweenService:Create(face, PRESS_TWEEN, { Position = UDim2.fromOffset(0, PRESS_DEPTH) }):Play()
	end
	face.MouseButton1Down:Connect(press)
	face.MouseButton1Up:Connect(release)
	face.MouseEnter:Connect(function()
		if UserInputService.MouseEnabled then
			TweenService:Create(hover, HOVER_TWEEN, { Scale = 1.05 }):Play()
		end
	end)
	face.MouseLeave:Connect(function()
		release()
		TweenService:Create(hover, HOVER_TWEEN, { Scale = 1 }):Play()
	end)
	face.Activated:Connect(function()
		if pressed then
			release()
		elseif os.clock() - lastPress > 0.4 then
			-- 키보드/게임패드로 누른 경우: 짧게 눌렸다 올라옴
			press()
			task.delay(0.07, release)
		end
	end)

	button.SetColor = setColor
	button.SetText = function(text: string)
		label.Text = text
	end
	button.SetIcon = setIcon

	setColor(props.Color or "Sky")
	setIcon(props.Icon)
	layout()

	root.Parent = props.Parent
	return button :: ChunkyButton
end

-- 창 -------------------------------------------------------------------------

export type Window = {
	Root: Frame,
	Panel: Frame,
	Body: Frame,
	Ribbon: Frame,
	Title: TextLabel,
	Close: ChunkyButton,
	SetColor: (name: string) -> (),
}

local RIBBON_HEIGHT = 54

-- props: { Size, Position, AnchorPoint, Title, Color(리본 색 이름), RibbonWidth?, Name?, ZIndex?, Visible?, Parent }
-- Cream 바탕 + Ink 테두리 4 + 모서리 18, 위 가운데에 색 리본 제목, 오른쪽 위에 빨간 동그라미 닫기 버튼
function Ui.window(props: { [string]: any }): Window
	local theme = Ui.Theme
	local root = Ui.new("Frame", {
		Name = props.Name or "Window",
		Size = props.Size or UDim2.fromOffset(720, 480),
		Position = props.Position or UDim2.fromScale(0.5, 0.5),
		AnchorPoint = props.AnchorPoint or Vector2.new(0.5, 0.5),
		ZIndex = props.ZIndex or 1,
		Visible = props.Visible ~= false,
		BackgroundTransparency = 1,
	})

	-- 아래 두께(립): 종이 책처럼 두툼하게
	local lip = Ui.new("Frame", {
		Name = "Lip",
		Position = UDim2.fromOffset(0, 8),
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = theme.PaperDark,
		ZIndex = 1,
		Parent = root,
	})
	Ui.corner(18).Parent = lip
	Ui.stroke(theme.Ink, 4).Parent = lip

	local panel = Ui.new("Frame", {
		Name = "Panel",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = theme.Cream,
		ZIndex = 2,
		Parent = root,
	})
	Ui.corner(18).Parent = panel
	Ui.stroke(theme.Ink, 4).Parent = panel
	-- 안쪽 종이 테두리
	local inner = Ui.new("Frame", {
		Name = "Inner",
		Position = UDim2.fromOffset(8, 8),
		Size = UDim2.new(1, -16, 1, -16),
		BackgroundTransparency = 1,
		Parent = panel,
	})
	Ui.corner(12).Parent = inner
	Ui.stroke(theme.Paper, 3).Parent = inner

	-- 리본 제목
	local ribbon = Ui.new("Frame", {
		Name = "Ribbon",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0, 4),
		Size = UDim2.fromOffset(props.RibbonWidth or 340, RIBBON_HEIGHT),
		BackgroundTransparency = 1,
		ZIndex = 3,
		Parent = root,
	})
	local tails = {}
	for _, side in { 0, 1 } do
		local tail = Ui.new("Frame", {
			Name = "Tail",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(side, if side == 0 then -16 else 16, 0.5, 10),
			Size = UDim2.fromOffset(48, 40),
			BorderSizePixel = 0,
			ZIndex = 1,
			Parent = ribbon,
		})
		Ui.corner(8).Parent = tail
		Ui.stroke(theme.Ink, 3).Parent = tail
		table.insert(tails, tail)
	end
	local main = Ui.new("Frame", {
		Name = "Main",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = ribbon,
	})
	Ui.corner(12).Parent = main
	Ui.stroke(theme.Ink, 3).Parent = main
	local gradient = Ui.new("UIGradient", { Rotation = 90, Parent = main })
	local title = Ui.label({
		Name = "Title",
		Position = UDim2.fromOffset(14, 5),
		Size = UDim2.new(1, -28, 1, -10),
		Text = props.Title or "",
		TextColor3 = WHITE,
		ZIndex = 3,
		Parent = main,
	}, 32)
	Ui.outline(title, 3)

	local close = Ui.chunkyButton({
		Name = "Close",
		Color = "Coral",
		Round = true,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -8, 0, 8),
		Size = UDim2.fromOffset(52, 58),
		Text = "X",
		TextSize = 30,
		OutlineThickness = 3,
		ZIndex = 4,
		Parent = root,
	})

	local top = RIBBON_HEIGHT / 2 + 4 + 14
	local body = Ui.new("Frame", {
		Name = "Body",
		Position = UDim2.fromOffset(18, top),
		Size = UDim2.new(1, -36, 1, -(top + 16)),
		BackgroundTransparency = 1,
		Parent = panel,
	})

	local colorName: string? = nil
	local function setColor(name: string)
		if name == colorName then
			return
		end
		colorName = name
		local pair = Ui.colorPair(name)
		gradient.Color = Ui.faceGradient(pair.Face)
		for _, tail in tails do
			tail.BackgroundColor3 = pair.Shadow
		end
	end
	setColor(props.Color or "Sky")

	root.Parent = props.Parent
	return {
		Root = root,
		Panel = panel,
		Body = body,
		Ribbon = ribbon,
		Title = title,
		Close = close,
		SetColor = setColor,
	}
end

-- 알약 / 칩 --------------------------------------------------------------------

export type Pill = { Root: Frame, Label: TextLabel, Icon: ViewportFrame? }

-- 캡슐 모양 반투명 Ink 바탕 + 흰 글자(테두리). 왼쪽에 테두리를 살짝 넘는 동그란 3D 아이콘(선택).
-- props: { Size(높이는 오프셋), Position, AnchorPoint, LayoutOrder, Parent, Text, TextColor3?, MaxTextSize?,
--          AutoWidth?(글자 길이에 맞춰 가로 자동, TextSize 사용), TextSize?, TextXAlignment?,
--          Icon?(Icons 이름), IconSize?, IconSpin?, IconBack?(아이콘 뒤 동그라미 색), BackgroundTransparency?, Name?, ZIndex?, Visible? }
function Ui.pill(props: { [string]: any }): Pill
	local theme = Ui.Theme
	local size: UDim2 = props.Size or UDim2.fromOffset(200, 40)
	local height = size.Y.Offset
	local autoWidth = props.AutoWidth == true
	local iconSize = props.IconSize or math.floor(height * 1.3)
	-- 아이콘 중심은 알약 왼쪽 끝에서 조금 안쪽 → 아이콘이 왼쪽 테두리를 살짝 넘어감
	local iconCenter = math.floor(iconSize * 0.28)
	local leftPad = if props.Icon then iconCenter + math.ceil(iconSize / 2) + 6 else 16

	local root = Ui.new("Frame", {
		Name = props.Name or "Pill",
		Size = if autoWidth then UDim2.fromOffset(0, height) else size,
		AutomaticSize = if autoWidth then Enum.AutomaticSize.X else Enum.AutomaticSize.None,
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.new(0, 0),
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = props.ZIndex or 1,
		Visible = props.Visible ~= false,
		BackgroundColor3 = theme.Ink,
		BackgroundTransparency = props.BackgroundTransparency or 0.3,
	})
	Ui.round().Parent = root
	Ui.stroke(theme.Ink, 3).Parent = root
	Ui.new("UIPadding", {
		PaddingLeft = UDim.new(0, leftPad),
		PaddingRight = UDim.new(0, props.PadRight or 16),
		Parent = root,
	})

	local label = Ui.label({
		Name = "Label",
		Text = props.Text or "",
		TextColor3 = props.TextColor3 or WHITE,
		TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left,
		TextScaled = not autoWidth,
		TextSize = props.TextSize or 20,
		AutomaticSize = if autoWidth then Enum.AutomaticSize.X else Enum.AutomaticSize.None,
		Size = if autoWidth then UDim2.fromScale(0, 1) else UDim2.fromScale(1, 1),
		ZIndex = 2,
		Parent = root,
	}, props.MaxTextSize or 30)
	Ui.outline(label, 2.5)

	local icon: ViewportFrame? = nil
	if props.Icon then
		-- UIPadding 만큼 안쪽에서 시작하므로 왼쪽 여백을 빼서 위치를 맞춤
		local position = UDim2.new(0, iconCenter - leftPad, 0.5, 0)
		if props.IconBack then
			local disc = Ui.new("Frame", {
				Name = "IconBack",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = position,
				Size = UDim2.fromOffset(iconSize, iconSize),
				BackgroundColor3 = props.IconBack,
				ZIndex = 3,
				Parent = root,
			})
			Ui.round().Parent = disc
			Ui.stroke(theme.Ink, 3).Parent = disc
			icon = icons().view(disc, props.Icon, {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromScale(0.84, 0.84),
				ZIndex = 4,
				Spin = props.IconSpin,
			})
		else
			icon = icons().view(root, props.Icon, {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = position,
				Size = UDim2.fromOffset(iconSize, iconSize),
				ZIndex = 3,
				Spin = props.IconSpin,
			})
		end
	end

	root.Parent = props.Parent
	return { Root = root, Label = label, Icon = icon }
end

export type Chip = { Root: Frame, Label: TextLabel }

-- 작은 색 캡슐 딱지 (글자 길이에 맞춰 가로 자동). 흰 글자 + Ink 테두리.
-- props: { Color = 색 이름 또는 Color3, Text, Height?, TextSize?, TextColor3?, Font?, Outline?(false 면 글자 테두리 없음),
--          StrokeThickness?, CornerRadius?, MinWidth?, Rotation?, Position, AnchorPoint, LayoutOrder, ZIndex, Visible, Parent }
function Ui.chip(props: { [string]: any }): Chip
	local height = props.Height or 28
	local color = props.Color
	local background = if typeof(color) == "Color3" then color else Ui.colorPair(color or "Sky").Face

	local root = Ui.new("Frame", {
		Name = props.Name or "Chip",
		Size = UDim2.fromOffset(props.MinWidth or 0, height),
		AutomaticSize = Enum.AutomaticSize.X,
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.new(0, 0),
		LayoutOrder = props.LayoutOrder or 0,
		Rotation = props.Rotation or 0,
		ZIndex = props.ZIndex or 1,
		Visible = props.Visible ~= false,
		BackgroundColor3 = background,
	})
	if props.CornerRadius then
		Ui.corner(props.CornerRadius).Parent = root
	else
		Ui.round().Parent = root
	end
	Ui.stroke(Ui.Theme.Ink, props.StrokeThickness or 2.5).Parent = root
	local pad = UDim.new(0, math.floor(height * 0.42))
	Ui.new("UIPadding", { PaddingLeft = pad, PaddingRight = pad, Parent = root })

	local label = Ui.label({
		Name = "Label",
		Text = props.Text or "",
		Font = props.Font or Ui.Theme.Font,
		TextColor3 = props.TextColor3 or WHITE,
		TextScaled = false,
		TextSize = props.TextSize or math.floor(height * 0.62),
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromScale(0, 1),
		ZIndex = 2,
		Parent = root,
	}, 100)
	if props.Outline ~= false then
		Ui.outline(label, props.OutlineThickness or 2)
	end

	root.Parent = props.Parent
	return { Root = root, Label = label }
end

-- 화면 크기 자동 스케일 -------------------------------------------------------

-- 화면 크기에 맞춰 크기를 조절하는 UIScale 을 붙임 (AnchorPoint 기준으로 커지고 작아짐)
local scalers: { UIScale } = {}

local function currentScale(): number
	local camera = workspace.CurrentCamera
	local viewport = if camera then camera.ViewportSize else DESIGN_SIZE
	return math.clamp(math.min(viewport.X / DESIGN_SIZE.X, viewport.Y / DESIGN_SIZE.Y), MIN_SCALE, MAX_SCALE)
end

function Ui.autoScale(object: GuiObject)
	local scale = Ui.new("UIScale", { Scale = currentScale(), Parent = object })
	table.insert(scalers, scale)
end

local function refreshScales()
	local value = currentScale()
	for _, scale in scalers do
		scale.Scale = value
	end
end

local cameraConnection: RBXScriptConnection? = nil
local function watchCamera()
	if cameraConnection then
		cameraConnection:Disconnect()
	end
	local camera = workspace.CurrentCamera
	if camera then
		cameraConnection = camera:GetPropertyChangedSignal("ViewportSize"):Connect(refreshScales)
	end
	refreshScales()
end
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(watchCamera)
watchCamera()

return Ui
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">Viewport</string>
            <string name="Source"><![CDATA[-- ViewportFrame 에 명소 모형을 띄우는 헬퍼.
-- 정적인 썸네일(컬렉션/여권 카드)은 한 번 찍고 끝(매 프레임 작업 없음),
-- 회전이 필요한 화면(굴림 연출)만 setSpin 으로 등록해서 RenderStepped 루프 하나로 돌립니다.

local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Landmarks = require(Shared.Landmarks)
local Models = require(Shared:WaitForChild("Models"))

local Ui = require(script.Parent.Ui)

local FIELD_OF_VIEW = 30 -- 세로 시야각(도). 좁을수록 원근 왜곡이 적어 미니어처처럼 보임
local YAW = math.rad(35) -- 정면(-Z)에서 오른쪽으로 돌아간 각도 (3/4 시점)
local PITCH = math.rad(22) -- 내려다보는 각도
local MARGIN = 1.04

-- 모형 틀 정보는 ViewportFrame 의 속성(Attribute)에 저장 → 모듈 쪽에 따로 들고 있을 필요가 없어서
-- 카드가 Destroy 되어도 정리할 것이 없음
local ATTR_HEIGHT_CENTER = "ViewCenterY"
local ATTR_FLAT = "ViewFlat"
local ATTR_HALF_HEIGHT = "ViewHalfHeight"

local Viewport = {}

type SpinEntry = { Speed: number, Angle: number }

-- 회전 중인 화면들. 부모가 사라지면(Destroy) 루프에서 알아서 빠짐
local spinning: { [ViewportFrame]: SpinEntry } = {}
local spinConnection: RBXScriptConnection? = nil

local function currentModel(vf: ViewportFrame): Model?
	return vf:FindFirstChildOfClass("Model")
end

-- 저장해 둔 틀 정보로 카메라 위치를 정함 (화면 비율이 바뀌면 다시 호출)
local function frameCamera(vf: ViewportFrame)
	local camera = vf.CurrentCamera
	local centerY = vf:GetAttribute(ATTR_HEIGHT_CENTER)
	local flat = vf:GetAttribute(ATTR_FLAT)
	local halfHeight = vf:GetAttribute(ATTR_HALF_HEIGHT)
	if not camera or type(centerY) ~= "number" or type(flat) ~= "number" or type(halfHeight) ~= "number" then
		return
	end

	local absolute = vf.AbsoluteSize
	local aspect = if absolute.X > 0 and absolute.Y > 0 then absolute.X / absolute.Y else 1
	local tanV = math.tan(math.rad(camera.FieldOfView / 2))
	local tanH = tanV * aspect

	-- 화면에 비치는 대략적인 반높이/반너비. 가로는 회전해도 넘지 않도록 수직축에서 가장 먼 모서리 기준
	local projectedHalfHeight = halfHeight * math.cos(PITCH) + flat * math.sin(PITCH)
	local distance = math.max(projectedHalfHeight / tanV + flat * 0.5, flat / tanH + flat) * MARGIN

	local target = Vector3.new(0, centerY, 0)
	local direction = Vector3.new(math.sin(YAW) * math.cos(PITCH), math.sin(PITCH), -math.cos(YAW) * math.cos(PITCH))
	camera.CFrame = CFrame.lookAt(target + direction * distance, target)
end

-- 새 ViewportFrame (카메라·조명 포함). props 로 Size/Position 등을 덮어씀
function Viewport.new(parent: Instance?, props: { [string]: any }?): ViewportFrame
	local vf = Ui.new("ViewportFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Ambient = Color3.fromRGB(165, 165, 180),
		LightColor = Color3.fromRGB(255, 248, 235),
		-- 빛이 나아가는 방향. 카메라와 같은 쪽(앞·위·오른쪽)에서 비추도록
		LightDirection = Vector3.new(-0.6, -1, 0.8),
	})
	for key, value in props or {} do
		if key ~= "Parent" then
			(vf :: any)[key] = value
		end
	end

	local camera = Ui.new("Camera", { FieldOfView = FIELD_OF_VIEW, Parent = vf })
	vf.CurrentCamera = camera

	vf:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		frameCamera(vf)
	end)

	vf.Parent = parent
	return vf
end

-- 모형을 화면에 올림. 이전 모형은 지움. 모형 피벗(바닥 중앙)을 원점에 놓고 3/4 각도로 카메라를 맞춤
function Viewport.setModel(vf: ViewportFrame, model: Model?)
	for _, child in vf:GetChildren() do
		if child:IsA("Model") and child ~= model then
			child:Destroy()
		end
	end
	if not model then
		vf:SetAttribute(ATTR_HEIGHT_CENTER, nil)
		return
	end

	local entry = spinning[vf]
	model:PivotTo(CFrame.Angles(0, if entry then entry.Angle else 0, 0))
	model.Parent = vf

	local ok, boxCFrame, size = pcall(function()
		return model:GetBoundingBox()
	end)
	if not ok then
		return
	end
	-- 회전축(피벗, 원점)에서 가장 먼 모서리까지의 가로 거리
	local center = boxCFrame.Position
	local reachX = math.abs(center.X) + size.X / 2
	local reachZ = math.abs(center.Z) + size.Z / 2
	vf:SetAttribute(ATTR_HEIGHT_CENTER, center.Y)
	vf:SetAttribute(ATTR_FLAT, math.max(0.5, math.sqrt(reachX * reachX + reachZ * reachZ)))
	vf:SetAttribute(ATTR_HALF_HEIGHT, math.max(0.5, size.Y / 2))
	frameCamera(vf)
end

-- 명소 모형을 만들어 올림. 모형을 못 만들면 false (화면은 비워 둠)
function Viewport.setLandmark(vf: ViewportFrame, landmark: Landmarks.Landmark, size: number?): boolean
	local ok, model = pcall(Models.create, landmark, size or 10)
	if not ok or typeof(model) ~= "Instance" or not model:IsA("Model") then
		warn("[LandmarkRNG] 모형을 만들지 못했어요 (" .. landmark.Id .. "): " .. tostring(model))
		Viewport.setModel(vf, nil)
		return false
	end
	Viewport.setModel(vf, model)
	return true
end

-- 카드용 정적 썸네일 (회전 없음)
function Viewport.thumbnail(parent: Instance?, landmark: Landmarks.Landmark, props: { [string]: any }?): ViewportFrame
	local vf = Viewport.new(nil, props)
	Viewport.setLandmark(vf, landmark, 10)
	vf.Parent = parent
	return vf
end

local function step(dt: number)
	for vf, entry in spinning do
		if not vf.Parent then
			spinning[vf] = nil -- Destroy 된 화면
			continue
		end
		local model = currentModel(vf)
		if model then
			entry.Angle = (entry.Angle + math.rad(entry.Speed) * dt) % (2 * math.pi)
			model:PivotTo(CFrame.Angles(0, entry.Angle, 0))
		end
	end
end

-- 초당 degreesPerSecond 도로 수직축 회전. 0 이면 멈춤(현재 각도 유지)
function Viewport.setSpin(vf: ViewportFrame, degreesPerSecond: number)
	if degreesPerSecond == 0 then
		spinning[vf] = nil
		return
	end
	local entry = spinning[vf]
	if entry then
		entry.Speed = degreesPerSecond
	else
		spinning[vf] = { Speed = degreesPerSecond, Angle = 0 }
	end
	if not spinConnection then
		spinConnection = RunService.RenderStepped:Connect(step)
	end
end

return Viewport
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
