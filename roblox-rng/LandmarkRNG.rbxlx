	})
	Ui.round().Parent = track
	refs.CooldownFill = Ui.new("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		ZIndex = 6,
		Parent = track,
	})
	Ui.round().Parent = refs.CooldownFill

	local auto = Ui.chunkyButton({
		Name = "Auto",
		Position = UDim2.new(0.5, ROLL_BUTTON.X / 2 + 16, 1, -(ROLL_BUTTON.Y + AUTO_BUTTON.Y) / 2),
		Size = UDim2.fromOffset(AUTO_BUTTON.X, AUTO_BUTTON.Y),
		Color = "Gray",
		Icon = "auto",
		IconSize = 46,
		Text = "AUTO",
		TextSize = 24,
		Parent = container,
	})
	auto.Activated:Connect(onToggleAuto)
	refs.AutoButton = auto
	Ui.keyCap(auto.Face, "T", { Position = UDim2.fromOffset(4, 4) })
	refs.AutoBadge = Ui.chip({
		Name = "On",
		Color = "Coral",
		Text = "ON",
		Height = 24,
		TextSize = 16,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -10, 0, 2),
		Rotation = 12,
		ZIndex = 6,
		Visible = false,
		Parent = auto.Face,
	})
end

-- 굴림 연출 ------------------------------------------------------------------

local function buildReveal()
	local container = anchor(
		"Reveal",
		Vector2.new(0.5, 0.5),
		UDim2.fromScale(0.5, 0.45),
		UDim2.fromOffset(700, 500),
		8 -- 메뉴 창보다 위
	)
	container.Visible = false
	refs.Reveal = container

	local inner = Ui.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = container,
	})
	refs.RevealScale = Ui.new("UIScale", { Parent = inner })

	-- 지역 이름: 도는 동안은 지역 색 글자, 멈추면 지역 색 딱지
	local regionTag = Ui.new("Frame", {
		Name = "Region",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0),
		Size = UDim2.fromOffset(280, 48),
		BackgroundTransparency = 1,
		ZIndex = 4,
		Parent = inner,
	})
	Ui.round().Parent = regionTag
	refs.RegionStroke = Ui.stroke()
	refs.RegionStroke.Parent = regionTag
	refs.RegionTag = regionTag
	refs.RegionSkin = Ui.skin(regionTag, "tag", { Radius = 24, Height = 48 })
	if refs.RegionSkin then
		refs.RegionSkin.Visible = false
	end
	refs.RevealRegion = Ui.label({
		Position = UDim2.fromOffset(12, 4),
		Size = UDim2.new(1, -24, 1, -8),
		TextColor3 = WHITE,
		ZIndex = 2,
		Parent = regionTag,
	}, 34)
	Ui.outline(refs.RevealRegion, 3)

	local centerY = 62 + VIEW_SIZE / 2

	-- 뒤에서 도는 햇살 (막대 12개를 가운데 기준으로 돌려 놓음)
	local burst = Ui.new("Frame", {
		Name = "Burst",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0, centerY),
		Size = UDim2.fromOffset(500, 500),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 1,
		Parent = inner,
	})
	refs.Burst = burst
	refs.Rays = {}
	-- 햇살 그림이 있으면 그 그림 하나를 등급 색으로 물들여 돌림, 없으면 막대 12개
	refs.BurstImage = Ui.skin(burst, "sunburst")
	for i = 1, if refs.BurstImage then 0 else RAY_COUNT do
		local ray = Ui.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.new(0, 30, 1, 0),
			Rotation = (i - 1) * 180 / RAY_COUNT,
			BackgroundColor3 = WHITE,
			BorderSizePixel = 0,
			Parent = burst,
		})
		Ui.new("UIGradient", { Rotation = 90, Transparency = RAY_FADE, Parent = ray })
		table.insert(refs.Rays, ray)
	end

	-- 모형 뒤의 둥근 판
	local disc = Ui.new("Frame", {
		Name = "Disc",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0, centerY),
		Size = UDim2.fromOffset(VIEW_SIZE, VIEW_SIZE),
		BackgroundColor3 = Theme.Cream,
		ZIndex = 2,
		Parent = inner,
	})
	Ui.round().Parent = disc
	Ui.stroke(Theme.Ink, 5).Parent = disc
	local ring = Ui.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -18, 1, -18),
		BackgroundTransparency = 1,
		Parent = disc,
	})
	Ui.round().Parent = ring
	Ui.stroke(WHITE, 3, 0.15).Parent = ring
	refs.Disc = disc

	local viewProps = {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0, centerY),
		Size = UDim2.fromOffset(VIEW_SIZE - 16, VIEW_SIZE - 16),
		ZIndex = 3,
	}
	refs.EarthView = Viewport.new(inner, viewProps)
	Viewport.setLandmark(refs.EarthView, Landmarks.Globe, 10)
	refs.ResultView = Viewport.new(inner, viewProps)
	refs.ResultView.Visible = false

	-- 등급 리본 (판 아래쪽에 걸침). 꼬리가 아래 명소 이름 글자에 닿지 않게 판 가운데를 판 끝보다 6 위에
	local ribbon = Ui.ribbon({
		Name = "TierRibbon",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0, centerY + VIEW_SIZE / 2 - 6),
		Size = UDim2.fromOffset(250, 44),
		Visible = false,
		ZIndex = 4,
		MaxTextSize = 26,
		Outline = 2.5,
		Parent = inner,
	})
	refs.Ribbon = ribbon.Root
	refs.RibbonLabel = ribbon.Label
	refs.SetRibbonColor = ribbon.SetColor

	local nameTop = centerY + VIEW_SIZE / 2 + 34
	refs.RevealName = Ui.label({
		Name = "LandmarkName",
		Position = UDim2.fromOffset(0, nameTop),
		Size = UDim2.new(1, 0, 0, 66),
		Font = Theme.FontTitle,
		ZIndex = 4,
		Parent = inner,
	}, 62)
	Ui.outline(refs.RevealName, 4)
	refs.RevealOdds = Ui.label({
		Name = "Odds",
		Position = UDim2.fromOffset(0, nameTop + 66),
		Size = UDim2.new(1, 0, 0, 30),
		Font = Theme.FontTitle,
		TextColor3 = WHITE,
		ZIndex = 4,
		Parent = inner,
	}, 28)
	Ui.outline(refs.RevealOdds, 2.5)

	-- 딱지 줄: NEW / 별 상승 "★★☆☆☆ +1"(가챠 중복) / 발견 보너스(코인 + 숫자)
	local tagRow = Ui.new("Frame", {
		Name = "Tags",
		Position = UDim2.fromOffset(0, nameTop + 104),
		Size = UDim2.new(1, 0, 0, 36),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 4,
		Parent = inner,
	})
	Ui.list(Enum.FillDirection.Horizontal, 14, Enum.HorizontalAlignment.Center).Parent = tagRow
	refs.TagRow = tagRow
	refs.NewChip = Ui.chip({
		Name = "New",
		Color = "Coral",
		Text = "NEW",
		Font = Theme.FontTitle,
		Height = 32,
		TextSize = 22,
		LayoutOrder = 1,
		Parent = tagRow,
	})
	refs.StarChip = Ui.chip({
		Name = "StarUp",
		Color = "Grape",
		Font = Theme.FontTitle,
		Height = 32,
		TextSize = 21,
		LayoutOrder = 2,
		Parent = tagRow,
	})
	refs.StarChipScale = Ui.new("UIScale", { Parent = refs.StarChip.Root }) -- 결과가 나온 뒤 "퐁" 하고 커짐
	refs.BonusPill = Ui.pill({
		Name = "Bonus",
		AutoWidth = true,
		Size = UDim2.fromOffset(0, 32),
		Icon = "coin",
		IconSize = 44,
		TextSize = 21,
		TextColor3 = Ui.colorPair("Sun").Face,
		LayoutOrder = 3,
		Parent = tagRow,
	})
end

-- 서버 행운 띠 / 뉴스 속보 / 알림 자리 ------------------------------------------

local TOP_WIDTH = 600 -- 위 가운데 묶음 폭 = 속보 띠 폭
local TOP_HEIGHT = 380
local TOP_Y = 10
local TOP_GAP = 12 -- 왼쪽 위 스탯과 띄울 거리(화면 px)

-- 위 가운데 묶음 자리: 기본은 화면 가운데. 왼쪽 위 스탯(윗줄)과 겹치면 안 겹칠 만큼 오른쪽으로 비키고,
-- 그래도 화면 오른쪽 끝을 넘는 아주 좁은 화면이면 가운데로 두고 스탯 아래로 내림.
-- 메뉴가 가로로 접혀(휴대폰) 이 묶음 높이 안에 들어오면 메뉴 오른쪽 끝·아래 끝도 함께 비켜 감.
-- 모든 묶음이 같은 Ui.autoScale 배율을 받으므로 화면 px 로 계산 (화면 크기가 바뀔 때마다 다시, placeMenu 뒤에)
local function placeTop()
	local top = refs.Top
	if not top then
		return
	end
	local scale = Ui.scale()
	local width = gui.AbsoluteSize.X
	local half = TOP_WIDTH * scale / 2
	local reserve = STATS_POS.X + STATS_RESERVE * scale
	local menu = menuPlace
	if menu and menu.Top < TOP_Y + TOP_HEIGHT * scale then
		reserve = math.max(reserve, MENU_X + menu.Width)
	end
	local center = math.max(width / 2, reserve + TOP_GAP + half)
	if center + half <= width - STATS_POS.X then
		top.Position = UDim2.fromOffset(center, TOP_Y)
	else
		local below = STATS_POS.Y + STATS_SIZE.Y * scale
		if menu and MENU_X + menu.Width > width / 2 - half then
			below = math.max(below, menu.Top + menu.Height)
		end
		top.Position = UDim2.new(0.5, 0, 0, below + TOP_GAP)
	end
end

-- 화면 크기·배율이 바뀔 때: 메뉴 → 상점 → 위 가운데 묶음 순서로 자리를 다시 잡음
local function relayout()
	local size = gui.AbsoluteSize
	if size.X <= 0 or size.Y <= 0 then
		return -- 아직 화면에 안 붙음 (AbsoluteSize 가 바뀌면 다시 불림)
	end
	local scale = Ui.scale()
	local touch = Ui.touchOnly()
	placeMenu(size, scale, touch)
	placeShop(size, scale, touch)
	placeTop()
end

local function topList(parent: Instance, gap: number): UIListLayout
	local layout = Ui.list(Enum.FillDirection.Vertical, gap, Enum.HorizontalAlignment.Center)
	layout.VerticalAlignment = Enum.VerticalAlignment.Top
	layout.Parent = parent
	return layout
end

local function buildNotices()
	-- 위에서부터 [서버 행운 띠(켜졌을 때만)] [뉴스 속보] [알림] 순서로 쌓임. 띠가 뜨면 아래 둘이 함께 내려감
	local top =
		anchor("Top", Vector2.new(0.5, 0), UDim2.new(0.5, 0, 0, TOP_Y), UDim2.fromOffset(TOP_WIDTH, TOP_HEIGHT), 9)
	topList(top, 6)
	refs.Top = top

	-- 서버 행운: 도는 지구본 + "서버 행운 ×2 · 12:34"
	refs.ServerLuck = Ui.chip({
		Name = "ServerLuck",
		Color = "Grape",
		Icon = "globe",
		IconSpin = 60,
		IconSize = 50,
		Height = 40,
		TextSize = 22,
		StrokeThickness = 3,
		LayoutOrder = 1,
		Visible = false,
		Parent = top,
	})

	-- 뉴스 속보 (속보 수만큼만 높이를 차지 — 속보가 없으면 알림이 맨 위에 떠서 열린 창의 머리 줄을 가리지 않음)
	local news = Ui.new("Frame", {
		Name = "News",
		LayoutOrder = 2,
		Size = UDim2.fromOffset(TOP_WIDTH, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = top,
	})
	topList(news, 8)
	refs.News = news

	-- 잠깐 떴다 사라지는 알림(뉴스 아래)
	local notices = Ui.new("Frame", {
		Name = "Notices",
		LayoutOrder = 3,
		Size = UDim2.fromOffset(600, 200),
		BackgroundTransparency = 1,
		Parent = top,
	})
	topList(notices, 8)
	refs.Notices = notices
end

function Hud.init(playerGui: PlayerGui, handlers: Handlers): ScreenGui
	gui = Ui.new("ScreenGui", {
		Name = "LandmarkRNG",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = playerGui,
	})
	local flashGui = Ui.new("ScreenGui", {
		Name = "LandmarkRNGFlash",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 5,
		Parent = playerGui,
	})
	flashFrame = Ui.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Parent = flashGui,
	})

	tickSound = makeSound(1.4, 0.25)
	landSound = makeSound(1.1, 0.4)
	revealSound = makeSound(0.9, 0.6)
	rareSound = makeSound(0.5, 1)
	newsSound = makeSound(0.7, 0.5)
	luckSound = makeSound(0.6, 0.7)
	starSound = makeSound(1.9, 0.5)

	buildStats()
	buildMenu(handlers.Menu, handlers.Teleport, handlers.Arrange)
	buildShop(handlers.Menu)
	buildRollBar(handlers.Roll, handlers.ToggleAuto)
	buildReveal()
	buildNotices()
	gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(relayout)
	Ui.onRescale(relayout)
	relayout()
	Hud.render(nil)
	return gui
end

-- 환생 가능 배지: 켜질 때만 통통 뛰는 애니메이션을 돌림
local function setRebirthReady(ready: boolean)
	if ready == rebirthReady then
		return
	end
	rebirthReady = ready
	refs.RebirthBadge.Root.Visible = ready
	local tween = badgeTween
	if tween then
		tween:Cancel()
		badgeTween = nil
	end
	refs.RebirthBadgeScale.Scale = 1
	if ready then
		local pulse = TweenService:Create(
			refs.RebirthBadgeScale,
			TweenInfo.new(0.45, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
			{ Scale = 1.25 }
		)
		pulse:Play()
		badgeTween = pulse
	end
end

local function boostChip(boost: Perks.Boost): Ui.Chip
	local chip = boostChips[boost.Key]
	if not chip then
		chip = Ui.chip({
			Name = "Boost" .. boost.Key,
			Color = "Sun",
			Icon = boost.Icon,
			Height = 30,
			TextSize = 18,
			LayoutOrder = 3,
			Parent = refs.StatChips,
		})
		boostChips[boost.Key] = chip
	end
	return chip
end

-- 가벼운 갱신(0.25초마다): 부스트 남은 시간, 서버 행운 띠, 환생 배지. 글자는 바뀔 때만 고침
-- coins: 지금 보이는 코인(부드럽게 오르는 값). nil 이면 환생 배지는 그대로 둠
function Hud.tick(coins: number?)
	local elapsed = time() - boostsAt
	local active: { [string]: boolean } = {}
	for _, boost in boosts do
		local left = boost.Seconds - elapsed
		if left > 0 then
			active[boost.Key] = true
			local chip = boostChip(boost)
			setText(chip.Label, Ui.times(boost.Mult) .. " " .. Format.duration(left))
			chip.Root.Visible = true
		end
	end
	for key, chip in boostChips do
		if not active[key] then
			chip.Root.Visible = false
		end
	end

	-- 서버 행운: 스냅샷/이벤트 중 더 늦게 끝나는 쪽
	local banner = refs.ServerLuck
	local untilTime = math.max(snapshotLuckUntil or 0, eventLuckUntil)
	local left = untilTime - serverNow()
	local luckText = "서버 행운 " .. Ui.times(Perks.mult("ServerLuck", 2))
	if left > 0 then
		setText(banner.Label, luckText .. " · " .. Format.duration(left))
		banner.Root.Visible = true
	elseif snapshotLuckOn then
		setText(banner.Label, luckText)
		banner.Root.Visible = true
	else
		banner.Root.Visible = false
	end

	if coins and hudState then
		setRebirthReady((Perks.rebirthCheck(hudState, coins)))
	end
end

-- receivedAt: 스냅샷을 받은 시각(time()). 부스트·서버 행운의 "남은 초" 기준
function Hud.render(state: PlayerState.Snapshot?, receivedAt: number?)
	hudState = state
	if not state then
		refs.CoinLabel.Text = "..."
		refs.IncomeChip.Root.Visible = false
		refs.RollsChip.Root.Visible = false
		refs.LuckChip.Root.Visible = false
		refs.RebirthChip.Root.Visible = false
		refs.StampBadge.Root.Visible = false
		refs.ArrangeBadge.Root.Visible = false
		setRebirthReady(false)
		shownCoins = -1
		return
	end
	local at = receivedAt or time()
	refs.IncomeChip.Label.Text = "+" .. incomeText(state.Income) .. "/s"
	refs.IncomeChip.Root.Visible = true
	refs.RollsChip.Label.Text = Format.commas(state.Rolls)
	refs.RollsChip.Root.Visible = true
	refs.LuckChip.Label.Text = Ui.times(state.Luck)
	refs.LuckChip.Root.Visible = true

	-- 도감 버튼 배지: 받은 대륙 도장 수 (하나라도 있으면 금색 숫자)
	local stamps = #PlayerState.completedRegions(state)
	local badge = refs.StampBadge
	badge.Label.Text = string.format("%d/%d", stamps, #Landmarks.Regions)
	badge.Label.TextColor3 = if stamps > 0 then Ui.colorPair("Sun").Face else WHITE
	badge.Root.Visible = true

	-- 배치 버튼 배지: 직접 배치 중 전시하면 수입이 느는 명소 수 (0 이면 숨김)
	local better = #PlayerState.betterHidden(state)
	refs.ArrangeBadge.Label.Text = tostring(better)
	refs.ArrangeBadge.Root.Visible = better > 0

	-- 환생 수 딱지 (0 이면 숨김)
	local rebirths = Perks.rebirths(state)
	refs.RebirthChip.Label.Text = Format.commas(rebirths)
	refs.RebirthChip.Root.Visible = rebirths > 0

	-- 부스트 / 서버 행운 기준값 (스냅샷을 받은 순간 기준)
	local snapshot = state :: any
	boosts = Perks.boosts(snapshot)
	boostsAt = at
	snapshotLuckUntil, snapshotLuckOn = Perks.serverLuck(snapshot.ServerLuck, serverNow() - (time() - at))
	Hud.tick(state.Coins + state.Income * math.max(0, time() - at))
end

-- ServerLuck 이벤트: 띠를 켜고 "<이름> 서버 행운!" 알림
-- untilValue: 끝나는 시각(서버 시계, 유닉스 초) 또는 남은 초
function Hud.serverLuck(name: string, untilValue: number)
	eventLuckUntil = math.max(eventLuckUntil, Perks.toEpoch(untilValue, serverNow()))
	Hud.tick(nil)
	local text = if name ~= "" then Format.escape(name) .. " 서버 행운!" else "서버 행운!"
	Hud.toast(text, Ui.colorPair("Grape").Face, 4, "globe")
	play(luckSound)
end

-- 매 프레임 호출: 부드럽게 올라가는 코인 표시 (정수가 바뀔 때만 글자 갱신)
function Hud.setCoins(amount: number)
	local whole = math.max(0, math.floor(amount))
	if whole == shownCoins then
		return
	end
	shownCoins = whole
	refs.CoinLabel.Text = Format.commas(whole)
end

function Hud.setAuto(enabled: boolean)
	refs.AutoButton.SetColor(if enabled then "Sun" else "Gray")
	refs.AutoBadge.Root.Visible = enabled
end

-- 굴리는 중에는 지구본 아이콘이 빠르게 돎 (글자는 그대로)
function Hud.setRolling(rolling: boolean)
	local icon = refs.RollButton.Icon
	if icon then
		Icons.setSpin(icon, if rolling then 420 else 60)
	end
end

-- where: 지금 있는 곳 ("Plaza" | "Park"). 버튼은 반대쪽으로 가는 버튼이 됨
function Hud.setLocation(where: string)
	local button = refs.TeleportButton
	if where == "Park" then
		button.SetText("광장")
		button.SetIcon("plaza")
	else
		button.SetText("공원")
		button.SetIcon("park")
	end
end

-- 내 공원 부지가 있으면(어디에 있든) 이동 버튼 옆에 공원 배치 버튼
function Hud.setPlotOwned(owned: boolean)
	local arrange: Ui.ChunkyButton = refs.ArrangeButton
	if arrange.Root.Visible ~= owned then
		arrange.Root.Visible = owned
		relayout() -- 가로 한 줄 메뉴면 묶음 폭이 바뀜
	end
end

local hideBurst: () -> ()

-- 3D 배치 모드(ParkEdit): 왼쪽 메뉴(+ [배치])·상점·굴리기 줄을 숨기고 아래 가운데를 보관함 띠에 내줌
-- (놀이공원 시뮬레이션의 건설 모드처럼 공원 + 띠만). 위쪽 코인·알림은 그대로. 굴림 결과는 가운데 연출(공원 한가운데를
-- 가림) 대신 알림 줄의 작은 딱지 — 도는 중이던 연출도 바로 숨기고 결과만 딱지로(Hud.reveal).
-- 자동 굴리기는 부르는 쪽(init)이 배치 모드 동안 쉬게 함
function Hud.setEditing(on: boolean)
	editing = on
	refs.Menu.Visible = not on
	refs.RollBar.Visible = not on
	local shop: GuiObject? = refs.Shop
	if shop then
		shop.Visible = not on
	end
	if on and refs.Reveal.Visible then
		refs.Reveal.Visible = false
		Viewport.setSpin(refs.EarthView, 0)
		Viewport.setSpin(refs.ResultView, 0)
		hideBurst()
	end
end

-- 쿨타임 막대가 비었다가 seconds 동안 가득 참
function Hud.startCooldown(seconds: number)
	cooldownSeconds = seconds
	local fill = refs.CooldownFill
	fill.Size = UDim2.fromScale(0, 1)
	TweenService:Create(fill, TweenInfo.new(seconds, Enum.EasingStyle.Linear), { Size = UDim2.fromScale(1, 1) }):Play()
end

local function flash(color: Color3, strength: number)
	flashFrame.BackgroundColor3 = color
	flashFrame.BackgroundTransparency = 1 - strength
	TweenService:Create(flashFrame, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		BackgroundTransparency = 1,
	}):Play()
end

-- 화면 전체 번쩍임 (환생 등)
function Hud.flash(color: Color3, strength: number)
	flash(color, strength)
end

-- landed: 결과 지역에 멈췄으면 지역 색 딱지, 아니면 지역 색 글자만
local function showRegion(region: Landmarks.Region, landed: boolean)
	local label = refs.RevealRegion
	label.Text = region.Name
	local skin: ImageLabel? = refs.RegionSkin
	if skin then
		skin.Visible = landed
		skin.ImageColor3 = region.Color
	else
		refs.RegionTag.BackgroundColor3 = region.Color
		refs.RegionTag.BackgroundTransparency = if landed then 0 else 1
		refs.RegionStroke.Enabled = landed
	end
	label.TextColor3 = if landed then WHITE else region.Color
end

local function showBurst(color: Color3)
	for _, ray in refs.Rays do
		ray.BackgroundColor3 = color
	end
	if refs.BurstImage then
		refs.BurstImage.ImageColor3 = color
	end
	refs.Burst.Visible = true
	if not burstTween then
		-- 멈췄던 각도에서 이어서 돎(AUTO 빠른 결과가 햇살을 껐다 켜도 0° 로 튀지 않게)
		local from = refs.Burst.Rotation % 360
		refs.Burst.Rotation = from
		local tween = TweenService:Create(
			refs.Burst,
			TweenInfo.new(10, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1),
			{ Rotation = from + 360 }
		)
		tween:Play()
		burstTween = tween
	end
end

function hideBurst()
	refs.Burst.Visible = false
	local tween = burstTween
	if tween then
		tween:Cancel()
		burstTween = nil
	end
end

local function showRibbon(tier: Landmarks.Tier)
	refs.SetRibbonColor(tier.Color, tier.Color:Lerp(Theme.Ink, 0.35))
	refs.RibbonLabel.Text = tier.Name
	refs.Ribbon.Visible = true
end

-- 알림 줄에 딱지 하나(오래된 것부터 밀려남) — Hud.toast · 배치 모드 굴림 결과가 같이 씀
local function pushToast(text: string, color: Color3?, seconds: number?, icon: string?): Ui.Chip
	toastOrder += 1
	while #toasts >= MAX_TOASTS do
		local oldest = table.remove(toasts, 1)
		if oldest then
			oldest:Destroy()
		end
	end

	local chip = Ui.chip({
		Name = "Toast",
		Color = color or Ui.colorPair("Sky").Face,
		Text = text,
		Icon = icon,
		IconSize = 48,
		Height = 40,
		TextSize = 22,
		StrokeThickness = 3,
		LayoutOrder = toastOrder,
		Parent = refs.Notices,
	})
	local box = chip.Root
	table.insert(toasts, box)
	local scale = Ui.new("UIScale", { Scale = 0.4, Parent = box })
	TweenService:Create(scale, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 })
		:Play()

	task.delay(seconds or 3, function()
		if not box.Parent then
			return -- 이미 밀려나서 지워짐
		end
		TweenService:Create(scale, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Scale = 0 })
			:Play()
		task.wait(0.18)
		local index = table.find(toasts, box)
		if index then
			table.remove(toasts, index)
		end
		box:Destroy()
	end)
	return chip
end

-- 별 상승 딱지 글자(가챠 중복): 채운 별(금색) + 빈 별 + "+1". 별이 가득 차면(★5) "+1" 대신 "MAX"
local function starUpText(stars: number): string
	local max = PlayerState.MAX_STARS
	local count = math.clamp(math.floor(stars), 1, max)
	return Ui.starsRich(count, max) .. (if count >= max then " MAX" else " +1")
end

-- 알림 줄의 굴림 결과 딱지: [지구본] 명소 이름(등급 색) + 오른쪽 위 작은 딱지(처음 발견 = NEW, 또 뽑아 별이 오름 = "★+1",
-- ★5 가 되면 "★MAX"). 배치 모드 결과(compactReveal)와 AUTO 별 상승 알림(starUpToast)이 같이 씀. 소리는 부르는 쪽에서
local function resultToast(landmark: Landmarks.Landmark, info: RevealInfo, name: string): Ui.Chip
	local chip = pushToast(landmark.Name, landmark.Tier.Color, 2.5, "globe")
	chip.Root.Name = name
	if info.IsNew or info.StarUp then
		local maxed = (info.Stars or 0) >= PlayerState.MAX_STARS
		Ui.chip({
			Name = if info.IsNew then "New" else "StarUp",
			Color = if info.IsNew then "Coral" else "Grape",
			Text = if info.IsNew then "NEW" else Ui.starsRich(1, 1) .. (if maxed then "MAX" else "+1"),
			Height = 20,
			TextSize = 14,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(1, -2, 0, 0),
			Rotation = 12,
			ZIndex = 6,
			Parent = chip.Root,
		})
	end
	return chip
end

-- 배치 모드의 굴림 결과: 가운데 연출 대신 알림 줄에 결과 딱지 하나(resultToast). 보너스는 생략(코인은 위에서 올라감).
-- 희귀하면 소리만 다르게(번쩍임 없음)
local function compactReveal(landmark: Landmarks.Landmark, info: RevealInfo)
	resultToast(landmark, info, "RollResult")
	play(if landmark.Tier.Rank >= 4 then rareSound else revealSound)
	if info.StarUp then
		play(starSound)
	end
end

-- AUTO 중 별 상승(가챠 중복): 다음 굴림이 곧 가운데 카드를 덮으므로(이미 발견한 명소는 빠른 결과라 굴림 간격, 짧으면
-- 0.42초만 보임) 알림 줄에도 결과 딱지 + "★+1"/"★MAX" 를 2.5초 남김. AUTO 속도는 그대로. 별 상승 알림은 한 칸만 씀 — 초반 AUTO 는
-- 거의 매번 별이 올라서, 새 것이 이전 별 알림을 바꿔 다른 알림(도감 +N·구매 등)을 밀어내지 않게
local starToast: GuiObject? = nil
local function starUpToast(landmark: Landmarks.Landmark, info: RevealInfo)
	local previous = starToast
	if previous and previous.Parent then
		local index = table.find(toasts, previous)
		if index then
			table.remove(toasts, index)
		end
		previous:Destroy()
	end
	starToast = resultToast(landmark, info, "StarUpToast").Root
end

-- AUTO 빠른 결과를 쓸지: 자동 굴림(Fast) 중 이미 발견한 명소(IsNew 아님 — 자동 발견 포함). Config.AUTO_QUICK_REVEAL 이
-- false 면 모든 결과를 등급 길이의 연출로
local function quickPace(info: RevealInfo): boolean
	return info.Fast and not info.IsNew and Config.AUTO_QUICK_REVEAL == true
end

-- 결과 카드 퐁: RevealScale 을 from 에서 1 로(이전 퐁은 멈춤)
local function popCard(from: number, seconds: number)
	local previous = popTween
	if previous then
		previous:Cancel()
	end
	refs.RevealScale.Scale = from
	local tween = TweenService:Create(
		refs.RevealScale,
		TweenInfo.new(seconds, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
		{ Scale = 1 }
	)
	popTween = tween
	tween:Play()
end

-- 결과 카드 내용: 지구본 → 명소 모형(같은 명소면 모형을 다시 만들지 않음), 등급 색 판·리본, 이름·확률,
-- 딱지 줄(NEW · 별 상승 "★★☆☆☆ +1" · 발견 보너스). 별이 오르면 딱지가 퐁 + 딩 소리, AUTO 면 알림 줄에도(starUpToast)
local function showResult(landmark: Landmarks.Landmark, info: RevealInfo)
	local tier = landmark.Tier
	Viewport.setSpin(refs.EarthView, 0)
	refs.EarthView.Visible = false
	if resultId ~= landmark.Id then
		resultId = if Viewport.setLandmark(refs.ResultView, landmark, 10) then landmark.Id else nil
	end
	refs.ResultView.Visible = true
	Viewport.setSpin(refs.ResultView, 40)
	refs.Disc.BackgroundColor3 = tier.Color:Lerp(WHITE, 0.6)
	showRibbon(tier)

	refs.RevealName.Text = landmark.Name
	refs.RevealName.TextColor3 = tier.Color
	refs.RevealOdds.Text = Format.oneIn(landmark.OneIn)

	local bonus = info.Bonus or 0
	refs.NewChip.Root.Visible = info.IsNew
	refs.StarChip.Root.Visible = info.StarUp
	if info.StarUp then
		refs.StarChip.Label.Text = starUpText(info.Stars or 0)
	end
	refs.BonusPill.Root.Visible = bonus > 0
	if bonus > 0 then
		refs.BonusPill.Label.Text = "+" .. Format.commas(bonus)
	end
	refs.TagRow.Visible = info.IsNew or info.StarUp or bonus > 0
	if info.StarUp then
		local pop = refs.StarChipScale
		pop.Scale = 0.3
		TweenService:Create(pop, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 })
			:Play()
		play(starSound)
		if info.Fast then
			starUpToast(landmark, info)
		end
	end
end

-- seconds 뒤에 가운데 카드를 숨김(그 사이 다음 연출이 시작됐으면 그대로 둠)
local function hideLater(seconds: number)
	local token = hideToken
	task.delay(seconds, function()
		if token == hideToken then
			refs.Reveal.Visible = false
			Viewport.setSpin(refs.ResultView, 0)
			hideBurst()
		end
	end)
end

-- AUTO 빠른 결과(이미 발견한 명소): 지구본 회전·착지·"? ? ?" 없이 결과 카드가 바로 퐁 — 등급 색 판·리본, 이름·확률,
-- 별 딱지는 원래 연출과 같음. 기다리지 않음(yield 없음): 부르는 쪽(init roll)은 곧바로 다음 굴림을 준비해서 서버 굴림
-- 간격만 기다리고, 카드는 다음 결과가 덮을 때까지 보임. 6등급 이상은 더 크게 퐁 + 햇살(6등급은 지금 행운으로도 드물 때만 —
-- QUICK_RARE_LUCK), 전설은 희귀 소리 + 옅은 번쩍임 (퐁 0.35초 < 가장 짧은 굴림 간격 0.42초). 흔한 결과는 작은 착지 소리만
-- (초당 2번 넘게 울려도 시끄럽지 않게)
local function quickReveal(landmark: Landmarks.Landmark, info: RevealInfo)
	local tier = landmark.Tier
	local rare = tier.Rank >= 7
		or (tier.Rank >= QUICK_RARE_RANK and landmark.OneIn >= QUICK_RARE_LUCK * math.max(1, info.Luck))
	refs.Reveal.Visible = true
	showRegion(Landmarks.RegionById[landmark.Region] or Landmarks.Regions[1], true)
	showResult(landmark, info)
	if rare then
		showBurst(tier.Color)
	else
		hideBurst()
	end
	popCard(if rare then 1.35 else 1.15, if rare then QUICK_RARE_POP_SECONDS else QUICK_POP_SECONDS)
	if tier.Rank >= 7 then
		flash(tier.Color, 0.35)
		play(rareSound)
	else
		play(if rare then revealSound else landSound)
	end
	hideLater(math.max(QUICK_HIDE_SECONDS, cooldownSeconds + QUICK_HIDE_AFTER_COOLDOWN))
end

-- 굴림 연출. 결과를 보여 줄 때까지 기다립니다(yield) — AUTO 빠른 결과(quickReveal)만 기다리지 않음.
-- 1) 지구본이 빠르게 돌며 지역 이름이 바뀌다 점점 느려짐 → 2) 결과 지역에 멈춤 → 3) 명소 공개
-- 배치 모드면(도는 중에 들어가도) 가운데 연출 없이 결과만 작은 딱지로(compactReveal) — 결과를 보인 뒤에 돌아감.
-- 자동 굴림 중 이미 발견한 명소는 결과 카드만 퐁(quickReveal). 새 발견·수동 굴림은 등급 길이 그대로
function Hud.reveal(landmark: Landmarks.Landmark, info: RevealInfo)
	hideToken += 1
	local previous = popTween
	if previous then
		previous:Cancel()
		popTween = nil
	end
	if editing then
		compactReveal(landmark, info)
		return
	end
	if quickPace(info) then
		quickReveal(landmark, info)
		return
	end
	local tier = landmark.Tier
	local rank = tier.Rank
	local duration = REVEAL_SECONDS[rank] or 3
	if info.Fast and rank < 4 then
		duration = math.max(0.35, duration * 0.5)
	end
	local region = Landmarks.RegionById[landmark.Region] or Landmarks.Regions[1]
	local regions = Landmarks.Regions

	local container = refs.Reveal
	container.Visible = true
	refs.RevealScale.Scale = 1
	hideBurst()
	refs.Ribbon.Visible = false
	refs.RevealName.Text = ""
	refs.RevealOdds.Text = ""
	refs.TagRow.Visible = false
	refs.Disc.BackgroundColor3 = Theme.Cream
	refs.ResultView.Visible = false
	Viewport.setSpin(refs.ResultView, 0)
	refs.EarthView.Visible = true

	-- 1) 지구본이 돌며 지역이 바뀜. 실제로 지난 시간을 더해야 연출 길이가 늘어지지 않음
	local index = spinRandom:NextInteger(1, #regions)
	local elapsed = 0
	while elapsed < duration and not editing do -- 배치 모드에 들어가면(연출은 숨김) 바로 결과 딱지로
		index = index % #regions + 1
		showRegion(regions[index], false)
		play(tickSound)
		local t = elapsed / duration
		Viewport.setSpin(refs.EarthView, 60 + 840 * (1 - t) * (1 - t))
		local interval = 0.05 + t * t * 0.22
		elapsed += task.wait(interval)
	end

	-- 배치 모드에 들어갔으면(연출은 setEditing 이 숨김) 결과만 딱지로
	local function switched(): boolean
		if editing then
			compactReveal(landmark, info)
			return true
		end
		return false
	end
	if switched() then
		return
	end

	-- 2) 결과 지역에 착지
	showRegion(region, true)
	Viewport.setSpin(refs.EarthView, 30)
	play(landSound)
	task.wait(if info.Fast and rank < 4 then LAND_SECONDS * 0.5 else LAND_SECONDS)
	if switched() then
		return
	end

	-- 불가사의 이상은 한 박자 뜸 들이기
	if rank >= 5 then
		refs.RevealName.Text = "? ? ?"
		refs.RevealName.TextColor3 = tier.Color
		showRibbon(tier)
		showBurst(tier.Color)
		flash(BLACK, 0.6)
		task.wait(SUSPENSE_SECONDS)
		if switched() then
			return
		end
	end

	-- 3) 결과 공개: 지구본 → 명소 모형(배치 모드에 잠깐 들어갔다 나와서 숨었어도 다시 보임)
	container.Visible = true
	showResult(landmark, info)
	showBurst(tier.Color)
	popCard(1.35, 0.35)
	if rank >= 4 then
		flash(tier.Color, math.min(0.25 + rank * 0.08, 0.8))
		play(rareSound)
	else
		play(revealSound)
	end

	-- 결과를 잠깐 보여 줌 (자동 굴림 중에도 희귀 명소는 바로 덮이지 않게)
	local hold = if rank >= 4 then (if info.Fast then 1.8 else 0.6) else (if info.Fast then 0.2 else 0.1)
	task.wait(hold)
	hideLater(if info.Fast then 1 else 2.5)
end

-- 잠깐 떴다 사라지는 알림: [아이콘][짧은 글자] 색 딱지. color 는 딱지 바탕색, icon 은 Icons 이름
function Hud.toast(text: string, color: Color3?, seconds: number?, icon: string?)
	pushToast(text, color, seconds, icon)
end

-- 대륙 도장을 새로 받음: [도장 그림] "도장 +25%"(대륙 색) 알림 + 행운 소리. 알림을 누르면 onOpen(도감의 그 대륙 탭 열기)
function Hud.stampToast(region: Landmarks.Region, onOpen: () -> ())
	local art = "stamp_" .. string.lower(region.Id)
	local bonus = math.floor(Config.REGION_LUCK_BONUS * 100 + 0.5)
	local chip =
		pushToast(string.format("도장 +%d%%", bonus), region.Color, 5, if Icons.imageId(art) then art else "passport")
	local box = chip.Root
	box.Name = "StampToast"
	box:SetAttribute("Region", region.Id)
	-- 딱지 안은 UIListLayout 이라 버튼을 넣지 않고 딱지 자체의 입력을 받음(Active = 뒤 3D 화면으로 안 넘김)
	box.Active = true
	box.InputBegan:Connect(function(input: InputObject)
		local kind = input.UserInputType
		if kind == Enum.UserInputType.MouseButton1 or kind == Enum.UserInputType.Touch then
			onOpen()
		end
	end)
	play(luckSound)
end

-- 서버 전체 "속보": 신문 띠가 오른쪽에서 밀려 들어와 잠시 머문 뒤 쏙 사라짐
-- [속보 딱지] 이름 · 명소(등급 색) · 1 in N  [주사위 #굴림 수]
function Hud.news(playerName: string, landmark: Landmarks.Landmark, rollNumber: number)
	local tier = landmark.Tier
	newsOrder += 1

	-- 너무 많이 쌓이면 가장 오래된 것부터 지움
	while #newsItems >= MAX_NEWS do
		local oldest = table.remove(newsItems, 1)
		if oldest then
			oldest:Destroy()
		end
	end

	local item = Ui.new("Frame", {
		LayoutOrder = newsOrder,
		Size = UDim2.new(1, 0, 0, 54),
		BackgroundTransparency = 1,
		Parent = refs.News,
	})
	table.insert(newsItems, item)

	local slide = Ui.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(2, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = item,
	})
	local scale = Ui.new("UIScale", { Parent = slide })

	-- 신문 띠: 크림 바탕 + Ink 테두리 + Ink 글자
	local bar = Ui.new("Frame", {
		Position = UDim2.fromOffset(56, 4),
		Size = UDim2.new(1, -56, 1, -8),
		BackgroundColor3 = Theme.Cream,
		ZIndex = 1,
		Parent = slide,
	})
	Ui.corner(10).Parent = bar
	Ui.stroke(Theme.Ink, 3).Parent = bar
	Ui.skin(bar, "panel_paper", { Radius = 10, Height = 46, CenterColor = Theme.Cream })
	Ui.label({
		Position = UDim2.fromOffset(66, 5),
		Size = UDim2.new(1, -66 - 130, 1, -10),
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = string.format(
			'%s · <font color="%s">%s</font> · <font color="%s">%s</font>',
			Format.escape(playerName),
			Format.hex(tier.Color:Lerp(Theme.Ink, 0.35)),
			Format.escape(landmark.Name),
			Format.hex(ODDS_COLOR),
			Format.oneIn(landmark.OneIn)
		),
		Parent = bar,
	}, 22)
	Ui.chip({
		Name = "Rolls",
		Color = "Sky",
		Icon = "dice",
		Text = "#" .. Format.commas(rollNumber),
		Height = 28,
		TextSize = 16,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		ZIndex = 2,
		Parent = bar,
	})

	-- 빨간 "속보" 도장 딱지 (살짝 기울임)
	local stamp = Ui.new("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.fromOffset(112, 46),
		BackgroundColor3 = Ui.colorPair("Coral").Face,
		Rotation = -6,
		ZIndex = 2,
		Parent = slide,
	})
	Ui.corner(10).Parent = stamp
	Ui.stroke(Theme.Ink, 3).Parent = stamp
	Ui.skin(stamp, "tag", { Radius = 10, Height = 46, Color = Ui.colorPair("Coral").Face })
	local stampRing = Ui.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -10, 1, -10),
		BackgroundTransparency = 1,
		Parent = stamp,
	})
	Ui.corner(7).Parent = stampRing
	Ui.stroke(WHITE, 2, 0.25).Parent = stampRing
	local stampLabel = Ui.label({
		Position = UDim2.fromOffset(8, 6),
		Size = UDim2.new(1, -16, 1, -12),
		Font = Theme.FontTitle,
		Text = "속보",
		TextColor3 = WHITE,
		ZIndex = 2,
		Parent = stamp,
	}, 26)
	Ui.outline(stampLabel, 2.5)

	play(newsSound)
	TweenService:Create(slide, TweenInfo.new(0.45, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
		Position = UDim2.fromScale(0.5, 0.5),
	}):Play()

	task.delay(NEWS_SECONDS, function()
		if not item.Parent then
			return -- 이미 밀려나서 지워짐
		end
		TweenService:Create(scale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
			Scale = 0,
		}):Play()
		task.wait(0.32)
		local index = table.find(newsItems, item)
		if index then
			table.remove(newsItems, index)
		end
		item:Destroy()
	end)
end

return Hud
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">Icons</string>
            <string name="Source"><![CDATA[-- 아이콘 (이모지 대신). 모든 아이콘은 Icons.view 하나로 그립니다(Ui.icon 도 이걸 부름).
--   Shared/ImageIds 에 그림 Id 가 있으면 ImageLabel(그린 그림), 없으면 기본 파트로 만든 3D 미니 모형(ViewportFrame).
--   Icons.view(parent, "coin", { Size = ..., Position = ..., AnchorPoint = ..., Spin = 60 }) -> Frame(이름 "Icon")
--   Icons.set(icon, "plaza")   -- 이미 만든 아이콘의 그림만 바꿈 (그림 <-> 3D 가 바뀌어도 됨)
--   Icons.setSpin(icon, 420)   -- 회전 속도(초당 도). 그림 아이콘은 빠를 때만 빙글 돌고, 느린 회전은 3D 에만 적용
-- 3D 모형은 이름별로 한 번만 만들어 두고 복제해서 씁니다. 파트 수는 아이콘마다 3~15개 정도로 작게 유지.
-- 아이콘: coin, globe(=roll), passport, album(=collection), hammer, park, plaza, dice, clover(=luck), star,
--   star_empty, news, lock, auto, close, check, arrow_up, plane, ticket, rebirth,
--   podium(공원 자동 배치: 1·2·3등 시상대 + 별), arrange(공원 배치 모드: 2×2 칸 판 위 미니 명소 셋 + 빈 칸 "+"),
--   crate(배치 모드 보관: 뚜껑 열린 나무 상자 + 미니 명소), camera(배치 모드 시점 바꾸기: 사진기),
--   robux(Robux 표시: 흰 육각형 + 가운데 네모 구멍 — 상점 버튼·Robux 가격)
--   (stamp_* 는 그림이 있을 때만 씀)

local RunService = game:GetService("RunService")

local Ui = require(script.Parent.Ui)
local Viewport = require(script.Parent.Viewport)

local Icons = {}

local V = Vector3.new
local rgb = Color3.fromRGB
local Mat = Enum.Material
local PI = math.pi

local UPRIGHT = CFrame.Angles(0, 0, PI / 2) -- 원기둥(길이 축 = X)을 세움
local ALONG_Z = CFrame.Angles(0, PI / 2, 0) -- 원기둥 길이 축을 Z 로 (정면을 보는 원판)
local FACE = CFrame.Angles(0, math.rad(-18), 0) -- 정면(-Z)을 카메라 쪽으로 살짝 돌려 옆면도 보이게

-- 색 (UI 테마와 맞춤)
local GOLD = rgb(255, 206, 64)
local GOLD_DEEP = rgb(222, 150, 24)
local OCEAN = rgb(57, 160, 255)
local LAND = rgb(76, 205, 96)
local SNOW = rgb(250, 252, 255)
local NAVY = rgb(38, 62, 140)
local CREAM = rgb(255, 244, 220)
local SKY = rgb(57, 160, 255)
local CORAL = rgb(255, 94, 91)
local SUN = rgb(255, 197, 61)
local GRAPE = rgb(155, 107, 255)
local GRASS = rgb(96, 196, 90)
local LEAF = rgb(58, 160, 74)
local LEAF_LIGHT = rgb(110, 210, 100)
local WOOD = rgb(150, 98, 58)
local WOOD_DARK = rgb(105, 68, 42)
local IRON = rgb(70, 70, 86)
local STEEL = rgb(160, 166, 184)
local MARBLE = rgb(246, 240, 228)
local MARBLE_SHADE = rgb(214, 204, 186)
local NEWSPRINT = rgb(236, 232, 220)
local INK = rgb(30, 27, 46)
local CLOVER = rgb(70, 190, 90)
local CLOVER_DARK = rgb(40, 140, 64)
local STAR_GRAY = rgb(196, 190, 212)

local function style(part: BasePart, cf: CFrame, size: Vector3, color: Color3, material: Enum.Material?)
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Size = size
	part.CFrame = cf
	part.Color = color
	part.Material = material or Mat.SmoothPlastic
end

local function part(
	model: Model,
	shape: Enum.PartType,
	cf: CFrame,
	size: Vector3,
	color: Color3,
	material: Enum.Material?
): BasePart
	local p = Instance.new("Part")
	p.Shape = shape -- 크기보다 먼저(공 모양은 크기가 균일해짐)
	style(p, cf, size, color, material)
	p.Parent = model
	return p
end

local function block(model: Model, cf: CFrame, size: Vector3, color: Color3, material: Enum.Material?): BasePart
	return part(model, Enum.PartType.Block, cf, size, color, material)
end

local function ball(model: Model, center: Vector3, d: number, color: Color3, material: Enum.Material?): BasePart
	return part(model, Enum.PartType.Ball, CFrame.new(center), V(d, d, d), color, material)
end

-- 길이 축이 cf 의 X 축인 원기둥
local function cyl(
	model: Model,
	cf: CFrame,
	length: number,
	d: number,
	color: Color3,
	material: Enum.Material?
): BasePart
	return part(model, Enum.PartType.Cylinder, cf, V(length, d, d), color, material)
end

local function wedge(model: Model, cf: CFrame, size: Vector3, color: Color3, material: Enum.Material?): BasePart
	local p = Instance.new("WedgePart")
	style(p, cf, size, color, material)
	p.Parent = model
	return p
end

local BUILDERS: { [string]: (Model) -> () } = {}

-- 동전: 모로 선 금화. 가운데 면 + 도드라진 테두리(조각 12개) + 가운데 마름모 문양
function BUILDERS.coin(m)
	local center = FACE * CFrame.new(0, 2.15, 0) * ALONG_Z -- 로컬 X = 동전 두께 방향
	cyl(m, center, 0.56, 4.1, GOLD)
	local pieces = 12
	local outer, width = 2.12, 0.42
	local chord = 2 * outer * math.sin(PI / pieces) + 0.06
	for k = 0, pieces - 1 do
		local cf = center * CFrame.Angles(k * 2 * PI / pieces, 0, 0) * CFrame.new(0, outer - width / 2, 0)
		block(m, cf, V(0.8, width, chord), GOLD_DEEP, Mat.Foil)
	end
	block(m, center * CFrame.Angles(PI / 4, 0, 0), V(0.66, 1.05, 1.05), GOLD_DEEP)
end

-- 지구본: 파란 공 + 튀어나온 초록 대륙 + 북극 얼음
function BUILDERS.globe(m)
	local radius = 2.1
	local center = V(0, radius, 0)
	ball(m, center, radius * 2, OCEAN)
	local function surface(lat: number, lon: number, r: number): Vector3
		local phi, lambda = math.rad(lat), math.rad(lon)
		return center
			+ V(r * math.cos(phi) * math.sin(lambda), r * math.sin(phi), -r * math.cos(phi) * math.cos(lambda))
	end
	local lands = {
		{ 12, 20, 1.9 },
		{ 45, 70, 2 },
		{ -18, 130, 1.5 },
		{ 38, -100, 2 },
		{ -22, -58, 1.6 },
		{ 55, 170, 1.4 },
	}
	for _, land in lands do
		local d = land[3]
		ball(m, surface(land[1], land[2], radius - d / 2 + 0.28), d, LAND)
	end
	ball(m, surface(90, 0, radius - 0.6 + 0.22), 1.2, SNOW)
end

-- 여권: 남색 수첩 + 오른쪽으로 보이는 종이 + 금색 문장
function BUILDERS.passport(m)
	local base = FACE * CFrame.new(0, 2.1, 0) * CFrame.Angles(0, 0, math.rad(-6))
	block(m, base, V(3, 4.2, 0.55), NAVY)
	block(m, base * CFrame.new(0.1, 0, 0), V(2.92, 4, 0.46), CREAM)
	cyl(m, base * CFrame.new(0, 0.5, -0.3) * ALONG_Z, 0.06, 1.5, GOLD)
	block(m, base * CFrame.new(0, -0.8, -0.3), V(1.7, 0.16, 0.06), GOLD)
	block(m, base * CFrame.new(0, -1.15, -0.3), V(1.2, 0.12, 0.06), GOLD)
end

-- 도감(컬렉션): 부채꼴로 펼친 카드 3장 (앞 카드에는 작은 그림)
function BUILDERS.album(m)
	local cards = {
		{ Angle = 20, Z = 0.3, Color = SKY },
		{ Angle = 0, Z = 0, Color = GRAPE },
		{ Angle = -20, Z = -0.3, Color = CORAL },
	}
	local front: CFrame? = nil
	for _, card in cards do
		local cf = FACE * CFrame.new(0, 0.2, card.Z) * CFrame.Angles(0, 0, math.rad(card.Angle)) * CFrame.new(0, 1.7, 0)
		block(m, cf, V(2.3, 3.2, 0.16), card.Color)
		block(m, cf * CFrame.new(0, 0.3, -0.05), V(1.8, 1.9, 0.14), CREAM)
		front = cf
	end
	if front then
		ball(m, (front * CFrame.new(0.45, 0.8, -0.12)).Position, 0.5, SUN)
		block(m, front * CFrame.new(0, -0.35, -0.08), V(1.8, 0.55, 0.16), GRASS)
	end
end

-- 망치(업그레이드): 나무 손잡이 + 빨간 손잡이 끝 + 쇠머리
function BUILDERS.hammer(m)
	local base = FACE * CFrame.new(0, 2.5, 0) * CFrame.Angles(0, 0, math.rad(-35))
	block(m, base * CFrame.new(0, -0.5, 0), V(0.55, 4, 0.55), WOOD)
	block(m, base * CFrame.new(0, -2.1, 0), V(0.68, 1.1, 0.68), CORAL)
	block(m, base * CFrame.new(0, 1.6, 0), V(2.8, 1.1, 1.1), STEEL, Mat.Metal)
	block(m, base * CFrame.new(1.45, 1.6, 0), V(0.3, 1.25, 1.25), IRON, Mat.Metal)
end

-- 공원: 잔디 원판 + 나무 + 벤치
function BUILDERS.park(m)
	cyl(m, CFrame.new(0, 0.2, 0) * UPRIGHT, 0.4, 5.2, GRASS)
	cyl(m, CFrame.new(-0.9, 1.4, 0.5) * UPRIGHT, 2, 0.6, WOOD)
	ball(m, V(-0.9, 3.1, 0.5), 2.6, LEAF)
	ball(m, V(-0.1, 2.5, -0.1), 1.6, LEAF_LIGHT)
	local bench = FACE * CFrame.new(1.05, 0, -0.9)
	block(m, bench * CFrame.new(0, 1, 0), V(1.9, 0.2, 0.7), WOOD_DARK)
	block(m, bench * CFrame.new(0, 1.45, 0.28), V(1.9, 0.5, 0.14), WOOD_DARK)
	block(m, bench * CFrame.new(-0.75, 0.65, 0), V(0.18, 0.5, 0.6), IRON)
	block(m, bench * CFrame.new(0.75, 0.65, 0), V(0.18, 0.5, 0.6), IRON)
end

-- 광장: 고전 기둥 (받침 + 기둥 + 소용돌이 머리)
function BUILDERS.plaza(m)
	local base = FACE
	block(m, base * CFrame.new(0, 0.25, 0), V(2.8, 0.5, 2.8), MARBLE_SHADE)
	block(m, base * CFrame.new(0, 0.65, 0), V(2.3, 0.3, 2.3), MARBLE)
	cyl(m, base * CFrame.new(0, 2.7, 0) * UPRIGHT, 3.8, 1.6, MARBLE)
	block(m, base * CFrame.new(0, 4.75, 0), V(2.2, 0.3, 2.2), MARBLE)
	cyl(m, base * CFrame.new(-1.05, 4.7, 0) * ALONG_Z, 2.2, 0.62, MARBLE_SHADE)
	cyl(m, base * CFrame.new(1.05, 4.7, 0) * ALONG_Z, 2.2, 0.62, MARBLE_SHADE)
	block(m, base * CFrame.new(0, 5.1, 0), V(2.9, 0.4, 2.9), MARBLE_SHADE)
end

-- 삼각형 화살촉: base 좌표계의 XY 평면에서 baseCenter(밑변 가운데)부터 dir 방향으로 length 만큼.
-- 직각 쐐기 두 개를 가운데 줄 양쪽에 붙임(쐐기의 직각 = 밑변 가운데, 세로 변 = dir, 가로 변 = 바깥 → 가운데)
local function arrowhead(
	model: Model,
	base: CFrame,
	baseCenter: Vector3,
	dir: Vector3,
	length: number,
	halfWidth: number,
	thickness: number,
	color: Color3
)
	local u = dir.Unit
	local v = V(-u.Y, u.X, 0)
	for _, side in { 1, -1 } do
		local yAxis = u
		local zAxis = v * -side
		local xAxis = yAxis:Cross(zAxis)
		local position = baseCenter + u * (length / 2) + v * (side * halfWidth / 2)
		wedge(model, base * CFrame.fromMatrix(position, xAxis, yAxis, zAxis), V(thickness, length, halfWidth), color)
	end
end

-- 별: 가운데 원판 + 뾰족한 끝 5개(직각 쐐기 2개씩). center/scale 을 주면 그 자리에 그 크기로(기본: 지름 4.4 별)
local function buildStar(m: Model, color: Color3, at: CFrame?, scale: number?)
	local k = scale or 1
	local outerRadius, innerRadius, thickness = 2.2 * k, 0.95 * k, 0.7 * k
	local center = at or FACE * CFrame.new(0, 2.2, 0) -- 별 평면 = 로컬 XY, 두께 = 로컬 Z
	cyl(m, center * ALONG_Z, thickness, innerRadius * 2, color)
	local apothem = innerRadius * math.cos(math.rad(36))
	local halfBase = innerRadius * math.sin(math.rad(36))
	local length = outerRadius - apothem
	for k = 0, 4 do
		local a = math.rad(90 + 72 * k)
		local u = V(math.cos(a), math.sin(a), 0) -- 뾰족한 방향
		local v = V(-math.sin(a), math.cos(a), 0) -- 가로 방향
		local mid = u * apothem -- 끝 밑변의 가운데(직각 꼭짓점)
		for _, side in { 1, -1 } do
			-- 쐐기의 직각 = 밑변 가운데, 세로 변(Y) = 뾰족한 방향, 가로 변(Z) = 바깥 꼭짓점 → 가운데
			local yAxis = u
			local zAxis = v * -side
			local xAxis = yAxis:Cross(zAxis)
			local position = mid + u * (length / 2) + v * (side * halfBase / 2)
			wedge(m, center * CFrame.fromMatrix(position, xAxis, yAxis, zAxis), V(thickness, length, halfBase), color)
		end
	end
end

function BUILDERS.star(m)
	buildStar(m, SUN)
end

-- 빈 별(아직 못 딴 별): 흐린 회색 별
function BUILDERS.star_empty(m)
	buildStar(m, STAR_GRAY)
end

-- 행운: 네잎클로버 (잎 원판 4장 + 가운데 + 줄기)
function BUILDERS.clover(m)
	local center = FACE * CFrame.new(0, 2.7, 0)
	for _, offset in { { -0.72, 0.72 }, { 0.72, 0.72 }, { -0.72, -0.72 }, { 0.72, -0.72 } } do
		cyl(m, center * CFrame.new(offset[1], offset[2], 0) * ALONG_Z, 0.35, 1.8, CLOVER)
	end
	ball(m, (center * CFrame.new(0, 0, -0.05)).Position, 0.75, CLOVER_DARK)
	block(m, center * CFrame.new(0.3, -1.75, 0) * CFrame.Angles(0, 0, math.rad(-12)), V(0.26, 2.1, 0.26), CLOVER_DARK)
end

-- 속보: 둘둘 만 신문 (빨간 띠 2개 + 앞쪽에 제목 줄)
function BUILDERS.news(m)
	local base = FACE * CFrame.new(0, 0.9, 0) * CFrame.Angles(0, 0, math.rad(8))
	cyl(m, base, 4.4, 1.6, NEWSPRINT)
	cyl(m, base * CFrame.new(-1.25, 0, 0), 0.3, 1.66, CORAL)
	cyl(m, base * CFrame.new(1.25, 0, 0), 0.3, 1.66, CORAL)
	block(m, base * CFrame.new(0, -0.15, -0.78), V(3.3, 0.95, 0.06), CREAM)
	block(m, base * CFrame.new(-0.35, 0.1, -0.82), V(1.8, 0.18, 0.04), INK)
	block(m, base * CFrame.new(-0.55, -0.25, -0.82), V(1.4, 0.1, 0.04), MARBLE_SHADE)
end

-- 비행기(여행사): 흰 동체 + 파란 날개 + 빨간 꼬리
function BUILDERS.plane(m)
	local base = FACE * CFrame.new(0, 1.4, 0) * CFrame.Angles(0, 0, math.rad(14)) -- 코(+X)가 살짝 위로
	cyl(m, base, 4.2, 0.95, SNOW)
	ball(m, (base * CFrame.new(2.1, 0, 0)).Position, 0.95, SNOW)
	block(m, base * CFrame.new(1.55, 0.3, 0), V(0.6, 0.3, 0.72), NAVY)
	block(m, base * CFrame.new(0.2, -0.1, 0), V(1.2, 0.14, 4.6), SKY)
	block(m, base * CFrame.new(-1.8, 0.75, 0), V(0.8, 1.2, 0.14), CORAL)
	block(m, base * CFrame.new(-1.8, 0.1, 0), V(0.6, 0.12, 1.8), SKY)
end

-- 입장권: 빨간 표 + 떼는 부분 + 가운데 크림 띠
function BUILDERS.ticket(m)
	local base = FACE * CFrame.new(0, 1.6, 0) * CFrame.Angles(0, 0, math.rad(12))
	block(m, base * CFrame.new(-0.45, 0, 0), V(2.9, 1.9, 0.18), CORAL)
	block(m, base * CFrame.new(1.55, 0, 0), V(0.95, 1.9, 0.18), SUN)
	block(m, base * CFrame.new(-0.45, 0, -0.04), V(2.1, 0.55, 0.16), CREAM)
end

-- 주사위(굴림 수): 흰 주사위, 앞 5 · 오른쪽 3 · 위 1(빨강). 앞과 오른쪽 면이 고루 보이게 조금 돌림
function BUILDERS.dice(m)
	local size = 3.4
	local h = size / 2
	local q = size * 0.26
	local pip = 0.74
	local center = CFrame.new(0, h, 0) * CFrame.Angles(0, math.rad(10), 0)
	block(m, center, V(size, size, size), SNOW)
	for _, p in { { -q, q }, { q, q }, { 0, 0 }, { -q, -q }, { q, -q } } do
		ball(m, (center * CFrame.new(p[1], p[2], -h)).Position, pip, INK)
	end
	for _, p in { { q, q }, { 0, 0 }, { -q, -q } } do
		ball(m, (center * CFrame.new(h, p[2], p[1])).Position, pip, INK)
	end
	ball(m, (center * CFrame.new(0, h, 0)).Position, pip * 1.3, CORAL)
end

-- 자물쇠: 금색 몸통 + 반원 쇠고리 + 열쇠 구멍
function BUILDERS.lock(m)
	local base = FACE
	block(m, base * CFrame.new(0, 1.3, 0), V(3.2, 2.6, 1.2), SUN)
	local radius, pieces = 1.05, 7
	local chord = 2 * radius * math.sin(PI / (2 * (pieces - 1))) + 0.1
	local arch = base * CFrame.new(0, 3.1, 0)
	for k = 0, pieces - 1 do
		local angle = k * PI / (pieces - 1)
		block(m, arch * CFrame.Angles(0, 0, angle) * CFrame.new(radius, 0, 0), V(0.5, chord, 0.5), STEEL, Mat.Metal)
	end
	for _, side in { -1, 1 } do
		block(m, base * CFrame.new(side * radius, 2.8, 0), V(0.5, 0.7, 0.5), STEEL, Mat.Metal)
	end
	cyl(m, base * CFrame.new(0, 1.55, -0.6) * ALONG_Z, 0.1, 0.62, INK)
	block(m, base * CFrame.new(0, 1.05, -0.6), V(0.28, 0.75, 0.1), INK)
end

-- 두 점을 잇는 굵은 막대 (base 좌표계의 XY 평면). 양 끝을 조금 늘려서 이음매가 비지 않게
local function bar(m: Model, base: CFrame, a: Vector3, b: Vector3, width: number, color: Color3)
	local d = b - a
	local angle = math.atan2(d.Y, d.X)
	block(m, base * CFrame.new((a + b) / 2) * CFrame.Angles(0, 0, angle), V(d.Magnitude + width, width, 0.8), color)
end

-- 체크: 초록 V 표시
function BUILDERS.check(m)
	local base = FACE * CFrame.new(0, 2.1, 0)
	bar(m, base, V(-1.7, 0.1, 0), V(-0.55, -1.05, 0), 0.95, GRASS)
	bar(m, base, V(-0.55, -1.05, 0), V(1.8, 1.45, 0), 0.95, GRASS)
end

-- 닫기/실패: 흰 X (빨간 바탕 위에 올라감)
function BUILDERS.close(m)
	local base = FACE * CFrame.new(0, 2, 0)
	bar(m, base, V(-1.4, -1.4, 0), V(1.4, 1.4, 0), 1, SNOW)
	bar(m, base, V(-1.4, 1.4, 0), V(1.4, -1.4, 0), 1, SNOW)
end

-- 위 화살표(수입·강화): 초록 기둥 + 화살촉
function BUILDERS.arrow_up(m)
	local base = FACE
	block(m, base * CFrame.new(0, 1.2, 0), V(1.2, 2.4, 0.8), GRASS)
	arrowhead(m, base, V(0, 2.3, 0), V(0, 1, 0), 2, 1.6, 0.8, GRASS)
end

-- 자동: 한 바퀴 도는 화살표(고리 조각 9개 + 화살촉). 오른쪽 위가 비어 있고 화살촉이 그쪽을 가리킴
function BUILDERS.auto(m)
	local center = FACE * CFrame.new(0, 2.3, 0)
	local radius, width, thickness = 1.65, 0.62, 0.7
	local pieces = 12
	local step = 2 * PI / pieces
	local chord = 2 * radius * math.sin(PI / pieces) + 0.08
	local start = math.rad(120)
	for k = 0, 8 do
		local cf = center * CFrame.Angles(0, 0, start + k * step) * CFrame.new(radius, 0, 0)
		block(m, cf, V(width, chord, thickness), SNOW)
	end
	local finish = start + 8 * step + step / 2
	local at = V(math.cos(finish), math.sin(finish), 0) * radius
	arrowhead(m, center, at, V(-math.sin(finish), math.cos(finish), 0), 1.3, 0.95, thickness, SNOW)
end

-- 환생: 금색 화살표 두 개가 원을 그리며 돎 + 가운데 초록 위 화살표 (파트 15개)
-- (ImageIds 에 "rebirth" 그림을 넣으면 그 그림을 씀)
function BUILDERS.rebirth(m)
	local center = FACE * CFrame.new(0, 2.3, 0)
	local radius, width, thickness = 1.9, 0.6, 0.7
	local step = 2 * PI / 12
	local chord = 2 * radius * math.sin(step / 2) + 0.08
	for _, start in { math.rad(100), math.rad(280) } do
		for k = 0, 3 do
			local cf = center * CFrame.Angles(0, 0, start + k * step) * CFrame.new(radius, 0, 0)
			block(m, cf, V(width, chord, thickness), SUN)
		end
		local finish = start + 3.5 * step
		local at = V(math.cos(finish), math.sin(finish), 0) * radius
		arrowhead(m, center, at, V(-math.sin(finish), math.cos(finish), 0), 1.1, 0.85, thickness, SUN)
	end
	block(m, center * CFrame.new(0, -0.45, 0), V(0.55, 0.9, 0.6), GRASS)
	arrowhead(m, center, V(0, 0, 0), V(0, 1, 0), 0.9, 0.75, 0.6, GRASS)
end

-- 공원 자동 배치: 1·2·3등 시상대(가운데 Sun 이 가장 높고, 왼쪽 Sky 2등, 오른쪽 Coral 3등) + 1등 위 작은 별.
-- "가장 희귀한 명소부터 앞 칸에" 를 뜻함. 굴리기 옆 AUTO(도는 화살표)와 다른 모양 (파트 14개)
function BUILDERS.podium(m)
	local width, depth, gap = 1.7, 1.6, 0.05
	local steps = {
		{ X = -(width + gap), Height = 1.8, Color = SKY },
		{ X = 0, Height = 2.7, Color = SUN },
		{ X = width + gap, Height = 1.15, Color = CORAL },
	}
	for _, step in steps do
		block(m, FACE * CFrame.new(step.X, step.Height / 2, 0), V(width, step.Height, depth), step.Color)
	end
	buildStar(m, GOLD, FACE * CFrame.new(0, 2.7 + 1.25, 0), 0.6)
end

-- 공원 배치(창 열기 버튼): 잔디 판 위 2×2 칸 — 세 칸에 색 블록(미니 명소), 한 칸은 빈 칸 초록 "+".
-- 이동 버튼의 공원(나무 + 벤치) 아이콘과 나란히 있어도 다르게 보이도록 (파트 10개)
function BUILDERS.arrange(m)
	local base = FACE
	block(m, base * CFrame.new(0, 0.2, 0), V(5.4, 0.4, 5.4), GRASS)
	local cells = {
		{ X = -1.3, Z = 1.3, Height = 1.7, Color = SKY }, -- 뒤 왼쪽
		{ X = 1.3, Z = 1.3, Height = 2.6, Color = SUN }, -- 뒤 오른쪽(가장 높음)
		{ X = -1.3, Z = -1.3, Height = 1.1, Color = CORAL }, -- 앞 왼쪽
		{ X = 1.3, Z = -1.3, Height = 0, Color = GRASS }, -- 앞 오른쪽: 빈 칸
	}
	for _, cell in cells do
		block(m, base * CFrame.new(cell.X, 0.5, cell.Z), V(2.3, 0.2, 2.3), CREAM)
		if cell.Height > 0 then
			block(m, base * CFrame.new(cell.X, 0.6 + cell.Height / 2, cell.Z), V(1.3, cell.Height, 1.3), cell.Color)
		end
	end
	-- 빈 칸의 "+"
	block(m, base * CFrame.new(1.3, 0.68, -1.3), V(1.4, 0.18, 0.4), LEAF)
	block(m, base * CFrame.new(1.3, 0.68, -1.3), V(0.4, 0.18, 1.4), LEAF)
end

-- 보관(배치 모드): 뚜껑이 뒤로 열린 나무 상자 + 안에서 삐죽 나온 미니 명소(Sky 블록) (파트 9개)
function BUILDERS.crate(m)
	local base = FACE
	block(m, base * CFrame.new(0, 1.3, 0), V(4, 2.6, 3), WOOD)
	-- 앞면 널빤지 띠 + 모서리 기둥(진한 나무)
	block(m, base * CFrame.new(0, 0.75, -1.52), V(4.05, 0.32, 0.1), WOOD_DARK)
	block(m, base * CFrame.new(0, 1.85, -1.52), V(4.05, 0.32, 0.1), WOOD_DARK)
	for _, side in { -1, 1 } do
		block(m, base * CFrame.new(side * 1.85, 1.3, -1.52), V(0.34, 2.62, 0.12), WOOD_DARK)
	end
	-- 안에서 나온 명소(파란 탑 + 금색 꼭지)
	block(m, base * CFrame.new(-0.5, 2.9, 0.1), V(1, 1.4, 1), SKY)
	block(m, base * CFrame.new(-0.5, 3.75, 0.1), V(0.5, 0.35, 0.5), SUN)
	-- 뒤로 젖힌 뚜껑
	block(m, base * CFrame.new(0, 3.05, 1.75) * CFrame.Angles(math.rad(-70), 0, 0), V(4, 2.2, 0.3), WOOD)
	block(m, base * CFrame.new(0, 3.1, 1.62) * CFrame.Angles(math.rad(-70), 0, 0), V(4.05, 0.3, 0.1), WOOD_DARK)
end

-- 시점(배치 모드 카메라 바꾸기): 사진기 — 몸통 + 렌즈 + 위 뷰파인더 + 셔터 단추 (파트 7개)
function BUILDERS.camera(m)
	local base = FACE
	block(m, base * CFrame.new(0, 1.5, 0), V(4.2, 2.6, 1.6), IRON)
	block(m, base * CFrame.new(0, 1.5, 0), V(4.25, 0.7, 1.65), STEEL, Mat.Metal)
	block(m, base * CFrame.new(-0.9, 3.05, 0), V(1.5, 0.6, 1.2), IRON)
	cyl(m, base * CFrame.new(0.2, 1.5, -0.95) * ALONG_Z, 0.6, 2, STEEL, Mat.Metal)
	cyl(m, base * CFrame.new(0.2, 1.5, -1.3) * ALONG_Z, 0.2, 1.4, SKY)
	cyl(m, base * CFrame.new(1.35, 2.95, 0) * UPRIGHT, 0.3, 0.7, CORAL)
	block(m, base * CFrame.new(1.45, 2.25, -0.82), V(0.6, 0.35, 0.1), SNOW)
end

-- Robux 표시(상점 버튼, 가격 버튼): 모서리가 위아래인 흰 육각판 + 가운데 진한 네모 구멍 (파트 4개).
-- 육각형 = 가로 a√3 × 세로 a 판 3장을 0/60/120도 돌려 겹친 것(a = 한 변). 정면이 카메라 쪽을 보게 살짝 젖힘
function BUILDERS.robux(m)
	local a = 2
	local depth = 0.5
	local base = FACE * CFrame.new(0, a, 0) * CFrame.Angles(math.rad(16), 0, 0)
	for k = 0, 2 do
		block(m, base * CFrame.Angles(0, 0, k * PI / 3), V(a * math.sqrt(3), a, depth), SNOW)
	end
	block(m, base * CFrame.new(0, 0, -depth / 2 - 0.02), V(a * 0.78, a * 0.78, 0.06), INK)
end

-- 예전 이름 -> 지금 이름 (ImageIds 와 같은 이름을 씀)
local ALIASES = {
	roll = "globe",
	collection = "album",
	luck = "clover",
}

-- 모든 파트를 옮겨서 경계 상자의 바닥 중앙이 원점에 오게 함 (Viewport 는 원점 기준으로 틀을 잡고 돌림)
local function recenter(model: Model)
	local minX, minY, minZ = math.huge, math.huge, math.huge
	local maxX, maxY, maxZ = -math.huge, -math.huge, -math.huge
	local parts = {}
	for _, child in model:GetChildren() do
		if child:IsA("BasePart") then
			table.insert(parts, child)
			local cf = child.CFrame
			local half = child.Size / 2
			local right, up, look = cf.RightVector, cf.UpVector, cf.LookVector
			local ex = math.abs(right.X) * half.X + math.abs(up.X) * half.Y + math.abs(look.X) * half.Z
			local ey = math.abs(right.Y) * half.X + math.abs(up.Y) * half.Y + math.abs(look.Y) * half.Z
			local ez = math.abs(right.Z) * half.X + math.abs(up.Z) * half.Y + math.abs(look.Z) * half.Z
			local p = cf.Position
			minX, maxX = math.min(minX, p.X - ex), math.max(maxX, p.X + ex)
			minY, maxY = math.min(minY, p.Y - ey), math.max(maxY, p.Y + ey)
			minZ, maxZ = math.min(minZ, p.Z - ez), math.max(maxZ, p.Z + ez)
		end
	end
	if #parts == 0 then
		return
	end
	local shift = V(-(minX + maxX) / 2, -minY, -(minZ + maxZ) / 2)
	for _, p in parts do
		p.CFrame += shift
	end
end

local templates: { [string]: Model } = {}

local function template(key: string): Model
	local cached = templates[key]
	if cached then
		return cached
	end
	local builder = BUILDERS[key]
	if not builder then
		warn("[LandmarkRNG] 모르는 아이콘: " .. tostring(key))
		key = "star"
		builder = BUILDERS.star
		if templates.star then
			return templates.star
		end
	end

	local model = Instance.new("Model")
	model.Name = "Icon_" .. key
	builder(model)
	recenter(model)

	-- 피벗 = 바닥 중앙(원점). Viewport.setModel 이 이 피벗을 돌림
	local root = Instance.new("Part")
	root.Name = "Root"
	style(root, CFrame.new(), V(0.05, 0.05, 0.05), INK)
	root.Transparency = 1
	root.Parent = model
	model.PrimaryPart = root

	templates[key] = model
	return model
end

-- 업그레이드 Id -> 아이콘 이름 (업그레이드 창, 구매 알림에서 같이 씀)
Icons.UPGRADE = {
	Globe = "globe",
	Agency = "plane",
	Park = "park",
	Ticket = "ticket",
} :: { [string]: string }

-- 그림 아이콘은 이 속도(초당 도) 이상일 때만 돌림. 천천히 도는 건 3D 모형에만 어울림
local FAST_SPIN = 180
local WHITE = Color3.new(1, 1, 1)

local imageSpins: { [ImageLabel]: number } = {}
local imageSpinConnection: RBXScriptConnection? = nil

local function stepImages(dt: number)
	for image, speed in imageSpins do
		if not image.Parent then
			imageSpins[image] = nil -- Destroy 된 아이콘
			continue
		end
		image.Rotation = (image.Rotation + speed * dt) % 360
	end
end

-- 그림 Id (없으면 nil). 예전 이름도 받아 줌
function Icons.imageId(name: string): string?
	return Ui.imageId(ALIASES[name] or name)
end

local function applySpin(icon: Frame)
	local value = icon:GetAttribute("Spin")
	local speed = if type(value) == "number" then value else 0
	local content = icon:FindFirstChild("Content")
	if not content then
		return
	end
	if content:IsA("ViewportFrame") then
		Viewport.setSpin(content, speed)
	elseif content:IsA("ImageLabel") then
		if math.abs(speed) >= FAST_SPIN then
			imageSpins[content] = speed
			if not imageSpinConnection then
				imageSpinConnection = RunService.RenderStepped:Connect(stepImages)
			end
		else
			imageSpins[content] = nil
			content.Rotation = 0
		end
	end
end

-- 색/투명도: 그림(ImageLabel)과 3D 화면(ViewportFrame) 둘 다 ImageColor3 / ImageTransparency 가 있음
local function applyLook(icon: Frame)
	local content = icon:FindFirstChild("Content")
	if content and (content:IsA("ImageLabel") or content:IsA("ViewportFrame")) then
		local color = icon:GetAttribute("Color")
		local transparency = icon:GetAttribute("Transparency")
		content.ImageColor3 = if typeof(color) == "Color3" then color else WHITE
		content.ImageTransparency = if type(transparency) == "number" then transparency else 0
	end
end

-- 이미 있는 아이콘의 그림을 바꿈. 그림이 있으면 ImageLabel, 없으면 3D 모형 (종류가 바뀌면 속을 새로 만듦)
function Icons.set(icon: Frame, name: string)
	local key = ALIASES[name] or name
	local id = Ui.imageId(key)
	local content = icon:FindFirstChild("Content")
	if id then
		local image: ImageLabel
		if content and content:IsA("ImageLabel") then
			image = content
		else
			if content then
				content:Destroy()
			end
			image = Ui.new("ImageLabel", {
				Name = "Content",
				BackgroundTransparency = 1,
				Size = UDim2.fromScale(1, 1),
				ScaleType = Enum.ScaleType.Fit,
				ZIndex = icon.ZIndex,
				Parent = icon,
			})
		end
		image.Image = id
	else
		local vf: ViewportFrame
		if content and content:IsA("ViewportFrame") then
			vf = content
		else
			if content then
				content:Destroy()
			end
			vf = Viewport.new(icon, {
				Name = "Content",
				ZIndex = icon.ZIndex,
				Ambient = rgb(196, 194, 208),
			})
		end
		Viewport.setModel(vf, template(key):Clone())
	end
	icon:SetAttribute("Icon", key)
	applyLook(icon)
	applySpin(icon)
end

-- 새 아이콘. props: { Size, Position, AnchorPoint, ZIndex, LayoutOrder, Rotation, Spin(초당 회전 각도),
--   Color?(ImageColor3), Transparency? }. 반환: 투명한 Frame(이름 "Icon") — 속은 그림 또는 3D 화면
function Icons.view(parent: Instance?, name: string, props: { [string]: any }?): Frame
	local options = props or {}
	local icon = Ui.new("Frame", {
		Name = "Icon",
		BackgroundTransparency = 1,
		Size = options.Size or UDim2.fromScale(1, 1),
		Position = options.Position or UDim2.new(),
		AnchorPoint = options.AnchorPoint or Vector2.new(0, 0),
		ZIndex = options.ZIndex or 1,
		LayoutOrder = options.LayoutOrder or 0,
		Rotation = options.Rotation or 0,
	})
	if type(options.Spin) == "number" then
		icon:SetAttribute("Spin", options.Spin)
	end
	if typeof(options.Color) == "Color3" then
		icon:SetAttribute("Color", options.Color)
	end
	if type(options.Transparency) == "number" then
		icon:SetAttribute("Transparency", options.Transparency)
	end
	Icons.set(icon, name)
	icon.Parent = parent
	return icon
end

-- 회전 속도 바꾸기 (0 이면 멈춤)
function Icons.setSpin(icon: Frame, degreesPerSecond: number)
	icon:SetAttribute("Spin", degreesPerSecond)
	applySpin(icon)
end

-- 흐리게/진하게 (0 = 진하게, 1 = 안 보임)
function Icons.setTransparency(icon: Frame, transparency: number)
	icon:SetAttribute("Transparency", transparency)
	applyLook(icon)
end

-- 물들이기 (흰색 = 원래 색)
function Icons.setColor(icon: Frame, color: Color3)
	icon:SetAttribute("Color", color)
	applyLook(icon)
end

return Icons
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">Panels</string>
            <string name="Source"><![CDATA[-- 메뉴 창: 도감(대륙 탭 — 예전 여권 창을 합침: 지역별 발견 현황 + 도장, 대표 지정), 강화(업그레이드), 환생(조건 + 확인), 상점(Robux).
-- 공원 배치는 창이 아니라 내 공원에서 하는 3D 배치 모드(ParkEdit) — 도감 머리 줄 [배치] 버튼이 그 모드를 켬
-- 크림색 창(Ui.window) 하나를 쓰고, 화면마다 리본 색과 제목(2글자)만 바꿉니다(도감은 탭 줄만큼 창이 조금 더 높음).
-- 글자는 최소로: 설명 문장 없이 아이콘 + 숫자 딱지로 보여 줍니다.
-- 화면마다 카드를 한 번 만들고 상태가 바뀌면 글자/색만 고칩니다. 썸네일(ViewportFrame)은
-- 새로 발견했을 때만 만들어서, 자동 굴림 중에 창을 열어 둬도 매번 다시 만들지 않습니다.
-- 도감 탭을 바꿔도 카드는 그대로 두고 보이기(Visible)·순서(LayoutOrder)만 바꿉니다(썸네일을 다시 만들지 않음).

local MarketplaceService = game:GetService("MarketplaceService")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Landmarks = require(Shared.Landmarks)
local PlayerState = require(Shared.PlayerState)

local Icons = require(script.Parent.Icons)
local Perks = require(script.Parent.Perks)
local Ui = require(script.Parent.Ui)
local Viewport = require(script.Parent.Viewport)
local Theme = Ui.Theme

type Landmark = Landmarks.Landmark
type Snapshot = PlayerState.Snapshot

export type Handlers = {
	Feature: (string?) -> (),
	Buy: (string) -> (),
	ToggleAutoFeature: () -> (),
	Rebirth: () -> (), -- 확인까지 누른 뒤에만 부름
	BuyPass: (string) -> (), -- Config.GamePasses 키
	BuyProduct: (string) -> (), -- Config.Products 키
	Toast: (text: string, icon: string?, color: Color3?) -> (), -- 짧은 알림 (기본 실패 색, 예: "코인 부족")
	Arrange: () -> (), -- 도감 [배치]: 3D 공원 배치 모드 켜기(창은 부르는 쪽이 닫음)
}

local REGION_BONUS = math.floor(Config.REGION_LUCK_BONUS * 100 + 0.5)

local HEADER_HEIGHT = 50 -- 창 본문 맨 위 딱지 줄 높이

-- 도감 대륙 탭: [전체] + 대륙마다 하나(예전 여권 창을 합침). 탭 = 세로 통통 버튼(왼쪽 메뉴 버튼처럼 아이콘 위 · 이름 아래),
-- 대륙 아이콘은 도장 그림. 여섯 개가 본문 폭을 똑같이 나눔(휴대폰 배율 0.55 에서 앞면 약 63×37px, 이름 10px)
local TAB_HEIGHT = 74 -- 앞면 68 + 그림자 6
local TAB_GAP = 6 -- 탭 줄 ~ 머리 줄
local TAB_SPACING = 8 -- 탭 사이
local TAB_ICON = 50 -- 도장 그림은 둘레가 비어 있어 크게, 앞면 위 끝에 붙임
local TAB_LABEL_Y = 45 -- 이름 칸 위 끝(아이콘 그림 아래 빈 곳과 조금 겹침)
local TAB_LABEL_HEIGHT = 20
local TAB_TEXT = 19
local COLLECTION_TOP = TAB_HEIGHT + TAB_GAP + HEADER_HEIGHT
local ALL_TAB = "All"

-- Height: 창 높이(없으면 WINDOW_SIZE.Y). 도감은 탭 줄 때문에 조금 더 높게(아래로 늘림 — openOffset)
local VIEWS: { [string]: { Title: string, Color: string, Top: number, Height: number? } } = {
	Collection = { Title = "도감", Color = "Sky", Top = COLLECTION_TOP, Height = 530 },
	Upgrade = { Title = "강화", Color = "Sun", Top = 4 },
	Rebirth = { Title = "환생", Color = "Coral", Top = HEADER_HEIGHT },
	Shop = { Title = "상점", Color = "Grass", Top = 4 }, -- Robux 상점: 코인으로 사는 강화(Sun)와 다른 색
}

local WHITE = Color3.new(1, 1, 1)
local FEATURED_BG = Color3.fromRGB(255, 218, 128)
local DIM_CHIP = Color3.fromRGB(172, 170, 190) -- 아직 못 받은 보너스 딱지
local UNKNOWN_BG = Color3.fromRGB(58, 53, 80) -- 도감 대륙 탭의 못 찾은 명소 카드
local FADED_STAMP = Color3.fromRGB(150, 146, 160) -- 아직 못 받은 도장(흐릿한 자국)

local WINDOW_SIZE = Vector2.new(760, 500)
local BODY_WIDTH = WINDOW_SIZE.X - 36 -- 창 본문 폭(Ui.window: 좌우 18)
local WINDOW_LIP = 8 -- 창 아래 두께(Ui.window 의 Lip)
local OPEN_OFFSET = -30 -- 창을 화면 가운데보다 조금 위로 (아래쪽 굴리기 버튼을 가리지 않게)
-- 스크롤 영역 안쪽 여백(오른쪽은 스크롤바 자리)
local PAD_X, PAD_RIGHT, PAD_Y = 6, 14, 6

local COLLECTION_CELL = Vector2.new(128, 184)
