	{ "chichen", "치첸이트사", "Chichen Itza", 3250, "Americas", "steps", rgb(190, 180, 160), rgb(80, 140, 80), rgb(230, 220, 190), M.Limestone },
	{ "forbiddencity", "자금성", "Forbidden City", 3500, "Asia", "temple", rgb(200, 50, 40), rgb(255, 200, 50), rgb(240, 230, 210), M.Brick },
	{ "serengeti", "세렝게티 초원", "Serengeti", 3750, "Africa", "tree", rgb(217, 181, 74), rgb(107, 142, 35), rgb(242, 140, 40), M.Grass },
	{ "parthenon", "파르테논 신전", "Parthenon", 4000, "Europe", "temple", rgb(240, 232, 216), rgb(200, 184, 154), rgb(111, 160, 216), M.Marble },
	{ "machupicchu", "마추픽추", "Machu Picchu", 4500, "Americas", "terraces", rgb(150, 145, 135), rgb(90, 160, 80), rgb(200, 230, 255), M.Slate },
	{ "amazon", "아마존 열대우림", "Amazon Rainforest", 4700, "Americas", "tree", rgb(46, 139, 60), rgb(140, 110, 60), rgb(255, 90, 60), M.LeafyGrass },
	{ "borobudur", "보로부두르 사원", "Borobudur", 5000, "Asia", "steps", rgb(140, 140, 130), rgb(90, 150, 90), rgb(220, 210, 180), M.Basalt },
	{ "sahara", "사하라 사막", "Sahara Desert", 5500, "Africa", "island", rgb(239, 194, 122), rgb(201, 139, 69), rgb(63, 163, 77), M.Sand },
	{ "meteora", "메테오라 수도원", "Meteora Monasteries", 6000, "Europe", "seastacks", rgb(184, 164, 136), rgb(200, 96, 60), rgb(136, 184, 104), M.Rock },
	{ "petra", "페트라", "Petra", 6250, "Asia", "facade", rgb(215, 130, 100), rgb(180, 100, 75), rgb(255, 200, 150), M.Sandstone },
	{ "galapagos", "갈라파고스 제도", "Galapagos Islands", 7000, "Americas", "island", rgb(78, 140, 70), rgb(40, 160, 200), rgb(140, 122, 90), M.Ground },
	{ "abusimbel", "아부심벨 신전", "Abu Simbel Temples", 7500, "Africa", "facade", rgb(217, 168, 108), rgb(168, 116, 63), rgb(242, 193, 78), M.Sandstone },
	{ "matterhorn", "마터호른", "Matterhorn", 7750, "Europe", "pyramid", rgb(140, 138, 136), rgb(255, 255, 255), rgb(111, 176, 232), M.Rock },
	{ "moai", "모아이 석상", "Moai", 8000, "Oceania", "moai", rgb(110, 105, 100), rgb(80, 150, 90), rgb(200, 60, 50), M.Basalt },
	{ "angelfalls", "앙헬 폭포", "Angel Falls", 9000, "Americas", "fountain", rgb(110, 80, 70), rgb(70, 150, 60), rgb(240, 250, 255), M.Sandstone },
	{ "everest", "에베레스트산", "Mount Everest", 9500, "Asia", "pyramid", rgb(245, 248, 255), rgb(110, 120, 135), rgb(255, 180, 90), M.Snow },
	{ "teotihuacan", "테오티우아칸", "Teotihuacan", 10000, "Americas", "steps", rgb(160, 130, 100), rgb(110, 90, 70), rgb(255, 200, 120), M.Cobblestone },
	{ "stonehenge", "스톤헨지", "Stonehenge", 11000, "Europe", "stones", rgb(150, 150, 145), rgb(90, 150, 80), rgb(200, 220, 255), M.Slate },

	{ "waitomo", "와이토모 반딧불이 동굴", "Waitomo Glowworm Caves", 12500, "Oceania", "arch", rgb(80, 75, 70), rgb(30, 40, 60), rgb(120, 240, 255), M.Rock },
	{ "giantscauseway", "자이언츠 코즈웨이", "Giant's Causeway", 14000, "Europe", "steps", rgb(60, 60, 68), rgb(44, 143, 184), rgb(167, 216, 240), M.Basalt },
	{ "terracotta", "진시황 병마용", "Terracotta Army", 16000, "Asia", "statue", rgb(160, 130, 110), rgb(120, 100, 80), rgb(200, 170, 140), M.Sandstone },
	{ "bluehole", "그레이트 블루홀", "Great Blue Hole", 19000, "Americas", "reef", rgb(20, 40, 90), rgb(70, 200, 220), rgb(240, 230, 200), M.SmoothPlastic },
	{ "alexandria", "알렉산드리아 등대", "Lighthouse of Alexandria", 20000, "Africa", "lighthouse", rgb(245, 240, 225), rgb(220, 200, 160), rgb(255, 170, 60), M.Marble },
	{ "tutankhamun", "투탕카멘의 무덤", "Tomb of Tutankhamun", 25000, "Africa", "statue", rgb(232, 185, 35), rgb(30, 58, 138), rgb(201, 160, 106), M.Foil },
	{ "nazca", "나스카 라인", "Nazca Lines", 30000, "Americas", "ruins", rgb(200, 150, 110), rgb(140, 100, 70), rgb(240, 220, 200), M.Sand },
	{ "yapstone", "얍섬 돌 화폐", "Rai Stones of Yap", 32500, "Oceania", "ring", rgb(190, 180, 160), rgb(140, 130, 112), rgb(80, 160, 80), M.Limestone },
	{ "pompeii", "폼페이", "Pompeii & Mount Vesuvius", 40000, "Europe", "ruins", rgb(201, 178, 142), rgb(106, 90, 80), rgb(255, 106, 42), M.Sandstone },
	{ "babylon", "바빌론 공중정원", "Hanging Gardens of Babylon", 50000, "Asia", "gardens", rgb(210, 180, 130), rgb(60, 170, 70), rgb(120, 200, 255), M.Sandstone },
	{ "richat", "사하라의 눈", "Richat Structure (Eye of the Sahara)", 55000, "Africa", "ring", rgb(217, 138, 78), rgb(138, 90, 60), rgb(242, 208, 138), M.Sand },
	{ "olmechead", "올멕 거대 두상", "Olmec Colossal Head", 65000, "Americas", "moai", rgb(110, 105, 100), rgb(78, 140, 70), rgb(200, 160, 110), M.Basalt },
	{ "artemis", "아르테미스 신전", "Temple of Artemis at Ephesus", 70000, "Asia", "temple", rgb(240, 235, 225), rgb(200, 180, 150), rgb(255, 210, 110), M.Marble },
	{ "nanmadol", "난마돌", "Nan Madol", 85000, "Oceania", "ruins", rgb(70, 70, 78), rgb(40, 150, 175), rgb(110, 200, 110), M.Basalt },
	{ "greatzimbabwe", "그레이트 짐바브웨", "Great Zimbabwe", 95000, "Africa", "ruins", rgb(154, 143, 126), rgb(107, 99, 88), rgb(201, 162, 74), M.Granite },
	{ "rhodes", "로도스 거상", "Colossus of Rhodes", 125000, "Europe", "statue", rgb(190, 130, 60), rgb(230, 225, 210), rgb(255, 140, 40), M.Foil },
	{ "tenochtitlan", "테노치티틀란", "Tenochtitlan", 140000, "Americas", "island", rgb(210, 180, 140), rgb(60, 150, 200), rgb(200, 60, 60), M.Limestone },
	{ "zeus", "올림피아 제우스 상", "Statue of Zeus at Olympia", 160000, "Europe", "statue", rgb(242, 230, 204), rgb(212, 166, 42), rgb(127, 216, 255), M.Marble },
	{ "heracleion", "헤라클레이온 해저 도시", "Sunken City of Heracleion", 180000, "Africa", "ruins", rgb(201, 185, 154), rgb(31, 127, 168), rgb(111, 224, 208), M.Limestone },
	{ "mausoleum", "마우솔로스 영묘", "Mausoleum at Halicarnassus", 225000, "Asia", "temple", rgb(237, 230, 214), rgb(184, 159, 122), rgb(255, 210, 110), M.Marble },

	{ "lochness", "네스호의 네시", "Loch Ness & Nessie", 250000, "Europe", "island", rgb(46, 90, 74), rgb(58, 110, 154), rgb(126, 216, 176), M.Slate },
	{ "babel", "바벨탑", "Tower of Babel", 450000, "Asia", "spiral", rgb(200, 170, 120), rgb(150, 120, 90), rgb(255, 230, 180), M.Sandstone },
	{ "trojanhorse", "트로이 목마", "Trojan Horse", 650000, "Asia", "statue", rgb(160, 120, 75), rgb(110, 80, 50), rgb(255, 220, 140), M.WoodPlanks },
	{ "libraryalex", "알렉산드리아 도서관", "Library of Alexandria", 950000, "Africa", "temple", rgb(242, 237, 225), rgb(201, 163, 107), rgb(255, 179, 71), M.Marble },
	{ "zealandia", "질랜디아", "Zealandia (Sunken Continent)", 1200000, "Oceania", "island", rgb(60, 140, 110), rgb(10, 60, 120), rgb(120, 255, 230), M.Glass },
	{ "atlantis", "아틀란티스", "Atlantis", 1900000, "Europe", "island", rgb(230, 240, 250), rgb(40, 120, 200), rgb(90, 255, 230), M.Marble },
	{ "labyrinth", "미노타우로스의 미궁", "Labyrinth of the Minotaur", 2750000, "Europe", "ruins", rgb(216, 200, 168), rgb(184, 72, 58), rgb(255, 208, 106), M.Sandstone },
	{ "hwangnyongsa", "황룡사 9층 목탑", "Hwangnyongsa Nine-Story Pagoda", 4000000, "Asia", "pagoda", rgb(180, 70, 60), rgb(60, 110, 90), rgb(255, 210, 90), M.WoodPlanks },
	{ "eldorado", "엘도라도", "El Dorado", 5500000, "Americas", "steps", rgb(255, 200, 60), rgb(200, 140, 30), rgb(255, 250, 180), M.Foil },

	{ "fountainofyouth", "젊음의 샘", "Fountain of Youth", 8000000, "Americas", "fountain", rgb(230, 230, 220), rgb(80, 220, 200), rgb(255, 230, 120), M.Marble },
	{ "yonggung", "용궁", "Dragon King's Palace", 25000000, "Asia", "pagoda", rgb(230, 70, 70), rgb(40, 130, 150), rgb(120, 255, 220), M.Glass },
	{ "mu", "무 대륙", "Lost Continent of Mu", 45000000, "Oceania", "island", rgb(175, 165, 125), rgb(30, 110, 170), rgb(255, 210, 90), M.Slate },
	{ "skyisland", "사하라 신기루 성", "Mirage Citadel of the Sahara", 110000000, "Africa", "skyisland", rgb(235, 200, 130), rgb(190, 140, 80), rgb(170, 240, 255), M.Sand },
	{ "shangrila", "샹그릴라", "Shangri-La", 375000000, "Asia", "pagoda", rgb(250, 250, 250), rgb(255, 200, 70), rgb(255, 240, 180), M.Marble },
	{ "worldtree", "세계수", "World Tree", 10000000000, "Europe", "tree", rgb(120, 90, 60), rgb(90, 220, 120), rgb(255, 255, 200), M.Wood },
}

Landmarks.List = {} :: { Landmark }
Landmarks.ById = {} :: { [string]: Landmark }

for _, def in DEFINITIONS do
	local oneIn = def[4] :: number
	local landmark: Landmark = {
		Id = def[1] :: string,
		Name = def[2] :: string,
		Subtitle = def[3] :: string,
		OneIn = oneIn,
		Region = def[5] :: string,
		Shape = def[6] :: string,
		Primary = def[7] :: Color3,
		Secondary = def[8] :: Color3,
		Accent = def[9] :: Color3,
		Material = def[10] :: Enum.Material,
		Tier = tierFor(oneIn),
	}
	assert(Landmarks.ById[landmark.Id] == nil, "중복된 명소 Id: " .. landmark.Id)
	assert(Landmarks.RegionById[landmark.Region], "없는 지역: " .. landmark.Region)
	table.insert(Landmarks.List, landmark)
	Landmarks.ById[landmark.Id] = landmark
end

-- 흔한 것 → 희귀한 것 순서(여권/표시용)
table.sort(Landmarks.List, function(a, b)
	return a.OneIn < b.OneIn
end)

-- 희귀한 것 → 흔한 것 순서(굴림 판정용)
Landmarks.RarestFirst = table.clone(Landmarks.List)
table.sort(Landmarks.RarestFirst, function(a, b)
	return a.OneIn > b.OneIn
end)

-- 지역별 목록(흔한 것 → 희귀한 것)
Landmarks.ByRegion = {} :: { [string]: { Landmark } }
for _, region in Landmarks.Regions do
	Landmarks.ByRegion[region.Id] = {}
end
for _, landmark in Landmarks.List do
	table.insert(Landmarks.ByRegion[landmark.Region], landmark)
end

Landmarks.Common = Landmarks.List[1]

-- 장식용 지구본(뽑기·수집 대상 아님): 광장의 거대 지구본, 굴림 연출의 도는 지구본에 씀.
-- Models.create 에 명소처럼 넘길 수 있게 같은 모양의 표. LandmarkModels 폴더에 "globe" 로 교체 가능.
Landmarks.Globe = {
	Id = "globe",
	Name = "지구본",
	Subtitle = "Globe",
	OneIn = 0,
	Region = Landmarks.Regions[1].Id,
	Shape = "globe",
	Primary = rgb(30, 95, 200), -- 바다
	Secondary = rgb(96, 190, 80), -- 초록 땅(숲·사막·눈 색은 Models 의 globe 가 정함)
	Accent = rgb(255, 255, 255),
	Material = M.SmoothPlastic,
	Tier = Landmarks.Tiers[1],
} :: Landmark
Landmarks.tierFor = tierFor

return Landmarks
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Models</string>
          <string name="Source"><![CDATA[-- 명소 3D 모형 (서버·클라이언트 공용, 양보(yield) 없음)
--
-- Models.build(landmark): 에셋 없이 기본 파트(Block/Ball/Cylinder/Wedge)만으로 만든 임시 미니어처.
--   설계 공간: 바닥 가로·세로 10 스터드(원점 중심) 안, 높이 22 스터드 이하, 바닥 y = 0, 정면은 -Z 쪽.
--   투명한 "Root" 파트(10 x 0.2 x 10)가 바닥 중앙에 있고 PrimaryPart(피벗 = 바닥 중앙).
--   모든 파트 Anchored = true, CanCollide = false. 색은 명소의 Primary / Secondary / Accent, 재질은 Material.
-- Models.create(landmark, size, opts?): 실제로 쓰는 함수.
--   ReplicatedStorage.LandmarkModels 에 명소 Id 와 같은 이름의 Model 이 있으면 복제(AI 메쉬 교체용), 없으면 build().
--   가로·세로 중 큰 쪽이 size 스터드가 되도록 Model:ScaleTo(높이는 size * 2.2 까지). 피벗 = 바닥 중앙, 부모 없음.
--   opts.Anchored == false 면 모든 BasePart: Anchored/CanCollide/CanQuery/CanTouch 끔 + Massless(캐릭터에 용접할 때).

local Landmarks = require(script.Parent.Landmarks)

type Landmark = Landmarks.Landmark

local Models = {}

local DESIGN_WIDTH = 10 -- 설계 공간 가로·세로(스터드)
local MAX_HEIGHT_RATIO = 2.2 -- 높이 한도 = size * 2.2 (설계 공간 22 / 10)
local OVERRIDE_FOLDER = "LandmarkModels"

local V = Vector3.new
local rgb = Color3.fromRGB
local Mat = Enum.Material
local PI = math.pi
local TAU = math.pi * 2

local UPRIGHT = CFrame.Angles(0, 0, PI / 2) -- 원기둥(길이 축 = X)을 세움
local ALONG_Z = CFrame.Angles(0, PI / 2, 0) -- 원기둥 길이 축을 Z 로(정면을 보는 원판)
local CORNERS = { { 1, 1 }, { 1, -1 }, { -1, 1 }, { -1, -1 } }

-- 명소 색으로 표현하기 어려운 자연물/그늘 색
local GRASS = rgb(96, 168, 78)
local LEAF = rgb(58, 132, 62)
local WATER = rgb(60, 145, 225)
local DARK = rgb(38, 32, 30)
local TILE = rgb(62, 66, 74)
local ROCK = rgb(120, 114, 106)
local WOOD = rgb(105, 72, 48)
local SAND = rgb(226, 204, 156)
local CLOUD = rgb(248, 250, 255)
local BLACK = rgb(0, 0, 0)
local WHITE = rgb(255, 255, 255)

type Ctx = {
	model: Model,
	id: string, -- 명소 Id(같은 모형을 쓰는 명소끼리 작은 차이를 줄 때)
	origin: CFrame, -- 파트 좌표에 앞에서 곱하는 기준 좌표계(기울어진 탑 등)
	P: Color3, -- 주 색
	S: Color3, -- 보조 색
	A: Color3, -- 강조 색(빛/장식)
	M: Enum.Material, -- 주 재질
	grand: boolean, -- 불가사의 이상 등급: 같은 모형을 쓰는 흔한 명소보다 웅장하게
}

local function mix(a: Color3, b: Color3, t: number): Color3
	return Color3.new(a.R + (b.R - a.R) * t, a.G + (b.G - a.G) * t, a.B + (b.B - a.B) * t)
end

-- 파트 생성 헬퍼 ------------------------------------------------------------

local function add(
	c: Ctx,
	part: BasePart,
	cf: CFrame,
	size: Vector3,
	color: Color3,
	material: Enum.Material?,
	transparency: number?
): BasePart
	part.Anchored = true
	part.CanCollide = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Size = size
	part.CFrame = c.origin * cf
	part.Color = color
	part.Material = material or c.M
	part.Transparency = transparency or 0
	part.Parent = c.model
	return part
end

local function shaped(
	c: Ctx,
	shape: Enum.PartType,
	cf: CFrame,
	size: Vector3,
	color: Color3,
	material: Enum.Material?,
	transparency: number?
): BasePart
	local part = Instance.new("Part")
	part.Shape = shape -- 크기보다 먼저(공 모양은 크기가 균일해짐)
	return add(c, part, cf, size, color, material, transparency)
end

-- 중심 좌표계 cf 에 놓는 직육면체
local function block(c: Ctx, cf: CFrame, size: Vector3, color: Color3, material: Enum.Material?, transparency: number?)
	return shaped(c, Enum.PartType.Block, cf, size, color, material, transparency)
end

-- 바닥 중앙이 (x, y, z) 인 직육면체
local function box(
	c: Ctx,
	x: number,
	y: number,
	z: number,
	sx: number,
	sy: number,
	sz: number,
	color: Color3,
	material: Enum.Material?,
	transparency: number?
)
	return block(c, CFrame.new(x, y + sy / 2, z), V(sx, sy, sz), color, material, transparency)
end

-- 중심이 (x, y, z), 지름 d 인 공
local function ball(
	c: Ctx,
	x: number,
	y: number,
	z: number,
	d: number,
	color: Color3,
	material: Enum.Material?,
	transparency: number?
)
	return shaped(c, Enum.PartType.Ball, CFrame.new(x, y, z), V(d, d, d), color, material, transparency)
end

-- 길이 축이 cf 의 X 축인 원기둥
local function cyl(
	c: Ctx,
	cf: CFrame,
	length: number,
	d: number,
	color: Color3,
	material: Enum.Material?,
	transparency: number?
)
	return shaped(c, Enum.PartType.Cylinder, cf, V(length, d, d), color, material, transparency)
end

-- 바닥 중앙이 (x, y, z) 인 세운 원기둥(높이 h, 지름 d)
local function col(
	c: Ctx,
	x: number,
	y: number,
	z: number,
	h: number,
	d: number,
	color: Color3,
	material: Enum.Material?,
	transparency: number?
)
	return cyl(c, CFrame.new(x, y + h / 2, z) * UPRIGHT, h, d, color, material, transparency)
end

-- 쐐기: 높은 면이 +Z(뒤), 경사면이 -Z(앞, cf.LookVector) 쪽을 봄
local function wedge(c: Ctx, cf: CFrame, size: Vector3, color: Color3, material: Enum.Material?, transparency: number?)
	return add(c, Instance.new("WedgePart"), cf, size, color, material, transparency)
end

-- a 에서 b 까지 이어지는 각재(단면 t x t)
local function beam(
	c: Ctx,
	a: Vector3,
	b: Vector3,
	t: number,
	color: Color3,
	material: Enum.Material?,
	transparency: number?
)
	local delta = b - a
	local length = delta.Magnitude
	local mid = (a + b) / 2
	local cf
	if math.abs(delta.Y) > length * 0.999 then
		cf = CFrame.new(mid) * CFrame.Angles(PI / 2, 0, 0) -- 수직이면 lookAt 대신 직접 세움
	else
		cf = CFrame.lookAt(mid, b)
	end
	return block(c, cf, V(t, t, length), color, material, transparency)
end

-- (dx, dz) 쪽을 정면(LookVector)으로 보는 회전
local function facing(dx: number, dz: number): CFrame
	return CFrame.Angles(0, math.atan2(-dx, -dz), 0)
end

-- 개구부 위쪽 모서리를 채우는 쐐기(아치처럼 보이게). xWall = 벽면 x, side = -1(왼쪽 벽) / 1(오른쪽 벽)
local function archCorner(
	c: Ctx,
	xWall: number,
	yTop: number,
	z: number,
	leg: number,
	depth: number,
	color: Color3,
	side: number
)
	-- 뒤집은(roll 180도) 쐐기를 벽 쪽으로 돌림: 직각이 벽과 천장이 만나는 모서리에 옴
	local cf = CFrame.new(xWall - side * leg / 2, yTop - leg / 2, z)
		* CFrame.Angles(0, side * PI / 2, 0)
		* CFrame.Angles(0, 0, PI)
	return wedge(c, cf, V(depth, leg, leg), color)
end

-- 기와지붕: 처마 판 + 앞뒤 경사 + 용마루 + 네 귀퉁이 들린 추녀. 바닥이 y, 전체 높이 ≈ 0.3 + h + 0.2
local function roof(c: Ctx, x: number, y: number, z: number, w: number, d: number, h: number, color: Color3)
	box(c, x, y, z, w, 0.3, d, color)
	local top = y + 0.3
	wedge(c, CFrame.new(x, top + h / 2, z - d / 4), V(w - 0.3, h, d / 2), color)
	wedge(c, CFrame.new(x, top + h / 2, z + d / 4) * CFrame.Angles(0, PI, 0), V(w - 0.3, h, d / 2), color)
	box(c, x, top + h - 0.2, z, w - 0.2, 0.4, 0.45, mix(color, BLACK, 0.25))
	for _, s in CORNERS do
		local cf = CFrame.new(x + s[1] * (w / 2 - 0.35), top + 0.3, z + s[2] * (d / 2 - 0.35))
		wedge(c, cf * CFrame.Angles(0, math.atan2(s[1], s[2]), 0), V(0.55, 0.6, 1.1), color)
	end
end

-- 박공지붕(쐐기 두 개). 바닥이 y
local function gable(c: Ctx, x: number, y: number, z: number, w: number, d: number, h: number, color: Color3)
	wedge(c, CFrame.new(x, y + h / 2, z - d / 4), V(w, h, d / 2), color)
	wedge(c, CFrame.new(x, y + h / 2, z + d / 4) * CFrame.Angles(0, PI, 0), V(w, h, d / 2), color)
end

-- 나무: 줄기 + 잎 공
local function plant(c: Ctx, x: number, y: number, z: number, h: number, d: number, leaf: Color3)
	col(c, x, y, z, h, math.max(0.2, d * 0.22), WOOD, Mat.Wood)
	ball(c, x, y + h + d * 0.3, z, d, leaf, Mat.Grass)
end

-- 계단식 피라미드(steps 단). 꼭대기 높이를 돌려줌
local function stepped(
	c: Ctx,
	x: number,
	z: number,
	y: number,
	base: number,
	height: number,
	steps: number,
	color: Color3
)
	local stepHeight = height / steps
	for i = 0, steps - 1 do
		local w = base * (1 - i / steps)
		box(c, x, y + i * stepHeight, z, w, stepHeight, w, color)
	end
	return y + height
end

-- 시계 판: cf 는 벽면 중앙, -Z 가 바깥
local function clockFace(c: Ctx, cf: CFrame, d: number)
	cyl(c, cf * CFrame.new(0, 0, -0.1) * ALONG_Z, 0.2, d, c.A, Mat.Neon)
	block(c, cf * CFrame.new(0, d * 0.14, -0.25), V(d * 0.08, d * 0.3, 0.1), c.S)
	block(c, cf * CFrame.Angles(0, 0, -2.1) * CFrame.new(0, d * 0.2, -0.27), V(d * 0.06, d * 0.42, 0.1), c.S)
end

-- 모형들 ------------------------------------------------------------------

local BUILDERS: { [string]: (Ctx) -> () } = {}

-- 시계탑 / 빅벤: 기단 + 탑신 + 네 면 시계 + 종루 + 뾰족 지붕
function BUILDERS.clocktower(c)
	box(c, 0, 0, 0, 6, 0.6, 6, c.S)
	box(c, 0, 0.6, 0, 3.6, 10, 3.6, c.P)
	for _, s in CORNERS do
		box(c, s[1] * 1.8, 0.6, s[2] * 1.8, 0.6, 10, 0.6, c.S)
	end
	box(c, 0, 5.4, 0, 3.9, 0.3, 3.9, c.S)
	box(c, 0, 10.6, 0, 4.4, 3.6, 4.4, c.P)
	for i = 0, 3 do
		clockFace(c, CFrame.Angles(0, i * PI / 2, 0) * CFrame.new(0, 12.4, -2.2), 3)
	end
	box(c, 0, 14.2, 0, 5, 0.4, 5, c.S)
	box(c, 0, 14.6, 0, 3.6, 1.6, 3.6, c.P)
	for i = 0, 3 do
		block(c, CFrame.Angles(0, i * PI / 2, 0) * CFrame.new(0, 15.4, -1.8), V(1.8, 1, 0.1), DARK)
	end
	box(c, 0, 16.2, 0, 4, 0.3, 4, c.S)
	local y = 16.5
	for _, step in { { 3, 0.9 }, { 2.2, 0.9 }, { 1.4, 1 }, { 0.7, 1 } } do
		box(c, 0, y, 0, step[1], step[2], step[1], c.S)
		y += step[2]
	end
	col(c, 0, y, 0, 1, 0.25, c.A, Mat.Metal)
	ball(c, 0, y + 1.25, 0, 0.5, c.A, Mat.Neon)
end

-- 등대 / 알렉산드리아 등대: 줄무늬 탑(흔한 것) 또는 3단 석탑(불가사의) + 유리 등롱 + 불빛 줄기
function BUILDERS.lighthouse(c)
	local top
	if c.grand then
		box(c, 0, 0, 0, 9.6, 0.6, 9.6, c.S)
		box(c, 0, 0.6, 0, 6.4, 6.4, 6.4, c.P)
		for i = 0, 3 do
			block(c, CFrame.Angles(0, i * PI / 2, 0) * CFrame.new(0, 4.6, -3.2), V(0.6, 1.6, 0.1), DARK)
		end
		box(c, 0, 7, 0, 6.9, 0.5, 6.9, c.S)
		box(c, 0, 7.5, 0, 4.4, 4.2, 4.4, c.P)
		block(c, CFrame.new(0, 9.6, 0) * CFrame.Angles(0, PI / 4, 0), V(4.4, 4.2, 4.4), c.P)
		col(c, 0, 11.7, 0, 0.4, 5.2, c.S)
		col(c, 0, 12.1, 0, 3.8, 3.2, c.P)
		top = 15.9
	else
		col(c, 0, 0, 0, 0.8, 8.6, ROCK, Mat.Slate)
		box(c, 2.2, 0.8, 1.3, 2, 1.4, 1.8, c.P)
		gable(c, 2.2, 2.2, 1.3, 2.3, 2.1, 0.9, c.S)
		local y = 0.8
		for i = 0, 5 do
			col(c, 0, y, 0, 1.9, 3.4 - i * 0.18, if i % 2 == 0 then c.P else c.S)
			y += 1.9
		end
		top = y
	end
	col(c, 0, top, 0, 0.3, 3.8, c.S)
	col(c, 0, top + 0.3, 0, 1.8, 2.2, c.A, Mat.Glass, 0.45)
	ball(c, 0, top + 1.2, 0, 1.3, c.A, Mat.Neon)
	col(c, 0, top + 2.1, 0, 0.3, 2.6, c.S)
	col(c, 0, top + 2.4, 0, 0.6, 1.6, c.S)
	if c.grand then
		-- 꼭대기의 신상
		col(c, 0, top + 3, 0, 1.1, 0.5, c.P)
		ball(c, 0, top + 4.3, 0, 0.45, c.P)
	else
		col(c, 0, top + 3, 0, 0.5, 0.8, c.S)
		ball(c, 0, top + 3.7, 0, 0.5, c.A, Mat.Neon)
	end
	block(c, CFrame.new(0, top + 1.2, 0) * CFrame.Angles(0, math.rad(30), 0), V(9.4, 0.5, 0.5), c.A, Mat.Neon, 0.6)
end

-- 풍차: 잔디 + 원뿔형 탑 + 둥근 지붕 + 네 날개
function BUILDERS.windmill(c)
	col(c, 0, 0, 0, 0.4, 9.4, GRASS, Mat.Grass)
	col(c, 0, 0.4, 0, 3, 5.4, c.P)
	col(c, 0, 3.4, 0, 3, 4.8, c.P)
	col(c, 0, 6.4, 0, 3, 4.2, c.P)
	col(c, 0, 3.3, 0, 0.3, 6.2, c.S)
	ball(c, 0, 9.4, 0, 4.4, c.S)
	box(c, 0, 0.4, -2.65, 1.1, 1.8, 0.3, c.S)
	box(c, 0, 4.4, -2.35, 0.7, 0.9, 0.2, DARK)
	box(c, 0, 7.2, -2.05, 0.6, 0.8, 0.2, DARK)
	local hub = CFrame.new(0, 9.6, -2.4)
	cyl(c, hub * ALONG_Z, 1.2, 0.8, c.S)
	for i = 0, 3 do
		local arm = CFrame.new(0, 9.6, -3.1) * CFrame.Angles(0, 0, PI / 4 + i * PI / 2)
		block(c, arm * CFrame.new(0, 2.5, 0), V(0.25, 5, 0.25), c.S)
		block(c, arm * CFrame.new(0.55, 2.9, -0.05), V(0.9, 3.8, 0.1), c.A, nil, 0.05)
	end
end

-- 분수대: 팔각 수반 + 2단 물받이 + 물줄기(유리/네온)
function BUILDERS.fountain(c)
	col(c, 0, 0, 0, 0.3, 9.8, c.P)
	local r = 4
	local side = 2 * r * math.tan(PI / 8) + 0.1
	for i = 0, 7 do
		block(c, CFrame.Angles(0, i * PI / 4, 0) * CFrame.new(0, 0.85, -r), V(side, 1.1, 0.5), c.P)
	end
	col(c, 0, 0.3, 0, 0.6, 7.5, c.S, Mat.Glass, 0.25)
	col(c, 0, 0.3, 0, 3.2, 1.2, c.P)
	col(c, 0, 3.1, 0, 0.4, 2.6, c.P)
	col(c, 0, 3.5, 0, 0.5, 4.6, c.P)
	col(c, 0, 4, 0, 0.12, 4, c.S, Mat.Glass, 0.2)
	col(c, 0, 0.9, 0, 3, 4.5, c.A, Mat.Glass, 0.65)
	col(c, 0, 4, 0, 1.8, 0.7, c.P)
	col(c, 0, 5.8, 0, 0.35, 2.4, c.P)
	col(c, 0, 6.15, 0, 0.1, 2, c.S, Mat.Glass, 0.2)
	col(c, 0, 4.12, 0, 1.68, 2.3, c.A, Mat.Glass, 0.65)
	col(c, 0, 6.15, 0, 2.2, 0.35, c.A, Mat.Neon, 0.3)
	ball(c, 0, 8.4, 0, 1, c.A, Mat.Glass, 0.45)
	for i = 0, 3 do
		local rot = CFrame.Angles(0, i * PI / 2 + PI / 4, 0)
		beam(c, rot * V(0, 1.4, -3.4), rot * V(0, 2.8, -2.3), 0.2, c.A, Mat.Neon, 0.3)
	end
end

-- 개선문: 원형 광장 + 네 기둥(앞뒤·옆 아치) + 코니스 + 아틱
function BUILDERS.arch(c)
	col(c, 0, 0, 0, 0.2, 9.8, c.S)
	box(c, 0, 0.2, 0, 9.2, 0.35, 5, c.S)
	local y = 0.55
	for _, sx in { -1, 1 } do
		local x = sx * 3
		box(c, x, y, -1.55, 3.2, 7, 1.3, c.P)
		box(c, x, y, 1.55, 3.2, 7, 1.3, c.P)
		box(c, x, y + 4, 0, 3.2, 3, 1.8, c.P)
		box(c, x, y + 1.2, -2.25, 1.8, 2.2, 0.15, c.S)
		box(c, x, y + 1.2, 2.25, 1.8, 2.2, 0.15, c.S)
	end
	box(c, 0, y + 5.6, 0, 2.8, 1.4, 4.4, c.P)
	archCorner(c, -1.4, y + 5.6, 0, 1.1, 4.4, c.P, -1)
	archCorner(c, 1.4, y + 5.6, 0, 1.1, 4.4, c.P, 1)
	box(c, 0, 7.55, 0, 9.6, 0.5, 4.8, c.S)
	box(c, 0, 8.05, 0, 9.2, 1.9, 4.4, c.P)
	box(c, 0, 8.6, -2.22, 8.4, 0.35, 0.1, c.A, Mat.Metal)
	box(c, 0, 8.6, 2.22, 8.4, 0.35, 0.1, c.A, Mat.Metal)
	box(c, 0, 9.95, 0, 9.6, 0.3, 4.8, c.S)
	ball(c, 0, 0.75, 0, 0.4, c.A, Mat.Neon)
end

-- 숭례문: 홍예문이 뚫린 석축 + 붉은 문루 2층 + 들린 추녀의 기와지붕 2겹
function BUILDERS.gate(c)
	box(c, -2.8, 0, 0, 3.6, 3.6, 4.6, c.P)
	box(c, 2.8, 0, 0, 3.6, 3.6, 4.6, c.P)
	box(c, 0, 2.3, 0, 2, 1.3, 4.6, c.P)
	archCorner(c, -1, 2.3, 0, 0.7, 4.6, c.P, -1)
	archCorner(c, 1, 2.3, 0, 0.7, 4.6, c.P, 1)
	box(c, 0, 3.6, 0, 9.2, 0.25, 4.8, mix(c.P, WHITE, 0.2))
	box(c, 0, 3.85, 0, 7.4, 0.25, 3.6, WOOD, Mat.Wood)
	box(c, 0, 4.1, 0, 6.8, 1.6, 3, c.A)
	box(c, 0, 5.4, 0, 7, 0.35, 3.2, c.S)
	roof(c, 0, 5.75, 0, 9, 5, 1.3, TILE)
	box(c, 0, 6.6, 0, 5.6, 1.6, 2.4, c.A)
	box(c, 0, 7.3, -1.22, 0.9, 0.6, 0.1, DARK)
	box(c, 0, 8.2, 0, 5.8, 0.3, 2.6, c.S)
	roof(c, 0, 8.5, 0, 8.2, 4.4, 1.5, TILE)
end

-- 피사의 사탑: 잔디 광장 위에 기울어진 원통형 8층 탑
function BUILDERS.leaning(c)
	box(c, 0, 0, 0, 9.6, 0.25, 9.6, GRASS, Mat.Grass)
	col(c, 0, 0.25, 0, 0.4, 5, c.S)
	c.origin = CFrame.new(0, 0.65, 0) * CFrame.Angles(0, 0, math.rad(-7))
	col(c, 0, 0, 0, 2.2, 3.6, c.P)
	local y = 2.2
	for _ = 1, 6 do
		col(c, 0, y, 0, 0.25, 4, c.S)
		col(c, 0, y + 0.25, 0, 1.45, 3.4, c.P)
		y += 1.7
	end
	col(c, 0, y, 0, 0.25, 3.6, c.S)
	col(c, 0, y + 0.25, 0, 1.5, 2.6, c.P)
	col(c, 0, y + 1.75, 0, 0.3, 2.9, c.S)
	c.origin = CFrame.new()
end

-- 서 있는 인물의 상체(어깨 윗면 높이 y): 목, 머리, 햇살 왕관, 횃불 든 오른팔, 서판 든 왼팔
local function figureTop(c: Ctx, y: number)
	col(c, 0, y, 0, 0.5, 0.6, c.P)
	local head = V(0, y + 0.95, 0)
	ball(c, 0, head.Y, 0, 1.2, c.P)
	col(c, 0, head.Y + 0.2, 0, 0.25, 1.35, c.P)
	for k = -3, 3 do
		local angle = k * PI / 7
		local dir = V(math.sin(angle), 0.45, -math.cos(angle)).Unit
		beam(c, head + dir * 0.5, head + dir * 1.25, 0.14, c.P)
	end
	beam(c, V(1, y - 0.2, 0), V(1.5, y + 2.6, 0), 0.5, c.P)
	col(c, 1.5, y + 2.4, 0, 0.9, 0.35, c.P)
	col(c, 1.5, y + 3.2, 0, 0.3, 0.75, c.A, Mat.Metal)
	ball(c, 1.5, y + 3.85, 0, 0.8, c.A, Mat.Neon)
	beam(c, V(-1, y - 0.2, 0), V(-1.2, y - 2, -0.6), 0.45, c.P)
	block(c, CFrame.new(-1.35, y - 1.4, -0.4) * CFrame.Angles(0, 0, 0.12), V(0.3, 1.5, 1), c.P)
end

-- 자유의 여신상(별 모양 요새 + 받침대) / 로도스 거상(항구를 가로질러 두 다리로 선 청동상)
function BUILDERS.statue(c)
	if c.grand then
		box(c, 0, 0, 0, 9.8, 0.3, 9.8, WATER, Mat.Glass, 0.15)
		for _, sx in { -1, 1 } do
			box(c, sx * 3.3, 0, 0, 2.8, 1, 9.6, c.S)
			box(c, sx * 2.2, 1, 0, 2, 2.4, 2, c.S)
			beam(c, V(sx * 2.2, 3.3, 0), V(sx * 0.6, 8.3, 0), 0.9, c.P)
		end
		box(c, 0, 7.8, 0, 2, 1.2, 1.2, c.P)
		box(c, 0, 9, 0, 2.2, 2.4, 1.3, c.P)
		figureTop(c, 11.4)
	else
		box(c, 0, 0, 0, 6.8, 0.6, 6.8, c.S)
		block(c, CFrame.new(0, 0.3, 0) * CFrame.Angles(0, PI / 4, 0), V(6.8, 0.6, 6.8), c.S)
		box(c, 0, 0.6, 0, 4.2, 0.8, 4.2, c.S)
		box(c, 0, 1.4, 0, 3.4, 4, 3.4, c.S)
		box(c, 0, 5.4, 0, 3.9, 0.4, 3.9, c.S)
		col(c, 0, 5.8, 0, 2.8, 2.6, c.P)
		col(c, 0, 8.6, 0, 2.6, 2.2, c.P)
		box(c, 0, 10.8, 0, 2.3, 1.3, 1.3, c.P)
		figureTop(c, 12.1)
	end
end

-- 스카이타워: 오클랜드 도심 블록(도로 + 빌딩들 + 뒤쪽 스카이시티) 위에 바로 선 탑.
--   밑동의 네 다리 + 긴 탑신 + 아래가 벌어진 전망대(유리 2층 + 빛 띠) + 긴 안테나
local function skyTower(c: Ctx)
	box(c, 0, 0, 0, 9.8, 0.3, 9.8, rgb(96, 100, 108), Mat.Concrete)
	box(c, 0, 0.3, 0, 3.8, 0.08, 3.8, rgb(190, 188, 182), Mat.Concrete)
	local glass = rgb(120, 160, 200)
	-- 빌딩: { x, z, 가로, 높이, 세로, 색, 재질 }
	local buildings = {
		{ -3.3, 3.3, 2.8, 4.8, 2.6, glass, Mat.Glass },
		{ 3.3, 3.3, 2.8, 3.8, 2.6, rgb(215, 205, 185), Mat.Concrete },
		{ 3.5, -0.1, 2.2, 5.6, 2.4, mix(c.S, glass, 0.5), Mat.Glass },
		{ -3.5, -0.3, 2.2, 2.6, 2.6, rgb(200, 190, 175), Mat.Concrete },
		{ -3.4, -3.6, 2.4, 1.6, 2, rgb(225, 225, 220), Mat.Concrete },
		{ 3.4, -3.6, 2.4, 2.2, 2, mix(glass, WHITE, 0.3), Mat.Glass },
	}
	for _, b in buildings do
		box(c, b[1], 0.3, b[2], b[3], b[4], b[5], b[6], b[7])
	end
	box(c, 0, 0.3, 3.1, 3.4, 1.6, 2.6, mix(c.P, c.S, 0.35))
	for _, s in CORNERS do
		beam(c, V(s[1] * 1.1, 0.35, s[2] * 1.1), V(s[1] * 0.3, 3.2, s[2] * 0.3), 0.45, c.P)
	end
	col(c, 0, 0.3, 0, 11, 1.15, c.P)
	col(c, 0, 11.2, 0, 0.5, 1.9, c.P)
	col(c, 0, 11.7, 0, 0.5, 2.7, c.P)
	col(c, 0, 12.2, 0, 1.1, 3.2, c.S, Mat.Glass)
	col(c, 0, 12.6, 0, 0.3, 3.3, c.A, Mat.Neon)
	col(c, 0, 13.3, 0, 0.35, 3.4, c.P)
	col(c, 0, 13.65, 0, 0.7, 2.4, c.S, Mat.Glass)
	col(c, 0, 14.35, 0, 0.35, 2, c.P)
	col(c, 0, 14.7, 0, 1.2, 0.9, c.P)
	col(c, 0, 15.9, 0, 4.2, 0.45, c.P)
	col(c, 0, 20.1, 0, 1, 0.22, c.A)
	ball(c, 0, 21.3, 0, 0.4, c.A, Mat.Neon)
end

-- 남산타워: 계단식 초록 언덕 + 가느다란 탑신 + 전망대 원반 + 안테나 (스카이타워는 도심 블록 위 버전)
function BUILDERS.needle(c)
	if c.id == "skytower" then
		skyTower(c)
		return
	end
	col(c, 0, 0, 0, 1.2, 9.8, GRASS, Mat.Grass)
	col(c, 0.3, 1.2, 0.2, 1.1, 7.4, GRASS, Mat.Grass)
	col(c, 0.2, 2.3, 0.1, 1, 4.8, GRASS, Mat.Grass)
	for i = 0, 5 do
		local angle = i * TAU / 6 + 0.4
		local r = if i % 2 == 0 then 4.1 else 3.1
		ball(c, math.cos(angle) * r, if i % 2 == 0 then 1.6 else 2.6, math.sin(angle) * r, 1.1, LEAF, Mat.Grass)
	end
	col(c, 0, 3.3, 0, 1, 2.6, c.P)
	col(c, 0, 4.3, 0, 7.6, 1.1, c.P)
	col(c, 0, 11.9, 0, 0.4, 2.6, c.S)
	col(c, 0, 12.3, 0, 1.5, 3.2, c.S, Mat.Glass)
	col(c, 0, 12.8, 0, 0.35, 3.3, c.A, Mat.Neon)
	col(c, 0, 13.8, 0, 0.5, 3.4, c.P)
	col(c, 0, 14.3, 0, 0.8, 1.6, c.P)
	col(c, 0, 15.1, 0, 2.6, 0.6, c.P)
	col(c, 0, 17.7, 0, 1.8, 0.35, c.A)
	ball(c, 0, 19.7, 0, 0.45, c.A, Mat.Neon)
end

-- 에펠탑: 네 다리가 모이며 가늘어지는 격자 탑 + 다리 사이 아치 + 전망대 3곳
function BUILDERS.lattice(c)
	box(c, 0, 0, 0, 9.8, 0.2, 9.8, GRASS, Mat.Grass)
	local function legAt(y: number): number
		return 4 - 1.5 * (y - 0.5) / 3.7
	end
	for _, s in CORNERS do
		local sx, sz = s[1], s[2]
		beam(c, V(sx * 4, 0.5, sz * 4), V(sx * 2.5, 4.2, sz * 2.5), 0.9, c.P)
		beam(c, V(sx * 2.4, 4.6, sz * 2.4), V(sx * 1.3, 9.2, sz * 1.3), 0.6, c.P)
		beam(c, V(sx * 1.2, 9.6, sz * 1.2), V(sx * 0.35, 17, sz * 0.35), 0.4, c.P)
	end
	-- 다리 사이 아치(3토막)
	for i = 0, 3 do
		local rot = CFrame.Angles(0, i * PI / 2, 0)
		local low, high = legAt(1), legAt(3.2)
		local points = { V(-low, 1, -low), V(-1.7, 3.2, -high), V(1.7, 3.2, -high), V(low, 1, -low) }
		for k = 1, 3 do
			beam(c, rot * points[k], rot * points[k + 1], 0.35, c.S)
		end
	end
	box(c, 0, 4.2, 0, 6, 0.5, 6, c.S)
	box(c, 0, 4.05, 0, 6.2, 0.15, 6.2, c.A, Mat.Neon)
	box(c, 0, 9.2, 0, 3.3, 0.45, 3.3, c.S)
	box(c, 0, 9.05, 0, 3.5, 0.15, 3.5, c.A, Mat.Neon)
	box(c, 0, 13, 0, 1.9, 0.25, 1.9, c.S)
	box(c, 0, 17, 0, 1.3, 0.4, 1.3, c.S)
	box(c, 0, 17.4, 0, 0.8, 0.9, 0.8, c.P)
	col(c, 0, 18.3, 0, 2.6, 0.22, c.P)
	ball(c, 0, 21.05, 0, 0.45, c.A, Mat.Neon)
end

-- 콜로세움: 타원형 아케이드(기둥 + 층 띠), 앞쪽은 무너져 낮고 뒤쪽은 3층, 안쪽 관중석과 모래 경기장
function BUILDERS.ring(c)
	local a, b = 4.5, 3.7
	local count = 14
	local function point(i: number): Vector3
		local t = i / count * TAU
		return V(a * math.cos(t), 0, b * math.sin(t))
	end
	local function tall(i: number): boolean
		return i % count <= 8 -- 뒤쪽(+Z) 절반 남짓만 온전함
	end
	box(c, 0, 0, 0, 9.8, 0.2, 8.4, c.S)
	box(c, 0, 0.2, 0, 5.2, 0.15, 3.8, c.A)
	for i = 0, count - 1 do
		local t = i / count * TAU
		local p = point(i)
		local h = if tall(i) then 5.4 else 3.6
		local yaw = math.atan2(-b * math.cos(t), -a * math.sin(t))
		block(c, CFrame.new(p.X, 0.2 + h / 2, p.Z) * CFrame.Angles(0, yaw, 0), V(0.62, h, 0.7), c.P)
	end
	for j = 0, count / 2 - 1 do
		local i1, i2 = 2 * j, 2 * j + 2
		local p1, p2 = point(i1), point(i2)
		local levels = if tall(i1) and tall(i2) then { 1.9, 3.4, 5.2 } else { 1.9, 3.4 }
		for _, y in levels do
			local mid = (p1 + p2) / 2
			local cf = CFrame.lookAt(V(mid.X, y + 0.2, mid.Z), V(p2.X, y + 0.2, p2.Z))
			block(c, cf, V(0.75, 0.4, (p2 - p1).Magnitude + 0.3), c.P)
		end
	end
	-- 관중석(안쪽으로 기운 쐐기)
	local seats = 7
	for j = 0, seats - 1 do
		local t1, t2 = j / seats * TAU, (j + 1) / seats * TAU
		local q1 = V(3.5 * math.cos(t1), 0, 2.75 * math.sin(t1))
		local q2 = V(3.5 * math.cos(t2), 0, 2.75 * math.sin(t2))
		local mid = (q1 + q2) / 2
		local chord = q2 - q1
		local inward = V(chord.Z, 0, -chord.X).Unit
		if inward:Dot(mid) > 0 then
			inward = -inward
		end
		wedge(c, CFrame.new(mid.X, 1.2, mid.Z) * facing(inward.X, inward.Z), V(chord.Magnitude + 0.2, 2, 1.2), c.S)
	end
end

-- 타지마할: 대리석 기단 + 본당(아치 입구) + 양파 돔 + 작은 정자 4 + 첨탑 4 + 연못
function BUILDERS.dome(c)
	box(c, 0, 0, 0, 9.6, 1, 9.6, c.S)
	box(c, 0, 1, 0, 5.6, 4, 5.6, c.P)
	local portal = mix(c.S, BLACK, 0.3)
	for i = 0, 3 do
		block(c, CFrame.Angles(0, i * PI / 2, 0) * CFrame.new(0, 2.6, -2.8), V(2, 3, 0.12), portal)
	end
	col(c, 0, 5, 0, 1.2, 3.8, c.P)
	ball(c, 0, 8.2, 0, 4.8, c.P)
	ball(c, 0, 10.4, 0, 2.2, c.P)
	col(c, 0, 11.3, 0, 1.3, 0.25, c.A, Mat.Metal)
	ball(c, 0, 12.75, 0, 0.4, c.A, Mat.Neon)
	for _, s in CORNERS do
		local x, z = s[1] * 2, s[2] * 2
		col(c, x, 5, z, 0.8, 0.9, c.P)
		ball(c, x, 6.05, z, 1, c.P)
	end
	for _, s in CORNERS do
		local x, z = s[1] * 4.2, s[2] * 4.2
		col(c, x, 1, z, 8, 0.8, c.P)
		col(c, x, 4.4, z, 0.2, 1.2, c.S)
		col(c, x, 9, z, 0.3, 1.2, c.S)
		ball(c, x, 9.75, z, 0.9, c.P)
	end
	box(c, 0, 1, -3.9, 0.9, 0.08, 1.7, WATER, Mat.Glass, 0.1)
end

-- 앙코르와트: 해자 + 섬 + 3단 기단 + 정면 계단 + 연꽃 봉오리 탑 5개(가운데가 가장 높음)
function BUILDERS.temple(c)
	box(c, 0, 0, 0, 9.8, 0.25, 9.8, WATER, Mat.Glass, 0.1)
	box(c, 0, 0.25, 0, 8.4, 0.3, 8.4, c.S)
	box(c, 0, 0.25, -4.55, 1.2, 0.3, 0.7, c.P)
	box(c, 0, 0.55, 0, 7.2, 1, 7.2, c.P)
	box(c, 0, 1.55, 0, 5.6, 1.1, 5.6, c.P)
	box(c, 0, 2.65, 0, 4, 1.2, 4, c.P)
	wedge(c, CFrame.new(0, 0.55 + 1.65, -3.1), V(1, 3.3, 2.2), c.A)
	local function lotus(x: number, z: number, base: number, tiers: number)
		local y = 3.85
		box(c, x, y, z, base, base * 0.8, base, c.P)
		y += base * 0.8
		for k = 1, tiers do
			local w = base * (1 - k / (tiers + 1.5))
			local h = base * 0.55
			box(c, x, y, z, w, h, w, c.P)
			y += h
		end
		ball(c, x, y + 0.1, z, base * 0.28, c.A)
	end
	lotus(0, 0, 1.8, 4)
	for _, s in CORNERS do
		lotus(s[1] * 1.35, s[2] * 1.35, 1.2, 3)
	end
	plant(c, -3.9, 0.55, -3.9, 1.4, 1.1, LEAF)
	plant(c, 3.9, 0.55, -3.9, 1.4, 1.1, LEAF)
end

-- 스핑크스: 엎드린 사자 몸 + 앞발 + 사람 머리(네메스 두건, 파란 줄무늬)
function BUILDERS.sphinx(c)
	box(c, 0, 0, 0, 9.8, 0.3, 7, c.S)
	local y = 0.3
	box(c, 0, y, 1.5, 2.8, 1.9, 5.4, c.P)
	cyl(c, CFrame.new(0, 2, 1.6) * ALONG_Z, 5, 2.8, c.P)
	ball(c, -1, y + 1.4, 3.2, 2.2, c.P)
	ball(c, 1, y + 1.4, 3.2, 2.2, c.P)
	box(c, 0, y, -1.9, 2.6, 3.1, 1.6, c.P)
	box(c, -0.85, y, -3.5, 0.8, 0.7, 2.6, c.P)
	box(c, 0.85, y, -3.5, 0.8, 0.7, 2.6, c.P)
	box(c, 0, 3.3, -1.95, 1.5, 1.9, 1.5, c.P)
	box(c, 0, 3.6, -1.6, 2.2, 2, 1.5, c.S)
	box(c, -0.95, 2.6, -2.75, 0.5, 1.6, 0.6, c.S)
	box(c, 0.95, 2.6, -2.75, 0.5, 1.6, 0.6, c.S)
	for _, sx in { -1, 1 } do
		box(c, sx * 1.12, 3.9, -1.6, 0.05, 0.25, 1.4, c.A)
		box(c, sx * 1.12, 4.5, -1.6, 0.05, 0.25, 1.4, c.A)
		box(c, sx * 0.35, 4.45, -2.72, 0.3, 0.15, 0.08, DARK)
	end
	box(c, 1.55, y, 2.8, 0.3, 0.3, 2.4, c.P)
end

-- 만리장성: 초록 봉우리 두 개를 넘어 지그재그로 이어지는 성벽(앞쪽 성가퀴, 뒤쪽 여장) + 봉우리 망루 + 골짜기 초소
function BUILDERS.wall(c)
	local ground = 0.3
	box(c, 0, 0, 0, 9.8, ground, 9.8, mix(c.S, WHITE, 0.25), Mat.Grass)
	local path = {
		V(-3.6, ground, -2),
		V(-1.9, 2.4, 0.2),
		V(0.1, ground, -1),
		V(2.2, 3, 1.4),
		V(3.7, ground, -0.8),
	}
	local dark = mix(c.P, BLACK, 0.2)
	for k = 1, #path - 1 do
		local p1, p2 = path[k], path[k + 1]
		-- 성벽 아래 비탈(쐐기): 높은 면이 봉우리 쪽
		local high, low = p2, p1
		if p1.Y > p2.Y then
			high, low = p1, p2
		end
		local flat = V(high.X - low.X, 0, high.Z - low.Z)
		local rise = high.Y - ground
		local mid = V((high.X + low.X) / 2, ground + rise / 2, (high.Z + low.Z) / 2)
		wedge(c, CFrame.lookAt(mid, mid - flat), V(2.8, rise, flat.Magnitude), c.S, Mat.Grass)
		-- 성벽 몸체 + 뒤쪽 여장 + 앞쪽 성가퀴 3개 (경로가 +X 로 가므로 로컬 -X 가 정면)
		local cf = CFrame.lookAt((p1 + p2) / 2, p2)
		local length = (p2 - p1).Magnitude + 0.3
		block(c, cf * CFrame.new(0, 0.5, 0), V(1.1, 1, length), c.P)
		block(c, cf * CFrame.new(0.46, 1.15, 0), V(0.18, 0.3, length), dark)
		for _, t in { -1, 0, 1 } do
			block(c, cf * CFrame.new(-0.46, 1.2, t * length / 3.2), V(0.18, 0.4, 0.45), dark)
		end
	end
	-- 봉우리 망루(깃발) + 골짜기 초소
	for _, k in { 2, 4 } do
		local p = path[k]
		box(c, p.X, p.Y - 0.3, p.Z, 1.7, 2, 1.7, c.P)
		box(c, p.X, p.Y + 1.7, p.Z, 2, 0.35, 2, dark)
		col(c, p.X + 0.6, p.Y + 2.05, p.Z + 0.6, 1.2, 0.1, DARK)
		box(c, p.X + 0.9, p.Y + 2.8, p.Z + 0.6, 0.6, 0.4, 0.05, c.A)
	end
	box(c, path[3].X, ground, path[3].Z, 1.4, 1.5, 1.4, c.P)
	box(c, path[3].X, ground + 1.5, path[3].Z, 1.6, 0.3, 1.6, dark)
	ball(c, -3.6, 0.9, 2.8, 1.2, LEAF, Mat.Grass)
	ball(c, 3.7, 0.9, 3.4, 1.3, LEAF, Mat.Grass)
	ball(c, 1, 0.8, -3.8, 1, LEAF, Mat.Grass)
end

-- 기자 피라미드: 모래 바닥 + 크기가 다른 계단식 피라미드 3개(금빛 꼭대기) + 야자수
function BUILDERS.pyramid(c)
	box(c, 0, 0, 0, 9.8, 0.3, 9.8, c.S, Mat.Sand)
	local top = stepped(c, -2.4, 1.4, 0.3, 4.8, 3.9, 8, c.P)
	box(c, -2.4, top, 1.4, 0.4, 0.3, 0.4, c.A, Mat.Neon)
	top = stepped(c, 2.1, 0.9, 0.3, 4.2, 3.4, 7, c.P)
	box(c, 2.1, top, 0.9, 0.35, 0.3, 0.35, c.A, Mat.Neon)
	stepped(c, 0.4, -3.3, 0.3, 2.6, 2.1, 5, mix(c.P, c.S, 0.5))
	plant(c, -3.9, 0.3, -2.4, 1.6, 1.1, LEAF)
	plant(c, -2.9, 0.3, -3.8, 1.2, 0.9, LEAF)
end

-- 치첸이트사 / 엘도라도: 9단 계단 피라미드 + 사면 계단 + 꼭대기 신전 (+ 불가사의 등급은 황금 태양)
function BUILDERS.steps(c)
	box(c, 0, 0, 0, 9.8, 0.25, 9.8, c.S, Mat.Grass)
	local y = 0.25
	for i = 0, 8 do
		local w = 7.8 - i * 0.55
		box(c, 0, y, 0, w, 0.72, w, c.P)
		y += 0.72
	end
	local rise = y - 0.25
	for i = 0, 3 do
		local rot = CFrame.Angles(0, i * PI / 2, 0)
		wedge(c, rot * CFrame.new(0, 0.25 + rise / 2, -3.15), V(1.4, rise, 2.9), c.A)
	end
	box(c, -0.85, 0.25, -4.45, 0.35, 0.5, 0.35, c.A)
	box(c, 0.85, 0.25, -4.45, 0.35, 0.5, 0.35, c.A)
	box(c, 0, y, 0, 2.6, 1.7, 2.6, c.P)
	box(c, 0, y + 1.7, 0, 3, 0.35, 3, c.P)
	box(c, 0, y, -1.28, 1, 1.1, 0.1, DARK)
	box(c, 0, y, 1.28, 1, 1.1, 0.1, DARK)
	for _, s in CORNERS do
		plant(c, s[1] * 4.3, 0.25, s[2] * 4.3, 1, 1.2, c.S)
	end
	if c.grand then
		cyl(c, CFrame.new(0, y + 3.6, 0) * ALONG_Z, 0.3, 2.4, c.A, Mat.Neon)
		for _, s in CORNERS do
			ball(c, s[1] * 1.3, y + 0.35, s[2] * 1.3, 0.5, c.A, Mat.Neon)
		end
	end
end

-- 마추픽추: 앞으로 내려가는 계단식 밭 + 뒤쪽의 뾰족한 와이나픽추 봉우리 + 돌집 유적
function BUILDERS.terraces(c)
	box(c, 0, 0, 0, 9.8, 0.25, 9.8, mix(c.S, BLACK, 0.2), Mat.Grass)
	for i = 0, 4 do
		local top = 3.4 - i * 0.65
		local front = -0.6 - i * 0.95
		local depth = 4.7 - front
		local w = 9.2 - i * 0.6
		local z = (front + 4.7) / 2
		box(c, 0, 0.25, z, w, top - 0.45, depth, c.P)
		box(c, 0, top - 0.2, z, w, 0.2, depth, c.S, Mat.Grass)
	end
	-- 와이나픽추: 조금씩 비틀어 쌓은 바위 덩어리로 만든 가파른 봉우리(위로 갈수록 바위색)
	local crags = {
		{ 3.8, 3, 3.4, 0.3 },
		{ 3, 2.7, 2.8, -0.35 },
		{ 2.2, 2.5, 2.1, 0.55 },
		{ 1.4, 2, 1.4, -0.2 },
		{ 0.7, 1, 0.7, 0.4 },
	}
	local y = 3.2
	for k, crag in crags do
		local color = mix(c.S, c.P, (k - 1) / 4)
		local cf = CFrame.new(2.2 + k * 0.1, y + crag[2] / 2, 2.3 + k * 0.05) * CFrame.Angles(0.06, crag[4], -0.05)
		block(c, cf, V(crag[1], crag[2], crag[3]), color, if k < 4 then Mat.Grass else nil)
		y += crag[2] * 0.85
	end
	box(c, -3.2, 3.4, 0.6, 1.6, 0.8, 1.2, c.P)
	box(c, -1.4, 3.4, 1.5, 1.2, 0.9, 1.6, c.P)
	box(c, -3, 3.4, 3.3, 1.8, 1, 1.4, c.P)
	box(c, -0.6, 3.4, 3.8, 1, 0.7, 1, c.P)
	box(c, -1.2, 3.4, -0.1, 1.3, 0.9, 1, c.P)
	gable(c, -1.2, 4.3, -0.1, 1.5, 1.2, 0.7, rgb(180, 150, 90))
end

-- 페트라(알카즈네): 붉은 절벽 + 협곡 벽 + 바위를 깎은 2층 신전 정면(기둥, 박공, 원형 정자)
function BUILDERS.facade(c)
	box(c, 0, 0, 0, 9.8, 0.25, 9.8, mix(c.P, SAND, 0.6), Mat.Sand)
	box(c, 0, 0.25, 3.2, 9.8, 14, 3.2, c.S)
	block(c, CFrame.new(-2.5, 14.6, 3.4) * CFrame.Angles(0, 0, 0.3), V(4.2, 2.2, 2.6), c.S)
	block(c, CFrame.new(2.6, 14.9, 3) * CFrame.Angles(0.2, 0, -0.25), V(3.6, 2.6, 2.4), c.S)
	box(c, -4.35, 0.25, 0.5, 1.1, 11, 2.2, c.S)
	box(c, 4.35, 0.25, 0.5, 1.1, 12, 2.2, c.S)
	-- 아래층: 기둥 6개 + 엔타블러처 + 박공 + 입구
	box(c, 0, 0.25, 1.1, 6.6, 0.45, 1.3, c.P)
	for k = 0, 5 do
		col(c, -2.75 + k * 1.1, 0.7, 0.85, 4.3, 0.55, c.P)
	end
	box(c, 0, 5, 1, 6.8, 0.7, 1.2, c.P)
	wedge(c, CFrame.new(-1.15, 6.3, 1) * CFrame.Angles(0, PI / 2, 0), V(1, 1.2, 2.3), c.P)
	wedge(c, CFrame.new(1.15, 6.3, 1) * CFrame.Angles(0, -PI / 2, 0), V(1, 1.2, 2.3), c.P)
	box(c, 0, 0.7, 1.57, 1.3, 2.6, 0.06, DARK)
	-- 위층: 양쪽 누각(반쪽 박공) + 가운데 원형 정자와 항아리
	box(c, 0, 6.9, 1, 6.8, 0.4, 1.2, c.P)
	for _, sx in { -1, 1 } do
		box(c, sx * 2.6, 7.3, 1, 1.6, 3, 1, c.P)
		wedge(c, CFrame.new(sx * 2.6, 10.7, 1) * CFrame.Angles(0, -sx * PI / 2, 0), V(1, 0.8, 1.6), c.P)
	end
	col(c, 0, 7.3, 1, 3.2, 1.9, c.P)
	col(c, 0, 10.5, 1, 0.35, 2.3, c.P)
	col(c, 0, 10.85, 1, 0.8, 1.4, c.P)
	ball(c, 0, 12, 1, 0.7, c.A)
end

-- 모아이: 잔디 + 뒤쪽 바다 + 제단(아후) 위에 긴 얼굴의 석상 5개(일부는 붉은 모자 푸카오)
function BUILDERS.moai(c)
	box(c, 0, 0, -0.95, 9.8, 0.3, 7.9, c.S, Mat.Grass)
	box(c, 0, 0, 3.95, 9.8, 0.2, 1.9, WATER, Mat.Glass, 0.1)
	box(c, 0, 0.3, 1.2, 9.6, 0.8, 2.2, mix(c.P, WHITE, 0.15))
	local xs = { -3.7, -1.85, 0, 1.85, 3.7 }
	local scales = { 0.9, 1, 1.12, 1, 0.92 }
	for k, x in xs do
		local s = scales[k]
		local y = 1.1
		box(c, x, y, 1.2, 1.3 * s, 1.5 * s, s, c.P)
		local headY = y + 1.5 * s
		local depth = 1.05 * s
		local front = 1.25 - depth / 2
		box(c, x, headY, 1.25, 1.15 * s, 2.3 * s, depth, c.P)
		box(c, x, headY + 1.35 * s, front - 0.1, 1.2 * s, 0.35 * s, 0.35 * s, c.P)
		wedge(c, CFrame.new(x, headY + 0.85 * s, front - 0.2 * s), V(0.35 * s, 0.9 * s, 0.4 * s), c.P)
		for _, sx in { -1, 1 } do
			box(c, x + sx * (0.575 * s + 0.05), headY + 0.8 * s, 1.25, 0.12, 1 * s, 0.35 * s, c.P)
		end
		if k % 2 == 1 then
			col(c, x, headY + 2.3 * s, 1.25, 0.55 * s, s, c.A)
		end
	end
end

-- 스톤헨지: 둥근 잔디 + 상인방을 얹은 바깥 원(일부 무너짐) + 안쪽 말굽 모양 삼석탑 5개 + 제단석 + 힐스톤
function BUILDERS.stones(c)
	col(c, 0, 0, 0, 0.25, 9.8, c.S, Mat.Grass)
	local y = 0.25
	local r = 3.9
	local count = 12
	local missing = { [4] = true, [9] = true }
	for i = 0, count - 1 do
		if not missing[i] then
			block(c, CFrame.Angles(0, i / count * TAU, 0) * CFrame.new(0, y + 1.1, -r), V(0.75, 2.2, 0.5), c.P)
		end
	end
	local chord = 2 * r * math.sin(PI / count) + 0.5
	for _, i in { 0, 1, 2, 5, 6, 10, 11 } do
		local cf = CFrame.Angles(0, (i + 0.5) / count * TAU, 0) * CFrame.new(0, y + 2.4, -r * math.cos(PI / count))
		block(c, cf, V(chord, 0.4, 0.5), c.P)
	end
	block(c, CFrame.Angles(0, 4 / count * TAU, 0) * CFrame.new(0, y + 0.25, -r), V(2, 0.5, 0.75), c.P)
	-- 안쪽 말굽(정면 -Z 쪽이 열림)
	for k, angle in { PI, PI - 0.9, PI + 0.9, PI - 1.8, PI + 1.8 } do
		local h = if k == 1 then 3.2 elseif k <= 3 then 2.8 else 2.5
		local frame = CFrame.Angles(0, angle, 0) * CFrame.new(0, y, -2)
		block(c, frame * CFrame.new(-0.45, h / 2, 0), V(0.55, h, 0.5), c.P)
		block(c, frame * CFrame.new(0.45, h / 2, 0), V(0.55, h, 0.5), c.P)
		block(c, frame * CFrame.new(0, h + 0.2, 0), V(1.6, 0.4, 0.55), c.P)
	end
	box(c, 0, y, 0.6, 1.4, 0.25, 0.5, mix(c.P, BLACK, 0.2))
	block(c, CFrame.new(0.9, y + 0.9, -4.6) * CFrame.Angles(0, 0, 0.12), V(0.7, 1.8, 0.5), c.P)
end

-- 바빌론 공중정원: 4단 테라스(그늘진 회랑 띠) + 초록 정원 + 늘어진 덩굴 + 정면 폭포 + 연못
function BUILDERS.gardens(c)
	box(c, 0, 0, 0, 9.8, 0.3, 9.8, mix(c.P, WHITE, 0.15))
	box(c, 0, 0.3, -4.4, 4, 0.12, 0.9, c.A, Mat.Glass, 0.2)
	local sizes = { 8.2, 6.4, 4.6, 2.8 }
	local shade = mix(c.P, BLACK, 0.45)
	local y = 0.3
	for i, w in sizes do
		box(c, 0, y, 0, w, 2, w, c.P)
		box(c, 0, y + 0.5, 0, w + 0.06, 0.8, w + 0.06, shade)
		box(c, 0, y + 2, 0, w - 0.2, 0.25, w - 0.2, c.S, Mat.Grass)
		box(c, 0, y, -w / 2 - 0.08, 0.9, 2.3, 0.12, c.A, Mat.Neon, 0.35)
		if i < #sizes then
			for _, sx in { -1, 1 } do
				box(c, sx * w * 0.3, y + 0.9, -w / 2 - 0.08, 0.6, 1.35, 0.15, c.S, Mat.Grass)
				ball(c, sx * (w / 2 - 0.45), y + 2.6, -(w / 2 - 0.45), 0.9, c.S, Mat.Grass)
			end
		end
		y += 2
	end
	box(c, 0, y + 0.25, 0, 1.2, 1.2, 1.2, c.P)
	plant(c, 0.9, y + 0.25, 0.9, 1.6, 1.2, c.S)
end

-- 바벨탑: 점점 좁아지는 원통 5층(어두운 회랑 + 밝은 난간) + 층 사이를 감아 오르는 경사로 + 미완성 꼭대기
function BUILDERS.spiral(c)
	local diameters = { 9.4, 7.6, 5.8, 4, 2.4 }
	local h = 3
	local shade = mix(c.S, BLACK, 0.2)
	for k, d in diameters do
		local y = (k - 1) * h
		col(c, 0, y, 0, h, d, shade)
		col(c, 0, y + h - 0.45, 0, 0.45, d + 0.1, c.P)
		col(c, 0, y, 0, 0.5, d + 0.1, c.P)
	end
	-- 경사로: 층 k 의 윗면(난간 고리)에서 한 바퀴 돌며 다음 층 윗면까지 올라감
	for k = 1, #diameters - 1 do
		local outer, inner = diameters[k] / 2, diameters[k + 1] / 2
		local segments = 9 - k
		local r = (outer + inner) / 2 / math.cos(PI / segments)
		local base = k * h
		for j = 0, segments - 1 do
			local t1 = (j / segments + k * 0.3) * TAU
			local t2 = ((j + 1) / segments + k * 0.3) * TAU
			local p1 = V(r * math.cos(t1), base + j / segments * h, r * math.sin(t1))
			local p2 = V(r * math.cos(t2), base + (j + 1) / segments * h, r * math.sin(t2))
			local cf = CFrame.lookAt((p1 + p2) / 2, p2)
			block(c, cf * CFrame.new(0, 0.15, 0), V(0.7, 0.3, (p2 - p1).Magnitude + 0.1), c.P)
		end
	end
	local top = #diameters * h
	box(c, -0.4, top, 0.3, 1, 1.4, 0.9, c.P)
	block(c, CFrame.new(0.5, top + 0.4, -0.3) * CFrame.Angles(0, 0.4, 0.2), V(0.8, 0.8, 0.8), c.P)
end

-- 무 대륙: 가라앉는 밀림 대륙(바다 + 얕은 여울 + 두 덩어리 땅) + 가운데 계단식 석조 신전(금 지붕, 금빛 태양 원반)
--   + 금빛 화로 + 밀림 나무 + 물에 잠겨 가는 무너진 돌기둥과 돌문
local function lostContinent(c: Ctx)
	local jungle = rgb(62, 140, 70)
	col(c, 0, 0, 0, 0.3, 9.8, c.S, Mat.Glass, 0.1)
	col(c, 0, 0, 0, 0.35, 8.8, mix(c.S, WHITE, 0.3), Mat.Glass, 0.1)
	col(c, 0.3, 0, 0.5, 0.75, 7.2, c.P)
	col(c, 0.3, 0.75, 0.5, 0.2, 6.9, jungle, Mat.Grass)
	col(c, -2.5, 0, -2.2, 0.55, 3.2, c.P)
	col(c, -2.5, 0.55, -2.2, 0.15, 2.9, jungle, Mat.Grass)
	local ground = 0.95
	local tx, tz = 0.4, 0.9
	local y = ground
	for _, tier in { { 4.4, 0.8 }, { 3.5, 0.8 }, { 2.6, 0.8 }, { 1.8, 0.7 } } do
		box(c, tx, y, tz, tier[1], tier[2], tier[1], c.P)
		y += tier[2]
	end
	wedge(c, CFrame.new(tx, (ground + y) / 2, tz - 1.95), V(1, y - ground, 2.1), mix(c.P, WHITE, 0.2))
	for _, s in CORNERS do
		ball(c, tx + s[1] * 1.55, ground + 1.8, tz + s[2] * 1.55, 0.4, c.A, Mat.Neon)
	end
	box(c, tx, y, tz + 0.1, 1.3, 1, 1.2, mix(c.P, WHITE, 0.12))
	box(c, tx, y, tz - 0.51, 0.45, 0.7, 0.05, DARK)
	box(c, tx, y + 1, tz + 0.1, 1.6, 0.2, 1.5, c.A, Mat.Metal)
	box(c, tx, y + 1.2, tz + 0.1, 0.9, 0.3, 0.9, c.A, Mat.Metal)
	cyl(c, CFrame.new(tx, y + 1.95, tz + 0.1) * ALONG_Z, 0.12, 0.9, c.A, Mat.Neon)
	-- 밀림: { x, z, 줄기 높이, 잎 지름, 바닥 높이 }
	for k, t in
		{
			{ -2.6, 2.7, 1.4, 1.6, ground },
			{ 2.9, 2.8, 1.2, 1.4, ground },
			{ 3.2, -0.9, 1.6, 1.5, ground },
			{ -2.8, 0.4, 1.1, 1.3, ground },
			{ -2.6, -2.3, 1.2, 1.3, 0.7 },
			{ 2.1, -2.2, 1, 1.2, ground },
		}
	do
		plant(c, t[1], t[5], t[2], t[3], t[4], if k % 2 == 0 then LEAF else jungle)
	end
	ball(c, -1, ground + 0.15, 3.3, 1, LEAF, Mat.Grass)
	ball(c, 3.3, ground + 0.1, 1.2, 0.9, jungle, Mat.Grass)
	ball(c, -1.4, 0.8, -3, 0.8, LEAF, Mat.Grass)
	-- 물에 잠겨 가는 유적
	block(c, CFrame.new(3, 0.95, -3.1) * CFrame.Angles(0.25, 0.3, 0.35), V(0.55, 1.6, 0.55), c.P)
	col(c, 3.9, 0, -1.9, 0.9, 0.5, c.P)
	box(c, -3.9, 0, 1, 0.45, 1.5, 0.45, c.P)
	box(c, -3.9, 0, 2.2, 0.45, 1.2, 0.45, c.P)
	block(c, CFrame.new(-3.9, 1.55, 1.6) * CFrame.Angles(0.12, 0, 0), V(0.55, 0.35, 1.8), c.P)
end

-- 아틀란티스: 물과 땅이 번갈아 도는 동심원 섬 + 가운데 원형 신전(빛나는 수정 첨탑) + 흰 탑 6개 + 다리
-- (무 대륙은 밀림 + 계단식 석조 신전 버전)
function BUILDERS.island(c)
	if c.id == "mu" then
		lostContinent(c)
		return
	end
	col(c, 0, 0, 0, 0.3, 9.8, c.S, Mat.Glass, 0.1)
	col(c, 0, 0, 0, 0.55, 8.4, c.P)
	col(c, 0, 0, 0, 0.6, 6.8, c.S, Mat.Glass, 0.1)
	col(c, 0, 0, 0, 0.8, 5.4, GRASS, Mat.Grass)
	col(c, 0, 0, 0, 0.85, 4, c.S, Mat.Glass, 0.1)
	col(c, 0, 0, 0, 1.2, 2.8, c.P)
	box(c, 0, 0.6, -2.45, 0.5, 0.15, 2.3, c.P)
	col(c, 0, 1.2, 0, 0.3, 2.4, c.P)
	for i = 0, 5 do
		local angle = i * TAU / 6
		col(c, 0.9 * math.cos(angle), 1.5, 0.9 * math.sin(angle), 1.5, 0.25, c.P)
	end
	col(c, 0, 1.5, 0, 1.5, 0.9, c.A, Mat.Neon)
	col(c, 0, 3, 0, 0.3, 2.4, c.P)
	ball(c, 0, 3.3, 0, 1.9, c.P)
	col(c, 0, 4.1, 0, 2.6, 0.35, c.A, Mat.Neon)
	ball(c, 0, 6.8, 0, 0.6, c.A, Mat.Neon)
	for i = 0, 5 do
		local angle = i * TAU / 6 + PI / 6
		local x, z = 3.8 * math.cos(angle), 3.8 * math.sin(angle)
		col(c, x, 0.55, z, 1.8, 0.55, c.P)
		ball(c, x, 2.5, z, 0.45, c.A, Mat.Neon)
	end
end

-- 용궁 / 샹그릴라: 계단 기단 위 3층 전각(들린 추녀 기와지붕) + 꼭대기 보주 + 등롱 + 떠다니는 빛 구슬
function BUILDERS.pagoda(c)
	box(c, 0, 0, 0, 9.6, 0.6, 9.6, c.S)
	box(c, 0, 0.6, 0, 7.4, 0.4, 7, mix(c.P, WHITE, 0.5))
	wedge(c, CFrame.new(0, 0.5, -4.2), V(1.6, 1, 1.2), mix(c.P, WHITE, 0.5))
	box(c, 0, 1, 0, 6, 2, 5.2, c.P)
	box(c, 0, 1, -2.62, 1.4, 1.5, 0.1, DARK)
	roof(c, 0, 3, 0, 8.4, 7.2, 1.4, c.S)
	box(c, 0, 4.2, 0, 4.4, 1.9, 3.8, c.P)
	roof(c, 0, 6.1, 0, 6.6, 5.6, 1.3, c.S)
	box(c, 0, 7.2, 0, 3, 1.7, 2.6, c.P)
	roof(c, 0, 8.9, 0, 4.8, 4, 1.2, c.S)
	col(c, 0, 10.3, 0, 1.4, 0.3, c.A, Mat.Metal)
	ball(c, 0, 12, 0, 0.7, c.A, Mat.Neon)
	for _, sx in { -1, 1 } do
		col(c, sx * 4.2, 0.6, -4.2, 1.2, 0.2, DARK)
		ball(c, sx * 4.2, 2, -4.2, 0.5, c.A, Mat.Neon)
	end
	ball(c, -4.1, 7.5, 1.5, 0.9, c.A, Mat.Glass, 0.5)
	ball(c, 4.2, 9.2, -0.8, 0.7, c.A, Mat.Glass, 0.5)
	ball(c, 3.6, 11.4, 2.4, 0.6, c.A, Mat.Glass, 0.5)
end

-- 하늘섬: 땅에 닿지 않고 떠 있는 바위섬(아래로 뾰족) + 잔디 + 나무 + 연못과 폭포 + 구름 + 작은 신전
function BUILDERS.skyisland(c)
	local rock = Mat.Slate
	col(c, 0, 7.2, 0, 1.2, 9, c.S, rock)
	col(c, 0.3, 5.8, -0.2, 1.4, 7, c.S, rock)
	col(c, -0.2, 4.4, 0.3, 1.4, 5, c.S, rock)
	col(c, 0.2, 3.1, 0.1, 1.3, 3, c.S, rock)
	ball(c, 0.1, 2.8, 0.1, 1.6, c.S, rock)
	ball(c, -2.6, 6.8, 1.6, 2.4, c.S, rock)
	ball(c, 2.4, 6.2, -1.8, 2.2, c.S, rock)
	col(c, 0, 8.4, 0, 0.5, 9.4, c.P)
	col(c, 1.8, 8.9, 1.6, 2.8, 0.6, WOOD, Mat.Wood)
	ball(c, 1.8, 12.4, 1.6, 2.6, mix(c.P, BLACK, 0.25))
	ball(c, 1, 11.8, 2.3, 1.8, mix(c.P, BLACK, 0.15))
	ball(c, 2.6, 11.9, 1, 1.7, mix(c.P, BLACK, 0.15))
	col(c, -1.2, 8.85, -2.6, 0.12, 2.2, WATER, Mat.Glass, 0.15)
	box(c, -1.2, 8.85, -4.1, 0.9, 0.12, 1.4, WATER, Mat.Glass, 0.15)
	box(c, -1.2, 2.4, -4.75, 1, 6.55, 0.2, c.A, Mat.Neon, 0.35)
	ball(c, -1.2, 2.4, -4.3, 1.2, c.A, Mat.SmoothPlastic, 0.4)
	ball(c, -3, 3.4, -1.5, 2, CLOUD, Mat.SmoothPlastic, 0.2)
	ball(c, 3, 4, 1.8, 2.4, CLOUD, Mat.SmoothPlastic, 0.2)
	ball(c, 0.6, 2.2, 2.6, 1.8, CLOUD, Mat.SmoothPlastic, 0.2)
	box(c, -2.9, 8.9, 1.2, 0.35, 1.6, 0.35, CLOUD, Mat.Marble)
	box(c, -1.7, 8.9, 1.2, 0.35, 1.6, 0.35, CLOUD, Mat.Marble)
	box(c, -2.3, 10.5, 1.2, 1.7, 0.3, 0.6, CLOUD, Mat.Marble)
	ball(c, 4.2, 6.6, -2.8, 0.9, c.S, rock)
	ball(c, -4.2, 9.8, -0.8, 0.7, c.S, rock)
end

-- 세계수: 뻗은 뿌리 + 굵은 줄기 + 가지 + 잎 공 캐노피 + 빛나는 열매
function BUILDERS.tree(c)
	col(c, 0, 0, 0, 0.3, 9.6, mix(c.S, BLACK, 0.4), Mat.Grass)
	for i = 0, 5 do
		local angle = i * TAU / 6 + 0.3
		local dir = V(math.cos(angle), 0, math.sin(angle))
		beam(c, dir * 0.9 + V(0, 2.2, 0), dir * 4.1 + V(0, 0.45, 0), 0.85, c.P)
	end
	col(c, 0, 0.3, 0, 5.2, 3, c.P)
	col(c, 0, 5.5, 0, 3, 2.4, c.P)
	col(c, 0, 8.5, 0, 2.5, 1.8, c.P)
	local leaves = {}
	for i = 0, 4 do
		local angle = i * TAU / 5 + 0.2
		local dir = V(math.cos(angle), 0, math.sin(angle))
		beam(c, V(0, 9.3, 0), dir * 2.8 + V(0, 12.4, 0), 0.8, c.P)
		table.insert(leaves, dir * 2.9 + V(0, 13.2, 0))
	end
	ball(c, 0, 15, 0, 7, c.S, Mat.Grass)
	ball(c, 0, 18.6, 0, 4.4, c.S, Mat.Grass)
	for _, p in leaves do
		ball(c, p.X, p.Y, p.Z, 3.8, mix(c.S, BLACK, 0.12), Mat.Grass)
	end
	-- 열매: 잎 공 표면 바로 바깥
	local fruits = {
		V(0, 15, 0) + V(-0.6, 0.3, -1).Unit * 3.5,
		V(0, 15, 0) + V(0.8, 0.6, -0.4).Unit * 3.5,
		V(0, 18.6, 0) + V(-0.3, 0.5, -1).Unit * 2.2,
		leaves[1] + V(0.2, 0.4, -1).Unit * 1.9,
		leaves[2] + V(-0.4, 0.2, -1).Unit * 1.9,
		leaves[3] + V(-1, 0.3, -0.2).Unit * 1.9,
		leaves[4] + V(0.3, -0.2, -1).Unit * 1.9,
	}
	for _, p in fruits do
		ball(c, p.X, p.Y, p.Z, 0.7, c.A, Mat.Neon)
	end
	col(c, 0, 0.3, 0, 0.08, 6, c.A, Mat.Neon, 0.5)
end

-- 하버 브리지: 항구 물 + 양쪽 기슭 + 끝마다 화강암 탑문 2개 + 나란한 강철 아치 두 줄(끝은 두껍고 꼭대기는 얇음)
--   + 아치를 꿰뚫고 지나는 도로 상판 + 아치에 매단 멜대 + 아치 사이 가새
--   (오페라하우스는 건물 이미지 상표 문제로 넣지 않음)
function BUILDERS.bridge(c)
	local granite = rgb(208, 196, 172)
	local deckY, deckTop = 2.2, 2.55
	box(c, 0, 0, 0, 9.8, 0.25, 9.8, WATER, Mat.Glass, 0.1)
	for _, sx in { -1, 1 } do
		box(c, sx * 4.2, 0, 0, 1.4, 0.6, 9.8, GRASS, Mat.Grass)
		box(c, sx * 4.3, 0.6, 0, 1.2, deckY - 0.6, 4.4, granite, Mat.Granite)
		for _, sz in { -1, 1 } do
			box(c, sx * 4.3, deckY, sz * 1.75, 1.1, 1.85, 0.9, granite, Mat.Granite)
			box(c, sx * 4.3, deckY + 1.85, sz * 1.75, 0.8, 0.4, 0.65, granite, Mat.Granite)
		end
	end
	box(c, 0, deckY, 0, 9.8, deckTop - deckY, 2.6, c.S)
	-- 아치: 위·아래 현(포물선) 사이를 비스듬한 토막으로 채움. 발은 탑문 아래 기슭(x = ±span)
	local span = 3.7
	local function curve(x: number, crown: number, foot: number): number
		local u = x / span
		return crown - (crown - foot) * u * u
	end
	local function upper(x: number): number
		return curve(x, 5.9, 3.3)
	end
	local function lower(x: number): number
		return curve(x, 5.3, 0.6)
	end
	local function middle(x: number): number
		return (upper(x) + lower(x)) / 2
	end
	local segments = 7
	for _, sz in { -1, 1 } do
		for k = 0, segments - 1 do
			local x1 = span * (2 * k / segments - 1)
			local x2 = span * (2 * (k + 1) / segments - 1)
			local p1, p2 = V(x1, middle(x1), sz), V(x2, middle(x2), sz)
			local along = p2 - p1
			local depth = (upper(x1) - lower(x1) + upper(x2) - lower(x2)) / 2 * math.abs(along.X) / along.Magnitude
			block(c, CFrame.lookAt((p1 + p2) / 2, p2), V(0.35, depth, along.Magnitude + depth * 0.4), c.P)
		end
		-- 멜대(아치 아래 현에서 상판까지)
		for _, x in { -2.1, -0.8, 0.8, 2.1 } do
			box(c, x, deckTop, sz, 0.12, lower(x) - deckTop + 0.1, 0.12, c.S)
		end
	end
	for _, x in { -2.4, 0, 2.4 } do
		beam(c, V(x, middle(x), -1), V(x, middle(x), 1), 0.2, c.S)
	end
	beam(c, V(-2.4, middle(-2.4), -1), V(0, middle(0), 1), 0.16, c.S)
	beam(c, V(2.4, middle(2.4), -1), V(0, middle(0), 1), 0.16, c.S)
end

-- 12사도 바위: 바다 + 왼쪽(-X)을 두른 사암 절벽(덤불 윗면, 아래가 젖어 어두움) + 절벽 밑 모래 해변과 물거품
--   + 탁 트인 바다에 흩어져 솟은 사암 기둥들(밑동은 파도에 파먹히고 위로 갈수록 좁고 비틀림) + 무너진 기둥 밑동
function BUILDERS.seastacks(c)
	box(c, 0, 0, 0, 9.8, 0.3, 9.8, c.S, Mat.Glass, 0.1)
	local wet = mix(c.P, BLACK, 0.22)
	local pale = mix(c.P, WHITE, 0.15)
	local cliff = mix(c.P, ROCK, 0.25)
	local scrub = mix(LEAF, c.P, 0.2)
	-- 절벽: { x, z, 가로, 깊이, 높이 }
	local cliffs = {
		{ -4, 0.9, 1.8, 8, 5.2 },
		{ -2.4, 4.1, 1.6, 1.6, 4.6 },
		{ -4.2, -4, 1.4, 1.8, 2.8 },
	}
	for _, cl in cliffs do
		local x, z, w, d, h = cl[1], cl[2], cl[3], cl[4], cl[5]
		box(c, x, 0, z, w, h * 0.25, d, wet)
		box(c, x, h * 0.25, z, w - 0.2, h * 0.75, d - 0.2, cliff)
		box(c, x, h, z, w - 0.3, 0.3, d - 0.3, scrub, Mat.Grass)
	end
	box(c, -2.75, 0.3, 0.4, 0.7, 0.12, 5.2, SAND, Mat.Sand)
	box(c, -2.3, 0.3, 0.4, 0.3, 0.1, 5.2, c.A, Mat.SmoothPlastic, 0.15)
	-- 바위 기둥: 밑동(파먹혀 가늘고 젖음) → 몸통(가장 넓음) → 꼭대기(좁고 비틀림)
	local function stack(x: number, z: number, h: number, w: number, twist: number)
		col(c, x, 0.3, z, 0.1, w * 1.35, c.A, Mat.SmoothPlastic, 0.2)
		local y = 0.3
		block(c, CFrame.new(x, y + h * 0.12, z) * CFrame.Angles(0, twist, 0), V(w * 0.7, h * 0.24 + 0.1, w * 0.68), wet)
		y += h * 0.24
		local cf = CFrame.new(x + w * 0.05, y + h * 0.2, z - w * 0.04) * CFrame.Angles(0, twist + 0.3, 0.035)
		block(c, cf, V(w, h * 0.42, w * 0.88), c.P)
		y += h * 0.4
		cf = CFrame.new(x - w * 0.06, y + h * 0.17, z + w * 0.05) * CFrame.Angles(0.04, twist - 0.25, -0.04)
		block(c, cf, V(w * 0.66, h * 0.34, w * 0.6), pale)
	end
	stack(-1.3, 2.5, 5.4, 1.2, 0.2)
	stack(0.6, 3.6, 4.2, 1.05, -0.4)
	stack(0, 0.5, 6.4, 1.3, 0.6)
	stack(2.4, 1.7, 4.8, 1.1, 0.1)
	stack(1.7, -1.6, 5.6, 1.2, -0.3)
	stack(-1.4, -1.7, 3.4, 1, 0.9)
	stack(3.4, -3.5, 3, 1, 0.4)
	-- 무너진 기둥(밑동만)
	col(c, 0, 0.3, -3.6, 0.1, 1.6, c.A, Mat.SmoothPlastic, 0.2)
	block(c, CFrame.new(0, 0.75, -3.6) * CFrame.Angles(0.1, 0.4, 0.08), V(1, 1, 0.9), wet)
end

-- 그레이트 배리어 리프: 짙은 바다 + 밝은 청록 산호 여울 + 가지 산호(분홍·주황) + 뇌 산호(노랑·보라 공)
--   + 탁자 산호 + 부채 산호 + 관 산호 + 헤엄치는 바다거북. 낮고 넓게(위에서 잘 보이도록)
function BUILDERS.reef(c)
	local purple = rgb(150, 90, 215)
	local orange = rgb(255, 140, 60)
	local tableColor = rgb(110, 205, 170)
	box(c, 0, 0, 0, 9.8, 0.3, 9.8, mix(c.S, rgb(20, 60, 140), 0.45), Mat.Glass, 0.1)
	local shallow = mix(c.S, WHITE, 0.4)
	col(c, -1.4, 0.3, 1.2, 0.15, 6, shallow, Mat.Sand)
	col(c, 2.2, 0.3, -1.4, 0.15, 4.6, shallow, Mat.Sand)
	col(c, -2.6, 0.3, -2.4, 0.15, 3, shallow, Mat.Sand)
	local ground = 0.45
	-- 가지 산호: 밑동에서 위·바깥으로 뻗는 가지 + 동그란 끝
	local function branching(x: number, z: number, h: number, color: Color3, count: number, turn: number)
		for k = 0, count - 1 do
			local angle = k / count * TAU + turn
			local lean = if k % 2 == 0 then 0.7 else 0.45
			local rise = if k % 2 == 0 then 0.8 else 1
			local tip = V(x + math.cos(angle) * h * lean, ground + h * rise, z + math.sin(angle) * h * lean)
			beam(c, V(x, ground - 0.1, z), tip, 0.22, color)
			ball(c, tip.X, tip.Y, tip.Z, 0.3, color)
		end
	end
	branching(-2.4, 2.2, 1.8, c.P, 4, 0.3)
	branching(2.9, 0, 1.5, orange, 3, 0.9)
	branching(-2.7, -2.5, 1.3, c.P, 3, 0.5)
	-- 뇌 산호(바닥에 얹힌 공): { x, z, 지름, 색 }
	for _, b in
		{
			{ -0.3, 2.9, 1.6, c.A },
			{ -1.2, 0.2, 1, purple },
			{ 1.4, -2.6, 1.3, purple },
			{ 3.4, -2.4, 1.1, mix(c.P, WHITE, 0.3) },
			{ -3.5, -0.4, 1.2, c.A },
		}
	do
		ball(c, b[1], b[3] / 2, b[2], b[3], b[4])
	end
	-- 탁자 산호(줄기 + 넓은 판)
	col(c, 0.5, ground, 1.2, 0.7, 0.25, tableColor)
	col(c, 0.5, ground + 0.7, 1.2, 0.15, 1.7, tableColor)
	col(c, 1.2, ground, -0.6, 0.45, 0.2, tableColor)
	col(c, 1.2, ground + 0.45, -0.6, 0.12, 1.2, tableColor)
	-- 부채 산호(바닥에 반쯤 묻힌 얇은 원판)
	cyl(c, CFrame.new(-3.6, 0.75, 3.5) * CFrame.Angles(0, 0.4, 0) * ALONG_Z, 0.08, 1.5, purple)
	cyl(c, CFrame.new(3.8, 0.6, 1.6) * CFrame.Angles(0, -1.2, 0) * ALONG_Z, 0.08, 1.2, orange)
	-- 관 산호
	for k, t in { { -3.9, 0.9, 0.9 }, { -3.5, 1.4, 0.6 }, { -4.1, 1.6, 0.7 } } do
		col(c, t[1], ground - 0.1, t[2], t[3] + 0.1, 0.35 - k * 0.03, orange)
	end
	-- 바다거북(앞쪽 깊은 물 위를 헤엄침, 정면을 봄)
	local turtle = CFrame.new(0.9, 1.2, -3.7) * CFrame.Angles(0, 0.35, 0)
	local shell = rgb(125, 105, 60)
	local skin = rgb(175, 170, 115)
	cyl(c, turtle * UPRIGHT, 0.25, 1.5, shell)
	cyl(c, turtle * CFrame.new(0, 0.2, 0) * UPRIGHT, 0.2, 1.05, mix(shell, BLACK, 0.15))
	local head = turtle * V(0, 0.05, -0.95)
	ball(c, head.X, head.Y, head.Z, 0.5, skin)
	for _, sx in { -1, 1 } do
		block(c, turtle * CFrame.new(sx * 0.95, 0, -0.35) * CFrame.Angles(0, sx * 0.5, 0), V(0.9, 0.08, 0.35), skin)
		block(c, turtle * CFrame.new(sx * 0.6, 0, 0.7) * CFrame.Angles(0, -sx * 0.5, 0), V(0.45, 0.08, 0.28), skin)
	end
end

-- 난마돌: 물길 사이 인공섬들 + 가운데 큰 섬의 현무암 기둥 성벽(통나무집처럼 가로세로 엇갈려 쌓음, 정면 입구)
--   + 안쪽 단과 무덤 + 작은 섬들의 낮은 벽 + 성벽을 덮은 초록 수풀
function BUILDERS.ruins(c)
	box(c, 0, 0, 0, 9.8, 0.3, 9.8, c.S, Mat.Glass, 0.1)
	local rubble = mix(c.P, ROCK, 0.55)
	local d = 0.5 -- 현무암 기둥 굵기
	local n = 0
	-- 누운 현무암 기둥. along = "x" 또는 "z"(길이 축). 조금씩 비틀고 색을 달리해 돌기둥처럼
	local function log(x: number, y: number, z: number, length: number, along: string, diameter: number?)
		n += 1
		local cf = CFrame.new(x, y, z) * CFrame.Angles(0, (n % 3 - 1) * 0.025, 0)
		if along == "z" then
			cf *= CFrame.Angles(0, PI / 2, 0)
		end
		local color = if n % 2 == 0 then c.P else mix(c.P, ROCK, 0.18)
		cyl(c, cf, length + (n % 4 - 1.5) * 0.08, (diameter or d) * (0.92 + n % 3 * 0.06), color)
	end
	-- 가운데 큰 섬 + 성벽(앞뒤 기둥 층과 옆 기둥 층이 반 단씩 엇갈림)
	local cx, cz = 0.6, 0.8
	local hx, hz = 2.3, 2.1
	local base = 0.6
	box(c, cx, 0, cz, 6, base, 5.8, rubble)
	for k = 0, 3 do
		local y = base + d / 2 + k * d
		for _, sz in { -1, 1 } do
			if sz == -1 and k < 2 then
				for _, sx in { -1, 1 } do
					log(cx + sx * 1.675, y, cz - hz, 2.15, "x")
				end
			else
				log(cx, y, cz + sz * hz, 2 * hx + 0.7, "x")
			end
		end
		for _, sx in { -1, 1 } do
			log(cx + sx * hx, y + d / 2, cz, 2 * hz + 0.7, "z")
		end
	end
	box(c, cx, base, cz + 0.4, 2.6, 0.6, 2.2, mix(c.P, BLACK, 0.12))
	box(c, cx, base + 0.6, cz + 0.4, 1.1, 0.35, 1.1, c.P)
	plant(c, cx + 1.4, base, cz + 1.3, 2.3, 1.8, c.A)
	plant(c, cx - 1.3, base, cz + 1.2, 1.7, 1.3, mix(c.A, LEAF, 0.4))
	ball(c, cx - hx, base + 4 * d + 0.1, cz - hz, 0.9, c.A, Mat.Grass)
	ball(c, cx + 2.8, base + 0.1, cz - 2.3, 0.8, c.A, Mat.Grass)
	ball(c, cx - 2.8, base + 0.1, cz + 2.4, 0.9, c.A, Mat.Grass)
	-- 작은 섬들: { x, z, 가로, 세로 }
	local islets = {
		{ -3.8, -3.7, 1.9, 1.8 },
		{ -3.9, 1.6, 1.6, 2.6 },
		{ 2, -3.9, 2.6, 1.5 },
	}
	for k, islet in islets do
		local x, z, w, depth = islet[1], islet[2], islet[3], islet[4]
		box(c, x, 0, z, w, 0.45, depth, rubble)
		log(x, 0.45 + 0.2, z - depth / 2 + 0.25, w + 0.1, "x", 0.4)
		log(x - w / 2 + 0.25, 0.45 + 0.4, z, depth + 0.1, "z", 0.4)
		if k == 2 then
			plant(c, x + 0.3, 0.45, z + 0.5, 1.3, 1.2, c.A)
		else
			ball(c, x + 0.35, 0.75, z + 0.3, 0.9, c.A, Mat.Grass)
		end
	end
end

-- 지구본 땅 표(GlobeLand.luau, tools/model_preview/globe_land.py 가 진짜 세계 지도로 만듦).
-- 한 줄 = { 위도, 경도, 돔 반지름(도), 색 종류[, 높이] }. 없거나 깨지면 땅 없이 바다만
local GLOBE_LAND: { { number } } = (function()
	local module = script:FindFirstChild("GlobeLand")
	if module and module:IsA("ModuleScript") then
		local ok, result = pcall(require, module)
		if ok and type(result) == "table" then
			return result :: any
		end
	end
	return {}
end)()

local GLOBE_GOLD = rgb(235, 190, 80) -- 광장 받침대 윗판(PedestalTop)과 같은 금색
-- 땅 색 종류(GlobeLand 넷째 칸): 1 눈(그린란드·남극·북극 섬·히말라야), 2 초록(명소 보조 색), 3 짙은 초록(열대림), 4 사막
local GLOBE_SNOW = rgb(244, 248, 252)
local GLOBE_TONES = {
	[1] = GLOBE_SNOW,
	[3] = rgb(44, 138, 70),
	[4] = rgb(238, 202, 122),
}
local GLOBE_MATERIALS = { [1] = Mat.Snow, [4] = Mat.Sand } -- 나머지(초록·숲)는 Grass
-- 바탕 돔 높이 = clamp(SLOPE * 지구 반지름 * 돔 반지름(라디안), MIN, MAX) — globe_land.py 와 같은 값이어야 함.
-- 낮고 넓은 돔(가라앉힌 큰 공)이라 겹친 자리의 골이 얕음. MIN 0.04 = 광장 크기(2.6배)에서 0.1 스터드
local DOME_SLOPE, DOME_MIN, DOME_MAX = 0.1, 0.04, 0.05

-- 지구본: 금색 받침 + 23.5도 기운 파란 공 + 진짜 지도를 따른 대륙(겹친 돔 공 약 140개, 해안선이 둥글게 굽이짐)
-- + 극지방 눈 + 받침 기둥에 닿는 금색 자오선 고리(32조각) + 극 축받이. 파트 약 185개
-- (광장에서는 클라이언트가 모형 전체를 매 프레임 PivotTo 로 돌리므로 파트를 더 늘리지 말 것)
-- 땅·극 돔은 그림자를 만들지 않음(지구 공 위 얇은 돔이라 보이는 그림자가 거의 없는데, 돌 때마다 그림자 계산만 늘어남)
function BUILDERS.globe(c)
	local goldDark = mix(GLOBE_GOLD, BLACK, 0.18)
	col(c, 0, 0, 0, 0.5, 4.2, goldDark, Mat.Metal)
	col(c, 0, 0.5, 0, 0.4, 2.6, GLOBE_GOLD, Mat.Metal)
	col(c, 0, 0.9, 0, 1.6, 0.6, GLOBE_GOLD, Mat.Metal)

	local radius = 4
	local center = V(0, 7, 0)
	local tilt = CFrame.new(center) * CFrame.Angles(0, 0, math.rad(23.5)) -- 북극이 -X 쪽으로 기움
	local ocean = ball(c, 0, 7, 0, radius * 2, c.P, Mat.SmoothPlastic)
	ocean.Reflectance = 0.06

	-- 위도/경도(도) → 지구 중심에서 r 떨어진 점. 경도 20도(아프리카)가 정면(-Z), 동쪽이 정면에서 볼 때 오른쪽
	local function surface(lat: number, lon: number, r: number): Vector3
		local phi, lambda = math.rad(lat), math.rad(lon - 20)
		return tilt * V(-r * math.cos(phi) * math.sin(lambda), r * math.sin(phi), -r * math.cos(phi) * math.cos(lambda))
	end
	-- 돔: 지표에서 height 만큼 솟고, 지표와 만나는 둘레가 중심에서 cap 도인 공(가라앉힌 공의 튀어나온 부분).
	-- 공은 돌리지 않음(돌린 공은 경계 상자가 커져서 Models.create 의 크기 맞춤·굴림 연출 틀이 달라짐)
	local function dome(lat: number, lon: number, cap: number, height: number, color: Color3, material: Enum.Material)
		local top = radius + height
		local cosCap = math.cos(math.rad(cap))
		local r = (radius * radius + top * top - 2 * radius * top * cosCap) / (2 * (top - radius * cosCap))
		local p = surface(lat, lon, top - r)
		ball(c, p.X, p.Y, p.Z, r * 2, color, material).CastShadow = false
	end

	-- 대륙: 해안 쪽 작은 돔은 0.04, 큰(내륙) 돔은 0.05 (DOME_*).
	-- 다섯째 칸이 있는 줄은 색 덧칠 공(마른 띠·히말라야 눈·열대림 등): 표에 적힌 높이 그대로(바탕 돔보다 살짝 위)
	for _, row in GLOBE_LAND do
		local cap, tone = row[3], row[4]
		local height = row[5] or math.clamp(DOME_SLOPE * radius * math.rad(cap), DOME_MIN, DOME_MAX)
		dome(row[1], row[2], cap, height, GLOBE_TONES[tone] or c.S, GLOBE_MATERIALS[tone] or Mat.Grass)
	end
	-- 북극 바다 얼음(남극은 땅 표에 있음)
	dome(90, 0, 11, DOME_MAX, GLOBE_SNOW, Mat.Snow)

	-- 자오선 고리: 지구 중심을 도는 금색 띠(원 둘레 32조각). 맨 아래 조각이 받침 기둥 꼭대기에 얹힘
	local ring, band, width = 4.5, 0.2, 0.34
	local pieces = 32
	local step = TAU / pieces
	local length = 2 * (ring + band / 2) * math.tan(step / 2) -- 바깥 모서리까지 맞닿게
	for k = 0, pieces - 1 do
		local cf = CFrame.new(center) * CFrame.Angles(0, 0, -PI / 2 + k * step) * CFrame.new(ring, 0, 0)
		block(c, cf, V(band, length, width), GLOBE_GOLD, Mat.Metal)
	end
	ball(c, 0, center.Y - ring, 0, 0.6, GLOBE_GOLD, Mat.Metal) -- 기둥과 고리가 만나는 마디
	-- 축: 지구를 꿰뚫어 고리의 두 극 축받이까지
	cyl(c, tilt * UPRIGHT, 9.5, 0.22, GLOBE_GOLD, Mat.Metal)
	for _, side in { 1, -1 } do
		cyl(c, tilt * CFrame.new(0, side * ring, 0) * UPRIGHT, 0.4, 0.62, GLOBE_GOLD, Mat.Metal)
	end
end

-- 모르는 모형: 기단 + 오벨리스크
local function fallback(c: Ctx)
	box(c, 0, 0, 0, 5, 1, 5, c.S)
	box(c, 0, 1, 0, 1.4, 7, 1.4, c.P)
	box(c, 0, 8, 0, 1, 0.5, 1, c.A)
	box(c, 0, 8.5, 0, 0.5, 0.5, 0.5, c.A, Mat.Neon)
end

-- 명소별 전용 모형 ------------------------------------------------------------
-- 대륙별 모듈(Models/Asia.luau 등)이 `return function(K) return { [명소 Id] = function(c) ... end } end`
-- 형태로 전용 모형을 돌려줌. K = 아래 KIT(파트 헬퍼·색·기존 모양 builders). 전용 모형이 없는 명소는 Shape 모양을 씀.
local KIT = {
	V = V,
	rgb = rgb,
	Mat = Mat,
	PI = PI,
	TAU = TAU,
	UPRIGHT = UPRIGHT,
	ALONG_Z = ALONG_Z,
	CORNERS = CORNERS,
	GRASS = GRASS,
	LEAF = LEAF,
	WATER = WATER,
	DARK = DARK,
	TILE = TILE,
	ROCK = ROCK,
	WOOD = WOOD,
	SAND = SAND,
	CLOUD = CLOUD,
	BLACK = BLACK,
	WHITE = WHITE,
	mix = mix,
	add = add,
	shaped = shaped,
	block = block,
	box = box,
	ball = ball,
	cyl = cyl,
	col = col,
	wedge = wedge,
	beam = beam,
	facing = facing,
	archCorner = archCorner,
	roof = roof,
	gable = gable,
	plant = plant,
	stepped = stepped,
	clockFace = clockFace,
	figureTop = figureTop,
	shapes = BUILDERS, -- 기존 모양을 바탕으로 쓰고 싶을 때: K.shapes.dome(c)
}

local CONTINENT_MODULES = { "Asia", "Asia2", "Europe", "Europe2", "Americas", "Americas2", "Africa", "Oceania" }
local CUSTOM: { [string]: (Ctx) -> () } = {}
for _, name in CONTINENT_MODULES do
	local moduleScript = script:FindFirstChild(name)
	if moduleScript and moduleScript:IsA("ModuleScript") then
		local ok, result = pcall(function()
			return (require(moduleScript) :: any)(KIT)
		end)
		if ok and type(result) == "table" then
			for id, builder in result do
				CUSTOM[id] = builder
			end
		else
			warn("[Models] " .. name .. " 전용 모형을 불러오지 못했습니다: " .. tostring(result))
		end
	end
end

-- 공개 API ------------------------------------------------------------------

-- 코드로 만든 모형이 있는 Shape 이름 집합
Models.SHAPES = {} :: { [string]: boolean }
for name in BUILDERS do
	Models.SHAPES[name] = true
end

-- 전용 모형이 있는 명소 Id 집합
Models.CUSTOM = {} :: { [string]: boolean }
for id in CUSTOM do
	Models.CUSTOM[id] = true
end

function Models.build(landmark: Landmark): Model
	local model = Instance.new("Model")
	model.Name = landmark.Id

	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = V(DESIGN_WIDTH, 0.2, DESIGN_WIDTH)
	root.CFrame = CFrame.new(0, 0.1, 0)
	root.PivotOffset = CFrame.new(0, -0.1, 0) -- 피벗 = 바닥 중앙(y = 0)
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.Parent = model
	model.PrimaryPart = root

	local ctx: Ctx = {
		model = model,
		id = landmark.Id,
		origin = CFrame.new(),
		P = landmark.Primary or rgb(200, 200, 200),
		S = landmark.Secondary or rgb(140, 140, 140),
		A = landmark.Accent or rgb(255, 240, 180),
		M = landmark.Material or Mat.SmoothPlastic,
		grand = landmark.Tier ~= nil and landmark.Tier.Rank >= 5,
	}
	local builder = CUSTOM[landmark.Id] or BUILDERS[landmark.Shape] or fallback
	local ok, err = pcall(builder, ctx)
	if not ok then
		-- 모형 코드에 문제가 있어도 게임은 계속되도록: 만들던 파트를 지우고 기본 모형으로
		warn(
			"[Models] "
				.. tostring(landmark.Id)
				.. " 모형 생성 실패, 기본 모형으로 대체: "
				.. tostring(err)
		)
		for _, child in model:GetChildren() do
			if child ~= root then
				child:Destroy()
			end
		end
		ctx.origin = CFrame.new()
		fallback(ctx)
	end
	return model
end

local function findOverride(landmark: Landmark): Model?
	local folder = game:GetService("ReplicatedStorage"):FindFirstChild(OVERRIDE_FOLDER)
	local source = folder and folder:FindFirstChild(landmark.Id)
	if source and source:IsA("Model") then
		return source
	end
	return nil
end

-- 교체 모형: 경계 상자의 바닥 중앙을 피벗으로. 경계 상자 크기를 돌려줌
local function pivotToBottom(model: Model): Vector3
	local cf, extents = model:GetBoundingBox()
	local bottom = cf * CFrame.new(0, -extents.Y / 2, 0)
	local primary = model.PrimaryPart
	if primary then
		-- PrimaryPart 가 있으면 WorldPivot 은 무시되므로 PrimaryPart 의 피벗을 옮김
		primary.PivotOffset = primary.CFrame:ToObjectSpace(bottom)
	else
		model.WorldPivot = bottom
	end
	return extents
end

function Models.create(landmark: Landmark, size: number, opts: { Anchored: boolean? }?): Model
	local model: Model? = nil
	local source = findOverride(landmark)
	if source then
		local clone = source:Clone()
		if clone and clone:FindFirstChildWhichIsA("BasePart", true) then
			model = clone
		end
	end

	local extents
	if model then
		extents = pivotToBottom(model)
		if math.max(extents.X, extents.Z) <= 1e-3 then
			model:Destroy()
			model = nil
		end
	end
	local built = model == nil
	if not model then
		model = Models.build(landmark)
		local _, buildExtents = (model :: Model):GetBoundingBox()
		extents = buildExtents
	end
	local result = model :: Model

	-- 가로·세로 중 큰 쪽이 size, 단 높이는 size * 2.2 까지
	local factor = size / math.max(extents.X, extents.Z)
	if extents.Y * factor > size * MAX_HEIGHT_RATIO then
		factor = size * MAX_HEIGHT_RATIO / extents.Y
	end
	if factor > 0 and factor < math.huge and math.abs(factor - 1) > 1e-4 then
		result:ScaleTo(result:GetScale() * factor)
	end

	-- 크기를 바꾼 뒤에도 피벗이 정확히 바닥 중앙이도록 다시 맞춤
	if built then
		local root = result.PrimaryPart :: BasePart
		root.PivotOffset = CFrame.new(0, -root.Size.Y / 2, 0)
	else
		pivotToBottom(result)
	end

	local loose = opts ~= nil and opts.Anchored == false
	for _, descendant in result:GetDescendants() do
		if descendant:IsA("BasePart") then
			if loose then
				descendant.Anchored = false
				descendant.Massless = true
				descendant.CanCollide = false
				descendant.CanQuery = false
				descendant.CanTouch = false
			else
				descendant.Anchored = true
				descendant.CanCollide = false
			end
		end
	end

	result.Name = landmark.Id
	return result
end

return Models
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">Africa</string>
            <string name="Source"><![CDATA[-- 아프리카 명소 전용 모형. Models/init.luau 가 K(파트 헬퍼·색·기존 모양)를 넘겨 호출합니다.
-- 규칙: 바닥 10x10 안, 높이 22 이하, 바닥 y = 0, 정면 -Z, 파트 45개 이하. c.P/c.S/c.A = 명소 주/보조/강조 색, c.M = 재질.
-- 희망봉 등대(lighthouse) · 스핑크스(sphinx) · 기자 피라미드(pyramid) · 알렉산드리아 등대(lighthouse 불가사의판)는
-- 원래 그 명소를 위해 만든 모양을 그대로 씀. 사하라 신기루 성은 나무 섬(skyisland) 대신 떠 있는 성채 전용 모형.
-- 좌우 주의: 정면(-Z 쪽)에서 바라보면 +X 가 왼쪽, -X 가 오른쪽.

return function(K)
	local B = {}

	local V, rgb, Mat, PI, TAU = K.V, K.rgb, K.Mat, K.PI, K.TAU
	local ALONG_Z, CORNERS = K.ALONG_Z, K.CORNERS
	local GRASS, LEAF, WATER, DARK = K.GRASS, K.LEAF, K.WATER, K.DARK
	local ROCK, WOOD, SAND, BLACK, WHITE = K.ROCK, K.WOOD, K.SAND, K.BLACK, K.WHITE
	local mix, block, box, ball, cyl, col, wedge, beam = K.mix, K.block, K.box, K.ball, K.cyl, K.col, K.wedge, K.beam
	local plant = K.plant

	-- 공용 도우미 -----------------------------------------------------------------

	-- a 에서 b 까지 이어지는 판: 가로 w(진행 방향의 오른쪽), 두께 t. a → b 는 수직이 아니어야 함
	local function slab(c, a, b, w, t, color, material, transparency)
		local mid = (a + b) / 2
		return block(c, CFrame.lookAt(mid, b), V(w, t, (b - a).Magnitude), color, material, transparency)
	end

	-- 정면(-Z)에서 삼각형이 보이는 박공(용마루가 Z 방향). 바닥 y, 폭 w(X), 깊이 d(Z), 높이 h
	local function frontGable(c, x, y, z, w, d, h, color, material)
		wedge(c, CFrame.new(x - w / 4, y + h / 2, z) * CFrame.Angles(0, PI / 2, 0), V(d, h, w / 2), color, material)
		wedge(c, CFrame.new(x + w / 4, y + h / 2, z) * CFrame.Angles(0, -PI / 2, 0), V(d, h, w / 2), color, material)
	end

	-- 칼날 봉우리: 용마루(길이 w)가 yaw 만큼 돈 박공. 밑변 d, 높이 h, 바닥 y
	local function blade(c, x, y, z, w, d, h, yaw, color, material)
		local base = CFrame.new(x, y + h / 2, z) * CFrame.Angles(0, yaw, 0)
		wedge(c, base * CFrame.new(0, 0, -d / 4), V(w, h, d / 2), color, material)
		wedge(c, base * CFrame.new(0, 0, d / 4) * CFrame.Angles(0, PI, 0), V(w, h, d / 2), color, material)
	end

	-- 세 점을 잇는 삼각형 판(직각 쐐기 두 개, 한 꼭짓점에서 내린 수선으로 나눔).
	--   쐐기 경계 상자가 설계 공간(바닥 위, 10x10 안)에 드는 나눔을 고르고, 없으면 가장 긴 변의 가운데에서 둘로 쪼갬
	local function tri(c, a, b, d, color, material, thick, depth)
		local t = thick or 0.2
		local function fits(p)
			local limit = 5 - t / 2
			return p.Y >= t / 2 and math.abs(p.X) <= limit and math.abs(p.Z) <= limit
		end
		local chosen
		for _, o in { { a, b, d }, { b, d, a }, { d, a, b } } do
			local apex, p, q = o[1], o[2], o[3]
			local edge = q - p
			local s = (apex - p):Dot(edge) / edge:Dot(edge)
			if s > 1e-3 and s < 1 - 1e-3 then
				local up = apex - (p + edge * s)
				if fits(p) and fits(q) and fits(p + up) and fits(q + up) then
					chosen = o
					break
				end
			end
		end
		if not chosen then
			if (depth or 0) >= 3 then
				return
			end
			-- 가장 긴 변을 반으로 나눠 두 삼각형으로
			local best, pts = -1, nil
			for _, o in { { a, b, d }, { b, d, a }, { d, a, b } } do
				local len = (o[2] - o[1]).Magnitude
				if len > best then
					best, pts = len, o
				end
			end
			local m = (pts[1] + pts[2]) / 2
			tri(c, pts[1], m, pts[3], color, material, t, (depth or 0) + 1)
			tri(c, m, pts[2], pts[3], color, material, t, (depth or 0) + 1)
			return
		end
		local apex, p, q = chosen[1], chosen[2], chosen[3]
		local edge = q - p
		local foot = p + edge * ((apex - p):Dot(edge) / edge:Dot(edge))
		local height = (apex - foot).Magnitude
		local up = (apex - foot).Unit
		for _, e in { p, q } do
			local len = (foot - e).Magnitude
			if len > 0.02 then
				local center = (e + apex) / 2
				wedge(c, CFrame.lookAt(center, center - (foot - e).Unit, up), V(t, height, len), color, material)
			end
		end
	end

	-- 원뿔 비탈을 판 n 장으로 덮음: 반지름 r1(높이 y1) → r2(높이 y2). colorOf(i) 로 판마다 색
	local function slopeRing(c, center, n, r1, y1, r2, y2, w, colorOf, material, turn)
		for i = 0, n - 1 do
			local a = (i + (turn or 0)) / n * TAU
			local dir = V(math.sin(a), 0, -math.cos(a))
			local p1 = center + V(0, y1, 0) + dir * r1
			local p2 = center + V(0, y2, 0) + dir * r2
			local normal = V(0, r1 - r2, 0) + dir * (y2 - y1)
			local mid = (p1 + p2) / 2 - normal.Unit * 0.2
			block(c, CFrame.lookAt(mid, mid + (p2 - p1)), V(w, 0.4, (p2 - p1).Magnitude + 0.15), colorOf(i), material)
		end
	end

	-- 우산 모양 아카시아: 기운 줄기 + 납작한 잎 판 두 장
	local function acacia(c, x, y, z, h, d, leaf, lean)
		local top = V(x + (lean or 0.3), y + h, z)
		beam(c, V(x, y, z), top, 0.26, WOOD, Mat.Wood)
		col(c, top.X, top.Y, top.Z, 0.35, d, leaf, Mat.Grass)
		col(c, top.X - d * 0.12, top.Y + 0.3, top.Z + d * 0.08, 0.3, d * 0.62, mix(leaf, BLACK, 0.12), Mat.Grass)
	end

	-- 야자수: 기운 줄기 + 늘어진 잎 네 장
	local function palm(c, x, y, z, h, leaf, turn)
		local top = V(x + 0.25, y + h, z + 0.1)
		beam(c, V(x, y, z), top, 0.24, WOOD, Mat.Wood)
		for k = 0, 3 do
			local a = (turn or 0) + k * PI / 2
			local tip = top + V(math.cos(a) * 1.05, -0.45, math.sin(a) * 1.05)
			slab(c, top + V(0, 0.08, 0), tip, 0.42, 0.08, leaf, Mat.Grass)
		end
	end

	-- 기린: 다리(앞뒤 판) + 몸통 + 긴 목 + 머리. yaw = 바라보는 방향(0 이면 -Z)
	local function giraffe(c, x, y, z, yaw, s)
		local coat = rgb(222, 168, 82)
		local cf = CFrame.new(x, y, z) * CFrame.Angles(0, yaw, 0)
		block(c, cf * CFrame.new(0, 0.8 * s, -0.42 * s), V(0.5 * s, 1.6 * s, 0.18 * s), coat)
		block(c, cf * CFrame.new(0, 0.8 * s, 0.42 * s), V(0.5 * s, 1.6 * s, 0.18 * s), coat)
		block(c, cf * CFrame.new(0, 1.85 * s, 0.05 * s) * CFrame.Angles(0.2, 0, 0), V(0.6 * s, 0.6 * s, 1.35 * s), coat)
		local neckFoot = cf * V(0, 2 * s, -0.5 * s)
		local head = cf * V(0, 3.9 * s, -1 * s)
		beam(c, neckFoot, head, 0.28 * s, coat)
		block(
			c,
			CFrame.new(head) * CFrame.Angles(0, yaw, 0) * CFrame.new(0, 0, -0.18 * s),
			V(0.3 * s, 0.32 * s, 0.62 * s),
			mix(coat, WOOD, 0.3)
		)
	end

	-- 코끼리: 다리(앞뒤 판) + 몸통 + 머리 + 귀 + 코
	local function elephant(c, x, y, z, yaw, s)
		local grey = rgb(128, 122, 118)
		local cf = CFrame.new(x, y, z) * CFrame.Angles(0, yaw, 0)
		block(c, cf * CFrame.new(0, 0.4 * s, -0.55 * s), V(0.95 * s, 0.8 * s, 0.4 * s), grey)
		block(c, cf * CFrame.new(0, 0.4 * s, 0.6 * s), V(0.95 * s, 0.8 * s, 0.4 * s), grey)
		block(c, cf * CFrame.new(0, 1.3 * s, 0.05 * s), V(1.15 * s, 1.1 * s, 1.9 * s), grey)
		block(c, cf * CFrame.new(0, 1.55 * s, -1.05 * s), V(0.8 * s, 0.85 * s, 0.6 * s), grey)
		block(c, cf * CFrame.new(0, 1.5 * s, -0.95 * s), V(1.7 * s, 0.95 * s, 0.12 * s), mix(grey, BLACK, 0.1))
		beam(c, cf * V(0, 1.3 * s, -1.35 * s), cf * V(0, 0.15 * s, -1.55 * s), 0.26 * s, grey)
	end

	-- 명소 -------------------------------------------------------------------

	-- 볼더스 비치: 청록 바다 + 흰 모래 후미 + 둥근 화강암 바위들 + 뒤뚱거리는 아프리카펭귄 무리(검은 몸, 흰 배, 검은 머리)
	B.boulders = function(c)
		local wet = mix(c.P, BLACK, 0.18)
		box(c, 0, 0, 0, 9.8, 0.2, 9.8, c.A, Mat.Glass, 0.1)
		box(c, -0.9, 0.2, 1.3, 8, 0.2, 7.2, SAND, Mat.Sand)
		box(c, -0.9, 0.2, -2.45, 8, 0.1, 0.4, mix(c.A, WHITE, 0.65), Mat.SmoothPlastic)
		box(c, 3.25, 0.2, 1.3, 0.4, 0.1, 7.2, mix(c.A, WHITE, 0.65), Mat.SmoothPlastic)
		-- 바위: { x, z, 지름 } (앞 가운데는 비워 펭귄이 보이게)
		for k, r in
			{
				{ -3.5, 3.5, 2.8 },
				{ -1, 3.9, 2 },
				{ 1.5, 3.9, 1.9 },
				{ 3.6, 2.8, 2.6 },
				{ -3.9, 0.1, 2 },
				{ 3.95, -0.9, 1.8 },
				{ -3.9, -3.7, 1.6 },
				{ 3.5, -3.9, 1.4 },
			}
		do
			ball(c, r[1], r[3] / 2, r[2], r[3], if k % 3 == 0 then wet else c.P)
		end
		-- 펭귄: 검은 몸통 + 앞으로 불룩한 흰 배 + 검은 머리 + 흰 뺨
		local function penguin(x, z, yaw)
			local y = 0.4
			local dir = V(-math.sin(yaw), 0, -math.cos(yaw))
			col(c, x, y, z, 1.6, 1.05, c.S, Mat.SmoothPlastic)
			local belly = V(x, y + 0.72, z) + dir * 0.24
			ball(c, belly.X, belly.Y, belly.Z, 0.92, WHITE, Mat.SmoothPlastic)
			ball(c, x, y + 1.9, z, 0.78, c.S, Mat.SmoothPlastic)
			local cheek = V(x, y + 1.84, z) + dir * 0.24
			ball(c, cheek.X, cheek.Y, cheek.Z, 0.4, WHITE, Mat.SmoothPlastic)
		end
		for _, p in
			{
				{ -1.9, 1.3, 0.3 },
				{ -0.2, 1.9, -0.2 },
				{ 1.5, 1, 0.5 },
				{ -1.1, -0.6, 0 },
				{ 0.7, -1.1, -0.4 },
				{ 2.1, -2.2, 0.9 },
			}
		do
			penguin(p[1], p[2], p[3])
		end
	end

	-- 셰프샤우엔: 뒤로 올라가는 비탈(푸른 벽 계단식 단) 위의 파랗게 칠한 네모 집들(흰 지붕 테두리, 주황 화분·문)
	--   + 가운데 파란 계단 골목 + 흙빛 카스바 탑 + 뒤쪽 리프 산맥 봉우리
	B.chefchaouen = function(c)
		local light, deep = mix(c.P, WHITE, 0.45), mix(c.P, rgb(30, 60, 160), 0.35)
		local wall = mix(c.P, WHITE, 0.7)
		local mountain = mix(LEAF, ROCK, 0.55)
		box(c, 0, 0, 0, 9.8, 0.3, 9.8, wall)
		box(c, 0, 0.3, 1.9, 9.8, 1, 6.2, wall)
		box(c, 0, 1.3, 3.3, 9.8, 1.1, 3.4, wall)
		frontGable(c, -2.2, 2.4, 4.4, 5.4, 1.1, 6.4, mountain, Mat.Rock)
		frontGable(c, 2.6, 2.4, 4.5, 4.6, 0.9, 5, mix(mountain, BLACK, 0.15), Mat.Rock)
		-- 집: { x, 바닥, z, 가로, 높이, 세로, 색, 문 x 치우침 }
		for k, h in
			{
				{ -3.1, 0.3, -3.3, 3.4, 2.2, 2.6, c.P, 0.6 },
				{ 3, 0.3, -3.4, 3.6, 1.8, 2.4, light, -0.8 },
				{ -3, 1.3, -0.1, 3.6, 2.4, 2, deep, 0.9 },
				{ 3.1, 1.3, 0, 3.4, 2.8, 2.2, c.P, -0.7 },
				{ -2.6, 2.4, 2.7, 4.2, 2.6, 2.2, light, 0.8 },
				{ 2.4, 2.4, 2.9, 3.6, 2, 2.4, deep, -0.4 },
			}
		do
			local x, y, z, w, hh, d = h[1], h[2], h[3], h[4], h[5], h[6]
			box(c, x, y, z, w, hh, d, h[7])
			box(c, x, y + hh, z, w + 0.1, 0.2, d + 0.1, c.S)
			box(c, x + h[8], y, z - d / 2 - 0.04, 0.6, 1.1, 0.1, if k % 2 == 0 then c.A else mix(c.P, BLACK, 0.45))
		end
		-- 창문과 벽에 건 주황 화분
		box(c, -2.4, 1.3, -4.64, 0.5, 0.5, 0.1, DARK)
		box(c, 3.9, 3, -1.14, 0.5, 0.5, 0.1, DARK)
		for _, p in
			{ { -3.6, 1.5, -4.66 }, { 2.2, 1.3, -4.66 }, { -2, 2.9, -1.16 }, { 2.3, 3.3, -1.16 }, { -3.8, 3.9, 1.54 } }
		do
			box(c, p[1], p[2], p[3], 0.32, 0.3, 0.16, c.A)
		end
		-- 가운데 파란 계단 골목
		wedge(c, CFrame.new(0, 0.8, -1.9), V(2, 1, 1.4), c.P)
		wedge(c, CFrame.new(0, 1.85, 0.9), V(2, 1.1, 1.4), c.P)
		-- 카스바 탑
		local ochre = rgb(196, 138, 92)
		box(c, -4.15, 2.4, 4.2, 1.2, 5, 1.2, ochre)
		box(c, -4.15, 7.4, 4.2, 1.4, 0.3, 1.4, mix(ochre, BLACK, 0.2))
		box(c, -4.15, 7.7, 4.2, 0.7, 0.6, 0.7, ochre)
	end

	-- 테이블 마운틴: 앞바다 + 해안 도시 + 꼭대기가 평평한 거대한 사암 절벽(골짜기 줄, 초록 비탈)
	--   + 꼭대기를 덮고 흘러내리는 "식탁보" 구름 + 왼쪽 데블스 피크, 오른쪽 라이언스 헤드 + 케이블카
	B.tablemountain = function(c)
		local cliff = mix(c.P, BLACK, 0.12)
		local gully = mix(c.P, BLACK, 0.35)
		box(c, 0, 0, 0, 9.8, 0.2, 9.8, WATER, Mat.Glass, 0.1)
		box(c, 0, 0.2, 1.2, 9.8, 0.2, 7.4, mix(c.S, SAND, 0.45), Mat.Grass)
		-- 도시: { x, z, 가로, 높이, 세로 }
		for k, b in
			{
				{ 3.9, -2, 0.9, 0.9, 1 },
				{ 2.8, -2.1, 0.8, 1.5, 0.9 },
				{ 1.7, -1.9, 1, 0.7, 1 },
				{ 0.5, -2.1, 0.7, 2, 0.7 },
				{ -0.6, -1.9, 1, 1.1, 1 },
				{ -1.8, -2.1, 0.8, 1.6, 0.8 },
			}
		do
			local color = if k % 3 == 0 then rgb(150, 190, 220) elseif k % 3 == 1 then WHITE else rgb(236, 226, 205)
			box(c, b[1], 0.4, b[2], b[3], b[4], b[5], color, if k % 3 == 0 then Mat.Glass else Mat.SmoothPlastic)
		end
		col(c, -3.6, 0.4, -2.1, 0.5, 1.6, WHITE, Mat.SmoothPlastic)
		-- 산 덩어리 + 앞·옆 비탈 + 골짜기
		box(c, 0, 0.4, 2.7, 7, 5.8, 4.2, c.P)
		wedge(c, CFrame.new(0, 1.9, -0.3), V(7, 3, 1.8), c.S, Mat.Grass)
		for _, x in { 2.2, 0.2, -1.5 } do
			box(c, x, 2.4, 0.56, 0.3, 3.6, 0.1, gully)
		end
		-- 식탁보 구름
		box(c, 0, 6.2, 2.7, 7.3, 0.55, 4.5, c.A, Mat.SmoothPlastic, 0.05)
		for _, d in { { 2.8, 1.4 }, { 1.1, 0.8 }, { -0.7, 1.6 }, { -2.6, 1 } } do
			box(c, d[1], 6.2 - d[2], 0.4, 1.3, d[2] + 0.1, 0.3, c.A, Mat.SmoothPlastic, 0.2)
		end
		-- 데블스 피크(정면에서 왼쪽 = +X, 뾰족) + 라이언스 헤드(오른쪽 = -X, 초록 비탈 위 바위 머리)
		frontGable(c, 4.15, 0.4, 2.6, 1.6, 3.8, 5.6, cliff)
		frontGable(c, -4.1, 0.4, 1.4, 1.7, 3.2, 2.8, c.S, Mat.Grass)
		frontGable(c, -4.1, 0.4, 1.5, 1.3, 1.6, 4.6, cliff)
		-- 케이블카
		box(c, -2.4, 0.4, -0.9, 0.6, 1.3, 0.5, WHITE)
		beam(c, V(-2.4, 1.7, -0.9), V(-2.4, 6.75, 0.8), 0.06, DARK)
		box(c, -2.4, 3.9, -0.3, 0.4, 0.4, 0.4, rgb(210, 50, 50))
	end

	-- 바오밥 거리: 붉은 흙길 양옆으로 늘어선 키 큰 바오밥(곧고 굵은 줄기 + 꼭대기에만 짧은 가지와 납작한 잎)
	--   + 풀밭 + 길 끝에 지는 주황 해 + 제부 소달구지
	B.baobab = function(c)
		local soil = mix(c.P, rgb(190, 90, 50), 0.45)
		local road = mix(soil, SAND, 0.45)
		box(c, 0, 0, 0, 9.8, 0.25, 9.8, soil, Mat.Sand)
		box(c, 0, 0.25, 0, 2, 0.05, 9.8, road, Mat.Sand)
		box(c, -3.5, 0.25, -0.5, 2.6, 0.06, 8, mix(c.S, SAND, 0.3), Mat.Grass)
		box(c, 3.5, 0.25, 0.5, 2.6, 0.06, 8, mix(c.S, SAND, 0.3), Mat.Grass)
		cyl(c, CFrame.new(0, 2.3, 4.9) * ALONG_Z, 0.1, 3.4, c.A, Mat.Neon)
		local function tree(x, z, h, d, turn)
			col(c, x, 0.25, z, h, d, c.P, Mat.Wood)
			local top = V(x, 0.25 + h, z)
			for k = 0, 2 do
				local a = turn + k * TAU / 3
				beam(c, top - V(0, 0.4, 0), top + V(math.cos(a) * 1.15, 1, math.sin(a) * 1.15), 0.3, c.P, Mat.Wood)
			end
			col(c, x, top.Y + 0.85, z, 0.4, 3, c.S, Mat.Grass)
		end
		tree(-2.5, -3.3, 7, 1.5, 0.2)
		tree(2.5, -2.2, 8, 1.6, 0.9)
		tree(-2.6, 0.2, 8.6, 1.7, 1.4)
		tree(2.4, 1.3, 7.4, 1.4, 0.5)
		tree(-2.3, 3.3, 7.8, 1.5, 1.1)
		tree(2.6, 3.4, 6.6, 1.3, 0.3)
		-- 소달구지
		box(c, 0.2, 0.75, -1.6, 0.9, 0.5, 1.2, WOOD, Mat.Wood)
		cyl(c, CFrame.new(0.2, 0.6, -1.5), 1.2, 0.7, DARK)
		box(c, 0.2, 0.3, -3, 0.6, 0.8, 1.2, rgb(150, 110, 80))
		box(c, 0.2, 0.8, -3.75, 0.45, 0.45, 0.5, rgb(150, 110, 80))
	end

	-- 아이트벤하두: 강과 야자수 앞, 언덕을 따라 층층이 쌓인 흙벽 성채(모서리마다 솟은 탑 + 톱니 테두리 + 좁은 창)
	--   + 언덕 꼭대기의 곡물 창고(아가디르)
	B.aitbenhaddou = function(c)
		local mud, dark = c.P, c.S
		local hill = mix(c.S, ROCK, 0.3)
		box(c, 0, 0, 0, 9.8, 0.2, 9.8, mix(c.P, SAND, 0.4), Mat.Sand)
		box(c, 0, 0.2, -4.35, 9.8, 0.08, 1.1, WATER, Mat.Glass, 0.1)
		for _, x in { -3.8, -1.2, 3.6 } do
			plant(c, x, 0.2, -3.25, 1.3, 1, c.A)
		end
		box(c, 0, 0.2, 1.2, 9.6, 1, 7.2, hill, Mat.Rock)
		box(c, 0.4, 1.2, 2.2, 7.4, 1.5, 5.2, hill, Mat.Rock)
		box(c, 0.6, 2.7, 3.2, 4.6, 1.6, 3.2, hill, Mat.Rock)
		-- 아가디르
		box(c, 0.6, 4.3, 3.4, 3.4, 1.6, 1.6, mud)
		box(c, 0.6, 5.9, 3.4, 3.6, 0.25, 1.8, dark)
		-- 성채: 몸채 + 톱니 테두리 + 네 귀퉁이 탑 + 창
		local function kasbah(x, y, z, w, h, d, tower)
			box(c, x, y, z, w, h, d, mud)
			box(c, x, y + h, z, w + 0.1, 0.2, d + 0.1, dark)
			for _, s in CORNERS do
				local tx, tz = x + s[1] * (w / 2 - 0.3), z + s[2] * (d / 2 - 0.3)
				box(c, tx, y, tz, 0.75, h + tower, 0.75, mix(mud, WHITE, 0.08))
				if s[2] < 0 then
					box(c, tx, y + h + tower, tz, 0.95, 0.3, 0.95, dark)
				end
			end
			box(c, x, y + h * 0.55, z - d / 2 - 0.03, w * 0.45, 0.35, 0.08, DARK)
		end
		kasbah(-2.6, 1.2, -1.2, 3, 2.6, 2.4, 1.2)
		kasbah(2.4, 2.7, 0.8, 2.6, 2.2, 2.2, 1)
		-- 작은 집: { x, 바닥, z, 가로, 높이, 세로 }
		for _, h in
			{
				{ 0.3, 1.2, -1.7, 1.8, 1.6, 1.3 },
				{ 3.4, 1.2, -1.7, 2.2, 1.2, 1.2 },
				{ -2.2, 2.7, 1.3, 2.4, 1.6, 1.8 },
				{ -0.1, 2.7, 0.8, 1.4, 2, 1.2 },
			}
		do
			box(c, h[1], h[2], h[3], h[4], h[5], h[6], mix(mud, dark, 0.2))
			box(c, h[1], h[2] + h[5] * 0.5, h[3] - h[6] / 2 - 0.03, 0.4, 0.4, 0.08, DARK)
		end
		-- 성문 + 강에서 오르는 길
		box(c, -0.9, 0.2, -2.9, 1, 0.1, 1.8, mix(c.P, SAND, 0.6), Mat.Sand)
		box(c, -0.9, 0.2, -2.42, 0.8, 1.3, 0.1, DARK)
	end

	-- 데드블레이: 하얗게 갈라진 점토 바닥 + 검게 말라 죽은 낙타가시나무 + 뒤쪽의 거대한 주황 모래언덕(볕 든 면 / 그늘 면)
	B.deadvlei = function(c)
		local shade = mix(c.P, rgb(90, 30, 20), 0.5)
		box(c, 0, 0, 0, 9.8, 0.2, 9.8, mix(c.P, SAND, 0.3), Mat.Sand)
		box(c, -0.6, 0.2, -2.2, 7.8, 0.1, 5, c.S, Mat.Sand)
		box(c, -2.2, 0.2, 0.6, 4, 0.1, 1.8, c.S, Mat.Sand)
		-- 큰 모래언덕(뒤쪽 전체): 왼쪽 뒤 꼭대기 H 에서 오른쪽 앞(F)으로 길게 내려오는 칼날 능선.
		--   능선 왼쪽·앞 면은 볕, 오른쪽 뒤 면은 그늘
		local H, F = V(-3.2, 5.8, 4.2), V(4, 0.2, -0.4)
		local L, BL, BR = V(-4.8, 0.2, 0.8), V(-4.8, 0.2, 4.8), V(4.8, 0.2, 4.8)
		tri(c, H, F, L, c.P, Mat.Sand, 0.3)
		tri(c, H, L, BL, mix(c.P, shade, 0.15), Mat.Sand, 0.3)
		tri(c, H, F, BR, shade, Mat.Sand, 0.3)
		-- 죽은 나무: 기운 줄기 + 비틀린 가지 셋
		local function deadTree(x, z, h, turn)
			local fork = V(x + 0.2, 0.3 + h * 0.5, z)
			beam(c, V(x, 0.3, z), fork, 0.34, c.A, Mat.Wood)
			for k = 0, 2 do
				local a = turn + k * 2.1
				local tip = fork + V(math.cos(a) * h * 0.42, h * (0.28 + 0.12 * k), math.sin(a) * h * 0.42)
				beam(c, fork, tip, 0.2, c.A, Mat.Wood)
			end
		end
		deadTree(-3, -3.2, 3.2, 0.3)
		deadTree(0.3, -2.4, 3.8, 1.2)
		deadTree(2.6, -3.8, 2.6, 2.2)
		deadTree(-2, 0.2, 2.8, 0.8)
		deadTree(1.2, -0.3, 2.4, 2.8)
	end

	-- 칭기 드 베마라하: 숲 바닥 + 좁은 협곡을 사이에 둔 회색 석회암 덩어리 둘 + 그 위로 빽빽이 솟은 칼날 봉우리들
	--   + 봉우리 사이를 잇는 흔들다리 + 협곡 속 초록 숲
	B.tsingy = function(c)
		local pale = mix(c.P, WHITE, 0.18)
		box(c, 0, 0, 0, 9.8, 0.3, 9.8, mix(c.A, BLACK, 0.25), Mat.Grass)
		box(c, -2.75, 0.3, 0.3, 4.3, 1.6, 9, c.S)
		box(c, 2.85, 0.3, 0, 4.1, 1.2, 9.6, c.S)
		-- 봉우리: { x, z, 용마루 길이, 밑변, 높이, 방향 }
		for k, b in
			{
				{ -3.8, -3.3, 0.8, 1.6, 5.2, 0.3 },
				{ -2.5, -2.1, 0.7, 1.5, 6.8, 1.2 },
				{ -1.3, -3.5, 0.6, 1.3, 4.2, 0.7 },
				{ -3.7, -0.5, 0.9, 1.7, 7.4, 2 },
				{ -1.6, 0.5, 0.7, 1.4, 5.8, 0.2 },
				{ -3.1, 2.1, 0.8, 1.6, 6.2, 1 },
				{ -1.3, 2.9, 0.7, 1.3, 4.6, 2.4 },
				{ -3.8, 3.9, 0.8, 1.4, 5, 0.5 },
				{ 1.6, -3.6, 0.7, 1.4, 4.4, 0.9 },
				{ 3.3, -2.8, 0.8, 1.6, 6.4, 0.1 },
				{ 2, -1, 0.6, 1.2, 5, 1.8 },
				{ 3.8, 0.3, 0.8, 1.6, 7, 0.6 },
				{ 1.8, 1.9, 0.7, 1.4, 5.6, 2.6 },
				{ 3.4, 3.2, 0.8, 1.5, 6, 1.3 },
				{ 1.6, 4, 0.6, 1.2, 4, 0.2 },
			}
		do
			local y = if b[1] < 0 then 1.9 else 1.5
			blade(c, b[1], y, b[2], b[3], b[4], b[5], b[6], if k % 3 == 0 then pale else c.P)
		end
		-- 흔들다리(널판 + 난간 줄 둘)
		local a, e = V(-1.3, 4.2, -1.3), V(1.7, 4, -1.1)
		slab(c, a, e, 0.6, 0.1, WOOD, Mat.Wood)
		beam(c, a + V(0, 0.55, -0.3), e + V(0, 0.55, -0.3), 0.05, rgb(200, 180, 140))
		beam(c, a + V(0, 0.55, 0.3), e + V(0, 0.55, 0.3), 0.05, rgb(200, 180, 140))
		-- 협곡 숲
		for _, t in { { 0.1, -3.4, 1.3 }, { 0.2, -0.2, 1.1 }, { 0, 2.6, 1.3 }, { -4.3, -4.5, 0.8 } } do
			ball(c, t[1], 0.3 + t[3] / 2, t[2], t[3], c.A, Mat.Grass)
		end
	end

	-- 랄리벨라 성 게오르기우스 교회: 붉은 바위 고원을 네모나게 파낸 구덩이 + 그 속에 통째로 깎아 만든 십자가 모양 교회
	--   (3단 기단, 창문 두 줄, 지붕 위 겹십자 무늬, 지붕이 땅 높이와 같음) + 벽에 뚫린 은자의 굴 + 흰 옷 순례자
	B.lalibela = function(c)
		local rock = mix(c.P, c.S, 0.45)
		local church = mix(c.P, c.A, 0.12)
		local top = 4.2
		box(c, 0, 0, 0, 9.8, 0.3, 9.8, mix(c.S, BLACK, 0.15))
		box(c, -4.25, 0.3, 0, 1.3, top - 0.3, 9.8, rock)
		box(c, 4.25, 0.3, 0, 1.3, top - 0.3, 9.8, rock)
		box(c, 0, 0.3, 4.25, 7.2, top - 0.3, 1.3, rock)
		box(c, 0, 0.3, -4.25, 7.2, 0.9, 1.3, rock)
		local grass = mix(rgb(170, 150, 80), GRASS, 0.3)
		box(c, -4.25, top, 0, 1.3, 0.12, 9.8, grass, Mat.Grass)
		box(c, 4.25, top, 0, 1.3, 0.12, 9.8, grass, Mat.Grass)
		box(c, 0, top, 4.25, 7.2, 0.12, 1.3, grass, Mat.Grass)
		-- 십자가 교회: 기단 + 몸체 + 지붕 판(각각 가로·세로 두 팔)
		for _, arm in { { 6, 2.4 }, { 2.4, 6 } } do
			box(c, 0, 0.3, 0, arm[1] + 0.5, 0.8, arm[2] + 0.5, church)
			box(c, 0, 1.1, 0, arm[1], top - 1.4, arm[2], church)
			box(c, 0, top - 0.3, 0, arm[1] + 0.2, 0.3, arm[2] + 0.2, mix(church, c.A, 0.3))
		end
		-- 지붕의 겹십자 무늬
		box(c, 0, top, 0, 4, 0.1, 0.7, mix(c.P, BLACK, 0.2))
		box(c, 0, top, 0, 0.7, 0.1, 4, mix(c.P, BLACK, 0.2))
		box(c, 0, top + 0.1, 0, 2, 0.08, 0.3, c.A)
		box(c, 0, top + 0.1, 0, 0.3, 0.08, 2, c.A)
		-- 창문(위층 창 + 아래층 창)과 문
		local glass = DARK
		box(c, 0, 1.1, -3.03, 0.7, 1.2, 0.1, glass)
		box(c, 0, 2.8, -3.03, 0.5, 0.8, 0.1, glass)
		for _, sx in { -1, 1 } do
			box(c, sx * 3.03, 2.8, 0, 0.1, 0.8, 0.5, glass)
			box(c, sx * 3.03, 1.5, 0, 0.1, 0.8, 0.5, glass)
			box(c, sx * 2.1, 2.8, -1.23, 0.5, 0.8, 0.1, glass)
		end
		-- 은자의 굴 + 순례자
		box(c, -3.58, 1.2, 1.6, 0.1, 1, 0.8, DARK)
		box(c, 1.8, 1.6, 3.58, 0.9, 1, 0.1, DARK)
		for _, p in { { -2.6, -3.1 }, { -2.1, -3.3 }, { 2.5, -2.6 } } do
			col(c, p[1], 0.3, p[2], 0.8, 0.45, WHITE, Mat.Fabric)
			ball(c, p[1], 1.25, p[2], 0.3, rgb(90, 60, 45))
		end
	end

	-- 카르나크 신전: 숫양 스핑크스 길 + 오벨리스크 한 쌍 + 파피루스 기둥 숲(대열주실, 가운데 줄이 더 높고 푸른 칠 주두)
	--   + 들보 + 뒤쪽의 거대한 탑문(파일론)과 어두운 문
	B.karnak = function(c)
		box(c, 0, 0, 0, 9.8, 0.25, 9.8, mix(c.P, SAND, 0.4), Mat.Sand)
		box(c, 0, 0.25, -2.5, 1.8, 0.06, 5, mix(c.P, WHITE, 0.25))
		-- 숫양 스핑크스(몸 + 머리)
		for _, sx in { -1, 1 } do
			for _, z in { -4.1, -2.8 } do
				box(c, sx * 1.35, 0.25, z, 0.6, 0.55, 1, c.S)
				ball(c, sx * 1.35, 1.05, z - 0.45, 0.55, c.S)
			end
		end
		-- 오벨리스크(몸 + 금빛 피라미드 머리)
		for _, sx in { -1, 1 } do
			box(c, sx * 3.7, 0.25, -3.4, 0.7, 6.4, 0.7, c.P)
			block(c, CFrame.new(sx * 3.7, 7, -3.4) * CFrame.Angles(0, PI / 4, 0), V(0.48, 0.7, 0.48), c.A)
		end
		-- 대열주실: { x, 높이 }
		for _, colm in { { -3.3, 4.4 }, { -1.1, 5.6 }, { 1.1, 5.6 }, { 3.3, 4.4 } } do
			local x, h = colm[1], colm[2]
			for _, z in { -0.6, 1.5 } do
				col(c, x, 0.25, z, h, 1.05, c.P)
				col(c, x, 0.25 + h, z, 0.55, 1.5, c.A)
			end
			box(c, x, 0.8 + h, 0.45, 1.2, 0.5, 3.4, c.S)
		end
		-- 탑문
		for _, sx in { -1, 1 } do
			box(c, sx * 2.7, 0.25, 3.9, 3.8, 4.6, 1.6, c.P)
			box(c, sx * 2.6, 4.85, 3.9, 3.4, 2.2, 1.4, c.P)
			box(c, sx * 2.6, 7.05, 3.9, 3.7, 0.35, 1.6, c.S)
		end
		box(c, 0, 0.25, 3.9, 1.8, 4.4, 1.2, mix(c.P, c.S, 0.3))
		box(c, 0, 0.25, 3.28, 1, 3, 0.1, DARK)
	end

	-- 메로에 피라미드: 주황 모래언덕 위에 줄지어 선 가파르고 뾰족한 누비아 피라미드들(계단 층) + 앞(동쪽)의 작은 예배당
	B.meroe = function(c)
		box(c, 0, 0, 0, 9.8, 0.25, 9.8, c.A, Mat.Sand)
		local dune = mix(c.A, c.P, 0.3)
		wedge(c, CFrame.new(-2.6, 0.6, -3.7) * CFrame.Angles(0, 0.3, 0), V(3.4, 0.7, 1.6), dune, Mat.Sand)
		wedge(c, CFrame.new(2.9, 0.55, -3.9) * CFrame.Angles(0, PI - 0.2, 0), V(3, 0.6, 1.4), dune, Mat.Sand)
		-- { x, z, 밑변, 높이, 단 수, 색 }
		local shade = mix(c.P, c.S, 0.4)
		for _, p in
			{
				{ -3.1, 2.3, 2.6, 5.4, 6, c.P },
				{ 0, 2.9, 2.9, 6.4, 7, shade },
				{ 3.1, 2, 2.5, 5, 6, c.P },
				{ -1.7, -0.9, 2.3, 4.4, 5, shade },
				{ 1.8, -0.6, 2.1, 3.6, 4, c.P },
			}
		do
			K.stepped(c, p[1], p[2], 0.25, p[3], p[4], p[5], p[6])
		end
		-- 예배당(탑문 모양 입구)
		for _, p in { { -3.1, 0.55 }, { 0, 1.05 }, { -1.7, -2.5 } } do
			box(c, p[1], 0.25, p[2], 1.2, 1.1, 0.9, c.S)
			box(c, p[1], 0.25, p[2] - 0.47, 0.4, 0.7, 0.06, DARK)
		end
	end

	-- 킬리만자로: 황금빛 초원 + 완만하고 넓은 화산(키보) 비탈 + 빙하 줄무늬 + 평평한 눈 덮인 꼭대기와 분화구
	--   + 정면에서 왼쪽(+X)의 들쭉날쭉한 마웬지 봉 + 앞쪽 우산 아카시아와 코끼리
	B.kilimanjaro = function(c)
		local savanna = mix(c.A, rgb(214, 190, 110), 0.55)
		local snow = c.S
		box(c, 0, 0, 0, 9.8, 0.25, 9.8, savanna, Mat.Grass)
		local center = V(0, 0.25, 0.6)
		local lower = mix(c.P, c.A, 0.25)
		slopeRing(c, center, 11, 4.2, 0.2, 2.4, 3.3, 2.5, function(i)
			return if i % 2 == 0 then lower else mix(lower, BLACK, 0.08)
		end, Mat.Rock)
		slopeRing(c, center, 10, 2.5, 3.2, 1.75, 4.9, 1.7, function(i)
			return if i % 3 == 1 then c.P else snow
		end, Mat.Rock, 0.5)
		col(c, center.X, 4.85, center.Z, 0.3, 3.7, snow, Mat.Snow)
		col(c, center.X, 4.9, center.Z, 0.3, 1.8, mix(snow, ROCK, 0.4))
		-- 마웬지
		local craggy = mix(c.P, BLACK, 0.15)
		for _, b in { { 3.5, 2.8, 1.3, 3.8, 0.4, 0.12 }, { 3, 3.4, 1, 4.6, 0.9, -0.1 }, { 4, 3.3, 0.9, 3, 0.2, 0.2 } } do
			block(
				c,
				CFrame.new(b[1], 0.25 + b[4] / 2, b[2]) * CFrame.Angles(0, b[5], b[6]),
				V(b[3], b[4], b[3]),
				craggy
			)
		end
		acacia(c, -3.5, 0.25, -3.4, 2, 2.4, c.A, 0.3)
		acacia(c, 3.7, 0.25, -2.4, 1.6, 2, c.A, -0.2)
		elephant(c, 0.8, 0.25, -3.6, PI / 2, 1)
	end

	-- 빅토리아 폭포: 뒤쪽 고원 위 잠베지강 + 좁은 틈으로 폭 넓게 쏟아지는 흰 물 커튼(섬 사이로 나뉨) + 틈 바닥의 물
	--   + 앞쪽 낮은 고원의 열대우림 + 오른쪽으로 빠져나가는 협곡과 강철 아치 다리 + 피어오르는 물보라와 무지개
	B.victoriafalls = function(c)
		local basalt = c.S
		local top, front = 4.6, 1.2
		local white = mix(c.A, c.P, 0.12)
		box(c, 0, 0, 0, 9.8, 0.25, 9.8, mix(c.P, rgb(20, 70, 130), 0.3), Mat.Glass, 0.1)
		-- 뒤 고원 + 강 + 강 위의 섬(리빙스턴섬 등)
		box(c, 0, 0.25, 2.85, 9.8, top - 0.35, 4.1, basalt)
		box(c, 0, top - 0.1, 2.85, 9.8, 0.2, 4.1, c.P)
		for _, i in { { -2, 1.6 }, { 1.2, 1.8 } } do
			box(c, i[1], top - 0.1, i[2], 0.7, 0.4, 2, LEAF, Mat.Grass)
			ball(c, i[1], top + 0.6, i[2] + 0.2, 0.9, LEAF, Mat.Grass)
		end
		-- 물 커튼(섬 자리에서 끊김) + 물줄기 결 + 바닥 물거품
		for _, seg in { { -4.9, -2.35 }, { -1.65, 0.85 }, { 1.55, 4.9 } } do
			box(c, (seg[1] + seg[2]) / 2, 0.25, 0.65, seg[2] - seg[1], top - 0.1, 0.3, white, Mat.Neon, 0.05)
		end
		for _, x in { -4.2, -3.1, -1, 0.3, 2.3, 3.4, 4.4 } do
			box(c, x, 0.8, 0.48, 0.22, top - 1.2, 0.06, mix(c.P, WHITE, 0.6), Mat.SmoothPlastic)
		end
		box(c, 0, 0.25, 0.1, 9.8, 0.7, 0.9, WHITE, Mat.SmoothPlastic, 0.1)
		-- 앞 고원(낮음, 오른쪽으로 빠지는 협곡으로 둘로 나뉨)
		local rim = mix(LEAF, GRASS, 0.3)
		box(c, -1.45, 0.25, -2.95, 7.1, front - 0.25, 3.9, basalt)
		box(c, 4.25, 0.25, -2.95, 1.3, front - 0.25, 3.9, basalt)
		box(c, -1.45, front, -2.95, 7.1, 0.15, 3.9, rim, Mat.Grass)
		box(c, 4.25, front, -2.95, 1.3, 0.15, 3.9, rim, Mat.Grass)
		for _, t in { { -4.3, -1.9, 1.1 }, { -4.2, -3.9, 1.2 }, { -3.2, -4.3, 0.9 }, { 4.3, -4.3, 0.9 } } do
			ball(c, t[1], front + 0.15 + t[3] * 0.4, t[2], t[3], LEAF, Mat.Grass)
		end
		-- 다리(강철 아치 + 상판)
		local steel = rgb(150, 140, 120)
		local span = { V(2.05, 0.4, -3.4), V(2.55, 1.05, -3.4), V(3.05, 1.05, -3.4), V(3.55, 0.4, -3.4) }
		for k = 1, 3 do
			beam(c, span[k], span[k + 1], 0.18, steel, Mat.Metal)
		end
		box(c, 2.8, front, -3.4, 1.8, 0.18, 0.6, steel, Mat.Metal)
		-- 피어오르는 물보라("천둥 치는 연기") + 무지개(빨강·노랑·파랑 호)
		ball(c, -2.6, 4.9, 0.1, 2.8, WHITE, Mat.SmoothPlastic, 0.7)
		ball(c, 2.4, 5.3, 0.3, 2.4, WHITE, Mat.SmoothPlastic, 0.72)
		local bands = { { 2.2, rgb(255, 90, 90) }, { 1.95, rgb(255, 225, 80) }, { 1.7, rgb(90, 160, 255) } }
		for _, band in bands do
			local points = {}
			for k = 0, 4 do
				local a = k / 4 * PI
				table.insert(points, V(-2.3 + band[1] * math.cos(a), 0.4 + band[1] * math.sin(a) * 1.3, -0.4))
			end
			for k = 1, 4 do
				beam(c, points[k], points[k + 1], 0.2, band[2], Mat.Neon, 0.3)
			end
		end
	end

	-- 세렝게티: 황금빛 풀밭 + 우산 아카시아 + 사자가 올라앉은 화강암 바위 언덕(코피) + 기린 + 얼룩말 + 누 떼 + 지는 해
	B.serengeti = function(c)
		box(c, 0, 0, 0, 9.8, 0.25, 9.8, c.P, Mat.Grass)
		box(c, -2.4, 0.25, 2.2, 3.8, 0.05, 3.2, mix(c.S, c.P, 0.45), Mat.Grass)
		box(c, 2.6, 0.25, -1.4, 3.4, 0.05, 2.6, mix(c.S, c.P, 0.45), Mat.Grass)
		cyl(c, CFrame.new(1.2, 2.2, 4.9) * ALONG_Z, 0.1, 3.4, c.A, Mat.Neon)
		-- 코피 + 사자(정면을 보고 앉음: 몸 + 갈기 + 얼굴)
		local granite = rgb(150, 140, 126)
		ball(c, -3.3, 1.25, 3.4, 2.5, granite)
		ball(c, -1.8, 0.95, 3.9, 1.9, mix(granite, BLACK, 0.12))
		block(c, CFrame.new(-2.7, 2.35, 3) * CFrame.Angles(0, 0.3, 0.1), V(2.4, 0.45, 1.5), granite)
		local lion, mane = rgb(214, 168, 92), rgb(140, 82, 38)
		box(c, -2.7, 2.55, 3.2, 0.6, 0.65, 1.1, lion)
		ball(c, -2.7, 3.35, 2.75, 0.9, mane)
		ball(c, -2.7, 3.3, 2.4, 0.5, lion)
		-- 아카시아
		acacia(c, 2.3, 0.25, 2.4, 2.8, 3.2, c.S, 0.4)
		acacia(c, -3.7, 0.25, -1.2, 2, 2.4, c.S, 0.35)
		acacia(c, 3.4, 0.25, -3.6, 1.5, 2, c.S, 0.2)
		-- 기린 + 얼룩말(흰 몸 + 검은 줄) + 누 떼
		giraffe(c, 0.4, 0.25, 0.8, PI / 2 + 0.4, 1)
		local cf = CFrame.new(-0.8, 0.25, -2.4) * CFrame.Angles(0, -PI / 2 + 0.3, 0)
		block(c, cf * CFrame.new(0, 0.42, -0.36), V(0.42, 0.84, 0.14), WHITE)
		block(c, cf * CFrame.new(0, 0.42, 0.36), V(0.42, 0.84, 0.14), WHITE)
		block(c, cf * CFrame.new(0, 1.05, 0), V(0.52, 0.5, 1.15), WHITE)
		for _, dz in { -0.25, 0.05, 0.35 } do
			block(c, cf * CFrame.new(0, 1.05, dz), V(0.56, 0.54, 0.1), BLACK)
		end
		beam(c, cf * V(0, 1.1, -0.45), cf * V(0, 1.75, -0.85), 0.28, WHITE)
		local gnu = rgb(70, 66, 62)
		for _, g in { { -3.9, -3.8 }, { -2.7, -4.1 }, { -3.3, -3 }, { -1.9, -3.4 } } do
			block(c, CFrame.new(g[1], 0.75, g[2]) * CFrame.Angles(0, 0.3, 0), V(0.8, 0.5, 0.42), gnu)
			block(c, CFrame.new(g[1] + 0.45, 0.8, g[2] + 0.15) * CFrame.Angles(0, 0.3, 0.5), V(0.4, 0.28, 0.26), gnu)
		end
	end

	-- 사하라 사막: 칼날 능선의 모래언덕 셋(볕 든 면 / 그늘 면) + 야자수 오아시스 + 투아레그 사람을 태운 낙타 대상
	B.sahara = function(c)
		local shade = mix(c.S, rgb(120, 60, 30), 0.3)
		box(c, 0, 0, 0, 9.8, 0.25, 9.8, c.P, Mat.Sand)
		-- 큰 모래언덕: 왼쪽 뒤 꼭대기에서 오른쪽 앞으로 길게 내려오는 칼날 능선(볕 든 면 / 그늘 면)
		local lit = mix(c.P, WHITE, 0.12)
		local H, F = V(-3.2, 4.6, 4.2), V(4, 0.25, -0.2)
		tri(c, H, F, V(-4.8, 0.25, 0.8), lit, Mat.Sand, 0.3)
		tri(c, H, V(-4.8, 0.25, 0.8), V(-4.8, 0.25, 4.8), mix(lit, shade, 0.25), Mat.Sand, 0.3)
		tri(c, H, F, V(4.8, 0.25, 4.8), shade, Mat.Sand, 0.3)
		-- 낮은 모래 물결(완만한 비탈 하나) + 바람 자국
		wedge(c, CFrame.new(-3.4, 0.45, -3.6) * CFrame.Angles(0, -0.2, 0), V(2.6, 0.4, 1.6), lit, Mat.Sand)
		block(c, CFrame.new(0.2, 0.27, -3.5) * CFrame.Angles(0, 0.1, 0), V(3.4, 0.04, 0.08), shade, Mat.Sand)
		-- 오아시스
		col(c, 2.9, 0.25, -3.2, 0.08, 3.2, c.A, Mat.Grass)
		col(c, 2.9, 0.3, -3.2, 0.08, 2.2, WATER, Mat.Glass, 0.1)
		palm(c, 3.3, 0.25, -2.2, 2.8, c.A, 0.3)
		palm(c, 1.8, 0.25, -3.7, 2.2, c.A, 0.9)
		-- 낙타 대상(오른쪽 = -X 로 걸어감)
		local fur = rgb(196, 150, 96)
		local function camel(x, z)
			local cf = CFrame.new(x, 0.25, z) * CFrame.Angles(0, PI / 2, 0)
			block(c, cf * CFrame.new(0, 0.55, -0.42), V(0.5, 1.1, 0.16), fur)
			block(c, cf * CFrame.new(0, 0.55, 0.45), V(0.5, 1.1, 0.16), fur)
			block(c, cf * CFrame.new(0, 1.35, 0), V(0.55, 0.55, 1.3), fur)
			local hump = cf * V(0, 1.65, 0.1)
			ball(c, hump.X, hump.Y, hump.Z, 0.75, fur)
			beam(c, cf * V(0, 1.35, -0.6), cf * V(0, 2.2, -0.95), 0.28, fur)
			block(c, cf * CFrame.new(0, 2.25, -1.15), V(0.3, 0.3, 0.55), fur)
		end
		camel(-2.8, -1.7)
		camel(-0.6, -1.4)
		camel(1.4, -1.1)
		col(c, -2.7, 1.9, -1.7, 0.9, 0.5, rgb(40, 70, 160), Mat.Fabric)
		ball(c, -2.7, 3, -1.7, 0.42, rgb(30, 50, 120), Mat.Fabric)
	end

	-- 아부심벨 대신전: 사암 절벽을 깎은 정면(위쪽 개코원숭이 띠) + 앉은 람세스 2세 거상 넷(네메스 두건, 이중관, 수염;
	--   정면에서 왼쪽 두 번째는 부서져 머리가 발치에 떨어져 있음) + 가운데 문 + 문 위 라-호라크티 신상과 태양 원반 + 나세르 호수
	B.abusimbel = function(c)
		local cliff = mix(c.P, c.S, 0.75)
		local nemes = mix(c.P, WHITE, 0.25)
		box(c, 0, 0, 0, 9.8, 0.3, 9.8, mix(c.P, SAND, 0.4), Mat.Sand)
		box(c, 0, 0, -4.3, 9.8, 0.34, 1.2, WATER, Mat.Glass, 0.1)
		box(c, 0, 0.3, 0.1, 9.6, 0.4, 3.6, c.S)
		box(c, 0, 0.3, 3.1, 9.8, 8.4, 3.4, cliff)
		box(c, 0, 8.1, 1.3, 9.4, 0.6, 0.3, c.S)
		box(c, 0, 7.8, 1.3, 9.4, 0.15, 0.3, c.A)
		box(c, 0, 0.7, 1.35, 1.1, 2.8, 0.1, DARK)
		box(c, 0, 3.9, 1.35, 1.2, 2.4, 0.1, mix(cliff, BLACK, 0.35))
		col(c, 0, 3.9, 1.2, 1.7, 0.55, c.P)
		cyl(c, CFrame.new(0, 6.05, 1.15) * ALONG_Z, 0.12, 0.75, c.A, Mat.Neon)
		local y0 = 0.7
		local function colossus(x, broken)
			for _, side in { -1, 1 } do
				box(c, x + side * 0.42, y0, -0.9, 0.62, 2.6, 0.9, c.P)
			end
			box(c, x, y0 + 2.6, -0.05, 1.8, 0.6, 2.6, c.P)
			if broken then
				box(c, x, y0 + 3.2, 0.7, 1.7, 1, 1.2, c.P)
				block(c, CFrame.new(x - 0.3, 0.95, -2.3) * CFrame.Angles(0.2, 0.5, PI / 2 - 0.2), V(1.05, 1.3, 1), c.P)
				return
			end
			box(c, x, y0 + 3.2, 0.7, 1.7, 2.3, 1.2, c.P)
			box(c, x, y0 + 4.9, 0.8, 2.05, 1.9, 1.1, nemes)
			box(c, x, y0 + 5.4, 0.35, 1.05, 1.35, 0.9, c.P)
			box(c, x, y0 + 5, -0.05, 0.3, 0.55, 0.3, c.P)
			col(c, x, y0 + 6.75, 0.6, 1.15, 0.8, nemes)
		end
		colossus(3.7, false)
		colossus(1.55, true)
		colossus(-1.55, false)
		colossus(-3.7, false)
	end

	-- 투탕카멘의 황금 가면: 사암 받침 + 황금 가슴과 층층이 좁아지는 보석 목깃 + 파란 줄무늬 네메스 두건(양옆으로 벌어진 날개,
	--   앞으로 늘어진 두 자락) + 금빛 얼굴(검은 눈화장, 코, 입) + 땋은 파란 수염 + 이마의 코브라·독수리
	B.tutankhamun = function(c)
		local gold, lapis = c.P, c.S
		local face = mix(c.P, WHITE, 0.1)
		box(c, 0, 0, 0.4, 6.8, 1, 4.4, c.A, Mat.Sandstone)
		box(c, 0, 1, 0.7, 6, 2.4, 2.6, gold)
		for k, band in { { 5.8, lapis }, { 5, rgb(64, 180, 190) }, { 4, rgb(190, 70, 50) }, { 2.8, lapis } } do
			box(c, 0, 3.4 - k * 0.4, -0.64, band[1], 0.4, 0.1, band[2])
		end
		-- 네메스: 뒤통수 덩어리 + 둥근 윗부분 + 벌어진 양옆 날개(줄무늬) + 윗머리 줄무늬 + 앞 자락(줄무늬)
		box(c, 0, 3.4, 0.8, 3.6, 3.8, 2.6, gold)
		box(c, 0, 7.2, 0.8, 3, 0.5, 2.3, gold)
		for _, sx in { -1, 1 } do
			local flap = CFrame.new(sx * 2.05, 5.1, -0.1) * CFrame.Angles(0, 0, sx * 0.2)
			block(c, flap, V(1.3, 3.4, 1.6), gold)
			for _, dy in { -1.15, -0.25, 0.65 } do
				block(c, flap * CFrame.new(0, dy, -0.82), V(1.34, 0.3, 0.06), lapis)
			end
			box(c, sx * 1.55, 1.2, -0.72, 0.8, 2.3, 0.3, gold)
			for _, y in { 1.7, 2.6 } do
				box(c, sx * 1.55, y, -0.9, 0.84, 0.3, 0.06, lapis)
			end
		end
		box(c, 0, 6.95, -0.52, 3.4, 0.28, 0.1, lapis)
		box(c, 0, 7.4, -0.37, 2.9, 0.22, 0.1, lapis)
		-- 얼굴
		box(c, 0, 4, -0.75, 2.3, 2.7, 0.9, face)
		box(c, 0, 6.5, -0.78, 2.5, 0.35, 0.96, gold)
		for _, sx in { -1, 1 } do
			box(c, sx * 0.55, 5.3, -1.22, 0.62, 0.3, 0.06, WHITE)
			box(c, sx * 0.55, 5.32, -1.26, 0.26, 0.26, 0.04, BLACK)
			block(c, CFrame.new(sx * 0.6, 5.85, -1.23) * CFrame.Angles(0, 0, sx * -0.12), V(0.8, 0.14, 0.06), lapis)
		end
		wedge(c, CFrame.new(0, 5.05, -1.35), V(0.42, 0.8, 0.3), face)
		box(c, 0, 4.4, -1.22, 0.7, 0.14, 0.06, rgb(170, 70, 50))
		beam(c, V(0, 4.1, -0.95), V(0, 2.75, -1.3), 0.45, lapis)
		col(c, 0, 6.6, -1.3, 0.6, 0.26, gold)
		ball(c, 0, 7.25, -1.3, 0.36, gold)
	end

	-- 사하라의 눈(리샤트 구조): 사막 한가운데 밝고 어두운 띠가 번갈아 도는 거대한 과녁 모양 돔(안쪽으로 갈수록 조금씩 높음)
	--   + 가장자리로 밀려드는 주황 모래언덕
	B.richat = function(c)
		box(c, 0, 0, 0, 9.8, 0.2, 9.8, mix(c.P, SAND, 0.35), Mat.Sand)
		local rings = {
			{ 9.4, c.S },
			{ 8.3, c.A },
			{ 7.3, c.S },
			{ 6.2, c.P },
			{ 5.1, c.S },
			{ 4, c.A },
			{ 2.9, c.S },
			{ 1.8, c.P },
			{ 0.8, c.A },
		}
		for k, r in rings do
			col(c, 0, 0.2, 0, 0.15 + k * 0.14, r[1], r[2], if r[2] == c.S then Mat.Rock else Mat.Sand)
		end
		for _, d in { { 3.7, -3.7, 2, 0.6, 0.8 }, { 4, -2.4, 1.4, 0.4, 0.8 }, { 2.4, -4, 1.4, 0.4, 0.8 } } do
			wedge(
				c,
				CFrame.new(d[1], 0.2 + d[4] / 2, d[2]) * CFrame.Angles(0, d[5], 0),
				V(d[3], d[4], 1),
				mix(c.P, rgb(230, 120, 50), 0.3),
				Mat.Sand
			)
		end
	end

	-- 그레이트 짐바브웨: 풀밭 위 타원형으로 휘어 도는 높은 마른돌 성벽(대 울타리, 앞쪽에 입구, 앞 왼쪽 벽 윗부분의 V자 띠 장식)
	--   + 안쪽의 평행 성벽과 원뿔 탑 + 돌기둥 위의 짐바브웨 새 + 바위 언덕 + 나무
	B.greatzimbabwe = function(c)
		box(c, 0, 0, 0, 9.8, 0.25, 9.8, mix(GRASS, SAND, 0.45), Mat.Grass)
		local cx, cz, a, b = 0.2, -0.3, 4, 3.5
		local n = 14
		local function point(t, scale)
			return V(cx + a * scale * math.cos(t), 0.25, cz + b * scale * math.sin(t))
		end
		for i = 0, n - 1 do
			if i ~= 8 then
				local t1, t2 = i / n * TAU, (i + 1) / n * TAU
				local p1, p2 = point(t1, 1), point(t2, 1)
				local tm = (t1 + t2) / 2
				local h = 2.7 + 0.5 * math.sin(tm)
				local mid = (p1 + p2) / 2 + V(0, h / 2, 0)
				local cf = CFrame.lookAt(mid, p2 + V(0, h / 2, 0))
				local len = (p2 - p1).Magnitude + 0.25
				block(c, cf, V(0.8, h, len), if i % 2 == 0 then c.P else mix(c.P, c.S, 0.25))
				-- 앞 왼쪽(+X, -Z) 벽의 V자 띠(바깥면)
				if i >= 11 then
					for k = -1, 1 do
						local chevron = cf * CFrame.new(-0.42, h / 2 - 0.45, k * len / 3) * CFrame.Angles(PI / 4, 0, 0)
						block(c, chevron, V(0.08, 0.34, 0.34), c.S)
					end
				end
			end
		end
		-- 안쪽 평행 성벽(뒤 왼쪽)
		for i = 1, 3 do
			local t1, t2 = i / n * TAU, (i + 1) / n * TAU
			local p1, p2 = point(t1, 0.74), point(t2, 0.74)
			local mid = (p1 + p2) / 2 + V(0, 1.1, 0)
			block(c, CFrame.lookAt(mid, p2 + V(0, 1.1, 0)), V(0.6, 2.2, (p2 - p1).Magnitude + 0.2), mix(c.P, c.S, 0.15))
		end
		-- 원뿔 탑
		local tx, tz = 1.3, 0.9
		col(c, tx, 0.25, tz, 2.2, 1.8, c.P)
		col(c, tx, 2.45, tz, 1.5, 1.4, c.P)
		col(c, tx, 3.95, tz, 1, 1, c.P)
		col(c, tx, 4.95, tz, 0.4, 0.66, c.P)
		-- 짐바브웨 새(돌기둥 위, 금빛)
		local bx, bz = -1.4, -0.9
		col(c, bx, 0.25, bz, 2.8, 0.5, c.S)
		block(c, CFrame.new(bx, 3.55, bz) * CFrame.Angles(0.25, 0, 0), V(0.45, 1.1, 0.6), c.A, Mat.Metal)
		ball(c, bx, 4.25, bz - 0.25, 0.42, c.A, Mat.Metal)
		wedge(c, CFrame.new(bx, 4.2, bz - 0.6) * CFrame.Angles(PI, 0, 0), V(0.16, 0.2, 0.35), c.A, Mat.Metal)
		-- 바위 언덕 + 나무
		ball(c, -4.1, 0.9, 4.1, 1.6, mix(c.S, ROCK, 0.3))
		ball(c, 4.2, 0.8, 4.2, 1.4, mix(c.S, ROCK, 0.3))
		plant(c, -4.2, 0.25, -4.1, 1.3, 1.3, LEAF)
		plant(c, 4.2, 0.25, -4, 1.1, 1.2, mix(LEAF, rgb(170, 90, 50), 0.3))
	end

	-- 헤라클레이온 해저 도시: 바닷속(투명한 물 덩어리) 모래 바닥 위의 붉은 화강암 거상(하피 신) + 무너진 신전(선 기둥, 부러진 기둥,
	--   쓰러진 기둥과 들보) + 검은 석비 + 작은 스핑크스 + 항아리 + 해초 + 물고기 + 햇살 줄기 + 수면 위의 작은 배
	B.heracleion = function(c)
		local stone = c.P
		local granite = rgb(170, 88, 76)
		local basalt = rgb(62, 64, 70)
		local surface = 7.7
		box(c, 0, 0, 0, 9.8, 0.3, 9.8, mix(c.P, SAND, 0.35), Mat.Sand)
		-- 거상(정면을 봄)
		local sx, sz = 1.6, 2.2
		box(c, sx, 0.3, sz, 1.9, 0.6, 1.5, stone)
		box(c, sx, 0.9, sz, 1.15, 2.4, 0.85, granite)
		box(c, sx, 3.3, sz, 1.6, 1.8, 0.9, granite)
		for _, side in { -1, 1 } do
			box(c, sx + side * 1, 2.5, sz, 0.4, 2.4, 0.55, granite)
		end
		box(c, sx, 5.1, sz - 0.05, 0.8, 0.9, 0.8, granite)
		box(c, sx, 4.9, sz + 0.15, 1.3, 1, 0.7, mix(granite, BLACK, 0.2))
		col(c, sx, 6, sz, 1.1, 0.7, granite)
		-- 무너진 신전
		box(c, -2.6, 0.3, 1.5, 4, 0.4, 3.4, stone)
		for _, p in { { -3.8, 0.3, 3.4 }, { -1.5, 0.3, 3 } } do
			col(c, p[1], 0.7, p[2], p[3], 0.65, stone)
			box(c, p[1], 0.7 + p[3], p[2], 0.95, 0.3, 0.95, stone)
		end
		col(c, -3.8, 0.7, 2.7, 1.2, 0.65, stone)
		cyl(c, CFrame.new(-2.2, 1.02, 2.6) * CFrame.Angles(0, 0.35, 0), 2.6, 0.62, stone)
		block(c, CFrame.new(-2.8, 0.62, -1.3) * CFrame.Angles(0, 0.45, 0.12), V(2.6, 0.5, 0.65), stone)
		-- 석비 + 스핑크스 + 항아리
		box(c, 3.6, 0.3, -0.6, 1, 2.2, 0.3, basalt)
		cyl(c, CFrame.new(3.6, 2.5, -0.6) * ALONG_Z, 0.3, 1, basalt)
		box(c, 0.2, 0.3, -2.4, 0.8, 0.6, 1.7, stone)
		box(c, 0.2, 0.6, -3.1, 0.75, 0.95, 0.65, stone)
		ball(c, 2.7, 0.62, -3.4, 0.64, rgb(180, 112, 72))
		ball(c, 3.4, 0.56, -3.9, 0.52, rgb(165, 100, 64))
		-- 해초
		for _, w in { { -4.3, -3, 2.2 }, { -3.8, -3.6, 1.6 }, { 4.3, 3.7, 2.4 } } do
			beam(c, V(w[1], 0.3, w[2]), V(w[1] - 0.25, 0.3 + w[3], w[2] - 0.15), 0.14, LEAF, Mat.Grass)
		end
		-- 물고기(몸 + 꼬리)
		local fish = rgb(255, 170, 60)
		for _, f in { { -0.8, 4.4, 0.4, 0.3 }, { -0.3, 5, 0.9, 0.3 }, { 3.3, 3.8, -2.2, -0.5 } } do
			local cf = CFrame.new(f[1], f[2], f[3]) * CFrame.Angles(0, f[4], 0)
			block(c, cf, V(0.55, 0.3, 0.2), fish)
			wedge(c, cf * CFrame.new(0.4, 0, 0) * CFrame.Angles(0, PI / 2, 0), V(0.1, 0.34, 0.28), fish)
		end
		-- 햇살 줄기
		for _, r in { { -1, 0.35 }, { 2.4, 0.3 } } do
			block(c, CFrame.new(r[1], 4, -0.4) * CFrame.Angles(0, 0, r[2]), V(0.5, 6.6, 0.1), c.A, Mat.Neon, 0.8)
		end
		-- 바닷물 + 수면 위의 배
		box(c, 0, 0.3, 0, 9.8, surface - 0.3, 9.8, c.S, Mat.Glass, 0.6)
		box(c, -2.6, surface, -3, 2, 0.35, 0.8, WOOD, Mat.Wood)
		col(c, -2.6, surface + 0.35, -3, 1.8, 0.1, WOOD, Mat.Wood)
		box(c, -2.4, surface + 0.8, -3, 0.9, 1.1, 0.05, WHITE, Mat.Fabric)
	end

	-- 알렉산드리아 도서관: 3단 기단 위 그리스식 신전(이오니아 기둥 열, 금빛 띠, 박공 지붕) + 기둥 사이로 보이는
	--   두루마리 가득한 서가 + 빛나는 문 + 앞의 두루마리 독서대 + 금빛 화로 둘
	B.libraryalex = function(c)
		local marble, gold, glow = c.P, c.S, c.A
		local scroll = rgb(236, 218, 172)
		box(c, 0, 0, 0, 9.8, 0.3, 9.8, mix(c.S, SAND, 0.5), Mat.Sandstone)
		for k = 0, 2 do
			box(c, 0, 0.3 + k * 0.3, 0.6 + k * 0.1, 9.2 - k * 0.6, 0.3, 7.6 - k * 0.6, marble)
		end
		box(c, 0, 1.2, 1.9, 6.4, 4.8, 3.8, mix(marble, gold, 0.15))
		-- 서가(두루마리 세 줄) + 빛나는 문
		for _, sx in { -1, 1 } do
			box(c, sx * 2, 1.4, -0.06, 2.1, 4.1, 0.12, WOOD, Mat.Wood)
			for k = 0, 2 do
				cyl(c, CFrame.new(sx * 2, 2 + k * 1.25, -0.3), 1.9, 0.42, scroll)
			end
		end
		box(c, 0, 1.2, -0.06, 1.2, 3.1, 0.12, glow, Mat.Neon)
		-- 기둥: 앞줄 6 + 양옆 3씩
		for _, x in { -3.5, -2.1, -0.7, 0.7, 2.1, 3.5 } do
			col(c, x, 1.2, -2, 4.8, 0.6, marble)
		end
		for _, sx in { -1, 1 } do
			for _, z in { -0.2, 1.6, 3.4 } do
				col(c, sx * 3.7, 1.2, z, 4.8, 0.6, marble)
			end
		end
		box(c, 0, 6, 0.8, 8, 0.7, 6.4, marble)
		box(c, 0, 6.2, -2.44, 8, 0.3, 0.1, gold)
		frontGable(c, 0, 6.7, 0.8, 8, 6.4, 1.6, marble)
		ball(c, 0, 8.45, -2.3, 0.5, gold, Mat.Metal)
		-- 화로 + 독서대(펼친 두루마리)
		for _, sx in { -1, 1 } do
			col(c, sx * 4, 0.3, -4, 1.2, 0.4, gold, Mat.Metal)
			ball(c, sx * 4, 1.8, -4, 0.7, glow, Mat.Neon)
		end
		box(c, 0, 0.3, -3.9, 0.3, 0.8, 0.3, WOOD, Mat.Wood)
		block(c, CFrame.new(0, 1.2, -3.9) * CFrame.Angles(-0.4, 0, 0), V(1.3, 0.05, 0.7), scroll)
		for _, sx in { -1, 1 } do
			col(c, sx * 0.7, 0.95, -3.9, 0.5, 0.2, scroll)
		end
	end

	-- 사하라 신기루 성: 땅에 닿지 않고 떠 있는 사암 섬(아래로 뾰족) 위의 흙벽 성채(톱니 성벽, 네 귀퉁이 둥근 탑, 가운데 성관 +
	--   신기루처럼 빛나는 유리 돔, 가느다란 첨탑) + 야자수 + 흘러내리는 모래 폭포 + 아래에 일렁이는 신기루 빛 고리 + 떠다니는 돌
	B.skyisland = function(c)
		local sand, stone = c.P, c.S
		local rock = Mat.Sandstone
		col(c, 0, 6.6, 0, 1.4, 9.4, stone, rock)
		col(c, 0.2, 5.2, -0.1, 1.4, 7.2, stone, rock)
		col(c, -0.1, 3.9, 0.2, 1.3, 5, mix(stone, BLACK, 0.1), rock)
		col(c, 0.1, 2.8, 0, 1.1, 2.8, mix(stone, BLACK, 0.15), rock)
		ball(c, 0.1, 2.6, 0, 1.4, mix(stone, BLACK, 0.2), rock)
		col(c, 0, 8, 0, 0.3, 9, sand, Mat.Sand)
		local g = 8.3
		-- 성벽 + 성문 + 앞 성벽 톱니
		box(c, 0, g, -3, 6.4, 1.8, 0.45, sand)
		box(c, 0, g, 3, 6.4, 1.8, 0.45, sand)
		box(c, -3, g, 0, 0.45, 1.8, 6.4, sand)
		box(c, 3, g, 0, 0.45, 1.8, 6.4, sand)
		box(c, 0, g, -3.25, 1, 1.3, 0.1, DARK)
		for _, x in { -2, -1, 1, 2 } do
			box(c, x, g + 1.8, -3, 0.5, 0.4, 0.45, sand)
		end
		-- 네 귀퉁이 탑
		for _, s in CORNERS do
			col(c, s[1] * 3, g, s[2] * 3, 3, 1.3, sand)
			col(c, s[1] * 3, g + 3, s[2] * 3, 0.4, 1.55, stone)
		end
		-- 성관 + 유리 돔 + 첨탑
		box(c, 0.4, g, 0.8, 2.8, 3.2, 2.8, sand)
		col(c, 0.4, g + 3.2, 0.8, 0.4, 2.4, stone)
		ball(c, 0.4, g + 4.1, 0.8, 2.3, c.A, Mat.Glass, 0.2)
		col(c, 0.4, g + 5.2, 0.8, 0.8, 0.15, c.A, Mat.Neon)
		col(c, -1.7, g, 1.9, 5.8, 0.7, sand)
		col(c, -1.7, g + 4.6, 1.9, 0.25, 1.1, stone)
		ball(c, -1.7, g + 6.1, 1.9, 0.75, c.A, Mat.Glass, 0.2)
		-- 야자수
		plant(c, 2, g, -1.8, 1.3, 1.1, LEAF)
		plant(c, -1.9, g, -1.6, 1, 0.9, LEAF)
		-- 모래 폭포 + 신기루 빛 고리 + 떠다니는 돌
		box(c, 3.9, 1.6, -2.4, 0.6, 6.4, 0.3, sand, Mat.Sand, 0.35)
		col(c, 0, 0.6, 0, 0.08, 7.4, c.A, Mat.Neon, 0.75)
		col(c, 0, 1.2, 0, 0.08, 4.6, c.A, Mat.Neon, 0.65)
		ball(c, 4.3, 6.2, 2.6, 0.9, stone, rock)
		ball(c, -4.3, 9.6, -1.2, 0.7, stone, rock)
	end

	return B
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">Americas</string>
            <string name="Source"><![CDATA[-- 아메리카 명소 전용 모형. Models/init.luau 가 K(파트 헬퍼·색·기존 모양)를 넘겨 호출합니다.
-- 규칙: 바닥 10x10 안, 높이 22 이하, 바닥 y = 0, 정면 -Z, 파트 45개 이하. c.P/c.S/c.A = 명소 주/보조/강조 색, c.M = 재질.
-- 버킹엄 분수(fountain) · 자유의 여신상(statue) · 치첸이트사(steps) 는 원래 그 명소를 위해 만든 모양을 그대로 씀.

return function(K)
	local B = {}

	local V, rgb, Mat, PI = K.V, K.rgb, K.Mat, K.PI
	local ALONG_Z = K.ALONG_Z
	local GRASS, LEAF, WATER, DARK = K.GRASS, K.LEAF, K.WATER, K.DARK
	local ROCK, WOOD, SAND, CLOUD, BLACK, WHITE = K.ROCK, K.WOOD, K.SAND, K.CLOUD, K.BLACK, K.WHITE
	local mix, block, box, ball, cyl, col, wedge, beam = K.mix, K.block, K.box, K.ball, K.cyl, K.col, K.wedge, K.beam
	local facing, gable, plant = K.facing, K.gable, K.plant

	-- a 에서 b 까지 이어지는 판: 가로 w(진행 방향의 오른쪽), 두께 t. a → b 는 수직이 아니어야 함
	local function slab(c, a, b, w, t, color, material, transparency)
		local mid = (a + b) / 2
		return block(c, CFrame.lookAt(mid, b), V(w, t, (b - a).Magnitude), color, material, transparency)
	end

	-- 원호 위의 판 조각들: 중심 (cx, cz), 반지름 r, 각 a0 → a1(0 = +Z, 시계 반대 = +X 쪽), n 토막.
	--   each(cf, chord, dir): cf = 원호 위 한 토막의 중심(y = 0, LookVector = 안쪽), chord = 토막 길이, dir = 바깥 방향
	local function around(cx, cz, r, a0, a1, n, each)
		for i = 0, n - 1 do
			local p1 = a0 + (a1 - a0) * i / n
			local p2 = a0 + (a1 - a0) * (i + 1) / n
			local pm = (p1 + p2) / 2
			local dir = V(math.sin(pm), 0, math.cos(pm))
			local chord = 2 * r * math.sin(math.abs(p2 - p1) / 2)
			each(CFrame.new(cx + dir.X * r, 0, cz + dir.Z * r) * facing(-dir.X, -dir.Z), chord, dir, i)
		end
	end

	-- 게이트웨이 아치: 잔디 공원 + 뒤쪽 미시시피강(증기선) + 연못 두 개 + 땅에서 솟아 꼭대기로 가늘어지는 은빛 현수선 아치
	B.gatewayarch = function(c)
		box(c, 0, 0, 0, 9.8, 0.2, 9.8, GRASS, Mat.Grass)
		box(c, 0, 0, 4.2, 9.8, 0.26, 1.4, WATER, Mat.Glass, 0.1)
		box(c, 0, 0.2, 3.35, 9.8, 0.14, 0.3, mix(c.S, WHITE, 0.45), Mat.Concrete)
		box(c, 0, 0.2, -2.6, 1.3, 0.04, 4.6, mix(c.S, WHITE, 0.65), Mat.Concrete)
		block(c, CFrame.new(-2.7, 0.22, -2.7) * CFrame.Angles(0, 0.45, 0), V(1.1, 0.05, 2.6), WATER, Mat.Glass)
		block(c, CFrame.new(2.7, 0.22, -2.7) * CFrame.Angles(0, -0.45, 0), V(1.1, 0.05, 2.6), WATER, Mat.Glass)
		-- 현수선 y = foot + A(cosh k - cosh(kx/L)) 를 호 길이로 고르게 나눠 토막을 이음(발은 굵고 꼭대기는 가늚)
		local L, H, k, foot = 4.1, 11.5, 3, 0.3
		local A = (H - foot) / (math.cosh(k) - 1)
		local function point(x)
			return V(x, foot + A * (math.cosh(k) - math.cosh(k * x / L)), 0)
		end
		local samples, lengths = {}, { 0 }
		for i = 0, 300 do
			samples[i + 1] = point(-L + 2 * L * i / 300)
			if i > 0 then
				lengths[i + 1] = lengths[i] + (samples[i + 1] - samples[i]).Magnitude
			end
		end
		local total = lengths[#lengths]
		local n = 17
		local points = {}
		local j = 1
		for s = 0, n do
			local target = total * s / n
			while j < #lengths - 1 and lengths[j + 1] < target do
				j += 1
			end
			local t = math.clamp((target - lengths[j]) / (lengths[j + 1] - lengths[j]), 0, 1)
			points[s + 1] = samples[j] + (samples[j + 1] - samples[j]) * t
		end
		for s = 1, n do
			local a, b = points[s], points[s + 1]
			local u = math.abs((s - 0.5) / n * 2 - 1)
			local t = 0.42 + 0.55 * u
			block(c, CFrame.lookAt((a + b) / 2, b), V(t * 0.9, t, (b - a).Magnitude + 0.12), c.P, Mat.Metal)
		end
		for _, sx in { -1, 1 } do
			box(c, sx * L, 0.2, 0, 1.4, 0.12, 1.2, mix(c.S, WHITE, 0.5), Mat.Concrete)
			plant(c, sx * 4.2, 0.2, -4.1, 1.1, 1.3, LEAF)
			plant(c, sx * 4.2, 0.2, 2.3, 1.1, 1.3, LEAF)
		end
		-- 미시시피 증기선
		box(c, 2.4, 0.26, 4.2, 1.8, 0.3, 0.7, WHITE)
		box(c, 2.3, 0.56, 4.2, 1.2, 0.35, 0.55, mix(WHITE, c.A, 0.4))
		box(c, 3.35, 0.26, 4.2, 0.3, 0.5, 0.75, rgb(190, 50, 40))
	end

	-- 빵산: 과나바라만 바다 + 숲으로 덮인 우르카 언덕 + 넓은 밑동 위로 뒤로 살짝 기울어 솟은 둥근 화강암 봉우리
	--   + 두 구간 케이블카(노란 객차) + 해변 + 요트
	B.sugarloaf = function(c)
		local granite = c.P
		local forest = c.S
		local light = mix(c.P, WHITE, 0.12)
		box(c, 0, 0, 0, 9.8, 0.25, 9.8, WATER, Mat.Glass, 0.1)
		col(c, 1.3, 0, 1.5, 0.5, 7, forest, Mat.Grass)
		col(c, -3, 0, -2.4, 0.45, 3.8, forest, Mat.Grass)
		box(c, -3.9, 0.25, -4.25, 1.6, 0.1, 1, SAND, Mat.Sand)
		-- 봉우리: 촘촘히 겹친 공(아래는 넓고 위로 좁아지며 뒤로 기움) = 매끈한 돔
		for i = 0, 6 do
			local d = 6.2 - i * 0.47
			ball(c, 1.1 + i * 0.1, d / 2 + i * 1.02, 1.3 + i * 0.13, d, if i % 2 == 0 then granite else light)
		end
		-- 기슭 숲(왼쪽 어깨와 앞 기슭)
		for _, t in
			{
				{ -1.2, 1.2, 0.2, 2.2 },
				{ -0.9, 2.6, 1.8, 2 },
				{ 0.2, 1.1, -1.4, 2 },
				{ 2.6, 1, -1.3, 1.8 },
				{ 3.9, 1.3, 0.6, 2 },
				{ -0.2, 3.9, 2.6, 1.6 },
			}
		do
			ball(c, t[1], t[2], t[3], t[4], forest, Mat.Grass)
		end
		-- 우르카 언덕
		col(c, -3, 0.45, -2.4, 1.1, 3.4, mix(granite, forest, 0.3))
		ball(c, -3, 1.65, -2.4, 3.2, forest, Mat.Grass)
		-- 케이블카: 해변 역 → 우르카 → 빵산 꼭대기
		local base, mid, top = V(-4.1, 0.9, -4.3), V(-3, 3.7, -2.4), V(1.9, 10.6, 2.6)
		box(c, -4.1, 0.35, -4.3, 0.8, 0.6, 0.6, WHITE)
		box(c, -3, 3.2, -2.4, 1, 0.5, 0.8, WHITE)
		box(c, 1.9, 9.8, 2.6, 1.1, 0.6, 0.9, WHITE)
		beam(c, base, mid, 0.07, DARK)
		beam(c, mid, top, 0.07, DARK)
		for _, t in { { base, mid, 0.5 }, { mid, top, 0.45 } } do
			local p = t[1] + (t[2] - t[1]) * t[3]
			box(c, p.X, p.Y - 0.35, p.Z, 0.08, 0.35, 0.08, DARK)
			box(c, p.X, p.Y - 0.85, p.Z, 0.6, 0.5, 0.6, c.A)
		end
		-- 요트
		box(c, 3.4, 0.25, -3.6, 0.3, 0.2, 1, WHITE)
		wedge(c, CFrame.new(3.4, 1.05, -3.6), V(0.06, 1.4, 0.9), WHITE)
	end

	-- 백악관(남쪽 정면): 잔디 + 분수 + 흰 본관(창문 두 줄, 코니스, 난간) + 가운데 반원형 포티코(기둥 6, 트루먼 발코니) + 성조기
	B.whitehouse = function(c)
		local white = c.P
		local shade = mix(c.P, ROCK, 0.18)
		local window = rgb(60, 70, 85)
		box(c, 0, 0, 0, 9.8, 0.2, 9.8, c.S, Mat.Grass)
		box(c, 0, 0.2, -3, 1.2, 0.03, 3.6, mix(SAND, WHITE, 0.4), Mat.Concrete)
		col(c, 0, 0.2, -3.7, 0.3, 1.9, shade)
		col(c, 0, 0.3, -3.7, 0.22, 1.6, WATER, Mat.Glass)
		col(c, 0, 0.5, -3.7, 0.9, 0.2, c.A, Mat.Neon, 0.3)
		-- 본관
		box(c, 0, 0.2, 1.6, 8.8, 1.2, 3.8, shade)
		box(c, 0, 1.4, 1.6, 8.6, 2.6, 3.6, white)
		box(c, 0, 4, 1.6, 8.9, 0.4, 3.9, white)
		box(c, 0, 4.4, 1.6, 8.6, 0.4, 3.6, mix(white, ROCK, 0.08))
		box(c, 0, 4.4, 2, 7.2, 0.7, 2.4, rgb(150, 150, 150))
		for _, x in { -3.7, -2.75, 2.75, 3.7 } do
			box(c, x, 2, -0.23, 0.5, 0.9, 0.1, window)
			box(c, x, 3.2, -0.23, 0.5, 0.6, 0.1, window)
			box(c, x, 0.55, -0.23, 0.45, 0.55, 0.1, window)
		end
		-- 반원형 포티코
		local pz = -0.2
		col(c, 0, 0.2, pz, 1.2, 4.2, shade)
		box(c, 0, 0.2, pz - 2.1, 0.8, 0.9, 0.12, window)
		col(c, 0, 1.4, pz, 2.6, 2.9, mix(white, ROCK, 0.12))
		for k = 0, 5 do
			local angle = math.rad(-75 + k * 30)
			col(c, 1.8 * math.sin(angle), 1.4, pz - 1.8 * math.cos(angle), 2.6, 0.32, white)
		end
		col(c, 0, 2.6, pz, 0.12, 3.9, white)
		col(c, 0, 4, pz, 0.45, 4.2, white)
		col(c, 0, 4.45, pz, 0.35, 4, mix(white, ROCK, 0.08))
		-- 성조기
		col(c, 0, 5.1, 2, 2.1, 0.08, ROCK, Mat.Metal)
		box(c, 0.5, 6.5, 2, 0.9, 0.55, 0.05, rgb(200, 40, 50))
		box(c, 0.25, 6.77, 1.99, 0.4, 0.28, 0.05, rgb(40, 60, 140))
		plant(c, -3.9, 0.2, -3.6, 1.2, 1.8, LEAF)
		plant(c, 3.9, 0.2, -3.6, 1.2, 1.8, LEAF)
	end

	-- 나이아가라 폭포: 아래 강 + 윗단 강이 말굽 모양으로 휘어 쏟아지는 캐나다 폭포(물안개) + 숲이 있는 고트섬
	--   + 곧게 떨어지는 미국 폭포(바위 더미) + 캐나다 쪽 기슭과 스카이론 타워 + 폭포로 다가가는 유람선
	B.niagara = function(c)
		local deep = mix(c.P, rgb(20, 70, 130), 0.35)
		local foam = mix(c.A, c.P, 0.08)
		local cliff = mix(ROCK, rgb(150, 125, 95), 0.35)
		local top, front = 4.2, 0.2
		local hx, R = 1.3, 2
		box(c, 0, 0, 0, 9.8, 0.3, 9.8, deep, Mat.Glass, 0.1)
		-- 말굽: 원호를 따라 떨어지는 물(뒤로 조금 누워 빛을 받음) + 폭포로 흘러드는 윗단 물
		around(hx, front, R, math.rad(-100), math.rad(100), 6, function(cf, chord, _dir, i)
			local white = if i == 2 or i == 3 then WHITE else foam
			block(
				c,
				cf * CFrame.new(0, (0.3 + top) / 2, 0.15) * CFrame.Angles(0.12, 0, 0),
				V(chord + 0.14, top - 0.2, 0.25),
				white
			)
			block(c, cf * CFrame.new(0, top - 0.2, 0.75), V(chord * (R + 1.5) / R + 0.1, 0.4, 1.4), c.P)
		end)
		box(c, 1.6, 0.3, 3.6, 4.2, top - 0.65, 2.6, cliff)
		box(c, 1.6, top - 0.35, 3.6, 4.2, 0.35, 2.6, c.P)
		-- 고트섬(말굽 왼쪽)
		box(c, -1.4, 0.3, 2.55, 1.9, 4, 4.7, cliff)
		box(c, -1.4, 4.3, 2.55, 1.9, 0.25, 4.7, c.S, Mat.Grass)
		ball(c, -1.5, 5, 1.2, 1.4, LEAF, Mat.Grass)
		ball(c, -1.3, 5.1, 3.2, 1.6, LEAF, Mat.Grass)
		-- 캐나다 쪽 기슭(말굽 오른쪽) + 스카이론 타워
		box(c, 4.3, 0.3, 2.55, 1.2, 4, 4.7, cliff)
		box(c, 4.3, 4.3, 2.55, 1.2, 0.25, 4.7, c.S, Mat.Grass)
		box(c, 4.3, 0.3, -2.4, 1.2, 1.6, 5, cliff)
		box(c, 4.3, 1.9, -2.4, 1.2, 0.2, 5, c.S, Mat.Grass)
		col(c, 4.2, 4.55, 4, 6.4, 0.45, rgb(225, 225, 215), Mat.Concrete)
		col(c, 4.2, 10.4, 4, 0.9, 1.5, rgb(225, 225, 215), Mat.Concrete)
		col(c, 4.2, 11.3, 4, 0.9, 0.15, DARK)
		-- 미국 폭포 + 바위 더미
		box(c, -3.65, 0.3, 2.55, 2.5, 3.2, 4.7, cliff)
		box(c, -3.65, 3.5, 2.55, 2.5, 0.3, 4.7, c.P)
		block(c, CFrame.new(-3.65, 2.05, 0.05) * CFrame.Angles(0.18, 0, 0), V(2.5, 3.5, 0.25), WHITE)
		for _, t in { { -4.3, -0.5, 1.2 }, { -3.5, -0.6, 1 }, { -2.8, -0.45, 1.2 } } do
			ball(c, t[1], t[3] / 2 + 0.1, t[2], t[3], ROCK)
		end
		-- 물안개 + 유람선
		ball(c, hx, 1.6, -0.6, 2.6, CLOUD, Mat.SmoothPlastic, 0.65)
		ball(c, hx + 0.3, 4.4, 0.2, 2, CLOUD, Mat.SmoothPlastic, 0.7)
		box(c, 0.2, 0.3, -2.9, 0.7, 0.3, 1.5, WHITE)
		box(c, 0.2, 0.6, -2.8, 0.55, 0.35, 0.9, rgb(40, 90, 200))
	end

	-- 무지개산(비니쿤카): 갈색 고원 + 높이마다 색이 바뀌는 지층 띠를 두른 봉우리 셋(층마다 살짝 바깥으로 나온 박공.
	--   가운데 큰 봉우리는 정면에서 뾰족한 삼각형) + 오솔길 + 알파카
	B.rainbowmountain = function(c)
		local bands = {
			rgb(150, 65, 70),
			c.P,
			rgb(225, 150, 70),
			c.S,
			c.A,
			rgb(175, 130, 190),
			mix(c.P, WHITE, 0.25),
		}
		box(c, 0, 0, 0, 9.8, 0.2, 9.8, mix(rgb(170, 145, 95), GRASS, 0.25), Mat.Grass)
		local t = 1.15
		-- 봉우리: { x, z, 방향(yaw), 꼭대기 높이, 능선 길이, 기울기(반폭/높이) }
		for _, peak in
			{
				{ -2, 2.1, PI / 2 - 0.3, 5.4, 3.6, 0.45 },
				{ 1.8, 2, PI / 2 + 0.35, 6, 3.6, 0.42 },
				{ 0.2, 0, PI / 2 + 0.1, 8.6, 4.4, 0.37 },
			}
		do
			local cf = CFrame.new(peak[1], 0, peak[2]) * CFrame.Angles(0, peak[3], 0)
			local apex, len, s = peak[4], peak[5], peak[6]
			for k, color in bands do
				local y = 0.2 + (k - 1) * t
				local h = apex - y
				if h < 0.9 then
					break
				end
				local d = 2 * (s * h + 0.05 * (k - 1))
				local w = len + (k - 1) * 0.1
				wedge(c, cf * CFrame.new(0, y + h / 2, -d / 4), V(w, h, d / 2), color)
				wedge(c, cf * CFrame.new(0, y + h / 2, d / 4) * CFrame.Angles(0, PI, 0), V(w, h, d / 2), color)
			end
		end
		slab(c, V(-4.6, 0.22, -4.7), V(0.8, 0.22, -4.3), 0.5, 0.04, mix(SAND, WHITE, 0.2), Mat.Sand)
		-- 알파카(옆모습, +X 쪽을 봄)
		local wool = rgb(245, 238, 225)
		local ax, az = 2.9, -4.1
		box(c, ax, 0.2, az, 0.9, 0.6, 0.3, wool)
		box(c, ax, 0.8, az, 1.05, 0.55, 0.5, wool)
		box(c, ax + 0.5, 1.25, az, 0.25, 0.85, 0.28, wool)
		box(c, ax + 0.62, 2, az, 0.5, 0.3, 0.28, wool)
		box(c, ax, 1.35, az, 0.55, 0.06, 0.52, rgb(220, 50, 80))
	end

	-- 아레날 화산: 잔디 + 호수 + 아래는 숲, 위는 맨 바위인 매끈한 원뿔(층층 원기둥) + 붉은 용암 줄기 + 화구의 빛 + 연기
	B.arenal = function(c)
		box(c, 0, 0, 0, 9.8, 0.25, 9.8, mix(c.S, BLACK, 0.15), Mat.Grass)
		block(c, CFrame.new(-2.9, 0.27, -3.3) * CFrame.Angles(0, 0.4, 0), V(3.2, 0.06, 1.8), WATER, Mat.Glass, 0.1)
		local n = 12
		local height = 12.2
		local h = height / n
		local radii = {}
		for k = 0, n - 1 do
			local d = 1.4 + 7.9 * (1 - k / n) ^ 1.35
			radii[k + 1] = d / 2
			local color
			if k <= 1 then
				color = c.S
			elseif k == 2 then
				color = mix(c.S, c.P, 0.5)
			else
				color = if k % 2 == 0 then c.P else mix(c.P, WHITE, 0.08)
			end
			col(c, 0, 0.25 + k * h, 0, h, d, color, if k <= 2 then Mat.Grass else nil)
		end
		local peak = 0.25 + height
		col(c, 0, peak, 0, 0.1, 1.1, c.A, Mat.Neon)
		-- 용암 줄기: 층 모서리를 따라 내려옴
		local function corner(k, angle)
			local r = radii[k] + 0.02
			return V(math.sin(angle) * r, 0.25 + k * h, -math.cos(angle) * r)
		end
		for _, flow in { { 0.35, { 12, 10, 8, 6 } }, { -0.5, { 12, 10, 9 } } } do
			local angle, ks = flow[1], flow[2]
			for i = 1, #ks - 1 do
				beam(c, corner(ks[i], angle), corner(ks[i + 1], angle), 0.3, c.A, Mat.Neon)
			end
		end
		-- 연기
		ball(c, 0.2, peak + 1.2, 0.2, 1.6, rgb(150, 145, 140), Mat.SmoothPlastic, 0.3)
		ball(c, 0.8, peak + 2.6, 0.6, 2.2, rgb(170, 165, 160), Mat.SmoothPlastic, 0.35)
		ball(c, 1.8, peak + 4.3, 1.1, 2.8, rgb(190, 185, 180), Mat.SmoothPlastic, 0.4)
		-- 기슭 숲
		for i = 0, 6 do
			local angle = i / 7 * 2 * PI + 0.3
			ball(
				c,
				math.sin(angle) * 4.1,
				0.95,
				math.cos(angle) * 4.1,
				1.7,
				if i % 2 == 0 then LEAF else c.S,
				Mat.Grass
			)
		end
	end

	-- 티칼 1호 신전(거대한 재규어 신전): 밀림 + 광장 + 가파르고 좁은 9단 피라미드 + 정면 한 줄 계단
	--   + 꼭대기 신전(입구) + 높이 솟은 지붕 볏(루프 콤) + 기단을 가리는 밀림 수관
	B.tikal = function(c)
		local weathered = mix(c.P, DARK, 0.28)
		box(c, 0, 0, 0, 9.8, 0.25, 9.8, mix(c.S, BLACK, 0.2), Mat.Grass)
		box(c, 0, 0.25, 0.2, 7.6, 0.3, 7.4, mix(c.P, WHITE, 0.1))
		local y, z0, n, h = 0.55, 0.8, 9, 1.12
		for i = 0, n - 1 do
			local t = i / (n - 1)
			box(c, 0, y, z0, 6.4 - 3.2 * t, h, 5.8 - 2.8 * t, if i % 2 == 0 then c.P else mix(c.P, DARK, 0.14))
			y += h
		end
		wedge(c, CFrame.new(0, 0.55 + (y - 0.55) / 2, -1.9), V(1.5, y - 0.55, 2.4), mix(c.P, WHITE, 0.15))
		box(c, 0, y, 1, 2.8, 2, 2.2, c.P)
		box(c, 0, y, -0.12, 0.8, 1.3, 0.1, DARK)
		box(c, 0, y + 2, 1, 3, 0.3, 2.4, weathered)
		box(c, 0, y + 2.3, 1.4, 2.4, 2.6, 0.9, weathered)
		box(c, 0, y + 4.9, 1.4, 1.6, 0.9, 0.8, weathered)
		for _, t in
			{
				{ -3.6, -3.4, 2.6 },
				{ 3.6, -3.5, 2.6 },
				{ -3.6, 0.6, 2.8 },
				{ 3.6, 0.2, 2.8 },
				{ -3.3, 3.5, 3 },
				{ 3.4, 3.4, 3 },
				{ -1.6, -4.1, 1.6 },
				{ 1.7, -4.1, 1.6 },
			}
		do
			ball(c, t[1], t[3] / 2 + 0.35, t[2], t[3], if t[3] > 2.7 then LEAF else c.S, Mat.Grass)
		end
	end

	-- 이과수 폭포: 흙빛 강 + 뒤쪽을 넓게 감싸는 밀림 절벽(2단) + 절벽 틈마다 두 단으로 쏟아지는 흰 폭포 여러 줄기
	--   + 폭포 사이 수풀 + 물안개 + 폭포 쪽으로 뻗은 관람 데크
	B.iguazu = function(c)
		local deep = mix(c.P, rgb(120, 90, 55), 0.4)
		local foam = mix(c.P, WHITE, 0.85)
		local ledge = mix(c.S, c.A, 0.2)
		local top, mid = 5, 2.6
		local R = 5.5
		local falls = { [0] = true, [1] = true, [3] = true, [5] = true, [6] = true }
		box(c, 0, 0, 0, 9.8, 0.3, 9.8, deep, Mat.Glass, 0.1)
		around(0, -2.2, R, math.rad(-40), math.rad(40), 7, function(cf, chord, _dir, i)
			local height = if falls[i] then top else top + 0.9
			block(
				c,
				cf * CFrame.new(0, (0.3 + height) / 2, 0.5),
				V(chord * (R + 1) / R + 0.1, height - 0.3, 1),
				c.S,
				Mat.Grass
			)
			block(c, cf * CFrame.new(0, (0.3 + mid) / 2, -0.55), V(chord + 0.1, mid - 0.3, 1.1), ledge)
			if falls[i] then
				block(c, cf * CFrame.new(0, top + 0.05, 0.45), V(chord * 0.7, 0.14, 1.1), c.P)
				local upper = cf * CFrame.new(0, (mid + top + 0.12) / 2, -0.12) * CFrame.Angles(0.15, 0, 0)
				block(c, upper, V(chord * 0.7, top + 0.12 - mid, 0.16), foam)
				local lower = cf * CFrame.new(0, (0.3 + mid + 0.05) / 2, -1.2) * CFrame.Angles(0.15, 0, 0)
				block(c, lower, V(chord * 0.85, mid - 0.25, 0.16), foam)
			else
				local p = (cf * CFrame.new(0, height + 0.3, 0.4)).Position
				ball(c, p.X, p.Y, p.Z, 1.5, LEAF, Mat.Grass)
			end
		end)
		for _, t in { { -4.1, 0.2, 1.6 }, { 4.1, 0.1, 1.6 }, { -4.1, 2.2, 1.6 }, { 4.1, 2.2, 1.6 } } do
			ball(c, t[1], t[3] / 2 + 0.3, t[2], t[3], if t[2] > 1 then c.S else LEAF, Mat.Grass)
		end
		ball(c, 0, 1.3, 1.5, 2.4, CLOUD, Mat.SmoothPlastic, 0.7)
		ball(c, -2.3, 1.1, 1, 2, CLOUD, Mat.SmoothPlastic, 0.7)
		box(c, 1.3, 0.9, -1.9, 0.5, 0.12, 5.8, rgb(150, 150, 150), Mat.Metal)
		box(c, 1.52, 1.02, -1.9, 0.05, 0.3, 5.8, rgb(210, 210, 210), Mat.Metal)
	end

	-- 아마존 열대우림: 굽이치는 흙탕 강 + 빽빽한 밀림(여러 높이의 나무) + 우뚝 솟은 케이폭 나무 + 금강앵무 + 큰가시연잎 + 카누
	B.amazon = function(c)
		local ground = mix(c.P, BLACK, 0.35)
		local river = mix(c.S, rgb(175, 125, 70), 0.45)
		box(c, 0, 0, 0, 9.8, 0.3, 9.8, ground, Mat.Grass)
		local path = {
			V(-4.5, 0.3, 4.2),
			V(-2.2, 0.3, 2.4),
			V(0.2, 0.3, 1.2),
			V(1, 0.3, -1.3),
			V(3, 0.3, -2.8),
			V(4.4, 0.3, -3.4),
		}
		for i = 1, #path - 1 do
			local a, b = path[i], path[i + 1]
			local dir = (b - a).Unit
			local a2 = if i > 1 then a - dir * 0.5 else a
			local b2 = if i < #path - 1 then b + dir * 0.5 else b
			slab(c, a2 + V(0, 0.03, 0), b2 + V(0, 0.03, 0), 1.5, 0.06, river, Mat.Glass, 0.05)
		end
		for _, p in { { -1.4, 2 }, { 0.8, -0.3 }, { 2.4, -2.4 } } do
			col(c, p[1], 0.36, p[2], 0.06, 0.8, rgb(90, 160, 70), Mat.Grass)
		end
		block(c, CFrame.new(-0.5, 0.42, 1.6) * CFrame.Angles(0, 0.6, 0), V(0.3, 0.18, 1.3), WOOD, Mat.Wood)
		-- 밀림: { x, z, 줄기 높이, 잎 지름, 색 }
		local greens = { c.P, LEAF, mix(c.P, rgb(200, 200, 60), 0.3), mix(c.P, BLACK, 0.2) }
		for k, t in
			{
				{ -3.6, 0.8, 1.6, 2.6 },
				{ -1.6, -0.9, 2.2, 2.6 },
				{ -3.8, -2.6, 1.4, 2.2 },
				{ -1.8, -3.8, 1.2, 2 },
				{ 0.2, -3.9, 1.6, 1.8 },
				{ 2.4, 1.2, 1.8, 2.8 },
				{ 3.8, -0.4, 1.3, 2 },
				{ -0.6, 3.9, 1.4, 1.9 },
				{ 3.8, 3.8, 1.6, 2.2 },
			}
		do
			plant(c, t[1], 0.3, t[2], t[3], t[4], greens[(k - 1) % #greens + 1])
		end
		-- 케이폭: 판뿌리 + 긴 줄기 + 우산 모양 수관
		local kx, kz = 1.4, 2.5
		col(c, kx, 0.3, kz, 8.2, 0.6, WOOD, Mat.Wood)
		beam(c, V(kx - 0.9, 0.35, kz), V(kx, 2, kz), 0.3, WOOD, Mat.Wood)
		beam(c, V(kx + 0.8, 0.35, kz - 0.5), V(kx, 2, kz), 0.3, WOOD, Mat.Wood)
		col(c, kx, 8.4, kz, 0.9, 4.6, c.P, Mat.Grass)
		ball(c, kx - 0.8, 9.4, kz + 0.2, 2.2, LEAF, Mat.Grass)
		ball(c, kx + 0.9, 9.3, kz - 0.3, 2, mix(c.P, BLACK, 0.1), Mat.Grass)
		-- 금강앵무 두 마리
		for _, m in { { -1.2, 4.6, -1.6, 0.4 }, { 3.2, 6.5, 1.4, -0.5 } } do
			local p = V(m[1], m[2], m[3])
			ball(c, p.X, p.Y, p.Z, 0.45, c.A)
			beam(c, p + V(0, -0.1, 0.1), p + V(0.1, -0.7, 0.35), 0.12, c.A)
			block(c, CFrame.new(p) * CFrame.Angles(0, m[4], 0), V(1, 0.06, 0.3), rgb(40, 110, 220))
		end
	end

	-- 앙헬 폭포: 밀림 + 붉은 사암 테푸이(평평한 초록 꼭대기, 깎아지른 절벽, 가운데 움푹한 협곡) + 꼭대기 가장자리에서
	--   떨어지는 가느다란 긴 물줄기(아래로 갈수록 퍼짐) + 물보라 + 흘러나가는 강 + 절벽 허리의 구름 + 기슭 밀림 비탈
	B.angelfalls = function(c)
		local jungle = mix(c.S, BLACK, 0.25)
		local rock = c.P
		local light = mix(c.P, WHITE, 0.1)
		local cleft = mix(c.P, BLACK, 0.35)
		box(c, 0, 0, 0, 9.8, 0.3, 9.8, jungle, Mat.Grass)
		box(c, 0, 0.3, 3.2, 9.8, 16, 3.4, rock)
		box(c, -3.3, 0.3, 1.1, 3.2, 14.6, 1.6, light)
		box(c, 3.25, 0.3, 1, 3.3, 15.4, 1.8, light)
		box(c, -4.1, 7, 0.2, 1.6, 7.9, 0.4, rock)
		box(c, 4.1, 5, 0.05, 1.6, 10.7, 0.3, rock)
		box(c, -0.1, 0.3, 1.46, 3.2, 16, 0.1, cleft)
		box(c, 0, 16.3, 3.2, 9.6, 0.35, 3.2, c.S, Mat.Grass)
		box(c, -3.3, 14.9, 1.1, 3, 0.3, 1.4, c.S, Mat.Grass)
		box(c, 3.25, 15.7, 1, 3.1, 0.3, 1.6, c.S, Mat.Grass)
		ball(c, 2.6, 16.8, 3, 1.3, LEAF, Mat.Grass)
		-- 물줄기: 꼭대기 물길 → 가는 물줄기(빛남) → 아래로 퍼지는 물보라
		box(c, -0.1, 16.3, 2.3, 0.7, 0.42, 1.8, WATER)
		box(c, -0.1, 7.6, 1.15, 0.5, 9.1, 0.2, c.A, Mat.Neon, 0.1)
		box(c, -0.1, 3.4, 1.05, 0.8, 4.3, 0.25, c.A, Mat.Neon, 0.35)
		box(c, -0.1, 0.3, 0.95, 1.3, 3.2, 0.3, c.A, Mat.SmoothPlastic, 0.4)
		ball(c, -0.1, 1.3, 0.5, 2.4, CLOUD, Mat.SmoothPlastic, 0.55)
		ball(c, 0.9, 1, 0.1, 1.8, CLOUD, Mat.SmoothPlastic, 0.6)
		slab(c, V(-0.1, 0.33, 0.2), V(0.9, 0.33, -4.9), 1.1, 0.06, WATER, Mat.Glass, 0.05)
		-- 기슭 밀림 비탈 + 수관
		wedge(c, CFrame.new(-3.3, 1.45, -0.35), V(3.2, 2.3, 1.3), jungle, Mat.Grass)
		wedge(c, CFrame.new(3.25, 1.45, -0.45), V(3.3, 2.3, 1.3), jungle, Mat.Grass)
		for _, t in
			{
				{ -4, -2.6, 2 },
				{ -2.2, -3.4, 1.8 },
				{ -3.2, -4.1, 1.6 },
				{ 2.5, -3.1, 2 },
				{ 4, -1.8, 1.8 },
				{ 3.6, -4, 1.7 },
			}
		do
			ball(c, t[1], t[3] / 2 + 0.4, t[2], t[3], if t[3] >= 1.8 then LEAF else c.S, Mat.Grass)
		end
		-- 구름
		ball(c, -3.9, 10.2, -0.2, 2, CLOUD, Mat.SmoothPlastic, 0.4)
		ball(c, -2.7, 10.5, -0.5, 1.5, CLOUD, Mat.SmoothPlastic, 0.4)
		ball(c, 3.8, 8.4, -0.5, 2.2, CLOUD, Mat.SmoothPlastic, 0.4)
		ball(c, 2.7, 8.1, -0.7, 1.4, CLOUD, Mat.SmoothPlastic, 0.4)
	end

	-- 그레이트 블루홀: 청록 석호 + 모래 여울 + 둥근 산호초 테두리 + 바깥에서 안쪽으로 짙어지는 동그란 구멍 + 산호 덩이 + 다이빙 보트 + 야자수 모래톱
	B.bluehole = function(c)
		local lagoon = mix(c.S, rgb(40, 150, 200), 0.3)
		local flats = mix(c.S, WHITE, 0.45)
		local rim = mix(c.A, c.S, 0.25)
		box(c, 0, 0, 0, 9.8, 0.9, 9.8, mix(c.A, ROCK, 0.35), Mat.Sand)
		box(c, 0, 0.9, 0, 9.8, 0.4, 9.8, lagoon, Mat.Glass, 0.05)
		col(c, -3.3, 0.9, 3.4, 0.42, 2.6, flats, Mat.Sand)
		col(c, 3.6, 0.9, -1, 0.42, 2.2, flats, Mat.Sand)
		local cz = 0.3
		col(c, 0, 0.9, cz, 0.44, 7.6, rim, Mat.Sand)
		col(c, 0, 0.9, cz, 0.46, 6.6, mix(c.S, c.P, 0.45))
		col(c, 0, 0.9, cz, 0.48, 5.6, mix(c.S, c.P, 0.75))
		col(c, 0, 0.9, cz, 0.5, 4.2, c.P)
		col(c, 0, 0.9, cz, 0.52, 2.6, mix(c.P, BLACK, 0.35))
		for i = 0, 9 do
			local angle = i / 10 * 2 * PI + 0.2
			local color = if i % 3 == 0
				then rgb(200, 150, 100)
				elseif i % 3 == 1 then rgb(170, 120, 150)
				else rgb(220, 200, 120)
			ball(c, math.sin(angle) * 3.55, 1.3, cz + math.cos(angle) * 3.55, 0.5, color)
		end
		-- 다이빙 보트
		local boat = CFrame.new(3.4, 1.45, -3.3) * CFrame.Angles(0, 0.6, 0)
		block(c, boat, V(0.6, 0.3, 1.6), WHITE)
		block(c, boat * CFrame.new(0, 0.3, 0.2), V(0.5, 0.35, 0.6), rgb(40, 90, 180))
		-- 야자수 모래톱
		local px, pz = -3.5, -3.4
		col(c, px, 0.9, pz, 0.5, 1.8, SAND, Mat.Sand)
		beam(c, V(px, 1.4, pz), V(px + 0.4, 3.1, pz - 0.1), 0.18, WOOD, Mat.Wood)
		for k = 0, 3 do
			local rot = CFrame.new(px + 0.4, 3.05, pz - 0.1) * CFrame.Angles(0, k * PI / 2 + 0.4, 0)
			block(
				c,
				rot * CFrame.new(0, -0.15, -0.55) * CFrame.Angles(-0.35, 0, 0),
				V(0.35, 0.06, 1.2),
				LEAF,
				Mat.Grass
			)
		end
	end

	-- 올멕 거대 두상: 잔디 + 흙바닥 + 현무암 두상(정면에서 둥근 투구 + 이마 띠와 가운데 장식, 귀 덮개와 귀걸이,
	--   부은 볼, 무거운 눈꺼풀과 아몬드 눈, 넓적한 코, 두툼한 입술) + 밀림
	B.olmechead = function(c)
		local stone = c.P
		local helmet = mix(c.P, BLACK, 0.1)
		local deep = mix(c.P, BLACK, 0.5)
		box(c, 0, 0, 0, 9.8, 0.25, 9.8, c.S, Mat.Grass)
		box(c, 0, 0.25, 0.4, 7.8, 0.3, 7, mix(c.A, ROCK, 0.35), Mat.Ground)
		-- 얼굴 덩어리: 턱 + 볼 + 이마
		box(c, 0, 0.55, 0.7, 5.8, 3.4, 5, stone)
		ball(c, -1.8, 2.85, -0.55, 3.2, stone)
		ball(c, 1.8, 2.85, -0.55, 3.2, stone)
		box(c, 0, 3.9, 0.7, 6, 2.4, 5.2, stone)
		-- 투구: 정면에서 둥근 돔 + 이마 띠 + 장식 + 귀 덮개와 귀걸이
		cyl(c, CFrame.new(0, 6, 0.8) * ALONG_Z, 5.4, 6.8, helmet)
		box(c, 0, 5.8, -2.3, 6.5, 0.8, 0.4, helmet)
		box(c, 0, 5.7, -2.62, 1.2, 1.1, 0.3, mix(helmet, WHITE, 0.08))
		ball(c, 0, 7, -2.1, 1.1, helmet)
		for _, sx in { -1, 1 } do
			box(c, sx * 3.1, 1.6, 0.9, 0.6, 4.9, 3, helmet)
			cyl(c, CFrame.new(sx * 3.5, 3.1, 0.3), 0.35, 1.4, helmet)
			col(c, sx * 3.1, 1, 0.9, 0.7, 0.9, helmet)
			-- 아몬드 눈(눈꺼풀 + 어두운 눈)
			block(c, CFrame.new(sx * 1.35, 4.95, -2.13) * CFrame.Angles(0, 0, sx * 0.14), V(1.5, 0.45, 0.1), deep)
			block(c, CFrame.new(sx * 1.35, 5.25, -2.25) * CFrame.Angles(0, 0, sx * 0.14), V(1.7, 0.3, 0.3), stone)
		end
		-- 코 + 입술
		wedge(c, CFrame.new(0, 4, -2.45), V(1.7, 2, 0.9), stone)
		ball(c, -0.72, 3.3, -2.35, 0.95, stone)
		ball(c, 0.72, 3.3, -2.35, 0.95, stone)
		cyl(c, CFrame.new(0, 2.45, -2.1), 2.4, 0.75, stone)
		cyl(c, CFrame.new(0, 1.8, -2.05), 2.1, 0.75, stone)
		box(c, 0, 2.05, -2.45, 1.9, 0.12, 0.1, deep)
		plant(c, -4, 0.25, 3.8, 2.2, 1.8, LEAF)
		plant(c, 4, 0.25, 3.6, 1.8, 1.6, c.S)
		ball(c, -4.1, 0.8, -3.9, 1.4, LEAF, Mat.Grass)
		ball(c, 4.2, 0.7, -4, 1.2, c.S, Mat.Grass)
	end

	-- 엘도라도: 밀림 + 앞쪽 둥근 호수(과타비타)에 뜬 황금 뗏목과 황금 왕 + 뒤쪽 황금 도시
	--   (성벽과 문, 가운데 계단 피라미드 신전과 빛나는 태양 원반, 양쪽 황금 탑, 황금 집들) + 밀림 나무
	B.eldorado = function(c)
		local gold, deep, glow = c.P, c.S, c.A
		local jungle = rgb(50, 120, 60)
		box(c, 0, 0, 0, 9.8, 0.25, 9.8, mix(jungle, BLACK, 0.2), Mat.Grass)
		col(c, 0, 0.25, -3.1, 0.06, 3.4, WATER, Mat.Glass, 0.1)
		box(c, 0, 0.31, -3.1, 1.3, 0.14, 0.8, gold)
		col(c, 0, 0.45, -3.1, 0.7, 0.36, glow, Mat.Neon)
		ball(c, 0, 1.3, -3.1, 0.36, glow, Mat.Neon)
		ball(c, 0.9, 0.35, -2.4, 0.25, glow, Mat.Neon)
		-- 성벽 + 문
		box(c, -2.7, 0.25, -0.9, 3.8, 1, 0.4, deep)
		box(c, 2.7, 0.25, -0.9, 3.8, 1, 0.4, deep)
		box(c, -0.6, 0.25, -0.9, 0.5, 1.8, 0.6, gold)
		box(c, 0.6, 0.25, -0.9, 0.5, 1.8, 0.6, gold)
		box(c, 0, 2.05, -0.9, 1.8, 0.35, 0.7, gold)
		-- 계단 피라미드 신전 + 태양 원반
		local y = 0.25
		for _, w in { 4.8, 3.9, 3, 2.2 } do
			box(c, 0, y, 2.4, w, 1.1, w, if w == 3.9 or w == 2.2 then deep else gold)
			y += 1.1
		end
		wedge(c, CFrame.new(0, 0.25 + (y - 0.25) / 2, 0.55), V(1, y - 0.25, 1.3), glow)
		box(c, 0, y, 2.4, 1.5, 1.2, 1.5, gold)
		box(c, 0, y + 1.2, 2.4, 1.8, 0.3, 1.8, deep)
		cyl(c, CFrame.new(0, y + 2.8, 2.6) * ALONG_Z, 0.2, 2.4, glow, Mat.Neon)
		cyl(c, CFrame.new(0, y + 2.8, 2.7) * ALONG_Z, 0.15, 3, gold)
		-- 양쪽 황금 탑
		for _, sx in { -1, 1 } do
			col(c, sx * 3.6, 0.25, 2.6, 4.6, 1.3, gold)
			ball(c, sx * 3.6, 5, 2.6, 1.5, gold)
			col(c, sx * 3.6, 5.6, 2.6, 1, 0.14, glow)
			ball(c, sx * 3.6, 6.7, 2.6, 0.35, glow, Mat.Neon)
			box(c, sx * 2.4, 0.25, 0.5, 1.3, 1, 1.1, gold)
			gable(c, sx * 2.4, 1.25, 0.5, 1.4, 1.2, 0.6, deep)
			box(c, sx * 3.9, 0.25, 4.3, 1.2, 1.4, 1, deep)
		end
		plant(c, -4.1, 0.25, -1.8, 1.4, 1.5, jungle)
		plant(c, 4.1, 0.25, -2.2, 1.2, 1.4, LEAF)
		ball(c, -3.9, 0.9, -4, 1.4, LEAF, Mat.Grass)
		ball(c, 3.9, 0.8, -4.1, 1.3, jungle, Mat.Grass)
	end

	return B
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">Americas2</string>
            <string name="Source"><![CDATA[-- 아메리카(2) 명소 전용 모형. Models/init.luau 가 K(파트 헬퍼·색·기존 모양)를 넘겨 호출합니다.
-- 규칙: 바닥 10x10 안, 높이 22 이하, 바닥 y = 0, 정면 -Z, 파트 45개 이하. c.P/c.S/c.A = 명소 주/보조/강조 색, c.M = 재질.
-- 마추픽추(terraces) 는 원래 그 명소를 위해 만든 모양을 그대로 씀.

return function(K)
	local B = {}

	local V, rgb, Mat, PI, TAU = K.V, K.rgb, K.Mat, K.PI, K.TAU
	local UPRIGHT, ALONG_Z = K.UPRIGHT, K.ALONG_Z
	local GRASS, LEAF, WATER, DARK, TILE = K.GRASS, K.LEAF, K.WATER, K.DARK, K.TILE
	local ROCK, WOOD, SAND, CLOUD, BLACK, WHITE = K.ROCK, K.WOOD, K.SAND, K.CLOUD, K.BLACK, K.WHITE
	local mix, block, box, ball, cyl, col, wedge, beam = K.mix, K.block, K.box, K.ball, K.cyl, K.col, K.wedge, K.beam
	local archCorner, gable, plant = K.archCorner, K.gable, K.plant

	-- a 에서 b 까지 이어지는 원기둥(지름 d). a → b 는 수직이 아니어야 함
	local function rod(c, a, b, d, color, material, transparency)
		local mid = (a + b) / 2
		return cyl(
			c,
			CFrame.lookAt(mid, b) * CFrame.Angles(0, PI / 2, 0),
			(b - a).Magnitude,
			d,
			color,
			material,
			transparency
		)
	end

	-- 정면(-Z)에서 삼각형으로 보이는 봉우리(쐐기 두 개): 바닥 y, 꼭짓점에서 -X 쪽 폭 wl, +X 쪽 폭 wr, 깊이 d, 높이 h
	local function peak(c, x, y, z, wl, wr, d, h, color, material)
		wedge(c, CFrame.new(x - wl / 2, y + h / 2, z) * CFrame.Angles(0, PI / 2, 0), V(d, h, wl), color, material)
		wedge(c, CFrame.new(x + wr / 2, y + h / 2, z) * CFrame.Angles(0, -PI / 2, 0), V(d, h, wr), color, material)
	end

	-- 침엽수(원기둥 두 단)
	local function pine(c, x, y, z, h, d, color)
		col(c, x, y, z, h * 0.5, d, color, Mat.Grass)
		col(c, x, y + h * 0.45, z, h * 0.55, d * 0.55, color, Mat.Grass)
	end

	-- 꺾은선(점 목록 xs, ys)에서 x 위치의 높이
	local function along(xs, ys, x)
		for k = 1, #xs - 1 do
			if x >= xs[k] and x <= xs[k + 1] then
				local t = (x - xs[k]) / (xs[k + 1] - xs[k])
				return ys[k] + (ys[k + 1] - ys[k]) * t
			end
		end
		return ys[#ys]
	end

	-- 워싱턴 기념탑: 내셔널 몰 잔디(십자 산책로 + 앞쪽 반사 연못) + 둔덕 위 광장 + 둘레의 성조기
	--   + 아주 가늘고 높은 흰 대리석 오벨리스크(아래 1/4 은 색이 살짝 다름) + 피라미드 꼭대기 + 전망 창
	B.washingtonmonument = function(c)
		local path = rgb(226, 218, 200)
		local lower = mix(c.P, rgb(214, 196, 168), 0.45)
		box(c, 0, 0, 0, 9.8, 0.3, 9.8, GRASS, Mat.Grass)
		box(c, 0, 0.3, 0, 9.8, 0.04, 0.7, path, Mat.Concrete)
		box(c, 0, 0.3, 0, 0.7, 0.04, 9.8, path, Mat.Concrete)
		box(c, 0, 0.3, -3.95, 3.2, 0.16, 1.7, mix(c.P, ROCK, 0.3))
		box(c, 0, 0.3, -3.95, 2.8, 0.2, 1.3, WATER, Mat.Glass, 0.1)
		col(c, 0, 0.3, 0, 0.5, 6, mix(GRASS, LEAF, 0.2), Mat.Grass)
		col(c, 0, 0.8, 0, 0.15, 3.6, path, Mat.Concrete)
		local flags = { rgb(205, 50, 60), rgb(45, 65, 140) }
		for i = 0, 7 do
			local a = (i + 0.5) / 8 * TAU
			local x, z = 2.45 * math.cos(a), 2.45 * math.sin(a)
			col(c, x, 0.8, z, 1.8, 0.08, WHITE, Mat.Metal)
			box(c, x + 0.24, 2.05, z, 0.46, 0.3, 0.05, flags[i % 2 + 1], Mat.Fabric)
		end
		local y = 0.95
		for k, t in { { 2.1, 5 }, { 2, 4.6 }, { 1.88, 4.4 }, { 1.76, 4.4 } } do
			box(c, 0, y, 0, t[1], t[2], t[1], if k == 1 then lower else c.P)
			y += t[2]
		end
		for _, x in { -0.4, 0.4 } do
			box(c, x, y - 1.2, -0.89, 0.22, 0.4, 0.04, DARK)
		end
		for _, t in { { 1.45, 0.55 }, { 1.08, 0.55 }, { 0.7, 0.5 }, { 0.32, 0.45 } } do
			box(c, 0, y, 0, t[1], t[2], t[1], c.P)
			y += t[2]
		end
		ball(c, 0, y, 0, 0.2, c.A, Mat.Metal)
	end

	-- 브루클린 다리: 강 + 뒤쪽 맨해튼 빌딩 + 비스듬히 놓인 다리(아치 면과 케이블 옆모습이 함께 보이게)
	--   + 양 끝 석조 앵커리지 + 상판이 뚫고 지나가는 뾰족 고딕 아치 두 개짜리 화강암 탑 2개(코니스)
	--   + 탑 꼭대기에서 늘어진 주 케이블 + 탑에서 부챗살처럼 내려오는 사선 케이블(거미줄)
	B.brooklynbridge = function(c)
		local stone = c.P
		local steel = c.S
		local deckY, deckTop = 2.6, 3
		local tx, archTop, top = 2.2, 7.2, 8.8
		local ax = 3.9
		box(c, 0, 0, 0, 9.8, 0.25, 9.8, WATER, Mat.Glass, 0.1)
		for _, b in { { -3.9, 3.9, 1.6, 5.2 }, { -2.3, 4.2, 1.2, 3.6 }, { -4.1, 2.2, 1.2, 2.8 } } do
			box(c, b[1], 0.25, b[2], b[3], b[4], b[3], mix(steel, WHITE, 0.35), Mat.Concrete)
		end
		local rot = CFrame.Angles(0, -0.5, 0)
		c.origin = rot
		for _, sx in { -1, 1 } do
			box(c, sx * ax, 0.25, 0, 1.1, 2.9, 2.6, mix(stone, ROCK, 0.3))
		end
		box(c, 0, deckY, 0, 2 * ax, deckTop - deckY, 2.4, steel)
		for _, sx in { -1, 1 } do
			local x = sx * tx
			box(c, x, 0.25, 0, 1.2, deckY - 0.25, 3.6, stone)
			for _, z in { -1.58, 0, 1.58 } do
				box(c, x, deckY, z, 1, archTop - deckY, if z == 0 then 0.5 else 0.45, stone)
			end
			box(c, x, archTop, 0, 1, 1.4, 3.6, stone)
			box(c, x, archTop + 1.4, 0, 1.2, 0.35, 3.8, mix(stone, WHITE, 0.2))
			-- 뾰족 아치: 길이 방향이 X 인 개구부라 좌표계를 90도 돌려 archCorner 를 씀
			c.origin = rot * CFrame.new(x, 0, 0) * CFrame.Angles(0, PI / 2, 0)
			for _, w in { { -1.35, -0.25 }, { 0.25, 1.35 } } do
				archCorner(c, w[1], archTop, 0, 0.55, 1, stone, -1)
				archCorner(c, w[2], archTop, 0, 0.55, 1, stone, 1)
			end
			c.origin = rot
		end
		local xs = { -tx, -tx / 2, 0, tx / 2, tx }
		local ys = {}
		for k, x in xs do
			ys[k] = deckTop + 0.35 + (top - deckTop - 0.35) * (x / tx) ^ 2
		end
		for _, z in { -1.1, 1.1 } do
			for k = 1, 4 do
				rod(c, V(xs[k], ys[k], z), V(xs[k + 1], ys[k + 1], z), 0.18, steel)
			end
			for _, sx in { -1, 1 } do
				rod(c, V(sx * tx, top, z), V(sx * ax, 3.15, z), 0.18, steel)
				beam(c, V(sx * (tx - 0.3), top - 0.5, z), V(sx * 0.7, deckTop, z), 0.07, steel)
			end
		end
		c.origin = CFrame.new()
	end

	-- 금문교: 바다 + 뒤쪽 마린 헤드랜즈 언덕 + 양 끝 앵커리지 + 주황 상판
	--   + 다리 두 개가 위로 갈수록 가늘어지는 아르데코 탑(가로보 3단) + 크게 늘어진 주 케이블 + 수직 멜대
	B.goldengate = function(c)
		local red = c.P
		local concrete = rgb(205, 200, 190)
		local deckY, deckTop = 2.6, 3.1
		local tx, top = 2.7, 11.9
		box(c, 0, 0, 0, 9.8, 0.25, 9.8, WATER, Mat.Glass, 0.1)
		col(c, 3.5, 0.25, 3.5, 1.1, 2.8, mix(GRASS, SAND, 0.35), Mat.Grass)
		col(c, 3.7, 1.35, 3.7, 0.9, 1.6, mix(GRASS, SAND, 0.2), Mat.Grass)
		for _, sx in { -1, 1 } do
			box(c, sx * 4.5, 0.25, 0, 0.8, 3.1, 2.6, concrete)
		end
		box(c, 0, deckY, 0, 9.8, deckTop - deckY, 2.2, red)
		for _, sx in { -1, 1 } do
			local x = sx * tx
			box(c, x, 0.25, 0, 1.4, 0.9, 2.8, concrete)
			for _, sz in { -1, 1 } do
				box(c, x, 1.15, sz, 0.72, 5.4, 0.62, red)
				box(c, x, 6.55, sz, 0.56, top + 0.25 - 6.55, 0.5, red)
			end
			for _, s in { { 5.6, 0.5 }, { 8.5, 0.45 }, { 11.2, 0.7 } } do
				box(c, x, s[1], 0, 0.42, s[2], 1.6, red)
			end
		end
		local xs = { -tx, -tx / 2, 0, tx / 2, tx }
		local ys = {}
		for k, x in xs do
			ys[k] = deckTop + 0.35 + (top - deckTop - 0.35) * (x / tx) ^ 2
		end
		for _, z in { -1, 1 } do
			for k = 1, 4 do
				rod(c, V(xs[k], ys[k], z), V(xs[k + 1], ys[k + 1], z), 0.2, red)
			end
			for _, sx in { -1, 1 } do
				rod(c, V(sx * tx, top, z), V(sx * 4.5, 3.35, z), 0.2, red)
			end
			for _, x in { -2, -0.8, 0.8, 2 } do
				local y = along(xs, ys, x)
				box(c, x, deckTop, z, 0.06, y - deckTop, 0.06, red)
			end
		end
	end

	-- 피통스: 바다 + 뒤쪽 섬 해안 + 숲에 덮인 둥근 원뿔 봉우리 둘(왼쪽 넓은 그로 피통, 오른쪽 가파른 프티 피통, 드러난 바위 벽)
	--   + 두 봉우리 사이 모래 해변(야자수, 오두막) + 앞바다의 돛단배
	B.pitons = function(c)
		local green = c.P
		local dark = mix(c.P, BLACK, 0.3)
		local lush = mix(c.P, LEAF, 0.5)
		local rock = mix(ROCK, c.P, 0.25)
		local crag = mix(c.P, ROCK, 0.5)
		box(c, 0, 0, 0, 9.8, 0.3, 9.8, c.S, Mat.Glass, 0.1)
		box(c, 0, 0.3, 3.7, 9.8, 0.5, 2.4, dark, Mat.Grass)
		-- 봉우리: 얇게 쌓아 올린 원기둥 원뿔(조금씩 기울어짐) + 둥근 꼭대기 + 비탈의 숲 덩어리
		local function piton(x, z, base, top, height, layers, lean)
			local step = height / layers
			for k = 0, layers - 1 do
				local d = base + (top - base) * k / (layers - 1)
				local t = k / (layers - 1)
				local color = if t < 0.5 then mix(dark, green, t * 2) else mix(green, crag, (t - 0.5) * 2)
				col(c, x + lean * k, 0.3 + k * step, z, step + 0.02, d, color, Mat.Grass)
			end
			ball(c, x + lean * layers, 0.3 + height, z, top * 1.05, crag, Mat.Grass)
		end
		piton(-2.1, 1.4, 5.6, 1.3, 6.8, 6, 0.03)
		piton(2.6, -0.1, 4.4, 0.9, 7.2, 7, -0.04)
		for _, p in
			{
				{ -4.1, 1.6, 0.4, 1.4 },
				{ -1.1, 2.6, -0.8, 1.4 },
				{ -2.7, 4.2, -0.2, 1.2 },
				{ 1.4, 2.2, -0.6, 1.2 },
				{ 3.6, 3.4, -0.5, 1 },
				{ 2.3, 5, -0.4, 0.9 },
			}
		do
			ball(c, p[1], p[2], p[3], p[4], lush, Mat.Grass)
		end
		block(c, CFrame.new(-2, 3.6, -0.6) * CFrame.Angles(0.4, 0.15, 0), V(1.2, 2.4, 0.4), rock)
		block(c, CFrame.new(2.9, 4.4, -1.1) * CFrame.Angles(0.3, -0.5, 0), V(0.7, 2.4, 0.3), rock)
		box(c, 0.3, 0.3, -1.7, 2.4, 0.12, 1.3, SAND, Mat.Sand)
		plant(c, -0.3, 0.42, -1.5, 1.3, 0.8, LEAF)
		plant(c, 0.9, 0.42, -1.9, 1.1, 0.7, LEAF)
		box(c, 0.4, 0.42, -1.2, 0.6, 0.4, 0.5, WHITE)
		local boat = CFrame.new(0.8, 0.3, -3.5) * CFrame.Angles(0, 0.6, 0)
		block(c, boat * CFrame.new(0, 0.12, 0), V(0.5, 0.25, 1.5), WHITE)
		wedge(c, boat * CFrame.new(0, 0.25 + 0.9, 0.05), V(0.05, 1.8, 1.1), c.A)
	end

	-- 올드 페이스풀: 풀밭 + 흰 규화물(간헐천 둔덕) + 주황 미생물 물길 + 위로 갈수록 넓어지는 흰 물기둥
	--   + 꼭대기에서 부채꼴로 떨어지는 물보라 + 바람에 밀려 나는 수증기 구름
	--   + 앞쪽 나무 관람 데크와 관광객 + 로지폴 소나무 + 작은 온천 웅덩이
	B.oldfaithful = function(c)
		local sinter = c.P
		local steam = c.S
		local meadow = mix(GRASS, SAND, 0.45)
		local pineColor = rgb(40, 90, 55)
		local foam = mix(steam, c.A, 0.25)
		box(c, 0, 0, 0, 9.8, 0.3, 9.8, meadow, Mat.Grass)
		local vx, vz = 0, 0.6
		col(c, vx, 0.3, vz, 0.35, 6.6, mix(sinter, WHITE, 0.45), Mat.Rock)
		col(c, vx + 0.2, 0.65, vz, 0.35, 4.2, mix(sinter, WHITE, 0.25), Mat.Rock)
		col(c, vx, 1, vz, 0.35, 2.2, sinter, Mat.Rock)
		block(
			c,
			CFrame.new(-1.7, 0.33, -2.2) * CFrame.Angles(0, 0.5, 0),
			V(0.55, 0.1, 2.4),
			rgb(215, 130, 55),
			Mat.Ground
		)
		block(c, CFrame.new(1.9, 0.33, -2) * CFrame.Angles(0, -0.6, 0), V(0.45, 0.1, 2), rgb(200, 150, 70), Mat.Ground)
		-- 물기둥(위로 갈수록 넓고 옅어짐) + 밑의 물보라 + 떨어지는 물방울 + 바람에 밀려 나는 수증기
		col(c, vx, 1.35, vz, 0.8, 3.2, steam, Mat.Glass, 0.45)
		local y = 1.35
		for _, p in { { 2.4, 1.3, 0.05 }, { 3, 1.8, 0.12 }, { 2.6, 2.3, 0.2 }, { 1.4, 2.6, 0.35 } } do
			col(c, vx, y, vz, p[1], p[2], steam, Mat.Glass, p[3])
			y += p[1]
		end
		for i = 0, 5 do
			local a = i / 6 * TAU + 0.4
			local r = 1.5 + (i % 2) * 0.5
			ball(c, vx + r * math.cos(a), 4.6 + (i % 3) * 1.3, vz + r * math.sin(a), 0.45, foam, Mat.Glass, 0.2)
		end
		for _, p in
			{ { 0.3, 11.4, 3.3, 0.25 }, { 1.2, 13.6, 3.8, 0.35 }, { 2.1, 16, 3.6, 0.5 }, { 2.9, 18.3, 2.8, 0.65 } }
		do
			ball(c, vx + p[1], p[2], vz + 0.2, p[3], CLOUD, Mat.SmoothPlastic, p[4])
		end
		for _, a in { -0.62, 0, 0.62 } do
			block(c, CFrame.Angles(0, a, 0) * CFrame.new(0, 0.42, -4.1), V(2.6, 0.12, 0.6), WOOD, Mat.WoodPlanks)
		end
		for k, x in { -1.1, -0.2, 0.9 } do
			local shirt = ({ rgb(210, 60, 60), rgb(60, 110, 200), rgb(240, 190, 60) })[k]
			col(c, x, 0.48, -4.2, 0.55, 0.28, shirt)
			ball(c, x, 1.15, -4.2, 0.24, rgb(235, 200, 170))
		end
		for _, p in { { -3.8, 3.4, 3.6 }, { -2.3, 4.1, 3 }, { 3.9, 3.4, 3.2 }, { -4, 0.2, 2.4 } } do
			pine(c, p[1], 0.3, p[2], p[3], 1.1, pineColor)
		end
		col(c, 3.3, 0.3, -0.6, 0.06, 1.8, rgb(225, 150, 60), Mat.Ground)
		col(c, 3.3, 0.3, -0.6, 0.1, 1.3, c.A, Mat.Glass, 0.05)
	end

	-- 모레인 호수: 짙은 숲 바닥 + 청록 호수 + 앞의 바위 더미 + 빨간 카누
	--   + 뒤쪽 너덜 비탈과 산벽 + 들쭉날쭉한 텐 피크(앞줄 회색 바위, 뒷줄 눈 봉우리) + 호숫가 침엽수
	B.morainelake = function(c)
		local rock = c.S
		local snow = c.A
		local forest = rgb(38, 92, 60)
		box(c, 0, 0, 0, 9.8, 0.3, 9.8, mix(rock, LEAF, 0.45), Mat.Grass)
		box(c, 0.2, 0.3, -1.2, 7.2, 0.1, 5.4, c.P, Mat.Glass, 0.05)
		wedge(c, CFrame.new(0, 0.3 + 1.5, 2.3), V(9.8, 3, 1.6), mix(rock, WHITE, 0.15), Mat.Slate)
		box(c, 0, 0.3, 4, 9.8, 3.4, 1.8, rock, Mat.Slate)
		box(c, 1, 2.2, 3.08, 2.6, 0.8, 0.1, snow, Mat.Snow)
		for _, p in { { 2.9, 1.3, 1.4, 6.2 }, { 0.4, 1.3, 1.2, 6.8 }, { -2.3, 1.4, 1.3, 6 }, { -4.2, 0.7, 0.7, 5 } } do
			peak(c, p[1], 3.4, 4.4, p[2], p[3], 0.9, p[4], snow, Mat.Snow)
		end
		for _, p in { { 3.9, 1, 1, 3.6 }, { 1.7, 1.2, 1.2, 4.6 }, { -0.8, 1.3, 1.3, 4 }, { -3.4, 1.5, 1.3, 4.8 } } do
			peak(c, p[1], 3, 3.5, p[2], p[3], 0.8, p[4], rock, Mat.Slate)
		end
		for _, p in { { -3.4, -3.9, 1.3, 0.3 }, { -2.3, -4.1, 1, -0.4 }, { -4, -3.1, 0.9, 0.7 } } do
			block(
				c,
				CFrame.new(p[1], 0.3 + p[3] * 0.4, p[2]) * CFrame.Angles(0.2, p[4], 0.15),
				V(p[3], p[3] * 0.8, p[3]),
				ROCK,
				Mat.Slate
			)
		end
		local canoe = rgb(205, 45, 40)
		block(c, CFrame.new(1.4, 0.45, -2) * CFrame.Angles(0, 0.4, 0), V(0.32, 0.14, 1.3), canoe)
		block(c, CFrame.new(-0.6, 0.45, -2.8) * CFrame.Angles(0, -0.3, 0), V(0.32, 0.14, 1.3), canoe)
		for _, p in { { 4.3, -2.6 }, { 4.3, -0.6 }, { 4.4, 1.2 }, { -4.2, -2.8 }, { -4.3, -0.9 }, { -4.2, 0.9 } } do
			pine(c, p[1], 0.3, p[2], 2.4, 0.95, forest)
		end
	end

	-- 파나마 운하: 밀림 땅 + 계단처럼 한 단씩 높아지는 갑문 3칸(물 높이가 다른 두 줄 수로, 콘크리트 벽) + 갑문 문짝
	--   + 가운데 칸의 컨테이너선(선수, 색색의 컨테이너, 흰 선교) + 벽 위 전기 기관차(뮬)와 견인줄 + 관제탑 + 예인선
	B.panamacanal = function(c)
		local concrete = c.P
		local water = c.S
		box(c, 0, 0, 0, 9.8, 0.3, 9.8, mix(GRASS, LEAF, 0.4), Mat.Grass)
		local sections = { { -4.9, -2.4, 1 }, { -2.4, 2.4, 1.9 }, { 2.4, 4.9, 2.8 } }
		for _, s in sections do
			local cx, w, level = (s[1] + s[2]) / 2, s[2] - s[1], s[3]
			box(c, cx, 0.3, 0, w, level - 0.3, 5.6, water, Mat.Glass, 0.1)
			for _, z in { -3.2, 0, 3.2 } do
				box(c, cx, 0.3, z, w, level - 0.1, 0.8, concrete)
			end
		end
		local steel = rgb(70, 75, 85)
		for k, gx in { -2.4, 2.4 } do
			for _, z in { -1.6, 1.6 } do
				box(c, gx, 0.3, z, 0.25, sections[k + 1][3] - 0.05, 2.4, steel, Mat.Metal)
			end
		end
		-- 컨테이너선(앞 수로, 가운데 칸)
		local sz = -1.6
		local hull = rgb(45, 55, 75)
		box(c, 0.2, 1.3, sz, 3.4, 1.3, 1.7, hull, Mat.Metal)
		block(c, CFrame.new(-1.5, 1.95, sz) * CFrame.Angles(0, PI / 4, 0), V(1.2, 1.3, 1.2), hull, Mat.Metal)
		local boxes = {
			{ -1, 1.2, c.A },
			{ -0.15, 0.9, rgb(50, 110, 190) },
			{ 0.7, 1.2, rgb(190, 60, 50) },
		}
		for _, b in boxes do
			box(c, b[1], 2.6, sz, 0.8, b[2], 1.5, b[3], Mat.Metal)
		end
		box(c, 1.6, 2.6, sz, 0.6, 1.7, 1.6, WHITE)
		box(c, 1.75, 4.3, sz, 0.3, 0.45, 0.35, rgb(190, 60, 50))
		-- 유람선(뒤 수로, 가운데 칸)
		box(c, 0.3, 1.4, 1.6, 2.8, 0.9, 1.3, WHITE)
		box(c, 0.5, 2.3, 1.6, 2, 0.55, 1, mix(WHITE, WATER, 0.2))
		-- 뮬(전기 기관차)과 견인줄
		local silver = rgb(200, 205, 210)
		for _, z in { -3.2, 0 } do
			box(c, -1.6, 2.1, z, 0.7, 0.45, 0.5, silver, Mat.Metal)
			beam(c, V(-1.6, 2.45, z), V(-1.3, 2.5, sz + (if z < sz then -0.8 else 0.8)), 0.05, DARK)
		end
		-- 관제탑(가운데 벽, 높은 칸)
		box(c, 3.6, 3, 0, 1.2, 1.1, 1.2, WHITE)
		gable(c, 3.6, 4.1, 0, 1.4, 1.4, 0.55, rgb(175, 75, 55))
		-- 예인선(뒤 수로, 낮은 칸)
		box(c, -3.7, 0.8, 1.6, 1.4, 0.4, 0.8, rgb(200, 70, 50))
		box(c, -3.5, 1.2, 1.6, 0.6, 0.45, 0.6, WHITE)
		for _, p in { { -3.6, 4.4 }, { -1.2, 4.3 }, { 1.4, 4.4 }, { 3.8, 4.3 }, { -3, -4.3 }, { 2.6, -4.3 } } do
			ball(c, p[1], 0.9, p[2], 1.2, LEAF, Mat.Grass)
		end
	end

	-- 페리토 모레노 빙하: 우윳빛 청록 호수 + 뒤쪽 설산에서 흘러내려 호수에 닿는 거대한 빙하
	--   (높이·앞뒤가 들쭉날쭉한 푸른 얼음 절벽 + 꼭대기의 뾰족한 세락 + 뒤로 솟는 빙원) + 양옆 눈 덮인 바위산
	--   + 떠다니는 빙산 + 앞쪽 전망 반도(숲, 나무 데크) + 유람선
	B.peritomoreno = function(c)
		local ice = c.P
		local blue = c.S
		local deep = mix(blue, rgb(40, 90, 170), 0.35)
		local lake = rgb(105, 170, 190)
		local rockColor = rgb(120, 114, 108)
		box(c, 0, 0, 0, 9.8, 0.3, 9.8, lake, Mat.Glass, 0.1)
		box(c, 0, 0.3, 2.6, 8.2, 2.4, 4.8, ice, Mat.Ice)
		wedge(c, CFrame.new(0, 2.7 + 1.5, 3.6), V(8.2, 3, 2.8), ice, Mat.Ice)
		-- 얼음 절벽: { x, 폭, 높이, 앞면 z, 색 }
		local faces = {
			{ -3.3, 1.6, 2.5, -0.5, ice },
			{ -1.7, 1.7, 3, -0.9, mix(ice, blue, 0.3) },
			{ 0, 1.8, 2.6, -0.6, ice },
			{ 1.7, 1.7, 3.1, -1, mix(ice, blue, 0.4) },
			{ 3.3, 1.6, 2.4, -0.4, mix(ice, blue, 0.15) },
		}
		for _, f in faces do
			box(c, f[1], 0.3, (f[4] + 1) / 2, f[2], f[3], 1 - f[4], f[5], Mat.Ice)
		end
		for k, f in faces do
			local h = 0.8 + (k % 3) * 0.25
			local cf = CFrame.new(f[1] + (k % 2 - 0.5) * 0.4, 0.3 + f[3] + h / 2 - 0.3, f[4] + 0.35)
				* CFrame.Angles(0.15 * (k % 3 - 1), k * 0.7, 0.3 * ((k % 2) * 2 - 1))
			block(c, cf, V(0.7, h, 0.6), mix(ice, WHITE, 0.4), Mat.Ice)
		end
		for _, p in { { -2.6, 0.5 }, { 0.9, 0.7 }, { 2.6, 1.4 } } do
			block(c, CFrame.new(p[1], 2.8, p[2]) * CFrame.Angles(0, 0.6, 0.35), V(0.6, 0.8, 0.6), WHITE, Mat.Ice)
		end
		block(c, CFrame.new(-1.7, 1.6, -0.93) * CFrame.Angles(0, 0, 0.3), V(0.25, 2.2, 0.06), deep, Mat.Ice)
		block(c, CFrame.new(1.8, 1.8, -1.03) * CFrame.Angles(0, 0, -0.25), V(0.3, 2.4, 0.06), deep, Mat.Ice)
		for _, z in { 1.5, 2.2 } do
			box(c, 0, 2.7, z, 7.4, 0.04, 0.16, deep, Mat.Ice)
		end
		-- 양옆 바위산(눈 모자) + 뒤쪽 설산
		for _, sx in { -1, 1 } do
			local x = sx * 4.1
			local wl, wr = if sx > 0 then 1.6 else 0.8, if sx > 0 then 0.8 else 1.6
			local h, snow, lift = 5.4, 0.5, 0.12
			peak(c, x, 0.3, 2.8, wl, wr, 3, h, rockColor, Mat.Slate)
			local sh = h * snow + lift
			peak(c, x, 0.3 + h * (1 - snow), 2.75, wl * sh / h, wr * sh / h, 3.2, sh, WHITE, Mat.Snow)
		end
		peak(c, -1.4, 4.5, 4.55, 1.6, 1.5, 0.8, 3.2, mix(ice, WHITE, 0.5), Mat.Snow)
		peak(c, 1.5, 4.5, 4.55, 1.3, 1.6, 0.8, 2.6, mix(ice, WHITE, 0.5), Mat.Snow)
		for _, p in { { -1.6, -2.3, 0.9, 0.3 }, { 1, -2.1, 0.7, -0.5 }, { -3.4, -3.3, 0.6, 0.8 } } do
			block(
				c,
				CFrame.new(p[1], 0.4, p[2]) * CFrame.Angles(0.15, p[4], 0.1),
				V(p[3], 0.45, p[3] * 0.8),
				mix(ice, blue, 0.2),
				Mat.Ice
			)
		end
		box(c, 3.7, 0.3, -3.7, 2.4, 0.5, 2.4, rgb(70, 120, 70), Mat.Grass)
		ball(c, 4.2, 1.3, -3, 1.1, LEAF, Mat.Grass)
		ball(c, 3.1, 1.2, -4.3, 0.9, LEAF, Mat.Grass)
		box(c, 2.8, 0.8, -3.4, 0.35, 0.1, 1.6, WOOD, Mat.WoodPlanks)
		box(c, 2.2, 0.8, -2.7, 1.4, 0.1, 0.45, WOOD, Mat.WoodPlanks)
		box(c, -1.4, 0.3, -3.9, 1.6, 0.35, 0.6, WHITE)
		box(c, -1.2, 0.65, -3.9, 0.8, 0.3, 0.45, rgb(60, 90, 140))
	end

	-- 우유니 소금사막: 흰 소금 평원(앞쪽 육각형 소금 결정 무늬) + 뒤쪽 하늘을 비추는 물 거울(비친 구름, 분홍 노을)
	--   + 거대 선인장이 선 잉카와시 섬 + 지붕 짐칸 달린 지프 + 원뿔형 소금 더미
	B.uyuni = function(c)
		local salt = c.P
		local ridge = mix(salt, ROCK, 0.3)
		box(c, 0, 0, 0, 9.8, 0.3, 9.8, salt, Mat.Salt)
		box(c, 0, 0.3, 2.6, 9.8, 0.04, 4.6, c.S, Mat.Glass, 0.1)
		box(c, 0, 0.3, 4.4, 9.8, 0.05, 0.9, c.A, Mat.Glass, 0.2)
		-- 거울에 비친 구름
		for _, p in { { -1.5, 3.1, 2.2 }, { 1, 1.5, 1.6 }, { -3.8, 1.4, 1.2 } } do
			cyl(c, CFrame.new(p[1], 0.34, p[2]) * UPRIGHT, 0.04, p[3], CLOUD, Mat.SmoothPlastic, 0.1)
		end
		local r = 1.25
		local function hexagon(cx, cz, skip)
			for k = 0, 5 do
				if not skip[k] then
					local a1, a2 = k * PI / 3, (k + 1) * PI / 3
					local p1 = V(cx + r * math.cos(a1), 0.34, cz + r * math.sin(a1))
					local p2 = V(cx + r * math.cos(a2), 0.34, cz + r * math.sin(a2))
					block(c, CFrame.lookAt((p1 + p2) / 2, p2), V(0.16, 0.08, r + 0.14), ridge, Mat.Salt)
				end
			end
		end
		local h = r * math.sqrt(3)
		hexagon(-0.6, -2.4, {})
		hexagon(-0.6 + h * math.cos(PI / 6), -2.4 + h * math.sin(PI / 6), { [3] = true })
		-- 잉카와시 섬 + 선인장
		local ix, iz = 3, 3
		col(c, ix, 0.3, iz, 0.8, 3.6, rgb(150, 120, 95), Mat.Rock)
		col(c, ix + 0.2, 1.1, iz + 0.2, 0.7, 2.6, rgb(135, 108, 88), Mat.Rock)
		col(c, ix + 0.1, 1.8, iz + 0.3, 0.5, 1.5, rgb(125, 100, 82), Mat.Rock)
		local cactus = rgb(80, 130, 70)
		for _, p in { { 2, 2.3, 3.2, 1 }, { 3.3, 2.2, 4, -1 }, { 3.9, 3.7, 2.8, 1 } } do
			local x, z, ht, side = p[1], p[2], p[3], p[4]
			local base = 1.1
			col(c, x, base, z, ht, 0.45, cactus, Mat.Grass)
			box(c, x + side * 0.3, base + ht * 0.45, z, 0.5, 0.26, 0.26, cactus, Mat.Grass)
			col(c, x + side * 0.52, base + ht * 0.45, z, ht * 0.35, 0.32, cactus, Mat.Grass)
		end
		-- 지프(지붕 짐칸)
		local jeep = CFrame.new(-2.2, 0.3, 0.2) * CFrame.Angles(0, 0.35, 0)
		block(c, jeep * CFrame.new(0, 0.17, 0), V(2.2, 0.34, 1), DARK)
		block(c, jeep * CFrame.new(0, 0.65, 0), V(2.5, 0.65, 1.1), WHITE)
		block(c, jeep * CFrame.new(0.2, 1.26, 0), V(1.7, 0.57, 1.04), mix(c.S, DARK, 0.4), Mat.Glass)
		block(c, jeep * CFrame.new(0.2, 1.65, 0), V(1.75, 0.2, 1.1), rgb(230, 140, 60))
		for _, p in { { -3.8, -1.8 }, { -3.2, -3.2 } } do
			col(c, p[1], 0.3, p[2], 0.35, 0.85, WHITE, Mat.Salt)
			col(c, p[1], 0.65, p[2], 0.3, 0.45, WHITE, Mat.Salt)
		end
	end

	-- 그랜드 캐니언: 캐니언 바닥 + 굽이치는 콜로라도 강 + 뒤쪽 북쪽 가장자리의 층층이 물러나는 붉은 절벽(지층 색 띠)
	--   + 가운데 솟은 층층 뷰트(신전 바위) 둘 + 앞쪽 남쪽 가장자리(소나무, 데저트 뷰 망루)
	B.grandcanyon = function(c)
		local red = c.P
		local tan = c.S
		local schist = rgb(98, 78, 82)
		local supai = mix(red, tan, 0.45)
		local cream = rgb(236, 214, 170)
		local kaibab = rgb(214, 196, 160)
		local rim = rgb(60, 105, 65)
		box(c, 0, 0, 0, 9.8, 0.3, 9.8, mix(schist, tan, 0.35), Mat.Slate)
		for _, s in { { -3, -1.4, 0.25 }, { 0.2, -1.9, -0.12 }, { 3.2, -1.5, 0.3 } } do
			block(c, CFrame.new(s[1], 0.33, s[2]) * CFrame.Angles(0, s[3], 0), V(3.4, 0.06, 0.7), c.A, Mat.Glass, 0.05)
		end
		-- 북쪽 가장자리: { 높이, 앞면 z, 색 }
		local y = 0.3
		for _, l in
			{ { 1.3, 1.2, schist }, { 1.8, 1.9, red }, { 1.4, 2.5, supai }, { 1.1, 3.1, cream }, { 0.6, 3.4, kaibab } }
		do
			box(c, 0, y, (l[2] + 4.9) / 2, 9.8, l[1], 4.9 - l[2], l[3], c.M)
			y += l[1]
		end
		for _, x in { -3.4, -0.6, 2.6 } do
			ball(c, x, y + 0.35, 4.3, 0.8, rim, Mat.Grass)
		end
		-- 층층 뷰트: { x, z, 가로, 세로, 층 높이들 }
		local function butte(x, z, w, d, heights)
			local colors = { schist, red, supai, cream, kaibab }
			local yy = 0.3
			for k, hgt in heights do
				local s = 1 - (k - 1) * 0.16
				box(c, x, yy, z, w * s, hgt, d * s, colors[k], c.M)
				yy += hgt
			end
		end
		butte(-2.4, 0.2, 2.8, 2.4, { 1.1, 1.6, 1.2, 0.9, 0.4 })
		butte(1.9, 0, 2.2, 1.9, { 1, 1.4, 1, 0.6 })
		butte(4.1, 0.5, 1.6, 2.4, { 1.3, 1.8, 1.4 })
		-- 남쪽 가장자리(앞 왼쪽) + 망루
		box(c, 3, 0.3, -4.1, 3.8, 0.9, 1.6, red, c.M)
		box(c, 3.2, 1.2, -4.3, 3.4, 0.35, 1.2, kaibab, c.M)
		pine(c, 1.8, 1.55, -4.3, 1.1, 0.6, rim)
		col(c, 4, 1.55, -4.2, 1.6, 0.8, rgb(170, 130, 100), Mat.Cobblestone)
		col(c, 4, 3.15, -4.2, 0.2, 0.95, rgb(150, 110, 85), Mat.Cobblestone)
	end

	-- 갈라파고스 제도: 바다 + 검은 용암 섬(초록 덤불) + 뒤쪽 붉은 응회암 분화구 + 바다에서 솟은 비스듬한 피너클 바위
	--   + 섬 앞쪽의 커다란 코끼리거북(둥근 등딱지, 긴 목) + 모래 해변의 바다사자 + 푸른발부비새 + 오푼티아 선인장 나무
	B.galapagos = function(c)
		local lava = mix(ROCK, BLACK, 0.45)
		local tuff = rgb(165, 105, 70)
		local shell = c.A
		local skin = rgb(115, 108, 95)
		local g = 0.65
		box(c, 0, 0, 0, 9.8, 0.3, 9.8, c.S, Mat.Glass, 0.1)
		box(c, -1, 0.3, 1.2, 7.8, 0.35, 7.4, lava, Mat.Basalt)
		box(c, -0.8, 0.3, -3.3, 5.8, 0.25, 2, SAND, Mat.Sand)
		-- 응회암 분화구
		col(c, -2.8, g, 3, 0.8, 3.8, tuff, Mat.Sandstone)
		col(c, -2.8, g + 0.8, 3, 0.7, 2.9, mix(tuff, BLACK, 0.1), Mat.Sandstone)
		col(c, -2.8, g + 1.5, 3, 0.45, 2, tuff, Mat.Sandstone)
		col(c, -2.8, g + 1.95, 3, 0.05, 1.3, DARK)
		-- 피너클 바위
		local pinnacle = mix(lava, tuff, 0.25)
		col(c, 3.6, 0.3, 1.8, 0.5, 2.2, lava, Mat.Basalt)
		local lean = CFrame.new(3.6, 0.3, 1.8) * CFrame.Angles(0.06, 0.3, 0.14)
		block(c, lean * CFrame.new(0, 1.9, 0), V(1.4, 3.8, 1.1), pinnacle, Mat.Basalt)
		block(c, lean * CFrame.new(0.1, 4.6, 0) * CFrame.Angles(0, 0, 0.08), V(0.95, 2, 0.8), pinnacle, Mat.Basalt)
		block(c, lean * CFrame.new(0.2, 5.8, 0) * CFrame.Angles(0, 0, PI / 4), V(0.62, 0.62, 0.6), pinnacle, Mat.Basalt)
		for _, p in { { -0.6, 2.8, 1.2 }, { 1.5, 3.8, 1 }, { -4.1, 0.2, 1.1 }, { 1.9, 0.6, 0.8 } } do
			ball(c, p[1], g + p[3] * 0.3, p[2], p[3], c.P, Mat.Grass)
		end
		-- 오푼티아 선인장 나무(줄기 + 납작한 잎)
		local ox, oz = 0.4, 1.4
		col(c, ox, g, oz, 1.9, 0.35, rgb(150, 120, 90), Mat.Wood)
		for _, pd in { { -0.4, 2.7, 0.3 }, { 0.35, 3, -0.4 }, { 0, 3.4, 0.9 }, { 0.3, 2.4, 1.8 } } do
			block(
				c,
				CFrame.new(ox + pd[1], pd[2], oz) * CFrame.Angles(0, pd[3], pd[1] * 0.8),
				V(0.7, 0.9, 0.15),
				mix(c.P, LEAF, 0.4),
				Mat.Grass
			)
		end
		-- 코끼리거북
		local tx, tz = -1.3, -1.1
		for _, s in K.CORNERS do
			col(c, tx + s[1] * 0.85, g, tz + s[2] * 0.7, 0.8, 0.55, skin)
		end
		col(c, tx, g + 0.6, tz, 0.4, 2.9, mix(shell, BLACK, 0.3))
		ball(c, tx, g + 0.85, tz, 2.7, shell)
		col(c, tx, g + 1.3, tz, 0.08, 2.6, mix(shell, BLACK, 0.35))
		beam(c, V(tx, g + 1, tz - 1.1), V(tx, g + 1.95, tz - 2.1), 0.5, skin)
		ball(c, tx, g + 2.1, tz - 2.2, 0.75, skin)
		-- 바다사자
		local seal = rgb(120, 100, 85)
		beam(c, V(0.6, 0.75, -3.4), V(1.8, 0.72, -3.8), 0.5, seal)
		beam(c, V(0.7, 0.8, -3.4), V(0.45, 1.25, -3.25), 0.36, seal)
		-- 푸른발부비새
		local bx, bz = 2.3, -1.9
		box(c, bx, g, bz, 0.45, 0.12, 0.3, rgb(50, 170, 235))
		ball(c, bx, g + 0.4, bz, 0.55, WHITE)
		block(c, CFrame.new(bx, g + 0.45, bz + 0.12) * CFrame.Angles(0.3, 0, 0), V(0.5, 0.35, 0.45), rgb(120, 95, 70))
		ball(c, bx, g + 0.8, bz - 0.05, 0.34, WHITE)
		block(c, CFrame.new(bx, g + 0.78, bz - 0.3), V(0.09, 0.09, 0.28), rgb(60, 110, 150))
	end

	-- 테오티우아칸: 메마른 풀밭 + 죽은 자의 길 + 길가 제단들 + 오른쪽의 거대한 5단 태양의 피라미드(길 쪽 계단)
	--   + 길 끝의 달의 피라미드(앞쪽 부속 기단과 계단)
	B.teotihuacan = function(c)
		local stone = c.P
		local shade = c.S
		local path = mix(stone, WHITE, 0.3)
		box(c, 0, 0, 0, 9.8, 0.25, 9.8, mix(stone, GRASS, 0.45), Mat.Grass)
		box(c, -2.2, 0.25, -1.9, 1.4, 0.06, 6, path, Mat.Concrete)
		box(c, -2.2, 0.25, 1.1, 3, 0.06, 1.2, path, Mat.Concrete)
		-- 태양의 피라미드
		local sx, sz = 2.2, -0.6
		local y = 0.25
		for _, t in { { 5.2, 1.5 }, { 4.3, 1.5 }, { 3.4, 1.3 }, { 2.5, 1.2 }, { 1.7, 0.9 } } do
			box(c, sx, y, sz, t[1], t[2], t[1], stone)
			y += t[2]
		end
		box(c, sx, y, sz, 1.1, 0.25, 1.1, shade)
		local run = 2.9 - 0.85
		wedge(
			c,
			CFrame.new(sx - 0.85 - run / 2, 0.25 + (y - 0.25) / 2, sz) * CFrame.Angles(0, PI / 2, 0),
			V(1.3, y - 0.25, run),
			mix(stone, WHITE, 0.3)
		)
		box(c, sx - 3.1, 0.25, sz, 0.6, 0.7, 2.2, stone)
		-- 달의 피라미드
		local mx, mz = -2.2, 3.3
		y = 0.25
		for _, t in { { 3.2, 1.1 }, { 2.6, 1 }, { 2, 0.9 }, { 1.4, 0.8 } } do
			box(c, mx, y, mz, t[1], t[2], t[1], stone)
			y += t[2]
		end
		box(c, mx, 0.25, 1.4, 2.2, 1.4, 0.9, shade)
		wedge(c, CFrame.new(mx, 0.25 + (y - 0.25) / 2, 1.55), V(0.9, y - 0.25, 2.1), mix(stone, WHITE, 0.15))
		-- 길가 제단
		for _, p in { { -4.1, -3.6 }, { -4.1, -1.4 }, { -4.1, 0.8 }, { -0.6, -4.1 } } do
			box(c, p[1], 0.25, p[2], 1.4, 0.6, 1.4, shade)
			box(c, p[1], 0.85, p[2], 0.9, 0.4, 0.9, stone)
		end
		plant(c, -4.2, 0.25, 3.8, 0.9, 1, mix(LEAF, SAND, 0.3))
		plant(c, 4.2, 0.25, 3.9, 1, 1.1, mix(LEAF, SAND, 0.3))
	end

	-- 나스카 라인: 뒤로 완만하게 올라가는 사막 고원 + 그 위에 밝은 선으로 그린 거대한 벌새(긴 부리, 펼친 날개, 부채꼴 꼬리)
	--   + 곧게 뻗은 직선과 사다리꼴 + 앞쪽 고속도로와 철골 전망탑 + 그림을 보러 선회하는 경비행기 + 뒤쪽 갈색 언덕
	B.nazca = function(c)
		local desert = c.P
		local lineColor = mix(c.A, WHITE, 0.3)
		local rise = 2
		box(c, 0, 0, 0, 9.8, 0.3, 9.8, c.S, Mat.Sand)
		wedge(c, CFrame.new(0, 0.3 + rise / 2, 0), V(9.8, rise, 9.8), desert, Mat.Sand)
		local tilt = math.atan2(rise, 9.8)
		local plane = CFrame.new(0, 0.3 + rise / 2, 0) * CFrame.Angles(-tilt, 0, 0)
		local function line(x1, z1, x2, z2, w, color)
			local a, b = V(x1, 0.02, z1), V(x2, 0.02, z2)
			block(
				c,
				plane * CFrame.lookAt((a + b) / 2, b),
				V(w, 0.1, (b - a).Magnitude + w),
				color or lineColor,
				Mat.Sand
			)
		end
		-- 직선, 사다리꼴, 고속도로
		line(-4.5, -3.8, -2.9, 4.6, 0.14)
		line(4.6, -1.2, 3.2, 4.6, 0.14)
		block(
			c,
			plane * CFrame.new(-3.6, 0.01, -1.6) * CFrame.Angles(0, 0.2, 0),
			V(0.9, 0.08, 2.6),
			mix(lineColor, desert, 0.35),
			Mat.Sand
		)
		line(-4.7, -4.35, 4.7, -4.35, 0.5, TILE)
		-- 벌새: 부리, 머리, 몸통, 날개 깃 3줄씩, 꼬리 3줄
		line(0.1, 1.9, 0.55, 4.5, 0.22)
		cyl(c, plane * CFrame.new(0, 0.02, 1.5) * UPRIGHT, 0.1, 1.1, lineColor, Mat.Sand)
		line(0, 1.2, 0, -1.4, 0.8)
		for _, sx in { -1, 1 } do
			for _, tip in { { 3.6, 1.6 }, { 3.5, 0.5 }, { 3.1, -0.5 } } do
				line(sx * 0.3, 0.4, sx * tip[1], tip[2], 0.3)
			end
		end
		for _, tx in { -0.8, 0, 0.8 } do
			line(0, -1.4, tx, if tx == 0 then -3.8 else -3.5, 0.26)
		end
		-- 전망탑
		local foot = plane * V(-3.9, 0, -3.6)
		local towerTop = foot.Y + 2.3
		for _, s in K.CORNERS do
			beam(
				c,
				V(foot.X + s[1] * 0.45, foot.Y, foot.Z + s[2] * 0.45),
				V(foot.X + s[1] * 0.3, towerTop, foot.Z + s[2] * 0.3),
				0.1,
				rgb(90, 90, 95),
				Mat.Metal
			)
		end
		box(c, foot.X, towerTop, foot.Z, 1, 0.12, 1, rgb(90, 90, 95), Mat.Metal)
		-- 경비행기
		local flight = CFrame.new(1, 6.4, -1.8) * CFrame.Angles(0, 0.6, 0) * CFrame.Angles(0, 0, 0.35)
		cyl(c, flight * ALONG_Z, 2.6, 0.5, WHITE)
		block(c, flight * CFrame.new(0, 0.28, -0.2), V(3.8, 0.08, 0.6), WHITE)
		block(c, flight * CFrame.new(0, 0.5, 1.1), V(0.08, 0.7, 0.5), rgb(200, 50, 50))
		block(c, flight * CFrame.new(0, 0.12, 1.15), V(1.4, 0.06, 0.4), WHITE)
		block(c, flight * CFrame.new(0, 0, -1.33), V(0.9, 0.12, 0.05), DARK)
		-- 뒤쪽 언덕
		local back = 0.3 + rise * 0.93
		peak(c, -2.9, back - 0.2, 3.9, 2, 1.9, 1.8, 1.6, mix(c.S, desert, 0.4), Mat.Sand)
		peak(c, 2.9, back - 0.2, 3.9, 1.9, 2, 1.8, 1.3, mix(c.S, desert, 0.4), Mat.Sand)
	end

	-- 테노치티틀란: 텍스코코 호수 + 섬 도시 + 사방으로 뻗은 둑길 + 신성 구역 광장
	--   + 쌍둥이 신전을 얹은 템플로 마요르(4단, 두 줄 계단, 붉은 우이칠로포치틀리·파란 틀랄록 신당)
	--   + 원형 에에카틀 신전 + 흰 집들과 운하 + 호수 위 치남파(떠 있는 밭)와 카누
	B.tenochtitlan = function(c)
		local stone = c.P
		local lake = c.S
		local white = rgb(240, 235, 225)
		local blue = rgb(60, 110, 200)
		box(c, 0, 0, 0, 9.8, 0.3, 9.8, lake, Mat.Glass, 0.1)
		box(c, 0, 0.3, 0.3, 6.6, 0.35, 6.4, mix(stone, SAND, 0.3))
		box(c, 0, 0.65, 0.6, 4.4, 0.08, 4.4, mix(stone, WHITE, 0.45))
		box(c, 0, 0.3, -3.9, 0.7, 0.22, 2, stone)
		box(c, 0, 0.3, 4.2, 0.7, 0.22, 1.4, stone)
		box(c, -4.1, 0.3, 0.6, 1.6, 0.22, 0.7, stone)
		box(c, 4.1, 0.3, 1.2, 1.6, 0.22, 0.7, stone)
		local tz = 1.4
		local y = 0.73
		for _, w in { 3.4, 2.9, 2.4, 1.9 } do
			box(c, 0, y, tz, w, 0.9, w, stone)
			y += 0.9
		end
		for _, sx in { -1, 1 } do
			wedge(
				c,
				CFrame.new(sx * 0.45, 0.73 + (y - 0.73) / 2, tz - 1.45),
				V(0.75, y - 0.73, 1.1),
				mix(stone, WHITE, 0.2)
			)
			local color = if sx > 0 then c.A else blue
			box(c, sx * 0.5, y, tz + 0.25, 0.8, 0.8, 0.9, white)
			box(c, sx * 0.5, y + 0.8, tz + 0.25, 0.9, 0.6, 1, color)
			box(c, sx * 0.5, y, tz - 0.22, 0.3, 0.5, 0.05, DARK)
		end
		col(c, -1.6, 0.73, -1.1, 0.4, 1.3, stone)
		col(c, -1.6, 1.13, -1.1, 0.6, 0.8, white)
		col(c, -1.6, 1.73, -1.1, 0.35, 0.95, c.A)
		for _, p in { { -2.7, -2.2 }, { 2.7, -2.1 }, { -2.8, 3 }, { 2.8, 3 }, { 2.8, 0.6 } } do
			box(c, p[1], 0.65, p[2], 0.9, 0.5, 0.9, white)
		end
		box(c, -2.75, 0.65, 0.5, 0.5, 0.03, 4, lake, Mat.Glass, 0.1)
		for _, p in { { -4.1, -3.3 }, { 4.1, -3.3 }, { -4, 3.6 } } do
			box(c, p[1], 0.3, p[2], 1.2, 0.15, 1.6, GRASS, Mat.Grass)
		end
		plant(c, -4.1, 0.45, -3.3, 1, 0.8, LEAF)
		plant(c, 4.1, 0.45, -3.3, 1.1, 0.8, LEAF)
		box(c, 2, 0.3, -3.8, 0.28, 0.14, 1, WOOD, Mat.Wood)
		box(c, -2.4, 0.3, 4.1, 1, 0.14, 0.28, WOOD, Mat.Wood)
	end

	-- 젊음의 샘: 둥근 밀림 빈터 + 대리석 계단 기단 + 빛나는 청록 샘물 + 3단 대리석 분수(물 커튼) + 황금 성배와 물줄기
	--   + 하늘로 솟는 빛 기둥 + 둘레의 부서진 고대 기둥(쓰러진 것 하나, 덩굴) + 야자수 + 떠다니는 금빛 반딧불
	B.fountainofyouth = function(c)
		local marble = c.P
		local water = c.S
		local gold = c.A
		local vine = rgb(70, 150, 80)
		col(c, 0, 0, 0, 0.3, 9.8, mix(GRASS, LEAF, 0.4), Mat.Grass)
		col(c, 0, 0.3, 0, 0.3, 7.6, mix(marble, ROCK, 0.15))
		col(c, 0, 0.6, 0, 0.7, 6.4, marble)
		col(c, 0, 1.3, 0, 0.04, 5.6, water, Mat.Neon, 0.2)
		col(c, 0, 1.3, 0, 1.6, 1.2, marble)
		col(c, 0, 2.9, 0, 0.35, 3.4, marble)
		col(c, 0, 3.25, 0, 0.04, 3, water, Mat.Neon, 0.2)
		col(c, 0, 1.34, 0, 1.56, 3.3, water, Mat.Glass, 0.6)
		col(c, 0, 3.25, 0, 1.3, 0.8, marble)
		col(c, 0, 4.55, 0, 0.3, 2.2, marble)
		col(c, 0, 4.85, 0, 0.04, 1.9, water, Mat.Neon, 0.2)
		col(c, 0, 3.29, 0, 1.26, 2.1, water, Mat.Glass, 0.6)
		col(c, 0, 4.85, 0, 0.8, 0.35, gold, Mat.Metal)
		col(c, 0, 5.65, 0, 0.6, 1, gold, Mat.Metal)
		col(c, 0, 6.25, 0, 1.2, 0.3, water, Mat.Neon, 0.2)
		ball(c, 0, 7.6, 0, 0.9, water, Mat.Neon, 0.3)
		col(c, 0, 6.2, 0, 9, 1.4, gold, Mat.Neon, 0.8)
		local heights = { 4.2, 2.4, 3.6, 1.6, 4.2, 3 }
		for i = 0, 5 do
			local a = i / 6 * TAU + PI / 6
			local x, z = 4.1 * math.cos(a), 4.1 * math.sin(a)
			local h = heights[i + 1]
			col(c, x, 0.3, z, h, 0.6, marble)
			if h > 4 then
				box(c, x, 0.3 + h, z, 0.85, 0.3, 0.85, marble)
			elseif i % 2 == 0 then
				ball(c, x, 0.3 + h, z, 0.75, vine, Mat.Grass)
			end
		end
		cyl(c, CFrame.new(-2.4, 0.58, -4) * CFrame.Angles(0, 0.3, 0), 2, 0.55, marble)
		plant(c, -2.5, 0.3, 3.9, 3.6, 1.8, LEAF)
		plant(c, 2.6, 0.3, 3.7, 3, 1.6, LEAF)
		for _, p in { { -1.8, 5.2, -1.2 }, { 2, 6.4, -0.6 }, { -1.2, 8.3, 1.5 }, { 1.4, 9.4, 1 } } do
			ball(c, p[1], p[2], p[3], 0.3, gold, Mat.Neon)
		end
	end

	return B
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">Asia</string>
            <string name="Source"><![CDATA[-- 아시아 명소 전용 모형. Models/init.luau 가 K(파트 헬퍼·색·기존 모양)를 넘겨 호출합니다.
-- 규칙: 바닥 10x10 안, 높이 22 이하, 바닥 y = 0, 정면 -Z, 파트 45개 이하. c.P/c.S/c.A = 명소 주/보조/강조 색, c.M = 재질.
-- 숭례문(gate) · 만리장성(wall) · 페트라(facade) · 바벨탑(spiral) 은 원래 그 명소를 위해 만든 모양을 그대로 씀.

return function(K)
	local B = {}

	local V, rgb, Mat, PI, TAU = K.V, K.rgb, K.Mat, K.PI, K.TAU
	local ALONG_Z, CORNERS = K.ALONG_Z, K.CORNERS
	local GRASS, LEAF, WATER, DARK, TILE = K.GRASS, K.LEAF, K.WATER, K.DARK, K.TILE
	local ROCK, WOOD, SAND, CLOUD, BLACK, WHITE = K.ROCK, K.WOOD, K.SAND, K.CLOUD, K.BLACK, K.WHITE
	local mix, block, box, ball, cyl, col, wedge, beam = K.mix, K.block, K.box, K.ball, K.cyl, K.col, K.wedge, K.beam
	local roof, gable, plant, clockFace = K.roof, K.gable, K.plant, K.clockFace

	-- 정면(-Z)에서 삼각형이 보이는 박공(용마루가 Z 방향). 바닥 y, 폭 w(X), 깊이 d(Z), 높이 h
	local function frontGable(c, x, y, z, w, d, h, color, material)
		wedge(c, CFrame.new(x - w / 4, y + h / 2, z) * CFrame.Angles(0, PI / 2, 0), V(d, h, w / 2), color, material)
		wedge(c, CFrame.new(x + w / 4, y + h / 2, z) * CFrame.Angles(0, -PI / 2, 0), V(d, h, w / 2), color, material)
	end

	-- 홍콩 시계탑: 붉은 벽돌 + 화강암 띠 탑신, 세 면 시계, 팔각 등롱 + 작은 돔 + 긴 피뢰침
	B.clocktower = function(c)
		local brick = rgb(178, 86, 60)
		local granite = mix(c.P, WHITE, 0.35)
		box(c, 0, 0, 0, 7.4, 0.3, 7.4, mix(c.P, WHITE, 0.55))
		box(c, 0, 0.3, 0, 4.4, 0.8, 4.4, granite)
		box(c, 0, 1.1, 0, 3.6, 10.2, 3.6, brick)
		for _, y in { 3.8, 6.6, 9.4 } do
			box(c, 0, y, 0, 3.8, 0.3, 3.8, granite)
		end
		box(c, 0, 1.1, -1.83, 1.2, 2.2, 0.1, DARK)
		box(c, 0, 4.6, -1.83, 0.5, 1.4, 0.1, DARK)
		box(c, 0, 7.4, -1.83, 0.5, 1.4, 0.1, DARK)
		box(c, 0, 11.3, 0, 4.3, 0.35, 4.3, granite)
		box(c, 0, 11.65, 0, 4, 3.1, 4, brick)
		for _, i in { 0, 1, 3 } do
			clockFace(c, CFrame.Angles(0, i * PI / 2, 0) * CFrame.new(0, 13.2, -2), 2.6)
		end
		box(c, 0, 14.75, 0, 4.5, 0.4, 4.5, granite)
		-- 팔각 등롱(사각 두 개를 45도 엇갈림) + 아치 창
		box(c, 0, 15.15, 0, 2.8, 2, 2.8, brick)
		block(c, CFrame.new(0, 16.15, 0) * CFrame.Angles(0, PI / 4, 0), V(2.8, 2, 2.8), brick)
		for i = 0, 3 do
			block(c, CFrame.Angles(0, i * PI / 2, 0) * CFrame.new(0, 16.1, -1.42), V(0.6, 1.2, 0.1), DARK)
		end
		col(c, 0, 17.15, 0, 0.3, 3.4, granite)
		col(c, 0, 17.45, 0, 0.7, 2.2, brick)
		ball(c, 0, 18.15, 0, 2.2, c.S)
		col(c, 0, 19.1, 0, 0.5, 0.5, granite)
		col(c, 0, 19.6, 0, 2.3, 0.14, c.S, Mat.Metal)
	end

	-- 첨성대: 잔디 + 네모 2단 기단 + 아래가 불룩한 병 모양 돌 원통(돌 켜) + 남쪽 네모 창 + 꼭대기 井 자 정자석 2단
	B.cheomseongdae = function(c)
		col(c, 0, 0, 0, 0.2, 9.6, GRASS, Mat.Grass)
		local stone = mix(c.S, WHITE, 0.15)
		box(c, 0, 0.2, 0, 5.6, 0.45, 5.6, stone)
		box(c, 0, 0.65, 0, 5, 0.45, 5, stone)
		local y = 1.1
		local courses = 11
		local courseH = 0.85
		for k = 0, courses - 1 do
			local t = (k + 0.5) / courses
			local d = 2.7 + 2.1 * (1 - t) ^ 2.2
			col(c, 0, y, 0, courseH, d, if k % 2 == 0 then c.P else mix(c.P, c.S, 0.3))
			y += courseH
		end
		box(c, 0, 4.5, -1.6, 1.1, 1.1, 0.4, DARK)
		for layer = 0, 1 do
			local ly = y + layer * 0.76
			for _, s in { -1, 1 } do
				box(c, 0, ly, s * 1, 3.1, 0.38, 0.4, c.P)
				box(c, s * 1, ly + 0.38, 0, 0.4, 0.38, 3.1, c.P)
			end
		end
		ball(c, -3.4, 0.6, -3.2, 1.1, LEAF, Mat.Grass)
		ball(c, 3.5, 0.65, 3.1, 1.2, LEAF, Mat.Grass)
		ball(c, 3.6, 0.5, -2.9, 0.9, LEAF, Mat.Grass)
	end

	-- 성산일출봉: 바다 위로 솟은 왕관 모양 분화구(비탈진 주름 절벽 + 둘레의 들쭉날쭉한 봉우리 + 안쪽 풀밭)
	--   + 뒤쪽 육지로 이어지는 풀밭 능선 + 떠오르는 해
	B.seongsan = function(c)
		local sea = mix(WATER, c.S, 0.35)
		local tuff = rgb(128, 104, 78)
		local green = c.P
		box(c, 0, 0, 0, 9.8, 0.3, 9.8, sea, Mat.Glass, 0.1)
		box(c, 1.6, 0, 4.2, 6.6, 0.6, 1.6, GRASS, Mat.Grass)
		local cx, cz = -0.4, -0.45
		col(c, cx, 0, cz, 0.7, 8.8, mix(tuff, ROCK, 0.4))
		col(c, cx, 0.7, cz, 1.3, 7.9, tuff)
		col(c, cx, 2, cz, 1.2, 7, mix(tuff, green, 0.55), Mat.Grass)
		col(c, cx, 3.2, cz, 0.9, 6.3, green, Mat.Grass)
		col(c, cx, 4.1, cz, 0.1, 5.1, mix(green, GRASS, 0.5), Mat.Grass)
		-- 절벽 주름(위로 갈수록 안쪽으로 기움)
		for i = 0, 7 do
			local cf = CFrame.new(cx, 0, cz) * CFrame.Angles(0, (i + 0.5) / 8 * TAU, 0)
			local vegetated = i % 2 == 1
			block(
				c,
				cf * CFrame.new(0, 2.2, -3.55) * CFrame.Angles(0.42, 0, 0),
				V(1, 3.9, 0.7),
				if vegetated then mix(green, tuff, 0.3) else mix(tuff, BLACK, 0.12),
				if vegetated then Mat.Grass else nil
			)
		end
		-- 둘레 봉우리(왕관): 높이를 들쭉날쭉하게
		local heights = { 1.6, 1, 1.9, 1.2, 0.8, 1.5, 1.1, 1.8, 0.9, 1.4, 0.8, 1.7 }
		for i, h in heights do
			local cf = CFrame.new(cx, 0, cz)
				* CFrame.Angles(0, i / #heights * TAU, 0)
				* CFrame.new(0, 3.9 + h / 2, -2.8)
				* CFrame.Angles(-0.12, 0, 0)
			local rocky = i % 3 == 0
			block(c, cf, V(1.65, h, 0.75), if rocky then tuff else green, if rocky then nil else Mat.Grass)
		end
		-- 육지에서 분화구로 오르는 능선
		wedge(c, CFrame.new(1.9, 0.6 + 1.5, 3.2) * CFrame.Angles(0, PI, 0), V(2.2, 3, 3), GRASS, Mat.Grass)
		ball(c, 4, 0.9, 4.2, 1, LEAF, Mat.Grass)
		ball(c, -1.4, 0.9, 4.3, 0.9, LEAF, Mat.Grass)
		-- 떠오르는 해
		cyl(c, CFrame.new(3.3, 7.4, 3.6) * ALONG_Z, 0.2, 2.4, c.A, Mat.Neon)
		cyl(c, CFrame.new(3.3, 7.4, 3.75) * ALONG_Z, 0.1, 3.4, c.A, Mat.Neon, 0.6)
	end

	-- 하와마할: 분홍 사암의 얇은 5층 정면. 위로 갈수록 좁아지는 피라미드 윤곽 + 층마다 크림색 띠
	--   + 튀어나온 창 기둥(자로카) 줄 + 기둥마다 작은 돔 + 꼭대기 정자
	B.hawamahal = function(c)
		local wall = c.S
		local bay = c.P
		local trim = c.A
		local front = -0.8
		box(c, 0, 0, -2.6, 9.8, 0.15, 3.6, rgb(205, 190, 165))
		-- 층 덩어리: { 폭, 바닥, 꼭대기, 깊이 }
		local levels = {
			{ 9.6, 0, 2.6, 3.2 },
			{ 9.6, 2.6, 4.8, 2.8 },
			{ 7.8, 4.8, 7, 2.4 },
			{ 5.8, 7, 9, 2 },
			{ 3.6, 9, 10.8, 1.6 },
		}
		for _, l in levels do
			box(c, 0, l[2], front + l[4] / 2, l[1], l[3] - l[2], l[4], wall)
		end
		box(c, 0, 0.15, front - 0.03, 1.4, 1.9, 0.08, DARK)
		-- 창 기둥: { x, 꼭대기 }
		local bays = {
			{ 0, 10.8 },
			{ -1.2, 10.8 },
			{ 1.2, 10.8 },
			{ -2.4, 9 },
			{ 2.4, 9 },
			{ -3.5, 7 },
			{ 3.5, 7 },
			{ -4.4, 4.8 },
			{ 4.4, 4.8 },
		}
		for _, b in bays do
			local x, top = b[1], b[2]
			block(c, CFrame.new(x, (2.6 + top) / 2, front) * CFrame.Angles(0, PI / 4, 0), V(0.85, top - 2.6, 0.85), bay)
			ball(c, x, top + 0.05, front - 0.15, 0.8, bay)
		end
		-- 층 띠(돌출 처마) + 층 가운데 가는 띠
		for k = 2, 5 do
			local l = levels[k]
			box(c, 0, l[2] - 0.09, front - 0.35, levels[k - 1][1] + 0.1, 0.18, 0.75, trim)
			box(c, 0, (l[2] + l[3]) / 2, front - 0.3, l[1], 0.1, 0.72, trim)
		end
		box(c, 0, 10.72, front - 0.35, 3.7, 0.16, 0.75, trim)
		col(c, 0, 10.8, -0.1, 0.8, 1.4, bay)
		ball(c, 0, 11.6, -0.1, 1.3, bay)
		col(c, 0, 12.15, -0.1, 0.5, 0.15, trim)
	end

	-- 히메지성: 잔디 + 비스듬한 돌 기단 + 흰 회벽 5층 천수각(층마다 회색 기와 처마 + 박공)
	--   + 앞쪽 치도리하후(삼각 박공)·가라하후(둥근 박공) + 금빛 샤치호코 + 뒤쪽 작은 천수 2
	B.himeji = function(c)
		local stone = mix(ROCK, WHITE, 0.25)
		local roofC = c.S
		box(c, 0, 0, 0, 9.8, 0.25, 9.8, GRASS, Mat.Grass)
		box(c, 0, 0.25, 0.3, 8, 1.2, 7, stone, Mat.Slate)
		box(c, 0, 1.45, 0.3, 7.2, 1.2, 6.2, stone, Mat.Slate)
		-- 작은 천수(뒤 양쪽)
		for _, sx in { -1, 1 } do
			box(c, sx * 2.6, 2.65, 2.4, 1.8, 1.5, 1.6, c.P)
			box(c, sx * 2.6, 4.15, 2.4, 2.5, 0.2, 2.3, roofC)
			gable(c, sx * 2.6, 4.35, 2.4, 2.2, 2, 0.7, roofC)
		end
		-- { 몸체 폭, 깊이, 높이, 지붕 높이 }
		local tiers = {
			{ 6.2, 4.6, 1.9, 0.9 },
			{ 5.2, 3.9, 1.5, 0.8 },
			{ 4.3, 3.3, 1.4, 0.75 },
			{ 3.4, 2.7, 1.3, 0.7 },
			{ 2.6, 2.1, 1.2, 1.1 },
		}
		local y = 2.65
		local z = 0
		local top = 0
		local lastW = 0
		for k, t in tiers do
			local w, d, h, rh = t[1], t[2], t[3], t[4]
			box(c, 0, y, z, w, h, d, c.P)
			if k <= 3 then
				box(c, 0, y + h * 0.4, z - d / 2 - 0.03, w * 0.6, 0.28, 0.06, DARK)
			end
			local ey = y + h
			box(c, 0, ey, z, w + 1.1, 0.22, d + 1.1, roofC)
			gable(c, 0, ey + 0.22, z, w + 0.7, d + 0.7, rh, roofC)
			if k == 2 or k == 4 then
				frontGable(c, 0, ey + 0.22, z - d / 2 - 0.1, w * 0.5, 1.2, rh * 1.35, roofC)
			elseif k == 1 then
				cyl(c, CFrame.new(0, ey + 0.25, z - d / 2 - 0.35), 2, 0.9, roofC)
			end
			top = ey + 0.22 + rh
			lastW = w + 0.7
			y = ey + 0.22 + rh * 0.55
		end
		for _, sx in { -1, 1 } do
			block(
				c,
				CFrame.new(sx * (lastW / 2 - 0.25), top + 0.1, z) * CFrame.Angles(0, 0, sx * 0.3),
				V(0.22, 0.6, 0.3),
				c.A,
				Mat.Metal
			)
		end
	end

	-- 파묵칼레: 뒤쪽 흰 석회 언덕에서 앞으로 계단처럼 내려오는 석회붕(단마다 옥빛 물)
	--   + 단 끝에 매달린 반원 웅덩이(흰 테두리 + 옥빛 물) + 언덕 위 히에라폴리스 기둥과 나무
	B.pamukkale = function(c)
		local white = c.P
		local pool = c.S
		box(c, 0, 0, 0, 9.8, 0.2, 9.8, mix(white, SAND, 0.3), Mat.Salt)
		-- 단: { 앞 z, 뒤 z, 윗면 }
		local steps = {
			{ 2.9, 4.9, 5.6 },
			{ 1.3, 2.9, 4.4 },
			{ -0.4, 1.3, 3.2 },
			{ -2.1, -0.4, 2 },
			{ -3.4, -2.1, 0.9 },
		}
		for k, st in steps do
			local zf, zb, top = st[1], st[2], st[3]
			box(c, 0, 0.2, (zf + zb) / 2, 9.8, top - 0.2, zb - zf, white)
			if k > 1 then
				box(c, 0, top, (zf + zb) / 2 + 0.1, 9.4, 0.05, zb - zf - 0.4, pool, Mat.Glass, 0.05)
			end
		end
		-- 단 끝의 웅덩이 줄: 단 번호 → x 목록
		local rows = {
			{ 2, 3.1, { -3.2, -0.1, 3 } },
			{ 3, 3.1, { -3, 0.1, 3.2 } },
			{ 4, 3, { -3.3, -0.2, 2.9 } },
			{ 5, 2.8, { -2.9, 0.1, 3.1 } },
		}
		for _, row in rows do
			local st = steps[row[1]]
			local below = if row[1] < #steps then steps[row[1] + 1][3] else 0.2
			local d = row[2]
			local top = st[3] + 0.15
			for _, x in row[3] do
				local lip = math.min(top - below, 0.8)
				col(c, x, top - lip, st[1], lip, d, white)
				col(c, x, top - 0.02, st[1], 0.08, d - 0.4, pool, Mat.Glass, 0.05)
			end
		end
		for _, x in { -3.6, -2.6, -1.6 } do
			col(c, x, 5.6, 3.9, 1.6, 0.35, mix(white, SAND, 0.45))
		end
		box(c, -2.6, 7.2, 3.9, 2.6, 0.3, 0.5, mix(white, SAND, 0.45))
		plant(c, 2.4, 5.6, 4, 1, 1.3, LEAF)
		plant(c, 3.8, 5.6, 3.6, 0.8, 1.1, LEAF)
	end

	-- 후지산: 숲 + 앞쪽 호수 + 매끈한 대칭 원뿔(비탈면에 붙인 판 두 고리: 아래는 완만한 푸른 비탈, 위는 가파른 눈 모자)
	--   + 평평한 분화구 꼭대기 + 눈선 아래로 흘러내린 눈 자락 + 벚꽃 나무 + 붉은 5층탑(추레이토)
	B.fuji = function(c)
		local forest = mix(LEAF, c.P, 0.25)
		box(c, 0, 0, 0, 9.8, 0.25, 9.8, forest, Mat.Grass)
		box(c, 0, 0.25, -4.25, 9.8, 0.05, 1.3, WATER, Mat.Glass, 0.1)
		local center = V(0, 0, 0.6)
		-- 원뿔 비탈을 판으로 덮음: 반지름 r1(높이 y1) → r2(높이 y2)
		local function slab(a: number, r1: number, y1: number, r2: number, y2: number, w: number, color, material)
			local dir = V(math.sin(a), 0, -math.cos(a))
			local p1 = center + V(0, y1, 0) + dir * r1
			local p2 = center + V(0, y2, 0) + dir * r2
			local normal = V(0, r1 - r2, 0) + dir * (y2 - y1)
			local mid = (p1 + p2) / 2 - normal.Unit * 0.2
			block(c, CFrame.lookAt(mid, mid + (p2 - p1)), V(w, 0.4, (p2 - p1).Magnitude + 0.15), color, material)
		end
		for i = 0, 11 do
			slab(i / 12 * TAU, 4.25, 0.45, 2.2, 2.55, 2.3, c.P)
		end
		for i = 0, 9 do
			slab((i + 0.5) / 10 * TAU, 2.45, 2.35, 0.95, 4.6, 1.6, c.S, Mat.Snow)
		end
		col(c, center.X, 4.4, center.Z, 0.25, 2.1, c.S, Mat.Snow)
		col(c, center.X, 4.45, center.Z, 0.25, 1.1, mix(c.S, ROCK, 0.35))
		-- 눈 자락(아래 비탈 위에 얹힘): 길이를 번갈아
		for i = 0, 5 do
			local a = (i + 0.3) / 6 * TAU
			local low = if i % 2 == 0 then 1.2 else 1.7
			local t = (low - 0.25) / 2.3
			slab(a, 4.25 - t * 2.05 + 0.08, low, 2.25, 2.55, 0.75, c.S, Mat.Snow)
		end
		-- 벚꽃
		plant(c, -3.9, 0.25, -3, 0.9, 1.5, c.A)
		plant(c, -2.8, 0.25, -3.7, 0.7, 1.1, c.A)
		-- 추레이토 탑
		local red = rgb(200, 60, 50)
		local px, pz = 3.9, -2.9
		local py = 0.25
		for k = 0, 2 do
			local w = 0.9 - k * 0.15
			box(c, px, py, pz, w, 0.6, w, red)
			box(c, px, py + 0.6, pz, w + 0.6, 0.14, w + 0.6, TILE)
			py += 0.74
		end
		col(c, px, py, pz, 0.7, 0.12, c.A, Mat.Metal)
	end

	-- 석굴암: 안이 보이게 앞을 연 둥근 화강암 돌방(돌판 벽 + 안으로 기운 궁륭 2단)
	--   + 연꽃 대좌 위에 앉은 커다란 흰 본존불 + 뒤벽의 둥근 광배 + 앞쪽 돌기둥 2개
	B.seokguram = function(c)
		local shell = mix(c.S, c.P, 0.45)
		local buddha = mix(c.P, WHITE, 0.45)
		box(c, 0, 0, 0, 9.8, 0.25, 9.8, GRASS, Mat.Grass)
		col(c, 0, 0.25, 0.9, 0.3, 8.2, c.S)
		box(c, 0, 0.25, -3.4, 3.8, 0.3, 2.6, c.S)
		local center = CFrame.new(0, 0, 0.9)
		local shells = {
			-- { 반지름, 바닥, 높이, 기울기, 개수, 각도 범위 }
			{ 3.7, 0.55, 3.2, 0, 7, 105 },
			{ 3.3, 3.75, 1.6, 0.4, 7, 105 },
			{ 2.45, 5.3, 1.3, 0.8, 5, 80 },
		}
		for k, s in shells do
			local r, y0, h, tilt, count, range = s[1], s[2], s[3], s[4], s[5], s[6]
			local step = 2 * range / (count - 1)
			local w = 2 * r * math.sin(math.rad(step / 2)) + 0.18
			for i = 0, count - 1 do
				local a = math.rad(-range + i * step)
				local cf = center * CFrame.Angles(0, a, 0) * CFrame.new(0, y0 + h / 2, r) * CFrame.Angles(-tilt, 0, 0)
				block(c, cf, V(w, h, 0.5), if (i + k) % 2 == 0 then shell else mix(shell, BLACK, 0.1))
			end
		end
		-- 본존불
		local bz = 1.1
		col(c, 0, 0.55, bz, 0.5, 3.3, shell)
		col(c, 0, 1.05, bz, 0.6, 1.9, buddha)
		col(c, 0, 1.65, bz, 0.45, 3.4, buddha)
		box(c, 0, 2.1, bz - 0.25, 3.2, 0.9, 2.1, buddha)
		box(c, 0, 3, bz + 0.2, 2, 2.1, 1.2, buddha)
		cyl(c, CFrame.new(0, 4.8, bz + 0.2), 2.4, 0.9, buddha)
		beam(c, V(-1.15, 4.7, bz + 0.1), V(-0.6, 3.2, bz - 0.8), 0.5, buddha)
		beam(c, V(1.15, 4.7, bz + 0.1), V(1.3, 3.1, bz - 0.95), 0.5, buddha)
		ball(c, 0, 5.85, bz + 0.15, 1.5, buddha)
		ball(c, 0, 6.6, bz + 0.2, 0.75, buddha)
		cyl(c, CFrame.new(0, 5.9, 2.75) * ALONG_Z, 0.15, 3, c.A, Mat.Neon)
		for _, sx in { -1, 1 } do
			col(c, sx * 1.7, 0.55, -2.9, 3.4, 0.7, shell)
		end
	end

	-- 아야 소피아: 분홍빛 본당 + 네모 받침 + 창문 띠 위의 납작한 큰 돔 + 앞뒤로 내려앉은 반구 돔
	--   + 버팀벽 + 모서리의 가는 첨탑 4개(연필 모양 지붕)
	B.hagiasophia = function(c)
		local dome = c.S
		box(c, 0, 0, 0, 9.8, 0.25, 9.8, mix(c.P, WHITE, 0.55))
		box(c, 0, 0.25, 0.2, 6.8, 3.2, 6.4, c.P)
		box(c, 0, 0.25, -3.5, 5.4, 2.4, 1.2, mix(c.P, WHITE, 0.1))
		box(c, 0, 3.45, 0.2, 5.6, 1.5, 5.6, c.P)
		for _, s in CORNERS do
			box(c, s[1] * 2.75, 3.45, 0.2 + s[2] * 1.7, 0.9, 2.2, 1.3, mix(c.P, BLACK, 0.08))
		end
		col(c, 0, 4.95, 0.2, 0.6, 5.4, mix(c.P, BLACK, 0.35))
		ball(c, 0, 4.6, 0.2, 5.4, dome)
		ball(c, 0, 3.45, -2.5, 3.6, dome)
		ball(c, 0, 3.45, 2.9, 3.6, dome)
		col(c, 0, 7.2, 0.2, 0.7, 0.14, c.A, Mat.Metal)
		ball(c, 0, 8, 0.2, 0.35, c.A, Mat.Neon)
		for _, s in CORNERS do
			local x, z = s[1] * 4.3, s[2] * 4.3
			col(c, x, 0.25, z, 9.15, 0.55, c.P)
			col(c, x, 7, z, 0.25, 0.9, mix(c.P, WHITE, 0.3))
			col(c, x, 9.4, z, 0.7, 0.5, dome)
			col(c, x, 10.1, z, 1, 0.26, dome)
		end
	end

	-- 카파도키아: 모래빛 골짜기 + 검은 모자를 쓴 요정 굴뚝 바위들(동굴 창) + 하늘에 뜬 열기구 3개
	B.cappadocia = function(c)
		box(c, 0, 0, 0, 9.8, 0.3, 9.8, mix(c.S, SAND, 0.35), Mat.Sand)
		local capColor = mix(c.S, DARK, 0.45)
		local function chimney(x, z, h, d, cave)
			col(c, x, 0.3, z, h * 0.45, d, c.P)
			col(c, x, 0.3 + h * 0.45, z, h * 0.33, d * 0.7, c.P)
			col(c, x, 0.3 + h * 0.78, z, h * 0.22, d * 0.45, mix(c.P, c.S, 0.4))
			ball(c, x, 0.3 + h + d * 0.08, z, d * 0.62, capColor)
			if cave then
				box(c, x, 0.3 + h * 0.2, z - d / 2, 0.4, 0.55, 0.2, DARK)
			end
		end
		chimney(-3.2, 2.4, 6.5, 2.2, true)
		chimney(-0.4, 3.2, 8, 2.4, false)
		chimney(2.6, 2.5, 7, 2.2, true)
		chimney(3.6, -1.2, 5, 1.9, false)
		chimney(-3.4, -1.6, 4.4, 1.8, true)
		chimney(0.5, 0, 5.4, 2, true)
		local function balloon(x, y, z, d, color, stripe)
			ball(c, x, y, z, d, color)
			col(c, x, y - 0.15, z, 0.35, d + 0.04, stripe)
			col(c, x, y - d * 0.62, z, d * 0.3, d * 0.42, color)
			box(c, x, y - d * 0.5 - 0.9, z, 0.45, 0.4, 0.45, WOOD, Mat.Wood)
		end
		balloon(-2.6, 13.5, -1.2, 2.6, c.A, rgb(255, 205, 70))
		balloon(2.4, 15.6, 0.8, 2.4, rgb(255, 205, 70), c.A)
		balloon(0.6, 10.8, -2.8, 2, rgb(70, 140, 230), WHITE)
	end

	-- 자금성(태화전): 돌 포장 광장 + 흰 대리석 3단 기단과 가운데 계단 + 붉은 기둥 전각
	--   + 금빛 기와의 겹처마 지붕(아래 처마 + 위 지붕) + 치문 장식 + 청동 향로
	B.forbiddencity = function(c)
		local marble = c.A
		local red = c.P
		local gold = c.S
		box(c, 0, 0, 0, 9.8, 0.2, 9.8, rgb(172, 166, 158))
		box(c, 0, 0.2, 0.6, 9.2, 0.55, 7.6, marble)
		box(c, 0, 0.75, 0.7, 8.4, 0.55, 6.8, marble)
		box(c, 0, 1.3, 0.8, 7.6, 0.55, 6, marble)
		wedge(c, CFrame.new(0, 0.2 + 0.825, -3.55), V(1.6, 1.65, 1.8), mix(marble, WHITE, 0.3))
		box(c, 0, 1.85, 1.1, 6.4, 2.2, 3.4, mix(red, BLACK, 0.3))
		for k = 0, 5 do
			col(c, -2.75 + k * 1.1, 1.85, -0.85, 2.2, 0.36, red)
		end
		roof(c, 0, 4.05, 0.9, 8.2, 5.4, 0.9, gold)
		box(c, 0, 5, 0.9, 5.2, 1, 2.9, red)
		roof(c, 0, 6, 0.9, 7.4, 4.6, 1.6, gold)
		for _, sx in { -1, 1 } do
			box(c, sx * 3.35, 7.7, 0.9, 0.35, 0.7, 0.45, mix(gold, BLACK, 0.25))
			col(c, sx * 3.2, 1.85, -1.8, 0.55, 0.5, rgb(70, 80, 70), Mat.Metal)
		end
	end

	-- 진시황 병마용: 흙 구덩이(뒤·옆 둑 + 칸막이 흙벽 3줄) + 칸마다 앞을 보고 줄지어 선 흙빛 병사 4x3
	--   (병사 = 아래 전포 + 넓은 갑옷 상체 + 머리)
	B.terracotta = function(c)
		local earth = mix(c.S, SAND, 0.25)
		box(c, 0, 0, 0, 9.8, 0.3, 9.8, mix(earth, BLACK, 0.12))
		box(c, 0, 0.3, 4.5, 9.8, 1.6, 0.8, earth)
		for _, sx in { -1, 1 } do
			box(c, sx * 4.6, 0.3, 0, 0.6, 1.6, 9.8, earth)
		end
		for _, x in { -2.2, 0, 2.2 } do
			box(c, x, 0.3, 0.4, 0.5, 1.3, 7.6, earth)
		end
		local armor = mix(c.P, c.S, 0.55)
		local xs = { -3.3, -1.1, 1.1, 3.3 }
		local zs = { -3, -0.8, 1.4 }
		for i, x in xs do
			for j, z in zs do
				local clay = if (i + j) % 2 == 0 then c.P else mix(c.P, c.A, 0.3)
				box(c, x, 0.3, z, 0.95, 1.2, 0.7, clay)
				box(c, x, 1.5, z, 1.15, 1, 0.8, armor)
				ball(c, x, 2.85, z, 0.72, mix(clay, c.A, 0.25))
			end
		end
	end

	-- 아르테미스 신전: 3단 기단 + 앞쪽 두 줄·옆 한 줄의 가늘고 높은 이오니아식 기둥 숲
	--   + 금빛 기둥머리 띠 + 엔타블러처와 금빛 프리즈 + 정면 박공 + 금빛 아크로테리아
	B.artemis = function(c)
		local marble = c.P
		box(c, 0, 0, 0, 9.8, 0.2, 9.8, mix(c.S, GRASS, 0.3), Mat.Grass)
		box(c, 0, 0.2, 0.2, 9.4, 0.4, 9.4, c.S)
		box(c, 0, 0.6, 0.2, 8.8, 0.4, 8.8, mix(c.S, marble, 0.5))
		box(c, 0, 1, 0.2, 8.2, 0.4, 8.2, marble)
		box(c, 0, 1.4, 1, 4.6, 6, 5.6, mix(c.S, marble, 0.3))
		box(c, 0, 1.4, -1.82, 1.4, 3.2, 0.1, DARK)
		for k = 0, 7 do
			local x = -3.5 + k
			col(c, x, 1.4, -3.5, 6, 0.5, marble)
			col(c, x, 1.4, -2.4, 6, 0.5, marble)
		end
		for _, sx in { -1, 1 } do
			for _, z in { -1.2, 0.3, 1.8, 3.3 } do
				col(c, sx * 3.5, 1.4, z, 6, 0.5, marble)
			end
		end
		box(c, 0, 7.4, 0.2, 7.9, 0.25, 8, c.A)
		box(c, 0, 7.65, 0.2, 8.2, 0.8, 8.2, marble)
		box(c, 0, 7.9, -3.93, 7.8, 0.28, 0.06, c.A)
		frontGable(c, 0, 8.45, 0.2, 8.2, 8.2, 1.7, marble)
		ball(c, 0, 10.2, -3.8, 0.5, c.A, Mat.Metal)
		ball(c, -3.9, 8.7, -3.8, 0.45, c.A, Mat.Metal)
		ball(c, 3.9, 8.7, -3.8, 0.45, c.A, Mat.Metal)
	end

	-- 황룡사 9층 목탑: 돌 기단 + 위로 갈수록 좁아지는 9층 붉은 목조 몸체(초록 단청 공포 + 넓은 기와 처마)
	--   + 금빛 상륜부
	B.hwangnyongsa = function(c)
		local stone = rgb(190, 185, 175)
		box(c, 0, 0, 0, 9.8, 0.2, 9.8, mix(SAND, GRASS, 0.3), Mat.Grass)
		box(c, 0, 0.2, 0, 7.6, 0.5, 7.6, stone)
		box(c, 0, 0.7, 0, 6.6, 0.35, 6.6, stone)
		wedge(c, CFrame.new(0, 0.2 + 0.425, -4.3), V(1.6, 0.85, 1), stone)
		local y = 1.05
		for k = 0, 8 do
			local t = k / 8
			local w = 4.6 - 2.2 * t
			local h = 1.35 - 0.3 * t
			box(c, 0, y, 0, w, h, w, c.P)
			box(c, 0, y + h - 0.28, 0, w + 0.3, 0.28, w + 0.3, c.S)
			local rw = w + 2 - 0.6 * t
			box(c, 0, y + h, 0, rw, 0.32, rw, TILE)
			y += h + 0.32
		end
		col(c, 0, y, 0, 0.5, 1.2, TILE)
		col(c, 0, y + 0.5, 0, 3.6, 0.2, c.A, Mat.Metal)
		for k = 0, 2 do
			col(c, 0, y + 1.1 + k * 0.6, 0, 0.12, 0.8 - k * 0.12, c.A, Mat.Metal)
		end
		ball(c, 0, y + 4.2, 0, 0.45, c.A, Mat.Neon)
	end

	-- 샹그릴라: 푸른 골짜기 + 개울 + 뒤쪽의 눈 덮인 뾰족 봉우리 3개(가운데 피라미드 모양 카라칼)
	--   + 흰 벽과 금빛 지붕의 라마 사원(본전 + 누각 + 양쪽 곁채) + 빛나는 창 + 꽃나무
	B.shangrila = function(c)
		local rock = rgb(112, 120, 138)
		box(c, 0, 0, 0, 9.8, 0.3, 9.8, rgb(110, 185, 90), Mat.Grass)
		box(c, 0, 0.3, -4.3, 9.8, 0.05, 0.7, WATER, Mat.Glass, 0.1)
		-- 용마루가 X 방향인 박공(옆에서 삼각형)
		local function ridge(x, y, z, w, d, h, color, material)
			wedge(c, CFrame.new(x, y + h / 2, z - d / 4), V(w, h, d / 2), color, material)
			wedge(c, CFrame.new(x, y + h / 2, z + d / 4) * CFrame.Angles(0, PI, 0), V(w, h, d / 2), color, material)
		end
		-- 봉우리: 정면 삼각형(폭 w, 두께 d) + (cross 가 있으면) 옆 삼각형(깊이 cross) + 같은 비율의 눈 모자
		local function peak(x, z, w, h, d, cross)
			local sh = h * 0.42
			local top = 0.3 + h + 0.12
			frontGable(c, x, 0.3, z, w, d, h, rock, Mat.Slate)
			frontGable(c, x, top - sh, z, w * sh / h + 0.1, d + 0.2, sh, CLOUD, Mat.Snow)
			if cross then
				ridge(x, 0.3, z, d, cross, h, rock, Mat.Slate)
				ridge(x, top - sh, z, d + 0.2, cross * sh / h + 0.1, sh, CLOUD, Mat.Snow)
			end
		end
		peak(-2.4, 3.3, 5, 7.5, 2.4)
		peak(3.2, 3.1, 3.4, 6.2, 2.2)
		peak(0.6, 3.4, 7, 12.5, 1.2, 3)
		local stone = mix(c.P, SAND, 0.35)
		box(c, 0, 0.3, -0.6, 7.2, 0.9, 4.4, stone)
		wedge(c, CFrame.new(0, 0.75, -3.3), V(1.4, 0.9, 1), stone)
		box(c, 0, 1.2, -0.2, 3.8, 2.2, 2.6, c.P)
		box(c, 0, 2.1, -1.53, 2.8, 0.5, 0.06, c.A, Mat.Neon)
		roof(c, 0, 3.4, -0.2, 4.8, 3.6, 1, c.S)
		box(c, 0, 4.3, -0.2, 2, 1.3, 1.6, c.P)
		gable(c, 0, 5.6, -0.2, 2.6, 2.2, 0.8, c.S)
		col(c, 0, 6.3, -0.2, 0.6, 0.2, c.S, Mat.Metal)
		ball(c, 0, 7.05, -0.2, 0.5, c.A, Mat.Neon)
		for _, sx in { -1, 1 } do
			box(c, sx * 2.9, 1.2, -0.8, 1.4, 1.5, 2, c.P)
			gable(c, sx * 2.9, 2.7, -0.8, 1.7, 2.3, 0.6, c.S)
		end
		plant(c, -4.1, 0.3, -3.3, 1, 1.3, rgb(255, 170, 200))
		plant(c, 4.1, 0.3, -3.1, 1.1, 1.4, LEAF)
	end

	return B
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">Asia2</string>
            <string name="Source"><![CDATA[-- 아시아(2) 명소 전용 모형. Models/init.luau 가 K(파트 헬퍼·색·기존 모양)를 넘겨 호출합니다.
-- 규칙: 바닥 10x10 안, 높이 22 이하, 바닥 y = 0, 정면 -Z, 파트 45개 이하. c.P/c.S/c.A = 명소 주/보조/강조 색, c.M = 재질.

return function(K)
	local V, rgb, Mat, PI, TAU = K.V, K.rgb, K.Mat, K.PI, K.TAU
	local ALONG_Z, CORNERS = K.ALONG_Z, K.CORNERS
	local LEAF, WATER, DARK, TILE, ROCK, WOOD, SAND, CLOUD, BLACK, WHITE =
		K.LEAF, K.WATER, K.DARK, K.TILE, K.ROCK, K.WOOD, K.SAND, K.CLOUD, K.BLACK, K.WHITE
	local mix, block, box, ball, cyl, col, wedge, beam, facing, roof, gable, plant =
		K.mix, K.block, K.box, K.ball, K.cyl, K.col, K.wedge, K.beam, K.facing, K.roof, K.gable, K.plant

	local B = {}

	-- 기와지붕(K.roof)을 다른 재질로 씌움
	local function roofWith(c, material, x, y, z, w, d, h, color)
		local keep = c.M
		c.M = material
		roof(c, x, y, z, w, d, h, color)
		c.M = keep
	end

	-- 삼각형 판: 밑변 a-b(꼭짓점 p 가 그 위쪽) 를 잇는 두께 t 의 판(직각 쐐기 두 개, p 에서 내린 수선으로 나눔).
	-- p 의 수선 발이 a-b 사이에 와야 함. 쐐기 상자의 빈 모서리도 p 높이 아래·안쪽에 머묾.
	-- out = 1 이면 inside 반대쪽(바깥)으로, -1 이면 inside 쪽으로 두께를 줌(면이 정확히 삼각형 평면에 오도록)
	local function tri(
		c,
		a: Vector3,
		b: Vector3,
		p: Vector3,
		t: number,
		color: Color3,
		material,
		inside: Vector3,
		out: number
	)
		local along = (b - a).Unit
		local foot = a + along * (p - a):Dot(along)
		local h = (p - foot).Magnitude
		local up = (p - foot).Unit
		local normal = (b - a):Cross(p - a).Unit
		if normal:Dot(inside - a) > 0 then
			normal = -normal
		end
		local shift = normal * (out * t / 2)
		local da, db = (foot - a):Dot(along), (b - foot):Dot(along)
		if da > 0.02 then
			local center = foot + up * (h / 2) - along * (da / 2) + shift
			wedge(c, CFrame.lookAt(center, center - along, up), V(t, h, da), color, material)
		end
		if db > 0.02 then
			local center = foot + up * (h / 2) + along * (db / 2) + shift
			wedge(c, CFrame.lookAt(center, center + along, up), V(t, h, db), color, material)
		end
	end

	-- 삼각뿔/사각뿔 봉우리: 바위 면(안쪽 두께) + 면마다 꼭대기에서 snow[i] 비율까지 덮는 눈 면(바깥 두께).
	-- ring[i] → ring[i + 1] 이 i 번째 면의 밑변. 꼭대기의 수선 발이 각 밑변 안에 오도록 둘 것
	local function peak(c, apex: Vector3, ring: { Vector3 }, rock: Color3, snowColor: Color3, snow: { number }?)
		local center = V(apex.X, ring[1].Y, apex.Z)
		for i, a in ring do
			local b = ring[i % #ring + 1]
			tri(c, a, b, apex, 0.3, rock, Mat.Rock, center, -1)
		end
		if snow then
			for i, a in ring do
				local b = ring[i % #ring + 1]
				local f = snow[i]
				if f > 0 then
					tri(c, apex + (a - apex) * f, apex + (b - apex) * f, apex, 0.12, snowColor, Mat.Snow, center, 1)
				end
			end
		end
	end

	-- 돌하르방: 둥근 잔디 + 제주 검은 돌담 + 유채꽃 + 귤나무, 가운데에 벙거지 모자·왕방울 눈·큰 코·배 위에 얹은 두 손의 현무암 석상
	function B.dolhareubang(c)
		local stone = mix(c.P, WHITE, 0.22)
		local pale = mix(c.P, WHITE, 0.34)
		local basalt = mix(c.P, BLACK, 0.3)
		col(c, 0, 0, 0, 0.3, 9.8, c.S, Mat.Grass)
		for _, a in { -0.95, 0, 0.95 } do
			local px, pz = 3.9 * math.sin(a), 3.9 * math.cos(a)
			block(c, CFrame.new(px, 0.75, pz) * facing(px, pz), V(3, 0.9, 0.7), basalt)
		end
		for _, f in
			{ { -2.9, -2.4, 0.8 }, { -3.6, -1.3, 0.7 }, { -2.2, -3.3, 0.7 }, { -3.4, 0.1, 0.6 }, { -1.3, -3.9, 0.6 } }
		do
			ball(c, f[1], 0.3 + f[3] * 0.4, f[2], f[3], rgb(250, 214, 48), Mat.Grass)
		end
		plant(c, 3, 0.3, -2.3, 1.2, 2, LEAF)
		for _, d in
			{ V(-0.5, 0.3, -0.8), V(0.45, 0.5, -0.75), V(0.9, -0.1, -0.4), V(-0.1, 0.95, -0.3), V(-0.85, -0.2, -0.5) }
		do
			local p = V(3, 2.1, -2.3) + d.Unit
			ball(c, p.X, p.Y, p.Z, 0.42, c.A)
		end
		-- 석상
		col(c, 0, 0.3, 0, 0.7, 3.8, basalt)
		col(c, 0, 1, 0, 5.2, 3.1, stone)
		cyl(c, CFrame.new(-0.25, 4.5, -1.35), 2.1, 0.75, stone)
		cyl(c, CFrame.new(0.25, 3.45, -1.35), 2.1, 0.75, stone)
		beam(c, V(-1.45, 5.9, 0), V(-1.25, 4.5, -1.05), 0.6, stone)
		beam(c, V(1.45, 5.9, 0), V(1.3, 3.45, -1.05), 0.6, stone)
		ball(c, 0, 7.5, -0.1, 3.5, stone)
		for _, sx in { -1, 1 } do
			box(c, sx * 1.66, 6.4, 0, 0.25, 1.5, 0.55, stone)
			ball(c, sx * 0.72, 7.9, -1.4, 1.15, pale)
			ball(c, sx * 0.72, 7.9, -1.93, 0.36, DARK)
		end
		wedge(c, CFrame.new(0, 6.95, -1.95), V(1.05, 1.7, 0.75), pale)
		box(c, 0, 5.87, -1.58, 1.2, 0.18, 0.1, DARK)
		col(c, 0, 8.7, 0, 0.35, 3.9, stone)
		col(c, 0, 9.05, 0, 0.8, 3.1, stone)
		ball(c, 0, 9.8, 0, 3.1, stone)
	end

	-- 다보탑: 사방 돌계단의 기단 + 네 귀 돌기둥과 가운데 기둥 + 네모 옥개석 + 네모 난간 + 대나무 마디 기둥의 팔각 난간
	--   + 연꽃 받침 + 팔각 지붕돌 + 상륜(노반·복발·보륜·보주)
	function B.dabotap(c)
		local stone = c.P
		local joint = mix(c.P, BLACK, 0.15)
		box(c, 0, 0, 0, 9.8, 0.25, 9.8, mix(c.S, SAND, 0.45), Mat.Sand)
		box(c, 0, 0.25, 0, 6, 1.5, 6, stone)
		box(c, 0, 1.75, 0, 6.3, 0.25, 6.3, joint)
		for i = 0, 3 do
			wedge(c, CFrame.Angles(0, i * PI / 2, 0) * CFrame.new(0, 1.125, -3.8), V(1.5, 1.75, 1.6), stone)
		end
		local y = 2
		for _, s in CORNERS do
			box(c, s[1] * 1.9, y, s[2] * 1.9, 0.55, 2.5, 0.55, stone)
		end
		box(c, 0, y, 0, 1.2, 2.5, 1.2, stone)
		y += 2.5
		box(c, 0, y, 0, 4.7, 0.3, 4.7, joint)
		box(c, 0, y + 0.3, 0, 5.4, 0.45, 5.4, stone)
		y += 0.75
		box(c, 0, y, 0, 2.4, 1.5, 2.4, stone)
		for i = 0, 3 do
			block(c, CFrame.Angles(0, i * PI / 2, 0) * CFrame.new(0, y + 0.45, -2.3), V(4.7, 0.9, 0.16), stone)
		end
		y += 1.5
		col(c, 0, y, 0, 0.3, 3.4, joint)
		y += 0.3
		col(c, 0, y, 0, 1.4, 1.5, stone)
		for i = 0, 7 do
			local a = i * PI / 4 + PI / 8
			col(c, 1.3 * math.cos(a), y, 1.3 * math.sin(a), 1.4, 0.24, stone)
		end
		y += 1.4
		col(c, 0, y, 0, 0.3, 3, joint)
		col(c, 0, y + 0.3, 0, 0.45, 2, stone)
		y += 0.75
		col(c, 0, y, 0, 0.35, 3.9, stone)
		y += 0.35
		col(c, 0, y, 0, 0.45, 1.1, stone)
		ball(c, 0, y + 0.8, 0, 1, stone)
		col(c, 0, y + 1.2, 0, 2.3, 0.2, stone)
		for k, d in { 0.95, 0.8, 0.65 } do
			col(c, 0, y + 1.3 + k * 0.45, 0, 0.14, d, stone)
		end
		ball(c, 0, y + 3.6, 0, 0.45, c.A, Mat.Metal)
	end

	-- 경복궁 근정전: 박석 마당 + 품계석 + 돌난간 두른 2단 월대와 가운데 계단 + 붉은 기둥 늘어선 전각
	--   + 초록 단청 띠 + 들린 추녀의 겹처마 기와지붕 두 겹
	function B.gyeongbokgung(c)
		local granite = rgb(208, 202, 190)
		local rail = rgb(238, 234, 224)
		local wall = mix(c.P, BLACK, 0.3)
		box(c, 0, 0, 0, 9.8, 0.2, 9.8, mix(granite, SAND, 0.35), Mat.Sand)
		for _, sx in { -1, 1 } do
			for _, z in { -4.3, -3.3 } do
				box(c, sx * 1.4, 0.2, z, 0.35, 0.45, 0.25, granite, Mat.Granite)
			end
		end
		box(c, 0, 0.2, 1.2, 9.2, 0.8, 6.8, granite, Mat.Granite)
		box(c, 0, 1, 1.45, 7.6, 0.8, 5.5, granite, Mat.Granite)
		wedge(c, CFrame.new(0, 0.6, -2.65), V(1.6, 0.8, 0.9), granite, Mat.Granite)
		wedge(c, CFrame.new(0, 1.4, -1.75), V(1.4, 0.8, 0.9), granite, Mat.Granite)
		for _, sx in { -1, 1 } do
			box(c, sx * 2.7, 1, -2.14, 3.8, 0.3, 0.12, rail, Mat.Marble)
			box(c, sx * 2.3, 1.8, -1.19, 3, 0.3, 0.12, rail, Mat.Marble)
			box(c, sx * 3.74, 1.8, 1.45, 0.12, 0.3, 5.5, rail, Mat.Marble)
		end
		local y = 1.8
		box(c, 0, y, 1.8, 6, 2, 3.4, wall)
		for k = 0, 5 do
			col(c, -2.75 + k * 1.1, y, 0.02, 2, 0.32, c.P)
		end
		box(c, 0, y + 1.65, 1.8, 6.3, 0.4, 3.7, c.S)
		roofWith(c, Mat.Slate, 0, y + 2.05, 1.8, 8.2, 5.6, 0.9, TILE)
		box(c, 0, 4.5, 1.8, 4.8, 1.3, 2.6, wall)
		box(c, 0, 5.75, 1.8, 5, 0.35, 2.8, c.S)
		roofWith(c, Mat.Slate, 0, 6.1, 1.8, 7.2, 4.6, 1.3, TILE)
	end

	-- 초콜릿 힐: 흙 단면이 보이는 들판 위에 고르게 솟은 갈색 둥근 언덕들(일부는 풀빛) + 전망대 언덕 + 덤불
	function B.chocolatehills(c)
		local base = 1
		box(c, 0, 0, 0, 9.8, base - 0.15, 9.8, mix(c.P, BLACK, 0.3), Mat.Ground)
		box(c, 0, base - 0.15, 0, 9.8, 0.15, 9.8, mix(c.S, LEAF, 0.35), Mat.Grass)
		-- { x, z, 지름 }: 공 중심 = 지름 / 2 (바닥 판이 아래쪽을 가림)
		local hills = {
			{ -3.7, -3.6, 2.2 },
			{ -1.3, -3.9, 2 },
			{ 1.2, -3.5, 2.3 },
			{ 3.7, -3.8, 2.1 },
			{ -3.9, -1.2, 2 },
			{ -1.8, -1.6, 1.9 },
			{ 2.5, -1.3, 2.3 },
			{ 4, 0.9, 1.9 },
			{ -3.5, 1.3, 2.3 },
			{ 1.8, 1.5, 2.1 },
			{ -3.8, 3.8, 2.1 },
			{ -1.3, 3.4, 2.3 },
			{ 1.1, 3.9, 2 },
			{ 3.6, 3.6, 2.3 },
			{ 0.4, -1.9, 1.7 },
		}
		for k, h in hills do
			local color = if k % 5 == 2 then mix(c.P, c.S, 0.55) else mix(c.P, BLACK, (k % 3) * 0.06)
			ball(c, h[1], h[3] / 2, h[2], h[3], color)
		end
		ball(c, -0.4, 1.5, 0.6, 3, c.P)
		box(c, -0.4, 2.85, 0.6, 1, 0.5, 1, c.A, Mat.Concrete)
		gable(c, -0.4, 3.35, 0.6, 1.2, 1.2, 0.5, rgb(190, 60, 50))
		for _, t in { { -2.6, -2.8, 0.7 }, { 3.1, -2.5, 0.6 }, { -2.2, 2.3, 0.8 }, { 2.9, 2.6, 0.7 } } do
			ball(c, t[1], base + t[3] / 2 - 0.1, t[2], t[3], LEAF, Mat.Grass)
		end
	end

	-- 금각사: 거울 연못 + 소나무 섬 + 뒤쪽 숲 + 돌 기단 위 3층 누각
	--   (1층 흰 벽·나무 기둥, 2·3층 금박, 얇게 뻗은 너와 처마, 꼭대기 금 봉황) + 물에 비친 금빛 + 낚시 정자
	function B.kinkakuji(c)
		local pond = mix(WATER, c.A, 0.5)
		local shingle = rgb(72, 54, 42)
		local wood = rgb(125, 90, 60)
		local plaster = rgb(242, 238, 228)
		box(c, 0, 0, 0, 9.8, 0.2, 9.8, pond, Mat.Glass, 0.1)
		box(c, 0, 0, 3.8, 9.8, 0.5, 2.2, c.S, Mat.Grass)
		ball(c, -3.7, 1.6, 3.9, 2.2, c.S, Mat.Grass)
		ball(c, 3.7, 1.8, 3.8, 2.4, mix(c.S, BLACK, 0.15), Mat.Grass)
		col(c, -3.4, 0, -3.1, 0.35, 1.9, ROCK, Mat.Slate)
		ball(c, -3.4, 1, -3.1, 1.2, LEAF, Mat.Grass)
		col(c, 3.5, 0, -3.6, 0.3, 1.4, ROCK, Mat.Slate)
		ball(c, 3.5, 0.8, -3.6, 0.9, LEAF, Mat.Grass)
		box(c, 0, 0.2, -2.6, 4.8, 0.03, 2.2, c.P, Mat.Glass, 0.55)
		-- 누각(s 배 크기)
		local s, z = 1.18, 1
		local function part(x, y, w, h, d, color, material)
			box(c, x * s, y * s, z, w * s, h * s, d * s, color, material)
		end
		part(0, 0, 5, 0.45, 4.2, ROCK, Mat.Slate)
		part(0, 0.45, 4.4, 1.6, 3.6, plaster, Mat.Plaster)
		for _, x in { -2.1, -0.7, 0.7, 2.1 } do
			box(c, x * s, 0.45 * s, z - 1.85 * s, 0.22 * s, 1.6 * s, 0.14, wood, Mat.Wood)
		end
		part(0, 2.05, 5.4, 0.2, 4.6, shingle, Mat.Wood)
		part(0, 2.25, 4.8, 0.15, 4, shingle, Mat.Wood)
		part(0, 2.4, 4.1, 1.5, 3.3, c.P)
		part(0, 2.4, 4.5, 0.35, 3.7, c.P)
		part(0, 3.9, 5.2, 0.2, 4.4, shingle, Mat.Wood)
		part(0, 4.1, 4.4, 0.15, 3.6, shingle, Mat.Wood)
		part(0, 4.25, 2.6, 1.35, 2.4, c.P)
		roofWith(c, Mat.Wood, 0, 5.6 * s, z, 3.9 * s, 3.6 * s, 1.1 * s, shingle)
		local top = (5.6 + 0.3) * s + 1.1 * s
		box(c, 0, top, z, 0.24, 0.6, 0.24, c.P)
		wedge(c, CFrame.new(0, top + 0.7, z), V(1.1, 0.5, 0.6), c.P)
		box(c, -3.6, 0.2, 0.4, 1.3, 0.9, 1.3, wood, Mat.Wood)
		box(c, -3.6, 1.1, 0.4, 1.7, 0.2, 1.7, shingle, Mat.Wood)
	end

	-- 천단 기년전: 3단 원형 흰 대리석 기단(사방 계단) + 붉은 원통 몸체 + 단청 띠 + 파란 원뿔 지붕 세 겹 + 금빛 보주
	function B.templeofheaven(c)
		local marble = c.A
		local railColor = mix(c.A, rgb(150, 150, 150), 0.3)
		local band = rgb(40, 130, 110)
		local gold = rgb(235, 190, 70)
		box(c, 0, 0, 0, 9.8, 0.2, 9.8, rgb(165, 160, 155), Mat.Concrete)
		local y = 0.2
		for _, d in { 9.4, 7.8, 6.2 } do
			col(c, 0, y, 0, 0.55, d, marble)
			col(c, 0, y + 0.55, 0, 0.18, d - 0.15, railColor)
			y += 0.73
		end
		local rise = y - 0.2
		for i = 0, 3 do
			wedge(c, CFrame.Angles(0, i * PI / 2, 0) * CFrame.new(0, 0.2 + rise / 2, -3.9), V(1.2, rise, 1.6), marble)
		end
		local function tier(bodyD: number, bodyH: number, discs: { { number } })
			col(c, 0, y, 0, bodyH, bodyD, c.S)
			y += bodyH
			col(c, 0, y, 0, 0.25, bodyD + 0.2, band)
			y += 0.25
			for _, disc in discs do
				col(c, 0, y, 0, disc[2], disc[1], c.P)
				y += disc[2]
			end
		end
		tier(4.4, 1.5, { { 6, 0.28 }, { 5.1, 0.3 }, { 4.1, 0.3 }, { 3.2, 0.25 } })
		tier(3.3, 0.85, { { 4.8, 0.28 }, { 4, 0.3 }, { 3.1, 0.3 }, { 2.3, 0.25 } })
		tier(2.3, 0.7, { { 3.6, 0.28 }, { 2.9, 0.32 }, { 2.1, 0.32 }, { 1.4, 0.3 }, { 0.7, 0.25 } })
		col(c, 0, y, 0, 0.5, 0.3, gold, Mat.Metal)
		ball(c, 0, y + 0.75, 0, 0.6, gold, Mat.Metal)
	end

	-- 포탈라궁: 마르포리 언덕(흰 지그재그 계단) + 층층이 흰 궁전(창 줄) + 가운데 우뚝한 붉은 궁전
	--   + 지붕 아래 검붉은 펜바 띠 + 금빛 지붕 세 채와 승리 깃발 + 앞쪽 성벽
	function B.potala(c)
		local white, red, gold = c.P, c.S, c.A
		local frieze = rgb(92, 34, 30)
		local hill = rgb(140, 118, 92)
		box(c, 0, 0, 0, 9.8, 0.25, 9.8, rgb(150, 140, 110), Mat.Ground)
		wedge(c, CFrame.new(0, 1.15, -2.6), V(9.8, 1.8, 2.2), hill, Mat.Rock)
		box(c, 0, 0.25, 1.2, 9.4, 3.2, 5.4, white)
		box(c, 0, 3.2, 1.2, 9.5, 0.25, 5.5, frieze)
		for _, wy in { 2.2, 2.75 } do
			for _, x in { -3.2, 0, 3.2 } do
				box(c, x, wy, -1.52, 2.4, 0.26, 0.06, DARK)
			end
		end
		for _, sx in { -1, 1 } do
			box(c, sx * 3.1, 3.45, 1.3, 2.8, 2.45, 4.4, white)
			box(c, sx * 3.1, 5.9, 1.3, 2.9, 0.4, 4.5, frieze)
			box(c, sx * 3.1, 4.6, -0.92, 2, 0.28, 0.06, DARK)
			beam(c, V(sx * 4.3, 0.55, -3.5), V(sx * 1.9, 1.3, -2.8), 0.25, white)
			beam(c, V(sx * 1.9, 1.35, -2.75), V(sx * 4.1, 2, -1.75), 0.25, white)
			col(c, sx * 1.55, 8.65, -0.4, 0.8, 0.24, gold, Mat.Metal)
			ball(c, sx * 4.4, 0.65, -4.3, 0.8, LEAF, Mat.Grass)
		end
		box(c, 0, 3.45, 1.2, 3.8, 1.35, 4.6, white)
		box(c, 0, 4.8, 1.3, 3.4, 3.4, 4, red)
		box(c, 0, 8.2, 1.3, 3.5, 0.45, 4.1, frieze)
		for _, wy in { 5.6, 6.5, 7.4 } do
			box(c, 0, wy, -0.72, 2.6, 0.3, 0.06, DARK)
		end
		-- 금빛 지붕 세 채(작은 붉은 누각 위)
		for _, g in { { -1.05, 0.8, 1.9 }, { 0.1, 1.1, 1.3 }, { 1.15, 0.8, 2 } } do
			box(c, g[1], 8.65, g[3], g[2] - 0.2, 0.35, g[2] - 0.2, frieze)
			gable(c, g[1], 9, g[3], g[2] + 0.1, g[2] + 0.1, 0.55, gold)
		end
		box(c, 0, 0.25, -4.5, 8.4, 0.7, 0.35, white)
	end

	-- 하롱베이: 에메랄드 바다 + 물가가 파여 들어간 석회암 섬들(비틀린 바위 두 덩이 + 초록 숲 덮개) + 붉은 돛 정크선
	function B.halong(c)
		box(c, 0, 0, 0, 9.8, 0.3, 9.8, c.S, Mat.Glass, 0.1)
		local lime = mix(mix(ROCK, c.P, 0.45), SAND, 0.15)
		local lime2 = mix(lime, WHITE, 0.12)
		local wet = mix(lime, BLACK, 0.35)
		local jungle = mix(LEAF, c.P, 0.2)
		local function karst(x: number, z: number, h: number, w: number, d: number, twist: number)
			local cf = CFrame.new(x, 0, z) * CFrame.Angles(0, twist, 0)
			col(c, x, 0.3, z, 0.45, math.min(w, d) * 0.8, wet)
			local body = h - 0.75
			block(
				c,
				cf * CFrame.new(0, 0.75 + body * 0.42, 0) * CFrame.Angles(0.04, 0, -0.03),
				V(w, body * 0.84, d),
				lime
			)
			block(
				c,
				cf * CFrame.new(w * 0.05, 0.75 + body * 0.4, -d * 0.04) * CFrame.Angles(0, PI / 4, 0.05),
				V(w * 0.8, body * 0.8, d * 0.8),
				lime2
			)
			local top = math.max(w, d) * 1.02
			ball(c, x, h - top * 0.28, z, top, jungle, Mat.Grass)
		end
		karst(-3.1, 2.9, 4.8, 2.8, 2.4, 0.3)
		karst(-0.2, 3.4, 3.6, 2.4, 1.8, -0.4)
		karst(2.7, 2.6, 5.6, 2.5, 2.4, 0.6)
		karst(3.7, -0.5, 3.2, 1.9, 2.1, -0.2)
		karst(-3.5, -0.6, 3, 2, 1.8, 0.8)
		karst(0.5, 0.7, 2.4, 1.9, 1.7, 0.2)
		karst(-1.9, -3, 1.8, 1.5, 1.3, -0.5)
		-- 정크선(왼쪽으로 항해): 선체 + 높은 고물 + 세 돛대의 붉은 돛
		local bx, bz = 1.7, -3.4
		box(c, bx, 0.3, bz, 2.8, 0.4, 0.9, WOOD, Mat.Wood)
		box(c, bx + 1.05, 0.7, bz, 0.7, 0.4, 0.9, WOOD, Mat.Wood)
		for _, s in { { -0.9, 0.75, 1.3 }, { 0.05, 1, 2 }, { 0.95, 0.7, 1.2 } } do
			col(c, bx + s[1], 0.7, bz, s[3] + 0.4, 0.08, DARK)
			block(
				c,
				CFrame.new(bx + s[1] + 0.05, 1.05 + s[3] / 2, bz - 0.08) * CFrame.Angles(0, 0.3, 0),
				V(s[2], s[3], 0.06),
				c.A,
				Mat.Fabric
			)
		end
	end

	-- 장가계: 짙은 숲 골짜기에서 솟은 가느다란 사암 기둥들(두 덩이를 비틀어 쌓음 + 풀 덮인 꼭대기 + 소나무)
	--   + 기둥 사이를 떠도는 구름 + 천하제일교(두 기둥을 잇는 돌다리)
	function B.zhangjiajie(c)
		box(c, 0, 0, 0, 9.8, 0.4, 9.8, mix(c.S, BLACK, 0.25), Mat.Grass)
		local low = mix(c.P, BLACK, 0.08)
		local high = mix(c.P, rgb(210, 190, 160), 0.35)
		local pine = mix(LEAF, c.S, 0.3)
		local function pillar(x: number, z: number, h: number, w: number, twist: number)
			local bottom = h * 0.55
			block(c, CFrame.new(x, 0.4 + bottom / 2, z) * CFrame.Angles(0, twist, 0), V(w, bottom, w * 0.9), low)
			local upper = h - bottom
			local cf = CFrame.new(x + w * 0.05, 0.4 + bottom + upper / 2 - 0.05, z - w * 0.05)
				* CFrame.Angles(0, twist + 0.4, 0)
			block(c, cf, V(w * 0.8, upper, w * 0.75), high)
			local top = cf * V(0, upper / 2 + w * 0.25, 0)
			ball(c, top.X, top.Y, top.Z, w * 1.15, pine, Mat.Grass)
			local side = cf * V(-w * 0.42, upper * 0.1, -w * 0.3)
			ball(c, side.X, side.Y, side.Z, w * 0.7, pine, Mat.Grass)
		end
		pillar(-2.6, 2.4, 17, 1.8, 0.2)
		pillar(0.4, 3.4, 14, 1.6, -0.3)
		pillar(3, 2, 15.5, 1.7, 0.5)
		pillar(-3.6, -0.9, 11, 1.5, -0.1)
		pillar(-0.8, 0.1, 12.5, 1.5, 0.7)
		pillar(2, -1, 9.5, 1.4, 0.1)
		pillar(3.7, -3.4, 7, 1.3, -0.4)
		pillar(-1.8, -3.3, 6.5, 1.3, 0.3)
		beam(c, V(-2, 12.2, 2.6), V(-0.1, 12.2, 3.2), 0.6, high)
		-- 기둥 사이를 떠도는 구름
		for _, cl in { { -1, 7.4, 2.2, 2.6 }, { 2.6, 5.6, 0.6, 2.2 }, { -2.4, 3.6, -1.6, 2.4 }, { 1.2, 3, -2.6, 2 } } do
			ball(c, cl[1], cl[2], cl[3], cl[4], c.A, Mat.SmoothPlastic, 0.3)
		end
		for _, t in { { 0.6, -3.6, 1.4 }, { -4, 3.9, 1.3 }, { 4.1, 0.7, 1.2 } } do
			ball(c, t[1], 0.4 + t[3] * 0.35, t[2], t[3], LEAF, Mat.Grass)
		end
	end

	-- 보로부두르: 밀림 잔디 + 네모 기단 5층(사방 계단) + 원형 단 3층에 둘러앉은 종 모양 스투파들 + 꼭대기 큰 스투파
	function B.borobudur(c)
		local stone = c.P
		local dark = mix(c.P, BLACK, 0.18)
		box(c, 0, 0, 0, 9.8, 0.2, 9.8, c.S, Mat.Grass)
		local y = 0.2
		for i, w in { 8.8, 7.8, 6.8, 5.8, 4.8 } do
			box(c, 0, y, 0, w, 0.5, w, if i % 2 == 1 then stone else dark)
			y += 0.5
		end
		for i = 0, 3 do
			local cf = CFrame.Angles(0, i * PI / 2, 0) * CFrame.new(0, 1.45, -3.68)
			wedge(c, cf, V(0.9, 2.5, 2.5), mix(stone, WHITE, 0.2))
		end
		-- 원형 단 + 스투파 고리: { 단 지름, 고리 반지름, 스투파 수, 스투파 지름 }
		for _, ring in { { 4.4, 1.97, 12, 0.5 }, { 3.5, 1.52, 9, 0.46 }, { 2.6, 1.07, 6, 0.42 } } do
			col(c, 0, y, 0, 0.3, ring[1], stone)
			y += 0.3
			for k = 0, ring[3] - 1 do
				local a = k / ring[3] * TAU + ring[2]
				ball(c, ring[2] * math.cos(a), y + ring[4] * 0.35, ring[2] * math.sin(a), ring[4], stone)
			end
		end
		ball(c, 0, y + 0.6, 0, 1.5, stone)
		box(c, 0, y + 1.25, 0, 0.45, 0.35, 0.45, stone)
		col(c, 0, y + 1.6, 0, 0.8, 0.22, stone)
	end

	-- 에베레스트: 빙하 바닥 + 눈 덮인 사각뿔 주봉(앞으로 뻗은 능선) + 뒤 오른쪽 로체 + 앞 왼쪽 눕체
	--   + 정상에서 옆으로 흩날리는 눈보라 깃 + 베이스캠프 텐트 + 오색 타르초(룽다)
	function B.everest(c)
		local snow, rock = c.P, c.S
		local g = 0.35
		box(c, 0, 0, 0, 9.8, g, 9.8, mix(c.S, WHITE, 0.7), Mat.Glacier)
		peak(
			c,
			V(-0.2, 9.6, 1),
			{ V(-4.7, g, -0.4), V(0.4, g, -4.4), V(4.6, g, 0.3), V(-0.4, g, 4.7) },
			rock,
			snow,
			{ 0.68, 0.6, 0.72, 0.6 }
		)
		local lhotse = { V(1.4, g, 0.4), V(4.8, g, 1.1), V(3.8, g, 4.8) }
		peak(c, V(3.2, 7.6, 2.8), lhotse, mix(rock, WHITE, 0.1), snow, { 0.55, 0.62, 0 })
		local nuptse = { V(-4.8, g, -1.1), V(-2.4, g, -4.8), V(-0.4, g, -1.4) }
		peak(c, V(-2.8, 6.4, -2.4), nuptse, mix(rock, WHITE, 0.18), snow, { 0.5, 0.55, 0 })
		ball(c, 0.55, 9.25, 1, 1.6, CLOUD, Mat.SmoothPlastic, 0.3)
		gable(c, 2.9, g, -4.1, 1.1, 0.9, 0.65, c.A)
		col(c, 1.1, g, -4.3, 1.9, 0.1, WOOD, Mat.Wood)
		local flags = { rgb(40, 90, 220), rgb(220, 40, 40), rgb(40, 170, 70), rgb(250, 210, 40) }
		for k, color in flags do
			local t = k / 5
			local p = V(1.1 + 3.5 * t, 2.2 - 1.4 * t, -4.3 + 1.1 * t)
			block(
				c,
				CFrame.new(p.X, p.Y - 0.2, p.Z) * CFrame.Angles(0, -0.3, 0),
				V(0.35, 0.35, 0.04),
				color,
				Mat.Fabric
			)
		end
	end

	-- 마우솔로스 영묘: 계단 기단 + 높은 대리석 받침(부조 띠·코니스) + 이오니아식 열주로 두른 안채
	--   + 24단 계단식 피라미드 지붕(6단으로 줄임) + 꼭대기 청동 4두 전차
	function B.mausoleum(c)
		local marble, stone, gold = c.P, c.S, c.A
		box(c, 0, 0, 0, 9.8, 0.25, 9.8, mix(stone, WHITE, 0.3))
		box(c, 0, 0.25, 0, 7.6, 0.5, 6.4, stone)
		box(c, 0, 0.75, 0, 7, 4.2, 5.8, marble)
		box(c, 0, 3.8, 0, 7.06, 0.6, 5.86, stone)
		box(c, 0, 4.95, 0, 7.3, 0.35, 6.1, stone)
		box(c, 0, 0.75, -2.92, 1, 1.6, 0.06, DARK)
		local y = 5.3
		box(c, 0, y, 0, 4.6, 2.2, 3.4, mix(marble, stone, 0.35))
		for _, x in { -3, -1.5, 0, 1.5, 3 } do
			for _, sz in { -1, 1 } do
				col(c, x, y, sz * 2.4, 2.2, 0.42, marble)
			end
		end
		for _, sx in { -1, 1 } do
			for _, z in { -0.8, 0.8 } do
				col(c, sx * 3, y, z, 2.2, 0.42, marble)
			end
		end
		y += 2.2
		box(c, 0, y, 0, 6.8, 0.5, 5.6, marble)
		y += 0.5
		for k = 0, 5 do
			box(c, 0, y, 0, 6.4 - k * 0.8, 0.45, 5.2 - k * 0.7, marble)
			y += 0.45
		end
		box(c, 0, y, 0, 1.6, 0.5, 1.4, stone)
		y += 0.5
		box(c, 0, y, -0.2, 1.2, 0.35, 0.6, mix(gold, BLACK, 0.35), Mat.Metal)
		box(c, 0, y + 0.35, -0.2, 1.3, 0.4, 0.85, gold, Mat.Metal)
		for k = 0, 3 do
			local cf = CFrame.new(-0.48 + k * 0.32, y + 0.95, -0.62) * CFrame.Angles(0.5, 0, 0)
			block(c, cf, V(0.2, 0.55, 0.25), gold, Mat.Metal)
		end
		box(c, 0, y + 0.2, 0.45, 0.8, 0.5, 0.45, gold, Mat.Metal)
		col(c, 0, y + 0.7, 0.45, 0.6, 0.3, gold, Mat.Metal)
		ball(c, 0, y + 1.45, 0.45, 0.3, gold, Mat.Metal)
	end

	-- 트로이 목마: 모래밭 + 뒤쪽 트로이 성벽(탑·성가퀴·성문) + 바퀴 달린 받침 위의 거대한 나무 말
	--   (통나무 몸통, 굵은 네 다리, 치켜든 목과 머리, 갈기, 꼬리, 옆구리 비밀 문). 앞 왼쪽을 보며 옆모습이 보이게 비스듬히 섬
	function B.trojanhorse(c)
		local wood, dark = c.P, c.S
		local stone = rgb(205, 188, 150)
		box(c, 0, 0, 0, 9.8, 0.2, 9.8, SAND, Mat.Sand)
		box(c, 0, 0.2, 4.3, 9.8, 3.4, 1.2, stone, Mat.Sandstone)
		for _, sx in { -1, 1 } do
			box(c, sx * 4.1, 0.2, 4.1, 1.6, 4.8, 1.6, stone, Mat.Sandstone)
		end
		for _, x in { -2.6, -1.3, 0, 1.3, 2.6 } do
			box(c, x, 3.6, 3.9, 0.6, 0.5, 0.4, stone, Mat.Sandstone)
		end
		box(c, 0, 0.2, 3.68, 1.6, 2.2, 0.1, DARK)
		-- 말(로컬 좌표: 머리가 -X)
		c.origin = CFrame.new(0.2, 0, -0.9) * CFrame.Angles(0, -0.45, 0)
		box(c, 0, 0.75, 0, 6.2, 0.4, 2.4, dark)
		for _, s in CORNERS do
			cyl(c, CFrame.new(s[1] * 2.3, 0.75, s[2] * 1.35) * ALONG_Z, 0.3, 1.5, dark)
			box(c, s[1] * 1.9, 1.15, s[2] * 0.65, 0.6, 2.6, 0.6, wood)
		end
		cyl(c, CFrame.new(0, 4.6, 0), 5.4, 2.6, wood)
		ball(c, -2.5, 4.75, 0, 2.5, wood)
		ball(c, 2.5, 4.7, 0, 2.5, wood)
		beam(c, V(-2.5, 5.2, 0), V(-3.4, 8, 0), 1.3, wood)
		block(c, CFrame.new(-3.9, 8.1, 0) * CFrame.Angles(0, 0, 0.45), V(2, 1, 1), wood)
		beam(c, V(-1.8, 5.45, 0), V(-2.7, 8.25, 0), 0.4, dark)
		beam(c, V(2.9, 5.3, 0), V(3.5, 2.6, 0), 0.45, dark)
		for _, sz in { -1, 1 } do
			box(c, -3.1, 8.8, sz * 0.3, 0.25, 0.7, 0.2, wood)
			box(c, -4.1, 8.05, sz * 0.51, 0.25, 0.25, 0.05, DARK)
			box(c, 0, 3.95, sz * 1.17, 4.6, 0.08, 0.06, dark)
		end
		box(c, 0.2, 4.3, -1.31, 1.2, 0.9, 0.05, dark)
		c.origin = CFrame.new()
	end

	-- 용궁: 모래 바닥 + 자개빛 기단 위 붉은 2층 전각(청록 기와, 빛나는 문) + 꼭대기 여의주
	--   + 전각을 휘감아 오르는 황금 용(머리·턱·뿔·물고 있는 여의주) + 산호 + 다시마 + 물방울
	function B.yonggung(c)
		local gold = rgb(240, 190, 60)
		local nacre = mix(WHITE, c.P, 0.15)
		col(c, 0, 0, 0, 0.4, 9.8, mix(SAND, c.S, 0.3), Mat.Sand)
		box(c, 0, 0.4, 0.8, 6.4, 0.7, 5.4, nacre, Mat.Marble)
		box(c, 0, 1.1, 0.9, 5, 2, 3.8, c.P)
		box(c, 0, 1.1, -1.02, 1.3, 1.5, 0.1, c.A, Mat.Neon)
		roof(c, 0, 3.1, 0.9, 7, 5.4, 1.2, c.S)
		box(c, 0, 4.1, 0.9, 3.2, 1.6, 2.6, c.P)
		roof(c, 0, 5.7, 0.9, 5, 3.8, 1.1, c.S)
		ball(c, 0, 7.3, 0.9, 0.7, c.A, Mat.Neon)
		-- 황금 용(꼬리 → 목): 굽이치며 전각 뒤를 돌아 오른쪽 앞에서 머리를 들고 정면을 봄
		local path = {
			V(-3.6, 0.9, -3.4),
			V(-4.3, 2.6, -0.8),
			V(-3.9, 5.2, 2.2),
			V(-1.2, 8.2, 3.6),
			V(1.8, 9.2, 2.4),
			V(3.6, 7, 0.4),
			V(3.2, 8.4, -2),
		}
		for k = 1, #path - 1 do
			local t = 0.4 + k * 0.08
			beam(c, path[k], path[k + 1], t, gold, Mat.Metal)
			if k > 1 then
				ball(c, path[k].X, path[k].Y, path[k].Z, t * 1.15, gold, Mat.Metal)
			end
		end
		local head = CFrame.lookAt(path[#path], V(1.4, 7.4, -4.4))
		block(c, head * CFrame.new(0, 0.1, -0.6), V(1.3, 0.9, 1.8), gold, Mat.Metal)
		block(c, head * CFrame.new(0, -0.5, -0.9) * CFrame.Angles(-0.4, 0, 0), V(1, 0.3, 1.4), gold, Mat.Metal)
		for _, sx in { -1, 1 } do
			local root = (head * CFrame.new(sx * 0.35, 0.5, 0)).Position
			beam(c, root, (head * CFrame.new(sx * 0.75, 1.5, 0.8)).Position, 0.18, CLOUD)
		end
		local pearl = (head * CFrame.new(0, -0.25, -1.85)).Position
		ball(c, pearl.X, pearl.Y, pearl.Z, 0.75, c.A, Mat.Neon)
		-- 산호, 다시마, 물고기, 물방울
		ball(c, 3.9, 0.7, -3.4, 1.2, rgb(255, 120, 150))
		ball(c, 4, 0.6, 3.5, 0.9, rgb(170, 110, 230))
		for _, k in { { -2.4, -3.9, 2.4, 0.15 }, { 4.3, 1.4, 2.8, 0.1 } } do
			local cf = CFrame.new(k[1], 0.4 + k[3] / 2, k[2]) * CFrame.Angles(k[4], 0, k[4])
			block(c, cf, V(0.25, k[3], 0.5), rgb(60, 150, 80))
		end
		ball(c, -1.6, 3.8, -3.2, 0.7, rgb(255, 150, 60))
		wedge(c, CFrame.new(-1.05, 3.8, -3.2) * CFrame.Angles(0, PI / 2, 0), V(0.1, 0.6, 0.5), rgb(255, 150, 60))
		ball(c, -1.6, 9.4, 1.6, 0.5, c.A, Mat.Glass, 0.5)
	end

	return B
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">Europe</string>
            <string name="Source"><![CDATA[-- 유럽 명소 전용 모형. Models/init.luau 가 K(파트 헬퍼·색·기존 모양)를 넘겨 호출합니다.
-- 규칙: 바닥 10x10 안, 높이 22 이하, 바닥 y = 0, 정면 -Z, 파트 45개 이하. c.P/c.S/c.A = 명소 주/보조/강조 색, c.M = 재질.
-- 풍차 마을(windmill) · 피사의 사탑(leaning) · 로도스 거상(statue) 은 원래 그 명소를 위해 만든 모양을 그대로 씀.

return function(K)
	local B = {}

	local V, rgb, Mat, PI, TAU = K.V, K.rgb, K.Mat, K.PI, K.TAU
	local ALONG_Z = K.ALONG_Z
	local GRASS, LEAF, WATER, DARK, TILE = K.GRASS, K.LEAF, K.WATER, K.DARK, K.TILE
	local ROCK, WOOD, SAND, BLACK, WHITE = K.ROCK, K.WOOD, K.SAND, K.BLACK, K.WHITE
	local mix, block, box, ball, cyl, col, wedge, beam = K.mix, K.block, K.box, K.ball, K.cyl, K.col, K.wedge, K.beam
	local gable, plant = K.gable, K.plant

	-- 정면(-Z)에서 삼각형이 보이는 박공(용마루가 Z 방향). 바닥 y, 폭 w(X), 깊이 d(Z), 높이 h
	local function frontGable(c, x, y, z, w, d, h, color, material)
		wedge(c, CFrame.new(x - w / 4, y + h / 2, z) * CFrame.Angles(0, PI / 2, 0), V(d, h, w / 2), color, material)
		wedge(c, CFrame.new(x + w / 4, y + h / 2, z) * CFrame.Angles(0, -PI / 2, 0), V(d, h, w / 2), color, material)
	end

	-- 박공(용마루가 X 방향, 삼각형이 옆에서 보임) + 재질
	local function ridge(c, x, y, z, w, d, h, color, material)
		wedge(c, CFrame.new(x, y + h / 2, z - d / 4), V(w, h, d / 2), color, material)
		wedge(c, CFrame.new(x, y + h / 2, z + d / 4) * CFrame.Angles(0, PI, 0), V(w, h, d / 2), color, material)
	end

	-- 세 점을 잇는 삼각형 판(직각 쐐기 두 개): 한 변(밑변)에 맞은편 꼭짓점에서 수선을 내려 둘로 나눔.
	--   쐐기의 경계 상자 = 밑변 x 높이 직사각형이므로, 그 상자가 설계 공간(바닥 위, 10x10 안)에 들어가는 밑변을 고름
	local function tri(c, a, b, d, color, material, thick)
		local t = thick or 0.15
		local function fits(p)
			local limit = 5 - t / 2
			return p.Y >= t / 2 and math.abs(p.X) <= limit and math.abs(p.Z) <= limit
		end
		local chosen, fallback, longest = nil, nil, -1
		for _, o in { { a, b, d }, { b, d, a }, { d, a, b } } do
			local apex, p, q = o[1], o[2], o[3]
			local edge = q - p
			local s = (apex - p):Dot(edge) / edge:Dot(edge)
			if s > 1e-3 and s < 1 - 1e-3 then
				local up = apex - (p + edge * s)
				if fits(p) and fits(q) and fits(p + up) and fits(q + up) then
					chosen = o
					break
				end
				if edge.Magnitude > longest then
					fallback, longest = o, edge.Magnitude
				end
			end
		end
		local o = chosen or fallback
		if not o then
			return
		end
		local apex, p, q = o[1], o[2], o[3]
		local edge = q - p
		local foot = p + edge * ((apex - p):Dot(edge) / edge:Dot(edge))
		local height = (apex - foot).Magnitude
		local up = (apex - foot).Unit
		for _, e in { p, q } do
			local back = (foot - e).Unit
			local center = (e + apex) / 2
			wedge(c, CFrame.lookAt(center, center - back, up), V(t, height, (foot - e).Magnitude), color, material)
		end
	end

	-- a 에서 b 까지 이어지는 판: 가로 w(진행 방향의 오른쪽), 두께 t. a → b 는 수직이 아니어야 함
	local function slab(c, a, b, w, t, color, material)
		local mid = (a + b) / 2
		return block(c, CFrame.lookAt(mid, b), V(w, t, (b - a).Magnitude), color, material)
	end

	-- a 에서 b 까지 이어지는 원기둥(지름 d)
	local function rod(c, a, b, d, color, material)
		local mid = (a + b) / 2
		return cyl(c, CFrame.lookAt(mid, b) * CFrame.Angles(0, PI / 2, 0), (b - a).Magnitude, d, color, material)
	end

	-- 쌓은 원기둥으로 만든 원뿔 지붕. 꼭대기 높이를 돌려줌
	local function cone(c, x, y, z, d, h, steps, color, material)
		local step = h / steps
		for k = 0, steps - 1 do
			col(c, x, y + k * step, z, step, d * (1 - k / steps), color, material)
		end
		return y + h
	end

	-- 쌓은 상자로 만든 사각뿔 지붕. 꼭대기 높이를 돌려줌
	local function spire(c, x, y, z, w, h, steps, color, material)
		local step = h / steps
		for k = 0, steps - 1 do
			local s = w * (1 - k / steps)
			box(c, x, y + k * step, z, s, step, s, color, material)
		end
		return y + h
	end

	-- 브란덴부르크 문: 도리스 기둥 6쌍(사이 벽 = 통로 5개) + 엔타블러처 + 계단식 아틱 + 초록 청동 4두 마차(콰드리가) + 양옆 초소
	B.brandenburg = function(c)
		local shade = mix(c.P, BLACK, 0.2)
		local bronze = c.A
		box(c, 0, 0, 0, 9.8, 0.2, 5.6, mix(c.S, WHITE, 0.5))
		box(c, 0, 0.2, 0, 8.4, 0.4, 3.6, c.S)
		for _, x in { -3.5, -2.1, -0.7, 0.7, 2.1, 3.5 } do
			box(c, x, 0.6, 0, 0.45, 4.4, 2.2, shade)
			for _, z in { -1.3, 1.3 } do
				col(c, x, 0.6, z, 4.4, 0.72, c.P)
			end
		end
		box(c, 0, 5, 0, 8.2, 0.6, 3.3, c.P)
		box(c, 0, 5.6, 0, 8.3, 0.45, 3.4, mix(c.P, c.S, 0.55))
		box(c, 0, 6.05, 0, 8.7, 0.3, 3.7, c.P)
		box(c, 0, 6.35, 0, 5.6, 1, 2.8, c.P)
		box(c, 0, 7.35, 0, 3, 0.4, 2.2, c.P)
		-- 콰드리가: 네 말(몸통 + 치켜든 목) + 전차 + 월계관 지팡이를 든 승리의 여신
		local y = 7.75
		box(c, 0, y, -0.2, 2.6, 0.6, 1, mix(bronze, BLACK, 0.25))
		for _, x in { -0.96, -0.32, 0.32, 0.96 } do
			box(c, x, y + 0.55, -0.2, 0.46, 0.6, 1.4, bronze)
			beam(c, V(x, y + 1, -0.75), V(x, y + 1.95, -1.2), 0.34, bronze)
		end
		box(c, 0, y, 0.65, 1.3, 0.95, 0.7, bronze)
		col(c, 0, y + 0.95, 0.65, 1.3, 0.42, bronze)
		ball(c, 0, y + 2.45, 0.65, 0.42, bronze)
		col(c, 0.45, y + 0.95, 0.55, 2.7, 0.12, bronze)
		cyl(c, CFrame.new(0.45, y + 3.75, 0.55) * ALONG_Z, 0.1, 0.55, bronze)
		-- 양옆 초소
		for _, s in { -1, 1 } do
			box(c, s * 4.55, 0.2, 0, 0.9, 3.2, 3, c.P)
			box(c, s * 4.55, 3.4, 0, 0.9, 0.3, 3.2, c.S)
		end
	end

	-- 트레비 분수: 궁전 정면(창문 줄 + 벽기둥) + 가운데 개선문(큰 기둥 4, 어두운 벽감 속 오케아노스) + 문장 아틱
	--   + 흰 바위 더미(스코글리에라) + 쏟아지는 물줄기 + 말 두 마리 + 넓은 반원 수반
	B.trevi = function(c)
		local stone = mix(c.P, ROCK, 0.4)
		local reef = mix(c.P, ROCK, 0.12)
		local niche = mix(c.P, BLACK, 0.5)
		box(c, 0, 0, 0, 9.8, 0.2, 9.8, mix(c.P, ROCK, 0.55))
		col(c, 0, 0.2, 0.2, 0.3, 9.4, stone)
		col(c, 0, 0.5, 0.2, 0.6, 8.6, c.P)
		col(c, 0, 0.5, 0.2, 0.62, 8, c.S, Mat.Glass, 0.1)
		-- 궁전
		box(c, 0, 0.2, 3.7, 9.8, 7.6, 2.2, c.P)
		box(c, 0, 7.8, 3.7, 9.8, 0.35, 2.3, stone)
		box(c, 0, 8.15, 3.8, 9.4, 1, 2, c.P)
		for _, s in { -1, 1 } do
			for _, wy in { 3.2, 5.6 } do
				box(c, s * 3.45, wy, 2.58, 2.5, 1, 0.06, DARK)
			end
			for _, px in { 2.85, 4.05 } do
				box(c, s * px, 0.2, 2.52, 0.3, 7.6, 0.16, c.P)
			end
		end
		-- 가운데 개선문 + 벽감 + 오케아노스
		box(c, 0, 0.2, 2.3, 4, 9.6, 1.2, c.P)
		box(c, 0, 9.8, 2.5, 3, 1.3, 0.8, c.P)
		box(c, 0, 11.1, 2.5, 1.4, 0.9, 0.4, c.A, Mat.Metal)
		for _, s in { -1, 1 } do
			col(c, s * 0.9, 11.1, 2.5, 0.8, 0.3, c.P)
		end
		box(c, 0, 2.2, 1.66, 2, 4.6, 0.1, niche)
		cyl(c, CFrame.new(0, 6.8, 1.66) * ALONG_Z, 0.1, 2, niche)
		block(c, CFrame.new(0, 4.3, 1.45), V(1, 3, 0.55), WHITE)
		ball(c, 0, 6.15, 1.45, 0.75, WHITE)
		ball(c, 0, 2.7, 1.15, 1.5, WHITE)
		for _, x in { -1.75, -1.3, 1.3, 1.75 } do
			col(c, x, 2, 1.55, 7.6, 0.42, c.P)
		end
		-- 바위 더미
		local rocks = {
			{ -3.3, 1.8, 2.6, 1.8, 1.6, 0.3 },
			{ -1.4, 1.5, 2.4, 2.6, 1.6, -0.2 },
			{ 1.4, 1.5, 2.4, 2.6, 1.6, 0.25 },
			{ 3.3, 1.8, 2.6, 1.8, 1.6, -0.3 },
			{ 0, 1.2, 3.2, 1.8, 1.4, 0.1 },
		}
		for _, r in rocks do
			block(c, CFrame.new(r[1], 0.9 + r[4] / 3, r[2]) * CFrame.Angles(0.15, r[6], 0.1), V(r[3], r[4], r[5]), reef)
		end
		for _, x in { -2.4, 0, 2.4 } do
			box(c, x, 0.9, 0.95, 1.1, 1.5, 0.15, mix(c.S, WHITE, 0.55), Mat.Glass, 0.25)
		end
		-- 트리톤이 끄는 말(날뛰는 말 / 얌전한 말)
		for _, s in { -1, 1 } do
			block(c, CFrame.new(s * 2.2, 1.7, 0.6) * CFrame.Angles(0.35, 0, 0), V(0.55, 0.7, 1.4), WHITE)
			beam(c, V(s * 2.2, 1.9, 0.05), V(s * 2.25, 2.8, -0.35), 0.38, WHITE)
		end
	end

	-- 리알토 다리: 운하 + 양쪽 둑과 집 + 돌 아치 하나(아치 고리 + 경사 상판) + 가운데 박공 문루
	--   + 양쪽 경사를 따라 아케이드 상점 줄(어두운 아치 창 + 지붕) + 난간 + 곤돌라와 뱃사공 + 계류 말뚝
	B.venice = function(c)
		local bank = mix(c.P, ROCK, 0.45)
		local lead = mix(c.P, TILE, 0.55)
		local depth = 3.2
		box(c, 0, 0, 0, 9.8, 0.3, 9.8, c.S, Mat.Glass, 0.1)
		for _, s in { -1, 1 } do
			box(c, s * 4.3, 0, 0, 1.4, 1, 9.8, bank)
		end
		box(c, -4.2, 1, 3.4, 1.6, 3.4, 2.8, rgb(214, 132, 96))
		box(c, -4.2, 3, 1.98, 1.1, 0.8, 0.06, DARK)
		box(c, 4.2, 1, 3.2, 1.6, 2.8, 3.2, rgb(228, 186, 112))
		box(c, 4.2, 2.6, 1.58, 1.1, 0.8, 0.06, DARK)
		-- 아치 고리
		local span = 3.6
		local function intrados(x: number): number
			local u = x / span
			return 1 + 2 * (1 - u * u)
		end
		local segments = 6
		for k = 0, segments - 1 do
			local x1 = span * (2 * k / segments - 1)
			local x2 = span * (2 * (k + 1) / segments - 1)
			local p1, p2 = V(x1, intrados(x1) + 0.3, 0), V(x2, intrados(x2) + 0.3, 0)
			slab(c, p1 - (p2 - p1) * 0.08, p2 + (p2 - p1) * 0.08, depth, 0.6, c.P)
		end
		-- 경사 상판(윗면: 끝 2.1 → 가운데 3.9)
		local function deck(x: number): number
			return 3.9 - 1.8 * math.abs(x) / 4.9
		end
		local drop = 0.53
		for _, s in { -1, 1 } do
			local a, b = V(s * 4.7, deck(4.7) - drop, 0), V(s * -0.05, deck(0) - drop, 0)
			if s > 0 then
				a, b = b, a
			end
			slab(c, a, b, depth, 1, c.P)
			box(c, s * 4.3, 1, 0, 1.3, 1.1, depth, c.P)
		end
		-- 난간(앞뒤) + 상점 줄 + 지붕 + 아치 창
		for _, s in { -1, 1 } do
			local x1, x2 = if s < 0 then -4.6 else 0.9, if s < 0 then -0.9 else 4.6
			for _, z in { -depth / 2 + 0.1, depth / 2 - 0.1 } do
				slab(c, V(x1, deck(x1) + 0.25, z), V(x2, deck(x2) + 0.25, z), 0.18, 0.5, c.P)
			end
			local s1, s2 = if s < 0 then -4.1 else 0.95, if s < 0 then -0.95 else 4.1
			slab(c, V(s1, deck(s1) + 0.6, 0), V(s2, deck(s2) + 0.6, 0), 1.7, 1.2, c.P)
			slab(c, V(s1 - 0.1, deck(s1) + 1.3, 0), V(s2 + 0.1, deck(s2) + 1.3, 0), 2, 0.25, lead)
			for _, ax in { 1.7, 2.6, 3.5 } do
				local x = s * ax
				box(c, x, deck(x) + 0.2, -0.86, 0.42, 0.62, 0.06, c.A)
			end
		end
		-- 가운데 문루
		box(c, 0, 3.7, 0, 1.6, 1.7, 2.3, c.P)
		frontGable(c, 0, 5.4, 0, 1.9, 2.5, 0.7, c.P)
		box(c, 0, 3.9, 0, 0.7, 1.05, 2.36, c.A)
		-- 곤돌라 + 뱃사공
		local gx = 1.5
		box(c, gx, 0.3, -3.4, 0.5, 0.28, 2.6, c.A)
		beam(c, V(gx, 0.45, -4.6), V(gx, 1, -4.85), 0.2, c.A)
		beam(c, V(gx, 0.45, -2.2), V(gx, 0.85, -1.95), 0.2, c.A)
		col(c, gx, 0.58, -2.5, 0.9, 0.34, WHITE)
		ball(c, gx, 1.65, -2.5, 0.34, rgb(236, 200, 160))
		-- 계류 말뚝
		col(c, -3.2, 0.3, -1.6, 1.7, 0.2, rgb(40, 90, 200))
		col(c, -3.2, 0.3, -2.3, 1.4, 0.2, WHITE)
	end

	-- 페나 궁전: 숲이 덮인 언덕 + 붉은 수도원 동과 붉은 시계탑(노란 전망대 + 작은 돔)
	--   + 노란 궁전 동과 노란 원형 탑(푸른 돔) + 가운데 푸른 타일 아치문 + 톱니 모양 성가퀴 + 망루
	B.pena = function(c)
		local forest = mix(LEAF, BLACK, 0.1)
		col(c, 0, 0, 0, 1.4, 9.8, forest, Mat.Grass)
		col(c, 0.2, 1.4, 0.3, 1.4, 7.8, GRASS, Mat.Grass)
		block(c, CFrame.new(-2.6, 1.8, -2.4) * CFrame.Angles(0.2, 0.5, 0.1), V(2, 1.6, 1.8), ROCK)
		block(c, CFrame.new(3.2, 1.7, -2) * CFrame.Angles(-0.1, -0.4, 0.15), V(1.8, 1.5, 1.6), ROCK)
		for _, t in { { -3.8, -1.2, 1.8 }, { 3.9, 1.4, 1.7 }, { -3.2, 3, 1.9 }, { 0.8, -4, 1.6 }, { 2.4, 3.8, 1.8 } } do
			ball(c, t[1], 1.7, t[2], t[3], LEAF, Mat.Grass)
		end
		local top = 2.8
		-- 붉은 수도원 동 + 시계탑
		box(c, -1.9, top, 1, 3.6, 3, 3.2, c.S)
		for _, x in { -3.3, -2.1, -0.9 } do
			box(c, x, top + 3, -0.4, 0.5, 0.45, 0.4, c.S)
		end
		box(c, -2.8, top, -1.1, 1.5, 7.4, 1.5, c.S)
		box(c, -2.8, top + 7.4, -1.1, 1.9, 0.9, 1.9, c.P)
		ball(c, -2.8, top + 8.5, -1.1, 1.3, c.P)
		col(c, -2.8, top + 9.1, -1.1, 0.8, 0.15, c.A, Mat.Metal)
		cyl(c, CFrame.new(-2.8, top + 6.2, -1.87) * ALONG_Z, 0.1, 0.9, WHITE)
		-- 노란 궁전 동 + 원형 탑
		box(c, 1.9, top, 0.8, 3.4, 2.6, 3.4, c.P)
		for _, z in { -0.5, 0.8, 2.1 } do
			box(c, 3.4, top + 2.6, z, 0.4, 0.45, 0.5, c.P)
		end
		col(c, 2.6, top, -1.1, 5.2, 2.3, c.P)
		col(c, 2.6, top + 5.2, -1.1, 0.45, 2.6, mix(c.P, c.S, 0.3))
		ball(c, 2.6, top + 6.1, -1.1, 2.3, c.A)
		col(c, 2.6, top + 7.2, -1.1, 0.7, 0.2, c.A, Mat.Metal)
		ball(c, 2.6, top + 8, -1.1, 0.35, rgb(250, 215, 90), Mat.Metal)
		for _, wy in { top + 1.4, top + 3.4 } do
			box(c, 2.2, wy, -2.26, 0.4, 0.8, 0.06, DARK)
		end
		-- 가운데 푸른 타일 아치문
		box(c, 0, top, -1, 2.2, 2.2, 1.4, c.A)
		box(c, 0, top, -1.72, 0.8, 1.3, 0.06, DARK)
		box(c, 0, top + 2.2, -1, 2.4, 0.3, 1.6, WHITE)
		-- 망루(모서리의 작은 원기둥 + 돔)
		for _, t in { { 3.5, 2.4 }, { -3.6, 2.5 } } do
			col(c, t[1], top + 1.6, t[2], 2, 0.7, c.P)
			ball(c, t[1], top + 3.7, t[2], 0.8, c.A)
		end
		wedge(c, CFrame.new(0.4, 2.1, -3.7), V(1, 1.4, 1.6), mix(c.P, WHITE, 0.4))
	end

	-- 브란 성(드라큘라 성): 숲 + 바위 벼랑 위 흰 벽 성채(가파른 붉은 지붕) + 높은 사각 탑(뾰족 지붕)
	--   + 원형 탑(원뿔 지붕) + 보랏빛으로 빛나는 창 + 보라 달과 박쥐
	B.bran = function(c)
		local cliff = mix(ROCK, rgb(125, 105, 85), 0.35)
		local pine = mix(LEAF, BLACK, 0.3)
		col(c, 0, 0, 0, 0.3, 9.8, GRASS, Mat.Grass)
		block(c, CFrame.new(0.2, 1.8, 0.5) * CFrame.Angles(0, 0.3, 0), V(6.2, 3, 5.4), cliff, Mat.Slate)
		block(c, CFrame.new(-1.6, 1.25, -1.4) * CFrame.Angles(0, -0.4, 0.12), V(3.8, 1.8, 3), ROCK, Mat.Slate)
		block(c, CFrame.new(1.8, 2.6, 1.4) * CFrame.Angles(0.1, 0.2, -0.08), V(3.4, 2.6, 3.2), cliff, Mat.Slate)
		for _, t in { { -3.6, -2.6, 2 }, { 3.6, -2.4, 2.2 }, { -3.8, 2.4, 2.2 }, { 3.4, 3.4, 2 }, { 0.2, -3.9, 1.8 } } do
			ball(c, t[1], 0.3 + t[3] / 2, t[2], t[3], pine, Mat.Grass)
		end
		local y = 3.2
		box(c, 0.2, y, 0.8, 4.4, 3.2, 3.2, c.P)
		gable(c, 0.2, y + 3.2, 0.8, 4.6, 3.4, 1.9, c.S)
		box(c, 1.9, y, 1.9, 2.2, 4.6, 2.4, c.P)
		frontGable(c, 1.9, y + 4.6, 1.9, 2.4, 2.6, 1.6, c.S)
		-- 앞 성벽(문) + 높은 사각 탑
		box(c, 0.15, 3.2, -1.55, 1.9, 1.5, 0.35, c.P)
		box(c, 0.15, 3.2, -1.74, 0.6, 0.9, 0.06, DARK)
		box(c, -1.6, 2.2, -1.2, 1.8, 7.4, 1.8, c.P)
		spire(c, -1.6, 9.6, -1.2, 2.2, 3.6, 4, c.S)
		-- 원형 탑
		col(c, 1.9, 2.6, -1, 6, 1.9, c.P)
		cone(c, 1.9, 8.6, -1, 2.4, 2.6, 4, c.S)
		-- 빛나는 창
		for _, w in
			{
				{ -1.6, 7.6, -2.12 },
				{ -1.6, 5.6, -2.12 },
				{ 1.9, 6.6, -1.97 },
				{ -0.1, 4.4, -0.82 },
				{ 1.3, 4.4, -0.82 },
			}
		do
			box(c, w[1], w[2], w[3], 0.4, 0.6, 0.06, c.A, Mat.Neon)
		end
		-- 보라 달 + 박쥐
		ball(c, -3.3, 13.6, 3.3, 2.4, c.A, Mat.Neon, 0.25)
		local bat = V(2.9, 12.6, -1.6)
		ball(c, bat.X, bat.Y, bat.Z, 0.35, BLACK)
		for _, s in { -1, 1 } do
			block(
				c,
				CFrame.new(bat.X + s * 0.45, bat.Y + 0.1, bat.Z) * CFrame.Angles(0, 0, s * 0.35),
				V(0.7, 0.08, 0.35),
				BLACK
			)
		end
	end

	-- 피렌체 두오모: 흰 대리석 + 초록 띠의 신랑(붉은 지붕) + 정면(박공, 둥근 창, 초록 줄) + 팔각 기단과 반원 제단부
	--   + 팔각 드럼 + 붉은 벽돌 큰 돔과 흰 갈비 8줄 + 흰 등탑 + 앞 오른쪽의 조토 종탑
	B.duomo = function(c)
		local gold = rgb(240, 200, 90)
		box(c, 0, 0, 0, 9.8, 0.2, 9.8, mix(c.P, ROCK, 0.45))
		-- 신랑
		box(c, 0, 0.2, -2.1, 3, 3.6, 4.6, c.P)
		frontGable(c, 0, 3.8, -2.1, 3.2, 4.6, 1, c.S)
		-- 정면
		box(c, 0, 0.2, -4.4, 3.8, 5.2, 0.3, c.P)
		frontGable(c, 0, 5.4, -4.4, 1.8, 0.3, 0.7, c.P)
		cyl(c, CFrame.new(0, 4.1, -4.58) * ALONG_Z, 0.1, 1, c.A)
		box(c, 0, 0.2, -4.58, 0.9, 1.6, 0.08, DARK)
		for _, s in { -1, 1 } do
			box(c, s * 1.25, 0.2, -4.58, 0.16, 5, 0.06, c.A)
		end
		-- 네모 기단 + 제단부 반구 3
		local cz = 2
		box(c, 0, 0.2, cz, 5.6, 3.2, 5.6, c.P)
		for _, p in { { -3, cz, 2.2 }, { 3, cz, 2.2 }, { 0, 3.9, 2 } } do
			ball(c, p[1], 3.4, p[2], p[3], c.S)
		end
		-- 팔각 드럼(띠 4개) + 돔 + 모서리의 흰 갈비 8줄
		local flat = 2.3
		for k = 0, 3 do
			block(
				c,
				CFrame.new(0, 4.6, cz) * CFrame.Angles(0, k * PI / 4, 0),
				V(flat * 2, 2.4, flat * 2 * math.tan(PI / 8)),
				c.P
			)
		end
		local domeY = 5.8
		ball(c, 0, domeY, cz, 4.8, c.S)
		local corner = flat / math.cos(PI / 8)
		local profile = { { corner, domeY }, { 1.9, domeY + 1.6 }, { 0.4, domeY + 2.85 } }
		for i = 0, 7 do
			local angle = (i + 0.5) * TAU / 8
			local dx, dz = math.cos(angle), math.sin(angle)
			for k = 1, 2 do
				local p, q = profile[k], profile[k + 1]
				beam(c, V(dx * p[1], p[2], cz + dz * p[1]), V(dx * q[1], q[2], cz + dz * q[1]), 0.3, c.P)
			end
		end
		col(c, 0, domeY + 2.6, cz, 1, 0.8, c.P)
		col(c, 0, domeY + 3.6, cz, 0.5, 0.45, c.P)
		ball(c, 0, domeY + 4.3, cz, 0.35, gold, Mat.Metal)
		-- 조토의 종탑(정면에서 볼 때 오른쪽)
		local bx, bz = -3.6, -3.2
		box(c, bx, 0.2, bz, 1.5, 9.8, 1.5, c.P)
		for _, by in { 3.4, 6.6 } do
			box(c, bx, by, bz, 1.56, 0.25, 1.56, c.A)
		end
		box(c, bx, 7.6, bz - 0.77, 0.5, 1.6, 0.06, DARK)
		box(c, bx, 10, bz, 1.8, 0.3, 1.8, c.P)
	end

	-- 성 바실리 대성당: 붉은 벽돌 기단 + 가운데 높은 천막 첨탑(금빛 양파) + 둘레의 큰 탑 4개와 작은 탑 4개,
	--   탑마다 색이 다른 양파 돔(초록·파랑·금·빨강흰 줄무늬)과 금 꼭지
	B.stbasil = function(c)
		local cream = rgb(240, 226, 200)
		local blue = rgb(60, 110, 205)
		local orange = rgb(235, 130, 50)
		box(c, 0, 0, 0, 9.8, 0.2, 9.8, rgb(150, 150, 155))
		box(c, 0, 0.2, 0, 7.8, 1.4, 7.8, c.P)
		box(c, 0, 1.6, 0, 8, 0.2, 8, cream)
		-- 가운데 천막 첨탑: 드럼 + 코코시닉 띠 + 초록·크림 번갈아 칠한 사각뿔 천막 + 금빛 양파
		col(c, 0, 1.8, 0, 5.2, 2.4, c.P)
		col(c, 0, 6.4, 0, 0.6, 2.7, cream)
		local apex = V(0, 12.9, 0)
		local base = { V(0, 7, -1.5), V(1.5, 7, 0), V(0, 7, 1.5), V(-1.5, 7, 0) }
		for k = 1, 4 do
			tri(c, apex, base[k], base[k % 4 + 1], if k % 2 == 0 then cream else c.S, c.M, 0.15)
		end
		ball(c, 0, 13.2, 0, 0.8, c.A, Mat.Metal)
		col(c, 0, 13.5, 0, 0.9, 0.14, c.A, Mat.Metal)
		-- 큰 탑 4: { x, z, 돔 색, 줄무늬 색(없으면 민무늬) }
		local big = {
			{ 0, -2.7, c.S, c.A },
			{ 2.7, 0, blue, nil },
			{ 0, 2.7, c.A, nil },
			{ -2.7, 0, c.P, nil },
		}
		for _, t in big do
			col(c, t[1], 1.8, t[2], 3.6, 1.4, c.P)
			ball(c, t[1], 6.2, t[2], 2, t[3])
			if t[4] then
				col(c, t[1], 6.05, t[2], 0.3, 2.04, t[4])
			end
			col(c, t[1], 7.1, t[2], 0.7, 0.45, t[3])
			ball(c, t[1], 8, t[2], 0.3, c.A, Mat.Metal)
		end
		-- 작은 탑 4
		local small = { { 2.3, -2.3, orange }, { 2.3, 2.3, c.S }, { -2.3, 2.3, blue }, { -2.3, -2.3, c.A } }
		for _, t in small do
			col(c, t[1], 1.8, t[2], 2.4, 1, c.P)
			ball(c, t[1], 4.8, t[2], 1.4, t[3])
			col(c, t[1], 5.4, t[2], 0.6, 0.3, t[3])
		end
	end

	-- 노트르담 대성당: 평평한 두 탑(긴 첨두 창 2개씩) + 세 개의 뾰족 아치 문 + 왕들의 회랑 + 푸른 장미창
	--   + 신랑과 가파른 슬레이트 지붕 + 익랑 + 제단부 + 교차부의 가느다란 첨탑 + 플라잉 버트레스
	B.notredame = function(c)
		local shade = mix(c.P, BLACK, 0.12)
		local fz = -3.8
		local face = fz - 0.84
		box(c, 0, 0, 0, 9.8, 0.2, 9.8, mix(c.P, ROCK, 0.4))
		box(c, 0, 0.2, fz, 7.2, 6.8, 1.6, c.P)
		for _, s in { -1, 1 } do
			local x = s * 2.35
			box(c, x, 7, fz, 2.5, 3.8, 1.6, c.P)
			box(c, x, 10.8, fz, 2.7, 0.25, 1.8, shade)
			for _, dx in { -0.55, 0.55 } do
				box(c, x + dx, 7.5, face, 0.5, 2.7, 0.08, DARK)
			end
			box(c, s * 1.1, 0.2, face, 0.26, 10.6, 0.12, shade)
		end
		-- 장미창
		cyl(c, CFrame.new(0, 4.8, face + 0.02) * ALONG_Z, 0.08, 2.4, DARK)
		cyl(c, CFrame.new(0, 4.8, face - 0.02) * ALONG_Z, 0.08, 2, c.A, Mat.Glass)
		-- 왕들의 회랑 + 윗 회랑
		box(c, 0, 2.9, face, 7.2, 0.45, 0.1, shade)
		box(c, 0, 6.3, face, 7.2, 0.35, 0.1, shade)
		-- 뾰족 아치 문 3
		for _, p in { { 0, 1.2, 1.7 }, { -2.35, 0.9, 1.4 }, { 2.35, 0.9, 1.4 } } do
			local x, w, h = p[1], p[2], p[3]
			box(c, x, 0.2, face, w, h, 0.08, DARK)
			block(
				c,
				CFrame.new(x, 0.2 + h, face) * CFrame.Angles(0, 0, PI / 4),
				V(w / math.sqrt(2), w / math.sqrt(2), 0.08),
				DARK
			)
		end
		-- 신랑 + 익랑 + 제단부
		box(c, 0, 0.2, 0.2, 3.2, 5.4, 6.4, c.P)
		frontGable(c, 0, 5.6, 0.2, 3.4, 6.4, 2.2, c.S)
		box(c, 0, 0.2, 1.2, 7, 5, 1.8, c.P)
		gable(c, 0, 5.2, 1.2, 7, 2, 1.6, c.S)
		col(c, 0, 0.2, 3.4, 5, 3, c.P)
		cone(c, 0, 5.2, 3.4, 3.2, 1.6, 2, c.S)
		-- 첨탑
		box(c, 0, 7.2, 1.2, 0.9, 1.4, 0.9, c.S)
		col(c, 0, 8.6, 1.2, 1.5, 0.6, c.S)
		col(c, 0, 10.1, 1.2, 1.8, 0.36, c.S)
		col(c, 0, 11.9, 1.2, 2, 0.16, c.S)
		-- 플라잉 버트레스
		for _, s in { -1, 1 } do
			for _, z in { -1.6, -0.2 } do
				box(c, s * 3.3, 0.2, z, 0.5, 3.6, 0.5, c.P)
				beam(c, V(s * 3.3, 3.6, z), V(s * 1.6, 5, z), 0.3, c.P)
			end
		end
	end

	-- 성 베드로 대성당: 타원 광장을 감싸는 베르니니 주랑(두 팔) + 가운데 오벨리스크
	--   + 큰 기둥이 늘어선 넓은 정면(아틱 + 성인상) + 높은 드럼 위 청회색 큰 돔(갈비) + 등탑 + 양옆 작은 돔
	B.stpeters = function(c)
		local paving = mix(c.P, WHITE, 0.3)
		box(c, 0, 0, 0, 9.8, 0.2, 9.8, mix(c.P, ROCK, 0.35))
		col(c, 0, 0.2, -2.3, 0.04, 5.4, paving)
		-- 주랑(타원의 양쪽 호)
		local a, b, cz0 = 4.3, 2.5, -2.3
		local pieces = 4
		for _, s in { -1, 1 } do
			for k = 0, pieces - 1 do
				local t1 = math.rad(-60 + 120 * k / pieces)
				local t2 = math.rad(-60 + 120 * (k + 1) / pieces)
				local p1 = V(s * a * math.cos(t1), 0.9, cz0 + b * math.sin(t1))
				local p2 = V(s * a * math.cos(t2), 0.9, cz0 + b * math.sin(t2))
				block(c, CFrame.lookAt((p1 + p2) / 2, p2), V(0.7, 1.4, (p2 - p1).Magnitude + 0.15), c.P)
			end
		end
		box(c, 0, 0.2, cz0, 0.32, 2.9, 0.32, c.P)
		-- 정면
		box(c, 0, 0.2, 1, 7.2, 4.6, 1, c.P)
		box(c, 0, 3.7, 0.45, 7.4, 0.3, 0.2, mix(c.P, BLACK, 0.1))
		box(c, 0, 0.2, 0.47, 5.8, 1.5, 0.06, DARK)
		for _, x in { -3.1, -1.9, -0.65, 0.65, 1.9, 3.1 } do
			col(c, x, 0.2, 0.42, 3.5, 0.42, c.P)
		end
		frontGable(c, 0, 3.7, 0.4, 2.4, 0.3, 0.6, c.P)
		-- 본당 + 드럼 + 돔
		local dz = 2.7
		box(c, 0, 0.2, dz, 6.2, 5.4, 3.2, c.P)
		col(c, 0, 5.6, dz, 2.2, 4, c.P)
		col(c, 0, 6.1, dz, 1, 4.06, mix(c.P, BLACK, 0.3))
		col(c, 0, 7.8, dz, 0.25, 4.3, c.P)
		local domeY, r = 8.05, 2.1
		ball(c, 0, domeY, dz, r * 2, c.S)
		for i = 0, 7 do
			local angle = i * TAU / 8
			local dx, dzz = math.cos(angle), math.sin(angle)
			local function at(phi: number, rr: number): Vector3
				return V(dx * rr * math.cos(phi), domeY + rr * math.sin(phi), dz + dzz * rr * math.cos(phi))
			end
			beam(c, at(math.rad(15), r + 0.12), at(math.rad(50), r + 0.12), 0.22, c.P)
			beam(c, at(math.rad(50), r + 0.12), at(math.rad(84), r + 0.12), 0.22, c.P)
		end
		col(c, 0, domeY + 1.9, dz, 1.3, 0.8, c.P)
		ball(c, 0, domeY + 3.4, dz, 0.4, c.A, Mat.Metal)
	end

	-- 몽생미셸: 갯벌과 물길 + 둑길 + 섬을 두른 성벽과 둥근 망루 + 가파른 육각뿔 바위산(비탈의 마을 집들, 숲)
	--   + 꼭대기 수도원(북쪽의 높은 라 메르베유 벽, 성당, 종탑) + 가느다란 첨탑 끝의 금빛 미카엘 상
	B.montsaintmichel = function(c)
		local rock = mix(c.P, ROCK, 0.45)
		local wall = mix(c.P, WHITE, 0.1)
		local house = mix(c.P, WHITE, 0.35)
		local roofColor = c.S
		box(c, 0, 0, 0, 9.8, 0.2, 9.8, mix(SAND, c.S, 0.35), Mat.Sand)
		box(c, -2.6, 0.2, -3.6, 4.4, 0.04, 2.4, mix(WATER, c.S, 0.3), Mat.Glass, 0.2)
		box(c, 0.9, 0.2, -4.2, 0.9, 0.3, 1.6, wall)
		-- 성벽 + 망루 + 성문
		local ox, oz = 0.3, 0.5
		col(c, ox, 0.2, oz, 1.4, 8.4, wall)
		for _, deg in { 205, 245, 325 } do
			local t = math.rad(deg)
			col(c, ox + 4.1 * math.cos(t), 0.2, oz + 4.1 * math.sin(t), 2, 1.1, wall)
		end
		box(c, 0.9, 0.2, oz - 4.17, 0.6, 0.9, 0.1, DARK)
		-- 바위산: 성벽 위에서 수도원 아래까지 오르는 육각뿔(정면이 평평한 면)
		local apex = V(0.4, 8.2, 1)
		local ry = 1.6
		for k = 0, 5 do
			local a1, a2 = math.rad(60 * k), math.rad(60 * (k + 1))
			local p1 = V(ox + 3.7 * math.cos(a1), ry, oz + 3.7 * math.sin(a1))
			local p2 = V(ox + 3.7 * math.cos(a2), ry, oz + 3.7 * math.sin(a2))
			tri(c, apex, p1, p2, rock, Mat.Slate, 0.2)
		end
		-- 마을 집: { x, y, z, 가로, 높이, 세로 }
		local houses = {
			{ -1.5, 1.6, -2.3, 1.3, 1.2, 1.1 },
			{ 0.7, 1.6, -2.45, 1.2, 1, 1 },
			{ -0.5, 3, -1.7, 1.2, 1.1, 1 },
			{ 1.5, 3, -1.45, 1, 0.9, 1 },
			{ -2.4, 2.4, -0.4, 1, 1, 1.2 },
		}
		for _, h in houses do
			box(c, h[1], h[2], h[3], h[4], h[5], h[6], house)
			box(c, h[1], h[2] + h[5], h[3], h[4] + 0.12, 0.35, h[6] + 0.12, roofColor)
		end
		ball(c, 2.7, 2.5, 2.2, 1.5, LEAF, Mat.Grass)
		ball(c, -2, 3.2, 2.3, 1.3, LEAF, Mat.Grass)
		-- 수도원
		box(c, 0.6, 2.8, 2.8, 3.4, 4.4, 1.4, c.P)
		box(c, 0.4, 5.6, 1, 3.8, 1.8, 1.5, c.P)
		gable(c, 0.4, 7.4, 1, 3.8, 1.5, 0.9, roofColor)
		box(c, 0.9, 7.4, 1, 1, 1.6, 1, c.P)
		box(c, 0.9, 9, 1, 0.7, 0.9, 0.7, roofColor)
		col(c, 0.9, 9.9, 1, 1.7, 0.45, roofColor)
		col(c, 0.9, 11.6, 1, 2.2, 0.22, roofColor)
		col(c, 0.9, 13.8, 1, 1.2, 0.1, roofColor)
		ball(c, 0.9, 15.2, 1, 0.35, c.A, Mat.Neon)
	end

	-- 파르테논: 아크로폴리스 바위 언덕 + 3단 기단 + 정면 8기둥·옆면 기둥 줄 + 어두운 안쪽 벽
	--   + 아키트레이브와 트리글리프 띠 + 삼각 박공 지붕 + 올리브 나무
	B.parthenon = function(c)
		local rock = mix(c.S, ROCK, 0.5)
		box(c, 0, 0, 0, 9.8, 0.2, 9.8, mix(GRASS, SAND, 0.55), Mat.Grass)
		box(c, 0, 0.2, 0, 9.4, 1.2, 9.6, rock, Mat.Rock)
		block(
			c,
			CFrame.new(-3.2, 1.05, -2.4) * CFrame.Angles(0.1, 0.35, -0.12),
			V(2.2, 1.3, 3.4),
			mix(rock, BLACK, 0.12),
			Mat.Rock
		)
		block(
			c,
			CFrame.new(3.15, 1, 2.2) * CFrame.Angles(-0.08, -0.4, 0.1),
			V(2.2, 1.2, 3.6),
			mix(rock, BLACK, 0.12),
			Mat.Rock
		)
		box(c, 0, 1.4, 0, 8.6, 0.4, 9.2, mix(c.S, WHITE, 0.2))
		box(c, 0, 1.8, 0, 5.6, 0.3, 8.8, c.S)
		box(c, 0, 2.1, 0, 5.2, 0.3, 8.4, c.P)
		local floor = 2.4
		local h = 3.2
		local hx, hz = 2.17, 3.95
		for k = 0, 7 do
			local x = -hx + k * (2 * hx / 7)
			col(c, x, floor, -hz, h, 0.46, c.P)
			col(c, x, floor, hz, h, 0.46, c.P)
		end
		for j = 1, 7 do
			local z = -hz + j * (2 * hz / 8)
			col(c, -hx, floor, z, h, 0.46, c.P)
			col(c, hx, floor, z, h, 0.46, c.P)
		end
		box(c, 0, floor, 0, 3.4, h, 6.4, mix(c.P, BLACK, 0.25))
		box(c, 0, floor + h, 0, 4.9, 0.45, 8.4, c.P)
		box(c, 0, floor + h + 0.45, 0, 4.9, 0.4, 8.4, mix(c.P, c.S, 0.6))
		frontGable(c, 0, floor + h + 0.85, 0, 5.1, 8.6, 1.1, c.P)
		plant(c, -4, 1.8, -4.2, 1, 1.3, mix(LEAF, ROCK, 0.3))
	end

	-- 마터호른: 초원 + 호수 + 샬레 + 전나무 + 삼각 면을 이어 만든 뾰족한 뿔 봉우리(어깨 능선, 살짝 굽은 정상)
	--   + 아래 비탈과 정상의 눈
	B.matterhorn = function(c)
		local rockLight = mix(c.P, rgb(170, 150, 125), 0.4)
		local rockDark = mix(c.P, BLACK, 0.3)
		local snow = c.S
		local fir = mix(LEAF, BLACK, 0.35)
		box(c, 0, 0, 0, 9.8, 0.3, 9.8, GRASS, Mat.Grass)
		-- 봉우리 밑의 빙하 받침(삼각 면의 경계 상자가 바닥 아래로 내려가지 않도록 뿔을 조금 띄움)
		local base = 0.95
		col(c, 0, 0.3, 0, base - 0.3, 9.3, mix(snow, ROCK, 0.15), Mat.Snow)
		local T1 = V(-0.9, 13.4, 0.4)
		local T2 = V(0.4, 12.7, 0.9)
		local Sh = V(-0.3, 7.4, -2.3)
		local S = V(0.2, base, -4.5)
		local W = V(-4.5, base, 0.5)
		local E = V(4.5, base, -0.3)
		local N = V(0.3, base, 4.5)
		local center = V(0, 5, 0.3)
		local function face(a, b, d, color)
			tri(c, a, b, d, color, c.M, 0.2)
		end
		face(T1, W, Sh, rockLight)
		face(Sh, W, S, rockLight)
		face(T1, Sh, T2, c.P)
		face(T2, Sh, E, rockDark)
		face(Sh, S, E, rockDark)
		face(T2, E, N, rockDark)
		face(T1, T2, N, c.P)
		face(T1, N, W, c.P)
		-- 눈: 면 위(바깥쪽으로 조금 띄움)의 작은 삼각형
		local function lerp(p, q, t)
			return p + (q - p) * t
		end
		local function snowPatch(a, b, d)
			local n = (b - a):Cross(d - a).Unit
			local mid = (a + b + d) / 3
			if n:Dot(mid - center) < 0 then
				n = -n
			end
			tri(c, a + n * 0.14, b + n * 0.14, d + n * 0.14, snow, Mat.Snow, 0.12)
		end
		snowPatch(W, S, lerp(Sh, (W + S) / 2, 0.55))
		snowPatch(S, E, lerp(Sh, (S + E) / 2, 0.5))
		snowPatch(T1, lerp(T1, W, 0.18), lerp(T1, Sh, 0.22))
		snowPatch(lerp(Sh, W, 0.15), lerp(Sh, T1, 0.25), lerp(W, T1, 0.45))
		snowPatch(lerp(T2, Sh, 0.3), lerp(T2, E, 0.35), lerp(Sh, E, 0.3))
		-- 호수 + 샬레 + 전나무
		col(c, -3.9, 0.3, -3.9, 0.05, 1.7, c.A, Mat.Glass, 0.1)
		box(c, 3.9, 0.3, -4, 1.1, 0.8, 0.9, WOOD, Mat.WoodPlanks)
		gable(c, 3.9, 1.1, -4, 1.3, 1.1, 0.6, rgb(150, 60, 50))
		for _, t in { { -4.4, -2.6 }, { -2.6, -4.4 }, { 4.4, -2.7 }, { 4.2, 4.2 }, { -4.2, 4.2 } } do
			col(c, t[1], 0.3, t[2], 0.9, 1, fir)
			col(c, t[1], 1.2, t[2], 0.9, 0.55, fir)
		end
	end

	-- 자이언츠 코즈웨이: 바다 + 뒤쪽 풀 덮인 절벽(오르간 기둥) + 절벽에서 바다로 계단처럼 내려가는
	--   벌집처럼 맞물린 육각 현무암 기둥들(직육면체 3개를 60도씩 돌려 겹친 육각기둥) + 끝의 물거품
	B.giantscauseway = function(c)
		local earth = mix(c.P, rgb(110, 88, 64), 0.5)
		box(c, 0, 0, 0, 9.8, 0.3, 9.8, c.S, Mat.Glass, 0.1)
		box(c, 0, 0.3, 4.2, 9.8, 4, 1.4, earth)
		box(c, 0, 4.3, 4.2, 9.8, 0.3, 1.4, GRASS, Mat.Grass)
		wedge(c, CFrame.new(0, 1.6, 2.9), V(9.8, 2.6, 1.2), mix(earth, GRASS, 0.35), Mat.Grass)
		for k, x in { 2.9, 3.6, 4.3 } do
			col(c, x, 0.3, 3.2, 3.3 + (k % 2) * 0.5, 0.66, c.P)
		end
		-- 육각기둥: 꼭짓점이 ±X, 이웃 기둥은 Z 로 R√3, 옆 줄은 X 로 1.5R(반 칸 엇갈림)
		local R = 0.85
		local shades = { mix(c.P, WHITE, 0.1), mix(c.P, WHITE, 0.24), mix(c.P, rgb(120, 104, 88), 0.4) }
		local function hex(x: number, z: number, h: number, shade: number)
			for k = 0, 2 do
				local cf = CFrame.new(x, 0.3 + h / 2, z) * CFrame.Angles(0, k * PI / 3, 0)
				block(c, cf, V(R, h, R * math.sqrt(3)), shades[shade])
			end
		end
		local dz = R * math.sqrt(3)
		local dx = 1.5 * R
		local columns = {
			{ 0, 2.2, 2.9, 1 },
			{ 0, 2.2 - dz, 2.3, 2 },
			{ 0, 2.2 - 2 * dz, 1.7, 3 },
			{ 0, 2.2 - 3 * dz, 1.1, 1 },
			{ 0, 2.2 - 4 * dz, 0.55, 2 },
			{ -dx, 2.2 - dz / 2, 2.6, 3 },
			{ -dx, 2.2 - 1.5 * dz, 1.95, 1 },
			{ -dx, 2.2 - 2.5 * dz, 1.25, 2 },
			{ dx, 2.2 - dz / 2, 2.2, 2 },
			{ dx, 2.2 - 1.5 * dz, 1.55, 3 },
			{ dx, 2.2 - 2.5 * dz, 0.9, 1 },
			{ -2 * dx, 2.2, 2.3, 2 },
		}
		for _, p in columns do
			hex(p[1], p[2], p[3], p[4])
		end
		col(c, 0, 0.3, -3.6, 0.05, 2.8, c.A, Mat.SmoothPlastic, 0.3)
	end

	-- 네스호의 네시: 짙은 호수 + 건너편 둥근 언덕(풀·헤더) + 곶 위의 어쿼트 성 폐허(무너진 탑, 성벽)
	--   + S자로 목을 높이 든 네시(머리, 빛나는 눈) + 물 위로 솟은 등 혹 3개 + 꼬리 + 물결
	B.lochness = function(c)
		local stone = rgb(150, 140, 124)
		local heather = mix(GRASS, rgb(130, 90, 150), 0.4)
		local waterTop = 0.9
		box(c, 0, 0, 0, 9.8, waterTop, 9.8, c.S, Mat.Glass, 0.1)
		box(c, 0, waterTop, 4.3, 9.8, 0.3, 1.4, GRASS, Mat.Grass)
		-- 뒤쪽 산: 앞을 보는 삼각 면 두 개씩(꼭대기, 왼쪽 뒤, 앞, 오른쪽 뒤)
		for _, hill in { { -1.4, 2.7, 3.5, heather }, { 2.6, 2, 2.3, mix(GRASS, LEAF, 0.4) } } do
			local x, top, w, color = hill[1], hill[2], hill[3], hill[4]
			local apex = V(x, waterTop + top, 3.6)
			local left, right = V(x - w, waterTop + 0.3, 4.3), V(x + w, waterTop + 0.3, 4.3)
			local front = V(x + 0.2, waterTop + 0.3, 3)
			tri(c, apex, left, front, color, Mat.Grass, 0.2)
			tri(c, apex, front, right, color, Mat.Grass, 0.2)
		end
		ball(c, 1.4, waterTop + 0.5, 3, 1.1, LEAF, Mat.Grass)
		-- 어쿼트 성
		col(c, -3.2, waterTop, 1.2, 0.4, 3.2, GRASS, Mat.Grass)
		local g = waterTop + 0.4
		box(c, -3.6, g, 1.6, 1.4, 3.6, 1.4, stone)
		box(c, -4.1, g + 3.6, 1.1, 0.4, 0.5, 0.4, stone)
		box(c, -3.1, g + 3.6, 1.1, 0.4, 0.3, 0.4, stone)
		box(c, -3.6, g + 1.8, 0.88, 0.25, 0.7, 0.06, DARK)
		box(c, -2.4, g, 0.5, 1.8, 0.9, 0.35, stone)
		box(c, -1.8, g, 1.4, 0.35, 0.6, 1.6, stone)
		ball(c, -2.5, g + 0.4, 2.4, 1, LEAF, Mat.Grass)
		-- 네시
		local skin = c.P
		local n0 = V(0.3, waterTop - 0.1, -0.3)
		local n1 = V(-0.25, 2.9, -0.7)
		local n2 = V(0.05, 4.7, -1.1)
		local head = V(-0.55, 5.7, -1.55)
		rod(c, n0, n1, 1, skin)
		ball(c, n1.X, n1.Y, n1.Z, 1, skin)
		rod(c, n1, n2, 0.84, skin)
		ball(c, n2.X, n2.Y, n2.Z, 0.84, skin)
		rod(c, n2, head, 0.7, skin)
		ball(c, head.X, head.Y, head.Z, 1.15, skin)
		rod(c, head, head + V(-0.75, -0.2, -0.6), 0.66, skin)
		for _, e in { V(-0.3, 0.3, -0.45), V(-0.68, 0.3, 0.05) } do
			local p = head + e
			ball(c, p.X, p.Y, p.Z, 0.22, c.A, Mat.Neon)
		end
		ball(c, 1.5, 0.8, 0.4, 1.6, skin)
		ball(c, 2.8, 0.7, 0.9, 1.4, skin)
		ball(c, 3.9, 0.55, 1.4, 1.1, skin)
		rod(c, V(4.1, waterTop - 0.1, 1.6), V(4.55, 1.7, 2.1), 0.4, skin)
		-- 물결
		for _, r in { { 0.3, -0.3, 2 }, { 1.5, 0.4, 2.3 }, { 2.8, 0.9, 2 } } do
			col(c, r[1], waterTop, r[2], 0.04, r[3], c.A, Mat.SmoothPlastic, 0.45)
		end
	end

	-- 미노타우로스의 미궁: 어두운 바닥 + 겹겹의 사각 미로 벽(엇갈린 틈과 막다른 길)
	--   + 미노아식 입구(아래가 좁은 붉은 기둥, 검은 기둥머리, 금빛 성스러운 뿔) + 횃불
	--   + 가운데 단 위에서 양날 도끼(라브리스)를 든 황소 머리 미노타우로스
	B.labyrinth = function(c)
		local t = 0.35
		local floorColor = mix(c.P, BLACK, 0.45)
		local wallColor = c.P
		box(c, 0, 0, 0, 9.8, 0.2, 9.8, floorColor)
		local function hwall(x1: number, x2: number, z: number, h: number)
			box(c, (x1 + x2) / 2, 0.2, z, x2 - x1 + t, h, t, wallColor)
		end
		local function vwall(x: number, z1: number, z2: number, h: number)
			box(c, x, 0.2, (z1 + z2) / 2, t, h, z2 - z1 + t, wallColor)
		end
		-- 바깥 고리(입구 = 앞 가운데)
		local o, m, i = 4.7, 3.6, 2.5
		hwall(-o, o, o, 1.6)
		vwall(-o, -o, o, 1.6)
		vwall(o, -o, o, 1.6)
		hwall(-o, -1, -o, 1.6)
		hwall(1, o, -o, 1.6)
		-- 둘째 고리(틈 = 뒤 왼쪽)
		hwall(-m, m, -m, 1.3)
		vwall(-m, -m, m, 1.3)
		vwall(m, -m, m, 1.3)
		hwall(-2.4, m, m, 1.3)
		-- 셋째 고리(틈 = 앞 오른쪽)
		hwall(-i, i, i, 1.3)
		vwall(-i, -i, i, 1.3)
		vwall(i, -i, i, 1.3)
		hwall(-i, 1.1, -i, 1.3)
		-- 막다른 길
		hwall(m, o, 0.5, 1.3)
		vwall(1, m, o, 1.3)
		vwall(-1, -m, -i, 1.3)
		-- 입구
		local gz = -4.6
		for _, s in { -1, 1 } do
			col(c, s * 0.95, 0.2, gz, 2.5, 0.5, c.S)
			col(c, s * 0.95, 2.7, gz, 0.35, 0.66, rgb(30, 26, 24))
		end
		box(c, 0, 3.05, gz, 2.8, 0.45, 0.7, c.P)
		box(c, 0, 3.05, gz - 0.36, 2.8, 0.2, 0.04, c.S)
		box(c, 0, 3.5, gz, 1.3, 0.3, 0.4, c.A, Mat.Metal)
		for _, s in { -1, 1 } do
			box(c, s * 0.5, 3.8, gz, 0.26, 0.7, 0.36, c.A, Mat.Metal)
		end
		for _, x in { -m, m } do
			ball(c, x, 1.75, -m, 0.4, c.A, Mat.Neon)
		end
		-- 가운데 단 + 미노타우로스
		col(c, 0, 0.2, 0, 0.4, 2.9, mix(c.P, WHITE, 0.25))
		local fur = rgb(92, 58, 44)
		local base = 0.6
		for _, s in { -1, 1 } do
			box(c, s * 0.33, base, 0, 0.45, 1.7, 0.55, fur)
		end
		box(c, 0, base + 1.4, 0, 1.2, 0.5, 0.7, c.S)
		box(c, 0, base + 1.9, 0, 1.7, 1.6, 0.85, fur)
		beam(c, V(-1.05, base + 3.2, 0), V(-1.25, base + 1.9, -0.35), 0.42, fur)
		beam(c, V(1.05, base + 3.2, 0), V(1.3, base + 2.3, -0.5), 0.42, fur)
		box(c, 0, base + 3.4, -0.05, 0.85, 0.95, 0.85, fur)
		box(c, 0, base + 3.45, -0.6, 0.62, 0.5, 0.4, mix(fur, WHITE, 0.25))
		for _, s in { -1, 1 } do
			beam(c, V(s * 0.35, base + 4.2, -0.05), V(s * 1.05, base + 4.95, -0.2), 0.2, rgb(240, 230, 205))
			ball(c, s * 0.22, base + 4.05, -0.49, 0.16, c.A, Mat.Neon)
		end
		-- 라브리스(양날 도끼)
		beam(c, V(1.35, base + 1.3, -0.55), V(1.35, base + 3.9, -0.55), 0.14, WOOD)
		block(c, CFrame.new(1.35, base + 3.55, -0.55) * CFrame.Angles(0, 0, PI / 4), V(0.7, 0.7, 0.08), c.A, Mat.Metal)
	end

	return B
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">Europe2</string>
            <string name="Source"><![CDATA[-- 유럽(2) 명소 전용 모형. Models/init.luau 가 K(파트 헬퍼·색·기존 모양)를 넘겨 호출합니다.
-- 규칙: 바닥 10x10 안, 높이 22 이하, 바닥 y = 0, 정면 -Z, 파트 45개 이하. c.P/c.S/c.A = 명소 주/보조/강조 색, c.M = 재질.
-- 개선문(arch) · 빅벤(clocktower) · 에펠탑(lattice) · 콜로세움(ring) · 스톤헨지(stones) · 아틀란티스(island) · 세계수(tree)
-- 는 원래 그 명소를 위해 만든 모양을 그대로 씀.

return function(K)
	local B = {}

	local V, rgb, Mat, PI = K.V, K.rgb, K.Mat, K.PI
	local ALONG_Z, CORNERS = K.ALONG_Z, K.CORNERS
	local GRASS, LEAF, WATER, DARK, ROCK, WOOD, SAND, BLACK, WHITE =
		K.GRASS, K.LEAF, K.WATER, K.DARK, K.ROCK, K.WOOD, K.SAND, K.BLACK, K.WHITE
	local mix, block, box, ball, cyl, col, wedge, beam = K.mix, K.block, K.box, K.ball, K.cyl, K.col, K.wedge, K.beam
	local archCorner, gable, stepped = K.archCorner, K.gable, K.stepped

	-- 정면(-Z)에서 삼각형이 보이는 박공(용마루가 Z 방향). 바닥 y, 폭 w(X), 깊이 d(Z), 높이 h
	local function frontGable(c, x, y, z, w, d, h, color, material)
		wedge(c, CFrame.new(x - w / 4, y + h / 2, z) * CFrame.Angles(0, PI / 2, 0), V(d, h, w / 2), color, material)
		wedge(c, CFrame.new(x + w / 4, y + h / 2, z) * CFrame.Angles(0, -PI / 2, 0), V(d, h, w / 2), color, material)
	end

	-- 원뿔 지붕: 지름이 줄어드는 원기둥 steps 단. 꼭대기 높이를 돌려줌
	local function cone(c, x, y, z, d, h, steps, color, material)
		local stepH = h / steps
		for i = 0, steps - 1 do
			col(c, x, y + i * stepH, z, stepH, d * (1 - i / steps), color, material)
		end
		return y + h
	end

	-- 타워 브리지: 템스강 + 강 속 교각 위의 고딕 석탑 2개(네 귀퉁이 작은 탑 + 뾰족 지붕 + 고딕 창)
	--   + 탑 위쪽을 잇는 파란 윗 보도 2줄(흰 띠) + 반쯤 들어 올린 도개교 상판 2장 + 기슭으로 내려가는 파란 현수 사슬
	B.towerbridge = function(c)
		local slate = rgb(78, 84, 96)
		local deck = 2.2
		local pier, towerTop = 1, 7.6
		box(c, 0, 0, 0, 9.8, 0.25, 9.8, mix(WATER, rgb(70, 110, 120), 0.4), Mat.Glass, 0.1)
		for _, sx in { -1, 1 } do
			local x = sx * 2.6
			-- 기슭 교대 + 옆 경간 도로
			box(c, sx * 4.6, 0, 0, 0.8, deck, 3.2, c.P)
			box(c, sx * 3.9, deck - 0.35, 0, 1.2, 0.35, 2.2, c.S)
			-- 교각 + 탑신 + 고딕 창
			box(c, x, 0, 0, 2.5, pier, 3.2, mix(c.P, ROCK, 0.35))
			box(c, x, pier, 0, 1.8, towerTop - pier, 2.4, c.P)
			box(c, x, 3.4, -1.22, 0.55, 2.6, 0.06, DARK)
			-- 네 귀퉁이 작은 탑 + 뾰족 모자
			for _, s in CORNERS do
				local tx, tz = x + s[1] * 0.85, s[2] * 1.15
				col(c, tx, pier, tz, towerTop - pier + 0.8, 0.58, c.P)
				col(c, tx, towerTop + 0.8, tz, 1, 0.34, slate)
			end
			-- 가운데 뾰족 지붕
			stepped(c, x, 0, towerTop, 1.6, 2.4, 3, slate)
			-- 현수 사슬(탑 위쪽 → 기슭)
			for _, sz in { -1, 1 } do
				beam(c, V(sx * 3.5, 6.6, sz * 0.9), V(sx * 4.75, deck + 0.1, sz * 0.9), 0.26, c.S)
			end
			-- 도개교 상판(탑 안쪽 면을 축으로 들어 올림)
			local angle = math.rad(40)
			local L = 1.7
			local cf = CFrame.new(sx * (1.7 - math.cos(angle) * L / 2), deck - 0.17 + math.sin(angle) * L / 2, 0)
			block(c, cf * CFrame.Angles(0, 0, -sx * angle), V(L, 0.34, 2.2), c.S)
		end
		-- 윗 보도(앞뒤 2줄) + 흰 띠
		for _, sz in { -1, 1 } do
			box(c, 0, 5.8, sz * 0.8, 3.6, 1.1, 0.5, c.S)
			box(c, 0, 6.2, sz * 1.06, 3.6, 0.3, 0.04, mix(c.S, WHITE, 0.55))
		end
		-- 가운데 탑 꼭지(금)
		for _, sx in { -1, 1 } do
			col(c, sx * 2.6, towerTop + 2.4, 0, 0.8, 0.14, c.A, Mat.Metal)
		end
	end

	-- 프라하 천문시계: 구시청사 탑(짙은 돌, 난간 + 뾰족 지붕 + 네 귀퉁이 작은 탑) 앞면 아래에 튀어나온 시계 집
	--   + 파란 천문 시계판(금테, 아래쪽 검은 땅, 위로 치우친 황도 고리, 금 바늘) + 아래 달력판 + 사도 창 + 양옆 인형
	--   + 양옆의 박공 집들
	B.pragueclock = function(c)
		local light = mix(c.P, WHITE, 0.3)
		local roofC = mix(c.P, BLACK, 0.4)
		local tileRed = rgb(170, 72, 52)
		local gold = c.A
		local tx, tz = 0.6, 1.4
		box(c, 0, 0, 0, 9.8, 0.3, 9.8, rgb(176, 166, 150), Mat.Cobblestone)
		-- 양옆 집(정면 박공)
		box(c, -3.4, 0.3, 1.4, 3, 5.4, 5, rgb(236, 214, 180))
		frontGable(c, -3.4, 5.7, 1.4, 3, 5, 1.8, tileRed)
		box(c, 3.9, 0.3, 1.8, 2, 4.6, 4.6, rgb(222, 190, 150))
		frontGable(c, 3.9, 4.9, 1.8, 2, 4.6, 1.4, tileRed)
		-- 탑
		box(c, tx, 0.3, tz, 3.4, 13.2, 3.4, c.P)
		box(c, tx, 9, tz, 3.6, 0.3, 3.6, light)
		box(c, tx, 10.2, tz - 1.72, 0.6, 1.8, 0.06, DARK)
		box(c, tx, 13.5, tz, 4, 0.5, 4, light)
		local top = stepped(c, tx, tz, 14, 2.8, 3.6, 3, roofC)
		col(c, tx, top, tz, 0.9, 0.14, gold, Mat.Metal)
		ball(c, tx, top + 1, tz, 0.35, gold, Mat.Metal)
		for _, s in CORNERS do
			local x, z = tx + s[1] * 1.75, tz + s[2] * 1.75
			col(c, x, 13.5, z, 1.8, 0.6, c.P)
			col(c, x, 15.3, z, 1.3, 0.3, roofC)
		end
		-- 시계 집(탑 앞면에 튀어나옴) + 경사 지붕
		local front = tz - 1.7 - 0.9
		box(c, tx, 0.3, front + 0.45, 3, 8.6, 0.9, light)
		wedge(c, CFrame.new(tx, 8.9 + 0.7, front + 0.45), V(3.2, 1.4, 0.9), roofC)
		-- 천문 시계판
		local ay = 5.7
		cyl(c, CFrame.new(tx, ay, front - 0.05) * ALONG_Z, 0.1, 2.7, gold, Mat.Metal)
		cyl(c, CFrame.new(tx, ay, front - 0.12) * ALONG_Z, 0.1, 2.3, c.S)
		cyl(c, CFrame.new(tx, ay - 0.55, front - 0.18) * ALONG_Z, 0.06, 1.1, DARK)
		cyl(c, CFrame.new(tx, ay + 0.25, front - 0.22) * ALONG_Z, 0.05, 1.5, gold, Mat.Metal)
		cyl(c, CFrame.new(tx, ay + 0.25, front - 0.26) * ALONG_Z, 0.05, 1.2, c.S)
		block(
			c,
			CFrame.new(tx, ay, front - 0.32) * CFrame.Angles(0, 0, -0.7) * CFrame.new(0, 0.55, 0),
			V(0.14, 1.1, 0.05),
			gold
		)
		ball(c, tx, ay, front - 0.32, 0.3, gold, Mat.Metal)
		-- 달력판
		cyl(c, CFrame.new(tx, 2.2, front - 0.05) * ALONG_Z, 0.1, 2.1, gold, Mat.Metal)
		cyl(c, CFrame.new(tx, 2.2, front - 0.12) * ALONG_Z, 0.1, 1.7, rgb(240, 232, 210))
		-- 사도 창 2개 + 양옆 인형(해골 등)
		for _, sx in { -1, 1 } do
			box(c, tx + sx * 0.55, 7.3, front - 0.02, 0.55, 0.8, 0.06, DARK)
			col(c, tx + sx * 1.8, 4.6, front + 0.2, 1.2, 0.4, light)
			ball(c, tx + sx * 1.8, 6, front + 0.2, 0.45, if sx < 0 then WHITE else gold)
		end
	end

	-- 산토리니(이아): 칼데라 바다 + 붉은 화산암 절벽(비탈 + 두 단 테라스) + 층층이 쌓인 흰 집들(파란 문, 몇 채는 황토색)
	--   + 파란 돔 교회 2채(흰 십자가) + 종탑 + 풍차
	B.santorini = function(c)
		local rock = rgb(168, 104, 80)
		local rockDark = rgb(122, 82, 70)
		local white = c.P
		local cream = rgb(245, 234, 214)
		local ochre = mix(c.A, WHITE, 0.3)
		box(c, 0, 0, 0, 9.8, 0.3, 9.8, mix(WATER, c.S, 0.5), Mat.Glass, 0.1)
		-- 절벽
		wedge(c, CFrame.new(0, 0.3 + 1.6, -1.6), V(9.8, 3.2, 2.2), rockDark, Mat.Rock)
		box(c, 0, 0.3, 2.25, 9.8, 3.2, 5.5, rock, Mat.Rock)
		box(c, 0, 3.5, 3.3, 9.8, 2, 3.4, rock, Mat.Rock)
		box(c, 0, 2.3, -0.53, 9.8, 0.35, 0.06, rgb(222, 206, 188), Mat.Rock)
		-- 집: { x, y, z, 가로, 높이, 세로, 색, 파란 문 }
		local houses = {
			{ -4, 3.5, 0.5, 1.6, 1.5, 1.8, white, true },
			{ -2.4, 3.5, 0.2, 1.4, 1.1, 1.4, ochre, false },
			{ -0.9, 3.5, 0.7, 1.5, 1.7, 1.6, white, true },
			{ 4.1, 3.5, 0.6, 1.5, 1.5, 1.6, cream, false },
			{ -3.8, 5.5, 2.6, 1.8, 1.2, 1.8, white, false },
			{ -2.2, 5.5, 3.8, 1.5, 1.6, 1.8, ochre, false },
			{ 1.8, 5.5, 2.5, 1.6, 1, 1.6, white, true },
			{ 3.7, 5.5, 2.8, 1.8, 1.4, 1.8, white, false },
			{ 1, 5.5, 4.2, 2, 1.8, 1.4, cream, false },
			{ -3, 1.6, -1.1, 1.2, 1, 1.2, white, false },
			{ 3, 1.3, -1.3, 1, 0.9, 1.2, white, false },
			{ -4.2, 2.3, -0.8, 1.1, 1.2, 1, white, true },
			{ -1.4, 2.2, -0.9, 1.3, 1.3, 1, cream, false },
			{ 0.8, 2.5, -0.8, 1.2, 1, 1, white, false },
			{ 4.1, 2, -1, 1, 1.1, 1.2, ochre, false },
		}
		for _, h in houses do
			box(c, h[1], h[2], h[3], h[4], h[5], h[6], h[7])
			if h[8] then
				box(c, h[1], h[2], h[3] - h[6] / 2 - 0.02, 0.4, 0.7, 0.06, c.S)
			end
		end
		-- 파란 돔 교회 2채
		for _, ch in { { -0.6, 5.5, 2.4, 1.8 }, { 2.4, 3.5, 0.4, 1.6 } } do
			local x, y, z, w = ch[1], ch[2], ch[3], ch[4]
			box(c, x, y, z, w, w * 0.85, w, white)
			ball(c, x, y + w * 0.85, z, w, c.S)
			box(c, x, y + w * 0.85 + w * 0.45, z, 0.12, 0.55, 0.12, white)
		end
		-- 종탑(흰 벽 + 종 창 + 작은 파란 돔)
		box(c, 0.7, 5.5, 1.9, 0.8, 2.6, 0.8, white)
		box(c, 0.7, 7, 1.48, 0.4, 0.6, 0.06, DARK)
		ball(c, 0.7, 8.1, 1.9, 0.6, c.S)
		-- 풍차
		col(c, -4, 5.5, 4.2, 1.8, 1, white)
		ball(c, -4, 7.3, 4.2, 1, rgb(150, 120, 90))
		for _, a in { PI / 4, -PI / 4 } do
			block(c, CFrame.new(-4, 7.1, 3.6) * CFrame.Angles(0, 0, a), V(0.12, 2.2, 0.06), WOOD, Mat.Wood)
		end
	end

	-- 헝가리 국회의사당: 도나우강 + 강변 둑 + 낮고 길쭉한 흰 고딕 본관(앞면 전체 창 띠, 붉은 박공지붕)
	--   + 가운데 전각의 큰 붉은 돔(창 두른 드럼 + 알 모양 돔 + 등롱 + 가는 첨탑, 둘레 작은 첨탑) + 입구 양옆 뾰족탑
	--   + 날개 전각(가파른 지붕, 앞 귀퉁이 첨탑) + 양 끝 전각
	B.hungaryparliament = function(c)
		local stone = c.P
		local roofC = c.S
		local shade = mix(c.P, BLACK, 0.55)
		box(c, 0, 0, -3.75, 9.8, 0.25, 2.5, WATER, Mat.Glass, 0.1)
		box(c, 0, 0, 1.25, 9.8, 0.5, 7.5, mix(c.P, ROCK, 0.5))
		-- 본관 + 창 띠
		box(c, 0, 0.5, 1.1, 9.4, 2.4, 3.8, stone)
		gable(c, 0, 2.9, 1.1, 9.4, 3.8, 1.6, roofC)
		box(c, 0, 1.2, -1.07, 9.4, 1, 0.06, shade)
		-- 가운데 전각 + 돔
		box(c, 0, 0.5, 1, 3, 3.6, 4, stone)
		col(c, 0, 4.1, 1, 1.8, 3.4, stone)
		col(c, 0, 4.55, 1, 0.8, 3.46, shade)
		ball(c, 0, 5.9, 1, 3.4, roofC)
		ball(c, 0, 7, 1, 2.2, roofC)
		col(c, 0, 7.8, 1, 1, 0.8, stone)
		col(c, 0, 8.8, 1, 3.6, 0.3, roofC)
		ball(c, 0, 12.5, 1, 0.35, c.A, Mat.Neon)
		for _, s in CORNERS do
			col(c, s[1] * 1.35, 4.1, 1 + s[2] * 1.35, 2.6, 0.28, stone)
		end
		for _, sx in { -1, 1 } do
			-- 입구 양옆 뾰족탑
			box(c, sx * 1.75, 0.5, -1, 0.6, 5.2, 0.6, stone)
			cone(c, sx * 1.75, 5.7, -1, 0.85, 2.2, 3, roofC)
			-- 날개 가운데 전각(가파른 지붕 + 앞 귀퉁이 첨탑)
			local mx = sx * 3
			box(c, mx, 0.5, 1, 1.4, 3.2, 4, stone)
			frontGable(c, mx, 3.7, 1, 1.4, 4, 1.8, roofC)
			for _, dx in { -0.7, 0.7 } do
				col(c, mx + dx, 0.5, -1.15, 4.4, 0.28, stone)
			end
			-- 양 끝 전각
			box(c, sx * 4.4, 0.5, 1, 1, 3.4, 4, stone)
			frontGable(c, sx * 4.4, 3.9, 1, 1, 4, 1.4, roofC)
		end
	end

	-- 보르군 목조 교회: 풀밭 + 둘레 회랑 + 층층이 겹친 가파른 박공지붕 3단(정면에서 삼각형이 겹쳐 보임)
	--   + 용마루 위 작은 탑(십자 박공) + 뾰족 첨탑 + 박공 끝의 용머리 + 뒤쪽 둥근 앱스 탑 + 전나무
	B.stavechurch = function(c)
		local wall = c.S
		local roofC = c.P
		local cz = -0.3
		col(c, 0, 0, 0, 0.3, 9.8, GRASS, Mat.Grass)
		-- 회랑 + 층층 지붕
		box(c, 0, 0.3, cz, 5.8, 1.2, 7.6, wall)
		box(c, 0, 0.3, cz - 3.82, 0.9, 1.1, 0.06, DARK)
		frontGable(c, 0, 1.5, cz, 6.6, 8.2, 1.3, roofC)
		box(c, 0, 1.5, cz, 4, 2.2, 6.4, wall)
		frontGable(c, 0, 3.4, cz, 5, 6.8, 1.2, roofC)
		box(c, 0, 3.4, cz, 2.8, 2.4, 5.6, wall)
		frontGable(c, 0, 5.8, cz, 3.6, 6, 2.6, roofC)
		-- 용마루 위 탑 + 십자 박공 + 첨탑
		box(c, 0, 7.4, cz, 1.3, 2, 1.3, wall)
		frontGable(c, 0, 9.4, cz, 1.9, 1.9, 0.9, roofC)
		gable(c, 0, 9.4, cz, 1.9, 1.9, 0.9, roofC)
		box(c, 0, 9.8, cz, 0.9, 0.8, 0.9, wall)
		frontGable(c, 0, 10.6, cz, 1.1, 1.1, 3, roofC)
		gable(c, 0, 10.6, cz, 1.1, 1.1, 3, roofC)
		-- 용머리(박공 끝에서 위·바깥으로)
		for _, sz in { -1, 1 } do
			beam(c, V(0, 8.2, cz + sz * 2.8), V(0, 9.2, cz + sz * 3.7), 0.24, c.A)
			beam(c, V(0, 10.1, cz + sz * 0.9), V(0, 10.7, cz + sz * 1.5), 0.18, c.A)
		end
		-- 뒤쪽 둥근 앱스 탑
		col(c, 0, 0.3, 4.1, 3.4, 1.6, wall)
		cone(c, 0, 3.7, 4.1, 1.8, 2.4, 3, roofC)
		-- 전나무
		for _, t in { { -3.9, -2.6 }, { 3.8, 1.8 } } do
			col(c, t[1], 0.3, t[2], 0.5, 0.35, WOOD, Mat.Wood)
			cone(c, t[1], 0.8, t[2], 1.9, 3.6, 4, mix(LEAF, BLACK, 0.2), Mat.Grass)
		end
	end

	-- 알함브라: 초록 사비카 언덕 + 평지 위 붉은 성벽(성가퀴) + 벨라 탑 + 코마레스 탑(창) + 흰 아케이드와 도금양 안뜰 연못
	--   + 사이프러스 + 뒤쪽 눈 덮인 시에라네바다 산
	B.alhambra = function(c)
		local wall = c.P
		local shade = mix(c.P, BLACK, 0.25)
		local stucco = rgb(236, 222, 196)
		local green = c.A
		local mountain = rgb(104, 114, 140)
		box(c, 0, 0, 0, 9.8, 0.3, 9.8, mix(green, LEAF, 0.4), Mat.Grass)
		-- 눈 덮인 산(뒤)
		for _, m in { { -1.8, 4.2, 6.2, 7.5 }, { 2.6, 4.25, 4.8, 5.6 } } do
			local x, z, w, h = m[1], m[2], m[3], m[4]
			frontGable(c, x, 0.3, z, w, 1.4, h, mountain, Mat.Rock)
			frontGable(c, x, 0.3 + h * 0.58, z - 0.08, w * 0.42, 1.4, h * 0.42, WHITE, Mat.Snow)
		end
		-- 언덕 위 평지 + 성벽
		box(c, 0.2, 0.3, 0.1, 9.2, 1.2, 6.8, mix(c.S, SAND, 0.35))
		wedge(c, CFrame.new(0.2, 0.9, -3.9), V(9.2, 1.2, 1.2), mix(green, LEAF, 0.3), Mat.Grass)
		local y = 1.5
		box(c, 0.2, y, -3, 9, 1.6, 0.5, wall)
		box(c, -4.1, y, 0.2, 0.5, 1.4, 6.2, wall)
		box(c, 4.5, y, 0.2, 0.5, 1.4, 6.2, wall)
		box(c, 0.2, y, 3.2, 9, 1.2, 0.4, wall)
		for k = 0, 3 do
			box(c, -1.8 + k * 1.3, y + 1.6, -3, 0.45, 0.35, 0.5, wall)
		end
		box(c, -0.8, y, -3.27, 0.8, 1.1, 0.06, DARK)
		-- 벨라 탑(왼쪽 앞) + 종
		box(c, -3.5, y, -2.5, 1.8, 3.8, 1.8, wall)
		box(c, -3.5, y + 3.8, -2.5, 2, 0.35, 2, shade)
		box(c, -3.5, y + 4.15, -2.5, 0.6, 0.7, 0.6, stucco)
		-- 오른쪽 앞 탑
		box(c, 3.9, y, -2.4, 1.3, 3, 1.3, wall)
		box(c, 3.9, y + 3, -2.4, 1.5, 0.3, 1.5, shade)
		-- 코마레스 탑 + 창
		box(c, 1.8, y, 1.9, 2.4, 5.4, 2.4, wall)
		box(c, 1.8, y + 5.4, 1.9, 2.6, 0.3, 2.6, shade)
		for _, sx in { -1, 1 } do
			box(c, 1.8 + sx * 0.6, 4.6, 0.68, 0.35, 0.9, 0.06, DARK)
		end
		-- 아케이드 + 도금양 안뜰(연못과 산울타리)
		box(c, 1.8, y, 0.35, 2.8, 1.8, 0.6, stucco)
		for k = -1, 1 do
			box(c, 1.8 + k * 0.85, y, 0.03, 0.55, 1.2, 0.06, DARK)
		end
		box(c, 1.8, y, -1.3, 1.1, 0.06, 2.4, WATER, Mat.Glass, 0.1)
		for _, sx in { -1, 1 } do
			box(c, 1.8 + sx * 0.95, y, -1.3, 0.4, 0.45, 2.4, green, Mat.Grass)
		end
		-- 사이프러스 + 언덕 숲
		for _, t in { { -2.4, -1.9 }, { -2.4, 0.3 }, { -1.1, 2.4 } } do
			col(c, t[1], y, t[2], 1.9, 0.5, mix(LEAF, BLACK, 0.3), Mat.Grass)
		end
		for _, t in { { -4.2, -4.3, 1.1 }, { 1.4, -4.3, 1.2 }, { 4.2, -4.2, 1 } } do
			ball(c, t[1], 0.55 + t[3] * 0.35, t[2], t[3], mix(green, LEAF, 0.5), Mat.Grass)
		end
	end

	-- 노이슈반슈타인 성: 숲 + 바위 벼랑 위 흰 성. 높은 본관(창 띠 + 파란 박공지붕) + 가장 높은 가는 원탑(원뿔 지붕)
	--   + 작은 원탑 + 네모 탑 + 앞쪽 성문 건물(연분홍, 양옆 원뿔 지붕 작은 탑)
	B.neuschwanstein = function(c)
		local white = c.P
		local roofC = c.S
		local gateColor = mix(c.P, rgb(214, 150, 118), 0.55)
		box(c, 0, 0, 0, 9.8, 0.3, 9.8, mix(GRASS, LEAF, 0.5), Mat.Grass)
		-- 바위 벼랑 + 숲
		box(c, 0.4, 0.3, 0.6, 8.2, 1.4, 7.2, ROCK, Mat.Slate)
		box(c, 0.6, 1.7, 0.8, 7.4, 1, 6.2, mix(ROCK, WHITE, 0.1), Mat.Slate)
		for _, t in { { -4.1, -3.9, 1.4 }, { -4, 2.9, 1.6 }, { 4.1, -4, 1.4 }, { 2.2, -4.2, 1.2 } } do
			ball(c, t[1], t[3] / 2 + 0.2, t[2], t[3], LEAF, Mat.Grass)
		end
		local y = 2.7
		-- 본관(팔라스)
		box(c, 1.3, y, 1.9, 5, 7, 2.4, white)
		for _, wy in { 5.2, 7.4 } do
			for k = -1, 1 do
				box(c, 1.3 + k * 1.5, wy, 0.68, 0.7, 1, 0.06, DARK)
			end
		end
		gable(c, 1.3, 9.7, 1.9, 5, 2.4, 2.4, roofC)
		-- 가장 높은 원탑
		col(c, -1.4, y, 0.5, 11.2, 1.4, white)
		col(c, -1.4, 13.9, 0.5, 0.35, 1.8, white)
		local top = cone(c, -1.4, 14.25, 0.5, 1.7, 3.6, 4, roofC)
		col(c, -1.4, top, 0.5, 1, 0.14, c.A, Mat.Metal)
		-- 작은 원탑(본관 오른쪽 끝)
		col(c, 4, y, 1, 8.6, 1, white)
		cone(c, 4, 11.3, 1, 1.2, 2.2, 3, roofC)
		-- 네모 탑(왼쪽 뒤)
		box(c, -2.9, y, 2.1, 1.6, 6, 1.6, white)
		stepped(c, -2.9, 2.1, 8.7, 1.8, 1.8, 2, roofC)
		-- 성문 건물 + 양옆 작은 탑
		box(c, 0.2, y, -1.5, 5, 3.2, 1.4, gateColor)
		gable(c, 0.2, 5.9, -1.5, 5, 1.4, 1.1, roofC)
		box(c, 0.2, y, -2.23, 0.9, 1.4, 0.06, DARK)
		for _, sx in { -1, 1 } do
			local x = 0.2 + sx * 2.5
			col(c, x, y, -2, 4.4, 0.9, gateColor)
			cone(c, x, 7.1, -2, 1.1, 1.8, 3, roofC)
		end
	end

	-- 세고비아 수도교: 광장 + 가늘고 높은 화강암 교각 위 2층 아치(아래층 높은 아치 5개, 위층 낮은 아치 5개) + 꼭대기 물길
	B.segovia = function(c)
		local stone = c.P
		local dark = mix(c.P, BLACK, 0.25)
		box(c, 0, 0, 0, 9.8, 0.3, 9.8, mix(c.S, SAND, 0.4), Mat.Cobblestone)
		local pierW, depth = 0.78, 1.5
		local spacing = 1.76
		local lowTop, beamH = 8.2, 0.7
		local upBase = lowTop + beamH
		local upTop = upBase + 2.4
		for k = 0, 5 do
			local x = -4.4 + k * spacing
			box(c, x, 0.3, 0, pierW, lowTop - 0.3, depth, stone)
			box(c, x, upBase, 0, pierW * 0.9, upTop - upBase, depth * 0.85, stone)
		end
		box(c, 0, lowTop, 0, 9.6, beamH, depth, stone)
		box(c, 0, upTop, 0, 9.6, 0.7, depth * 0.85, stone)
		box(c, 0, upTop + 0.7, 0, 9.6, 0.3, depth * 0.7, dark)
		for k = 0, 4 do
			local xl = -4.4 + k * spacing
			local xr = xl + spacing
			archCorner(c, xl + pierW / 2, lowTop, 0, 0.32, depth, stone, -1)
			archCorner(c, xr - pierW / 2, lowTop, 0, 0.32, depth, stone, 1)
			archCorner(c, xl + pierW * 0.45, upTop, 0, 0.3, depth * 0.85, stone, -1)
			archCorner(c, xr - pierW * 0.45, upTop, 0, 0.3, depth * 0.85, stone, 1)
		end
		-- 뒤쪽 구시가 집(붉은 기와)
		local tile = rgb(176, 84, 56)
		for _, h in { { -3, 3.4, 2.6, 2.2, 2.2, rgb(226, 200, 160) }, { 3.2, 3.5, 2.4, 2.8, 2, rgb(214, 186, 150) } } do
			box(c, h[1], 0.3, h[2], h[3], h[4], h[5], h[6])
			gable(c, h[1], 0.3 + h[4], h[2], h[3] + 0.2, h[5] + 0.2, 0.9, tile)
		end
	end

	-- 메테오라: 초록 골짜기 + 둥글게 솟은 바위 기둥들(위로 조금씩 좁아짐) + 꼭대기 끝까지 지은 수도원(붉은 지붕, 돔, 종탑)
	B.meteora = function(c)
		local rock = c.P
		local rockDark = mix(c.P, BLACK, 0.18)
		local wallC = rgb(226, 214, 190)
		local roofC = c.S
		box(c, 0, 0, 0, 9.8, 0.3, 9.8, mix(c.A, LEAF, 0.4), Mat.Grass)
		-- 바위 기둥: 원기둥 몸통 + 비틀어 붙인 모난 덩어리(세로 골) + 불룩한 밑동
		local function pillar(x, z, h, d, twist)
			col(c, x, 0.3, z, h, d, rock, Mat.Rock)
			local cf = CFrame.new(x + d * 0.1, 0.3 + h * 0.46, z - d * 0.08) * CFrame.Angles(0, twist, 0.03)
			block(c, cf, V(d * 0.78, h * 0.92, d * 0.92), rockDark, Mat.Rock)
			ball(c, x - d * 0.12, 0.3 + d * 0.5, z + d * 0.05, d, rockDark, Mat.Rock)
			return 0.3 + h
		end
		-- 가장 큰 기둥 + 큰 수도원
		local top = pillar(0.6, 1.4, 10, 3.8, 0.3)
		box(c, 0.2, top, 1.8, 2.4, 1.3, 1.6, wallC)
		gable(c, 0.2, top + 1.3, 1.8, 2.6, 1.8, 0.8, roofC)
		box(c, 1.4, top, 0.7, 1.3, 1, 1.2, wallC)
		ball(c, 1.4, top + 1, 0.7, 0.9, roofC)
		box(c, -0.7, top, 0.6, 0.6, 2, 0.6, wallC)
		box(c, -0.7, top + 2, 0.6, 0.8, 0.3, 0.8, roofC)
		-- 왼쪽 기둥 + 수도원(꼭대기를 다 덮음)
		top = pillar(-2.9, -0.8, 7, 2.8, -0.4)
		box(c, -2.9, top, -0.8, 2.3, 1.2, 2, wallC)
		gable(c, -2.9, top + 1.2, -0.8, 2.5, 2.2, 0.8, roofC)
		-- 오른쪽 낮은 기둥 + 작은 예배당
		top = pillar(3.2, -2.2, 5.2, 2.2, 0.5)
		box(c, 3.2, top, -2.2, 1.2, 0.9, 1.2, wallC)
		gable(c, 3.2, top + 0.9, -2.2, 1.4, 1.4, 0.6, roofC)
		-- 뒤쪽 빈 기둥들(꼭대기 풀)
		for _, p in { { -2.6, 3.2, 8.5, 2.6, 0.7 }, { 3.3, 3.3, 6.5, 2.1, -0.2 } } do
			top = pillar(p[1], p[2], p[3], p[4], p[5])
			ball(c, p[1], top, p[2], p[4] * 0.95, rock, Mat.Rock)
		end
		-- 골짜기 나무
		for _, t in { { -4.2, -3.8 }, { -1, -3.6 }, { 1.4, -4.2 }, { 4.3, 0.8 }, { -4.4, 1.6 } } do
			ball(c, t[1], 0.8, t[2], 1.1, mix(c.A, LEAF, 0.6), Mat.Grass)
		end
	end

	-- 폼페이: 화산재 땅 + 뒤쪽 베수비오 화산(층층 원뿔 + 빛나는 분화구 + 용암 줄기 + 우산 소나무 모양 연기)
	--   + 앞쪽 포룸 유적(바닥 + 부서진 기둥 줄 + 유피테르 신전 기단과 기둥) + 지붕 없는 집 벽
	B.pompeii = function(c)
		local ruin = c.P
		local ruinDark = mix(c.P, BLACK, 0.2)
		local ash = c.S
		box(c, 0, 0, 0, 9.8, 0.3, 9.8, mix(c.P, ROCK, 0.45), Mat.Ground)
		-- 베수비오
		local vx, vz = 0.8, 2.3
		local y = 0.3
		local diameters = { 5.4, 4.8, 4.2, 3.6, 3, 2.5, 2.1 }
		for i, d in diameters do
			local t = (i - 1) / (#diameters - 1)
			col(c, vx, y, vz, 0.95, d, mix(mix(ash, GRASS, 0.3), mix(ash, BLACK, 0.15), t), Mat.Rock)
			y += 0.95
		end
		col(c, vx, y - 0.05, vz, 0.1, 1.5, c.A, Mat.Neon)
		beam(c, V(vx - 0.4, y - 0.1, vz - 0.8), V(vx - 1.3, 1.4, vz - 2.5), 0.3, c.A, Mat.Neon)
		beam(c, V(vx + 0.5, y - 0.1, vz - 0.7), V(vx + 1.9, 1.8, vz - 1.6), 0.25, c.A, Mat.Neon)
		local smoke = rgb(120, 112, 108)
		ball(c, vx, y + 1.1, vz, 1.6, smoke, Mat.SmoothPlastic, 0.15)
		ball(c, vx - 0.3, y + 2.5, vz + 0.2, 2.2, smoke, Mat.SmoothPlastic, 0.15)
		ball(c, vx + 0.2, y + 4.2, vz + 0.1, 3, mix(smoke, WHITE, 0.2), Mat.SmoothPlastic, 0.15)
		-- 포룸 바닥
		box(c, -0.6, 0.3, -2.6, 7.4, 0.12, 4, mix(ruin, WHITE, 0.2))
		-- 유피테르 신전(기단 + 계단 + 앞 기둥 4개, 일부 부러짐)
		box(c, 0.6, 0.3, -1.3, 2.6, 1, 2, ruin)
		wedge(c, CFrame.new(0.6, 0.8, -2.6), V(1.4, 1, 0.6), ruin)
		for k, h in { 2.2, 1.4, 2.2, 0.9 } do
			col(c, 0.6 + (k - 2.5) * 0.7, 1.3, -2, h, 0.38, ruin)
		end
		-- 포룸 양옆 부서진 기둥 줄
		for k, h in { 1.8, 1.8, 1, 1.8 } do
			col(c, -3.6, 0.42, -4.2 + (k - 1) * 1, h, 0.42, ruin)
		end
		box(c, -3.6, 2.22, -3.7, 0.5, 0.3, 1.5, ruin)
		for k, h in { 1.6, 0.8, 1.6 } do
			col(c, 3.6, 0.42, -4.2 + (k - 1) * 1.2, h, 0.42, ruin)
		end
		-- 지붕 없는 집 벽
		box(c, -3, 0.3, 1, 2.6, 1.3, 0.25, ruinDark)
		box(c, -4.2, 0.3, 2, 0.25, 1.3, 2.2, ruinDark)
		box(c, -2.2, 0.3, 2.4, 0.25, 0.9, 1.6, ruinDark)
		box(c, -3.2, 0.3, 3.4, 2, 1.1, 0.25, ruinDark)
		box(c, 4.4, 0.3, 1.5, 0.25, 1.2, 3, ruinDark)
		box(c, 4, 0.3, 3.9, 1, 0.9, 0.25, ruinDark)
	end

	-- 올림피아 제우스 상: 신전 대리석 바닥 + 올리브기름 연못 + 흑단 받침(금 띠) 위 옥좌에 앉은 상아·황금 거상
	--   (금 옷자락 두른 다리와 무릎, 드러난 상아 가슴, 금 머리칼·수염, 올리브 관) + 오른손의 승리의 여신 니케
	--   + 왼손에 쥔 독수리 홀 + 양옆 신전 기둥과 들보
	B.zeus = function(c)
		local ivory = c.P
		local gold = c.S
		local ebony = rgb(48, 36, 32)
		local marble = rgb(232, 228, 220)
		box(c, 0, 0, 0, 9.8, 0.4, 9.8, marble, Mat.Marble)
		box(c, 0, 0.4, -3.3, 4.6, 0.1, 2.2, c.A, Mat.Glass, 0.2)
		-- 받침 + 발판 + 옥좌
		box(c, 0, 0.4, 1.2, 5.4, 1.4, 4.6, ebony)
		box(c, 0, 1.5, 1.2, 5.5, 0.2, 4.7, gold, Mat.Metal)
		box(c, 0, 1.8, -0.7, 2.6, 0.4, 1, gold, Mat.Metal)
		box(c, 0, 1.8, 1.9, 3.8, 2.5, 2.8, ebony)
		box(c, 0, 1.8, 3.6, 4, 10, 0.6, ebony)
		box(c, 0, 11.6, 3.6, 4.2, 0.3, 0.7, gold, Mat.Metal)
		for _, sx in { -1, 1 } do
			ball(c, sx * 1.8, 12.2, 3.6, 0.6, gold, Mat.Metal)
			box(c, sx * 2.1, 4.3, 1.9, 0.5, 1.4, 2.6, gold, Mat.Metal)
		end
		-- 앉은 몸: 다리(금 옷자락) + 발 + 무릎 + 상아 가슴 + 어깨에 두른 옷자락
		for _, sx in { -1, 1 } do
			box(c, sx * 0.6, 2.2, -0.4, 0.9, 2.4, 0.9, gold)
			box(c, sx * 0.6, 2.2, -0.95, 0.6, 0.35, 0.5, ivory)
		end
		box(c, 0, 4.3, 1.1, 2.4, 1.1, 3.1, gold)
		box(c, 0, 5.2, 2.4, 2.2, 3.4, 1.5, ivory)
		beam(c, V(-1, 8.4, 1.6), V(0.9, 5.4, 1.6), 0.55, gold)
		-- 머리: 상아 얼굴 + 금 머리칼 + 금 수염 + 올리브 관
		ball(c, 0, 9.5, 2.3, 1.7, ivory)
		ball(c, 0, 9.75, 2.75, 1.7, gold)
		ball(c, 0, 8.75, 1.85, 1.05, gold)
		col(c, 0, 9.95, 2.4, 0.25, 1.6, rgb(110, 150, 70))
		-- 오른팔(앞으로 내밀어 니케를 받침) + 니케
		beam(c, V(1.3, 8.3, 2.4), V(1.5, 6.4, 1.6), 0.6, ivory)
		beam(c, V(1.5, 6.4, 1.6), V(1.6, 6.6, -0.2), 0.55, ivory)
		col(c, 1.6, 6.8, -0.3, 1.1, 0.45, gold, Mat.Metal)
		ball(c, 1.6, 8.1, -0.3, 0.42, gold, Mat.Metal)
		for _, sx in { -1, 1 } do
			block(
				c,
				CFrame.new(1.6 + sx * 0.32, 7.8, -0.05) * CFrame.Angles(0, 0, sx * 0.55),
				V(0.12, 0.95, 0.45),
				WHITE
			)
		end
		-- 왼팔(들어 올려 홀을 쥠) + 독수리 홀
		beam(c, V(-1.3, 8.3, 2.4), V(-2.1, 7.2, 1.6), 0.6, ivory)
		beam(c, V(-2.1, 7.2, 1.6), V(-2.3, 9, 1.2), 0.5, ivory)
		col(c, -2.35, 1.8, 1.2, 11.2, 0.22, gold, Mat.Metal)
		ball(c, -2.35, 13.2, 1.2, 0.55, gold, Mat.Metal)
		for _, sx in { -1, 1 } do
			beam(c, V(-2.35, 13.2, 1.2), V(-2.35 + sx * 0.75, 13.6, 1.2), 0.18, gold, Mat.Metal)
		end
		-- 신전 기둥 + 들보
		for _, sx in { -1, 1 } do
			for _, z in { 0.2, 4 } do
				col(c, sx * 4.3, 0.4, z, 13, 0.8, marble, Mat.Marble)
			end
			box(c, sx * 4.3, 13.4, 2.1, 0.9, 0.6, 5.2, marble, Mat.Marble)
		end
	end

	return B
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
