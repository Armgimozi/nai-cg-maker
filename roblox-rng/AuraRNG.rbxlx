      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Auras</string>
          <string name="Source"><![CDATA[--!strict
-- 오라(뽑기 결과) 목록. OneIn = "1/N 확률"의 N.
-- 새 오라를 추가하려면 Auras 표에 한 줄만 넣으면 됩니다(Id는 저장 키이므로 바꾸지 마세요).

export type Tier = {
	Rank: number,
	Name: string,
	MinOneIn: number,
	Color: Color3,
}

export type Aura = {
	Id: string,
	Name: string,
	Subtitle: string,
	OneIn: number,
	Color: Color3,
	Gradient: { Color3 }?,
	Tier: Tier,
}

local Auras = {}

-- 등급: OneIn 이 MinOneIn 이상이면 해당 등급(높은 등급부터 검사)
Auras.Tiers = {
	{ Rank = 1, Name = "일반", MinOneIn = 1, Color = Color3.fromRGB(200, 200, 200) },
	{ Rank = 2, Name = "고급", MinOneIn = 10, Color = Color3.fromRGB(110, 220, 110) },
	{ Rank = 3, Name = "희귀", MinOneIn = 100, Color = Color3.fromRGB(80, 160, 255) },
	{ Rank = 4, Name = "에픽", MinOneIn = 1000, Color = Color3.fromRGB(180, 100, 255) },
	{ Rank = 5, Name = "전설", MinOneIn = 10000, Color = Color3.fromRGB(255, 170, 40) },
	{ Rank = 6, Name = "신화", MinOneIn = 100000, Color = Color3.fromRGB(255, 70, 120) },
	{ Rank = 7, Name = "초월", MinOneIn = 1000000, Color = Color3.fromRGB(255, 255, 255) },
} :: { Tier }

local function tierFor(oneIn: number): Tier
	for i = #Auras.Tiers, 1, -1 do
		local tier = Auras.Tiers[i]
		if oneIn >= tier.MinOneIn then
			return tier
		end
	end
	return Auras.Tiers[1]
end

local rgb = Color3.fromRGB

-- stylua: ignore
local DEFINITIONS = {
	{ "common",    "평범",      "Common",     2,         rgb(190, 190, 190) },
	{ "breeze",    "산들바람",  "Breeze",     4,         rgb(170, 235, 220) },
	{ "dew",       "이슬",      "Dew",        8,         rgb(140, 200, 255) },
	{ "ember",     "불씨",      "Ember",      16,        rgb(255, 130, 70) },
	{ "pebble",    "조약돌",    "Pebble",     32,        rgb(160, 140, 120) },
	{ "frost",     "서리",      "Frost",      64,        rgb(170, 225, 255) },
	{ "bloom",     "꽃망울",    "Bloom",      128,       rgb(255, 150, 200) },
	{ "spark",     "섬광",      "Spark",      256,       rgb(255, 240, 90) },
	{ "tide",      "파도",      "Tide",       512,       rgb(40, 130, 255),  { rgb(40, 130, 255), rgb(120, 230, 255) } },
	{ "moonlight", "달빛",      "Moonlight",  1000,      rgb(210, 220, 255), { rgb(160, 170, 255), rgb(250, 250, 255) } },
	{ "sunflare",  "태양 섬광", "Sunflare",   2500,      rgb(255, 190, 60),  { rgb(255, 120, 30), rgb(255, 230, 90) } },
	{ "aurora",    "오로라",    "Aurora",     5000,      rgb(90, 255, 180),  { rgb(60, 255, 160), rgb(90, 140, 255), rgb(200, 90, 255) } },
	{ "crystal",   "수정",      "Crystal",    10000,     rgb(190, 250, 255), { rgb(140, 240, 255), rgb(255, 255, 255), rgb(200, 160, 255) } },
	{ "inferno",   "업화",      "Inferno",    25000,     rgb(255, 80, 30),   { rgb(120, 0, 0), rgb(255, 80, 20), rgb(255, 210, 60) } },
	{ "glacier",   "빙하",      "Glacier",    50000,     rgb(120, 200, 255), { rgb(20, 80, 200), rgb(140, 220, 255), rgb(255, 255, 255) } },
	{ "stardust",  "별가루",    "Stardust",   100000,    rgb(255, 230, 150), { rgb(40, 30, 90), rgb(255, 230, 150), rgb(40, 30, 90) } },
	{ "glitch",    "글리치",    "ERR_404",    404040,    rgb(0, 255, 90),    { rgb(0, 255, 90), rgb(255, 0, 200), rgb(0, 200, 255) } },
	{ "nebula",    "성운",      "Nebula",     250000,    rgb(200, 90, 255),  { rgb(80, 20, 160), rgb(255, 90, 200), rgb(90, 200, 255) } },
	{ "eclipse",   "일식",      "Eclipse",    500000,    rgb(255, 120, 40),  { rgb(10, 10, 10), rgb(255, 120, 40), rgb(10, 10, 10) } },
	{ "celestial", "천상",      "Celestial",  1000000,   rgb(255, 250, 210), { rgb(255, 255, 255), rgb(255, 220, 120), rgb(160, 220, 255) } },
	{ "void",      "공허",      "The Void",   2500000,   rgb(120, 60, 200),  { rgb(0, 0, 0), rgb(120, 60, 200), rgb(0, 0, 0) } },
	{ "genesis",   "창세",      "Genesis",    10000000,  rgb(255, 255, 255), { rgb(255, 80, 80), rgb(255, 230, 80), rgb(80, 255, 140), rgb(80, 160, 255), rgb(220, 90, 255) } },
	{ "infinity",  "무한",      "∞ Infinity", 100000000, rgb(255, 255, 255), { rgb(255, 255, 255), rgb(0, 0, 0), rgb(255, 255, 255) } },
}

Auras.List = {} :: { Aura }
Auras.ById = {} :: { [string]: Aura }

for _, def in DEFINITIONS do
	local oneIn = def[4] :: number
	local aura: Aura = {
		Id = def[1] :: string,
		Name = def[2] :: string,
		Subtitle = def[3] :: string,
		OneIn = oneIn,
		Color = def[5] :: Color3,
		Gradient = def[6] :: { Color3 }?,
		Tier = tierFor(oneIn),
	}
	assert(Auras.ById[aura.Id] == nil, "중복된 오라 Id: " .. aura.Id)
	table.insert(Auras.List, aura)
	Auras.ById[aura.Id] = aura
end

-- 흔한 것 → 희귀한 것 순서(도감 표시용)
table.sort(Auras.List, function(a, b)
	return a.OneIn < b.OneIn
end)

-- 희귀한 것 → 흔한 것 순서(굴림 판정용)
Auras.RarestFirst = table.clone(Auras.List)
table.sort(Auras.RarestFirst, function(a, b)
	return a.OneIn > b.OneIn
end)

Auras.Common = Auras.List[1]
Auras.tierFor = tierFor

return Auras
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--!strict
-- 게임 전체 밸런스/설정 값. 숫자만 바꿔서 난이도를 조절할 수 있습니다.

local Config = {
	-- 굴리기 --------------------------------------------------------------
	ROLL_COOLDOWN = 1.2, -- 굴리기 사이 최소 간격(초). 서버가 강제합니다.
	COOLDOWN_TOLERANCE = 0.15, -- 네트워크 지연을 감안한 허용 오차(초)
	BASE_LUCK = 1,

	-- N번째 굴림마다 행운 보너스 ("행운 굴림")
	LUCKY_ROLL_EVERY = 10,
	LUCKY_ROLL_MULT = 2,

	-- 1/N 이상 희귀한 오라를 뽑으면 서버 전체에 알림
	ANNOUNCE_ONE_IN = 1000,

	-- 굴림 1회당 코인 = ceil(N ^ COIN_EXPONENT)
	COIN_EXPONENT = 0.35,

	-- 저장 ---------------------------------------------------------------
	DATASTORE_NAME = "AuraRNG_v1",
	AUTOSAVE_INTERVAL = 120,

	-- 물약(상점) ------------------------------------------------------------
	-- LuckMult: 행운 배수, CooldownMult: 굴림 간격 배수
	-- 같은 물약을 또 사면 효과는 중첩되지 않고 지속 시간만 늘어납니다(최대 MAX_POTION_SECONDS).
	MAX_POTION_SECONDS = 60 * 60,
	Potions = {
		{
			Id = "Luck",
			Name = "행운 물약",
			Description = "5분 동안 행운 x1.5",
			Price = 300,
			Duration = 300,
			LuckMult = 1.5,
			CooldownMult = 1,
			Color = Color3.fromRGB(90, 220, 120),
		},
		{
			Id = "Speed",
			Name = "신속 물약",
			Description = "5분 동안 굴림 속도 +40%",
			Price = 400,
			Duration = 300,
			LuckMult = 1,
			CooldownMult = 0.6,
			Color = Color3.fromRGB(90, 170, 255),
		},
		{
			Id = "Fortune",
			Name = "대박 물약",
			Description = "3분 동안 행운 x3",
			Price = 2500,
			Duration = 180,
			LuckMult = 3,
			CooldownMult = 1,
			Color = Color3.fromRGB(255, 200, 60),
		},
	},
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Format</string>
          <string name="Source"><![CDATA[--!strict
-- 숫자/시간 표시용 포맷 함수

local Format = {}

-- 1234567 -> "1,234,567"
function Format.commas(n: number): string
	local negative = n < 0
	local digits = tostring(math.floor(math.abs(n)))
	local out = digits:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if out:sub(1, 1) == "," then
		out = out:sub(2)
	end
	return if negative then "-" .. out else out
end

local SUFFIXES = {
	{ 1e12, "T" },
	{ 1e9, "B" },
	{ 1e6, "M" },
	{ 1e3, "K" },
}

-- 2500000 -> "2.5M", 404040 -> "404K". 반올림 대신 버림(999.95K 가 "1000K" 가 되지 않도록).
function Format.short(n: number): string
	for _, entry in SUFFIXES do
		local unit = entry[1] :: number
		if n >= unit then
			local value = n / unit
			local text
			if value >= 100 then
				text = tostring(math.floor(value))
			else
				text = string.format("%.1f", math.floor(value * 10) / 10):gsub("%.0$", "")
			end
			return text .. (entry[2] :: string)
		end
	end
	return Format.commas(n)
end

-- 확률 표기: 1,000,000 미만은 콤마, 이상은 축약 ("1 in 2,500", "1 in 10M")
function Format.oneIn(n: number): string
	if n >= 1e6 then
		return "1 in " .. Format.short(n)
	end
	return "1 in " .. Format.commas(n)
end

-- 1.5 -> "x1.5", 2 -> "x2", 1.25 -> "x1.25"
function Format.multiplier(x: number): string
	local text = string.format("%.2f", x):gsub("0+$", ""):gsub("%.$", "")
	return "x" .. text
end

-- 초 -> "4:05" / "1:02:03"
function Format.duration(seconds: number): string
	local total = math.max(0, math.ceil(seconds))
	local h = total // 3600
	local m = (total % 3600) // 60
	local s = total % 60
	if h > 0 then
		return string.format("%d:%02d:%02d", h, m, s)
	end
	return string.format("%d:%02d", m, s)
end

-- Color3 -> "#rrggbb" (RichText 용)
function Format.hex(color: Color3): string
	return string.format(
		"#%02x%02x%02x",
		math.floor(color.R * 255 + 0.5),
		math.floor(color.G * 255 + 0.5),
		math.floor(color.B * 255 + 0.5)
	)
end

-- RichText 에 넣을 문자열 이스케이프
function Format.escape(text: string): string
	return (text:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"):gsub('"', "&quot;"))
end

return Format
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[-- 원격 통신 객체. 서버가 처음 require 할 때 만들고, 클라이언트는 생길 때까지 기다립니다.
-- (Rojo 없이 Studio 에 직접 복사해도 따로 RemoteEvent 를 만들 필요가 없도록)

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local FOLDER_NAME = "AuraRNGRemotes"

local FUNCTIONS = {
	"GetState", -- () -> Snapshot
	"Roll", -- () -> RollResponse
	"Equip", -- (auraId?) -> { Ok, State }
	"BuyPotion", -- (potionId) -> { Ok, Reason?, State }
	"SetSetting", -- (key, value) -> { Ok, State }
}

local EVENTS = {
	"State", -- 서버 -> 클라: Snapshot (물약 만료 등 서버 쪽 변화)
	"Announce", -- 서버 -> 모두: 희귀 오라 획득 알림
}

local folder: Folder
if RunService:IsServer() then
	folder = Instance.new("Folder")
	folder.Name = FOLDER_NAME
	for _, name in FUNCTIONS do
		local remote = Instance.new("RemoteFunction")
		remote.Name = name
		remote.Parent = folder
	end
	for _, name in EVENTS do
		local remote = Instance.new("RemoteEvent")
		remote.Name = name
		remote.Parent = folder
	end
	folder.Parent = ReplicatedStorage
else
	folder = ReplicatedStorage:WaitForChild(FOLDER_NAME) :: Folder
end

local Net = {}

function Net.fn(name: string): RemoteFunction
	return folder:WaitForChild(name) :: RemoteFunction
end

function Net.event(name: string): RemoteEvent
	return folder:WaitForChild(name) :: RemoteEvent
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">PlayerState</string>
          <string name="Source"><![CDATA[--!strict
-- 플레이어 데이터와 그 데이터를 바꾸는 규칙(순수 함수). 서버가 유일한 진실의 원천이고,
-- 클라이언트는 Snapshot 만 받아서 화면에 그립니다. Roblox 서비스에 의존하지 않아 테스트 가능.

local Auras = require(script.Parent.Auras)
local Config = require(script.Parent.Config)

type Aura = Auras.Aura

export type Settings = {
	AutoEquip: boolean,
}

export type Data = {
	Rolls: number,
	Coins: number,
	Inventory: { [string]: number }, -- 오라 Id -> 보유 개수
	Equipped: string?,
	Potions: { [string]: number }, -- 물약 Id -> 남은 초 (접속 중에만 줄어듦)
	Settings: Settings,
}

export type Snapshot = {
	Revision: number,
	Rolls: number,
	Coins: number,
	Inventory: { [string]: number },
	Equipped: string?,
	Potions: { [string]: number },
	Settings: Settings,
	Luck: number,
	Cooldown: number,
}

export type Potion = typeof(Config.Potions[1])

local PlayerState = {}

PlayerState.PotionsById = {} :: { [string]: Potion }
for _, potion in Config.Potions do
	PlayerState.PotionsById[potion.Id] = potion
end

function PlayerState.new(): Data
	return {
		Rolls = 0,
		Coins = 0,
		Inventory = {},
		Equipped = nil,
		Potions = {},
		Settings = { AutoEquip = true },
	}
end

local function nonNegativeInt(value: any): number?
	if type(value) == "number" and value == value and value >= 0 and value < math.huge then
		return math.floor(value)
	end
	return nil
end

-- DataStore 에서 읽은 값(형식 보장 없음)을 안전한 Data 로 정리합니다.
-- 모르는 오라 Id 의 보유 개수는 지우지 않고 보존합니다(오라를 잠시 뺐다가 다시 넣어도 안전).
function PlayerState.reconcile(raw: any): Data
	local data = PlayerState.new()
	if type(raw) ~= "table" then
		return data
	end

	data.Rolls = nonNegativeInt(raw.Rolls) or 0
	data.Coins = nonNegativeInt(raw.Coins) or 0

	if type(raw.Inventory) == "table" then
		for id, count in raw.Inventory do
			local n = nonNegativeInt(count)
			if type(id) == "string" and n and n > 0 then
				data.Inventory[id] = n
			end
		end
	end

	if type(raw.Equipped) == "string" and Auras.ById[raw.Equipped] and data.Inventory[raw.Equipped] then
		data.Equipped = raw.Equipped
	end

	if type(raw.Potions) == "table" then
		for id, seconds in raw.Potions do
			if type(id) == "string" and PlayerState.PotionsById[id] and type(seconds) == "number" and seconds > 0 then
				data.Potions[id] = math.min(seconds, Config.MAX_POTION_SECONDS)
			end
		end
	end

	if type(raw.Settings) == "table" and type(raw.Settings.AutoEquip) == "boolean" then
		data.Settings.AutoEquip = raw.Settings.AutoEquip
	end

	return data
end

-- 물약 효과를 반영한 현재 행운 (행운 굴림 보너스 제외)
function PlayerState.luck(data: Data): number
	local luck = Config.BASE_LUCK
	for id in data.Potions do
		local potion = PlayerState.PotionsById[id]
		if potion then
			luck *= potion.LuckMult
		end
	end
	return luck
end

-- 굴림 번호(1부터)가 행운 굴림인지
function PlayerState.isLuckyRoll(rollNumber: number): boolean
	return rollNumber % Config.LUCKY_ROLL_EVERY == 0
end

-- 다음 행운 굴림까지 남은 굴림 수 (1 = 바로 다음 굴림)
function PlayerState.rollsUntilLucky(rolls: number): number
	return Config.LUCKY_ROLL_EVERY - (rolls % Config.LUCKY_ROLL_EVERY)
end

-- 이번 굴림에 실제로 적용할 행운과 행운 굴림 여부
function PlayerState.rollLuck(data: Data): (number, boolean)
	local lucky = PlayerState.isLuckyRoll(data.Rolls + 1)
	local luck = PlayerState.luck(data)
	if lucky then
		luck *= Config.LUCKY_ROLL_MULT
	end
	return luck, lucky
end

function PlayerState.cooldown(data: Data): number
	local cooldown = Config.ROLL_COOLDOWN
	for id in data.Potions do
		local potion = PlayerState.PotionsById[id]
		if potion then
			cooldown *= potion.CooldownMult
		end
	end
	return cooldown
end

function PlayerState.coinsFor(aura: Aura): number
	return math.ceil(aura.OneIn ^ Config.COIN_EXPONENT)
end

-- 굴림 결과 반영. 반환: 얻은 코인, 처음 얻은 오라인지
function PlayerState.applyRoll(data: Data, aura: Aura): (number, boolean)
	local owned = data.Inventory[aura.Id] or 0
	data.Inventory[aura.Id] = owned + 1
	data.Rolls += 1
	local coins = PlayerState.coinsFor(aura)
	data.Coins += coins
	return coins, owned == 0
end

-- 가장 희귀한 보유 오라
function PlayerState.best(data: Data): Aura?
	for _, aura in Auras.RarestFirst do
		if (data.Inventory[aura.Id] or 0) > 0 then
			return aura
		end
	end
	return nil
end

-- auraId 가 nil 이면 해제. 보유한 오라만 장착 가능.
function PlayerState.equip(data: Data, auraId: any): boolean
	if auraId == nil then
		data.Equipped = nil
		return true
	end
	if type(auraId) == "string" and Auras.ById[auraId] and (data.Inventory[auraId] or 0) > 0 then
		data.Equipped = auraId
		return true
	end
	return false
end

-- 반환: 성공 여부, 실패 사유(표시용)
function PlayerState.buyPotion(data: Data, potionId: any): (boolean, string?)
	local potion = if type(potionId) == "string" then PlayerState.PotionsById[potionId] else nil
	if not potion then
		return false, "존재하지 않는 물약입니다"
	end
	if data.Coins < potion.Price then
		return false, "코인이 부족합니다"
	end
	local current = data.Potions[potion.Id] or 0
	if current + potion.Duration > Config.MAX_POTION_SECONDS then
		return false, string.format("최대 %d분까지만 쌓을 수 있습니다", Config.MAX_POTION_SECONDS // 60)
	end
	data.Coins -= potion.Price
	data.Potions[potion.Id] = current + potion.Duration
	return true, nil
end

-- 물약 시간 감소. 끝난 물약이 있으면 true.
function PlayerState.tickPotions(data: Data, dt: number): boolean
	local expired = false
	for id, remaining in data.Potions do
		local left = remaining - dt
		if left <= 0 then
			data.Potions[id] = nil
			expired = true
		else
			data.Potions[id] = left
		end
	end
	return expired
end

function PlayerState.setSetting(data: Data, key: any, value: any): boolean
	if key == "AutoEquip" and type(value) == "boolean" then
		data.Settings.AutoEquip = value
		return true
	end
	return false
end

function PlayerState.snapshot(data: Data, revision: number): Snapshot
	return {
		Revision = revision,
		Rolls = data.Rolls,
		Coins = data.Coins,
		Inventory = table.clone(data.Inventory),
		Equipped = data.Equipped,
		Potions = table.clone(data.Potions),
		Settings = table.clone(data.Settings),
		Luck = PlayerState.luck(data),
		Cooldown = PlayerState.cooldown(data),
	}
end

return PlayerState
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">RollLogic</string>
          <string name="Source"><![CDATA[--!strict
-- 굴림 판정 (순수 함수 — 서버/테스트에서 공용)
--
-- 방식: 가장 희귀한 오라부터 차례로 "luck / N" 확률 판정을 하고, 처음 성공한 오라를 줍니다.
-- 모두 실패하면 가장 흔한 오라. 그래서 행운 1 에서 희귀 오라는 거의 정확히 1/N,
-- 행운이 L 배면 희귀 오라 확률도 약 L 배가 됩니다. 행운이 N 이상이면 그보다 흔한 오라는 안 나옵니다.

export type Rollable = { Id: string, OneIn: number }

local RollLogic = {}

-- rarestFirst: OneIn 내림차순 목록. nextNumber: [0, 1) 난수 함수.
function RollLogic.roll<T>(rarestFirst: { T & Rollable }, luck: number, nextNumber: () -> number): T & Rollable
	local count = #rarestFirst
	for i = 1, count - 1 do
		local aura = rarestFirst[i]
		-- nextNumber() < luck / OneIn 과 같지만 나눗셈 오차가 없음
		if nextNumber() * aura.OneIn < luck then
			return aura
		end
	end
	return rarestFirst[count]
end

-- 주어진 행운에서 각 오라가 실제로 나올 확률 { [Id] = p } (합계 1)
function RollLogic.probabilities(rarestFirst: { Rollable }, luck: number): { [string]: number }
	local result = {}
	local remaining = 1
	local count = #rarestFirst
	for i = 1, count - 1 do
		local aura = rarestFirst[i]
		local p = math.min(1, luck / aura.OneIn)
		result[aura.Id] = remaining * p
		remaining *= 1 - p
	end
	result[rarestFirst[count].Id] = remaining
	return result
end

return RollLogic
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="11">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="12">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- 서버 진입점: 플레이어 데이터 관리, 굴림 판정(서버 권위), 상점, 알림

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Auras = require(Shared.Auras)
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Net = require(Shared.Net)
local PlayerState = require(Shared.PlayerState)
local RollLogic = require(Shared.RollLogic)

local AuraDisplay = require(script.AuraDisplay)
local DataService = require(script.DataService)

-- 에픽 이상 결과는 굴린 사람의 연출(최대 약 4초)이 끝난 뒤에 알림/리더보드에 반영
-- (굴린 본인의 클라이언트는 연출이 끝날 때까지 자기 알림을 따로 보류함)
local REVEAL_GRACE = 4.5

type Session = {
	Data: PlayerState.Data,
	LockId: string?, -- nil 이면 저장하지 않음(Studio 등)
	LastRoll: number,
	Revision: number,
	Stats: { Rolls: IntValue, Best: StringValue },
}

local sessions: { [Player]: Session } = {}
local rng = Random.new()

local function nextNumber(): number
	return rng:NextNumber()
end

local function snapshot(session: Session): PlayerState.Snapshot
	session.Revision += 1
	return PlayerState.snapshot(session.Data, session.Revision)
end

local function pushState(player: Player)
	local session = sessions[player]
	if session then
		Net.event("State"):FireClient(player, snapshot(session))
	end
end

local function updateStats(session: Session)
	session.Stats.Rolls.Value = session.Data.Rolls
	local best = PlayerState.best(session.Data)
	session.Stats.Best.Value = if best then best.Name else "-"
end

local function refreshAura(player: Player)
	local session = sessions[player]
	local aura = if session and session.Data.Equipped then Auras.ById[session.Data.Equipped] else nil
	AuraDisplay.apply(player.Character, aura)
end

local function createLeaderstats(player: Player): { Rolls: IntValue, Best: StringValue }
	local folder = Instance.new("Folder")
	folder.Name = "leaderstats"
	local rolls = Instance.new("IntValue")
	rolls.Name = "굴림"
	rolls.Parent = folder
	local best = Instance.new("StringValue")
	best.Name = "최고"
	best.Value = "-"
	best.Parent = folder
	folder.Parent = player
	return { Rolls = rolls, Best = best }
end

local function onCharacter(player: Player, character: Model)
	-- 머리/몸통이 생길 때까지 기다린 뒤 효과를 붙임
	character:WaitForChild("Head", 10)
	character:WaitForChild("HumanoidRootPart", 10)
	if player.Character == character then
		refreshAura(player)
	end
end

-- BindToClose 가 진행 중인 저장을 기다릴 수 있도록 개수를 셈
local savesInFlight = 0

local function trackedSave(player: Player, data: PlayerState.Data, lockId: string, release: boolean)
	savesInFlight += 1
	DataService.save(player, data, lockId, release)
	savesInFlight -= 1
end

local function onPlayerAdded(player: Player)
	local data, lockId = DataService.load(player)
	if player.Parent == nil then
		-- 불러오는 동안 나감: 방금 건 세션 잠금을 풀어 둬야 다음 접속이 기다리지 않음
		if data and lockId then
			trackedSave(player, data, lockId, true)
		end
		return
	end
	if not data then
		player:Kick("데이터를 불러오지 못했습니다. 잠시 후 다시 접속해 주세요.")
		return
	end

	local session: Session = {
		Data = data,
		LockId = lockId,
		LastRoll = -math.huge,
		Revision = 0,
		Stats = createLeaderstats(player),
	}
	sessions[player] = session
	updateStats(session)

	player.CharacterAdded:Connect(function(character)
		onCharacter(player, character)
	end)
	-- 일부 아바타(다이나믹 헤드 등)는 외형 로딩 중 머리를 교체하므로 로딩이 끝난 뒤 한 번 더 붙임
	player.CharacterAppearanceLoaded:Connect(function(character)
		if player.Character == character then
			refreshAura(player)
		end
	end)
	if player.Character then
		task.spawn(onCharacter, player, player.Character)
	end
	pushState(player)
end

local function saveAndRelease(player: Player)
	local session = sessions[player]
	if not session then
		return
	end
	sessions[player] = nil
	if session.LockId then
		trackedSave(player, session.Data, session.LockId, true)
	end
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(saveAndRelease)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

-- 서버 종료 시 남은 플레이어를 병렬로 저장하고, 퇴장 처리 중인 저장까지 끝나길 기다림(최대 약 25초)
game:BindToClose(function()
	for player in sessions do
		task.spawn(saveAndRelease, player)
	end
	local deadline = os.clock() + 25
	while savesInFlight > 0 and os.clock() < deadline do
		task.wait(0.1)
	end
end)

-- 자동 저장
task.spawn(function()
	while true do
		task.wait(Config.AUTOSAVE_INTERVAL)
		for player, session in sessions do
			if session.LockId then
				task.spawn(DataService.save, player, session.Data, session.LockId, false)
			end
		end
	end
end)

-- 물약 시간 감소 (접속 중에만)
task.spawn(function()
	while true do
		local dt = task.wait(1)
		for player, session in sessions do
			if PlayerState.tickPotions(session.Data, dt) then
				pushState(player)
			end
		end
	end
end)

local function announce(player: Player, aura: Auras.Aura, rollNumber: number)
	Net.event("Announce"):FireAllClients({
		UserId = player.UserId,
		Name = player.DisplayName,
		AuraId = aura.Id,
		Rolls = rollNumber,
	})
	print(
		string.format(
			"[AuraRNG] %s 님이 %s (%s) 획득 — %d번째 굴림",
			player.Name,
			aura.Name,
			Format.oneIn(aura.OneIn),
			rollNumber
		)
	)
end

-- 원격 함수 --------------------------------------------------------------

Net.fn("GetState").OnServerInvoke = function(player: Player)
	-- 클라이언트가 데이터 로드보다 먼저 시작할 수 있으므로 최대 30초 대기
	local deadline = os.clock() + 30
	while not sessions[player] and player.Parent and os.clock() < deadline do
		task.wait(0.2)
	end
	local session = sessions[player]
	return if session then snapshot(session) else nil
end

Net.fn("Roll").OnServerInvoke = function(player: Player)
	local session = sessions[player]
	if not session then
		return { Ok = false, Reason = "loading" }
	end

	-- 쿨타임: 허용 오차만큼 일찍 와도 받아주되, 기준 시각은 "원래 가능했던 시각"으로 밀어서
	-- 오차를 반복 악용해도 평균 속도가 빨라지지 않게 합니다.
	local now = time()
	local cooldown = PlayerState.cooldown(session.Data)
	local readyAt = session.LastRoll + cooldown
	if now < readyAt - Config.COOLDOWN_TOLERANCE then
		return { Ok = false, Reason = "cooldown", RetryIn = readyAt - now }
	end
	session.LastRoll = math.max(now, readyAt)

	local luck, lucky = PlayerState.rollLuck(session.Data)
	local aura = RollLogic.roll(Auras.RarestFirst, luck, nextNumber)
	local coins, isNew = PlayerState.applyRoll(session.Data, aura)

	-- 에픽 이상은 연출이 끝난 뒤에 리더보드("최고")를 바꿔야 Tab 목록으로 결과가 미리 새지 않음
	if aura.Tier.Rank >= 4 then
		task.delay(REVEAL_GRACE, updateStats, session)
	else
		updateStats(session)
	end
	if aura.OneIn >= Config.ANNOUNCE_ONE_IN then
		task.delay(REVEAL_GRACE, announce, player, aura, session.Data.Rolls)
	end

	return {
		Ok = true,
		AuraId = aura.Id,
		Luck = luck,
		Lucky = lucky,
		Coins = coins,
		IsNew = isNew,
		State = snapshot(session),
	}
end

Net.fn("Equip").OnServerInvoke = function(player: Player, auraId: any)
	local session = sessions[player]
	if not session then
		return { Ok = false }
	end
	local ok = PlayerState.equip(session.Data, auraId)
	if ok then
		refreshAura(player)
	end
	return { Ok = ok, State = snapshot(session) }
end

Net.fn("BuyPotion").OnServerInvoke = function(player: Player, potionId: any)
	local session = sessions[player]
	if not session then
		return { Ok = false, Reason = "데이터를 불러오는 중입니다" }
	end
	local ok, reason = PlayerState.buyPotion(session.Data, potionId)
	return { Ok = ok, Reason = reason, State = snapshot(session) }
end

Net.fn("SetSetting").OnServerInvoke = function(player: Player, key: any, value: any)
	local session = sessions[player]
	if not session then
		return { Ok = false }
	end
	local ok = PlayerState.setSetting(session.Data, key, value)
	return { Ok = ok, State = snapshot(session) }
end
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">AuraDisplay</string>
          <string name="Source"><![CDATA[-- 장착한 오라를 캐릭터에 표시: 머리 위 이름표 + 등급에 따른 파티클/빛
-- 그라데이션 회전 애니메이션은 클라이언트가 "AuraGradient" 태그를 보고 처리합니다(서버 복제 부담 없음).

local CollectionService = game:GetService("CollectionService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Auras = require(Shared.Auras)
local Format = require(Shared.Format)

local FX_NAME = "AuraFX"

local AuraDisplay = {}

local function colorSequence(colors: { Color3 }): ColorSequence
	if #colors == 1 then
		return ColorSequence.new(colors[1])
	end
	local keypoints = {}
	for i, color in colors do
		table.insert(keypoints, ColorSequenceKeypoint.new((i - 1) / (#colors - 1), color))
	end
	return ColorSequence.new(keypoints)
end

local function auraColors(aura: Auras.Aura): { Color3 }
	return aura.Gradient or { aura.Color }
end

local function clear(character: Model)
	for _, descendant in character:GetDescendants() do
		if descendant.Name == FX_NAME then
			descendant:Destroy()
		end
	end
end

local function makeLabel(parent: Instance, text: string, size: UDim2, position: UDim2, aura: Auras.Aura): TextLabel
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = size
	label.Position = position
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.Text = text
	label.TextColor3 = if aura.Gradient then Color3.new(1, 1, 1) else aura.Color
	label.Parent = parent

	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Transparency = 0.2
	stroke.Color = Color3.new(0, 0, 0)
	stroke.Parent = label

	if aura.Gradient then
		local gradient = Instance.new("UIGradient")
		gradient.Color = colorSequence(aura.Gradient)
		gradient.Parent = label
		CollectionService:AddTag(gradient, "AuraGradient")
	end
	return label
end

local function addBillboard(character: Model, aura: Auras.Aura)
	local head = character:FindFirstChild("Head")
	if not head or not head:IsA("BasePart") then
		return
	end
	local billboard = Instance.new("BillboardGui")
	billboard.Name = FX_NAME
	billboard.Adornee = head
	billboard.Size = UDim2.new(7, 0, 1.8, 0)
	billboard.StudsOffset = Vector3.new(0, 2.6, 0)
	billboard.MaxDistance = 120
	billboard.LightInfluence = 0

	makeLabel(billboard, aura.Name, UDim2.fromScale(1, 0.62), UDim2.fromScale(0, 0), aura)
	makeLabel(
		billboard,
		Format.oneIn(aura.OneIn) .. " · " .. aura.Tier.Name,
		UDim2.fromScale(1, 0.34),
		UDim2.fromScale(0, 0.64),
		aura
	)
	billboard.Parent = head
end

local function addParticles(character: Model, aura: Auras.Aura)
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then
		return
	end
	local rank = aura.Tier.Rank
	if rank < 3 then
		return -- 일반/고급 등급은 이름표만
	end

	local attachment = Instance.new("Attachment")
	attachment.Name = FX_NAME
	attachment.Parent = root

	local sparkles = Instance.new("ParticleEmitter")
	sparkles.Color = colorSequence(auraColors(aura))
	sparkles.LightEmission = 1
	sparkles.LightInfluence = 0
	sparkles.Lifetime = NumberRange.new(1, 1.8)
	sparkles.Rate = 6 * rank
	sparkles.Speed = NumberRange.new(1, 2 + rank * 0.5)
	sparkles.SpreadAngle = Vector2.new(180, 180)
	sparkles.Rotation = NumberRange.new(0, 360)
	sparkles.RotSpeed = NumberRange.new(-90, 90)
	sparkles.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.2, 0.25 + rank * 0.05),
		NumberSequenceKeypoint.new(1, 0),
	})
	sparkles.Acceleration = Vector3.new(0, 1.5, 0)
	sparkles.Parent = attachment

	if rank >= 4 then
		local light = Instance.new("PointLight")
		light.Name = FX_NAME
		light.Color = aura.Color
		light.Range = 6 + rank * 2
		light.Brightness = 1.5
		light.Parent = root
	end

	if rank >= 6 then
		-- 신화/초월: 발밑에서 올라오는 두 번째 파티클 기둥
		local pillar = Instance.new("ParticleEmitter")
		pillar.Color = sparkles.Color
		pillar.LightEmission = 1
		pillar.LightInfluence = 0
		pillar.Lifetime = NumberRange.new(1.2, 2)
		pillar.Rate = 30
		pillar.Speed = NumberRange.new(4, 7)
		pillar.EmissionDirection = Enum.NormalId.Top
		pillar.SpreadAngle = Vector2.new(8, 8)
		pillar.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.6),
			NumberSequenceKeypoint.new(1, 0),
		})
		pillar.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.2),
			NumberSequenceKeypoint.new(1, 1),
		})
		pillar.Parent = attachment
	end
end

-- aura 가 nil 이면 효과 제거만
function AuraDisplay.apply(character: Model?, aura: Auras.Aura?)
	if not character then
		return
	end
	clear(character)
	if aura then
		addBillboard(character, aura)
		addParticles(character, aura)
	end
end

return AuraDisplay
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[-- DataStore 저장/불러오기 + 세션 잠금
--
-- 저장 형식: { Data = PlayerState.Data, Lock = { Id, JobId, Time }? }
-- 세션 잠금: 불러올 때마다 새 잠금 Id 를 발급하고, 저장은 그 Id 가 기록에 그대로 있을 때만 합니다.
--   · 이전 세션(다른 서버든 같은 서버 재접속이든)이 아직 저장 중이면 잠시 기다렸다가 불러옴
--   · 퇴장 저장으로 잠금이 풀린 뒤 늦게 도착한 자동 저장은 무시됨(잠금을 다시 걸지 않음)
--   · 잠금이 만료되어 다른 세션이 가져갔으면 그쪽 데이터를 덮어쓰지 않음

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local PlayerState = require(Shared.PlayerState)

local LOCK_EXPIRE_SECONDS = Config.AUTOSAVE_INTERVAL * 3
local LOAD_ATTEMPTS = 6
local SAVE_ATTEMPTS = 3

local DataService = {}

local store: DataStore? = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DATASTORE_NAME)
	end)
	if ok then
		store = result
	else
		warn("[DataService] DataStore 를 열 수 없습니다: " .. tostring(result))
	end
end

local function keyFor(player: Player): string
	return "player_" .. player.UserId
end

local function newLock(lockId: string)
	return { Id = lockId, JobId = game.JobId, Time = os.time() }
end

-- 반환: data(실패 시 nil), lockId(nil 이면 저장하지 않음)
-- Studio 에서 API 접근이 꺼져 있으면 새 데이터로 플레이만 하고 저장은 하지 않습니다.
function DataService.load(player: Player): (PlayerState.Data?, string?)
	if not store then
		if RunService:IsStudio() then
			return PlayerState.new(), nil
		end
		return nil, nil
	end

	local lockId = HttpService:GenerateGUID(false)
	for attempt = 1, LOAD_ATTEMPTS do
		local steal = attempt == LOAD_ATTEMPTS
		local blocked = false
		local loaded: any = nil

		local ok, err = pcall(function()
			store:UpdateAsync(keyFor(player), function(record)
				-- UpdateAsync 는 충돌 시 이 함수를 다시 부를 수 있으므로 결과 변수는 매번 초기화
				blocked = false
				loaded = nil
				record = if type(record) == "table" then record else {}
				local lock = record.Lock
				if
					not steal
					and type(lock) == "table"
					and lock.Id ~= lockId
					and os.time() - (tonumber(lock.Time) or 0) < LOCK_EXPIRE_SECONDS
				then
					blocked = true
					return nil -- 쓰기 취소
				end
				loaded = record.Data
				record.Lock = newLock(lockId)
				return record
			end)
		end)

		if ok and not blocked then
			return PlayerState.reconcile(loaded), lockId
		end
		if not ok then
			warn(
				string.format(
					"[DataService] %s 불러오기 실패(%d/%d): %s",
					player.Name,
					attempt,
					LOAD_ATTEMPTS,
					tostring(err)
				)
			)
			if RunService:IsStudio() then
				-- 게시 안 된 place 이거나 API 접근이 꺼진 경우: 테스트는 되도록 저장 없이 진행
				warn(
					"[DataService] Studio 에서는 저장 없이 진행합니다. 저장까지 테스트하려면 게임을 게시하고 "
						.. "Game Settings > Security > 'Enable Studio Access to API Services' 를 켜세요."
				)
				return PlayerState.new(), nil
			end
		end
		if player.Parent == nil then
			return nil, nil
		end
		task.wait(if blocked then 5 else attempt * 1.5)
	end
	return nil, nil
end

-- lockId: load 가 돌려준 값. release=true 면 잠금을 풀어 다음 세션이 바로 불러갈 수 있게 합니다(퇴장 시).
function DataService.save(player: Player, data: PlayerState.Data, lockId: string, release: boolean): boolean
	if not store then
		return false
	end
	for attempt = 1, SAVE_ATTEMPTS do
		local stale = false
		local ok, err = pcall(function()
			store:UpdateAsync(keyFor(player), function(record)
				stale = false
				record = if type(record) == "table" then record else {}
				local lock = record.Lock
				if type(lock) ~= "table" or lock.Id ~= lockId then
					-- 이미 풀린 잠금(퇴장 저장 완료)이거나 다른 세션이 가져간 경우: 덮어쓰지 않음
					stale = true
					return nil
				end
				record.Data = data
				record.Lock = if release then nil else newLock(lockId)
				return record
			end)
		end)
		if ok then
			if stale then
				warn(
					"[DataService] "
						.. player.Name
						.. " 의 세션이 이미 끝났거나 다른 세션이 데이터를 사용 중이라 저장을 건너뜁니다."
				)
				return false
			end
			return true
		end
		warn(
			string.format(
				"[DataService] %s 저장 실패(%d/%d): %s",
				player.Name,
				attempt,
				SAVE_ATTEMPTS,
				tostring(err)
			)
		)
		if attempt < SAVE_ATTEMPTS then
			task.wait(attempt * 2)
		end
	end
	return false
end

return DataService
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="15">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="16">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="17">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[-- 클라이언트 진입점: 상태 동기화, 굴리기/자동 굴리기, 메뉴 연결, 알림

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TextChatService = game:GetService("TextChatService")
local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Auras = require(Shared.Auras)
local Format = require(Shared.Format)
local Net = require(Shared.Net)

local Hud = require(script.Hud)
local Panels = require(script.Panels)
local Ui = require(script.Ui)

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local state = nil -- 서버에서 받은 최신 Snapshot
local stateReceivedAt = 0
local rolling = false
local revealing = false
local autoRoll = false
local lastRollSentAt = -math.huge
local heldAnnouncements = {} -- 내 굴림 연출 중에 도착한 "내" 알림 (연출이 끝나면 표시)

-- 서버 상태 반영. Revision 이 더 큰 것만 받아서 늦게 도착한 옛 상태가 덮어쓰지 않게 함.
-- receivedAt: 스냅샷을 실제로 받은 시각(물약 남은 시간 계산 기준). 늦게 반영할 때 넘겨줌.
local function applyState(snapshot: any, receivedAt: number?)
	if type(snapshot) ~= "table" then
		return
	end
	if state and snapshot.Revision <= state.Revision then
		return
	end
	state = snapshot
	stateReceivedAt = receivedAt or time()
	Hud.render(state)
	Panels.render(state)
end

local function invoke(name: string, ...: any): any
	local ok, result = pcall(Net.fn(name).InvokeServer, Net.fn(name), ...)
	if not ok then
		warn("[AuraRNG] " .. name .. " 실패: " .. tostring(result))
		Hud.toast("서버와 통신하지 못했어요. 잠시 후 다시 시도해 주세요.", Ui.Theme.Bad)
		return nil
	end
	return result
end

local function equip(auraId: string?)
	local response = invoke("Equip", auraId)
	if response then
		applyState(response.State)
		if response.Ok and auraId then
			local aura = Auras.ById[auraId]
			Hud.toast(aura.Name .. " 장착!", aura.Color, 2)
		end
	end
end

local function showAnnouncement(info: any, aura: any)
	Hud.banner(tostring(info.Name), aura, tonumber(info.Rolls) or 0)

	-- 채팅창에도 시스템 메시지 (새 TextChatService 를 쓰는 경우)
	pcall(function()
		local channels = TextChatService:FindFirstChild("TextChannels")
		local general = channels and channels:FindFirstChild("RBXGeneral")
		if general then
			general:DisplaySystemMessage(
				string.format(
					'[AuraRNG] %s 님이 <font color="%s"><b>%s</b></font> (%s) 획득!',
					Format.escape(tostring(info.Name)),
					Format.hex(aura.Color),
					aura.Name,
					Format.oneIn(aura.OneIn)
				)
			)
		end
	end)
end

local function roll()
	if rolling or not state then
		return
	end
	rolling = true
	Hud.setRolling(true)

	-- 쿨타임이 남았으면 기다렸다가 요청
	local waitFor = lastRollSentAt + state.Cooldown - time()
	if waitFor > 0 then
		task.wait(waitFor)
	end
	lastRollSentAt = time()
	local response = invoke("Roll")
	local receivedAt = time()

	if response and response.Ok then
		Hud.startCooldown(response.State.Cooldown)
		local aura = Auras.ById[response.AuraId]
		revealing = true
		Hud.reveal(aura, {
			Fast = autoRoll,
			Lucky = response.Lucky,
			IsNew = response.IsNew,
			Coins = response.Coins,
			Luck = response.Luck,
		})
		revealing = false
		applyState(response.State, receivedAt) -- 연출이 끝난 뒤에 숫자 갱신(스포일러 방지)
		for _, held in heldAnnouncements do
			showAnnouncement(held.Info, held.Aura)
		end
		table.clear(heldAnnouncements)

		-- 더 희귀하면 자동 장착
		if state.Settings.AutoEquip then
			local current = if state.Equipped then Auras.ById[state.Equipped] else nil
			if not current or aura.OneIn > current.OneIn then
				equip(aura.Id)
			end
		end
	elseif response and response.Reason == "cooldown" then
		task.wait(response.RetryIn or 0.2)
		lastRollSentAt = -math.huge -- 이미 RetryIn 만큼 기다렸으니 다음 요청에서 또 기다리지 않음
	else
		task.wait(1) -- 데이터 불러오는 중이거나 통신 실패: 자동 굴리기가 요청을 퍼붓지 않게
	end

	rolling = false
	Hud.setRolling(false)
end

local function toggleAuto()
	autoRoll = not autoRoll
	Hud.setAuto(autoRoll)
	if autoRoll and not rolling then
		task.spawn(roll)
	end
end

local function buy(potionId: string)
	local response = invoke("BuyPotion", potionId)
	if not response then
		return
	end
	applyState(response.State)
	if response.Ok then
		Hud.toast("구매 완료!", Ui.Theme.Good, 2)
	else
		Hud.toast(response.Reason or "구매하지 못했어요", Ui.Theme.Bad, 2)
	end
end

local function toggleAutoEquip()
	if not state then
		return
	end
	local response = invoke("SetSetting", "AutoEquip", not state.Settings.AutoEquip)
	if response then
		applyState(response.State)
	end
end

-- 화면 만들기 ---------------------------------------------------------------

local gui = Hud.init(playerGui, {
	Roll = function()
		task.spawn(roll)
	end,
	ToggleAuto = toggleAuto,
	Menu = Panels.toggle,
})
Panels.init(gui, {
	Equip = equip,
	Buy = buy,
	ToggleAutoEquip = toggleAutoEquip,
})

-- 키보드: R = 굴리기, T = 자동 굴리기
UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if input.KeyCode == Enum.KeyCode.R then
		task.spawn(roll)
	elseif input.KeyCode == Enum.KeyCode.T then
		toggleAuto()
	end
end)

-- 서버 이벤트 ---------------------------------------------------------------

Net.event("State").OnClientEvent:Connect(applyState)

Net.event("Announce").OnClientEvent:Connect(function(info)
	local aura = type(info) == "table" and Auras.ById[info.AuraId]
	if not aura then
		return
	end
	-- 내가 뽑은 알림이 내 연출보다 먼저 오면 결과가 미리 보이므로 연출이 끝날 때까지 보류
	if info.UserId == player.UserId and revealing then
		table.insert(heldAnnouncements, { Info = info, Aura = aura })
		return
	end
	showAnnouncement(info, aura)
end)

-- 루프 ---------------------------------------------------------------------

-- 그라데이션 오라 이름표 회전 애니메이션 (서버/클라가 붙인 "AuraGradient" 태그 대상)
RunService.RenderStepped:Connect(function()
	local rotation = (os.clock() * 90) % 360
	for _, gradient in CollectionService:GetTagged("AuraGradient") do
		if gradient:IsA("UIGradient") then
			gradient.Rotation = rotation
		end
	end
end)

-- 물약 타이머 표시
task.spawn(function()
	while true do
		Hud.updateTimers(state, time() - stateReceivedAt)
		task.wait(0.25)
	end
end)

-- 자동 굴리기
task.spawn(function()
	while true do
		if autoRoll and not rolling then
			roll()
		end
		task.wait(0.05)
	end
end)

-- 처음 상태 받아오기 (서버 데이터 로드가 끝날 때까지 서버 쪽에서 기다려 줌)
applyState(invoke("GetState"))
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">Hud</string>
            <string name="Source"><![CDATA[-- 기본 화면(HUD): 스탯, 물약 타이머, 메뉴 버튼, 굴리기 버튼, 굴림 연출, 알림

local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Auras = require(Shared.Auras)
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local PlayerState = require(Shared.PlayerState)
local RollLogic = require(Shared.RollLogic)

local Ui = require(script.Parent.Ui)
local Theme = Ui.Theme

-- 등급(Rank)별 굴림 연출 길이(초). 빠른 모드(자동 굴림)에서는 에픽 미만만 절반으로 줄임.
local REVEAL_SECONDS = { 0.8, 1.0, 1.4, 2.0, 2.6, 3.0, 3.0 }
local FAKE_SPIN_LUCK = 25 -- 돌아가는 동안 보여줄 가짜 결과는 조금 더 화려하게
local TICK_SOUND = "rbxasset://sounds/electronicpingshort.wav"

local Hud = {}

local gui: ScreenGui
local flashFrame: Frame
local refs: { [string]: any } = {}
local spinRandom = Random.new()
local hideToken = 0

local function makeSound(pitch: number, volume: number): Sound
	return Ui.new("Sound", {
		SoundId = TICK_SOUND,
		PlaybackSpeed = pitch,
		Volume = volume,
		Parent = SoundService,
	})
end

local tickSound: Sound
local revealSound: Sound
local rareSound: Sound

local function play(sound: Sound)
	if sound then
		sound.TimePosition = 0
		sound:Play()
	end
end

local function panel(props: { [string]: any }): Frame
	local frame = Ui.new("Frame", {
		BackgroundColor3 = Theme.Panel,
		BackgroundTransparency = 0.15,
	})
	for key, value in props do
		if key ~= "Parent" then
			(frame :: any)[key] = value
		end
	end
	Ui.corner(14).Parent = frame
	Ui.stroke().Parent = frame
	frame.Parent = props.Parent
	return frame
end

-- 화면 구석에 붙는 투명 컨테이너(화면 크기에 따라 자동 스케일)
local function anchor(name: string, anchorPoint: Vector2, position: UDim2, size: UDim2): Frame
	local frame = Ui.new("Frame", {
		Name = name,
		AnchorPoint = anchorPoint,
		Position = position,
		Size = size,
		BackgroundTransparency = 1,
		Parent = gui,
	})
	Ui.autoScale(frame)
	return frame
end

local function buildStats()
	local container = anchor("Stats", Vector2.new(0, 0), UDim2.new(0, 12, 0, 12), UDim2.fromOffset(250, 118))
	local box = panel({ Size = UDim2.fromScale(1, 1), Parent = container })
	Ui.padding(10).Parent = box
	Ui.list(Enum.FillDirection.Vertical, 4).Parent = box

	local function row(order: number, color: Color3): TextLabel
		return Ui.label({
			LayoutOrder = order,
			Size = UDim2.new(1, 0, 0, 30),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = color,
			Parent = box,
		}, 24)
	end
	refs.Coins = row(1, Theme.Gold)
	refs.Rolls = row(2, Theme.Text)
	refs.Luck = row(3, Theme.Good)
end

local function buildPotions()
	local container = anchor("Potions", Vector2.new(1, 0), UDim2.new(1, -12, 0, 12), UDim2.fromOffset(230, 200))
	local layout = Ui.list(Enum.FillDirection.Vertical, 6, Enum.HorizontalAlignment.Right)
	layout.VerticalAlignment = Enum.VerticalAlignment.Top
	layout.Parent = container
	refs.PotionList = container
	refs.PotionRows = {}
end

local function buildMenu(onMenu: (string) -> ())
	local container = anchor("Menu", Vector2.new(0, 0.5), UDim2.new(0, 12, 0.5, 0), UDim2.fromOffset(120, 230))
	Ui.list(Enum.FillDirection.Vertical, 10).Parent = container
	for order, entry in { { "Inventory", "🎒 가방" }, { "Index", "📖 도감" }, { "Shop", "🛒 상점" } } do
		local button = Ui.button({
			Name = entry[1],
			LayoutOrder = order,
			Size = UDim2.fromOffset(120, 64),
			Text = entry[2],
			Parent = container,
		}, 22)
		button.Activated:Connect(function()
			onMenu(entry[1])
		end)
	end
end

local function buildRollBar(onRoll: () -> (), onToggleAuto: () -> ())
	local container = anchor("RollBar", Vector2.new(0.5, 1), UDim2.new(0.5, 0, 1, -18), UDim2.fromOffset(420, 120))

	refs.LuckyInfo = Ui.label({
		Size = UDim2.new(1, 0, 0, 30),
		TextColor3 = Theme.SubText,
		Parent = container,
	}, 22)

	local row = Ui.new("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 40),
		Size = UDim2.new(1, 0, 0, 76),
		Parent = container,
	})
	Ui.list(Enum.FillDirection.Horizontal, 12, Enum.HorizontalAlignment.Center).Parent = row

	refs.AutoButton = Ui.button({
		LayoutOrder = 1,
		Size = UDim2.fromOffset(130, 76),
		Text = "자동: 끔",
		Parent = row,
	}, 22)
	refs.AutoButton.Activated:Connect(onToggleAuto)

	local rollButton = Ui.button({
		LayoutOrder = 2,
		Size = UDim2.fromOffset(240, 76),
		BackgroundColor3 = Theme.Accent,
		Text = "🎲 굴리기",
		ClipsDescendants = true,
		Parent = row,
	}, 32)
	rollButton.Activated:Connect(onRoll)
	refs.RollButton = rollButton

	-- 쿨타임 막대 (버튼 아래쪽)
	local bar = Ui.new("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, -6, 1, 6),
		Size = UDim2.new(0, 0, 0, 6),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.3,
		BorderSizePixel = 0,
		Parent = rollButton,
	})
	refs.CooldownBar = bar
end

-- 글자 테두리 (UIStroke 기본값 Contextual = 글자에 적용)
local function textOutline(label: TextLabel, thickness: number)
	Ui.new("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = thickness, Transparency = 0.2, Parent = label })
end

local function buildReveal()
	local container = anchor("Reveal", Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.42), UDim2.fromOffset(760, 230))
	container.Visible = false
	refs.Reveal = container

	local inner = Ui.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = container,
	})
	refs.RevealScale = Ui.new("UIScale", { Parent = inner })

	refs.RevealTag = Ui.label({
		Size = UDim2.new(1, 0, 0, 34),
		TextColor3 = Theme.Gold,
		Parent = inner,
	}, 28)
	refs.RevealName = Ui.label({
		Position = UDim2.fromOffset(0, 36),
		Size = UDim2.new(1, 0, 0, 110),
		Font = Theme.FontHeavy,
		Parent = inner,
	}, 96)
	textOutline(refs.RevealName, 3)
	refs.RevealSub = Ui.label({
		Position = UDim2.fromOffset(0, 148),
		Size = UDim2.new(1, 0, 0, 40),
		Parent = inner,
	}, 32)
	textOutline(refs.RevealSub, 2)
	refs.RevealReward = Ui.label({
		Position = UDim2.fromOffset(0, 192),
		Size = UDim2.new(1, 0, 0, 32),
		TextColor3 = Theme.Gold,
		Parent = inner,
	}, 26)
end

local function buildNotices()
	local container = anchor("Notices", Vector2.new(0.5, 0), UDim2.new(0.5, 0, 0, 12), UDim2.fromOffset(680, 220))
	local layout = Ui.list(Enum.FillDirection.Vertical, 6, Enum.HorizontalAlignment.Center)
	layout.VerticalAlignment = Enum.VerticalAlignment.Top
	layout.Parent = container
	refs.Notices = container
end

function Hud.init(playerGui: PlayerGui, handlers: { Roll: () -> (), ToggleAuto: () -> (), Menu: (string) -> () })
	gui = Ui.new("ScreenGui", {
		Name = "AuraRNG",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = playerGui,
	})
	local flashGui = Ui.new("ScreenGui", {
		Name = "AuraRNGFlash",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 5,
		Parent = playerGui,
	})
	flashFrame = Ui.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Parent = flashGui,
	})

	tickSound = makeSound(1.4, 0.25)
	revealSound = makeSound(0.9, 0.6)
	rareSound = makeSound(0.5, 1)

	buildStats()
	buildPotions()
	buildMenu(handlers.Menu)
	buildRollBar(handlers.Roll, handlers.ToggleAuto)
	buildReveal()
	buildNotices()
	Hud.render(nil)
	return gui
end

function Hud.render(state: PlayerState.Snapshot?)
	if not state then
		refs.Coins.Text = "🪙 불러오는 중..."
		refs.Rolls.Text = ""
		refs.Luck.Text = ""
		refs.LuckyInfo.Text = ""
		return
	end
	refs.Coins.Text = "🪙 " .. Format.commas(state.Coins)
	refs.Rolls.Text = "🎲 굴림 " .. Format.commas(state.Rolls) .. "회"
	refs.Luck.Text = "🍀 행운 " .. Format.multiplier(state.Luck)

	local untilLucky = PlayerState.rollsUntilLucky(state.Rolls)
	if untilLucky == 1 then
		refs.LuckyInfo.Text = string.format("✨ 다음 굴림은 행운 굴림! (행운 x%d)", Config.LUCKY_ROLL_MULT)
		refs.LuckyInfo.TextColor3 = Theme.Gold
	else
		refs.LuckyInfo.Text =
			string.format("행운 굴림까지 %d회 · [R] 키로도 굴릴 수 있어요", untilLucky)
		refs.LuckyInfo.TextColor3 = Theme.SubText
	end

	-- 물약 줄: 활성 물약이 바뀌었을 때만 다시 만듦
	local rows = refs.PotionRows
	for id, row in rows do
		if not state.Potions[id] then
			row.Frame:Destroy()
			rows[id] = nil
		end
	end
	for order, potion in Config.Potions do
		if state.Potions[potion.Id] and not rows[potion.Id] then
			local row = panel({
				LayoutOrder = order,
				Size = UDim2.fromOffset(230, 40),
				Parent = refs.PotionList,
			})
			Ui.padding(6).Parent = row
			local label = Ui.label({
				Size = UDim2.fromScale(1, 1),
				TextXAlignment = Enum.TextXAlignment.Right,
				TextColor3 = potion.Color,
				Parent = row,
			}, 22)
			rows[potion.Id] = { Frame = row, Label = label }
		end
	end
end

-- 매 프레임 가까이 호출: 물약 남은 시간 표시 (elapsed = 스냅샷 받은 뒤 지난 시간)
function Hud.updateTimers(state: PlayerState.Snapshot?, elapsed: number)
	if not state then
		return
	end
	for id, row in refs.PotionRows do
		local remaining = (state.Potions[id] or 0) - elapsed
		local potion = PlayerState.PotionsById[id]
		row.Label.Text = string.format("%s  %s", potion.Name, Format.duration(remaining))
	end
end

function Hud.setAuto(enabled: boolean)
	refs.AutoButton.Text = if enabled then "자동: 켬" else "자동: 끔"
	refs.AutoButton.BackgroundColor3 = if enabled then Theme.Good else Theme.PanelLight
end

function Hud.setRolling(rolling: boolean)
	refs.RollButton.Text = if rolling then "굴리는 중..." else "🎲 굴리기"
	refs.RollButton.BackgroundTransparency = if rolling then 0.4 else 0
end

function Hud.startCooldown(seconds: number)
	local bar = refs.CooldownBar
	bar.Size = UDim2.new(1, 12, 0, 6)
	TweenService:Create(bar, TweenInfo.new(seconds, Enum.EasingStyle.Linear), { Size = UDim2.new(0, 0, 0, 6) }):Play()
end

local function flash(color: Color3, strength: number)
	flashFrame.BackgroundColor3 = color
	flashFrame.BackgroundTransparency = 1 - strength
	TweenService:Create(flashFrame, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		BackgroundTransparency = 1,
	}):Play()
end

local function showAura(aura: Auras.Aura)
	refs.RevealName.Text = aura.Name
	Ui.paintAura(refs.RevealName, aura)
	refs.RevealSub.Text = Format.oneIn(aura.OneIn)
	refs.RevealSub.TextColor3 = aura.Tier.Color
end

-- 굴림 연출. 끝날 때까지 기다립니다(yield).
function Hud.reveal(
	aura: Auras.Aura,
	info: { Fast: boolean, Lucky: boolean, IsNew: boolean, Coins: number, Luck: number }
)
	hideToken += 1
	local rank = aura.Tier.Rank
	local duration = REVEAL_SECONDS[rank] or 3
	if info.Fast and rank < 4 then
		duration = math.max(0.35, duration * 0.5)
	end

	local container = refs.Reveal
	container.Visible = true
	refs.RevealScale.Scale = 1
	refs.RevealTag.Text = if info.Lucky
		then string.format("✨ 행운 굴림! (행운 %s)", Format.multiplier(info.Luck))
		else ""
	refs.RevealReward.Text = ""

	-- 1) 룰렛처럼 가짜 결과가 빠르게 돌다가 점점 느려짐
	local elapsed = 0
	while elapsed < duration do
		local fake = RollLogic.roll(Auras.RarestFirst, FAKE_SPIN_LUCK, function()
			return spinRandom:NextNumber()
		end)
		showAura(fake)
		play(tickSound)
		local t = elapsed / duration
		local interval = 0.04 + t * t * 0.2
		elapsed += task.wait(interval) -- 실제로 지난 시간을 더해야 연출 길이가 늘어지지 않음
	end

	-- 2) 전설 이상은 한 박자 뜸 들이기
	if rank >= 5 then
		refs.RevealName.Text = "? ? ?"
		Ui.paintAura(refs.RevealName, { Color = aura.Tier.Color })
		refs.RevealSub.Text = aura.Tier.Name .. " 등급..."
		flash(Color3.new(0, 0, 0), 0.6)
		task.wait(0.9)
	end

	-- 3) 결과 공개
	showAura(aura)
	refs.RevealSub.Text = Format.oneIn(aura.OneIn) .. " · " .. aura.Tier.Name
	local tags = {}
	if info.IsNew then
		table.insert(tags, "🆕 새로 발견!")
	end
	if info.Lucky then
		table.insert(tags, "✨ 행운 굴림")
	end
	refs.RevealTag.Text = table.concat(tags, "   ")
	refs.RevealReward.Text = "+" .. Format.commas(info.Coins) .. " 🪙"

	refs.RevealScale.Scale = 1.35
	TweenService:Create(refs.RevealScale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Scale = 1,
	}):Play()
	if rank >= 4 then
		flash(aura.Color, math.min(0.25 + rank * 0.08, 0.8))
		play(rareSound)
	else
		play(revealSound)
	end

	local token = hideToken
	task.delay(if info.Fast then 1 else 2.5, function()
		if token == hideToken then
			container.Visible = false
		end
	end)
end

-- 잠깐 떴다 사라지는 알림 (색은 선택)
function Hud.toast(text: string, color: Color3?, seconds: number?)
	local box = panel({
		Size = UDim2.fromOffset(520, 44),
		Parent = refs.Notices,
	})
	Ui.padding(8).Parent = box
	Ui.label({
		Size = UDim2.fromScale(1, 1),
		Text = text,
		TextColor3 = color or Theme.Text,
		Parent = box,
	}, 22)
	task.delay(seconds or 3, function()
		box:Destroy()
	end)
end

-- 서버 전체 희귀 획득 알림
function Hud.banner(playerName: string, aura: Auras.Aura, rollNumber: number)
	local box = panel({
		Size = UDim2.fromOffset(660, 76),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.25,
		Parent = refs.Notices,
	})
	box:FindFirstChildOfClass("UIStroke").Color = aura.Tier.Color
	Ui.padding(8).Parent = box
	Ui.label({
		Size = UDim2.new(1, 0, 0.45, 0),
		Text = string.format(
			"🎉 %s 님이 %s번째 굴림에서 획득!",
			Format.escape(playerName),
			Format.commas(rollNumber)
		),
		Parent = box,
	}, 22)
	local name = Ui.label({
		Position = UDim2.fromScale(0, 0.45),
		Size = UDim2.new(1, 0, 0.55, 0),
		Font = Theme.FontHeavy,
		Text = string.format("%s  (%s · %s)", aura.Name, Format.oneIn(aura.OneIn), aura.Tier.Name),
		Parent = box,
	}, 30)
	Ui.paintAura(name, aura)
	task.delay(6, function()
		box:Destroy()
	end)
end

return Hud
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">Panels</string>
            <string name="Source"><![CDATA[-- 메뉴 창: 가방(장착), 도감(발견 현황), 상점(물약)

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Auras = require(Shared.Auras)
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local PlayerState = require(Shared.PlayerState)

local Ui = require(script.Parent.Ui)
local Theme = Ui.Theme

type Handlers = {
	Equip: (string?) -> (),
	Buy: (string) -> (),
	ToggleAutoEquip: () -> (),
}

local TITLES = {
	Inventory = "🎒 가방",
	Index = "📖 도감",
	Shop = "🛒 상점",
}

local Panels = {}

local window: Frame
local titleLabel: TextLabel
local headerButton: TextButton
local body: ScrollingFrame
local handlers: Handlers
local openName: string? = nil
local lastState: PlayerState.Snapshot? = nil

local function clearBody()
	for _, child in body:GetChildren() do
		child:Destroy()
	end
end

local function gridLayout()
	Ui.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(142, 112),
		CellPadding = UDim2.fromOffset(10, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Parent = body,
	})
	Ui.padding(6).Parent = body
end

local function auraCard(order: number, aura: Auras.Aura, known: boolean, footer: string, highlight: boolean): TextButton
	local card = Ui.new("TextButton", {
		LayoutOrder = order,
		Text = "",
		AutoButtonColor = true,
		BackgroundColor3 = if highlight then Color3.fromRGB(60, 52, 110) else Theme.PanelLight,
		Parent = body,
	})
	Ui.corner(12).Parent = card
	Ui.stroke(if known then aura.Tier.Color else Theme.Stroke, if highlight then 3 else 2, if known then 0.1 else 0.5).Parent =
		card
	Ui.padding(8).Parent = card

	local name = Ui.label({
		Size = UDim2.new(1, 0, 0.42, 0),
		Font = Theme.FontHeavy,
		Text = if known then aura.Name else "???",
		TextColor3 = Theme.SubText,
		Parent = card,
	}, 26)
	if known then
		Ui.paintAura(name, aura)
	end
	Ui.label({
		Position = UDim2.fromScale(0, 0.44),
		Size = UDim2.new(1, 0, 0.26, 0),
		Text = Format.oneIn(aura.OneIn),
		TextColor3 = aura.Tier.Color,
		Parent = card,
	}, 18)
	Ui.label({
		Position = UDim2.fromScale(0, 0.72),
		Size = UDim2.new(1, 0, 0.28, 0),
		Text = footer,
		TextColor3 = Theme.SubText,
		Parent = card,
	}, 16)
	return card
end

local function renderInventory(state: PlayerState.Snapshot)
	headerButton.Visible = true
	headerButton.Text = if state.Settings.AutoEquip
		then "더 희귀하면 자동 장착: 켬"
		else "더 희귀하면 자동 장착: 끔"

	local owned = {}
	for _, aura in Auras.RarestFirst do
		if (state.Inventory[aura.Id] or 0) > 0 then
			table.insert(owned, aura)
		end
	end
	if #owned == 0 then
		-- 격자 칸 하나에 끼지 않도록 격자 없이 한 줄로 표시
		Ui.label({
			Size = UDim2.new(1, 0, 0, 40),
			Text = "아직 오라가 없어요. 굴려 보세요!",
			TextColor3 = Theme.SubText,
			Parent = body,
		}, 24)
		return
	end

	gridLayout()
	for order, aura in owned do
		local equipped = state.Equipped == aura.Id
		local footer = string.format(
			"x%s · %s",
			Format.commas(state.Inventory[aura.Id]),
			if equipped then "장착 중" else "눌러서 장착"
		)
		local card = auraCard(order, aura, true, footer, equipped)
		card.Activated:Connect(function()
			handlers.Equip(if equipped then nil else aura.Id)
		end)
	end
end

local function renderIndex(state: PlayerState.Snapshot)
	local found = 0
	for _, aura in Auras.List do
		if (state.Inventory[aura.Id] or 0) > 0 then
			found += 1
		end
	end
	titleLabel.Text = string.format("%s  (%d / %d 발견)", TITLES.Index, found, #Auras.List)
	gridLayout()
	for order, aura in Auras.List do
		local known = (state.Inventory[aura.Id] or 0) > 0
		auraCard(order, aura, known, aura.Tier.Name .. " · " .. aura.Subtitle, false)
	end
end

local function renderShop(state: PlayerState.Snapshot)
	local layout = Ui.list(Enum.FillDirection.Vertical, 10, Enum.HorizontalAlignment.Center)
	layout.VerticalAlignment = Enum.VerticalAlignment.Top
	layout.Parent = body
	Ui.padding(6).Parent = body

	for order, potion in Config.Potions do
		local row = Ui.new("Frame", {
			LayoutOrder = order,
			Size = UDim2.new(1, -12, 0, 86),
			BackgroundColor3 = Theme.PanelLight,
			Parent = body,
		})
		Ui.corner(12).Parent = row
		Ui.stroke(potion.Color, 2, 0.2).Parent = row
		Ui.padding(10).Parent = row

		local remaining = state.Potions[potion.Id]
		Ui.label({
			Size = UDim2.new(0.68, 0, 0.5, 0),
			TextXAlignment = Enum.TextXAlignment.Left,
			Font = Theme.FontHeavy,
			Text = potion.Name .. (if remaining then "  (사용 중)" else ""),
			TextColor3 = potion.Color,
			Parent = row,
		}, 26)
		Ui.label({
			Position = UDim2.fromScale(0, 0.52),
			Size = UDim2.new(0.68, 0, 0.48, 0),
			TextXAlignment = Enum.TextXAlignment.Left,
			Text = potion.Description,
			TextColor3 = Theme.SubText,
			Parent = row,
		}, 20)

		local affordable = state.Coins >= potion.Price
		local buy = Ui.button({
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.fromScale(1, 0.5),
			Size = UDim2.new(0.3, 0, 1, 0),
			BackgroundColor3 = if affordable then Theme.Good else Theme.PanelLight,
			TextColor3 = if affordable then Color3.new(0.05, 0.1, 0.05) else Theme.SubText,
			Text = "🪙 " .. Format.commas(potion.Price),
			Parent = row,
		}, 24)
		buy.Activated:Connect(function()
			handlers.Buy(potion.Id)
		end)
	end

	Ui.label({
		LayoutOrder = 100,
		Size = UDim2.new(1, -12, 0, 30),
		Text = string.format(
			"같은 물약은 시간만 늘어나요(최대 %d분). 다른 물약끼리는 효과가 곱해져요.",
			Config.MAX_POTION_SECONDS // 60
		),
		TextColor3 = Theme.SubText,
		Parent = body,
	}, 18)
end

local function render()
	if not openName then
		return
	end
	clearBody()
	titleLabel.Text = TITLES[openName]
	headerButton.Visible = false
	local state = lastState
	if not state then
		return
	end
	if openName == "Inventory" then
		renderInventory(state)
	elseif openName == "Index" then
		renderIndex(state)
	elseif openName == "Shop" then
		renderShop(state)
	end
end

function Panels.init(parent: ScreenGui, callbacks: Handlers)
	handlers = callbacks

	window = Ui.new("Frame", {
		Name = "Window",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(660, 450),
		BackgroundColor3 = Theme.Panel,
		BackgroundTransparency = 0.05,
		Visible = false,
		ZIndex = 5,
		Parent = parent,
	})
	Ui.corner(16).Parent = window
	Ui.stroke(Theme.Accent, 2, 0.2).Parent = window
	Ui.autoScale(window)

	titleLabel = Ui.label({
		Position = UDim2.fromOffset(16, 10),
		Size = UDim2.new(0.5, 0, 0, 36),
		TextXAlignment = Enum.TextXAlignment.Left,
		Font = Theme.FontHeavy,
		Parent = window,
	}, 28)

	headerButton = Ui.button({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -64, 0, 10),
		Size = UDim2.fromOffset(250, 38),
		Visible = false,
		Parent = window,
	}, 18)
	headerButton.Activated:Connect(function()
		handlers.ToggleAutoEquip()
	end)

	local close = Ui.button({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 10),
		Size = UDim2.fromOffset(40, 38),
		BackgroundColor3 = Theme.Bad,
		Text = "✕",
		Parent = window,
	}, 22)
	close.Activated:Connect(Panels.close)

	body = Ui.new("ScrollingFrame", {
		Position = UDim2.fromOffset(12, 58),
		Size = UDim2.new(1, -24, 1, -70),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = window,
	})
end

-- 같은 창 버튼을 다시 누르면 닫힘
function Panels.toggle(name: string)
	if openName == name then
		Panels.close()
		return
	end
	openName = name
	window.Visible = true
	render()
end

function Panels.close()
	openName = nil
	window.Visible = false
	clearBody()
end

function Panels.render(state: PlayerState.Snapshot?)
	lastState = state
	render()
end

return Panels
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">Ui</string>
            <string name="Source"><![CDATA[-- UI 생성 헬퍼와 테마. 모든 화면은 코드로 만들어서 .rbxm 없이도 동작합니다.

local CollectionService = game:GetService("CollectionService")

local Ui = {}

Ui.Theme = {
	Panel = Color3.fromRGB(24, 26, 38),
	PanelLight = Color3.fromRGB(40, 44, 64),
	Stroke = Color3.fromRGB(90, 96, 140),
	Text = Color3.fromRGB(240, 240, 250),
	SubText = Color3.fromRGB(165, 170, 200),
	Accent = Color3.fromRGB(125, 95, 255),
	Good = Color3.fromRGB(90, 220, 120),
	Bad = Color3.fromRGB(255, 95, 95),
	Gold = Color3.fromRGB(255, 205, 70),
	Font = Enum.Font.GothamBold,
	FontHeavy = Enum.Font.GothamBlack,
}

-- 화면 크기 기준 해상도. 이보다 작으면(휴대폰) 줄이고, 크면 조금 키웁니다.
local DESIGN_SIZE = Vector2.new(1280, 720)

-- Ui.new("Frame", { Size = ..., Parent = ... }, { 자식들 })
function Ui.new(className: string, props: { [string]: any }?, children: { Instance }?): any
	local instance = Instance.new(className)
	local parent = nil
	for key, value in props or {} do
		if key == "Parent" then
			parent = value
		else
			(instance :: any)[key] = value
		end
	end
	for _, child in children or {} do
		child.Parent = instance
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

function Ui.corner(radius: number?): UICorner
	return Ui.new("UICorner", { CornerRadius = UDim.new(0, radius or 12) })
end

function Ui.stroke(color: Color3?, thickness: number?, transparency: number?): UIStroke
	return Ui.new("UIStroke", {
		Color = color or Ui.Theme.Stroke,
		Thickness = thickness or 2,
		Transparency = transparency or 0.3,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function Ui.padding(px: number): UIPadding
	local u = UDim.new(0, px)
	return Ui.new("UIPadding", { PaddingTop = u, PaddingBottom = u, PaddingLeft = u, PaddingRight = u })
end

function Ui.list(direction: Enum.FillDirection, gap: number, hAlign: Enum.HorizontalAlignment?): UIListLayout
	return Ui.new("UIListLayout", {
		FillDirection = direction,
		Padding = UDim.new(0, gap),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = hAlign or Enum.HorizontalAlignment.Left,
		VerticalAlignment = Enum.VerticalAlignment.Center,
	})
end

-- 글자 크기 자동(TextScaled) + 최대 크기 제한
function Ui.label(props: { [string]: any }, maxTextSize: number?): TextLabel
	local label = Ui.new("TextLabel", {
		Text = "",
		BackgroundTransparency = 1,
		Font = Ui.Theme.Font,
		TextColor3 = Ui.Theme.Text,
		TextScaled = true,
		RichText = true,
	})
	for key, value in props do
		if key ~= "Parent" then
			(label :: any)[key] = value
		end
	end
	Ui.new("UITextSizeConstraint", { MaxTextSize = maxTextSize or 28, Parent = label })
	label.Parent = props.Parent
	return label
end

function Ui.button(props: { [string]: any }, maxTextSize: number?): TextButton
	local button = Ui.new("TextButton", {
		Text = "",
		AutoButtonColor = true,
		BackgroundColor3 = Ui.Theme.PanelLight,
		Font = Ui.Theme.FontHeavy,
		TextColor3 = Ui.Theme.Text,
		TextScaled = true,
		RichText = true,
	})
	for key, value in props do
		if key ~= "Parent" then
			(button :: any)[key] = value
		end
	end
	Ui.corner(12).Parent = button
	Ui.stroke().Parent = button
	Ui.new("UITextSizeConstraint", { MaxTextSize = maxTextSize or 26, Parent = button })
	Ui.padding(6).Parent = button
	button.Parent = props.Parent
	return button
end

function Ui.colorSequence(colors: { Color3 }): ColorSequence
	if #colors == 1 then
		return ColorSequence.new(colors[1])
	end
	local keypoints = {}
	for i, color in colors do
		table.insert(keypoints, ColorSequenceKeypoint.new((i - 1) / (#colors - 1), color))
	end
	return ColorSequence.new(keypoints)
end

-- 텍스트에 오라 색(단색 또는 회전하는 그라데이션)을 입힘
function Ui.paintAura(label: TextLabel | TextButton, aura: any)
	local old = label:FindFirstChild("AuraGradient")
	if old then
		old:Destroy()
	end
	if aura.Gradient then
		label.TextColor3 = Color3.new(1, 1, 1)
		local gradient = Ui.new("UIGradient", {
			Name = "AuraGradient",
			Color = Ui.colorSequence(aura.Gradient),
			Parent = label,
		})
		CollectionService:AddTag(gradient, "AuraGradient")
	else
		label.TextColor3 = aura.Color
	end
end

-- 화면 크기에 맞춰 크기를 조절하는 UIScale 을 붙임 (AnchorPoint 기준으로 커지고 작아짐)
local scalers: { UIScale } = {}

local function currentScale(): number
	local camera = workspace.CurrentCamera
	local viewport = if camera then camera.ViewportSize else DESIGN_SIZE
	return math.clamp(math.min(viewport.X / DESIGN_SIZE.X, viewport.Y / DESIGN_SIZE.Y), 0.6, 1.3)
end

function Ui.autoScale(object: GuiObject)
	local scale = Ui.new("UIScale", { Scale = currentScale(), Parent = object })
	table.insert(scalers, scale)
end

local function refreshScales()
	local value = currentScale()
	for _, scale in scalers do
		scale.Scale = value
	end
end

local cameraConnection: RBXScriptConnection? = nil
local function watchCamera()
	if cameraConnection then
		cameraConnection:Disconnect()
	end
	local camera = workspace.CurrentCamera
	if camera then
		cameraConnection = camera:GetPropertyChangedSignal("ViewportSize"):Connect(refreshScales)
	end
	refreshScales()
end
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(watchCamera)
watchCamera()

return Ui
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="21">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="NeedsPivotMigration">false</bool>
    </Properties>
    <Item class="Part" referent="22">
