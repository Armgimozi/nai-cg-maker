+
+def tinted(a, mid, pal, night=True, frame=0):
+    """모델을 읽어 면마다 색을 미리 곱한 미리보기용 모델 (게임 셰이더 규칙으로 알파를 푼다)."""
+    with open(os.path.join(a, "models", "vfx", mid + ".json"), encoding="utf-8") as f:
+        j = json.load(f)
+    cols = [_rgb(c) for c in pal]
+    if night and mid not in ("warn", "warn_fill", "warn_line"):
+        cols[2] = cols[0]  # 밤에는 테를 바깥 빛으로
+    pm = _PModel()
+    cache = {}
+    for el in j["elements"]:
+        e2 = dict(el)
+        e2["faces"] = {}
+        for fn, fd in el["faces"].items():
+            key = fd["texture"].lstrip("#")
+            tint = fd.get("tintindex")
+            nk = f"{key}|{tint}"
+            if nk not in pm.atlases:
+                tex = j["textures"][key].split(":", 1)[1]
+                png = os.path.join(a, "textures", tex + ".png")
+                if png not in cache:
+                    img = Image.open(png).convert("RGBA")
+                    meta = png + ".mcmeta"
+                    fw, fh = img.width, img.height
+                    if os.path.exists(meta):
+                        an = json.load(open(meta)).get("animation", {})
+                        fw, fh = an.get("width", img.width), an.get("height", img.width)
+                    nfr = max(1, img.height // fh)
+                    fr = frame % nfr
+                    cache[png] = np.array(img.crop((0, fr * fh, fw, fr * fh + fh))).astype(np.float32)
+                arr = cache[png]
+                al = decode_alpha(arr.astype(np.int32))
+                rgb = arr[..., :3] / 255.0 * (cols[tint] if tint is not None else 255.0)
+                out = np.dstack([rgb, al * 255.0]).clip(0, 255).astype(np.uint8)
+                pm.atlases[nk] = _Tex(Image.fromarray(out, "RGBA"))
+            d2 = dict(fd)
+            d2["texture"] = "#" + nk
+            e2["faces"][fn] = d2
+        pm.elements.append(e2)
+    return pm
+
+
+def view_matrix(scale=1.0, yaw=0.0, pitch=0.0, roll=0.0, t=(0, 0, 0), sx=None):
+    """디스플레이 Transformation 흉내 + 아이템 디스플레이의 Y 180도 + 미리보기 렌더러의 좌우 반전 보정."""
+    from mc3d import mat
+    flip = np.diag([-1.0, 1.0, -1.0, 1.0])  # 아이템 디스플레이의 Y 180도
+    mirror = np.diag([-1.0, 1.0, 1.0, 1.0])  # mc3d 화면은 좌우가 뒤집혀 있어 되돌린다
+    s = scale if sx is None else sx
+    return mirror @ mat(translate=t, scale=s, yaw=yaw, pitch=pitch, roll=roll) @ flip
+
+
+def shot(a, parts, size=220, yaw=0, pitch=-90, bg=NIGHT_BG, span=None):
+    """parts: [(모델 id, 색, 밤?, 행렬)]. pitch=-90 이면 위에서 내려다보고 화면 위쪽이 앞(+Z), 왼쪽이 +X."""
+    from mc3d import render
+    ps = [(tinted(a, mid, pal, night), M) for (mid, pal, night, M) in parts]
+    sc = None if span is None else size / span
+    return render(ps, size=size, yaw=yaw, pitch=pitch, bg=bg, pad=0.04, scale=sc, center=(0, 0) if span else None)
+
+
+def _font(sz):
+    for p in (os.environ.get("PREVIEW_FONT", ""), "/tmp/claude-0/work/fonts/ng.ttf",
+              "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"):
+        try:
+            return ImageFont.truetype(p, sz)
+        except OSError:
+            pass
+    return ImageFont.load_default()
+
+
+VIEW = {  # geometry → (yaw, pitch, 화면 범위 블록)
+    "g_flat": (0, -90, 3.2), "g_flat_q": (0, -90, 3.2), "g_flat_front": (0, -90, 3.2), "g_strip": (0, -90, 1.6),
+    "g_bill_q": (0, 0, None), "g_bill": (0, 0, None), "g_vbill": (0, 0, None), "g_beam": (-60, -25, None),
+    "g_cut": (-60, -25, None), "g_ring_wall": (-20, -28, None), "g_dome": (-20, -20, None), "g_wave": (-35, -12, None),
+}
+
+
+def _scale_for(mid, geo):
+    if geo == "g_vbill":
+        return (1.0, 6.0 if mid == "bolt" else 2.6, 1.0)
+    if geo == "g_beam":
+        return (0.6, 0.6, 3.0)
+    return (1, 1, 1)
+
+
+def preview(a, out_png, manifest, bg=NIGHT_BG, night=True, cols=8, cell=210):
+    """모든 VFX 모델을 속성 색으로 칠해 한 장에 모은다."""
+    f = _font(13)
+    rows = (len(manifest) + cols - 1) // cols
+    sheet = Image.new("RGBA", (cols * cell, rows * (cell + 34) + 40), (10, 9, 16, 255))
+    d = ImageDraw.Draw(sheet)
+    d.text((10, 10), f"augsky:vfx/*  ({len(manifest)} models)  — {'night, rim tint = a' if night else 'day, rim tint = dark'}",
+           font=_font(18), fill=(235, 235, 245))
+    for n, (mid, geo, note, show) in enumerate(manifest):
+        yaw, pitch, span = VIEW.get(geo, (0, -90, None))
+        img = shot(a, [(mid, PAL[show], night, view_matrix(sx=_scale_for(mid, geo)))], size=cell - 10, yaw=yaw,
+                   pitch=pitch, span=span, bg=bg)
+        x, y = (n % cols) * cell, 40 + (n // cols) * (cell + 34)
+        sheet.alpha_composite(img, (x + 5, y))
+        d.text((x + 6, y + cell - 6), mid, font=f, fill=(240, 240, 250))
+        d.text((x + 6, y + cell + 10), note[:26], font=_font(11), fill=(160, 160, 180))
+    sheet.convert("RGB").save(out_png)
+    return out_png
+
+
+if __name__ == "__main__":
+    import shutil
+    import tempfile
+    sys.path.insert(0, HERE)
+    tmp = sys.argv[1] if len(sys.argv) > 1 else tempfile.mkdtemp()
+    a = os.path.join(tmp, "assets", NS)
+    if os.path.exists(a):
+        shutil.rmtree(a)
+    B = build(a)
+    print("텍스처", len(B.bk.files), "장, 텍셀", B.bk.texels, "모델", len(B.manifest))
+    out = sys.argv[2] if len(sys.argv) > 2 else os.path.join(tmp, "preview-vfx.png")
+    preview(a, out, B.manifest)
+    print(out)
