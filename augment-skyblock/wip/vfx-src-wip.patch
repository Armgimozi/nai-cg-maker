+    /** 판 모양 조각. 반지름 r, 좌표계 fr */
+    public static Sprite flat(CastFx fx, String model, Location c, double r, Shapes.Frame fr, CastFx.Cols k) {
+        double s = r / Geo.FLAT_HALF;
