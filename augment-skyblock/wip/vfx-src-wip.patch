+    static String slashModel(CastFx fx, double angleDeg, CastFx.Cols k) {
+        Models m = fx.vfx.models;
+        if (angleDeg >= 300) {
+            String w = m.pick("slash_wide");
+            if (w != null) return w;
+        }
+        if (k.rainbow()) {
+            String r = m.pick("slash_rainbow");
