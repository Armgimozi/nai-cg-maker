+                                        Emit.dust(fx, c.clone().add(Math.cos(aa) * rr, 0.15 + i * 0.15, Math.sin(aa) * rr), Color.fromRGB(0x3ad040), 1.0, Emit.DETAIL);
+                                    }
+                                }
+                            }
+                        }
+                    };
+                }));
+
+        m.put("vine_storm", Sig.of()
+                .on(Ev.Hit.class, (fx, e) -> {
+                    if (e.tick()) return;
