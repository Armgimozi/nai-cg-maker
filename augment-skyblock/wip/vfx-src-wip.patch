+/** 기본 연출과 전용 연출이 같이 쓰는 조각·입자 묶음 */
+public final class Kit {
+    private Kit() {}
+
+    static final Color WHITE = Color.WHITE;
+
+    static ThreadLocalRandom rnd() {
