+        if (k != null) sp.tint(k);
+        return sp;
+    }
+
+    /** 속성 모양 이름 (팩의 *_frost / *_flame / *_void 변형). 없으면 null */
+    static String shape(CastFx fx) {
+        return switch (fx.pal.id()) {
+            case "frost" -> "frost";
+            case "flame", "sun" -> "flame";
+            // 종말(doom)은 검은 심 고리를 쓰지 않는다: 작은 낙하 충격마다 검은 바퀴 자국처럼 남았다
+            case "abyss", "shadow", "ender" -> "void";
