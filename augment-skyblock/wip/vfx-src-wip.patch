+# ── 세로/빔 (애니메이션) ──
+
+def f_beam(X, Y, px, frame, nf, seed=91):
+    """빔 단면: Y(-1..1) = 폭, X(0..1) = 길이(흐르는 결)."""
+    nz = Noise(seed)
+    ay = np.abs(Y)
+    flow = nz.fbm((X - frame / nf) * 4, ay * 7, 3, pu=4)
+    i = np.where(ay < 0.11, 1.0, np.where(ay < 0.36, 0.80 - 0.27 * (ay - 0.11) / 0.25,
+                                          0.52 * np.exp(-(ay - 0.36) / 0.10)))
+    i = i * np.where(ay < 0.11, 1.0, 0.72 + 0.5 * flow)
+    return np.clip(i * smooth(1.0, 0.86, ay), 0, 1)
+
+
+def f_rift(X, Y, px, frame, nf, seed=93):
+    nz = Noise(seed + frame * 3)
+    ay = Y
+    jag = nz.fbm(X * 6, 0.5, 3, pu=6)
+    half = 0.20 + 0.14 * jag
+    black = np.where(np.abs(ay) < half, 1.0, 0)
+    d = np.abs(np.abs(ay) - half)
+    lips = np.where(np.abs(ay) >= half, prof(d, 1.0 * px, 3.0 * px, 0.12), 0)
+    spark = nz.fbm(X * 16 + frame * 0.7, ay * 10, 2, pu=16)
+    lips = lips * (0.75 + 0.45 * spark)
+    return {"I": np.clip(lips * smooth(1.0, 0.9, np.abs(ay)), 0, 1), "black": black}
+
+
+def f_pillar(X, Y, px, frame, nf, seed=95):
+    """빛기둥: X(-1..1) 폭, Y(0 아래 → 1 위). 위로 흐르는 결, 위로 갈수록 옅다."""
+    nz = Noise(seed)
+    ax = np.abs(X)
+    up = nz.fbm(ax * 9, (Y - frame / nf) * 3, 3, pv=3)
+    prof_x = np.where(ax < 0.10, 1.0, np.where(ax < 0.32, 0.80 - 0.27 * (ax - 0.10) / 0.22,
+                                               0.52 * np.exp(-(ax - 0.32) / 0.12)))
+    fade = (1 - Y) ** 0.9 * smooth(0.0, 0.04, Y) + 0.0
+    flare = 0.6 * np.exp(-Y / 0.06) * np.exp(-ax / 0.5)
+    i = prof_x * (0.62 + 0.55 * up) * (0.25 + 0.75 * fade)
+    i = np.where(ax < 0.10, np.maximum(i, 0.82 * fade + 0.2), i)
+    return np.clip(np.maximum(i, flare) * smooth(1.0, 0.8, ax) * smooth(1.0, 0.97, Y), 0, 1)
+
+
+def f_bolt(X, Y, px, frame, nf, seed=97):
+    """번개: 아래(Y=0)에서 위(Y=8)까지 지그재그 + 곁가지. 좌표는 X(-0.5..0.5)·Y(0..8) 블록비."""
+    rng = np.random.default_rng(seed + frame * 13)
+
+    def path(p0, p1, rough, depth):
+        pts = [np.array(p0, float), np.array(p1, float)]
+        for _ in range(depth):
+            new = [pts[0]]
+            for a, b in zip(pts[:-1], pts[1:]):
+                m = (a + b) / 2
+                L = np.linalg.norm(b - a)
+                m[0] += rng.normal(0, rough * L)
+                m[0] = np.clip(m[0], -0.36, 0.36)
+                new += [m, b]
+            pts = new
+        return pts
+
+    main = path((rng.uniform(-0.1, 0.1), 0.0), (rng.uniform(-0.1, 0.1), 8.0), 0.22, 6)
+    segs = [(*main[j], *main[j + 1]) for j in range(len(main) - 1)]
+    i = np.zeros_like(X)
+    D, _ = seg_dist(X, Y, segs)
+    i = prof(D, 1.7 * px, 3.4 * px, 3.6 * px)
+    for _ in range(rng.integers(2, 4)):
+        j = rng.integers(len(main) // 6, len(main) * 5 // 6)
+        p0 = main[j]
+        p1 = p0 + np.array([rng.choice([-1, 1]) * rng.uniform(0.15, 0.32), rng.uniform(-1.6, -0.6)])
+        p1[0] = np.clip(p1[0], -0.38, 0.38)
+        br = path(p0, p1, 0.25, 4)
+        D, T = seg_dist(X, Y, [(*br[q], *br[q + 1]) for q in range(len(br) - 1)])
+        i = np.maximum(i, prof(D, 0.9 * px, 2.0 * px, 2.4 * px, 0.8))
+    return i
+
+
+def f_flame(X, Y, px, frame, nf, seed=99):
+    """불꽃 혀: X(-1..1), Y(0 아래 → 1 위). 프레임마다 위로 흐르며 날름거린다."""
+    nz = Noise(seed)
+    t = frame / nf
+    sway = 0.10 * np.sin(Y * 5 - t * 2 * math.pi) * Y
+    n = nz.fbm(X * 2.5, (Y - t) * 3, 3, pv=3)
+    half = 0.85 * (1 - Y) ** 0.75 * (0.65 + 0.6 * n) * smooth(0.0, 0.08, Y)
+    d = np.abs(X - sway) / np.maximum(half, 1e-3)
+    heat = (1 - Y) ** 0.6
+    i = np.where(d < 1, (1 - d ** 1.6) * (0.55 + 0.6 * heat), 0)
+    tongues = nz.fbm(X * 6 + 5, (Y - t) * 6, 2, pv=6)
+    i = i * np.where(Y > 0.45, smooth(0.3, 0.6, tongues + 0.25 * (1 - Y)), 1.0)
+    return np.clip(i * smooth(1.0, 0.92, np.abs(X)), 0, 1)
+
+
+def f_wave(X, Y, px, seed=101):
+    """해일 벽: X(-1..1) 폭, Y(0 아래 → 1 위). 아래는 비치고 위로 갈수록 짙어지며, 마루에 흰 거품이 말린다."""
+    nz = Noise(seed)
+    crest = 0.80 + 0.10 * np.cos(X * math.pi / 2) - 0.12 * X ** 2 + 0.04 * nz(X * 8, 1.0)
+    below = Y < crest
+    t = np.clip(Y / crest, 0, 1)
+    flow = nz.fbm(X * 5 + Y * 1.5, Y * 7, 3)  # 비스듬히 솟는 물결
+    body = (0.20 + 0.42 * t ** 1.6) * (0.55 + 0.75 * flow)
+    body = body * smooth(0.0, 0.3, Y) * smooth(1.0, 0.82, np.abs(X))
+    # 마루 바로 아래의 밝은 띠 (빛이 비치는 얇은 물)
+    lip = np.where((Y < crest) & (Y > crest - 0.12), 0.40 + 0.16 * smooth(crest - 0.12, crest, Y), 0)
+    foam_d = np.abs(Y - crest)
+    foam = np.where(foam_d < 0.045 + 0.05 * nz(X * 22, 3.0), 1.0, 0)
+    blobs = nz.fbm(X * 16, Y * 12, 2)
+    foam2 = np.where((Y < crest) & (Y > crest - 0.25) & (blobs > 0.70), 0.86, 0)
+    edge = smooth(1.0, 0.8, np.abs(X))
+    i = np.where(below, np.maximum(np.maximum(body, lip * edge), foam2 * edge), 0)
+    return np.clip(np.maximum(i, foam * edge), 0, 1)
+
+
+def f_wave_crest(X, Y, px, seed=103):
+    """마루 위로 튀는 물보라 (앞으로 기운 판)."""
+    nz = Noise(seed)
+    rng = np.random.default_rng(seed)
+    base = np.where(Y < 0.22, 0.62 * (1 - Y / 0.22) * (0.55 + 0.6 * nz.fbm(X * 10, Y * 4, 2)), 0)
+    i = base * smooth(1.0, 0.8, np.abs(X))
+    for _ in range(30):
+        cx, cy = rng.uniform(-0.9, 0.9), rng.uniform(0.1, 0.85)
+        d = np.hypot((X - cx) * 2, Y - cy)
+        i = np.maximum(i, prof(d, 0.01 + 0.01 * (1 - cy), 0.026, 0.02, 0.85 - 0.45 * cy))
+    return np.clip(i, 0, 1)
+
+
+def f_ring_wall(X, Y, px, seed=105):
+    """빛 장막: X(0..1) = 둘레(한 바퀴), Y(0 아래 → 1 위). 아래가 밝고 위로 결이 솟는다."""
+    nz = Noise(seed)
+    h = 0.35 + 0.65 * nz.fbm(X * 24, 0.5, 3, pu=24)  # 결마다 높이
+    col = nz.fbm(X * 48, 2.0, 2, pu=48)
+    rise = np.clip(1 - Y / h, 0, 1) ** 1.4 * (0.55 + 0.6 * col)
+    base = np.where(Y < 0.05, 1.0, np.where(Y < 0.14, 0.80 - 0.25 * (Y - 0.05) / 0.09, 0))
+    return np.clip(np.maximum(base, 0.75 * rise), 0, 1)
+
+
+def f_dome(X, Y, px):
+    """반구 단면(반원): X(-1..1), Y(0 아래 → 1 위). 둘레가 밝고 안쪽으로 짧게 번진다 (가장자리만 빛나는 막)."""
+    r = np.hypot(X, Y)
+    d = 0.95 - r
+    i = np.where(d >= 0, prof(d, 1.6 * px, 4.5 * px, 0.06), prof(-d, 1.0 * px, 2.0 * px, 1.4 * px))
+    i = i * (0.75 + 0.25 * smooth(0.0, 0.6, Y))
+    return np.clip(i * smooth(0.0, 0.02, Y), 0, 1)
+
+
+# ─────────────────────────── 텍스처 굽기 ───────────────────────────
+
+class Baker:
+    """밝기장 → 띠별 PNG. 같은 그림의 띠들은 해상도가 같아 서로 꼭 맞물린다."""
+
+    def __init__(self, tex_dir):
+        self.dir = tex_dir
+        self.texels = 0
+        self.files = []
+
+    def save(self, name, img, frames=1, frametime=1):
+        os.makedirs(self.dir, exist_ok=True)
+        path = os.path.join(self.dir, name + ".png")
+        img.save(path, optimize=True)
+        self.files.append(name)
+        fw, fh = img.width, img.height // frames
+        self.texels += fw * fh
+        if frames > 1:
+            meta = {"animation": {"frametime": frametime, "interpolate": False}}
+            if fw != fh:
+                meta["animation"]["width"] = fw
+                meta["animation"]["height"] = fh
+            with open(path + ".mcmeta", "w", encoding="utf-8") as f:
+                json.dump(meta, f)
+
+    def field(self, painter, w, h, ss, dom, frame=None, nf=None, pxk=1.0, **kw):
+        X, Y = grid(w, h, ss, *dom)
+        # pxk: 해상도를 올려도 선 굵기(세계 크기)는 그대로 두려면 그만큼 크게 준다 (가장자리만 매끈해진다)
+        px = (dom[1] - dom[0]) / w * pxk
+        res = painter(X, Y, px, frame, nf, **kw) if frame is not None else painter(X, Y, px, **kw)
+        if not isinstance(res, dict):
+            res = {"I": res}
+        return {k: down(np.asarray(v, np.float32), ss) for k, v in res.items()}
+
+    def bake(self, name, painter, w, h, dom=(-1, 1, -1, 1), ss=3, q=False, frames=1, frametime=1,
+             rim=2, rim_alpha=0.5, core=True, fade=1.0, rainbow=None, direct=False, cut=None, pxk=1.0, **kw):
+        """
+        name 접두사로 띠별 텍스처를 저장하고 {띠: 텍스처 이름} 을 돌려준다.
+        q=True 면 전체를 그린 뒤 오른쪽 아래 4분의 1만 저장한다 (모델이 거울처럼 4번 붙인다).
+        rainbow=f(X,Y) → 색상(0..1): out+in 을 미리 칠한 'body' 한 장으로 만든다 (심·테는 원본과 공유).
+        direct=True 면 그림이 띠별 알파를 바로 준다 (경고 표시).
+        """
+        per_frame = []
+        for fi in range(frames):
+            fl = self.field(painter, w, h, ss, dom, *((fi, frames) if frames > 1 else ()), pxk=pxk, **kw)
+            if direct:
+                bands = {k: v * fade for k, v in fl.items()}
+            else:
+                dimmed = fade < 0.99
+                if dimmed:
+                    # 흐린 단계 = 알파를 낮춘 판이 아니라 '타고 남은 가는 선'. 낮 잔디 위에서 반투명한 흰 판은
+                    # 허연 안개처럼 보이므로, 번짐을 잘라 내고 선은 진하게 두되 한 단계 식은 색으로 칠한다
+                    # (흰 심 → b, 안쪽 띠 → a). 55% 단계는 선이 조금, 25% 단계는 가장 밝은 심만 남는다
+                    k_a = 0.5 + 0.75 * fade
+                    ct = cut if cut is not None else (0.30 if fade >= 0.4 else 0.66)
+                    sb = split(fl["I"], rim=0, fade=1.0, core=core, cut=ct)
+                    o, i_, c_ = sb.get("out", 0), sb.get("in", 0), sb.get("core", 0)
+                    bands = {"out": np.maximum(o, i_) * k_a}
+                    if core:
+                        bands["in"] = c_ * k_a
+                else:
+                    ct = cut if cut is not None else CUT
+                    bands = split(fl["I"], rim=rim, rim_alpha=rim_alpha, fade=fade, core=core, cut=ct)
+                if "black" in fl:
+                    blk = fl["black"] >= 0.5
+                    for k in bands:
+                        bands[k] = np.where(blk, 0, bands[k])
+                    bands["black"] = np.where(blk, k_a if dimmed else fade, 0)
+                if "shade" in fl:
+                    # 칠하지 않는 반투명 검정 (공허 웅덩이 바탕)
+                    sh = fl["shade"]
+                    taken = np.zeros(sh.shape, bool)
+                    for k in bands:
+                        taken |= bands[k] > 0
+                    bands["black"] = np.where(taken, bands.get("black", 0), np.maximum(bands.get("black", 0), sh * fade))
+            imgs = {}
+            for band, alpha in bands.items():
+                rgb = np.zeros(alpha.shape + (3,)) if band == "black" else None
+                imgs[band] = (alpha, rgb)
+            if rainbow is not None:
+                X, Y = grid(w, h, 1, *dom)
+                hue = rainbow(X, Y)
+                o = imgs.pop("out", (np.zeros((h, w)), None))[0]
+                i_ = imgs.pop("in", (np.zeros((h, w)), None))[0]
+                col = np.where((i_ > 0)[..., None], hue_rgb(hue, 0.42, 1.0), hue_rgb(hue, 0.88, 1.0))
+                imgs = {"body": (np.maximum(o, i_), col)}
+            per_frame.append(imgs)
+        out = {}
+        for band in per_frame[0]:
+            stack = []
+            for imgs in per_frame:
+                alpha, rgb = imgs[band]
+                im = to_rgba(alpha, rgb)
+                if q:
+                    im = im.crop((im.width // 2, im.height // 2, im.width, im.height))
+                stack.append(im)
+            if not np.any(np.array(stack[0])[..., 3]):
+                continue  # 빈 띠는 버린다
+            full = Image.new("RGBA", (stack[0].width, stack[0].height * len(stack)))
+            for k, im in enumerate(stack):
+                full.paste(im, (0, k * im.height))
+            tname = f"{name}_{band}"
+            self.save(tname, full, frames, frametime)
+            out[band] = tname
+        return out
+
+
+# ─────────────────────────── 모델 (요소·면) ───────────────────────────
+
+FACE_AXES = {  # 면 → (u 가 따라가는 축, 시작이 min/max), (v 축, 시작) — 바닐라 면 굽기 규칙
+    "up": (("x", "min"), ("z", "min")),
+    "down": (("x", "min"), ("z", "max")),
+    "north": (("x", "max"), ("y", "max")),
+    "south": (("x", "min"), ("y", "max")),
+    "east": (("z", "max"), ("y", "max")),
+    "west": (("z", "min"), ("y", "max")),
+}
+AXI = {"x": 0, "y": 1, "z": 2}
+
+
+def uv_for(face, frm, to, tu, tv):
+    """텍스처 좌표가 모델 좌표에 고정되도록(tu = (축, u=0 인 좌표, u=16 인 좌표)) 면의 uv 를 계산한다.
+    그래서 윗면과 아랫면이 같은 자리에 같은 텍셀을 보여 준다 (아래에서 봐도 앞뒤가 뒤집히지 않는다)."""
+    (ua, us), (va, vs) = FACE_AXES[face]
+    assert ua == tu[0] and va == tv[0], (face, tu, tv)
+
+    def lin(m, c):
+        return round(16 * (c - m[1]) / (m[2] - m[1]), 4)
+
+    i, j = AXI[ua], AXI[va]
+    s, e = (frm[i], to[i]) if us == "min" else (to[i], frm[i])
+    s2, e2 = (frm[j], to[j]) if vs == "min" else (to[j], frm[j])
+    return [lin(tu, s), lin(tv, s2), lin(tu, e), lin(tv, e2)]
+
+
+class ModelOut:
+    def __init__(self):
+        self.textures = {}
+        self.elements = []
+
+    def key(self, tex):
+        for k, v in self.textures.items():
+            if v == tex:
+                return k
+        k = f"t{len(self.textures)}"
+        self.textures[k] = tex
+        return k
+
+    def quad(self, frm, to, faces, layer, tu, tv, rot=None):
+        tex, tint = layer
+        k = self.key(tex)
+        fd = {}
+        for f in faces:
+            d = {"texture": "#" + k, "uv": uv_for(f, frm, to, tu, tv)}
+            if tint is not None:
+                d["tintindex"] = tint
+            fd[f] = d
+        e = {"from": [round(c, 4) for c in frm], "to": [round(c, 4) for c in to], "shade": False,
+             "light_emission": 15, "faces": fd}
+        if rot:
+            e["rotation"] = rot
+        self.elements.append(e)
+
+
+def g_flat(m, layers):
+    for L in layers:
+        m.quad([-16, 8, -16], [32, 8, 32], ("up", "down"), L, ("x", -16, 32), ("z", -16, 32))
+
+
+def g_flat_q(m, layers):
+    for L in layers:
+        for (x0, x1) in ((8, 32), (-16, 8)):
+            for (z0, z1) in ((8, 32), (-16, 8)):
+                tu = ("x", 8, x1 if x0 == 8 else x0)
+                tv = ("z", 8, z1 if z0 == 8 else z0)
+                m.quad([x0, 8, z0], [x1, 8, z1], ("up", "down"), L, tu, tv)
+
+
+def g_flat_front(m, layers):
+    # 앞쪽 반원만 (로컬 z 0..1.5 = 모델 z -16..8)
+    for L in layers:
+        m.quad([-16, 8, -16], [32, 8, 8], ("up", "down"), L, ("x", -16, 32), ("z", -16, 8))
+
+
+def g_strip(m, layers):
+    # 폭 1 (x -0.5..0.5), 길이 1 앞으로 (z 0..1)
+    for L in layers:
+        m.quad([0, 8, -8], [16, 8, 8], ("up", "down"), L, ("x", 0, 16), ("z", -8, 8))
+
+
+def g_bill_q(m, layers, size):
+    h = size / 2
+    for L in layers:
+        for (x0, x1) in ((8, 8 + h), (8 - h, 8)):
+            for (y0, y1) in ((8, 8 + h), (8 - h, 8)):
+                tu = ("x", 8, x1 if x0 == 8 else x0)
+                tv = ("y", 8, y1 if y0 == 8 else y0)
+                m.quad([x0, y0, 8], [x1, y1, 8], ("north", "south"), L, tu, tv)
+
+
+def g_bill(m, layers, size):
+    h = size / 2
+    for L in layers:
+        m.quad([8 - h, 8 - h, 8], [8 + h, 8 + h, 8], ("north", "south"), L, ("x", 8 - h, 8 + h), ("y", 8 + h, 8 - h))
+
+
+def g_vbill(m, layers):
+    for L in layers:
+        m.quad([0, 8, 8], [16, 24, 8], ("north", "south"), L, ("x", 0, 16), ("y", 24, 8))
+
+
+def g_beam(m, layers, y=(0, 16), z=(-8, 8)):
+    # 두 판을 Z축 둘레 ±45도로 엇갈려 세운다 (어느 옆에서 봐도 한 판은 보이고, 판이 둘뿐이라 정렬 깨짐이 적다)
+    for L in layers:
+        for ang in (45, -45):
+            m.quad([8, y[0], z[0]], [8, y[1], z[1]], ("east", "west"), L, ("z", z[1], z[0]), ("y", y[1], y[0]),
+                   rot={"origin": [8, 8, 8], "axis": "z", "angle": ang})
+
+
+def g_cut(m, layers):
+    g_beam(m, layers, y=(4, 12), z=(-16, 32))
+
+
+def g_ring_wall(m, layers, R=24.0, y0=8, y1=24, n=16):
+    """둘레 16면의 세로 띠. 텍스처 가로가 한 바퀴(면마다 1/16)."""
+    side = 2 * R * math.sin(math.pi / n) * 1.01
+    apo = R * math.cos(math.pi / n)
+
+    def norm(t):
+        t = t % 180
+        return t - 180 if t > 90 else t
+
+    for L in layers:
+        for k in range(n):
+            phi = 2 * math.pi * k / n
+            cx, cz = 8 + apo * math.cos(phi), 8 + apo * math.sin(phi)
+            deg = math.degrees(phi)
+            ta, tb = norm(-(deg + 90)), norm(-deg)
+            if abs(ta) <= 45.0001:
+                th, frm, to, faces, axis = ta, [cx - side / 2, y0, cz], [cx + side / 2, y1, cz], ("north", "south"), "x"
+            else:
+                th, frm, to, faces, axis = tb, [cx, y0, cz - side / 2], [cx, y1, cz + side / 2], ("east", "west"), "z"
+            # 회전 후 두 끝의 각도를 보고 둘레 방향으로 u 가 k → k+1 이 되게 한다 (이웃 면과 결이 이어진다)
+            i = AXI[axis]
+            t = math.radians(th)
+            ang = []
+            for c in (frm[i], to[i]):
+                dx, dz = (c - cx, 0.0) if axis == "x" else (0.0, c - cz)
+                rx, rz = cx + math.cos(t) * dx + math.sin(t) * dz, cz - math.sin(t) * dx + math.cos(t) * dz
+                ang.append(math.atan2(rz - 8, rx - 8))
+            da = (ang[1] - ang[0] + math.pi) % (2 * math.pi) - math.pi
+            cs, ce = (frm[i], to[i]) if da > 0 else (to[i], frm[i])
+            ln = ce - cs
+            uvm = (axis, cs - k * ln, cs - k * ln + 16 * ln)
+            rot = {"origin": [cx, 16, cz], "axis": "y", "angle": th} if abs(th) > 1e-6 else None
+            m.quad(frm, to, faces, L, uvm, ("y", y1, y0), rot=rot)
+
+
+def g_dome(m, layers):
+    for L in layers:
+        for ang in (0, 45, -45):
+            rot = {"origin": [8, 8, 8], "axis": "y", "angle": ang} if ang else None
+            m.quad([-16, 8, 8], [32, 32, 8], ("north", "south"), L, ("x", -16, 32), ("y", 32, 8), rot=rot)
+        m.quad([8, 8, -16], [8, 32, 32], ("east", "west"), L, ("z", -16, 32), ("y", 32, 8))
+
+
+def g_wave(m, layers, crest):
+    for L in layers:
+        m.quad([-16, 8, 8], [32, 32, 8], ("north", "south"), L, ("x", -16, 32), ("y", 32, 8))
+    for L in crest:
+        # 마루 판은 앞(로컬 +Z = 모델 -Z)으로 22.5도 기운다
+        m.quad([-16, 20, 8], [32, 32, 8], ("north", "south"), L, ("x", -16, 32), ("y", 32, 20),
+               rot={"origin": [8, 20, 8], "axis": "x", "angle": -22.5})
