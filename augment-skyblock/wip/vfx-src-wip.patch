+    static void bossBeam(CastFx fx, Ev.Beam ev, CastFx.Cols k) {
+        Location start = ev.start();
+        Vector dir = ev.dir().clone().normalize();
+        Location end = ev.end();
+        double len = start.distance(end);
+        double w = Math.max(0.8, ev.width());
