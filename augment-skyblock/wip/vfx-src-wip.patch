+    public Sprite grow(int age, int dur, double k) {
+        return key(age, dur, s -> s.sc.mul((float) k));
+    }
+
+    public Sprite moveBy(int age, int dur, double x, double y, double z) {
+        return key(age, dur, s -> s.tr.add((float) x, (float) y, (float) z));
