+    def model(self, mid, geo, layers, defaults=(WHITE, WHITE, DARK), note="", show="frost", parts=None, **gkw):
+        """layers: [(띠, 텍스처 이름)] 아래→위. parts 를 주면 [(geo, layers)] 여러 묶음을 한 모델에 넣는다."""
+        m = ModelOut()
+
+        def conv(ls):
+            return [("augsky:vfx/" + tex, TINT[band]) for band, tex in ls]
+
+        if "crest" in gkw:
+            gkw = dict(gkw, crest=conv(gkw["crest"]))
+        for g, ls in (parts or [(geo, layers)]):
+            g(m, conv(ls), **gkw)
+        all_l = [x for _, ls in (parts or [(geo, layers)]) for x in ls]
+        first = next((t for b, t in all_l if b in ("out", "body", "edge")), all_l[0][1])
+        tx = {"particle": f"{NS}:vfx/{first}"}
+        tx.update(m.textures)
+        write_json(os.path.join(self.a, "models", "vfx", mid + ".json"), {"textures": tx, "elements": m.elements})
+        write_json(os.path.join(self.a, "items", "vfx", mid + ".json"), {"model": {
+            "type": "minecraft:model", "model": f"{NS}:vfx/{mid}",
+            "tints": [{"type": "minecraft:custom_model_data", "index": i, "default": defaults[i]} for i in range(3)]}})
+        self.manifest.append((mid, geo.__name__, note, show))
