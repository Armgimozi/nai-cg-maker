+# ── 속성 고리 ──
+
+def f_ring_frost(X, Y, px, seed=81):
+    ax, ay = np.abs(X), np.abs(Y)
+    r, th = polar(ax, ay)
+    i = f_ring(X, Y, px, r0=0.86, extra=False)
+    rng = np.random.default_rng(seed)
+    segs = []
+    # 4분면 대칭: 0..90도 안에 가시 4개 (총 16개)
+    for k in range(4):
+        a = math.radians(11.25 + 22.5 * k)
+        ln = (0.12, 0.07, 0.10, 0.065)[k]
+        w = math.radians(3.2)
+        base = 0.86
+        tip = (base + ln) * np.array([math.sin(a), math.cos(a)])
+        p0 = base * np.array([math.sin(a - w), math.cos(a - w)])
+        p1 = base * np.array([math.sin(a + w), math.cos(a + w)])
+        i = np.maximum(i, np.where(in_triangle(ax, ay, p0, tip, p1), 0.7, 0))
+        segs += [(*p0, *tip), (*tip, *p1)]
+        tin = (base - ln * 0.6) * np.array([math.sin(a + 0.19), math.cos(a + 0.19)])
+        segs.append((*(base * np.array([math.sin(a + 0.19), math.cos(a + 0.19)])), *tin))
+    D, _ = seg_dist(ax, ay, segs)
+    return np.maximum(i, prof(D, 0.8 * px, 1.8 * px, 2.0 * px))
+
+
+def f_ring_flame(X, Y, px, seed=83):
+    ax, ay = np.abs(X), np.abs(Y)
+    r, th = polar(ax, ay)
+    nz = Noise(seed)
+    i = f_ring(X, Y, px, r0=0.80, extra=False)
+    lick = nz.fbm(th / (math.pi / 2) * 7, 0.5, 3, pu=7)
+    tongue = 0.05 + 0.15 * lick ** 1.4
+    out = r - 0.80
+    f = np.clip(1 - out / tongue, 0, 1)
+    flick = nz.fbm(th / (math.pi / 2) * 20, r * 16, 2, pu=20)
+    fl = np.where(out > -0.02, 0.85 * f ** 1.3 * (0.5 + 0.7 * flick), 0)
+    return np.clip(np.maximum(i, fl), 0, 1)
+
+
+def f_ring_void(X, Y, px, seed=85):
+    ax, ay = np.abs(X), np.abs(Y)
+    r, th = polar(ax, ay)
+    nz = Noise(seed)
+    jag = nz.fbm(th / (math.pi / 2) * 12, 1.0, 2, pu=12)
+    half = 0.025 + 0.03 * jag
+    black = np.where(np.abs(r - 0.88) < half, 1.0, 0)
+    lips = prof(np.abs(np.abs(r - 0.88) - half), 0.6 * px, 1.6 * px, 2.4 * px)
+    tend = nz.fbm(th / (math.pi / 2) * 30, r * 20, 2, pu=30)
+    wisp = np.where(r > 0.88, 0.5 * smooth(0.55, 0.8, tend) * np.exp(-(r - 0.88) / 0.04), 0)
+    wisp_in = np.where(r < 0.88, 0.45 * np.exp(-(0.88 - r) / 0.05) * (0.5 + 0.5 * tend), 0)
+    i = np.where(black > 0, 0, np.maximum(np.maximum(lips, wisp), wisp_in))
+    return {"I": i, "black": black}
