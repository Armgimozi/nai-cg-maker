+        Block b = g.clone().add(0, -1, 0).getBlock();
+        Material m = b.getType();
+        if (!m.isSolid() || !m.isOccluding() || b.getState() instanceof org.bukkit.block.TileState) return fallback;
+        return m;
+    }
+
+    // ------------------------------------------------------------------ 조각 (팩 모델)
