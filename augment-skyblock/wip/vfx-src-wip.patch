+#!/usr/bin/env python3
+"""
+스킬 이펙트(VFX) 스프라이트 생성기 — 텍스처, 모델, 아이템 정의를 코드로 만든다.
+gen_pack.main() 이 build(a) 와 preview(...) 를 부른다. 따로 돌리면 미리보기만 만든다:
+  python3 vfx_assets.py <출력 폴더> [미리보기.png]
+
+플러그인은 PAPER 아이템에 item_model "augsky:vfx/<id>" 를 붙여 ItemDisplay 로 띄우고
+(ItemDisplayTransform.NONE, Brightness 15), custom_model_data 색 [a, b, dark] 로 칠한다 (tints 0/1/2).
+  0 a    = 바깥 빛 (속성 주색)
+  1 b    = 안쪽 띠 (밝은 보조색)
+  2 dark = 가장자리 테. 낮엔 어두운 색(하늘 앞에서 또렷), 밤·네더엔 a 를 주면 바깥 빛이 된다
+  흰 심(core)·무지개 몸통·검은 심(공허)은 칠하지 않는다. 색을 안 주면 흰색/흰색/#222222.
+  예외: warn·warn_fill·warn_line 기본색 = 위험 빨강 #FF3B1F / 노랑 안쪽선 #FFD23F / 검정 테
+        (속성색과 상관없이 같은 경고. 마지막 몇 틱엔 0 번을 흰색으로 깜빡이면 된다),
+        moon 은 원판 = 1, 분화구 = 0.
+
+좌표 약속 — Transformation 이 보는 디스플레이 로컬 좌표. 아이템 디스플레이가 모델을 Y축으로 180도
+돌려 그리는 것을 모델에 미리 반영했으니 Rigs 의 FLIP 을 곱하지 않는다 (실제 클라이언트에서 확인).
+  +Y 위, +Z 앞(진행 방향), +X 는 앞을 봤을 때 왼쪽 → 회전 행렬의 열 = (왼쪽, 위, 앞).
+  Y축 양의 회전 = 위에서 볼 때 반시계(앞 → 왼쪽).
+
+모델 크기 (scale 1 일 때)
+  바닥 그림(y=0 평면, 반지름 1.5 = 지름 3, scale = 반지름/1.5. 위·아랫면이 같은 그림이라 아래서 봐도 앞뒤 그대로):
+    ring* 밝은 선이 반지름 0.95×1.5. shock* 앞 가장자리 0.95. warn 테 0.9~0.985. circle 바깥 테 0.955.
+    slash* 앞쪽 반원만(z 0..1.5): 160도 초승달, 바깥 날 0.965×1.5, 끝은 앞에서 ±80도.
+      slash_w1→w2→w3→slash 를 한 틱씩 바꾸면 왼쪽(+X)에서 오른쪽(-X)으로 그어진다. 반대는 scale.x 를 음수로.
+    slash_wide* 330도 회오리: 머리 = 앞, 위에서 볼 때 시계 방향(앞 → 오른쪽)으로 도는 모양, 꼬리가 왼쪽으로 감긴다.
+    swirl* 팔이 바깥으로 갈수록 반시계로 감긴다 → 시계 방향(Y축 음의 회전)으로 돌리면 팔이 끌려가며 빨려든다.
+    warn_line: 폭 1 (x -0.5..0.5), 원점에서 앞으로 길이 1 (z 0..1), 화살이 앞을 가리킨다. scale = (폭, 1, 길이).
+  빌보드(Billboard.CENTER, 원점 중심): star* 2블록, orb*·spark·void_orb 1블록, sun*·moon* 3블록.
+  세로 빌보드(Billboard.VERTICAL): pillar·bolt·flame — x -0.5..0.5, 바닥 y=0 에서 위로 1. scale = (폭, 높이, 1).
+    bolt 는 높이:폭 8:1 일 때 지그재그가 자연스럽다.
+  빔: beam·beam_rainbow·rift — 원점에서 앞으로 z 0..1, 단면 폭 1 (±45도로 엇갈린 두 판). scale = (폭, 폭, 길이).
+  cut: 엇갈린 두 판의 렌즈 칼선, 길이 3 (z -1.5..1.5) 두께 0.5. 세우면 차원문 틈.
+  ring_wall: 반지름 1.5, 높이 1 (바닥 y=0)의 세로 빛 장막 16면. dome: 반지름·높이 1.5 반구 (반원 판 4장).
+  wave: 폭 3 (x ±1.5), 높이 1.5 의 물 벽 + 앞으로 22.5도 기운 물보라 판. 앞(+Z)으로 밀고 간다.
+
+사라지는 단계: <id>_dim(55%)·<id>_faint(25%) 를 갈아 끼우며 조금씩 키우면 줄어들며 빨려드는 느낌이 없다.
+  흐린 단계는 투명도를 낮춘 판이 아니라 번짐을 잘라 낸 가는 선(진한 알파)이고, 한 단계 식은 색으로 칠한다
+  (_faint 는 가장 밝은 심선만 남아, 시전자 발밑에 깔아도 1인칭 바닥을 덮지 않는다):
+  0 번(a) = 남은 선, 1 번(b) = 가장 밝은 심. 원본과 같은 해상도라 큰 판에서도 픽셀 덩어리가 보이지 않는다.
+터짐 그림책(한 틱씩): star_f1→star_f2→star_f3, shock_f1→shock→shock_f2→shock_f3.
+반복 애니메이션(mcmeta, 1틱): beam·beam_rainbow·pillar·flame 8장, bolt·rift 4장.
+
+알파 표시 (pack/shaders/rendertype_item_entity_translucent_cull.fsh 가 읽는다):
+  252           = 불투명하게 스스로 빛남 (예전 무기 빛과 같다)
+  17..30 + RGB 가 모두 짝수 = 반투명하게 스스로 빛남, 알파 (값-16)/15
+  셰이더가 없는 클라이언트(셰이더팩 등)에서는 17..30 이 거의 안 보이고 252 만 평범하게 그려진다.
+  아주 옅은 픽셀(알파 0.28 미만)은 만들지 않는다 — 깊이를 써서 뒤의 입자를 가리지 않게.
+"""
+import colorsys
+import json
+import math
+import os
+import sys
+
+import numpy as np
+from PIL import Image, ImageDraw, ImageFilter, ImageFont
+
+NS = "augsky"
+HERE = os.path.dirname(os.path.abspath(__file__))
+
+# 띠 이름 → tintindex (None = 칠하지 않음)
+TINT = {"rim": 2, "out": 0, "in": 1, "core": None, "body": None, "black": None,
+        "edge": 0, "accent": 1}
+# 띠를 그리는 순서 (아래 → 위). 같은 평면이라 가려지지 않지만 미리보기 정렬에 쓴다
+ORDER = ["rim", "black", "out", "body", "in", "edge", "accent", "core"]
+
+
+# ─────────────────────────── 알파 표시 ───────────────────────────
+
+def marks(a):
+    """0..1 알파 → 셰이더가 읽는 알파 바이트. 너무 옅은 곳은 비운다(깊이를 써서 뒤 입자를 가리지 않게)."""
+    a = np.asarray(a, dtype=np.float32)
+    k = np.clip(np.round(a * 15.0), 0, 14)
+    return np.where(a >= 0.95, 252, np.where(k >= 1, 16 + k, 0)).astype(np.uint8)
+
+
+def decode_alpha(arr):
+    """미리보기용: 텍스처 RGBA → 실제 그려질 알파(0..1). 게임 셰이더와 같은 규칙."""
+    a = arr[..., 3].astype(np.int32)
+    even = np.all(arr[..., :3] % 2 == 0, axis=-1)
+    out = a / 255.0
+    out = np.where((a >= 17) & (a <= 30) & even, (a - 16) / 15.0, out)
+    out = np.where(a == 252, 1.0, np.where(a == 251, 0.75, np.where(a == 250, 0.5, out)))
+    return out
+
+
+def to_rgba(alpha, rgb=None):
+    """알파 배열(+색) → RGBA 이미지. 색은 짝수로 맞춘다(반투명 빛 표시)."""
+    m = marks(alpha)
+    h, w = m.shape
+    if rgb is None:
+        c = np.full((h, w, 3), 254, np.uint8)
+    else:
+        c = (np.clip(rgb, 0, 255).astype(np.uint8) // 2) * 2
+    c = np.where(m[..., None] == 0, 0, c).astype(np.uint8)
+    return Image.fromarray(np.dstack([c, m]), "RGBA")
+
+
+# ─────────────────────────── 수학 도구 ───────────────────────────
+
+def smooth(e0, e1, x):
+    t = np.clip((x - e0) / (e1 - e0), 0.0, 1.0)
+    return t * t * (3 - 2 * t)
+
+
+def grid(w, h, ss, x0=-1.0, x1=1.0, y0=-1.0, y1=1.0):
+    """초과표본 격자. 열 → x(오른쪽 +), 행 → y(맨 윗줄이 y1 = 앞/위)."""
+    xs = x0 + (np.arange(w * ss, dtype=np.float32) + 0.5) / (w * ss) * (x1 - x0)
+    ys = y1 - (np.arange(h * ss, dtype=np.float32) + 0.5) / (h * ss) * (y1 - y0)
+    return np.meshgrid(xs, ys)
+
+
+def down(f, ss):
+    if ss == 1:
+        return f
+    h, w = f.shape[0] // ss, f.shape[1] // ss
+    return f.reshape(h, ss, w, ss).mean(axis=(1, 3))
+
+
+class Noise:
+    """값 노이즈. 주기(pu, pv)를 주면 그 격자 간격으로 이어진다(각도·애니메이션 반복용)."""
+
+    def __init__(self, seed, n=256):
+        self.t = np.random.default_rng(seed).random((n, n)).astype(np.float32)
+        self.n = n
+
+    def __call__(self, u, v, pu=None, pv=None):
+        pu, pv = pu or self.n, pv or self.n
+        iu, iv = np.floor(u).astype(np.int64), np.floor(v).astype(np.int64)
+        fu, fv = u - iu, v - iv
+        su, sv = fu * fu * (3 - 2 * fu), fv * fv * (3 - 2 * fv)
+
+        def g(a, b):
+            return self.t[(b % pv) % self.n, (a % pu) % self.n]
+
+        top = g(iu, iv) * (1 - su) + g(iu + 1, iv) * su
+        bot = g(iu, iv + 1) * (1 - su) + g(iu + 1, iv + 1) * su
+        return top * (1 - sv) + bot * sv
+
+    def fbm(self, u, v, octaves=3, pu=None, pv=None, gain=0.5):
+        tot, amp, norm = 0.0, 1.0, 0.0
+        for o in range(octaves):
+            f = 2 ** o
+            tot = tot + amp * self(u * f + 17.3 * o, v * f + 9.1 * o,
+                                   None if pu is None else pu * f, None if pv is None else pv * f)
+            norm += amp
+            amp *= gain
+        return tot / norm
+
+
+def prof(d, core, body, glow, peak=1.0):
+    """선에서의 거리 d → 밝기. core 안 = 흰 심(1), body 까지 = b 띠, 그 밖은 a 로 지수 감쇠."""
+    body = max(body, core + 1e-6)
+    i = np.where(d <= core, 1.0,
+                 np.where(d <= body, 0.80 - 0.26 * (d - core) / (body - core),
+                          0.52 * np.exp(-(d - body) / glow)))
+    return i * peak
+
+
+def seg_dist(X, Y, segs, big=9.0):
+    """여러 선분까지의 최소 거리와, 가장 가까운 선분의 진행 비율 t."""
+    D = np.full(X.shape, big, np.float32)
+    T = np.zeros(X.shape, np.float32)
+    for (ax, ay, bx, by) in segs:
+        dx, dy = bx - ax, by - ay
+        l2 = dx * dx + dy * dy or 1e-12
+        t = np.clip(((X - ax) * dx + (Y - ay) * dy) / l2, 0, 1)
+        d = np.hypot(X - (ax + t * dx), Y - (ay + t * dy))
+        closer = d < D
+        D = np.where(closer, d, D)
+        T = np.where(closer, t, T)
+    return D, T
+
+
+def polar(X, Y):
+    """r, 앞(+Y)에서 오른쪽(+X)으로 잰 각도(라디안)."""
+    return np.hypot(X, Y), np.arctan2(X, Y)
+
+
+def hue_rgb(h, s=1.0, v=1.0):
+    """색상 배열 → RGB 배열 (0..255)."""
+    h = np.mod(h, 1.0)
+    i = np.floor(h * 6).astype(int) % 6
+    f = h * 6 - np.floor(h * 6)
+    p, q, t = v * (1 - s), v * (1 - s * f), v * (1 - s * (1 - f))
+    r = np.choose(i, [v, q, p, p, t, v])
+    g = np.choose(i, [t, v, v, q, p, p])
+    b = np.choose(i, [p, p, t, v, v, q])
+    return np.dstack([r, g, b]) * 255.0
+
+
+def dilate(mask, r):
+    """불리언 마스크를 r 픽셀 넓힌 단계들 (1..r)."""
+    img = Image.fromarray(mask.astype(np.uint8) * 255, "L")
+    out = []
+    for k in range(1, r + 1):
+        out.append(np.array(img.filter(ImageFilter.MaxFilter(2 * k + 1))) > 0)
+    return out
+
+
+# ─────────────────────────── 밝기 → 띠 나누기 ───────────────────────────
+
+CUT, T_IN, T_CORE = 0.16, 0.52, 0.80
+
+
+def split(I, rim=2, rim_alpha=0.5, fade=1.0, core=True, cut=CUT, out_lo=0.28, in_alpha=1.0):
+    """
+    밝기 I(0..1) → 띠별 알파. 띠끼리 겹치지 않아(같은 평면이어도 깜빡이지 않는다) 함께 그리면 한 장 그림이 된다.
+      core ≥ 0.80 흰 심 / in 0.52~0.80 b / out 0.16~0.52 a (옅어지며) / rim = 바깥 1~rim 픽셀 dark
+    """
+    vis = I >= cut
+    cm = (I >= T_CORE) if core else np.zeros_like(vis)
+    im = (I >= T_IN) & ~cm
+    om = vis & ~im & ~cm
+    t = np.clip((I - cut) / (T_IN - cut), 0, 1)
+    out = {
+        "out": np.where(om, (out_lo + (1 - out_lo) * t ** 0.85) * fade, 0),
+        "in": np.where(im, in_alpha * fade, 0),
+    }
+    if core:
+        out["core"] = np.where(cm, fade, 0)
+    if rim and fade >= 0.99:
+        ra = np.zeros(I.shape, np.float32)
+        prev = vis
+        for k, m in enumerate(dilate(vis, rim)):
+            ring = m & ~prev
+            ra = np.where(ring, rim_alpha * (1 - 0.3 * k / max(rim - 1, 1)), ra)
+            prev = m
+        out["rim"] = ra
+    return out
+
+
+# ─────────────────────────── 그림(밝기장) ───────────────────────────
+# 모두 (X, Y, px) 를 받는다. px = 출력 한 픽셀의 크기(정규화 좌표). 밝기 I 또는 {띠: (알파, 색)} 를 돌려준다.
+
+def f_ring(X, Y, px, r0=0.95, extra=True):
+    r = np.hypot(X, Y)
+    d = r - r0
+    # 바깥으로는 짧게, 안쪽으로 길게 번진다 (퍼지는 테두리 느낌)
+    i = np.where(d >= 0, prof(d, 1.3 * px, 3.2 * px, 1.6 * px), prof(-d, 1.3 * px, 3.6 * px, 6.0 * px))
+    if extra:
+        i = np.maximum(i, prof(np.abs(r - (r0 - 0.075)), 0, 0.7 * px, 1.4 * px, 0.55))
+    return i
+
+
+def f_shock(X, Y, px, edge=0.95, inner=0.42, seed=3, streak=1.0, thick=1.0, heat=1.0, broken=0.0, sym=True):
+    if sym:  # 4분할 텍스처: 네 귀퉁이 대칭
+        r, th = polar(np.abs(X), np.abs(Y))
+        per, qa = 22, math.pi / 2
+    else:  # 흩어지는 단계는 대칭이 보이지 않게 전체로 그린다
+        r, th = polar(X, Y)
+        th = th + math.pi
+        per, qa = 64, 2 * math.pi
+    nz = Noise(seed)
+    s = nz.fbm(th / qa * per, r * 3.0, 3, pu=per)  # 방사형 줄무늬
+    trail = np.clip((r - inner) / (edge - inner), 0, 1)
+    if broken > 0:
+        # 흩어지는 단계: 몸통은 가는 방사 줄만 남는다 (덩어리 대신 결)
+        body = 0.6 * heat * trail ** 1.4 * smooth(0.62, 0.88, s) * streak
+    else:
+        body = 0.62 * heat * trail ** (1.6 / thick) * (0.55 + 0.75 * s * streak + (1 - streak) * 0.3)
+    body = np.where(r <= edge, body, 0)
+    d = r - edge
+    line = np.where(d >= 0, prof(d, 1.6 * px * thick, 3.5 * px * thick, 1.8 * px),
+                    prof(-d, 1.6 * px * thick, 5.0 * px * thick, 5.0 * px))
+    line = line * heat
+    if broken > 0:
+        b = nz.fbm(th / qa * (7 if sym else 20) + 40, 0.3, 2, pu=7 if sym else 20)
+        line = line * smooth(broken - 0.06, broken + 0.06, b)
+    return np.maximum(line, body)
+
+
+def f_star(X, Y, px, L=0.97, Ls=0.58, core=0.10, rw=0.075, rws=0.055, glow=0.26, broken=False, seed=5):
+    ax, ay = np.abs(X), np.abs(Y)
+    r = np.hypot(ax, ay) + 1e-6
+    i = np.zeros_like(r)
+    # 가로세로 긴 빛살 + 대각 짧은 빛살 (끝으로 갈수록 가늘고 옅다)
+    for (dx, dy, length, width) in ((1, 0, L, rw), (0, 1, L, rw), (0.7071, 0.7071, Ls, rws)):
+        if length <= 0:
+            continue
+        along = ax * dx + ay * dy
+        perp = np.abs(ax * dy - ay * dx)
+        t = np.clip(along / length, 0, 1)
+        wid = width * (1 - t) ** 1.2 + 0.4 * px
+        ray = np.exp(-(perp / wid) ** 2) * (1 - t) ** 1.6
+        ray = np.where(along > 0, ray, 0)
+        if broken:
+            nz = Noise(seed + int(dx * 10))
+            ray = ray * smooth(0.35, 0.6, nz(along * 14, 3.0))
+        i = np.maximum(i, ray * 1.05)
+    i = np.maximum(i, np.where(r < core, 1.0, 0.95 * np.exp(-(np.maximum(r - core, 0) / glow) ** 1.3)))
+    return np.clip(i, 0, 1)
+
+
+def f_spark(X, Y, px):
+    return f_star(X, Y, px, L=0.97, Ls=0.34, core=0.05, rw=0.05, rws=0.035, glow=0.12)
+
+
+def f_orb(X, Y, px):
+    r = np.hypot(X, Y)
+    return np.where(r < 0.2, 1.0, np.where(r < 0.36, 0.80 - 0.28 * (r - 0.2) / 0.16,
+                                           0.52 * np.exp(-(np.maximum(r - 0.36, 0) / 0.17) ** 1.4)))
+
+
+def f_void_orb(X, Y, px, seed=11):
+    r, th = polar(np.abs(X), np.abs(Y))
+    nz = Noise(seed)
+    hole = 0.50
+    d = r - hole
+    i = np.where(d >= 0, prof(d, 1.2 * px, 3.0 * px, 0.06 + 0.05 * nz.fbm(th * 6, r * 4, 2)), 0)
+    i = np.where(r < hole, 0, i)
+    black = np.where(r < hole + 0.2 * px, 1.0, 0)
+    return {"I": i, "black": black}
+
+
+def f_sun(X, Y, px, seed=21):
+    r, th = polar(np.abs(X), np.abs(Y))
+    nz = Noise(seed)
+    disc = 0.30
+    i = np.where(r < 0.17, 1.0, np.where(r < disc, 0.79 - 0.2 * (r - 0.17) / (disc - 0.17), 0))
+    # 코로나: 각도 노이즈로 길이가 다른 빛살
+    k = nz.fbm(th / (math.pi / 2) * 10, 0.5, 2, pu=10)
+    rays = 0.6 * np.exp(-np.maximum(r - disc, 0) / (0.08 + 0.32 * k ** 2)) * (0.65 + 0.35 * np.cos(th * 16) ** 2)
+    corona = 0.5 * np.exp(-np.maximum(r - disc, 0) / 0.08)
+    i = np.where(r >= disc, np.maximum(rays, corona), i)
+    # 대각선 렌즈 빛
+    i = np.maximum(i, f_star(X, Y, px, L=0.98, Ls=0.75, core=0.0, rw=0.02, rws=0.016, glow=0.01) * 0.75)
+    return np.clip(i, 0, 1)
+
+
+def f_moon(X, Y, px, seed=31):
+    r = np.hypot(X, Y)
+    rng = np.random.default_rng(seed)
+    disc = 0.58
+    i = np.where(r < disc, 0.70, 0)
+    # 둥근 가장자리 빛 (오른쪽 위가 더 밝다)
+    lim = np.clip((r - (disc - 0.07)) / 0.07, 0, 1) * (0.55 + 0.45 * np.clip((X + Y) / (1.4 * disc), -1, 1))
+    i = np.where(r < disc, np.maximum(i, 0.70 + 0.3 * lim), i)
+    halo = 0.5 * np.exp(-np.maximum(r - disc, 0) / 0.09)
+    i = np.where(r >= disc, halo, i)
+    crater = np.zeros_like(r)
+    for _ in range(9):
+        a, rr = rng.uniform(0, 2 * math.pi), rng.uniform(0, disc * 0.75)
+        cx, cy, cr = rr * math.sin(a), rr * math.cos(a), rng.uniform(0.04, 0.13)
+        dd = np.hypot(X - cx, Y - cy)
+        crater = np.maximum(crater, np.where(dd < cr, 0.55 + 0.25 * (1 - dd / cr), 0))
+    crater = np.where(r < disc - 0.03, crater, 0)
+    # 분화구는 a 띠(밝기 0.4~0.47)로 칠해 밤낮 모두 원판(b)보다 짙게 보인다
+    return np.where(crater > 0, 0.40 + 0.07 * (crater - 0.55) / 0.25, i)
+
+
+# ── 베기 ──
+
+def crescent(X, Y, R=0.965, T=0.34, tip=math.radians(80)):
+    """두 원으로 만든 초승달: u(바깥 가장자리 0 → 안쪽 1), 각도, 두께."""
+    zt = R * math.cos(tip)
+    d = (2 * R * T - T * T) / (2 * (R - T - zt))
+    Ri = R + d - T
+    r, th = polar(X, Y)
+    c = np.cos(th)
+    t_in = -d * c + np.sqrt(np.maximum(d * d * c * c - d * d + Ri * Ri, 0))
+    thick = np.maximum(R - t_in, 1e-4)
+    u = (R - r) / thick
+    return u, th, thick, r
+
+
+def f_slash(X, Y, px, seed=41, wipe=None, frost=False, flame=False, void=False):
+    # 속성 모양이 바깥으로 튀어나올 자리를 남기려고 속성 베기는 초승달을 조금 작게 그린다
+    R = 0.965 if not (frost or flame) else (0.895 if frost else 0.80)
+    u, th, thick, r = crescent(X, Y, R=R)
+    tipa = math.radians(80)
+    nz = Noise(seed)
+    along = smooth(tipa, tipa - math.radians(34), np.abs(th))  # 끝으로 갈수록 가늘고 옅게
+    # 날 가장자리: 바깥 테두리 바로 안쪽의 흰 칼선
+    edge_d = np.abs(u - 0.06) * thick
+    i_edge = prof(edge_d, 1.6 * px, 3.6 * px, 3.0 * px)
+    # 몸통: 칼선 쪽은 b 로 뜨겁고 안쪽(뒤)으로 a 로 식으며, 결(속도선)과 들쭉날쭉한 꼬리가 있다
+    streak = nz.fbm(r * 46, th * 2.2, 3)
+    tail = 0.82 + 0.25 * nz.fbm(th * 7 + 3, 2.0, 2)
+    body = 0.90 * np.clip(1 - u / tail, 0, 1) ** 1.1 * (0.58 + 0.58 * streak)
+    body = np.where((u >= 0) & (u <= 1), body, 0)
+    outside = np.where(u < 0, 0.5 * np.exp(np.minimum(u, 0) * thick / (2.2 * px)), 0)  # 바깥으로 아주 짧은 번짐
+    i = np.maximum(np.maximum(i_edge, body), outside) * along
+    # 굵은 속도선 몇 가닥
+    rng = np.random.default_rng(seed)
+    for _ in range(6):
+        uu = rng.uniform(0.25, 0.75)
+        a0, a1 = sorted(rng.uniform(-60, 60, 2))
+        a0, a1 = math.radians(a0), math.radians(max(a1, a0 + 25))
+        line = prof(np.abs(u - uu) * thick, 0.5 * px, 1.3 * px, 1.8 * px, rng.uniform(0.6, 0.9))
+        line = line * smooth(a0 - 0.05, a0 + 0.12, th) * smooth(a1 + 0.05, a1 - 0.12, th)
+        i = np.maximum(i, line * along)
+    if frost:
+        i = np.maximum(i, frost_shards(X, Y, px, r, th, R, seed) * smooth(tipa + 0.05, tipa - 0.35, np.abs(th)))
+    if flame:
+        i = flame_edge(i, X, Y, px, r, th, u, thick, seed, along, R)
+    if wipe is not None:
+        # 휘두르는 중: 왼쪽 끝(-80도)에서 wipe 각도까지만, 머리 부분이 하얗게 달아오른다
+        w = math.radians(wipe)
+        rev = smooth(w + 0.10, w - 0.03, th)
+        head = np.exp(-((th - w) / 0.09) ** 2) * np.clip(1.1 - u, 0, 1) * np.where((u > -0.1) & (u < 1.0), 1, 0)
+        i = np.maximum(i * rev * (0.55 + 0.45 * smooth(w - 1.4, w, th)), head * 0.95 * along)
+    if void:
+        # 공허: 칼선 자리에 검은 틈, 그 양옆에 가는 빛, 바깥으로 새는 덩굴
+        jag = Noise(seed + 7)(th * 30, 1.0)
+        half = 0.07 + 0.06 * jag * along
+        crack = np.where((np.abs(u - 0.19) < half) & (along > 0.35), 1.0, 0)
+        lips = prof(np.abs(np.abs(u - 0.19) - half) * thick, 0.6 * px, 1.6 * px, 2.0 * px)
+        tend = Noise(seed + 9).fbm(th * 40, r * 30, 2)
+        out_t = np.where((u < 0) & (u > -0.25), 0.5 * smooth(0.5, 0.8, tend) * np.exp(np.minimum(u, 0) * 6), 0) * along
+        i = np.maximum(np.maximum(i * 0.9, lips * along), out_t)
+        return {"I": np.where(crack > 0, 0, i), "black": crack}
+    return i
+
+
+def frost_shards(X, Y, px, r, th, R, seed):
+    """서리: 바깥 가장자리를 따라 솟은 얼음 결정(삼각 가시) + 결정 면을 가르는 곧은 선 + 반짝임."""
+    rng = np.random.default_rng(seed + 100)
+    out = np.zeros_like(r)
+    segs = []
+    n = 13
+    for k in range(n):
+        a = math.radians(-70 + 140 * (k + rng.uniform(-0.3, 0.3)) / (n - 1))
+        fall = 1 - (abs(a) / math.radians(88)) ** 2
+        ln = (rng.uniform(0.07, 0.095) if k % 2 == 0 else rng.uniform(0.035, 0.055)) * fall + 0.012
+        w = math.radians(rng.uniform(2.6, 4.0) if k % 2 == 0 else rng.uniform(1.8, 2.6))
+        base = R - 0.025
+        lean = rng.uniform(-1.2, 1.2) * w
+        tip = (base + ln) * np.array([math.sin(a + lean), math.cos(a + lean)])
+        p0 = base * np.array([math.sin(a - w), math.cos(a - w)])
+        p1 = base * np.array([math.sin(a + w), math.cos(a + w)])
+        tri = in_triangle(X, Y, p0, tip, p1)
+        # 가시 안쪽: 가운데 능선이 밝고 가장자리는 b
+        out = np.maximum(out, np.where(tri, 0.66, 0))
+        mid = (p0 + p1) / 2
+        segs.append((mid[0], mid[1], tip[0], tip[1]))
+    D, _ = seg_dist(X, Y, segs)
+    out = np.maximum(out, prof(D, 0.7 * px, 1.4 * px, 1.6 * px) * (r > R - 0.05))
+    # 몸통 안의 결정 면 (꺾인 직선)
+    fac = []
+    for k in range(7):
+        a = math.radians(rng.uniform(-55, 55))
+        r0 = R - rng.uniform(0.05, 0.09)
+        r1 = r0 - rng.uniform(0.07, 0.14)
+        b = a + rng.choice([-1, 1]) * rng.uniform(0.08, 0.16)
+        fac.append((r0 * math.sin(a), r0 * math.cos(a), r1 * math.sin(b), r1 * math.cos(b)))
+    D, _ = seg_dist(X, Y, fac)
+    out = np.maximum(out, prof(D, 0.4 * px, 1.0 * px, 1.4 * px, 0.85))
+    # 반짝임
+    for _ in range(9):
+        a = math.radians(rng.uniform(-60, 60))
+        rr = R - rng.uniform(0.02, 0.2)
+        sx, sy = rr * math.sin(a), rr * math.cos(a)
+        sz = rng.uniform(0.025, 0.045)
+        out = np.maximum(out, 0.95 * f_star((X - sx) / sz, (Y - sy) / sz, px / sz, L=0.95, Ls=0.0, core=0.12,
+                                            rw=0.12, rws=0.0, glow=0.08))
+    return out
+
+
+def in_triangle(X, Y, a, b, c):
+    def s(p1, p2):
+        return (X - p2[0]) * (p1[1] - p2[1]) - (p1[0] - p2[0]) * (Y - p2[1])
+    d1, d2, d3 = s(a, b), s(b, c), s(c, a)
+    neg = (d1 < 0) | (d2 < 0) | (d3 < 0)
+    pos = (d1 > 0) | (d2 > 0) | (d3 > 0)
+    return ~(neg & pos)
+
+
+def flame_edge(i, X, Y, px, r, th, u, thick, seed, along, R):
+    """화염: 바깥 가장자리가 불꽃 혀로 갈라져 날름거린다 + 불티."""
+    nz = Noise(seed + 200)
+    lick = nz.fbm(th * 16, 0.3, 3)  # 각도마다 불꽃 길이 (봉우리가 뾰족한 혀가 된다)
+    room = 0.985 - R
+    tongue = room * (0.12 + 0.95 * smooth(0.30, 0.78, lick))
+    outside = r - R
+    f = np.clip(1 - outside / np.maximum(tongue, 1e-3), 0, 1)
+    flick = nz.fbm(th * 30, r * 22, 2)
+    shape = f ** 1.1 * (0.6 + 0.6 * flick)
+    fl = np.where(outside > -0.03, 0.95 * shape, 0) * smooth(math.radians(84), math.radians(55), np.abs(th))
+    i = np.maximum(i, fl)
+    rng = np.random.default_rng(seed + 300)
+    for _ in range(22):
+        a = rng.uniform(-1.25, 1.25)
+        rr = R + rng.uniform(0.0, room) * (1 - abs(a) / 1.5)
+        cx, cy = rr * math.sin(a), rr * math.cos(a)
+        if abs(cx) > 0.97 or cy > 0.985 or cy < 0.03:
+            continue
+        d = np.hypot(X - cx, Y - cy)
+        i = np.maximum(i, prof(d, 0.7 * px, 1.5 * px, 1.0 * px, rng.uniform(0.62, 0.95)))
+    return i
+
+
+def f_slash_wide(X, Y, px, seed=51):
+    """330도 회오리 베기. 머리 = 앞(위쪽), 위에서 볼 때 시계 방향으로 돈다:
+    머리 뒤(왼쪽)로 꼬리가 반시계로 감겨 돌아와 머리 오른쪽 30도에서 끝난다."""
+    r, th = polar(X, Y)
+    sweep = math.radians(330)
+    s_ = np.mod(-th, 2 * math.pi)  # 머리에서 뒤로 잰 각도 0..2π
+    s_ = np.where(s_ > math.radians(345), s_ - 2 * math.pi, s_)  # 머리 바로 앞은 음수 (둥근 끝)
+    prog = np.clip(1 - s_ / sweep, 0, 1)  # 머리 1 → 꼬리 0
+    Rr = 0.78 + 0.185 * prog
+    T = 0.04 + 0.32 * prog ** 1.25
+    T = np.maximum(T * smooth(-0.03, 0.42, s_) ** 0.6, 1e-3)  # 머리는 뾰족하게
+    u = (Rr - r) / T
+    nz = Noise(seed)
+    cap = 1.0
+    tail = smooth(0.0, 0.3, prog)
+    edge = prof(np.abs(u - 0.07) * T, 1.5 * px, 3.4 * px, 3.0 * px)
+    streak = nz.fbm(r * 46, s_ * 3, 3)
+    body = 0.9 * np.clip(1 - u / 0.9, 0, 1) ** 1.1 * (0.58 + 0.58 * streak)
+    body = np.where((u >= 0) & (u <= 1), body, 0)
+    outside = np.where(u < 0, 0.5 * np.exp(np.minimum(u, 0) * T / (2.2 * px)), 0)
+    i = np.maximum(np.maximum(edge * (0.45 + 0.55 * prog), body), outside) * tail * cap
+    return np.where((s_ > sweep) | (s_ < -0.02), 0, i)
+
+
+def f_cut(X, Y, px):
+    """가는 렌즈 모양 칼선 (가로 = 길이)."""
+    t = np.clip(np.abs(X), 0, 1)
+    half = 0.62 * (1 - t ** 2) ** 0.9
+    d = np.abs(Y)
+    core = 0.10 * (1 - t ** 2) + 0.5 * px
+    i = np.where(d <= core, 1.0, np.where(d <= half, 0.80 - 0.28 * (d - core) / np.maximum(half - core, 1e-3), 0))
+    i = np.where(d > half, 0.52 * np.exp(-(d - half) / (2 * px)) * (1 - t), i)
+    return i * smooth(1.0, 0.85, np.abs(X))
+
+
+# ── 마법진 ──
+
+GLYPHS = [  # 룬 획 (0..1 사각형, x = 옆, y = 바깥쪽). 굵은 선 몇 개로 단순하게
+    [(0.5, 0, 0.5, 1), (0.5, 0.7, 0.9, 0.95), (0.5, 0.4, 0.9, 0.65)],
+    [(0.3, 0, 0.3, 1), (0.3, 1, 0.8, 0.6), (0.8, 0.6, 0.3, 0.3)],
+    [(0.5, 0, 0.5, 1), (0.1, 0.75, 0.9, 0.25)],
+    [(0.2, 0, 0.2, 1), (0.8, 0, 0.8, 1), (0.2, 0.5, 0.8, 0.5)],
+    [(0.5, 0, 0.5, 1), (0.15, 1, 0.5, 0.6), (0.85, 1, 0.5, 0.6)],
+    [(0.2, 0, 0.8, 1), (0.8, 0, 0.2, 1)],
+    [(0.5, 0, 0.5, 1), (0.5, 0.5, 0.9, 0.85), (0.5, 0.5, 0.1, 0.15)],
+    [(0.2, 0.0, 0.2, 1), (0.2, 1, 0.8, 0.75), (0.2, 0.5, 0.8, 0.75)],
+    [(0.5, 0, 0.1, 0.5), (0.1, 0.5, 0.5, 1), (0.5, 1, 0.9, 0.5), (0.9, 0.5, 0.5, 0)],
+    [(0.5, 0, 0.5, 1), (0.1, 0.65, 0.9, 0.65), (0.2, 0.2, 0.8, 0.2)],
+    [(0.15, 0, 0.5, 1), (0.5, 1, 0.85, 0), (0.3, 0.45, 0.7, 0.45)],
+    [(0.5, 0, 0.5, 0.6), (0.5, 0.6, 0.15, 1), (0.5, 0.6, 0.85, 1)],
+]
+
+
+def rune_ring(n, rc, h, wfrac, offset=0.0, glyphs=None):
+    """반지름 rc 둘레에 n 개의 룬 선분 목록 (바깥쪽이 룬의 위)."""
+    segs = []
+    gl = glyphs or GLYPHS
+    for k in range(n):
+        a = 2 * math.pi * (k + 0.5) / n + offset
+        out = np.array([math.sin(a), math.cos(a)])
+        side = np.array([math.cos(a), -math.sin(a)])
+        w = 2 * math.pi * rc / n * wfrac
+        for (x0, y0, x1, y1) in gl[k % len(gl)]:
+            p0 = (rc + (y0 - 0.5) * h) * out + (x0 - 0.5) * w * side
+            p1 = (rc + (y1 - 0.5) * h) * out + (x1 - 0.5) * w * side
+            segs.append((p0[0], p0[1], p1[0], p1[1]))
+    return segs
+
+
+def poly_segs(n, R, a0=0.0):
+    pts = [(R * math.sin(a0 + 2 * math.pi * k / n), R * math.cos(a0 + 2 * math.pi * k / n)) for k in range(n)]
+    return [(pts[k][0], pts[k][1], pts[(k + 1) % n][0], pts[(k + 1) % n][1]) for k in range(n)]
+
+
+def star_segs(n, step, R, a0=0.0):
+    pts = [(R * math.sin(a0 + 2 * math.pi * k / n), R * math.cos(a0 + 2 * math.pi * k / n)) for k in range(n)]
+    return [(pts[k][0], pts[k][1], pts[(k + step) % n][0], pts[(k + step) % n][1]) for k in range(n)]
+
+
+def f_circle(X, Y, px):
+    """마법진: 이중 테 + 룬 띠(12자) + 육망성 + 안쪽 원 + 꼭짓점 구슬."""
+    r = np.hypot(X, Y)
+    lw = (1.2 * px, 2.6 * px, 2.4 * px)
+    i = prof(np.abs(r - 0.955), *lw)
+    i = np.maximum(i, prof(np.abs(r - 0.885), 0.8 * px, 1.9 * px, 2.0 * px))
+    i = np.maximum(i, prof(np.abs(r - 0.715), 1.0 * px, 2.2 * px, 2.2 * px))
+    i = np.maximum(i, prof(np.abs(r - 0.415), 0.8 * px, 2.0 * px, 2.0 * px))
+    i = np.maximum(i, prof(np.abs(r - 0.20), 0.7 * px, 1.7 * px, 1.8 * px, 0.9))
+    # 룬
+    D, _ = seg_dist(X, Y, rune_ring(12, 0.80, 0.085, 0.42))
+    i = np.maximum(i, prof(D, 0.9 * px, 2.0 * px, 2.0 * px))
+    # 룬 사이 점
+    for k in range(12):
+        a = 2 * math.pi * k / 12
+        d = np.hypot(X - 0.80 * math.sin(a), Y - 0.80 * math.cos(a))
+        i = np.maximum(i, prof(d, 1.2 * px, 2.4 * px, 1.6 * px, 0.85))
+    # 육망성
+    D, _ = seg_dist(X, Y, star_segs(6, 2, 0.715))
+    i = np.maximum(i, prof(D, 1.0 * px, 2.2 * px, 2.4 * px))
+    # 꼭짓점 구슬
+    for k in range(6):
+        a = 2 * math.pi * k / 6
+        d = np.hypot(X - 0.715 * math.sin(a), Y - 0.715 * math.cos(a))
+        i = np.maximum(i, prof(np.abs(d - 0.032), 0.9 * px, 2.0 * px, 1.8 * px))
+        i = np.maximum(i, np.where(d < 0.02, 0.75, 0))
+    # 가운데 작은 룬
+    D, _ = seg_dist(X, Y, [(-0.07, 0, 0.07, 0), (0, -0.07, 0, 0.07), (-0.05, -0.05, 0.05, 0.05), (-0.05, 0.05, 0.05, -0.05)])
+    i = np.maximum(i, prof(D, 0.8 * px, 1.8 * px, 1.6 * px, 0.9))
+    return i
+
+
+def f_circle_inner(X, Y, px):
+    r = np.hypot(X, Y)
+    i = prof(np.abs(r - 0.95), 1.0 * px, 2.2 * px, 2.0 * px)
+    i = np.maximum(i, prof(np.abs(r - 0.70), 0.9 * px, 2.0 * px, 2.0 * px))
+    D, _ = seg_dist(X, Y, rune_ring(8, 0.825, 0.15, 0.40, offset=0.2, glyphs=GLYPHS[3:]))
+    i = np.maximum(i, prof(D, 1.0 * px, 2.0 * px, 2.0 * px))
+    D, _ = seg_dist(X, Y, poly_segs(3, 0.70) + poly_segs(3, 0.70, math.pi))
+    i = np.maximum(i, prof(D, 0.9 * px, 2.0 * px, 2.0 * px))
+    i = np.maximum(i, prof(np.abs(r - 0.33), 0.9 * px, 2.0 * px, 2.0 * px))
+    i = np.maximum(i, np.where(r < 0.07, 0.95, prof(r - 0.07, 0, 1.5 * px, 2.0 * px, 0.8)))
+    return i
+
+
+def f_swirl(X, Y, px, seed=61, arms=3, twist=2.4):
+    """3갈래 로그 나선. 위에서 볼 때 팔이 시계 방향으로 감겨 들어간다."""
+    r, th = polar(X, Y)
+    nz = Noise(seed)
+    lr = np.log(np.maximum(r, 1e-3))
+    psi = th + twist * lr
+    ph = np.mod(psi * arms / (2 * math.pi), 1.0) - 0.5
+    width = 0.13 + 0.10 * r
+    arm = np.exp(-(ph / width) ** 2)
+    wisp = nz.fbm(psi * 3 / math.pi + 3, r * 9, 3, pu=6)
+    fade = smooth(1.0, 0.55, r) * (0.55 + 0.45 * smooth(0.0, 0.35, r))
+    i = 0.78 * arm * fade * (0.5 + 0.7 * wisp)
+    # 안쪽 소용돌이 + 밝은 중심
+    i = np.maximum(i, np.where(r < 0.06, 1.0, 0.86 * np.exp(-(np.maximum(r - 0.06, 0) / 0.10) ** 1.2)) * (0.85 + 0.15 * arm))
+    return np.clip(i, 0, 1)
+
+
+# ── 경고(텔레그래프): 속성색과 상관없이 같은 위험 표시 ──
+
+def f_warn(X, Y, px):
+    r, th = polar(np.abs(X), np.abs(Y))
+    edge = np.where((r >= 0.905) & (r <= 0.985), 1.0, 0)
+    blk = np.where(((r > 0.985) & (r <= 1.0)) | ((r >= 0.885) & (r < 0.905)), 0.78, 0)
+    # 안쪽을 가리키는 위험 눈금 24개 (끝이 뾰족한 삼각형)
+    seg = math.pi * 2 / 24
+    a = np.mod(th + seg / 2, seg) - seg / 2
+    depth = (0.885 - r) / 0.075
+    tick = np.where((depth >= 0) & (depth <= 1) & (np.abs(a) * r < 0.022 * (1 - depth) + 0.004), 0.9, 0)
+    tick_rim = np.where((depth >= -0.05) & (depth <= 1.15) & (np.abs(a) * r < 0.022 * (1 - depth) + 0.012) & (tick == 0), 0.6, 0)
+    accent = np.where(np.abs(r - 0.765) < 0.006, 0.92, 0)
+    half = np.where(np.abs(r - 0.5) < 0.006, 0.5, 0)
+    half_rim = np.where((np.abs(r - 0.5) >= 0.006) & (np.abs(r - 0.5) < 0.013), 0.45, 0)
+    return {"edge": np.maximum(np.maximum(edge, tick), half),
+            "rim": np.maximum(np.maximum(blk, tick_rim), half_rim) * (1 - np.maximum(edge, tick) > 0),
+            "accent": accent}
+
+
+def f_warn_fill(X, Y, px):
+    """진행 막대: 옅은 원판 대신 띠를 겹친 원 (깊이 문제를 피한다) + 밝은 앞 가장자리."""
+    r = np.hypot(np.abs(X), np.abs(Y))
+    bands = np.where((np.mod(r, 0.105) < 0.04) & (r < 0.93), 0.42, 0)
+    front = np.where((r >= 0.93) & (r <= 0.99), 0.85, 0)
+    rim = np.where((r > 0.99) & (r <= 1.0), 0.6, 0)
+    return {"edge": np.maximum(bands, front), "rim": rim}
+
+
+def f_warn_line(X, Y, px):
+    """줄 경고: 양쪽 레일 + 앞(위)을 가리키는 화살 6개. X = 폭(-1..1), Y = 길이(-1 아래 → 1 위)."""
+    ax = np.abs(X)
+    rail = np.where((ax >= 0.70) & (ax <= 0.92), 1.0, 0)
+    blk = np.where(((ax > 0.92) & (ax <= 1.0)) | ((ax >= 0.62) & (ax < 0.70)), 0.75, 0)
+    period = 2.0 / 6
+    v = np.mod(Y + 1, period) / period  # 0..1, 위로 갈수록 커짐
+    chev = np.abs((v - 0.25) - (0.5 - ax * 0.55))
+    ch = np.where((chev < 0.11) & (ax < 0.58), 0.72, 0)
+    ch_rim = np.where((chev >= 0.11) & (chev < 0.16) & (ax < 0.6), 0.5, 0)
+    accent = np.where(np.abs(ax - 0.66) < 0.025, 0.0, 0)
+    return {"edge": np.maximum(rail, ch), "rim": np.maximum(blk, ch_rim), "accent": accent}
+
+
+# ── 땅 갈라짐(잔광) ──
+
+def jag_path(rng, start, ang, length, steps, jitter):
+    pts = [np.array(start, dtype=float)]
+    a = ang
+    for k in range(steps):
+        a += rng.normal(0, jitter)
+        pts.append(pts[-1] + length / steps * np.array([math.sin(a), math.cos(a)]))
+    return pts, a
+
+
+def f_crack(X, Y, px, seed=71):
+    rng = np.random.default_rng(seed)
+    segs, wts = [], []
+    for k in range(8):
+        ang = 2 * math.pi * (k + rng.uniform(-0.3, 0.3)) / 8
+        ln = rng.uniform(0.55, 0.9)
+        pts, a = jag_path(rng, (0.08 * math.sin(ang), 0.08 * math.cos(ang)), ang, ln, 9, 0.28)
+        for j in range(len(pts) - 1):
+            segs.append((*pts[j], *pts[j + 1]))
+            wts.append(1 - j / len(pts))
+        for _ in range(rng.integers(1, 3)):
+            j = rng.integers(2, len(pts) - 2)
+            bp, _ = jag_path(rng, pts[j], a + rng.choice([-1, 1]) * rng.uniform(0.5, 0.9), ln * 0.35, 4, 0.3)
+            for q in range(len(bp) - 1):
+                segs.append((*bp[q], *bp[q + 1]))
+                wts.append(0.6 * (1 - j / len(pts)) * (1 - q / len(bp)))
+    i = np.zeros_like(X)
+    for (s, w) in zip(segs, wts):
+        D, _ = seg_dist(X, Y, [s])
+        i = np.maximum(i, prof(D, (0.4 + 0.9 * w) * px, (1.2 + 1.2 * w) * px, 1.6 * px, 0.55 + 0.45 * w))
+    r = np.hypot(X, Y)
+    i = np.maximum(i, prof(np.abs(r - 0.09), 0.8 * px, 2.0 * px, 2.0 * px, 0.9))
+    i = np.maximum(i, np.where(r < 0.09, 0.6, 0))
+    return i
+
+
+def f_crack_rime(X, Y, px, seed=73):
+    """서리꽃: 60도 간격 곧은 가지 + 양옆 잔가지 (고사리 모양)."""
+    rng = np.random.default_rng(seed)
+    segs = []
+    a0 = rng.uniform(0, 1)
+    for k in range(6):
+        a = a0 + 2 * math.pi * k / 6
+        L = rng.uniform(0.75, 0.92)
+        d = np.array([math.sin(a), math.cos(a)])
+        segs.append((0, 0, *(d * L)))
+        for j in range(1, 6):
+            p = d * L * j / 6
+            ln = L * 0.28 * (1 - j / 7)
+            for s in (-1, 1):
+                b = a + s * math.radians(55)
+                q = p + ln * np.array([math.sin(b), math.cos(b)])
+                segs.append((*p, *q))
+    D, _ = seg_dist(X, Y, segs)
+    r = np.hypot(X, Y)
+    i = prof(D, 0.7 * px, 1.6 * px, 2.2 * px) * (1 - 0.45 * smooth(0.2, 0.95, r))
+    rng2 = np.random.default_rng(seed + 1)
+    for _ in range(14):
+        a, rr = rng2.uniform(0, 2 * math.pi), rng2.uniform(0.2, 0.9)
+        d = np.hypot(X - rr * math.sin(a), Y - rr * math.cos(a))
+        i = np.maximum(i, f_star((X - rr * math.sin(a)) / 0.06, (Y - rr * math.cos(a)) / 0.06, px / 0.06,
+                                 L=0.95, Ls=0.4, core=0.08, rw=0.08, rws=0.05, glow=0.12) * 0.9)
+    return np.clip(i, 0, 1)
+
+
+def f_crack_pool(X, Y, px, seed=75):
+    """공허 웅덩이: 어두운 바탕(테 색) + 들쭉날쭉한 빛 가장자리 + 덩굴 같은 금."""
+    r, th = polar(X, Y)
+    nz = Noise(seed)
+    edge_r = 0.50 + 0.12 * nz.fbm(np.cos(th) * 2.5 + 3, np.sin(th) * 2.5 + 3, 3) - 0.06
+    d = r - edge_r
+    i = prof(np.abs(d), 1.0 * px, 2.4 * px, 3.0 * px)
+    rng = np.random.default_rng(seed)
+    segs = []
+    for k in range(9):
+        a = 2 * math.pi * (k + rng.uniform(-0.3, 0.3)) / 9
+        rr = 0.5
+        pts, _ = jag_path(rng, (rr * math.sin(a), rr * math.cos(a)), a, rng.uniform(0.2, 0.42), 5, 0.4)
+        segs += [(*pts[j], *pts[j + 1]) for j in range(len(pts) - 1)]
+    D, T = seg_dist(X, Y, segs)
+    i = np.maximum(i, np.where(d > 0, prof(D, 0.6 * px, 1.4 * px, 1.8 * px, 0.8), 0))
+    motes = np.zeros_like(r)
+    for _ in range(10):
+        a, rr = rng.uniform(0, 2 * math.pi), rng.uniform(0.05, 0.38)
+        dd = np.hypot(X - rr * math.sin(a), Y - rr * math.cos(a))
+        motes = np.maximum(motes, prof(dd, 0.8 * px, 1.6 * px, 1.4 * px, 0.75))
+    i = np.maximum(i, motes)
+    pool = np.where(d < -2.4 * px, 0.55 + 0.25 * nz.fbm(X * 6 + 9, Y * 6, 2), 0)
+    return {"I": i, "shade": np.where(i >= CUT, 0, pool)}
+
+
+def f_crack_glyph(X, Y, px):
+    """성스러운 낙인: 테 + 끝이 넓은 십자 + 빛살 8개 + 안쪽 원."""
+    r, th = polar(X, Y)
+    i = prof(np.abs(r - 0.86), 1.0 * px, 2.4 * px, 2.4 * px)
+    i = np.maximum(i, prof(np.abs(r - 0.30), 0.9 * px, 2.0 * px, 2.0 * px))
+    ax, ay = np.abs(X), np.abs(Y)
+    for (a, b) in ((ax, ay), (ay, ax)):
+        wid = 0.035 + 0.06 * np.clip(b / 0.78, 0, 1) ** 2
+        arm = np.where((b <= 0.78) & (a <= wid), 1.0, 0)
+        i = np.maximum(i, np.where(arm > 0, 0.9 - 0.3 * (a / wid), 0))
+        i = np.maximum(i, prof(np.abs(a - wid), 0.8 * px, 1.6 * px, 1.8 * px) * (b <= 0.8))
+    D, _ = seg_dist(X, Y, [(0.33 * math.sin(a), 0.33 * math.cos(a), 0.8 * math.sin(a), 0.8 * math.cos(a))
+                           for a in [math.pi / 4 + k * math.pi / 2 for k in range(4)]])
+    i = np.maximum(i, prof(D, 0.7 * px, 1.5 * px, 1.8 * px, 0.8))
+    return i
+
