+def hue_angle(X, Y):
+    return np.arctan2(X, Y) / (2 * math.pi) + 0.5
+
+
+def hue_quad(X, Y):
+    """4분할(거울) 텍스처용 무지개: 한 사분면 안에서 색상환을 한 바퀴 돌아, 거울 경계에서 색이 끊기지 않는다."""
+    return np.arctan2(np.abs(Y), np.abs(X)) / (math.pi / 2)
+
+
+def hue_radial(X, Y):
+    return 0.5 + 0.9 * np.hypot(X, Y)
+
+
+def hue_slash(X, Y):
+    return 0.5 + np.arctan2(X, Y) / math.radians(200)
+
+
+def hue_len(X, Y):
+    return X * 1.0
